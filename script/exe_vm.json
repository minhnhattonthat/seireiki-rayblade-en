  "len": 67,
  "en": "",
  "status": "todo"
 },
 {
  "id": "exevm:80012560",
  "jp": "ヤマト「いい感じよ。トウヤもやればできるじゃニャい。{nl}　でも、八方美人はダメだからね」",
  "addr": 2147558752,
  "text_addr": 2147558754,
  "text_len": 48,
  "len": 51,
  "en": "",
  "status": "todo"
 },
 {
  "id": "exevm:80012599",
  "jp": "ヤマト「かニャり好意を抱かれてるわ。{nl}　でも、安心したらダメよ。{nl}　乙女心は難しいんだからね」",
  "addr": 2147558809,
  "text_addr": 2147558811,
  "text_len": 56,
  "len": 59,
  "en": "",
  "status": "todo"
 },
 {
  "id": "exevm:800125DA",
  "jp": "ヤマト「すごいすごい！　でも安心するのは早いわ。{nl}　やっぱり最後はちゃんとリードしてあげニャいとね」",
  "addr": 2147558874,
  "text_addr": 2147558876,
  "text_len": 57,
  "len": 60,
  "en": "",
  "status": "todo"
 },
 {
  "id": "exevm:8001261C",
  "jp": "ヤマト「よっ、この色男！{nl}　もう心配はいらニャいみたいね。{nl}　でも、最後までちゃんと大切にしてあげるのよ」",
  "addr": 2147558940,
