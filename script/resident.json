 {
  "id": "res58:03B1",
  "jp": "ヤマト「えっと、おんニャの子からの評価は{nl}　こんニャ感じね。もちろん、数字が高いほど{nl}　好意を寄せられてるってことだからね」",
  "off": 945,
  "len": 75,
  "en": "",
  "status": "todo",
  "sub": 58,
  "sub_addr": 2147556973,
  "text_addr": 2147557920,
  "text_len": 72
 },
 {
  "id": "res58:0402",
  "jp": "ヤマト「現在の好感度はこんニャ感じよ。{nl}　話題をうまく使っていけば大丈夫。頑張ろうね」",
  "off": 1026,
  "len": 60,
  "en": "",
  "status": "todo",
  "sub": 58,
  "sub_addr": 2147556973,
  "text_addr": 2147558001,
  "text_len": 57
 },
 {
  "id": "res58:0444",
  "jp": "ヤマト「それじゃ、恒例の好感度チェーック！」",
  "off": 1092,
  "len": 32,
  "en": "",
  "status": "todo",
  "sub": 58,
  "sub_addr": 2147556973,
  "text_addr": 2147558067,
  "text_len": 29
 },
 {
  "id": "res58:0617",
  "jp": "ヤマト「う～ん、このまんまじゃマズイんじゃニャい？{nl}　もうちょっとマメに動いたほうがいいわね」",
  "off": 1559,
  "len": 53,
  "en": "",
  "status": "todo",
  "sub": 58,
  "sub_addr": 2147556973,
  "text_addr": 2147558534,
  "text_len": 50
 },
 {
  "id": "res58:0652",
  "jp": "ヤマト「もうちょっとね。{nl}　話題はどんどん使わニャいとダメ。{nl}　溜めててもいいことはひとつもニャいよ」",
  "off": 1618,
  "len": 58,
  "en": "",
  "status": "todo",
  "sub": 58,
  "sub_addr": 2147556973,
  "text_addr": 2147558593,
  "text_len": 55
 },
 {
  "id": "res58:0692",
  "jp": "ヤマト「まぁまぁって感じね」",
  "off": 1682,
  "len": 18,
  "en": "",
  "status": "todo",
  "sub": 58,
  "sub_addr": 2147556973,
  "text_addr": 2147558657,
  "text_len": 15
 },
 {
  "id": "res58:06AA",
  "jp": "ヤマト「まぁまぁって感じね。{nl}　その調子でガンガンいっちゃえ！{nl}　‥‥って、ヤダあたしったら、はしたニャい‥‥」",
  "off": 1706,
  "len": 67,
  "en": "",
  "status": "todo",
  "sub": 58,
  "sub_addr": 2147556973,
  "text_addr": 2147558681,
  "text_len": 64
 },
 {
  "id": "res58:06F3",
  "jp": "ヤマト「いい感じよ。トウヤもやればできるじゃニャい。{nl}　でも、八方美人はダメだからね」",
  "off": 1779,
  "len": 51,
  "en": "",
  "status": "todo",
  "sub": 58,
  "sub_addr": 2147556973,
  "text_addr": 2147558754,
  "text_len": 48
 },
 {
  "id": "res58:072C",
  "jp": "ヤマト「かニャり好意を抱かれてるわ。{nl}　でも、安心したらダメよ。{nl}　乙女心は難しいんだからね」",
  "off": 1836,
  "len": 59,
  "en": "",
  "status": "todo",
  "sub": 58,
  "sub_addr": 2147556973,
  "text_addr": 2147558811,
  "text_len": 56
 },
 {
  "id": "res58:076D",
  "jp": "ヤマト「すごいすごい！　でも安心するのは早いわ。{nl}　やっぱり最後はちゃんとリードしてあげニャいとね」",
  "off": 1901,
  "len": 60,
  "en": "",
  "status": "todo",
  "sub": 58,
  "sub_addr": 2147556973,
  "text_addr": 2147558876,
  "text_len": 57
 },
 {
  "id": "res58:07AF",
  "jp": "ヤマト「よっ、この色男！{nl}　もう心配はいらニャいみたいね。{nl}　でも、最後までちゃんと大切にしてあげるのよ」",
  "off": 1967,
