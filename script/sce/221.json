  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2447,
  "text_len": 8
 },
 {
  "id": "sce221:0099B",
  "jp": "トウヤ「‥‥ったく、あのおっちゃん、そんなモンまで‥‥」",
  "off": 2459,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2461,
  "text_len": 32
 },
 {
  "id": "sce221:009C1",
  "jp": "ヤマト「役に立つんだからいいじゃニャい。本当は{nl}　緊急時にそニャえての機能らしいよ。登録されている{nl}　脳波パターンと違う時に感知するみたいだもの」",
  "off": 2497,
  "len": 94,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2499,
  "text_len": 91
 },
 {
  "id": "sce221:00A22",
