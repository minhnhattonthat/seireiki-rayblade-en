  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5226,
  "text_len": 11
 },
 {
  "id": "sce221:01479",
  "jp": "アーサー「どうかしましたか？」",
  "off": 5241,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5243,
  "text_len": 18
 },
 {
  "id": "sce221:01491",
  "jp": "トウヤ「いや、色んな部屋があるんだなって思って‥‥」",
  "off": 5265,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5267,
  "text_len": 32
 },
 {
  "id": "sce221:014B7",
  "jp": "アーサー「そうですか？　でも、みんな同じでしょう」",
  "off": 5303,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5305,
  "text_len": 29
 },
 {
  "id": "sce221:014DA",
  "jp": "ヤマト「部屋の大きさはおニャじだけど‥‥ニャかみが‥‥」",
  "off": 5338,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5340,
  "text_len": 35
 },
 {
  "id": "sce221:01503",
  "jp": "トウヤ「すごく個性的だよな‥‥」",
  "off": 5379,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5381,
  "text_len": 21
 },
 {
  "id": "sce221:0151E",
  "jp": "アーサー「そうですか、それは素直に喜んで{nl}　よろしいのでしょうか？」",
  "off": 5406,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5408,
  "text_len": 40
 },
 {
  "id": "sce221:0154C",
  "jp": "トウヤ「ああ、レイアウトがアーサーらしくて{nl}　いい感じだと思う」",
  "off": 5452,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5454,
  "text_len": 36
 },
 {
  "id": "sce221:01576",
  "jp": "ヤマト「そこはかとニャく呪術のニオイがするけど‥‥」",
  "off": 5494,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5496,
  "text_len": 30
 },
 {
  "id": "sce221:0159A",
  "jp": "アーサー「そ、そうですか‥‥？」",
  "off": 5530,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5532,
  "text_len": 21
 },
 {
  "id": "sce221:015B5",
  "jp": "ヤマト「わぁ～　これニャにかしら？{nl}　みたこともニャい物がたくさんあるわ～」",
  "off": 5557,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5559,
  "text_len": 42
 },
 {
  "id": "sce221:015E5",
  "jp": "トウヤ「おい、勝手に触るんじゃねぇぞ」",
  "off": 5605,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5607,
  "text_len": 22
 },
 {
  "id": "sce221:01601",
  "jp": "ヤマト「わかってるわよ」",
  "off": 5633,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5635,
  "text_len": 12
 },
 {
  "id": "sce221:0161D",
  "jp": "アーサー「ふふふ‥‥あなたにはこれからも期待してますよ」",
  "off": 5661,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5663,
  "text_len": 34
 },
 {
  "id": "sce221:01645",
  "jp": "トウヤ「期待って言われてもなぁ」",
  "off": 5701,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5703,
  "text_len": 19
 },
 {
  "id": "sce221:0165E",
  "jp": "アーサー「なにを言っているのですか。{nl}　こんなに早く聖霊機を操り、実戦で成果を上げた{nl}　操者はあなたがはじめてです。{nl}　私達でもそれなりの訓練をしてここまできたのですから{nl}　自信を持ってください」",
  "off": 5726,
  "len": 123,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5728,
  "text_len": 120
 },
 {
  "id": "sce221:016DC",
  "jp": "トウヤ「自信か‥‥」",
  "off": 5852,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5854,
  "text_len": 14
 },
 {
  "id": "sce221:016F0",
  "jp": "アーサー「とにかく、いつ敵が動きだすかはわかりません。{nl}　今すぐにも襲ってくるかもしれませんし、{nl}　これからも私達と共に戦っていきましょう」",
  "off": 5872,
  "len": 83,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5874,
  "text_len": 80
 },
 {
  "id": "sce221:01746",
  "jp": "トウヤ「すまねえが、まだちゃんとした返事はできねえよ。{nl}　俺の心の中で何か引っかかるものがあるからな‥‥」",
  "off": 5958,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5960,
  "text_len": 62
 },
 {
  "id": "sce221:0178A",
  "jp": "アーサー「そうですか‥‥」",
  "off": 6026,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6028,
  "text_len": 17
 },
 {
  "id": "sce221:017A1",
  "jp": "ヤマト「トウヤ、トウヤ！{nl}　これみてよ、こんニャの見たことニャいわ」",
  "off": 6049,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6051,
  "text_len": 36
 },
 {
  "id": "sce221:017CB",
  "jp": "トウヤ「あーっ！　だから勝手に‥‥」",
  "off": 6091,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6093,
  "text_len": 24
 },
 {
  "id": "sce221:017E9",
  "jp": "アーサー「ははは、別に構いませんよ。{nl}　それから、なにか悩み事があったらいつでも{nl}　相談してください。{nl}　我々は数少ない“同郷の者”なのですからね」",
  "off": 6121,
  "len": 93,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6123,
  "text_len": 90
 },
 {
  "id": "sce221:01849",
  "jp": "トウヤ「ああ。こんなことでもなければ出会わなかった{nl}　だろうしな。すまねぇ、邪魔したな」",
  "off": 6217,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6219,
  "text_len": 48
 },
 {
  "id": "sce221:0187F",
  "jp": "アーサー「え？　私に用事があったのでは？」",
  "off": 6271,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6273,
  "text_len": 28
 },
 {
  "id": "sce221:018A1",
  "jp": "トウヤ「もう済んだ。とりあえず挨拶だけだがな」",
  "off": 6305,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6307,
  "text_len": 26
 },
 {
  "id": "sce221:018C1",
  "jp": "アーサー「なるほど。それはいいことですね。{nl}　それでは、頑張ってください」",
  "off": 6337,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6339,
  "text_len": 41
 },
 {
  "id": "sce221:018F0",
  "jp": "トウヤ「ああ」",
  "off": 6384,
  "len": 10,
  "en": "Touya: Yeah.",
  "status": "translated",
  "style": 0,
  "text_off": 6386,
  "text_len": 7
 },
 {
  "id": "sce221:01918",
  "jp": "ヤマト「世界にはあたし達の知らニャいものが{nl}　山ほどあるのね、ビックリしちゃった」",
  "off": 6424,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6426,
  "text_len": 46
 },
 {
  "id": "sce221:0194C",
  "jp": "トウヤ「当たり前だろ、俺達の住む日本でも、{nl}　まだ知らねえものは沢山あるよ。{nl}　目の前にあるものがすべてじゃねえってことだ」",
  "off": 6476,
  "len": 77,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6478,
  "text_len": 74
 },
 {
  "id": "sce221:0199C",
  "jp": "ヤマト「それもそうね」",
  "off": 6556,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6558,
  "text_len": 11
 },
 {
  "id": "sce221:019F8",
  "jp": "フェイン「どうした？」",
  "off": 6648,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6650,
  "text_len": 12
 },
 {
  "id": "sce221:01A0A",
  "jp": "トウヤ「お前の乗っていたミレオンのことなんだが‥‥」",
  "off": 6666,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6668,
  "text_len": 30
 },
 {
  "id": "sce221:01A2E",
  "jp": "フェイン「おお、もう直ったのか？」",
  "off": 6702,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6704,
  "text_len": 19
 },
 {
  "id": "sce221:01A47",
  "jp": "トウヤ「え？　あ、いや‥‥実は‥‥」",
  "off": 6727,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6729,
  "text_len": 24
 },
 {
  "id": "sce221:01A65",
  "jp": "ヤマト『ねぇ、そういうこと言わニャいほうが{nl}　いいんじゃニャい？　まだどうニャるかわからニャいって{nl}　言ってたし‥‥』",
  "off": 6757,
  "len": 67,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6759,
  "text_len": 64
 },
 {
  "id": "sce221:01AAB",
  "jp": "　残念だが、ミレオンはもうダメだな{nl}　まだ直ってはいねぇけど、みんな頑張ってるぜ",
  "off": 6827,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 128,
  "text_off": 6829,
  "text_len": 45
 },
 {
  "id": "sce221:01AE4",
  "jp": "フェイン「はははは！　面白い冗談を言う奴だな。{nl}　俺のミレオンがあの程度で壊れるはずがないではないか！」",
  "off": 6884,
  "len": 67,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6886,
  "text_len": 64
 },
 {
  "id": "sce221:01B2A",
  "jp": "トウヤ「まぁ、頑張って直してみるとは言っていたが‥‥」",
  "off": 6954,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6956,
  "text_len": 33
 },
 {
  "id": "sce221:01B51",
  "jp": "フェイン「まぁ、心配することはない。{nl}　次は俺の大活躍を見せてやるぜっ！{nl}　だっはっはっはっはっ！」",
  "off": 6993,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6995,
  "text_len": 60
 },
 {
  "id": "sce221:01B93",
  "jp": "ヤマト「‥‥」",
  "off": 7059,
  "len": 12,
  "en": "",
  "status": "todo",
