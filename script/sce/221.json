  "off": 4133,
  "len": 10,
  "en": "Touya: Yeah.",
  "status": "translated",
  "style": 0,
  "text_off": 4135,
  "text_len": 7
 },
 {
  "id": "sce221:01032",
  "jp": "ヤマト「これで簡単だけど説明はおしまい。{nl}　あとは実際にやってみて肌で感じるのが一番ね」",
