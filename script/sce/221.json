  "off": 4018,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4020,
  "text_len": 12
 },
 {
  "id": "sce221:00FC4",
  "jp": "ヤマト「すニャおでよろしい。で、最後ニャんだけど、{nl}　もう十分だって思ったら、『終了する』ってところを{nl}　選択するのよ。そしたら、このパートは終了するからね」",
  "off": 4036,
  "len": 94,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4038,
  "text_len": 91
 },
 {
