 {
  "id": "sce419:00476",
  "jp": "オーレリィ「ううん、なんでも。まぁそれで一人で暮らすよう{nl}　になってからもちょくちょく顔を出すようになってね。{nl}　だから、弾きはじめて2年ちょっとかな？」",
  "off": 1142,
  "len": 89,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1144,
  "text_len": 86
 },
 {
  "id": "sce419:004D2",
  "jp": "ヤマト「でも、凄い数ね。これだけ持ってきたの？」",
  "off": 1234,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1236,
  "text_len": 28
 },
 {
  "id": "sce419:004F4",
  "jp": "オーレリィ「まさか。バートがちょくちょく仕入れて{nl}　くれてね、それでいつの間にかこんなになったんだ」",
  "off": 1268,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1270,
  "text_len": 55
 },
 {
  "id": "sce419:00531",
  "jp": "トウヤ「あの人、ホントなんでも仕入れてくるんだな‥‥{nl}　でも、ギターってそんなに面白いのか？」",
  "off": 1329,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1331,
  "text_len": 56
 },
 {
  "id": "sce419:0056F",
  "jp": "オーレリィ「やってみれば奥が深くて楽しいよ。{nl}　トウヤもやってみたら？　なんならアタシが教えて{nl}　あげようか？」",
  "off": 1391,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1393,
  "text_len": 63
 },
 {
  "id": "sce419:005B4",
  "jp": "トウヤ「そうだな。この戦いが終わったら頼もうかな」",
