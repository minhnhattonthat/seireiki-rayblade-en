[
 {
  "id": "sce079:00050",
  "jp": "セリカ「レイフォン兄！　本当にレイフォン兄なんだ！」",
  "off": 80,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 82,
  "text_len": 32
 },
 {
  "id": "sce079:00076",
  "jp": "レイフォン「ああ‥‥久しぶりだね、セリカ。{nl}　少し見ない間にまたきれいになったみたいだ。{nl}　髪も切って‥‥とても似合っているよ」",
  "off": 118,
  "len": 79,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 120,
  "text_len": 76
 },
 {
  "id": "sce079:000C8",
  "jp": "セリカ「もぅ！　レイフォン兄ったら！」",
  "off": 200,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 202,
  "text_len": 22
 },
 {
  "id": "sce079:000E4",
  "jp": "レイフォン「おや？　そこにいるのは‥‥{nl}　どうやら無事に脱出できたようだね」",
  "off": 228,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 230,
  "text_len": 45
 },
 {
  "id": "sce079:00117",
  "jp": "トウヤ「ああ」",
  "off": 279,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 281,
  "text_len": 7
 },
 {
  "id": "sce079:00124",
  "jp": "カスミ「トウヤちゃんが夢で出会った人って‥‥」",
  "off": 292,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 294,
  "text_len": 29
 },
 {
  "id": "sce079:00147",
  "jp": "トウヤ「ああ。この人だ」",
  "off": 327,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 329,
  "text_len": 13
 },
 {
  "id": "sce079:0015A",
  "jp": "レイフォン「僕もあれからすぐに出る事ができてね。{nl}　少し王宮に寄って、準備をしていて気がついたら、{nl}　王宮では色々起こっていてね。{nl}　もう少し早く出てこれればよかったんだけど、{nl}　エイディオンの再生に時間がかかってね」",
  "off": 346,
  "len": 133,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 348,
  "text_len": 130
 },
 {
  "id": "sce079:001E2",
  "jp": "セリカ「やっぱりあれってエイディオンだったんだ。{nl}　封印の間に安置されている姿しか見たこと{nl}　なかったから‥‥」",
  "off": 482,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 484,
  "text_len": 65
 },
 {
  "id": "sce079:00229",
  "jp": "レイフォン「そうだよ。あれは、はるか太古の時代、{nl}　地球‥‥つまりそちらにいる人達のいた世界だけど、{nl}　そこへ飛来した機体なんだ」",
  "off": 553,
  "len": 84,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 555,
  "text_len": 81
 },
 {
  "id": "sce079:00280",
  "jp": "カスミ「え？　ということは‥‥宇宙人の？」",
  "off": 640,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 642,
  "text_len": 28
 },
 {
  "id": "sce079:002A2",
  "jp": "アーサー「ですが、それがどうしてこのアガルティアに？」",
  "off": 674,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 676,
  "text_len": 30
 },
 {
  "id": "sce079:002C6",
  "jp": "レイフォン「君達が目撃したという巨大な物体、{nl}　<E1>ォーリアと戦うためさ。その戦いの余剰エネルギーは{nl}　地球を破壊するほどだった。{nl}　だから、エイディオンと他の二体、シー<E1>ァリアスと{nl}　クールマリシンの力で力の性質を変換させ、{nl}　このアガルティアを作り上げたというわけなんだ。{nl}　つまり地球とこのアガルティアは表裏一体。{nl}　一つにして他なるものでありながら互いに関係{nl}　しあっているということさ」",
  "off": 710,
  "len": 242,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 712,
  "text_len": 239
 },
 {
  "id": "sce079:003BB",
  "jp": "セリカ「そ、それって‥‥」",
  "off": 955,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 957,
  "text_len": 15
 },
 {
  "id": "sce079:003D0",
  "jp": "レイフォン「突然のことで信じられないかもしれないけど、{nl}　すべて事実さ。もっとも、すべては僕の中にいる{nl}　グラウザーが教えてくれてた知識だけどね」",
  "off": 976,
  "len": 87,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 978,
  "text_len": 84
 },
 {
  "id": "sce079:0042A",
  "jp": "トウヤ「グラウザー？」",
  "off": 1066,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1068,
  "text_len": 13
 },
 {
  "id": "sce079:0043D",
  "jp": "レイフォン「3年前あの爆発の時、本来死ぬはずだった{nl}　僕を助けてくれたのが超精神体となったグラウザー{nl}　だったんだ。{nl}　僕は死にたくなかった。生きたかった。{nl}　そして気がついた時、グラウザーと僕は同化していた。{nl}　グラウザーの力であの空間に退避してね」",
  "off": 1085,
  "len": 159,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1087,
  "text_len": 156
 },
 {
  "id": "sce079:004DF",
  "jp": "セリカ「もしかして、そのグラウザーっていう人が{nl}　エイディオンに乗ってやってきたの？」",
  "off": 1247,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1249,
  "text_len": 47
 },
 {
  "id": "sce079:00514",
  "jp": "レイフォン「ああ。僕も完全には理解していないけど、{nl}　地球の外には宇宙というものがあって、そのさらに遠くに{nl}　別の宇宙が存在し、彼らはそこから来たらしいんだ。{nl}　“リン・カーマ”というのが彼らの故郷の名前で、{nl}　もとは太陽系の人間と系譜をおなじくするよう{nl}　なんだけど、定かではないみたいだね。{nl}　ただ、ひとつの事実として、リン・カーマの人類と{nl}　太陽系人類の姿は酷似している点からその説は{nl}　間違ってはいないだろうね。{nl}　グラウザーはそのリン・カーマで、エイディオン、{nl}　シー<E1>ァリアス、クールマリシンのΞ体の超攻性外殻体{nl}　“神凱王”を製作した科学者だったんだ」",
  "off": 1300,
  "len": 359,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1302,
  "text_len": 356
 },
 {
  "id": "sce079:0067E",
  "jp": "トウヤ「‥‥なんだかワケわかんねぇ‥‥」",
  "off": 1662,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1664,
  "text_len": 24
 },
 {
  "id": "sce079:0069C",
  "jp": "セリカ「つまり、このアガルティアは<E1>ォーリアという{nl}　奴との戦いの余波で出来た世界で、{nl}　それはリン・カーマっていう異星人がやった、と。{nl}　そんで、その内のグラウザーとかいう人の精神が{nl}　あなたの身体の中で共生してる。{page}　ついでに言うなら外に立ってるあのΞ体を作ったのも{nl}　その人だということ？」",
  "off": 1692,
  "len": 182,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1694,
  "text_len": 179
 },
 {
  "id": "sce079:00755",
  "jp": "レイフォン「お見事。もうすぐ、他の二人も到着{nl}　すると思うから、それから詳しい説明をさせてもらうよ」",
  "off": 1877,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1879,
  "text_len": 61
 },
 {
  "id": "sce079:00798",
  "jp": "トウヤ「おい、まだあるのかよ‥‥」",
  "off": 1944,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1946,
  "text_len": 19
 },
 {
  "id": "sce079:007B1",
  "jp": "侍女「失礼します。<E1>ァルガ・ソルマ様と{nl}　リシュナ・ミルシュ様がご到着されました」",
  "off": 1969,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1971,
  "text_len": 49
 },
 {
  "id": "sce079:007E8",
  "jp": "レスト「よし、お通ししろ」",
  "off": 2024,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2026,
  "text_len": 14
 },
 {
  "id": "sce079:00818",
  "jp": "トウヤ「‥‥ん？　あーっ！　あの時のじーさん！」",
  "off": 2072,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2074,
  "text_len": 32
 },
 {
  "id": "sce079:0083E",
  "jp": "<E1>ァルガ「おお、無事に合流できたようじゃな？」",
  "off": 2110,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2112,
  "text_len": 28
 },
 {
  "id": "sce079:00860",
  "jp": "トウヤ「てぇーことはやっぱり、あんた達も{nl}　リン・カーマとかいう宇宙人なのか？」",
  "off": 2144,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2146,
  "text_len": 47
 },
 {
  "id": "sce079:00895",
  "jp": "<E1>ァルガ「うむ。しかしここにいるリシュナや{nl}　グラウザーとちがってワシは本体じゃがな」",
  "off": 2197,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2199,
  "text_len": 46
 },
 {
  "id": "sce079:008C9",
  "jp": "トウヤ「本体？」",
  "off": 2249,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2251,
  "text_len": 11
 },
 {
  "id": "sce079:008DA",
  "jp": "リシュナ「私のこの体は本来はマナ・エルアという少女の{nl}　もので、“借りている”状態なのです。{nl}　グラウザーのほうは違うようですが‥‥」",
  "off": 2266,
  "len": 85,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2268,
  "text_len": 82
 },
 {
  "id": "sce079:00932",
  "jp": "レイフォン「グラウザーは僕を信用してくれているのさ」",
  "off": 2354,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2356,
  "text_len": 30
 },
 {
  "id": "sce079:00956",
  "jp": "トウヤ「へぇ～　ん？　ちょっと待てよ‥‥{nl}　あんたらがここに来てこのアガルティアができたんだろ？{nl}　てーことはじーさん、あんたいったい、いくつだ？」",
  "off": 2390,
  "len": 87,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2392,
  "text_len": 84
 },
 {
  "id": "sce079:009B0",
  "jp": "<E1>ァルガ「老人に年を訊くのは失礼じゃぞ。{nl}　ワシの年齢と3サイズはひみつじゃ」",
  "off": 2480,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2482,
  "text_len": 47
 },
 {
  "id": "sce079:009E5",
  "jp": "トウヤ「とぼけたじーさんだな。まぁなんにしても{nl}　あんたらも＜ゼ＝オード＞の奴等を倒しに{nl}　来たんだろ？」",
  "off": 2533,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2535,
  "text_len": 63
 },
 {
  "id": "sce079:00A2A",
  "jp": "リシュナ「＜ゼ＝オード＞ではなく<E1>ォーリアです」",
  "off": 2602,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2604,
  "text_len": 29
 },
 {
  "id": "sce079:00A4D",
  "jp": "アーサー「そうそう、それです。{nl}　その<E1>ォーリアというのはなんなのですか？{nl}　さきほども言っておられましたけど‥‥」",
  "off": 2637,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2639,
  "text_len": 65
 },
 {
  "id": "sce079:00A94",
  "jp": "レイフォン「リシュナ、頼むよ」",
  "off": 2708,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2710,
  "text_len": 16
 },
 {
  "id": "sce079:00AAA",
  "jp": "リシュナ「はい。わかりました。{nl}　‥‥<E1>ォーリアは簡単に言ってしまえば“器”です。{page}　ただ、その中に入るのは知的生命体の“意識”{nl}　<E1>ォーリアはその“意識”の収集のために{nl}　造られた存在です。{nl}　このため、<E1>ォーリアには意志というものはなく、{nl}　ただ与えられた命令“意識を収集せよ”を{nl}　実行しているにすぎません」",
  "off": 2730,
  "len": 204,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2732,
  "text_len": 201
 },
 {
  "id": "sce079:00B79",
  "jp": "セリカ「ち、ちょっと、それってデビッシュ博士が{nl}　言っていた“計画”と同じじゃない？」",
  "off": 2937,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2939,
  "text_len": 52
 },
 {
  "id": "sce079:00BB3",
  "jp": "リシュナ「ええ。彼の乗っている＜ゼ＝オード＞聖霊機は{nl}　<E1>ォーリアの末端機関にすぎませんから‥‥」",
  "off": 2995,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2997,
  "text_len": 65
 },
 {
  "id": "sce079:00BFA",
  "jp": "トウヤ「なるほどね‥‥でも、誰がなんの目的で、{nl}　そんなもん作って、送り込んで来たんだ？」",
  "off": 3066,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3068,
  "text_len": 55
 },
 {
  "id": "sce079:00C49",
  "jp": "リシュナ「別の星の人達が送り込んだことは{nl}　わかっていますが、その目的となると‥‥",
  "off": 3145,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3147,
  "text_len": 51
 },
 {
  "id": "sce079:00C91",
  "jp": "　ただ、<E1>ォーリアはあの一体だけではなく、{nl}　様々な宇宙へ送り込まれているようなのです」",
  "off": 3217,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3219,
  "text_len": 52
 },
 {
  "id": "sce079:00CCB",
  "jp": "トウヤ「あんなのが他にもいるのか⁈」",
  "off": 3275,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3277,
  "text_len": 20
 },
 {
  "id": "sce079:00CE5",
  "jp": "リシュナ「同一の銀河に複数の<E1>ォーリアがいたという{nl}　報告はされていません。{page}　ですが、複数いることは確認されています。{nl}　我々のリン・カーマも<E1>ォーリアによって事実上{nl}　崩壊させられました。免れたのは私達Ξ人だけです」",
  "off": 3301,
  "len": 139,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3303,
  "text_len": 136
 },
 {
  "id": "sce079:00D73",
  "jp": "トウヤ「なんか話がえらいことになってきたが、{nl}　その<E1>ォーリアというのが復活すると、この世界の人間が{nl}　みんな消えてなくなるってことか？」",
  "off": 3443,
  "len": 82,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3445,
  "text_len": 79
 },
 {
  "id": "sce079:00DC8",
  "jp": "<E1>ァルガ「ああ。<E1>ォーリアが欲するものは、{nl}　あくまで外宇宙の知的生命体が持つ情報で、{nl}　資源や技術などには興味はないようじゃからな。{nl}　アレが来た世界は生命体だけが消えることとなる。{nl}　<E1>ォーリアはおぬしの乗っているライブレードを含む{nl}　六体の＜ゼ＝オード＞聖霊機が集結することで{nl}　呼び出すんじゃ。{nl}　再び道が開かれた今、止めるには<E1>ォーリア自体を{nl}　破壊するしかない」",
  "off": 3528,
  "len": 243,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3530,
  "text_len": 240
 },
 {
  "id": "sce079:00EBE",
  "jp": "トウヤ「‥‥で、あんた達が出てきたと？{nl}　どうして今まで‥‥」",
  "off": 3774,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3776,
  "text_len": 39
 },
 {
  "id": "sce079:00EEB",
  "jp": "レイフォン「僕ら‥‥というより、僕とリシュナの中にいる{nl}　精神体と<E1>ァルガはなんとか<E1>ォーリアの封印を{nl}　してから、力を使い果たし、眠りについたんだ」",
  "off": 3819,
  "len": 93,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3821,
  "text_len": 90
 },
 {
  "id": "sce079:00F4B",
  "jp": "リシュナ「<E1>ォーリアの反応を目覚めのキーとして」",
  "off": 3915,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3917,
  "text_len": 30
 },
 {
  "id": "sce079:00F6F",
  "jp": "<E1>ァルガ「ワシはゴーデリウスの復活の時に{nl}　目覚めたのじゃが、グラウザーの奴は次元の狭間に{nl}　おって手がだせんかった。{nl}　仕方なくワシとこのリシュナで<E1>ォーリアを{nl}　攻撃したんじゃが、押し戻すだけで{nl}　精一杯じゃったわい、だっはっはっは！」",
  "off": 3951,
  "len": 147,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3953,
  "text_len": 144
 },
 {
  "id": "sce079:01005",
  "jp": "ヤマト「笑ってるよ、あのおじーさん‥‥」",
  "off": 4101,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4103,
  "text_len": 24
 },
 {
  "id": "sce079:01023",
  "jp": "トウヤ「で、どうなんだ？　また復活するのか？」",
  "off": 4131,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4133,
  "text_len": 27
 },
 {
  "id": "sce079:01044",
  "jp": "リシュナ「おそらく。ただ、すでに一度<E1>ォーリアは{nl}　この地へ現れています。もしかしたら六体すべてが{nl}　集まらなくても呼び出すことができるかも‥‥」",
  "off": 4164,
  "len": 88,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4166,
  "text_len": 85
 },
 {
  "id": "sce079:0109F",
  "jp": "カスミ「え‥‥それではこちらには手の打ちようが{nl}　ないということですか‥‥？」",
  "off": 4255,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4257,
  "text_len": 46
 },
 {
  "id": "sce079:010D3",
  "jp": "レイフォン「あれから数日たってもまだその兆候がないと{nl}　いうことはなにかしらの要因があるんじゃないのかい？」",
  "off": 4307,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4309,
  "text_len": 61
 },
 {
  "id": "sce079:01116",
  "jp": "トウヤ「‥‥なんか他人ごとのような言い方だな」",
  "off": 4374,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4376,
  "text_len": 29
 },
 {
  "id": "sce079:01139",
  "jp": "レイフォン「気に触ったのなら謝るよ。{nl}　でも、僕達の目的も究極的には君達と同じ。{nl}　敵対するつもりはないよ」",
  "off": 4409,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4411,
  "text_len": 69
 },
 {
  "id": "sce079:01184",
  "jp": "<E1>ァルガ「とにかく、今はお互い、協力して事に{nl}　当たるしかないということじゃ」",
  "off": 4484,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4486,
  "text_len": 45
 },
 {
  "id": "sce079:011B7",
  "jp": "アーサー「それはこちらとしても助かります」",
  "off": 4535,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4537,
  "text_len": 24
 },
 {
  "id": "sce079:011D5",
  "jp": "レイフォン「それじゃ、少しの間かもしれないけど、よろしく」",
  "off": 4565,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4567,
  "text_len": 31
 },
 {
  "id": "sce079:011FA",
  "jp": "<E1>ァルガ「ワシらもしばらく厄介になるとしようかの」",
  "off": 4602,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4604,
  "text_len": 27
 },
 {
  "id": "sce079:0121B",
  "jp": "リシュナ「よろしくお願いします‥‥」",
  "off": 4635,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4637,
  "text_len": 21
 },
 {
  "id": "sce079:0125D",
  "jp": "ムルク「どうじゃ、様子は？」",
  "off": 4701,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4703,
  "text_len": 17
 },
 {
  "id": "sce079:01274",
  "jp": "ベルンスト「問題ありません。{nl}　しかし、よくこれだけの設備をもっていましたね」",
  "off": 4724,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4726,
  "text_len": 43
 },
 {
  "id": "sce079:012A5",
  "jp": "ムルク「ワシの自慢のプライベートラボじゃからな。{nl}　だが、アガルティアの議会には内緒じゃぞ」",
  "off": 4773,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4775,
  "text_len": 53
 },
 {
  "id": "sce079:012E0",
  "jp": "ベルンスト「ええ、わかっていますよ。{nl}　あなたに出会わなかったらこの子は彼のように{nl}　死んでいたでしょうから‥‥」",
  "off": 4832,
  "len": 67,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4834,
  "text_len": 64
 },
 {
  "id": "sce079:01326",
  "jp": "ムルク「彼？　おぬし、まだ別に‥‥」",
  "off": 4902,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4904,
  "text_len": 23
 },
 {
  "id": "sce079:01343",
  "jp": "ベルンスト「まぁ、彼のほうはクローンですけど。{nl}　少々遺伝子をいじりまして不安定になって‥‥{nl}　注意はしたのですが‥‥」",
  "off": 4931,
  "len": 78,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4933,
  "text_len": 75
 },
 {
  "id": "sce079:01394",
  "jp": "ムルク「もしやそいつは王都のクーデターを{nl}　裏で操っていたという奴か？{nl}　たしか、名は‥‥カインといったかの」",
  "off": 5012,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5014,
  "text_len": 66
 },
 {
  "id": "sce079:013DC",
  "jp": "ベルンスト「ほう、よく御存じですね。{nl}　なかなか優秀な情報提供者をおもちのようだ」",
  "off": 5084,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5086,
  "text_len": 50
 },
 {
  "id": "sce079:01414",
  "jp": "助手「博士ぇ～‥‥あぁっ！」",
  "off": 5140,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5142,
  "text_len": 22
 },
 {
  "id": "sce079:01439",
  "jp": "助手「うぅ～」",
  "off": 5177,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5179,
  "text_len": 10
 },
 {
  "id": "sce079:01467",
  "jp": "ムルク「まったく、あれほど走るなと言ったであろう。{nl}　そこは微妙に段差があるんじゃぞ」",
  "off": 5223,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5225,
  "text_len": 49
 },
 {
  "id": "sce079:0149E",
  "jp": "ベルンスト「‥‥私には平面にしかみえませんが‥‥」",
  "off": 5278,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5280,
  "text_len": 32
 },
 {
  "id": "sce079:014C4",
  "jp": "ムルク「おお、気にしないでくれ。{nl}　こやつは少々変わっておってな」",
  "off": 5316,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5318,
  "text_len": 36
 },
 {
  "id": "sce079:014EE",
  "jp": "ベルンスト「はぁ、少々‥‥ですか‥‥」",
  "off": 5358,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5360,
  "text_len": 24
 },
 {
  "id": "sce079:0150C",
  "jp": "ムルク「ところで、そんなに慌ててどうした？」",
  "off": 5388,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5390,
  "text_len": 24
 },
 {
  "id": "sce079:01532",
  "jp": "助手「あのぉ、えっと、博士のお助けになった{nl}　ベルンストさんなんですけどぉ、{nl}　あの方って＜ゼ＝オード＞さんみたいですよぉ」",
  "off": 5426,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5428,
  "text_len": 72
 },
 {
  "id": "sce079:01580",
  "jp": "ベルンスト「‥‥」",
  "off": 5504,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5506,
  "text_len": 11
 },
 {
  "id": "sce079:01591",
  "jp": "ムルク「ベルンストとはそこにおる御仁のことか？」",
  "off": 5521,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5523,
  "text_len": 27
 },
 {
  "id": "sce079:015B2",
  "jp": "助手「え？　‥‥あ<0EF>」",
  "off": 5554,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5556,
  "text_len": 16
 },
 {
  "id": "sce079:015C8",
  "jp": "ムルク「相変わらず、そそっかしい奴じゃ。{nl}　まぁよい。{nl}　‥‥で、それは本当かな？」",
  "off": 5576,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5578,
  "text_len": 50
 },
 {
  "id": "sce079:0160C",
  "jp": "ベルンスト「‥‥だったらどうなさいますか？」",
  "off": 5644,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5646,
  "text_len": 25
 },
 {
  "id": "sce079:0162B",
  "jp": "ムルク「ふむぅ‥‥ワシには関係ない。{nl}　こうやって貴重なデータの採集もできるし、{nl}　なによりワシはおぬしを気にいった。{nl}　好きなだけここにいればよい」",
  "off": 5675,
  "len": 89,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5677,
  "text_len": 86
 },
 {
  "id": "sce079:01687",
  "jp": "ベルンスト「‥‥」",
  "off": 5767,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5769,
  "text_len": 11
 },
 {
  "id": "sce079:01698",
  "jp": "ムルク「自分の研究の方が大事。こう言えば安心か？」",
  "off": 5784,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5786,
  "text_len": 36
 },
 {
  "id": "sce079:016C2",
  "jp": "ベルンスト「‥‥なるほど。{nl}　あなたは良くも悪くも“錬金学士”であるようですね。{nl}　では、もう少しの間お世話になりますよ」",
  "off": 5826,
  "len": 78,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5828,
  "text_len": 75
 },
 {
  "id": "sce079:01713",
  "jp": "ムルク「うむ。おお、そうじゃ。おぬし装兵機はどうした？{nl}　なんならワシのバルアミーの技術をあわせてよりパワフルに{nl}　改造してやるぞ」",
  "off": 5907,
  "len": 78,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5909,
  "text_len": 75
 },
 {
  "id": "sce079:01764",
  "jp": "ベルンスト「‥‥遠慮しておきます」",
  "off": 5988,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5990,
  "text_len": 21
 },
 {
  "id": "sce079:0179B",
  "jp": "ローディス「‥‥やぁ、みんな来てくれたんだね」",
  "off": 6043,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6045,
  "text_len": 27
 },
 {
  "id": "sce079:017BC",
  "jp": "セリカ「兄さん！　大丈夫⁈」",
  "off": 6076,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6078,
  "text_len": 20
 },
 {
  "id": "sce079:017D6",
  "jp": "ローディス「ああ。このとおり、たいしたことはないよ。{nl}　だが、私が不甲斐ないばかりに‥‥」",
  "off": 6102,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6104,
  "text_len": 52
 },
 {
  "id": "sce079:01810",
  "jp": "セリカ「そんなことないわ。ギール大佐達は犠牲に{nl}　なったけど、他のみんなは無事だったんだし‥‥」",
  "off": 6160,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6162,
  "text_len": 59
 },
 {
  "id": "sce079:01851",
  "jp": "ローディス「ふふふ‥‥ありがとう‥‥」",
  "off": 6225,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6227,
  "text_len": 24
 },
 {
  "id": "sce079:01879",
  "jp": "ティックス「‥‥」",
  "off": 6265,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6267,
  "text_len": 11
 },
 {
  "id": "sce079:0188A",
  "jp": "アーサー「王子‥‥」",
  "off": 6282,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6284,
  "text_len": 16
 },
 {
  "id": "sce079:018A0",
  "jp": "ティックス「みんな、ごめんなさい。僕‥‥」",
  "off": 6304,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6306,
  "text_len": 24
 },
 {
  "id": "sce079:018BE",
  "jp": "セリカ「ティックス、どういうことだったの？」",
  "off": 6334,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6336,
  "text_len": 23
 },
 {
  "id": "sce079:018E6",
  "jp": "ティックス「‥‥」",
  "off": 6374,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6376,
  "text_len": 11
 },
 {
  "id": "sce079:018F7",
  "jp": "セリカ「ティックス⁈」",
  "off": 6391,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6393,
  "text_len": 12
 },
 {
  "id": "sce079:01909",
  "jp": "カスミ「セ、セリカちゃん‥‥あまり責めちゃ‥‥」",
  "off": 6409,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6411,
  "text_len": 29
 },
 {
  "id": "sce079:01937",
  "jp": "ティックス「‥‥いいんだ。僕は‥‥大変なことを{nl}　してしまったんだから‥‥」",
  "off": 6455,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6457,
  "text_len": 47
 },
 {
  "id": "sce079:0196C",
  "jp": "セリカ「ちゃんと話してくれるわね？」",
  "off": 6508,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6510,
  "text_len": 20
 },
 {
  "id": "sce079:01986",
  "jp": "ティックス「‥‥うん」",
  "off": 6534,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6536,
  "text_len": 13
 },
 {
  "id": "sce079:019AA",
  "jp": "セリカ「‥‥やっぱりあのテロの時だったのね。{nl}　あの時にカインが‥‥」",
  "off": 6570,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6572,
  "text_len": 41
 },
 {
  "id": "sce079:019D9",
  "jp": "ティックス「‥‥カインが僕のことを利用しようと{nl}　していたことは知っていたよ。{nl}　だけど、それでもよかったんだ。{nl}　カインは少なくとも僕を認めてくれた。{nl}　僕をちゃんと見てくれたんだ‥‥」",
  "off": 6617,
  "len": 110,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6619,
  "text_len": 107
 },
 {
  "id": "sce079:01A4A",
  "jp": "セリカ「それで、王宮を抜け出したの？」",
  "off": 6730,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6732,
  "text_len": 24
 },
 {
  "id": "sce079:01A68",
  "jp": "ティックス「ここには僕の居場所がないと思ったから‥‥{nl}　別に行く当てもなかったけど、なぜか僕にはカインの{nl}　居場所がわかったんだ‥‥そしてカインと出会い‥‥」",
  "off": 6760,
  "len": 102,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6762,
  "text_len": 99
 },
 {
  "id": "sce079:01AD1",
  "jp": "セリカ「‥‥どうしたの？」",
  "off": 6865,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6867,
  "text_len": 16
 },
 {
  "id": "sce079:01AE7",
  "jp": "ティックス「それからの記憶はないんだ。{nl}　気がついたら再びこの王宮へ戻っていたから。{nl}　そこでカインは僕に父上や兄さんを殺し、{nl}　王になれと言った。でも僕は断った‥‥{nl}　僕は王位とかが欲しかったんじゃない。{nl}　一人の人間として認めてほしかっただけなんだ。{nl}　でも、カインも僕のことを道具としてしか{nl}　見てくれなかった‥‥{nl}　そうしたらカインは変な薬を使ってみんなを操って、{nl}　それから、クーデターを‥‥」",
  "off": 6887,
  "len": 246,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6889,
  "text_len": 243
 },
 {
  "id": "sce079:01BE0",
  "jp": "ティックス「僕は間違っていた‥‥{nl}　僕は誰かに認められるためにいるんじゃない。{nl}　大事なのは自分が他の人にどんなことをして{nl}　あげれるのかだってことなのに。{nl}　僕は自分のことしか考えていなかったんだ。{nl}　それがわかったから、カインを止めようとしたんだ。{nl}　でも、ダメだった。侍女のルーナが助けてくれなかったら{nl}　僕はここにいなかった。彼女のおかげで逃げることが{nl}　できたんだ。そして、封印の間でレイフォン兄さんに‥‥」",
  "off": 7136,
  "len": 245,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7138,
  "text_len": 242
 },
 {
  "id": "sce079:01CD8",
  "jp": "ローディス「‥‥」",
  "off": 7384,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7386,
  "text_len": 12
 },
 {
  "id": "sce079:01CEA",
  "jp": "セリカ「そうだったの‥‥ルーナ。{nl}　ティックスを助けてくれてありがとう」",
  "off": 7402,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7404,
  "text_len": 40
 },
 {
  "id": "sce079:01D18",
  "jp": "侍女「いえ、そんな‥‥当然のことをしたまでです」",
  "off": 7448,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7450,
  "text_len": 30
 },
 {
  "id": "sce079:01D42",
  "jp": "ティックス「ルーナも兄さんも姉さんもこんな僕を{nl}　心配してくれた‥‥それだけで十分なのに、僕は‥‥{nl}　僕は罰を受けるべきなんだ‥‥{nl}　裁かれるべき人間なんだ」",
  "off": 7490,
  "len": 103,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7492,
  "text_len": 100
 },
 {
  "id": "sce079:01DB2",
  "jp": "？？？？？「‥‥それは違うぞ、ティックス」",
  "off": 7602,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7604,
  "text_len": 29
 },
 {
  "id": "sce079:01DD5",
  "jp": "フェイン「へ、陛下⁈」",
  "off": 7637,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7639,
  "text_len": 14
 },
 {
  "id": "sce079:01DE9",
  "jp": "セリカ「お父様⁉」",
  "off": 7657,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7659,
  "text_len": 12
 },
 {
  "id": "sce079:01E07",
  "jp": "レジオナル「ティックス。間違いを起こさぬ人間はおらん。{nl}　大切なのはその間違いを繰り返さないこと。{nl}　そして、間違いを起こさないように努力することだ。{nl}　お前は自分の間違いに気づいた。{nl}　罰をうけるのは簡単だ。{nl}　だが、お前には王族としての罪の償い方がある。{nl}　ティックス、後悔は未来の行動の糧とすればいい。{nl}　過去になにをしたかではなく、これからどうするかなのだ」",
  "off": 7687,
  "len": 226,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7689,
  "text_len": 223
 },
 {
  "id": "sce079:01EEC",
  "jp": "ティックス「父上‥‥」",
  "off": 7916,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7918,
  "text_len": 15
 },
 {
  "id": "sce079:01F01",
  "jp": "ローディス「そうだ。お前は私と違って、この国の{nl}　王となるべき人間だ。より大きな善政によって{nl}　償えばいいんだ」",
  "off": 7937,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7939,
  "text_len": 68
 },
 {
  "id": "sce079:01F4B",
  "jp": "レジオナル「ローディス。お前もいつまでこだわっている？{nl}　お前は私の息子だ。たとえ血がつながってなくてもな。{nl}　ローディス、セリカ、ティックス‥‥ここにいるΞ人は{nl}　私の自慢の子供達なのだからな」",
  "off": 8011,
  "len": 120,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8013,
  "text_len": 117
 },
 {
  "id": "sce079:01FC6",
