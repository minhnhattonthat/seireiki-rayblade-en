  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2152,
  "text_len": 43
 },
 {
  "id": "sce181:0089B",
  "jp": "ジグリム兵止「知将タイロンとも思えぬ言葉。{nl}　少々無謀ではありませんか？」",
  "off": 2203,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2205,
  "text_len": 48
 },
 {
  "id": "sce181:008CE",
  "jp": "タイロン「ならば貴公ならどうする？」",
