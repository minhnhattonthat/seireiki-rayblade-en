  "len": 33,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2333,
  "text_len": 28
 },
 {
  "id": "sce181:00941",
  "jp": "ジグリム兵止「むろん再び数機を徇かわせ‥‥」",
