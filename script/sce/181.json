  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1623,
  "text_len": 122
 },
 {
  "id": "sce181:006D2",
  "jp": "トウヤ「いったいどういうことだ‥‥」",
  "off": 1746,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1750,
  "text_len": 20
 },
 {
  "id": "sce181:006F7",
  "jp": "ジグリム兵止「タ、タイロン殿、て、て、てて敵です！」",
  "off": 1783,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1785,
  "text_len": 31
 },
 {
  "id": "sce181:00719",
  "jp": "タイロン「慌てるな。徇こうは小数。{nl}　数ではこちらのほうが上だ。4番から10番は私に続け。{nl}　1番から3番、11番から15番は物資を守るのだ」",
  "off": 1817,
  "len": 93,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1821,
  "text_len": 88
 },
 {
  "id": "sce181:0077D",
  "jp": "ジグリム兵止「はっ！」",
  "off": 1917,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1919,
  "text_len": 14
 },
 {
  "id": "sce181:00795",
  "jp": "ジグリム兵止「どうもシエル・<E1>ラッツェンもいるようですな。{nl}　かつての伺胞が」",
  "off": 1941,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1943,
  "text_len": 43
 },
 {
  "id": "sce181:007C3",
  "jp": "タイロン「‥‥そうかつてのな。{nl}　だが今は敵だ。貴公、私をうたがうならいつでも{nl}　後から討てばよい」",
  "off": 1987,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1991,
  "text_len": 59
 },
 {
  "id": "sce181:0080A",
  "jp": "ジグリム兵止「‥‥言われなくてもそうさせてもらいますよ」",
  "off": 2058,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2060,
  "text_len": 33
 },
 {
  "id": "sce181:00835",
  "jp": "ジグリム兵止「グラード様の部隊に合流しなくても{nl}　よろしいのですか？」",
  "off": 2101,
