[
 {
  "id": "sce036:00029",
  "jp": "レイフォン「ローディス‥‥そんなに落ち込まないで‥‥{nl}　君が僕の味方でいてくれたように僕もずっと君の‥‥」",
  "off": 41,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 43,
  "text_len": 68
 },
 {
  "id": "sce036:00073",
  "jp": "ローディス「同情なんてたくさんだ！{nl}　私は王家の嫡子なんだ。{nl}　嫡子でなければいけないんだ！」",
  "off": 115,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 117,
  "text_len": 59
 },
 {
  "id": "sce036:000B4",
  "jp": "レイフォン「ロ、ローディス‥‥どうしたんだい？{nl}　君らしくないじゃないか‥‥{nl}　陛下の息子じゃないからどうだって言うんだい？{nl}　皇太子という地位なんて、君という存在に比べたら{nl}　ちっぽけなものだよ。だから‥‥」",
  "off": 180,
  "len": 132,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 182,
  "text_len": 129
 },
 {
  "id": "sce036:0013B",
  "jp": "ローディス「‥‥たしかに地位など私個人にとって{nl}　重要なものではない。だが、皇太子としての私はすでに{nl}　私個人の範ちゅうを越えてしまっているんだ。{nl}　レイフォン、私は君とは違う！{nl}　皇太子たる私が背負うものは君とは比べようもなく{nl}　重いものなんだっ！」",
  "off": 315,
  "len": 162,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 317,
  "text_len": 159
 },
 {
  "id": "sce036:001E0",
  "jp": "レイフォン「‥‥ローディス、君が責任感の強い人だって{nl}　ことは僕が一番知っているよ。{nl}　でも、それに押し潰されることはないんだ」",
  "off": 480,
  "len": 82,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 482,
  "text_len": 79
 },
 {
  "id": "sce036:00235",
  "jp": "ローディス「くっ‥‥君にはわからない‥‥{nl}　叔父上の愛妾の子供である君には！」",
  "off": 565,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 567,
  "text_len": 54
 },
 {
  "id": "sce036:00271",
  "jp": "レイフォン「‥‥ローディス‥‥」",
  "off": 625,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 627,
  "text_len": 21
 },
 {
  "id": "sce036:0028C",
  "jp": "ローディス「‥‥あっ、す、すまない。言い過ぎた‥‥」",
  "off": 652,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 654,
  "text_len": 33
 },
 {
  "id": "sce036:002B3",
  "jp": "レイフォン「ローディス‥‥それが君の本心なんだね。{nl}　‥‥君が励ましてくれた時、僕は救われたんだ。{nl}　王族の中にもこういう考えをする人がいるんだって{nl}　わかって、とてもうれしかった‥‥{nl}　でもそれは、僕に同情していただけなんだね」",
  "off": 691,
  "len": 141,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 693,
  "text_len": 138
 },
 {
  "id": "sce036:00343",
  "jp": "ローディス「ち、違う‥‥」",
  "off": 835,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 837,
  "text_len": 17
 },
 {
  "id": "sce036:0035A",
  "jp": "レイフォン「単なる気まぐれで可愛そうな庶子に{nl}　救いの手を差し伸べてみただけ。{nl}　ただ、それだけだったんだ‥‥」",
  "off": 858,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 860,
  "text_len": 68
 },
 {
  "id": "sce036:003A4",
  "jp": "ローディス「聞いてくれ！　私はそういうつもりじゃ‥‥」",
  "off": 932,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 934,
  "text_len": 33
 },
 {
  "id": "sce036:003CB",
  "jp": "レイフォン「‥‥そうだね。{nl}　君は僕とちがって“正統”でなければならないからね。{nl}　だけど、僕は父上も母上も尊敬している。{nl}　たとえ、妾腹の子と言われても、二人の子供であって{nl}　よかったと思っているんだ。君が僕のことをそんなふうに{nl}　見ていたなんて残念だよ‥‥」",
  "off": 971,
  "len": 165,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 973,
  "text_len": 162
 },
 {
  "id": "sce036:00473",
  "jp": "ローディス「レ、レイフォン！」",
  "off": 1139,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1141,
  "text_len": 17
 },
 {
  "id": "sce036:0048A",
  "jp": "レイフォン「‥‥さようなら、ローディスさん‥‥」",
  "off": 1162,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1164,
  "text_len": 29
 },
 {
  "id": "sce036:004AD",
  "jp": "ローディス「レイフォン‼」",
  "off": 1197,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1199,
  "text_len": 15
 },
 {
  "id": "sce036:004DA",
  "jp": "ローディス「はぁはぁはぁ‥‥また、あの夢か‥‥」",
  "off": 1242,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1244,
  "text_len": 30
 },
 {
  "id": "sce036:00524",
  "jp": "メル<E1>ィ「ゲンちゃん‥‥そろそろ‥‥」",
  "off": 1316,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1318,
  "text_len": 23
 },
 {
  "id": "sce036:00549",
  "jp": "ゲン「ああ、ちょっと待って。{nl}　ほら姉ちゃん、行くよ！」",
