  "status": "todo",
  "style": 1,
  "text_off": 2379,
  "text_len": 20
 },
 {
  "id": "sce179:00960",
  "jp": "<E1>ァレス「ふっ‥‥」",
  "off": 2400,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2404,
  "text_len": 12
 },
 {
  "id": "sce179:00971",
  "jp": "フェイン「あなたはまさか‥‥」",
  "off": 2417,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2421,
  "text_len": 17
 },
 {
  "id": "sce179:00987",
  "jp": "<E1>ァレス「誰でもない。戦いに魅せられたただの傭兵さ。{nl}　それ以上でも以下でもない‥‥」",
  "off": 2439,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2443,
  "text_len": 54
 },
 {
  "id": "sce179:009EC",
  "jp": "フェイン「なっ！　その動き‥‥師匠‥‥？」",
  "off": 2540,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2544,
  "text_len": 30
 },
 {
  "id": "sce179:00A0F",
  "jp": "<E1>ァレス「ほぅ、お前がレストの弟子という男か‥‥{nl}　ふふふふ、なかなかいい動きをする‥‥」",
  "off": 2575,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2579,
  "text_len": 54
 },
 {
  "id": "sce179:00A4A",
  "jp": "フェイン「お前は‥‥いや、あなたは‥‥」",
  "off": 2634,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2638,
  "text_len": 25
 },
 {
  "id": "sce179:00A68",
  "jp": "<E1>ァレス「どうした？　お前の力を見せてみろ。{nl}　お前の師匠はそんなものではなかったぞ？」",
  "off": 2664,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2668,
  "text_len": 52
 },
 {
  "id": "sce179:00B49",
  "jp": "<E1>ァレス「<E1>ェル、データの収集は？」",
  "off": 2889,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2893,
  "text_len": 22
 },
 {
  "id": "sce179:00B64",
  "jp": "<E1>ェル「完璧です。施設へ細工も終わりました」",
  "off": 2916,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2920,
  "text_len": 29
 },
 {
  "id": "sce179:00B86",
  "jp": "<E1>ァレス「よし。ではそろそろ加勢するか」",
  "off": 2950,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2954,
  "text_len": 22
 },
 {
