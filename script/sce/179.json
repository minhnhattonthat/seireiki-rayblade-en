  "len": 14,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2981,
  "text_len": 9
 },
 {
  "id": "sce179:00BAF",
  "jp": "カイン「あの機体‥‥」",
  "off": 2991,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2995,
  "text_len": 15
 },
 {
  "id": "sce179:00BC3",
  "jp": "<E1>ァレス「そこの黒い装兵機。これより我々も加勢する」",
  "off": 3011,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3015,
  "text_len": 33
 },
 {
  "id": "sce179:00BE9",
  "jp": "カイン「‥‥そうか。保険をかけたってことか‥‥{nl}　ふふふふ‥‥まぁ、いいさ‥‥」",
  "off": 3049,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3053,
  "text_len": 50
 },
 {
  "id": "sce179:00C20",
  "jp": "ジョノ「返答ありません」",
  "off": 3104,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3108,
  "text_len": 14
 },
 {
  "id": "sce179:00C33",
  "jp": "<E1>ァレス「そうか。構わん。もう目的は果たした。{nl}　適当なところで撤退する。無理はするな」",
  "off": 3123,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3127,
  "text_len": 54
 },
 {
  "id": "sce179:00C6E",
  "jp": "<E1>ェル「りょーかい」",
  "off": 3182,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3186,
  "text_len": 11
 },
 {
  "id": "sce179:00C7E",
  "jp": "ジョノ「了解」",
  "off": 3198,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3202,
  "text_len": 9
 },
 {
  "id": "sce179:00CA5",
  "jp": "カイン「‥‥やるじゃないか‥‥{nl}　今日はここまでみたいだね‥‥{nl}　だけど、次はこうはいかないよ‥‥」",
  "off": 3237,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3241,
  "text_len": 61
 },
 {
