  "text_len": 35
 },
 {
  "id": "sce179:000C3",
  "jp": "カイン「こうして直接会うのは初めてだね」",
  "off": 195,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 199,
  "text_len": 24
 },
 {
  "id": "sce179:000E3",
  "jp": "セリカ「その声‥‥もしかしてカインなの？！」",
  "off": 227,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 229,
  "text_len": 27
 },
 {
  "id": "sce179:00101",
  "jp": "カイン「やあ、セリカ。久しぶりだね。{nl}　ティックスは元気かい？」",
  "off": 257,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 261,
  "text_len": 36
 },
 {
  "id": "sce179:0012D",
  "jp": "セリカ「どうしてあなたがザクサスに‥‥」",
  "off": 301,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 303,
  "text_len": 22
 },
 {
  "id": "sce179:00146",
  "jp": "カイン「さぁ、どうしてだろうね？{nl}　そのうち解るさ。そのうちにね。{nl}　あ、それから僕の国に抗議しても無駄だよ。{nl}　僕はもう存在しないことになってるから」",
  "off": 326,
  "len": 92,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 330,
  "text_len": 87
 },
 {
  "id": "sce179:001A5",
  "jp": "セリカ「それ、どういうこと‥‥？」",
  "off": 421,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 423,
  "text_len": 20
 },
 {
  "id": "sce179:001BC",
  "jp": "カイン「国を追われた悲劇の王子さまってとこかな？」",
  "off": 444,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 448,
  "text_len": 32
 },
 {
  "id": "sce179:001E4",
  "jp": "セリカ「ふざけないで！」",
  "off": 484,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 486,
  "text_len": 13
 },
 {
  "id": "sce179:001F4",
  "jp": "カイン「‥‥おしゃべりはここまでだ。{nl}　僕は僕自身のために君達と戦わなければならない。{nl}　それじゃ‥‥いくよ！」",
  "off": 500,
  "len": 73,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 504,
  "text_len": 68
 },
 {
  "id": "sce179:0027F",
  "jp": "ミヤスコ「まさか‥‥いえ、そんなはずないわ。{nl}　生き残りがまだいるなんて‥‥でもあれは遠隔操作‥‥」",
  "off": 639,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 641,
  "text_len": 62
 },
 {
  "id": "sce179:002C3",
  "jp": "シスク「どうしたの？　顔真っ青よ？」",
  "off": 707,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 709,
  "text_len": 23
 },
 {
  "id": "sce179:002E0",
  "jp": "ミヤスコ「だ、大丈夫‥‥」",
  "off": 736,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 738,
  "text_len": 18
 },
 {
  "id": "sce179:00345",
  "jp": "アイ「トウヤ。あたしは好きにさせてもらうわ」",
  "off": 837,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 841,
  "text_len": 23
 },
 {
  "id": "sce179:0037B",
  "jp": "アーサー「すみません、今回は勝手に行動させて{nl}　もらいます」",
  "off": 891,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 895,
  "text_len": 38
 },
 {
  "id": "sce179:003C0",
  "jp": "クロビス「俺は単独行動をする。そっちは任せたぞ」",
  "off": 960,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 964,
  "text_len": 30
 },
 {
  "id": "sce179:003FD",
  "jp": "オーレリィ「悪いけど、まだあたしの命を預けれないんだ。{nl}　勝手にさせてもらうよ」",
  "off": 1021,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1025,
  "text_len": 46
 },
 {
  "id": "sce179:0044A",
  "jp": "シィウチェン「‥‥指示に従うつもりはない。{nl}　こちらは勝手にさせてもらう」",
  "off": 1098,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1102,
  "text_len": 44
 },
 {
  "id": "sce179:00493",
  "jp": "セリカ「悪いけど今回は指示に従えないわ」",
  "off": 1171,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1175,
  "text_len": 26
 },
 {
  "id": "sce179:004CC",
  "jp": "フェイン「お前の中にはまだ熱き正義の魂が{nl}　宿っていない！　そんな者の命令に従うことはできん！{nl}　ということで、俺は俺の正義を貫く！　以上！」",
  "off": 1228,
  "len": 98,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1232,
  "text_len": 93
 },
 {
  "id": "sce179:00546",
  "jp": "ゲン「オイラがどれだけ成長したかみせてあげるよ！{nl}　だから勝手に行動させてもらうから。じゃ！」",
  "off": 1350,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1354,
  "text_len": 55
 },
 {
  "id": "sce179:0059A",
  "jp": "メル<E1>ィ「お兄ちゃん、ちょっとメル<E1>ィに考えがあるの。{nl}　だから勝手に動くね」",
  "off": 1434,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1438,
  "text_len": 44
 },
 {
  "id": "sce179:005E5",
  "jp": "メリッサ「今回はちょっと、単独行動をさせてもらうわ」",
  "off": 1509,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1513,
  "text_len": 32
 },
 {
  "id": "sce179:00624",
  "jp": "クルル「あたし、好きに戦うね」",
  "off": 1572,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1576,
  "text_len": 17
 },
 {
  "id": "sce179:00654",
  "jp": "レオーネ「ボク、トウヤの指示にうまく従えるか{nl}　自信ないんだ。だから、今回は自由にさせてもらうね」",
  "off": 1620,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1624,
  "text_len": 59
 },
 {
  "id": "sce179:006C1",
  "jp": "マキ「よ、よし、チャンスだわ！　この戦いを‥‥って、{nl}　どうしてライブレードじゃないのよぉ～{nl}　まぁ、いいわ。とりあえず記録しとこ‥‥レイスケ！」",
  "off": 1729,
  "len": 87,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1731,
  "text_len": 84
 },
 {
  "id": "sce179:0071B",
  "jp": "レイスケ「ピポポポ‥‥ブーン」",
  "off": 1819,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1821,
  "text_len": 18
 },
 {
  "id": "sce179:007B5",
  "jp": "セリカ「カイン！　本当にあなたなの⁈」",
  "off": 1973,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1977,
  "text_len": 23
 },
 {
  "id": "sce179:007D1",
  "jp": "カイン「そうさ。そんなに変わったかい？」",
  "off": 2001,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2005,
  "text_len": 22
 },
 {
  "id": "sce179:007EC",
  "jp": "セリカ「外見なんかじゃないわ。{nl}　あのカインがこんなことするハズない。{nl}　あなた、誰⁈」",
  "off": 2028,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2032,
  "text_len": 48
 },
 {
  "id": "sce179:00821",
  "jp": "カイン「僕は僕さ。君がレイフォンのために貴重な{nl}　サンプルだったアゼラの花を摘んで叱られたことを{nl}　知っているあのカインだよ」",
  "off": 2081,
  "len": 77,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2085,
  "text_len": 72
 },
 {
  "id": "sce179:0086E",
  "jp": "セリカ「本当に‥‥カインなの‥‥？」",
  "off": 2158,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2162,
  "text_len": 25
 },
 {
  "id": "sce179:0088C",
  "jp": "カイン「そう言っているじゃないか。{nl}　さっ、昔話しなんかしている場合じゃないよ。{nl}　今は戦闘中なんだからね」",
  "off": 2188,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2192,
  "text_len": 63
 },
 {
  "id": "sce179:008D0",
  "jp": "セリカ「カイン‥‥」",
