  "len": 87,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 1741,
  "text_len": 81
 },
 {
  "id": "sce201:0071F",
  "jp": "アイ「う～ん、そうなのかなぁ？」",
  "off": 1823,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1827,
  "text_len": 18
 },
 {
  "id": "sce201:00736",
  "jp": "トウヤ「たしかにヤマトの言うとおりかもしれねぇな。{nl}　‥‥とにかく今はあの二人を救出することを考えよう」",
