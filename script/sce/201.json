  "style": 2,
  "text_off": 1591,
  "text_len": 12
 },
 {
  "id": "sce201:00644",
  "jp": "トウヤ「い、いや‥‥なんか嫌な感じ‥‥{nl}　こう、ザラザラするっていうか‥‥」",
  "off": 1604,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1608,
  "text_len": 46
 },
 {
  "id": "sce201:00677",
