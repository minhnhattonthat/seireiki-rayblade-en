  "style": 1,
  "text_off": 552,
  "text_len": 46
 },
 {
  "id": "sce201:00271",
  "jp": "シィウチェン「‥‥指示に従うつもりはない。{nl}　こちらは勝手にさせてもらう」",
  "off": 625,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 629,
  "text_len": 44
 },
 {
  "id": "sce201:002BA",
