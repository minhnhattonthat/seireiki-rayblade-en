  "status": "todo",
  "style": 1,
  "text_off": 493,
  "text_len": 28
 },
 {
  "id": "sce201:00224",
  "jp": "オーレリィ「悪いけど、まだあたしの命を預けれないんだ。{nl}　勝手にさせてもらうよ」",
  "off": 548,
  "len": 51,
  "en": "",
