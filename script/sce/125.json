  "text_off": 5767,
  "text_len": 9
 },
 {
  "id": "sce125:01694",
  "jp": "フェイン「‥‥あれ？」",
  "off": 5780,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5782,
  "text_len": 14
 },
 {
  "id": "sce125:016A8",
