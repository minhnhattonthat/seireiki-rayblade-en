  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4655,
  "text_len": 50
 },
 {
  "id": "sce125:0127D",
  "jp": "ゲン「ふふふふ‥‥逃げよう！」",
  "off": 4733,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4735,
  "text_len": 19
 },
 {
  "id": "sce125:012A8",
  "jp": "トウヤ「え？」",
  "off": 4776,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4778,
  "text_len": 8
 },
 {
  "id": "sce125:012B6",
  "jp": "ゲン「今の揺れのせいにしようよ！」",
  "off": 4790,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4792,
  "text_len": 20
 },
 {
  "id": "sce125:012D0",
