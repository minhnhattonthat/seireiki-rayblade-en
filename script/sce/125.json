  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4601,
  "text_len": 23
 },
 {
  "id": "sce125:0122D",
  "jp": "ヤマト「‥‥うーん、違うみたいよ。そういう感じしニャいし。{nl}　気流の乱れかニャ？」",
