  "status": "todo",
  "style": 0,
  "text_off": 4865,
  "text_len": 12
 },
 {
  "id": "sce125:01311",
  "jp": "ヤマト「それじゃ、メル<E1>ィが努られてもいいの？」",
  "off": 4881,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4883,
  "text_len": 26
 },
 {
  "id": "sce125:01331",
  "jp": "トウヤ「そ、それは‥‥」",
