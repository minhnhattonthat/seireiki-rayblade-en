  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2568,
  "text_len": 42
 },
 {
  "id": "sce257:00A36",
  "jp": "ヤマト「ま、まぁ、そんニャ感じ」",
  "off": 2614,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2616,
  "text_len": 17
 },
 {
  "id": "sce257:00A53",
  "jp": "フェイン「おおっ！　それはつまり俺の口上もそれだけ{nl}　素晴らしいってことだな！」",
  "off": 2643,
