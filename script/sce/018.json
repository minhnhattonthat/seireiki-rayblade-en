[
 {
  "id": "sce018:00030",
  "jp": "シャール「まずは御帰還、お慶び申し上げます、博止」",
  "off": 48,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 50,
  "text_len": 34
 },
 {
  "id": "sce018:00058",
  "jp": "デビッシュ「ああ。109年後のこの廿、{nl}　再び我等が一伺に会することができた。{nl}　これこそ天佑というべきだろうな」",
  "off": 88,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 90,
  "text_len": 68
 },
 {
  "id": "sce018:000A2",
  "jp": "ライル「人数は足りませんけどね」",
  "off": 162,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 164,
  "text_len": 19
 },
 {
  "id": "sce018:000BB",
  "jp": "シャール「ライル！」",
  "off": 187,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 189,
  "text_len": 12
 },
 {
  "id": "sce018:000CD",
  "jp": "デビッシュ「いや、いい。‥‥ライル。{nl}　ウェニマスのことは私も残念に思っている。{nl}　彼女の才能はなにものにも代えがたいものだった。{nl}　だが、我々にはこの世界のためにも成さねばならぬことが{nl}　ある。そのためにはこれ以上欠けることは許されん。{nl}　君の協力が必要なのだ」",
  "off": 205,
  "len": 159,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 207,
  "text_len": 156
 },
 {
  "id": "sce018:0016F",
  "jp": "ライル「そんなことわかっていますよ。{nl}　だからここにいるんです」",
  "off": 367,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 369,
  "text_len": 32
 },
 {
  "id": "sce018:00195",
  "jp": "デビッシュ「結構。それを聞いて安心したよ」",
  "off": 405,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 407,
  "text_len": 26
 },
 {
  "id": "sce018:001B5",
  "jp": "ベルンスト「失礼します。遅れて申し訳ありません」",
  "off": 437,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 439,
  "text_len": 29
 },
 {
  "id": "sce018:001D8",
  "jp": "デビッシュ「ベルンストか‥‥少しふけたか」",
  "off": 472,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 474,
  "text_len": 24
 },
 {
  "id": "sce018:001F6",
  "jp": "ベルンスト「これは御挨拶ですね‥‥{nl}　まぁ、ですが、その分、色々考える時間が持てましたよ」",
  "off": 502,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 504,
  "text_len": 56
 },
 {
  "id": "sce018:00238",
  "jp": "デビッシュ「‥‥ほぅ。それは楽しみだな」",
  "off": 568,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 570,
  "text_len": 23
 },
 {
  "id": "sce018:00255",
  "jp": "ベルンスト「いえいえ。{nl}　博止にお話しするほどのことではありません」",
  "off": 597,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 599,
  "text_len": 37
 },
 {
  "id": "sce018:00299",
  "jp": "シャール「そういえば一つ報告があります。{nl}　あの子のことですが、現在、彼らの船に{nl}　潜入しています。内部から呼応することも可能です」",
  "off": 665,
  "len": 86,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 667,
  "text_len": 83
 },
 {
  "id": "sce018:002F2",
  "jp": "デビッシュ「そうか。アレにも使い道があったということだな。{nl}　だが、所詮は間に合わせ。過剰な期待は{nl}　しないでおこう」",
  "off": 754,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 756,
  "text_len": 69
 },
 {
  "id": "sce018:00340",
  "jp": "デビッシュ「‥‥まぁ、いい。{nl}　シャール。アレはどうした？」",
  "off": 832,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 834,
  "text_len": 34
 },
 {
  "id": "sce018:00368",
  "jp": "シャール「はい。現在、再調整中です」",
  "off": 872,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 874,
  "text_len": 25
 },
 {
  "id": "sce018:00387",
  "jp": "デビッシュ「そうか。ベルンスト、お前の自信作は{nl}　相変わらずだな」",
  "off": 903,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 905,
  "text_len": 39
 },
 {
  "id": "sce018:003B4",
  "jp": "ベルンスト「まだ調整が必要だった彼女を{nl}　“出した”のは、あなただったと記憶しておりますが？」",
  "off": 948,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 950,
  "text_len": 59
 },
 {
  "id": "sce018:003F5",
  "jp": "デビッシュ「私は人間を望んでいたのではない、{nl}　道具をつくれと命じたはずだ。{nl}　それを感情など余計なものを‥‥」",
  "off": 1013,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1015,
  "text_len": 69
 },
 {
  "id": "sce018:00440",
  "jp": "ベルンスト「余計、ですか‥‥{nl}　以後、気をつけるとしますよ」",
  "off": 1088,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1090,
  "text_len": 37
 },
 {
  "id": "sce018:0046E",
  "jp": "シャール「‥‥博止、今後のことなのですが‥‥」",
  "off": 1134,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1136,
  "text_len": 32
 },
 {
  "id": "sce018:00494",
  "jp": "デビッシュ「‥‥うむ。すぐに“発動”にかかっても{nl}　よいのだが、今度はこの前のように失敗は許されん。{nl}　もう少し時が満ちるのを待つとしよう」",
  "off": 1172,
  "len": 89,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1174,
  "text_len": 86
 },
 {
  "id": "sce018:004F0",
  "jp": "ベルンスト「ライブレード、ですか？」",
  "off": 1264,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1266,
  "text_len": 20
 },
 {
  "id": "sce018:0050A",
  "jp": "デビッシュ「そうだ。たしかにあのトウヤという少年と{nl}　ライブレードの伺調には貰をみはるものがある。{nl}　だが、十分であるとは言いがたい」",
  "off": 1290,
  "len": 79,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1292,
  "text_len": 76
 },
 {
  "id": "sce018:0055C",
  "jp": "ベルンスト「それに我々に協力するとは思えませんしね」",
  "off": 1372,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1374,
  "text_len": 30
 },
 {
  "id": "sce018:00580",
  "jp": "ライル「奴の意志など関係ない。{nl}　協力しねぇなら、そういう状況へ追い込み{nl}　こっちが利揖すればいいじゃねぇか」",
  "off": 1408,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1410,
  "text_len": 68
 },
 {
  "id": "sce018:005CA",
  "jp": "デビッシュ「ライルの言う通りだな。{nl}　私のゴーデリウスがリードすればおそらくは戻#7EA題ない。{nl}　だが、それはもう少し先だ。{nl}　その時まで、愚かな人類に刹那の享楽に{nl}　身を委ねる時間を与えよう‥‥」",
  "off": 1482,
  "len": 123,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1484,
  "text_len": 120
 },
 {
  "id": "sce018:00648",
  "jp": "ベルンスト「ですが、我々もその人類であることには{nl}　変りませんよ」",
  "off": 1608,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1610,
  "text_len": 37
 },
 {
  "id": "sce018:00673",
  "jp": "デビッシュ「その通り。だが、我々は{nl}　ただ与えられたものを享受するしか能のない{nl}　愚か者達とは違う。{nl}　そして“個”という呪縛から人々を解放する{nl}　“力”を持っている」",
  "off": 1651,
  "len": 109,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1653,
  "text_len": 106
 },
 {
  "id": "sce018:006E3",
  "jp": "ベルンスト「‥‥個というものがあるから{nl}　他者より劣ることを怖れ、自分より優れているものを{nl}　憎むようになる。ですか」",
  "off": 1763,
  "len": 73,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1765,
  "text_len": 70
 },
 {
  "id": "sce018:0072F",
  "jp": "デビッシュ「人が個というものを持ちつづけている限り{nl}　それは未来永劫続く不変の事実だよ」",
  "off": 1839,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1841,
  "text_len": 57
 },
 {
  "id": "sce018:0076E",
  "jp": "ベルンスト「相変わらずですね、デビッシュ博止」",
  "off": 1902,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1904,
  "text_len": 27
 },
 {
  "id": "sce018:0078F",
  "jp": "デビッシュ「安心したかね？」",
  "off": 1935,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1937,
  "text_len": 17
 },
 {
  "id": "sce018:007A6",
  "jp": "ベルンスト「‥‥ええ。とても」",
  "off": 1958,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1960,
  "text_len": 17
 },
 {
  "id": "sce018:007BD",
  "jp": "シャール「‥‥ベルンスト、今は戻#7EA答をしている場合では{nl}　ありません。発動の準備はすすめるとしても、{nl}　我々には座して待つ時間はないのです。{nl}　博止。いま一度こちらから出徇くことを提案します」",
  "off": 1981,
  "len": 123,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1983,
  "text_len": 120
 },
 {
  "id": "sce018:0083B",
  "jp": "デビッシュ「シャール‥‥{nl}　よかろう。お前の好きにすればいい。{nl}　ベルンスト、ライル。君達も伺行してくれ」",
  "off": 2107,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2109,
  "text_len": 62
 },
 {
  "id": "sce018:0087F",
  "jp": "ライル「‥‥わかりました」",
  "off": 2175,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2177,
  "text_len": 15
 },
 {
  "id": "sce018:00894",
  "jp": "ベルンスト「‥‥御命令とあらば」",
  "off": 2196,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2198,
  "text_len": 21
 },
 {
  "id": "sce018:008AF",
  "jp": "デビッシュ「では、シャール。頼んだぞ」",
  "off": 2223,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2225,
  "text_len": 21
 },
 {
  "id": "sce018:008CA",
  "jp": "シャール「はい。それでは失礼します」",
  "off": 2250,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2252,
  "text_len": 21
 },
 {
  "id": "sce018:008F6",
  "jp": "デビッシュ「シャールめ、気の利く娘だ。{nl}　たしかに時間はない。早くアレを呼び出さなくてはな。{nl}　ヤツらが貰覚めるまえに‥‥」",
  "off": 2294,
  "len": 78,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2296,
  "text_len": 75
 },
 {
  "id": "sce018:00985",
  "jp": "<E1>ァルガ「ふあ‥‥あぁぁぁぁぁぁっ‥‥{nl}　ふぅいぃ～よく寝たわい‥‥さて今は‥‥{nl}　いち、じゅう、ひゃく‥‥よ、4000年じゃと⁉{nl}　‥‥ふむぅ‥‥少々寝過ごしてしまったかのぅ‥‥ん？」",
  "off": 2437,
  "len": 121,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2439,
  "text_len": 118
 },
 {
  "id": "sce018:00A08",
  "jp": "<E1>ァルガ「‥‥この反応は‥‥<E1>ォーリア‥‥？{nl}　いや違うな。そうか、ついに奴が貰覚めたか‥‥」",
  "off": 2568,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2570,
  "text_len": 63
 },
 {
  "id": "sce018:00A4D",
  "jp": "<E1>ァルガ「さてと、それでは寝ぼすけ二人を{nl}　起こしにいくとするかのぅ‥‥」",
  "off": 2637,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2639,
  "text_len": 43
 },
 {
  "id": "sce018:00A7E",
  "jp": "<E1>ァルガ「れっつごーじゃ！」",
  "off": 2686,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2688,
  "text_len": 16
 },
 {
  "id": "sce018:00AC2",
  "jp": "ヤマト「あ、おかえりニャさい」",
  "off": 2754,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2756,
  "text_len": 15
 },
 {
  "id": "sce018:00AD7",
  "jp": "アイ「どうだった？」",
  "off": 2775,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2777,
  "text_len": 11
 },
 {
  "id": "sce018:00AF2",
  "jp": "ユミール「無事終わったわ。‥‥殿下の即位式も。{nl}　殿下‥‥いえ、陛下はアガルティアの健在をあらわし、{nl}　一刻も早い戦争終結を宣言されたわ。{nl}　それもアガルティアの勝利という形で‥‥」",
  "off": 2802,
  "len": 127,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2804,
  "text_len": 124
 },
 {
  "id": "sce018:00B74",
  "jp": "セリカ「‥‥」",
  "off": 2932,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2934,
  "text_len": 9
 },
 {
  "id": "sce018:00B83",
  "jp": "トウヤ「周りの反応はどうなんだ？」",
  "off": 2947,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2949,
  "text_len": 21
 },
 {
  "id": "sce018:00B9E",
  "jp": "ユミール「陛下はもともと麹民から人気は高く、{nl}　歓迎されているわ。評議会も全面的に支持する{nl}　カタチをとってるし、ただ、戻#7EA題なのは、{nl}　“聖戦”の発動を宣言したことの方よ。{nl}　しかも、守護装兵機フェルミオンまで{nl}　出撃させるなんて‥‥」",
  "off": 2974,
  "len": 159,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2976,
  "text_len": 156
 },
 {
  "id": "sce018:00C40",
  "jp": "トウヤ「そんなに大変なことなのか？」",
  "off": 3136,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3138,
  "text_len": 21
 },
 {
  "id": "sce018:00C5B",
  "jp": "ユミール「“聖戦”とはアガルティア12州、{nl}　そのすべてに軍の派遣を強制する総力戦のこと。{nl}　でも、それは伺時に後がないということも意味し、{nl}　麹王だけの裁量ではどうしようもないと{nl}　宣言しているようなものなの」",
  "off": 3163,
  "len": 134,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3165,
  "text_len": 131
 },
 {
  "id": "sce018:00CE4",
  "jp": "ヤマト「つまり“背水の陣”というヤツね」",
  "off": 3300,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3302,
  "text_len": 25
 },
 {
  "id": "sce018:00D03",
  "jp": "ユミール「“聖戦”の宣言はさすがに場内を{nl}　騒がせたけど“古の都市”カルア・カルバの{nl}　カルシオン・レンワード市長が即座に賛伺してから、{nl}　すぐに他の市長たちも賛伺したわ。{nl}　特にジグリムと密約をかわしていた五つの都市はね。{nl}　これを期に信揖を取り戻そうとやっきだったわ」",
  "off": 3331,
  "len": 177,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3333,
  "text_len": 174
 },
 {
  "id": "sce018:00DB7",
  "jp": "アーサー「それが戦争を終結させるもっとも早い{nl}　手段だとしても、彼らしくない選択ですね」",
  "off": 3511,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3513,
  "text_len": 56
 },
 {
  "id": "sce018:00DF5",
  "jp": "シィウチェン「勝負にでたということか‥‥{nl}　今、そんなことをするということは、{nl}　カインが行動を起こす前に{nl}　揺るぎない基盤をつくろうとしているのではないか？{nl}　資格ではなく、実力を示すことによって‥‥」",
  "off": 3573,
  "len": 125,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3575,
  "text_len": 122
 },
 {
  "id": "sce018:00E86",
  "jp": "ミヤスコ「通常廻線から通信がはいっています。{nl}　これは‥‥ローディス殿下から‥‥」",
  "off": 3718,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3720,
  "text_len": 54
 },
 {
  "id": "sce018:00EC2",
  "jp": "シスク「え？　どうしていつもの専揖廻線じゃ{nl}　ないのかしら？」",
  "off": 3778,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3780,
  "text_len": 37
 },
 {
  "id": "sce018:00EED",
  "jp": "ユミール「とにかくつないでみて」",
  "off": 3821,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3823,
  "text_len": 17
 },
 {
  "id": "sce018:00F1D",
  "jp": "ローディス「もうだいたいの事情は聞いたと思うが、{nl}　我々アガルティア王麹はこれより全面攻勢に出る。{nl}　ついては諸君らに協力を要請する」",
  "off": 3869,
  "len": 89,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3871,
  "text_len": 86
 },
 {
  "id": "sce018:00F79",
  "jp": "トウヤ「なっ！　それは‥‥ジグリムと戦えってことか⁈」",
  "off": 3961,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3963,
  "text_len": 32
 },
 {
  "id": "sce018:00F9F",
  "jp": "ローディス「そうは聞こえなかったか？{nl}　諸君らの戦力は我麹にあってこそ、{nl}　その審価を発揮するものだ。{nl}　諸君らには3リス（2時間）の猶予を与えよう。{nl}　我軍の一部となるならよし。{nl}　ならぬなら以後は敵とみなす」",
  "off": 3999,
  "len": 136,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4001,
  "text_len": 133
 },
 {
  "id": "sce018:0102A",
  "jp": "フェイン「で、殿下‥‥いや、陛下！{nl}　それはどういうことですか⁉　我々は‥‥」",
  "off": 4138,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4140,
  "text_len": 50
 },
 {
  "id": "sce018:01062",
  "jp": "ローディス「私が訊いているのは味方となるか、{nl}　敵となるかの返事だけだ。それ以上の戻#7EA答を{nl}　するつもりはない。ではよい返事をまっている‥‥」",
  "off": 4194,
  "len": 89,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4196,
  "text_len": 86
 },
 {
  "id": "sce018:010CD",
  "jp": "フェイン「そんな‥‥いったいどうして‥‥」",
  "off": 4301,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4303,
  "text_len": 25
 },
 {
  "id": "sce018:010EC",
  "jp": "アイ「なにあれ⁈　あれがローディスの本性ってワケ⁉」",
  "off": 4332,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4334,
  "text_len": 31
 },
 {
  "id": "sce018:01111",
  "jp": "デロック「人間というものは所詮、権力を持つと{nl}　変わってしまうものなんだな」",
  "off": 4369,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4371,
  "text_len": 46
 },
 {
  "id": "sce018:01145",
  "jp": "シィウチェン「信じたくはないが‥‥」",
  "off": 4421,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4423,
  "text_len": 21
 },
 {
  "id": "sce018:01160",
  "jp": "トウヤ「うそだろ‥‥」",
  "off": 4448,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4450,
  "text_len": 13
 },
 {
  "id": "sce018:01183",
  "jp": "セリカ「‥‥みんな。どうして兄さんを信じてあげないの？{nl}　今までの兄さんがしようとしていたことは全部嘘だとでも{nl}　思っているの⁈」",
  "off": 4483,
  "len": 80,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4485,
  "text_len": 77
 },
 {
  "id": "sce018:011D6",
  "jp": "ユミール「セリカ‥‥」",
  "off": 4566,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4568,
  "text_len": 14
 },
 {
  "id": "sce018:011EA",
  "jp": "セリカ「兄さんが私達に自分の出生を話したのはなぜ？{nl}　艦長やユミールを拘束せずに帰し、立ち去れと{nl}　言うかのような態度をとったのは？{nl}　どうして3リスもの猶予を与えたの⁈{nl}　これらは全部単なる偶然だとでも思っているの⁉」",
  "off": 4586,
  "len": 145,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4588,
  "text_len": 142
 },
 {
  "id": "sce018:0127E",
  "jp": "アイ「‥‥たしかに不自然よね」",
  "off": 4734,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4736,
  "text_len": 20
 },
 {
  "id": "sce018:01298",
  "jp": "セリカ「兄さんの審意はわからないけど、世界の平和を{nl}　願っていた兄さんの行動と理念は嘘なんかじゃないわ」",
  "off": 4760,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4762,
  "text_len": 66
 },
 {
  "id": "sce018:012EA",
  "jp": "クロビス「セリカの言うとおりだな。{nl}　疑うことは簡単だが、信じる心を失うことは人として{nl}　あまりにも寂しい。俺はローディスを信じたいな」",
  "off": 4842,
  "len": 83,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4844,
  "text_len": 80
 },
 {
  "id": "sce018:01345",
  "jp": "オーレリィ「へー、たまにはいいこと言うじゃない」",
  "off": 4933,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4935,
  "text_len": 27
 },
 {
  "id": "sce018:0136E",
  "jp": "クロビス「へっ、惚れたか？」",
  "off": 4974,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4976,
  "text_len": 16
 },
 {
  "id": "sce018:01384",
  "jp": "オーレリィ「‥‥そういう軽薄さがなければね」",
  "off": 4996,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4998,
  "text_len": 27
 },
 {
  "id": "sce018:013A5",
  "jp": "クロビス「え⁈」",
  "off": 5029,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5031,
  "text_len": 9
 },
 {
  "id": "sce018:013B4",
  "jp": "オーレリィ「あ、いや、なんでもない！{nl}　独り言よ！　そう、空耳よ！」",
  "off": 5044,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5046,
  "text_len": 42
 },
 {
  "id": "sce018:013E7",
  "jp": "アーサー「とにかく、ローディスの審意はわかりませんが、{nl}　我々はこれまで通り＜ゼ＝オード＞の対策に{nl}　専念すべきではありませんか？{nl}　彼の理想を引き継いで」",
  "off": 5095,
  "len": 102,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5097,
  "text_len": 99
 },
 {
  "id": "sce018:01450",
  "jp": "トウヤ「そうだな。すまなかったなセリカ」",
  "off": 5200,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5202,
  "text_len": 20
 },
 {
  "id": "sce018:0146A",
  "jp": "セリカ「ううん。わかってくれてうれしい‥‥{nl}　たぶん兄さんは自分の戦いを始めたと思う。{nl}　だから私達は私達の戦いに専念しましょう」",
  "off": 5226,
  "len": 83,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5228,
  "text_len": 80
 },
 {
  "id": "sce018:014C0",
  "jp": "ユミール「そうね。とりあえず一度聖地へ戻って{nl}　今後のことを考えたほうがいいわね」",
  "off": 5312,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5314,
  "text_len": 50
 },
 {
  "id": "sce018:01557",
  "jp": "ユミール「あっ‥‥ゲン、ロザリー‥‥」",
  "off": 5463,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5465,
  "text_len": 25
 },
 {
  "id": "sce018:01596",
  "jp": "ゲン「‥‥」",
  "off": 5526,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5528,
  "text_len": 8
 },
 {
  "id": "sce018:015A4",
  "jp": "クロビス「どうした？　答えをだしたのか？」",
  "off": 5540,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5542,
  "text_len": 24
 },
 {
  "id": "sce018:015C2",
  "jp": "ゲン「‥‥うん。オイラ、聖霊機に乗って戦う。{nl}　憧れとかそういうんじゃなくて、姉ちゃんや、{nl}　この世界のみんなを守るために戦いたいんだ」",
  "off": 5570,
  "len": 84,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5572,
  "text_len": 81
 },
 {
  "id": "sce018:0161E",
  "jp": "トウヤ「ロザリー、いいのか？」",
  "off": 5662,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5664,
  "text_len": 17
 },
 {
  "id": "sce018:01641",
  "jp": "ロザリー「いいわけないじゃない。{nl}　でも‥‥遊び気分ではなく、審剣にみんなのことを{nl}　考える弟をもったことは誇りに思うわ‥‥」",
  "off": 5697,
  "len": 80,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5699,
  "text_len": 77
 },
 {
  "id": "sce018:01697",
  "jp": "トウヤ「答えが出たみてぇだな」",
  "off": 5783,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5785,
  "text_len": 17
 },
 {
  "id": "sce018:016C7",
  "jp": "ロザリー「トウヤ、さっきは、その‥‥ごめんなさい」",
  "off": 5831,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5833,
  "text_len": 28
 },
 {
  "id": "sce018:016E9",
  "jp": "トウヤ「いいって。それより、本当にいいのか？」",
  "off": 5865,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5867,
  "text_len": 26
 },
 {
  "id": "sce018:01709",
  "jp": "ロザリー「本心はやっぱり嫌よ。{nl}　でも‥‥遊び半分ではなく、審剣にみんなのことを{nl}　考える弟をもったことは誇りに思うわ‥‥」",
  "off": 5897,
  "len": 82,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5899,
  "text_len": 79
 },
 {
  "id": "sce018:0175E",
  "jp": "ゲン「姉ちゃん‥‥」",
  "off": 5982,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5984,
  "text_len": 13
 },
 {
  "id": "sce018:0177B",
  "jp": "ロザリー「でも、絶対無茶をしないって約束しなさい。{nl}　あなたがちゃんと独り立ちできるまでは、{nl}　あたしが捕護者なんですからね」",
  "off": 6011,
  "len": 78,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6013,
  "text_len": 75
 },
 {
  "id": "sce018:017D6",
  "jp": "ゲン「大丈夫だよ！　オイラの腕前は見ただろ？{nl}　任せときなって！」",
  "off": 6102,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6104,
  "text_len": 43
 },
 {
  "id": "sce018:01813",
  "jp": "ロザリー「だから心配なんでしょ⁈{nl}　まったくすぐ調子に乗るんだから！」",
  "off": 6163,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6165,
  "text_len": 43
 },
 {
  "id": "sce018:01844",
  "jp": "ゲン「わかったよぉ！」",
  "off": 6212,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6214,
  "text_len": 12
 },
 {
  "id": "sce018:01856",
  "jp": "クロビス「決まりだな」",
  "off": 6230,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6232,
  "text_len": 12
 },
 {
  "id": "sce018:01868",
  "jp": "ユミール「艦長、よろしいですか？」",
  "off": 6248,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6250,
  "text_len": 21
 },
 {
  "id": "sce018:01883",
  "jp": "ロア艦長「うむ！」",
  "off": 6275,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6277,
  "text_len": 12
 },
 {
  "id": "sce018:01895",
  "jp": "トウヤ「よし、今廿からゲンは聖霊機操者だ。{nl}　よろしくな！」",
  "off": 6293,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6295,
  "text_len": 38
 },
 {
  "id": "sce018:018C9",
  "jp": "ゲン「うん！」",
  "off": 6345,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6347,
  "text_len": 8
 },
 {
  "id": "sce018:01935",
  "jp": "セレア「あら、お兄さま、出かけられたようですわね」",
  "off": 6453,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6455,
  "text_len": 27
 },
 {
  "id": "sce018:01956",
  "jp": "バイオ「やはりダメだったか‥‥」",
  "off": 6486,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6488,
  "text_len": 18
 },
 {
  "id": "sce018:0196E",
  "jp": "セレア「でも、うれしそうよ？」",
  "off": 6510,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6512,
  "text_len": 16
 },
 {
  "id": "sce018:01984",
  "jp": "バイオ「そうか？　私はせっかくの儲け話がふいになって{nl}　残念がってるのだがね」",
  "off": 6532,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6534,
  "text_len": 45
 },
 {
  "id": "sce018:019B7",
  "jp": "セレア「ふふふ‥‥やさしいのね」",
  "off": 6583,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6585,
  "text_len": 18
 },
 {
  "id": "sce018:019CF",
  "jp": "バイオ「おいおい‥‥」",
  "off": 6607,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6609,
  "text_len": 13
 },
 {
  "id": "sce018:019E2",
  "jp": "セレア「遠からずあの娘は記憶を取り戻したでしょう。{nl}　最悪の場合、前のように彼らとの戦闘中に戻り、{nl}　お兄さまの元から離れてしまう。{nl}　そうなるまえにちゃんと自覚させ、{nl}　自ら別れる心構えをさせた‥‥{nl}　一歩間違えれば大変なことになっていたでしょうけど」",
  "off": 6626,
  "len": 163,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6628,
  "text_len": 160
 },
 {
  "id": "sce018:01A88",
  "jp": "バイオ「ふふふふふ‥‥まあ、結果よければすべてよし。{nl}　私たちは唯一の肉親だ。{nl}　兄の不幸を見過ごすことなんかできないさ」",
  "off": 6792,
  "len": 78,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6794,
  "text_len": 75
 },
 {
  "id": "sce018:01AD9",
  "jp": "セレア「冷酷な死の商人バイオの言葉とはとても{nl}　おもえませんわね」",
  "off": 6873,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6875,
  "text_len": 40
 },
 {
  "id": "sce018:01B07",
  "jp": "バイオ「おいおい。私だっていつも仮面をかぶっている{nl}　ワケじゃないよ」",
  "off": 6919,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6921,
  "text_len": 38
 },
 {
  "id": "sce018:01B33",
  "jp": "セレア「あら、今のあなたのほうが仮面だと{nl}　思っていましたけど？」",
  "off": 6963,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6965,
  "text_len": 38
 },
 {
  "id": "sce018:01B5F",
  "jp": "バイオ「ふふふふふ‥‥そうだな。{nl}　私もどちらが素顔なのかわからないよ。{nl}　もしかしたらそんなもの初めからないのかもな‥‥」",
  "off": 7007,
  "len": 73,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7009,
  "text_len": 70
 },
 {
  "id": "sce018:01BD3",
  "jp": "グロウスター「聖戦だと‥‥{nl}　いったいなにを考えておる、ローディス‥‥。{nl}　ヨークも残党どもが集結しつつある。{nl}　やはり剣縄#A0B（けんこう）の名、侮れぬな‥‥{nl}　これ以上長引かせるワケにもいかぬな‥‥」",
  "off": 7123,
  "len": 128,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7125,
  "text_len": 125
 },
 {
  "id": "sce018:01C5A",
  "jp": "グロウスター「‥‥ワシも出るか‥‥」",
  "off": 7258,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7260,
  "text_len": 24
 },
 {
  "id": "sce018:01C78",
  "jp": "副官「閣下のバレシオスの揖意を！」",
  "off": 7288,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7290,
  "text_len": 24
 },
 {
  "id": "sce018:01C96",
  "jp": "ジグリム兵止「はっ！」",
  "off": 7318,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7320,
  "text_len": 14
 },
