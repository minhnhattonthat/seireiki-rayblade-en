 },
 {
  "id": "sce264:01B33",
  "jp": "トウヤ「‥‥お前、いっぺんガボンに診てもらえ」",
  "off": 6963,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6965,
  "text_len": 27
 },
 {
  "id": "sce264:01B54",
  "jp": "フェイン「なにを！　俺はいたって健康そのもの！{nl}　病気になるほど軟弱にはできていない！{nl}　だっはっはっはっ！」",
  "off": 6996,
  "len": 69,
  "en": "",
