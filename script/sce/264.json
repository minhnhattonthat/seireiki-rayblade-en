  "style": 0,
  "text_off": 6998,
  "text_len": 66
 },
 {
  "id": "sce264:01B9C",
  "jp": "ヤマト「‥‥重傷ね」",
  "off": 7068,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7070,
  "text_len": 14
 },
 {
  "id": "sce264:01BB8",
  "jp": "フェイン「‥‥で、どうだった？　今回のは結構自信が{nl}　あるんだがな。いやぁ、自分の才能が怖いぜ」",
  "off": 7096,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7098,
  "text_len": 62
 },
 {
  "id": "sce264:01BFC",
  "jp": "　なかなかいいんじゃねぇか{nl}　演歌みてぇだ",
  "off": 7164,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 128,
  "text_off": 7166,
  "text_len": 23
 },
 {
  "id": "sce264:01C25",
  "jp": "フェイン「だろ？　特に最後のとこなんか言ってる俺が{nl}　しびれるぐらいだからな」",
  "off": 7205,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7207,
  "text_len": 45
 },
 {
  "id": "sce264:01C58",
  "jp": "ヤマト「陶酔してる‥‥これはもう末期ね」",
  "off": 7256,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7258,
  "text_len": 26
 },
 {
  "id": "sce264:01C78",
  "jp": "トウヤ「そ、そうか。まぁ、頑張れよ」",
  "off": 7288,
