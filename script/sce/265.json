  "off": 3037,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3039,
  "text_len": 26
 },
 {
  "id": "sce265:00BFD",
  "jp": "トウヤ「そ、そうか。まぁ、頑張れよ」",
