  "status": "todo",
  "style": 0,
  "text_off": 6478,
  "text_len": 29
 },
 {
  "id": "sce349:0196F",
  "jp": "佳澄美「うん‥‥だって透夜ちゃんが選んだことだもの」",
  "off": 6511,
