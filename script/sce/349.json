  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6513,
  "text_len": 34
 },
 {
  "id": "sce349:01997",
  "jp": "晃一郎「‥‥そっか。{nl}　‥‥でも、あの透夜がねぇ‥‥」",
