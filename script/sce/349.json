  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6625,
  "text_len": 24
 },
 {
  "id": "sce349:019FD",
  "jp": "透夜「ああ‥‥それにセリカと約束したしな」",
  "off": 6653,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6655,
  "text_len": 27
 },
 {
  "id": "sce349:01A1E",
  "jp": "フォルゼン「そうですか‥‥わかりました。{nl}　それでは参りましょうか」",
  "off": 6686,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6688,
  "text_len": 37
 },
 {
  "id": "sce349:01A6B",
  "jp": "セリカ「はあっ‥‥、はあっ‥‥！」",
  "off": 6763,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6765,
  "text_len": 22
 },
 {
  "id": "sce349:01A87",
  "jp": "エミィ「きゃっ⁉」",
  "off": 6791,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6793,
  "text_len": 10
 },
 {
  "id": "sce349:01A97",
  "jp": "セリカ「うわぁっ⁉」",
  "off": 6807,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6809,
  "text_len": 11
 },
 {
  "id": "sce349:01AC2",
  "jp": "セリカ「あいたたたぁ～」",
  "off": 6850,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6852,
  "text_len": 13
 },
 {
  "id": "sce349:01AD5",
  "jp": "エミィ「だ、大丈夫ですか、セリカ様⁉」",
  "off": 6869,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6871,
  "text_len": 24
 },
 {
  "id": "sce349:01AF3",
  "jp": "セリカ「え？　あぁ、平気、平気‥‥ちょっと、{nl}　息が‥‥あがっちゃって‥‥はぁ、ふぅ‥‥」",
  "off": 6899,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6901,
  "text_len": 59
 },
 {
  "id": "sce349:01B34",
  "jp": "エミィ「いったい何をそんなに急いでいるのか知りませんけど{nl}　廊下は静かに、ですわ。セリカ様」",
  "off": 6964,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6966,
  "text_len": 53
 },
 {
  "id": "sce349:01B6F",
  "jp": "セリカ「へへへ、ごめんごめん、と、そうだ、急がなきゃ！」",
  "off": 7023,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7025,
  "text_len": 30
 },
 {
  "id": "sce349:01BB7",
  "jp": "エミィ「あ、セリカ様⁉」",
  "off": 7095,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7097,
  "text_len": 14
 },
 {
  "id": "sce349:01BCB",
  "jp": "セリカ「あぁー、ごめん！　ちょっと急いでるの！　じゃ！」",
  "off": 7115,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7117,
  "text_len": 33
 },
 {
  "id": "sce349:01BF6",
  "jp": "エミィ「え⁉　あ、ちょっとセリカ様～⁉」",
  "off": 7158,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7160,
  "text_len": 24
 },
 {
  "id": "sce349:01C14",
  "jp": "エミィ「行っちゃった‥‥{nl}　なんだったのかしら‥‥あんなにめかしこんで」",
  "off": 7188,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7190,
  "text_len": 41
 },
 {
  "id": "sce349:01C4A",
  "jp": "フェイン「姫！　姫～！」",
  "off": 7242,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7244,
  "text_len": 17
 },
 {
  "id": "sce349:01C61",
  "jp": "エミィ「はぁ‥‥今日はなんだか慌ただしい日ですわねぇ。{nl}　ほらそこっ、廊下は静かに！　ですわよっ！」",
  "off": 7265,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7267,
  "text_len": 61
 },
 {
  "id": "sce349:01CA4",
  "jp": "フェイン「あっ、二世！　姫を見なかったか？」",
  "off": 7332,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7334,
  "text_len": 28
 },
 {
  "id": "sce349:01CC6",
  "jp": "エミィ「うぐっ‥‥まだ言うか‥‥{nl}　まったく、あなたには記憶力というものが{nl}　ないようですわね」",
  "off": 7366,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7368,
  "text_len": 56
 },
 {
  "id": "sce349:01D04",
  "jp": "フェイン「うるさいぞ二世。知らんならお前に用はない」",
  "off": 7428,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7430,
  "text_len": 31
 },
 {
  "id": "sce349:01D29",
  "jp": "エミィ「あっ、ちょ、ちょっと！」",
  "off": 7465,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7467,
  "text_len": 17
 },
 {
  "id": "sce349:01D40",
  "jp": "フェイン「なんだ？」",
  "off": 7488,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7490,
  "text_len": 11
 },
 {
  "id": "sce349:01D51",
  "jp": "エミィ「あ、あなた王宮騎士団への入団試験を{nl}　お受けになると聞きましたが‥‥」",
  "off": 7505,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7507,
  "text_len": 52
 },
 {
  "id": "sce349:01D8B",
  "jp": "フェイン「そうだか‥‥それがどうかしたのか？」",
  "off": 7563,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7565,
  "text_len": 26
 },
 {
  "id": "sce349:01DAB",
  "jp": "エミィ「試験には実技と筆記がありますわよね？{nl}　わたくしはご存じの通り錬金学士として将来を{nl}　嘱望されている身‥‥」",
  "off": 7595,
  "len": 81,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7597,
  "text_len": 78
 },
 {
  "id": "sce349:01DFF",
  "jp": "フェイン「だからなにが言いたい？」",
  "off": 7679,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7681,
  "text_len": 19
 },
 {
  "id": "sce349:01E18",
  "jp": "エミィ「だから、その‥‥勉強を教えてあげても{nl}　よろしくてよ？」",
  "off": 7704,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7706,
  "text_len": 38
 },
 {
  "id": "sce349:01E44",
  "jp": "フェイン「‥‥専門が違うだろ？」",
  "off": 7748,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7750,
  "text_len": 22
 },
 {
  "id": "sce349:01E60",
  "jp": "エミィ「わ、わたくしほどの才能があれば入団試験程度の{nl}　問題など教えることは容易いことですわ」",
  "off": 7776,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7778,
  "text_len": 60
 },
 {
  "id": "sce349:01EA2",
  "jp": "フェイン「でも‥‥」",
  "off": 7842,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7844,
  "text_len": 12
 },
 {
  "id": "sce349:01EBE",
  "jp": "イ<E1>ェル「‥‥教えてもらってはどうです？」",
  "off": 7870,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7872,
  "text_len": 25
 },
 {
  "id": "sce349:01EDD",
  "jp": "エミィ「イ、イ<E1>ェル様！」",
  "off": 7901,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7903,
  "text_len": 15
 },
 {
  "id": "sce349:01EF2",
  "jp": "フェイン「お言葉ですが‥‥」",
  "off": 7922,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7924,
  "text_len": 18
 },
 {
  "id": "sce349:01F0A",
  "jp": "イ<E1>ェル「その為に毎日遅くまで図書院で{nl}　騎士教本などを読んでいるのですから。{nl}　ね、エミィ？」",
  "off": 7946,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7948,
  "text_len": 61
 },
 {
  "id": "sce349:01F4D",
  "jp": "エミィ「あ、いや、それは‥‥」",
  "off": 8013,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8015,
  "text_len": 17
 },
 {
  "id": "sce349:01F64",
  "jp": "フェイン「お前‥‥」",
  "off": 8036,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8038,
  "text_len": 13
 },
 {
  "id": "sce349:01F77",
  "jp": "エミィ「‥‥」",
  "off": 8055,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8057,
  "text_len": 9
 },
 {
  "id": "sce349:01F86",
  "jp": "イ<E1>ェル「あっ、そうそう。セリカ様ならもうとっくに{nl}　タワーへ向かいましたよ」",
  "off": 8070,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8072,
  "text_len": 42
 },
 {
  "id": "sce349:01FB6",
  "jp": "フェイン「なっ！　そ、そうですか！　では失礼します！」",
  "off": 8118,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8120,
  "text_len": 32
 },
 {
  "id": "sce349:01FDC",
  "jp": "エミィ「あ、ちょっと！　いったい今日は何があるって{nl}　言うんですの⁉」",
  "off": 8156,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8158,
  "text_len": 41
 },
 {
  "id": "sce349:0200B",
  "jp": "フェイン「アイツが返ってくるんだよ！{nl}　早くこの事を姫にお伝えしなければ‼」",
  "off": 8203,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8205,
  "text_len": 45
 },
 {
  "id": "sce349:02045",
  "jp": "エミィ「アイツ？　あっ！　ひょっとしてセリカ様が{nl}　急いでおられたのは‥‥」",
  "off": 8261,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8263,
  "text_len": 44
 },
 {
  "id": "sce349:02077",
  "jp": "イ<E1>ェル「ええ。再びこの地へやってきた‥‥{nl}　いえ、帰ってきたのです」",
  "off": 8311,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8313,
  "text_len": 40
 },
 {
  "id": "sce349:020A5",
  "jp": "エミィ「そうですか‥‥」",
  "off": 8357,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8359,
  "text_len": 14
 },
 {
  "id": "sce349:020B9",
  "jp": "イ<E1>ェル「フェインも階位が上がり部下を持つ身と{nl}　なるのに相変わらずですね」",
  "off": 8377,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8379,
  "text_len": 47
 },
 {
  "id": "sce349:020EE",
  "jp": "エミィ「‥‥ええ、全然変りません‥‥」",
  "off": 8430,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8432,
  "text_len": 26
 },
 {
  "id": "sce349:0210E",
  "jp": "イ<E1>ェル「もしかして余計なお世話でしたか？」",
  "off": 8462,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8464,
  "text_len": 27
 },
 {
  "id": "sce349:0212F",
  "jp": "エミィ「‥‥いえ」",
  "off": 8495,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8497,
  "text_len": 11
 },
 {
  "id": "sce349:02140",
  "jp": "イ<E1>ェル「エミィ。そんなに焦る必要はありませんよ。{nl}　人を好きになるというのは走り続けるだけではダメです。{nl}　ときどき振り返って、相手を見ないとね」",
  "off": 8512,
  "len": 89,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8514,
  "text_len": 86
 },
 {
  "id": "sce349:0219C",
  "jp": "エミィ「‥‥難しい‥‥ですね」",
  "off": 8604,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8606,
  "text_len": 20
 },
 {
  "id": "sce349:021B6",
  "jp": "イ<E1>ェル「そうですよ。だから素敵なものなのです」",
  "off": 8630,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8632,
  "text_len": 26
 },
 {
  "id": "sce349:021D6",
  "jp": "エミィ「はい、そうですね。わたくしもそう思います」",
  "off": 8662,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8664,
  "text_len": 26
 },
 {
  "id": "sce349:02212",
  "jp": "フォルゼン「さっ、着きましたよ」",
  "off": 8722,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8724,
  "text_len": 17
 },
 {
  "id": "sce349:02229",
  "jp": "トウヤ「あれからもう2週間か‥‥」",
  "off": 8745,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8747,
  "text_len": 21
 },
 {
  "id": "sce349:0224B",
  "jp": "トウヤ「あっ‥‥」",
  "off": 8779,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8781,
  "text_len": 11
 },
 {
  "id": "sce349:0225C",
  "jp": "フォルゼン「おやおや、待ちきれなかったようですね‥‥」",
  "off": 8796,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8798,
  "text_len": 30
 },
 {
