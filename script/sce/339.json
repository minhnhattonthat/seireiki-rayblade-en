  "status": "todo",
  "style": 0,
  "text_off": 1732,
  "text_len": 14
 },
 {
  "id": "sce339:006D6",
  "jp": "セリカ「ちょっと資材のほうが乏しくなってきたし、{nl}　ライブレードの部品も足りないものがでてきたしね」",
  "off": 1750,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1752,
  "text_len": 57
 },
 {
  "id": "sce339:00715",
  "jp": "ユミール「艦長、よろしいですか？」",
  "off": 1813,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1815,
  "text_len": 21
 },
 {
  "id": "sce339:00730",
