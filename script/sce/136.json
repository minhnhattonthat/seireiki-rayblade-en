  "id": "sce136:00E61",
  "jp": "セリカ「笑い事じゃないでしょ⁉{nl}　あなた自分がやったことわかってるの⁉」",
  "off": 3681,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3683,
  "text_len": 42
 },
