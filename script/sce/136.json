  "status": "todo",
  "style": 1,
  "text_off": 2511,
  "text_len": 18
 },
 {
  "id": "sce136:009E5",
  "jp": "セリカ「わかった⁉」",
  "off": 2533,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2535,
  "text_len": 11
 },
 {
  "id": "sce136:009F3",
  "jp": "フェイン「は、はい‥‥わかりました‥‥」",
