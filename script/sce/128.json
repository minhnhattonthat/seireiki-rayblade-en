  "text_len": 17
 },
 {
  "id": "sce128:00A11",
  "jp": "？？「もぅ、ノリがわるいなぁ‥‥{nl}　ちょっとお茶貰でラブリーなジョークじゃない」",
  "off": 2577,
  "len": 51,
