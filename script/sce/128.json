  "style": 0,
  "text_off": 4199,
  "text_len": 26
 },
 {
  "id": "sce128:0108A",
  "jp": "？？「あーっ！　もぅうるさい！{nl}　決まってないって言ってるの！{nl}　もぅ、勝手にやれば！」",
  "off": 4234,
  "len": 58,
