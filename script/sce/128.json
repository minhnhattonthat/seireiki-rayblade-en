  "status": "todo",
  "style": 0,
  "text_off": 2186,
  "text_len": 87
 },
 {
  "id": "sce128:008EA",
  "jp": "？？「もういい！　そんなに嫌なら勝手にすれば！　ふん！」",
  "off": 2282,
