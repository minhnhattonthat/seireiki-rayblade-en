  "status": "todo",
  "style": 0,
  "text_off": 4054,
  "text_len": 75
 },
 {
  "id": "sce128:01035",
  "jp": "？？「まだ詳細が決まってないからほりゅーなの」",
  "off": 4149,
  "len": 32,
