  "status": "todo",
  "style": 0,
  "text_off": 503,
  "text_len": 96
 },
 {
  "id": "sce128:00261",
  "jp": "トウヤ「‥‥あっ、切りやがった‥‥{nl}　とにかくやるしかねぇ。動いてくれよ‥‥」",
  "off": 609,
