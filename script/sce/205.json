  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2211,
  "text_len": 41
 },
 {
  "id": "sce205:008D0",
  "jp": "ガリュード「このリーボーフェンと聖霊機の今後が{nl}　決まりしだい、ヨークに戻る」",
  "off": 2256,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2258,
  "text_len": 50
 },
 {
  "id": "sce205:00908",
  "jp": "フェイン「え⁈　と、ともに戦っては{nl}　いただけないのですか⁉」",
