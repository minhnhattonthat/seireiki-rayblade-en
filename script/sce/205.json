  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3030,
  "text_len": 38
 },
 {
  "id": "sce205:00C00",
  "jp": "セリカ「あれ？　聞いてなかったの？{nl}　う～ん‥‥ユミール、お願い」",
  "off": 3072,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3074,
  "text_len": 41
 },
