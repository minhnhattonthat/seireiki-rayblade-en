 },
 {
  "id": "sce402:00979",
  "jp": "カスミ「え？」",
  "off": 2425,
  "len": 11,
  "en": "Kasumi: Huh?",
  "status": "translated",
  "style": 0,
  "text_off": 2427,
  "text_len": 8
 },
 {
  "id": "sce402:00987",
  "jp": "トウヤ「俺、お前に言われるまで忘れていた。{nl}　あの時だって、あそこまで言われてやっと‥‥」",
  "off": 2439,
  "len": 56,
  "en": "Touya: I'd forgotten until you told me. Even back then, it took you spelling it out before I finally...",
  "status": "translated",
  "style": 0,
  "text_off": 2441,
  "text_len": 53
 },
 {
  "id": "sce402:009C6",
  "jp": "カスミ「ううん。ちゃんと思い出してくれたもん。{nl}　それだけで十分だよ」",
  "off": 2502,
  "len": 42,
  "en": "Kasumi: No. You remembered, after all. That's enough for me.",
  "status": "translated",
  "style": 0,
  "text_off": 2504,
  "text_len": 39
 },
 {
  "id": "sce402:009F3",
  "jp": "トウヤ「そ、そうか。{nl}　でもまあ、全然ロマンチックじゃなかったけどな」",
  "off": 2547,
  "len": 40,
  "en": "Touya: R-right. Still, it wasn't romantic at all, though.",
  "status": "translated",
  "style": 0,
  "text_off": 2549,
  "text_len": 37
 },
 {
  "id": "sce402:00A1E",
  "jp": "カスミ「‥‥ううん。そんなことないよ。{nl}{ctl:3C3E}{face:84FF10}　それに‥‥」",
  "off": 2590,
  "len": 42,
  "en": "Kasumi: ...No. That's not true.{ctl:3C3E}{face:84FF10} And besides...",
  "status": "translated",
  "style": 0,
  "text_off": 2592,
  "text_len": 39
 },
 {
  "id": "sce402:00A4B",
