  "en": "Gabon: See what?",
  "status": "translated",
  "style": 0,
  "text_off": 7602,
  "text_len": 11
 },
 {
  "id": "sce402:01DC1",
  "jp": "ミヤスコ「そ、そう‥‥ですか。{nl}　いえ、なんでもありません」",
