[
 {
  "id": "sce185:0057C",
  "jp": "トウヤ「訊きたいことがあるんだが‥‥」",
  "off": 1404,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1406,
  "text_len": 22
 },
 {
  "id": "sce185:00598",
  "jp": "クロビス「おう、なんだ？　女の口説き方か？」",
  "off": 1432,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1434,
  "text_len": 28
 },
 {
  "id": "sce185:005BA",
  "jp": "トウヤ「‥‥あんたと一緒にしねぇでくれ。{nl}　オーレリィのことだよ」",
  "off": 1466,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1468,
  "text_len": 38
 },
 {
  "id": "sce185:005E6",
  "jp": "クロビス「なんだ、オーレリィの口説き方か？{nl}　そいつは難儀な問題だぞ」",
  "off": 1510,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1512,
  "text_len": 44
 },
 {
  "id": "sce185:00618",
  "jp": "トウヤ「あんたはそのことしか頭にねぇのか⁈」",
  "off": 1560,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1562,
  "text_len": 24
 },
 {
  "id": "sce185:00636",
  "jp": "クロビス「まぁ、落ち着け。この前のことだろ？」",
  "off": 1590,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1592,
  "text_len": 27
 },
 {
  "id": "sce185:00657",
  "jp": "トウヤ「ああ‥‥」",
  "off": 1623,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1625,
  "text_len": 11
 },
 {
  "id": "sce185:00668",
  "jp": "クロビス「もうあいつには訊いたのか？」",
  "off": 1640,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1642,
  "text_len": 21
 },
 {
  "id": "sce185:00683",
  "jp": "トウヤ「ああ。自分の問題だって答えてくれなかった。{nl}　あんたが落ち込んでいたあいつを励ましたことは聞いた。{nl}　なぁ、もしかしてあいつ、あんたのこと‥‥」",
  "off": 1667,
  "len": 90,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1669,
  "text_len": 87
 },
 {
  "id": "sce185:006E0",
  "jp": "クロビス「‥‥トウヤ。お前、あいつのことを{nl}　どう思っている？」",
  "off": 1760,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1762,
  "text_len": 37
 },
 {
  "id": "sce185:0070B",
  "jp": "トウヤ「え？　どうって‥‥」",
  "off": 1803,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1805,
  "text_len": 17
 },
 {
  "id": "sce185:00722",
  "jp": "クロビス「ただ、心配なだけなら、これ以上あいつに{nl}　かまうな。そうじゃないなら答えてやろう」",
  "off": 1826,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1828,
  "text_len": 51
 },
 {
  "id": "sce185:0075B",
  "jp": "トウヤ「？」",
  "off": 1883,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1885,
  "text_len": 7
 },
 {
  "id": "sce185:00768",
  "jp": "クロビス「‥‥あいつのことを仲間として心配しているのか、{nl}　一人の女のとして心配しているのか、どっちだ？」",
  "off": 1896,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1898,
  "text_len": 65
 },
 {
  "id": "sce185:007AF",
  "jp": "トウヤ「え⁈　そ、それは‥‥」",
  "off": 1967,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1969,
  "text_len": 18
 },
 {
  "id": "sce185:007C7",
  "jp": "クロビス「‥‥」",
  "off": 1991,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1993,
  "text_len": 10
 },
 {
  "id": "sce185:007D7",
  "jp": "　そりゃ、仲間として‥‥{nl}　もちろん、仲間以上の存在として心配している",
  "off": 2007,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 128,
  "text_off": 2009,
  "text_len": 47
 },
 {
  "id": "sce185:00818",
  "jp": "クロビス「‥‥本気でいってんのか？」",
  "off": 2072,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2074,
  "text_len": 23
 },
 {
  "id": "sce185:00835",
  "jp": "トウヤ「あ、ああ‥‥」",
  "off": 2101,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2103,
  "text_len": 13
 },
 {
  "id": "sce185:00848",
  "jp": "クロビス「‥‥」",
  "off": 2120,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2122,
  "text_len": 10
 },
 {
  "id": "sce185:00858",
  "jp": "トウヤ「‥‥」",
  "off": 2136,
  "len": 12,
  "en": "Touya: ...",
  "status": "translated",
  "style": 0,
  "text_off": 2138,
  "text_len": 9
 },
 {
  "id": "sce185:00867",
  "jp": "　‥‥本当は仲間以上に思っている{nl}　‥‥‥‥",
  "off": 2151,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 128,
  "text_off": 2153,
  "text_len": 35
 },
 {
  "id": "sce185:0089C",
  "jp": "クロビス「‥‥そうか。わかった」",
  "off": 2204,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2206,
  "text_len": 18
 },
 {
  "id": "sce185:008B4",
  "jp": "トウヤ「だが、心配してることには‥‥」",
  "off": 2228,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2230,
  "text_len": 23
 },
 {
  "id": "sce185:008D1",
  "jp": "クロビス「そういう問題じゃない。{nl}　悪かったな。もう忘れてくれ」",
  "off": 2257,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2259,
  "text_len": 36
 },
 {
  "id": "sce185:008FD",
  "jp": "ヤマト「‥‥結局、聞けニャかったね‥‥」",
  "off": 2301,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2303,
  "text_len": 27
 },
 {
  "id": "sce185:0091E",
  "jp": "トウヤ「‥‥」",
  "off": 2334,
  "len": 12,
  "en": "Touya: ...",
  "status": "translated",
  "style": 0,
  "text_off": 2336,
  "text_len": 9
 },
 {
  "id": "sce185:0093B",
  "jp": "クロビス「そうか‥‥{nl}　よし、なら話そう。結果からいうと俺とあいつとの間には{nl}　仲間以上の関係はない。{nl}　だが、あいつはこんな俺に好意をよせてくれている。{nl}　しかし、俺はずっと気づかないフリをしてきた」",
  "off": 2363,
  "len": 122,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2365,
  "text_len": 119
 },
 {
  "id": "sce185:009B8",
  "jp": "トウヤ「‥‥なぜ？」",
  "off": 2488,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2490,
  "text_len": 13
 },
 {
  "id": "sce185:009CB",
  "jp": "クロビス「俺にはあいつの想いを受け止める資格はない。{nl}　愛するひとを守れないような男ではな」",
  "off": 2507,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2509,
  "text_len": 55
 },
 {
  "id": "sce185:00A08",
  "jp": "トウヤ「愛するひと？」",
  "off": 2568,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2570,
  "text_len": 13
 },
 {
  "id": "sce185:00A1B",
  "jp": "クロビス「妻さ‥‥」",
  "off": 2587,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2589,
  "text_len": 13
 },
 {
  "id": "sce185:00A2E",
  "jp": "トウヤ「え⁈　あんた結婚してたのか⁉」",
  "off": 2606,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2608,
  "text_len": 23
 },
 {
  "id": "sce185:00A4B",
  "jp": "クロビス「ああ」",
  "off": 2635,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2637,
  "text_len": 8
 },
 {
  "id": "sce185:00A59",
  "jp": "トウヤ「そうか‥‥それなら不倫ってことに‥‥ん？{nl}　でも、守れなかったって‥‥もしかして亡くなったのか？」",
  "off": 2649,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2651,
  "text_len": 65
 },
 {
  "id": "sce185:00AA0",
  "jp": "クロビス「‥‥ああ」",
  "off": 2720,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2722,
  "text_len": 12
 },
 {
  "id": "sce185:00AB2",
  "jp": "トウヤ「‥‥す、すまねぇ‥‥」",
  "off": 2738,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2740,
  "text_len": 19
 },
 {
  "id": "sce185:00ACB",
  "jp": "クロビス「‥‥気にするな。{nl}　あいつが死んで、その大切さに気づくなんてな‥‥{nl}　俺はとんだ大馬鹿者だ‥‥」",
  "off": 2763,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2765,
  "text_len": 69
 },
 {
  "id": "sce185:00B16",
  "jp": "トウヤ「‥‥愛してなかったワケじゃねぇんだろ？」",
  "off": 2838,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2840,
  "text_len": 28
 },
 {
  "id": "sce185:00B38",
  "jp": "クロビス「‥‥妻は、エレナは軍時代の上官の娘だった。{nl}　トップエースであることが当り前となり、それが{nl}　プレッシャーとなっていた俺はエレナの父親の権力を{nl}　頼るまでに腐っていた。{nl}　俺は自分の地位を確立するために{nl}　あいつを利用したんだ」",
  "off": 2872,
  "len": 151,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2874,
  "text_len": 148
 },
 {
  "id": "sce185:00BD2",
  "jp": "トウヤ「‥‥」",
  "off": 3026,
  "len": 12,
  "en": "Touya: ...",
  "status": "translated",
  "style": 0,
  "text_off": 3028,
  "text_len": 9
 },
 {
  "id": "sce185:00BE1",
  "jp": "クロビス「あいつはそんな俺を愛してくれた。{nl}　だが、その時の俺はそれを苦痛としか感じられなかった。{nl}　エレナを利用したという罪悪感と自分の地位を{nl}　守る為の束縛感にな。{nl}　俺は表向きは良き夫を演じた。{nl}　‥‥最低な人間だった」",
  "off": 3041,
  "len": 149,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3043,
  "text_len": 146
 },
 {
  "id": "sce185:00C79",
  "jp": "トウヤ「もしかして奥さんが亡くなったのって‥‥」",
  "off": 3193,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3195,
  "text_len": 28
 },
 {
  "id": "sce185:00C9B",
  "jp": "クロビス「いや、交通事故だ。その時はたいしたことが{nl}　ないと言って病院にも行かなかったが、頭を打っていた{nl}　らしく、突然倒れて‥‥」",
  "off": 3227,
  "len": 85,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3229,
  "text_len": 82
 },
 {
  "id": "sce185:00CF3",
  "jp": "トウヤ「‥‥そのまま？」",
  "off": 3315,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3317,
  "text_len": 15
 },
 {
  "id": "sce185:00D08",
  "jp": "クロビス「一度意識を取り戻した。その時、あいつ、{nl}　俺に微笑みかけてこう言った‥‥{nl}　“あなたは自由よ”ってな。{nl}　あいつはそんなことになっても自分のことよりも、{nl}　俺のことを気遣っていたんだ。{nl}　もうろうとする意識で俺の手を握ったエレナの最期の{nl}　言葉は“愛してる”だった‥‥{nl}　衝撃だった。後悔した。{nl}　全部わかっていながらそれでも、こんな俺を愛してると{nl}　言ってくれたんだ」",
  "off": 3336,
  "len": 238,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3338,
  "text_len": 235
 },
 {
  "id": "sce185:00DF9",
  "jp": "トウヤ「‥‥」",
  "off": 3577,
  "len": 12,
  "en": "Touya: ...",
  "status": "translated",
  "style": 0,
  "text_off": 3579,
  "text_len": 9
 },
 {
  "id": "sce185:00E08",
  "jp": "クロビス「親戚も友人もみんな俺を責めなかった。{nl}　それどころか励ましの言葉をかけてくれた。{nl}　俺はいたたまれなかった。{nl}　だから俺は軍を辞め、現実から目を背けた。{nl}　絶望という免罪符を振りかざし逃げたんだ」",
  "off": 3592,
  "len": 130,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3594,
  "text_len": 127
 },
 {
  "id": "sce185:00E8D",
  "jp": "トウヤ「けど、今のあんたからはそんなこと想像も{nl}　できねぇぞ‥‥」",
  "off": 3725,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3727,
  "text_len": 38
 },
 {
  "id": "sce185:00EB9",
  "jp": "クロビス「今の俺は自分を騙して生きているようなもんだ。{nl}　戦うことで自分を見失わずにいる。{nl}　そんな人間に、人を愛する資格などない」",
  "off": 3769,
  "len": 86,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3771,
  "text_len": 83
 },
 {
  "id": "sce185:00F12",
  "jp": "トウヤ「だからオーレリィの気持ちに応えられないのか‥‥{nl}　‥‥なんで、そこまで俺に話したんだ？」",
  "off": 3858,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3860,
  "text_len": 59
 },
 {
  "id": "sce185:00F53",
  "jp": "クロビス「フッ‥‥何故だろうな？{nl}　俺もヤキが回ったか」",
  "off": 3923,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3925,
  "text_len": 35
 },
 {
  "id": "sce185:00F7C",
  "jp": "トウヤ「おいおい‥‥それ嫌味か？」",
  "off": 3964,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3966,
  "text_len": 22
 },
 {
  "id": "sce185:00F98",
  "jp": "クロビス「ははは、冗談だ。{nl}　‥‥だが、いつまでも逃げているワケにもいかんな。{nl}　オーレリィとちゃんと話をつける時かもな」",
  "off": 3992,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3994,
  "text_len": 69
 },
 {
  "id": "sce185:00FE3",
  "jp": "トウヤ「‥‥しかしオーレリィはあんたのこと‥‥」",
  "off": 4067,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4069,
  "text_len": 29
 },
 {
  "id": "sce185:01006",
  "jp": "クロビス「あいつも愛されることに慣れていない人間だ。{nl}　ただ、優しさと憧れを恋と勘違いしているだけだ。{nl}　それに、今の俺は誰かを愛することはできそうにない。{nl}　これは逃げているとかじゃなく、本心だ。{nl}　こんな状態であいつの想いを受け止めても{nl}　傷つけるだけだ。誰かを悲しませるのは{nl}　もうたくさんだからな」",
  "off": 4102,
  "len": 180,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4104,
  "text_len": 177
 },
 {
  "id": "sce185:010BD",
  "jp": "トウヤ「そんなことして大丈夫なのか？{nl}　あいつ、強がってるが‥‥」",
  "off": 4285,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4287,
  "text_len": 40
 },
 {
  "id": "sce185:010EB",
  "jp": "クロビス「だからお前に話しているんだ。{nl}　あいつが自分のことを話したのはお前が初めてだろう。{nl}　あいつ自身気づいていないが、お前のことを信頼している{nl}　証拠だ。だから、あいつを支えてやってほしい」",
  "off": 4331,
  "len": 117,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4333,
  "text_len": 114
 },
 {
  "id": "sce185:01163",
  "jp": "トウヤ「俺が‥‥？」",
  "off": 4451,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4453,
  "text_len": 14
 },
 {
  "id": "sce185:01177",
  "jp": "クロビス「さっきの言葉は嘘か？」",
  "off": 4471,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4473,
  "text_len": 20
 },
 {
  "id": "sce185:01191",
  "jp": "トウヤ「‥‥いや。そうだな。{nl}　どこまでできるかわからねぇが‥‥」",
  "off": 4497,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4499,
  "text_len": 37
 },
 {
  "id": "sce185:011BC",
  "jp": "クロビス「お前ならできる」",
  "off": 4540,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4542,
  "text_len": 14
 },
