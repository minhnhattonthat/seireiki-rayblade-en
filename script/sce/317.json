  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 513,
  "text_len": 22
 },
 {
  "id": "sce317:0021B",
  "jp": "トウヤ「ちょっと訊きたいことがあってな。今いいか？」",
  "off": 539,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 541,
  "text_len": 29
 },
 {
  "id": "sce317:0023E",
  "jp": "カスミ「うん。あっ、中にはいって」",
  "off": 574,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 576,
  "text_len": 18
 },
 {
  "id": "sce317:0027E",
  "jp": "カスミ「訊きたいことってなに？」",
  "off": 638,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 640,
  "text_len": 18
 },
 {
  "id": "sce317:00296",
  "jp": "トウヤ「ああ。ちょっと昔のことを思い出して‥‥」",
  "off": 662,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 664,
  "text_len": 29
 },
 {
  "id": "sce317:002B9",
  "jp": "カスミ「昔のこと？」",
  "off": 697,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 699,
  "text_len": 12
 },
 {
  "id": "sce317:002CB",
  "jp": "トウヤ「‥‥小学2年の時。覚えてるか？」",
  "off": 715,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 717,
  "text_len": 28
 },
 {
  "id": "sce317:002ED",
  "jp": "カスミ「あっ‥‥も、もちろん。{nl}　トウヤちゃんと出会った時だもん」",
  "off": 749,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 751,
  "text_len": 38
 },
 {
  "id": "sce317:00319",
  "jp": "トウヤ「そう。あの時なんだけど‥‥」",
  "off": 793,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 795,
  "text_len": 21
 },
 {
  "id": "sce317:00334",
  "jp": "　どうして俺なんかに話しかけたんだ？{nl}　そういやあ、あの時から眼鏡かけてたよな？",
  "off": 820,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 128,
  "text_off": 822,
  "text_len": 47
 },
 {
  "id": "sce317:0036F",
  "jp": "カスミ「え？」",
  "off": 879,
  "len": 11,
  "en": "Kasumi: Huh?",
  "status": "translated",
  "style": 0,
  "text_off": 881,
  "text_len": 8
 },
 {
  "id": "sce317:0037D",
  "jp": "トウヤ「だってそうだろ？　あの時の俺ってクラスから{nl}　孤立してたし、下手すりゃお前まで同じように{nl}　なってたかもしれねぇのに」",
  "off": 893,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 895,
  "text_len": 72
 },
 {
  "id": "sce317:003CB",
  "jp": "カスミ「‥‥ねえ、トウヤちゃん」",
  "off": 971,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 973,
  "text_len": 18
 },
 {
  "id": "sce317:003E3",
  "jp": "トウヤ「ん？」",
  "off": 995,
  "len": 11,
  "en": "Touya: Hm?",
  "status": "translated",
  "style": 0,
  "text_off": 997,
  "text_len": 8
 },
 {
  "id": "sce317:003F1",
  "jp": "カスミ「私がトウヤちゃんに出会ったのっていつだと思う？」",
  "off": 1009,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1011,
  "text_len": 33
 },
 {
  "id": "sce317:00418",
  "jp": "トウヤ「いつって‥‥俺に話しかけて来たあの時だろ？」",
  "off": 1048,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1050,
  "text_len": 33
 },
 {
  "id": "sce317:0043F",
  "jp": "カスミ「ちがうよ。あれが初めてじゃないよ」",
  "off": 1087,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1089,
  "text_len": 22
 },
 {
  "id": "sce317:0045B",
  "jp": "トウヤ「あ、ああ、そりゃ、同じクラスだもんな。{nl}　俺が転校してきた最初の日‥‥」",
  "off": 1115,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1117,
  "text_len": 49
 },
 {
  "id": "sce317:00492",
  "jp": "カスミ「（ふるふるふる）」",
  "off": 1170,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1172,
  "text_len": 13
 },
 {
  "id": "sce317:004A5",
  "jp": "トウヤ「え？」",
  "off": 1189,
  "len": 11,
  "en": "Touya: Huh?",
  "status": "translated",
  "style": 0,
  "text_off": 1191,
  "text_len": 8
 },
 {
  "id": "sce317:004B3",
  "jp": "カスミ「その前の日」",
  "off": 1203,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1205,
  "text_len": 12
 },
 {
  "id": "sce317:004C5",
  "jp": "トウヤ「前の日‥‥？　その前の日って、たしか‥‥あっ」",
  "off": 1221,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1223,
  "text_len": 36
 },
 {
  "id": "sce317:004EF",
  "jp": "カスミ「トウヤちゃんが引っ越して来た日。{nl}　あの時、二階のベランダから見てたの。{nl}　でも、降りていったらトウヤちゃん、もう家の中に{nl}　入ってて‥‥そうしたらおばさまが私に気づいて‥‥{nl}　それが最初だよ」",
  "off": 1263,
  "len": 124,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1265,
  "text_len": 121
 },
 {
  "id": "sce317:0056E",
  "jp": "トウヤ「そりゃわかるワケねぇよ。{nl}　それに引っ越した日のことなんかほとんど覚えてねぇし」",
  "off": 1390,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1392,
  "text_len": 48
 },
 {
  "id": "sce317:005A4",
  "jp": "カスミ「私はちゃんと覚えてるよ。{nl}　その時、おばさまが私に言ってくれた言葉も」",
  "off": 1444,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1446,
  "text_len": 46
 },
 {
  "id": "sce317:005D8",
  "jp": "トウヤ「言葉？」",
  "off": 1496,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1498,
  "text_len": 11
 },
 {
  "id": "sce317:005E9",
  "jp": "カスミ「うん。トウヤちゃんと仲良くしてあげてねって‥‥」",
  "off": 1513,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1515,
  "text_len": 32
 },
 {
  "id": "sce317:0060F",
  "jp": "ヤマト「もしかして、それがトウヤにはニャしかけた理由？」",
  "off": 1551,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1553,
  "text_len": 31
 },
 {
  "id": "sce317:00634",
  "jp": "カスミ「うん。本当はもっと早くしようと思ってたんだけど、{nl}　なかなか勇気が出せなくって‥‥」",
  "off": 1588,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1590,
  "text_len": 55
 },
 {
  "id": "sce317:00671",
  "jp": "トウヤ「でも、あの時、ほっとけないからって‥‥」",
  "off": 1649,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1651,
  "text_len": 27
 },
 {
  "id": "sce317:00692",
  "jp": "カスミ「本当のこと言ったらトウヤちゃん喜んだ？」",
  "off": 1682,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1684,
  "text_len": 29
 },
 {
  "id": "sce317:006B5",
  "jp": "トウヤ「う～ん‥‥余計に避けたかもな」",
  "off": 1717,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1719,
  "text_len": 25
 },
 {
  "id": "sce317:006D4",
  "jp": "カスミ「でしょ？」",
  "off": 1748,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1750,
  "text_len": 10
 },
 {
  "id": "sce317:006E4",
  "jp": "ヤマト「ニャイスニャ判断だったわね」",
  "off": 1764,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1766,
  "text_len": 20
 },
 {
  "id": "sce317:006FE",
  "jp": "カスミ「でも、話しかけた理由はそれだけじゃないよ。{nl}　おばさまに言われなくてもきっと同じことしてたと思う。{nl}　ただそれが早いか遅いかの違いだけだよ」",
  "off": 1790,
  "len": 86,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1792,
  "text_len": 83
 },
 {
  "id": "sce317:00757",
  "jp": "トウヤ「そうだったのか‥‥{nl}　でも、そのおかげで今の俺があるのかもな」",
  "off": 1879,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1881,
  "text_len": 39
 },
 {
  "id": "sce317:00784",
  "jp": "カスミ「そんなおおげさな～」",
  "off": 1924,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1926,
  "text_len": 15
 },
 {
  "id": "sce317:00799",
  "jp": "トウヤ「でも、あの時、空港の事件の時、{nl}　ずっと一緒にいてくれたよな‥‥」",
  "off": 1945,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1947,
  "text_len": 47
 },
 {
  "id": "sce317:007CE",
  "jp": "カスミ「うん‥‥だって、あの時のトウヤちゃん、{nl}　ちゃんと捕まえとかないと消えていなくなっちゃいそう{nl}　だったから‥‥」",
  "off": 1998,
  "len": 70,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2000,
  "text_len": 67
 },
 {
  "id": "sce317:00817",
  "jp": "トウヤ「お前もおじさんもおばさんもヤマトも。{nl}　みんながいたから俺は立ち直れたんだ‥‥」",
  "off": 2071,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2073,
  "text_len": 50
 },
 {
  "id": "sce317:00859",
  "jp": "カスミ「そう思ってくれてうれしいな。{nl}　あっ、そうだ。シスクさんからケーキ貰ったんだ。{nl}　よかったら一緒に食べない？」",
  "off": 2137,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2139,
  "text_len": 66
 },
 {
  "id": "sce317:008A1",
  "jp": "トウヤ「あ、ああ、そうだな。{nl}　それじゃ、もらおうかな」",
  "off": 2209,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2211,
  "text_len": 28
 },
 {
  "id": "sce317:008C3",
  "jp": "カスミ「ちょっとまっててね。お茶も用意するから」",
  "off": 2243,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2245,
  "text_len": 27
 },
 {
  "id": "sce317:008E6",
  "jp": "ヤマト「‥‥カスミっていい子よね」",
  "off": 2278,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2280,
  "text_len": 20
 },
 {
  "id": "sce317:00900",
  "jp": "トウヤ「ああ。昔からな」",
  "off": 2304,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2306,
  "text_len": 13
 },
 {
  "id": "sce317:00926",
  "jp": "　{nl}それから俺達は昔話をしながら{nl}語らいの時を過ごした‥‥",
  "off": 2342,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2344,
  "text_len": 38
 },
 {
  "id": "sce317:00960",
  "jp": "カスミ「え？　うん‥‥たしか小学校にあがる時からかな」",
  "off": 2400,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2402,
  "text_len": 34
 },
 {
  "id": "sce317:00988",
  "jp": "トウヤ「へぇ‥‥やっぱり読書とか勉強のしすぎか？」",
  "off": 2440,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2442,
  "text_len": 32
 },
 {
  "id": "sce317:009AE",
  "jp": "カスミ「う～ん、たしかに本とか読むのは好きだったけど‥‥{nl}　私の目が悪いのは遺伝みたい」",
  "off": 2478,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2480,
  "text_len": 55
 },
 {
  "id": "sce317:009EB",
  "jp": "トウヤ「そういや、おばさんもかなりきてたよな」",
  "off": 2539,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2541,
  "text_len": 23
 },
 {
  "id": "sce317:00A08",
  "jp": "カスミ「うん。そういう家系みたい。{nl}　でも、ある程度進んだら視力の低下は止まったけど」",
  "off": 2568,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2570,
  "text_len": 53
 },
 {
  "id": "sce317:00A43",
  "jp": "トウヤ「今でどれぐらいなんだ？」",
  "off": 2627,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2629,
  "text_len": 18
 },
 {
  "id": "sce317:00A5B",
  "jp": "カスミ「0．01以下」",
  "off": 2651,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2653,
  "text_len": 13
 },
 {
  "id": "sce317:00A6E",
  "jp": "トウヤ「おい、それって‥‥」",
  "off": 2670,
  "len": 19,
  "en": "Touya: Hey, that means...",
  "status": "translated",
  "style": 0,
  "text_off": 2672,
  "text_len": 16
 },
 {
  "id": "sce317:00A84",
  "jp": "カスミ「機械じゃないと測定できないよ。{nl}　だって、一番前に立って一番上のマークが{nl}　分からないもん」",
  "off": 2692,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2694,
  "text_len": 63
 },
 {
  "id": "sce317:00AC9",
  "jp": "トウヤ「にこやかに言ってる場合じゃねぇぞ。{nl}　相当悪いじゃねぇか」",
  "off": 2761,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2763,
  "text_len": 39
 },
 {
  "id": "sce317:00AF6",
  "jp": "カスミ「だから眼鏡をはずしたら‥‥」",
  "off": 2806,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2808,
  "text_len": 22
 },
 {
  "id": "sce317:00B14",
  "jp": "カスミ「これぐらい近づかないと見えないよ」",
  "off": 2836,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2838,
  "text_len": 23
 },
 {
  "id": "sce317:00B31",
  "jp": "トウヤ「‼　そ、そうか‥‥」",
  "off": 2865,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2867,
  "text_len": 17
 },
