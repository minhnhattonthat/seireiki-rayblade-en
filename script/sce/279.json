  "text_off": 5345,
  "text_len": 12
 },
 {
  "id": "sce279:014F1",
  "jp": "ヤマト「カスミって、フェインと‥‥」",
  "off": 5361,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5363,
  "text_len": 20
 },
 {
  "id": "sce279:0150F",
  "jp": "カスミ「？　フェイン君は荷物を運ぶのを{nl}　手伝ってくれただけだよ。{nl}　それがどうかしたの？」",
  "off": 5391,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5393,
  "text_len": 54
 },
 {
  "id": "sce279:0154B",
  "jp": "トウヤ「荷物？」",
  "off": 5451,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5453,
  "text_len": 11
 },
 {
  "id": "sce279:0156E",
  "jp": "カスミ「着替えとかは一人で大丈夫だったけど、{nl}　本なんかはさすがに運べなくって‥‥{nl}　そしたらフェイン君が通りかかって」",
  "off": 5486,
  "len": 76,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5488,
  "text_len": 73
 },
 {
  "id": "sce279:015BD",
  "jp": "トウヤ「それであいつが運んでやるって言い出したんだな？」",
  "off": 5565,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5567,
  "text_len": 32
 },
 {
  "id": "sce279:015F5",
  "jp": "カスミ「うん。よくわかったね」",
  "off": 5621,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5623,
  "text_len": 15
 },
 {
  "id": "sce279:0160A",
  "jp": "トウヤ「まあ、さっきのあいつの態度をみてたら、{nl}　ほっとくワケねぇだろうからな」",
  "off": 5642,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5644,
  "text_len": 42
 },
 {
  "id": "sce279:0163E",
  "jp": "カスミ「フェイン君ってどこかトウヤちゃんに似てるよね」",
  "off": 5694,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5696,
  "text_len": 29
 },
 {
  "id": "sce279:01661",
  "jp": "トウヤ「そうか？」",
  "off": 5729,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5731,
  "text_len": 10
 },
 {
  "id": "sce279:01683",
  "jp": "カスミ「うん。裏表のないところとか、優しいところとか」",
  "off": 5763,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5765,
  "text_len": 30
 },
 {
  "id": "sce279:016A7",
  "jp": "ヤマト「彼の場合は明確ニャ目的がある上での{nl}　行動だと思うけど‥‥」",
  "off": 5799,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5801,
  "text_len": 47
 },
 {
  "id": "sce279:016EE",
  "jp": "カスミ「？」",
  "off": 5870,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5872,
  "text_len": 7
 },
 {
  "id": "sce279:016FB",
  "jp": "トウヤ「もう荷物は大丈夫なのか？{nl}　何かあるなら手伝うぞ」",
  "off": 5883,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5885,
  "text_len": 38
 },
 {
  "id": "sce279:01727",
  "jp": "カスミ「ううん。大丈夫。後は整理するだけだから」",
  "off": 5927,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5929,
  "text_len": 30
 },
 {
  "id": "sce279:0174B",
  "jp": "トウヤ「そうか。まあ、何かあったら遠慮せずに言えよ」",
  "off": 5963,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5965,
  "text_len": 30
 },
 {
  "id": "sce279:01773",
  "jp": "カスミ「うん。そうする」",
  "off": 6003,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6005,
  "text_len": 12
 },
 {
  "id": "sce279:01785",
  "jp": "トウヤ「それじゃ」",
  "off": 6021,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6023,
  "text_len": 9
 },
 {
  "id": "sce279:018B5",
  "jp": "トウヤ「よっ」",
