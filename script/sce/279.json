  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6327,
  "text_len": 7
 },
 {
  "id": "sce279:018CA",
  "jp": "セリカ「ああ、トウヤ。どうしたの？」",
  "off": 6346,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6348,
  "text_len": 19
 },
 {
  "id": "sce279:018E9",
  "jp": "トウヤ「ん？　まぁ、別にこれといって用はねぇけど」",
  "off": 6377,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6379,
  "text_len": 28
 },
 {
  "id": "sce279:01910",
  "jp": "セリカ「ふぅ～ん。それじゃ、私の代わりにこの席を温める{nl}　任務を与えます」",
  "off": 6416,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6418,
  "text_len": 45
 },
 {
  "id": "sce279:01943",
  "jp": "トウヤ「はぁ？」",
  "off": 6467,
  "len": 12,
  "en": "Touya: Huh?",
  "status": "translated",
  "style": 0,
  "text_off": 6469,
  "text_len": 9
 },
 {
  "id": "sce279:01964",
  "jp": "セリカ「暇なんでしょ？」",
  "off": 6500,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6502,
  "text_len": 14
 },
 {
  "id": "sce279:01978",
  "jp": "トウヤ「それほどまでに暇じゃねぇよ。それじゃあな！」",
  "off": 6520,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6522,
  "text_len": 28
 },
 {
  "id": "sce279:0199E",
  "jp": "セリカ「あっ‥‥」",
  "off": 6558,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6560,
  "text_len": 11
 },
 {
  "id": "sce279:019B7",
  "jp": "セリカ「新しい出会いをもとめて放浪中とか？」",
  "off": 6583,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6585,
  "text_len": 29
 },
 {
  "id": "sce279:019DA",
  "jp": "トウヤ「んなわけねぇーだろ」",
  "off": 6618,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6620,
  "text_len": 15
 },
 {
  "id": "sce279:019FA",
  "jp": "セリカ「そうよね。トウヤって、どっちかというと自分から{nl}　積極的に恋を求める感じじゃないものね」",
  "off": 6650,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6652,
  "text_len": 56
 },
 {
  "id": "sce279:01A38",
  "jp": "トウヤ「じゃ、どう見えるんだ？」",
  "off": 6712,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6714,
  "text_len": 18
 },
 {
  "id": "sce279:01A54",
  "jp": "セリカ「う～ん、自分では特に気してない行動が{nl}　相手の心を動かして、いつのまにかうまくいく、{nl}{ctl:783E}{face:041C05}　かな？」",
  "off": 6740,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6742,
  "text_len": 72
 },
 {
  "id": "sce279:01AA2",
  "jp": "トウヤ「そんなに都合のいいことあるかよ」",
  "off": 6818,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6820,
  "text_len": 22
 },
 {
  "id": "sce279:01AC9",
  "jp": "セリカ「まっ、そのうち分かるわよ。{nl}　さて、それじゃ、私そろそろ行くね」",
