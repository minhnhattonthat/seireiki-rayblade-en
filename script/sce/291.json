  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4433,
  "text_len": 33
 },
 {
  "id": "sce291:01176",
  "jp": "カスミ「うん。でも、バートさんが揖意してくれるって」",
