  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4557,
  "text_len": 42
 },
 {
  "id": "sce291:011FE",
  "jp": "トウヤ「なんにしても、そういうことなら取りあえずは{nl}　問題ねぇな」",
