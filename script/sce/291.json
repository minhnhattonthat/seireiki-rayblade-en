  "id": "sce291:010C7",
  "jp": "カスミ「うん。助けてもらってるのに、こんな部屋まで{nl}　揖意してもらって‥‥」",
  "off": 4295,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4297,
  "text_len": 45
 },
 {
  "id": "sce291:010FA",
  "jp": "トウヤ「まあ、考えてみれば一人一部屋なんて{nl}　高待遇だよな。しかもメシまでついてるし」",
  "off": 4346,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4348,
  "text_len": 52
 },
 {
  "id": "sce291:01134",
  "jp": "カスミ「もう、トウヤちゃんったら‥‥」",
