  "status": "todo",
  "style": 0,
  "text_off": 6717,
  "text_len": 22
 },
 {
  "id": "sce020:01A57",
  "jp": "ユミール「とにかく、コルネル村の近くまで行きましょう。{nl}　到着まで、とりあえず待機しておいて」",
  "off": 6743,
  "len": 58,
