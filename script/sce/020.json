  "status": "todo",
  "style": 0,
  "text_off": 6691,
  "text_len": 20
 },
 {
  "id": "sce020:01A3B",
  "jp": "クロビス「ふふふ‥‥秘密兵器さ」",
  "off": 6715,
  "len": 25,
