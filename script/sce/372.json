  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 812,
  "text_len": 20
 },
 {
  "id": "sce372:00344",
  "jp": "デロック「なんかひっかかるんだな。{nl}　でも僕は人間ができているから許してあげるんだな。{nl}　よいしょっと。それじゃ、行くんだな」",
