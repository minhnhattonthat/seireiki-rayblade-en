  "status": "todo",
  "style": 0,
  "text_off": 3773,
  "text_len": 22
 },
 {
  "id": "sce372:00ED7",
  "jp": "クルル「やっぱり！　そんな感じがしてたんだ。{nl}　ねっ、聖霊機、見せて」",
