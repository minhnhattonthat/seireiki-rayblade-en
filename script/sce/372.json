  "status": "todo",
  "style": 0,
  "text_off": 2374,
  "text_len": 12
 },
 {
  "id": "sce372:0096E",
  "jp": "？？？「クルル、そんなにジロジロみてはいけません。{nl}　失礼でしょ？」",
  "off": 2414,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2416,
  "text_len": 40
 },
