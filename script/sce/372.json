  "status": "todo",
  "style": 0,
  "text_off": 6851,
  "text_len": 18
 },
 {
  "id": "sce372:01AD9",
  "jp": "メリッサ「もぅ、忘れてしまったのですか？{nl}　今廿は博止の誕生廿ですよ」",
