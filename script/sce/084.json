  "off": 2655,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2657,
  "text_len": 48
 },
 {
  "id": "sce084:00A99",
  "jp": "レオーネ『う～ん。それもそうだね。{nl}　大体の位置#674関係はわかったし、あとは一人でも{nl}　大丈夫そうね‥‥』",
  "off": 2713,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2715,
  "text_len": 66
 },
 {
  "id": "sce084:00AE1",
  "jp": "トウヤ「なにをブツブツ言ってんだ？」",
  "off": 2785,
