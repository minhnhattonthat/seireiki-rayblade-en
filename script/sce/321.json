  "style": 0,
  "text_off": 1637,
  "text_len": 20
 },
 {
  "id": "sce321:0067D",
  "jp": "セリカ「シルクってあのてらてらして綺麗なやつ？{nl}　そっかぁ‥‥そうだったんだ‥‥」",
