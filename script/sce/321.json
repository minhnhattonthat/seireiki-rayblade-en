  "jp": "アーサー「そうかもしれませんね」",
  "off": 2317,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2319,
  "text_len": 18
 },
 {
  "id": "sce321:00925",
  "jp": "アイ「ねぇ、あたしシルクって使ったことないから{nl}　知らないけど、そんなにいいの？」",
  "off": 2341,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2343,
  "text_len": 44
 },
