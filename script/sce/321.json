  "style": 0,
  "text_off": 1744,
  "text_len": 21
 },
 {
  "id": "sce321:006E9",
  "jp": "オーレリィ「んーなんか、アーサーって、苦学生っていう{nl}　印象だったから、ちょっとね」",
