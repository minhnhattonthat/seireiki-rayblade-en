  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2822,
  "text_len": 17
 },
 {
  "id": "sce338:00B1B",
  "jp": "所員「博士！　今度はなにをしでかしたのですか⁈」",
  "off": 2843,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2845,
  "text_len": 32
 },
 {
  "id": "sce338:00B41",
  "jp": "ムルク「失礼な奴じゃな。ワシはずっとお前の目の前に{nl}　おったではないか」",
  "off": 2881,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2883,
  "text_len": 42
 },
