  "status": "todo",
  "style": 128,
  "text_off": 1906,
  "text_len": 23
 },
 {
  "id": "sce310:00799",
  "jp": "フェイン「だろ？　特に最後のとこなんか言ってる俺が{nl}　しびれるぐらいだからな」",
  "off": 1945,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1947,
  "text_len": 45
 },
 {
