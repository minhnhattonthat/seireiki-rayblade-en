  "status": "todo",
  "style": 0,
  "text_off": 1705,
  "text_len": 27
 },
 {
  "id": "sce310:006C8",
  "jp": "フェイン「なにを！　俺はいたって健康そのもの！{nl}　病気になるほど軟弱にはできていない！{nl}　だっはっはっはっ！」",
  "off": 1736,
  "len": 69,
