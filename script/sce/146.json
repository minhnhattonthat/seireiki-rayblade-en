  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6017,
  "text_len": 8
 },
 {
  "id": "sce146:0178D",
  "jp": "ベイオ「どうした？　頭が痛むのか？」",
