  "len": 79,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3967,
  "text_len": 76
 },
 {
  "id": "sce146:00FCF",
  "jp": "セリカ「ライブレードのほうもあとちょっとよ。{nl}　ま、いよいよというワケね」",
