  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1323,
  "text_len": 81
 },
 {
  "id": "sce146:00580",
  "jp": "ヨアニス「殴ったな‥‥私を殴ったな‥‥{nl}　殴ったなぁぁぁぁっ‼」",
  "off": 1408,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1410,
  "text_len": 41
 },
 {
  "id": "sce146:005BC",
