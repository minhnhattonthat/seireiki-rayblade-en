  "status": "todo",
  "style": 0,
  "text_off": 2534,
  "text_len": 21
 },
 {
  "id": "sce146:009FF",
  "jp": "レシュ「あ、ああ‥‥実は‥‥{nl}　くっ！　な、なんて言えば‥‥ううっ」",
