  "text_len": 13
 },
 {
  "id": "sce146:01912",
  "jp": "デイ「起こしてしまったかな？」",
  "off": 6418,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6420,
  "text_len": 17
 },
 {
  "id": "sce146:01929",
  "jp": "ドリス「‥‥どうしたの？」",
  "off": 6441,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6443,
  "text_len": 16
 },
 {
  "id": "sce146:0193F",
  "jp": "デイ「なんでもない」",
  "off": 6463,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6465,
  "text_len": 10
 },
 {
  "id": "sce146:0194F",
  "jp": "ドリス「‥‥うそ。あの人のことでしょ？」",
  "off": 6479,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6481,
  "text_len": 24
 },
 {
  "id": "sce146:0196D",
  "jp": "デイ「ふっ‥‥バカなことを‥‥」",
  "off": 6509,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6511,
  "text_len": 20
 },
 {
  "id": "sce146:01987",
  "jp": "ドリス「じゃあ、なに？」",
  "off": 6535,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6537,
  "text_len": 13
 },
 {
  "id": "sce146:0199A",
  "jp": "デイ「私自身のことだよ」",
  "off": 6554,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6556,
  "text_len": 15
 },
 {
  "id": "sce146:019AF",
  "jp": "ドリス「‥‥」",
  "off": 6575,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6577,
  "text_len": 9
 },
 {
  "id": "sce146:019BE",
  "jp": "デイ「‥‥やはりな。お前も気づいていたか‥‥{nl}　時々、私が私でない何者かになる‥‥{nl}　そんな気がするんだ‥‥。{nl}　昼間の会談からその感覚は強まる一方だ」",
  "off": 6590,
  "len": 104,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6592,
  "text_len": 101
 },
 {
  "id": "sce146:01A2D",
  "jp": "ドリス「‥‥あなたはあなた。他の誰でもないのよ？{nl}　忘れないで。ここにあなたを一番知っている女が{nl}　いることを。デイ、自信をもって」",
  "off": 6701,
  "len": 81,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6703,
  "text_len": 78
 },
 {
  "id": "sce146:01A81",
  "jp": "デイ「そう、だな‥‥私はデイ・ラクバルだ。{nl}　‥‥すまんな」",
  "off": 6785,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6787,
  "text_len": 35
 },
 {
  "id": "sce146:01AAA",
  "jp": "ドリス「そうよ。あなたがしっかりしなくちゃ。{nl}　私達の悲願達成のために‥‥」",
  "off": 6826,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6828,
  "text_len": 46
 },
 {
  "id": "sce146:01ADE",
  "jp": "デイ「ああ。そうだな。{nl}　ドリス‥‥例の件、頼んだぞ」",
  "off": 6878,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6880,
  "text_len": 32
 },
 {
  "id": "sce146:01B04",
  "jp": "ドリス「ええ。任せて。{nl}　この前は邪魔が入ったけど次はかならず‥‥」",
  "off": 6916,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6918,
  "text_len": 42
 },
 {
  "id": "sce146:01B34",
  "jp": "デイ「ふふふふ、たのもしいことだな」",
  "off": 6964,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6966,
