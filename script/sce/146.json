  "status": "todo",
  "style": 0,
  "text_off": 1226,
  "text_len": 26
 },
 {
  "id": "sce146:004F9",
  "jp": "ヨアニス「あっ、あ、あ、あ、あああ‥‥{nl}　な、殴った‥‥」",
