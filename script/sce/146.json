  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4605,
  "text_len": 25
 },
 {
  "id": "sce146:0121A",
  "jp": "デロック「う～ん‥‥どっかで見た事のある顔なんだな‥‥」",
  "off": 4634,
