  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1540,
  "text_len": 13
 },
 {
  "id": "sce146:00615",
  "jp": "ヨアニス「なにをする！　放せ！{nl}　あんなやつ、あんなやつぅ！」",
  "off": 1557,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1559,
  "text_len": 35
 },
 {
  "id": "sce146:0063E",
