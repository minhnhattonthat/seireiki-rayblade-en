  "status": "translated",
  "style": 0,
  "text_off": 4533,
  "text_len": 8
 },
 {
  "id": "sce285:011C1",
  "jp": "ヤマト「だって、フラフラだし。{nl}　男の子だったらそれぐらいできるでしょ？」",
