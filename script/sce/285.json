  "status": "todo",
  "style": 0,
  "text_off": 4698,
  "text_len": 34
 },
 {
  "id": "sce285:01280",
  "jp": "トウヤ「聞こえない。{nl}　早く診てもらったほうがいいしな。{nl}　降りたかったら俺を倒してからにしろ」",
  "off": 4736,
