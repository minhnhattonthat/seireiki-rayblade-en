 {
  "id": "sce064:00341",
  "jp": "トウヤ（‥‥てめぇ、何者だ？）",
  "off": 833,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 835,
  "text_len": 20
 },
 {
  "id": "sce064:0035B",
  "jp": "声（ああ、そうか‥‥これならどうかな？{nl}　聴きなれた声になったんじゃないか？）",
  "off": 859,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 861,
  "text_len": 46
 },
 {
  "id": "sce064:0038F",
  "jp": "トウヤ（これは‥‥デビッシュ⁉{nl}　てめぇ、生きていたのか⁈）",
  "off": 911,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 913,
  "text_len": 35
 },
 {
  "id": "sce064:003B8",
  "jp": "声（はははははは！）",
