 },
 {
  "id": "sce200:00130",
  "jp": "ジグリム兵士「グ、グラード様！」",
  "off": 304,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 308,
  "text_len": 21
 },
 {
  "id": "sce200:0014A",
  "jp": "グラード「ベーゼンドルファー‥‥ついに出たか。{nl}　しかし‥‥なんという威庄感だ‥‥」",
  "off": 330,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 334,
  "text_len": 55
 },
 {
  "id": "sce200:00186",
  "jp": "ガリュード「‥‥ほぅ、ジグリムにもこれほどの{nl}　プラーナの持ち主がいたか」",
  "off": 390,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 394,
  "text_len": 43
 },
 {
  "id": "sce200:001B6",
  "jp": "グラード「‥‥ガリュード・ビア・<E1>ラッツェン殿と{nl}　おみうけしますが？」",
  "off": 438,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 442,
  "text_len": 42
 },
 {
  "id": "sce200:001E5",
  "jp": "ガリュード「いかにも」",
  "off": 485,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 489,
  "text_len": 12
 },
 {
  "id": "sce200:001F6",
  "jp": "グラード「私はジグリム共和国軍第二師団{nl}　アルマ方面軍所属グラード・バーグリーと申します」",
  "off": 502,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 506,
  "text_len": 64
 },
 {
  "id": "sce200:0023B",
  "jp": "ガリュード「その名‥‥久しく聞かなかったが？」",
  "off": 571,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 575,
  "text_len": 30
 },
 {
  "id": "sce200:0025E",
  "jp": "グラード「いささか事情がありまして、一時前線から{nl}　身をひいておりました。復帰緒戦の相手が{nl}　<E1>ラッツェン殿とは私もついていませんな‥‥」",
  "off": 606,
  "len": 92,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 610,
  "text_len": 87
 },
 {
  "id": "sce200:002BA",
  "jp": "ガリュード「フッ‥‥“西の獅子”と怖れられた{nl}　貴公ならば相手にとって不足はない。{nl}　幕引きの相手としてもな」",
  "off": 698,
  "len": 79,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 702,
  "text_len": 74
 },
 {
  "id": "sce200:00309",
  "jp": "グラード「<E1>ラッツェン殿‥‥もしや‥‥」",
  "off": 777,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 781,
  "text_len": 26
 },
 {
  "id": "sce200:00328",
  "jp": "ガリュード「さて、始めるとするか‥‥」",
  "off": 808,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 812,
  "text_len": 23
 },
 {
  "id": "sce200:0037B",
  "jp": "ミヤスコ「間もなくベルネア砦がレーダー圏内に入ります」",
  "off": 891,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 893,
  "text_len": 34
 },
 {
  "id": "sce200:003A3",
  "jp": "セリカ「モニターに回して」",
  "off": 931,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 933,
  "text_len": 15
 },
 {
  "id": "sce200:003B8",
  "jp": "ミヤスコ「了解」",
  "off": 952,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 954,
  "text_len": 10
 },
 {
  "id": "sce200:003CF",
  "jp": "デロック「結構な数なんだな」",
  "off": 975,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 977,
  "text_len": 17
 },
 {
  "id": "sce200:003EE",
  "jp": "レデュース「‥‥抜け道のほうは大丈夫か‥‥」",
  "off": 1006,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1008,
  "text_len": 32
 },
 {
  "id": "sce200:00414",
  "jp": "セリカ「抜け道？」",
  "off": 1044,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1046,
  "text_len": 12
 },
 {
  "id": "sce200:00426",
  "jp": "レデュース「ベルネア砦にはいざという時のために{nl}　脱出路が確保されています。うまくいけば、{nl}　我々が囮になり、そこから脱出を図ることができます」",
  "off": 1062,
  "len": 88,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1064,
  "text_len": 85
 },
 {
  "id": "sce200:00481",
  "jp": "オズ<E1>ァルド「しかし、前線ではなく、後方に{nl}　待機してると思われる、この部隊が投入されれば{nl}　我等とて危険ではありませんか？」",
  "off": 1153,
  "len": 82,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1155,
  "text_len": 79
 },
 {
  "id": "sce200:004D6",
  "jp": "カイン「そうだね。でも、どうしてこんな戦力の分散という{nl}　愚を犯しているんだろうね？　ジグリムの指揮官は{nl}　よほどの馬鹿か策士のどちらかだね」",
  "off": 1238,
  "len": 88,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1240,
  "text_len": 85
 },
 {
  "id": "sce200:00531",
  "jp": "レデュース「フラム国王陛下に教えていただいた情報に{nl}　よりますと指揮官はあのグラード・バーグリーのようです」",
  "off": 1329,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1331,
  "text_len": 68
 },
 {
  "id": "sce200:0057B",
  "jp": "カイン「‥‥あの人がタダで情報を流したことが{nl}　気になるけど、情報自体の信憑性は高い。{nl}　ということは後者‥‥{nl}　これは一筋縄ではいかないかも知れないね」",
  "off": 1403,
  "len": 103,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1405,
  "text_len": 100
 },
 {
  "id": "sce200:005E5",
  "jp": "レデュース「ですから、まずは私が話をつけます。{nl}　交渉が決裂すれば、聖霊機を投入し、{nl}　ガリュード様とシエルの救出をお願いします」",
  "off": 1509,
  "len": 85,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1511,
  "text_len": 82
 },
 {
  "id": "sce200:0063D",
  "jp": "アーサー「それは危険すぎます」",
  "off": 1597,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1599,
  "text_len": 19
 },
 {
  "id": "sce200:00656",
  "jp": "レデュース「いきなり戦闘を仕掛けるワケにもいかん。{nl}　それに聖霊機を特定の国家と敵対させることは{nl}　避けねばならない。そのためにはこれが最善の‥‥」",
  "off": 1622,
  "len": 96,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1624,
  "text_len": 93
 },
 {
  "id": "sce200:006CC",
  "jp": "アルフォリナ「それはなりません。{nl}　タイロンに続きあなたまで失うことなど‥‥」",
  "off": 1740,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1742,
  "text_len": 43
 },
 {
  "id": "sce200:006FD",
  "jp": "アイ「！」",
  "off": 1789,
  "len": 9,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1791,
  "text_len": 6
 },
 {
  "id": "sce200:00709",
  "jp": "オズ<E1>ァルド「へ、陛下！」",
  "off": 1801,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1803,
  "text_len": 16
 },
 {
  "id": "sce200:0071F",
  "jp": "ユミール「もう大丈夫なのですか？」",
  "off": 1823,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1825,
  "text_len": 22
 },
 {
  "id": "sce200:0073B",
  "jp": "アルフォリナ「ええ。まだちょっと目眩がしますが‥‥」",
  "off": 1851,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1853,
  "text_len": 30
 },
 {
  "id": "sce200:0075F",
  "jp": "アイ「もぅ、あれだけ寝てなさいって言ったのに～」",
  "off": 1887,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1889,
  "text_len": 27
 },
 {
  "id": "sce200:00780",
  "jp": "アルフォリナ「ごめんなさい。{nl}　でも、もう大丈夫ですから。{page}　それよりもリーボーフェンそのものを威嚇に使い、{nl}　その間に脱出を促し、回収、離脱という方法では{nl}　いけませんか？{page}　武力を誇示することは誇れることではありませんが、{nl}　無用に戦闘を避けるためには仕方ないことだと{nl}　思いましょう」",
  "off": 1920,
  "len": 180,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1922,
  "text_len": 177
 },
 {
  "id": "sce200:00837",
  "jp": "クロビス「まぁ、そっちのほうが危険もすくないだろうな。{nl}　安全なところから交渉をするのは俺も好かんがな」",
  "off": 2103,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2105,
  "text_len": 60
 },
 {
  "id": "sce200:00879",
  "jp": "アルフォリナ「武人としてのあなたの気持ちもわかりますが{nl}　ここは我慢してください」",
  "off": 2169,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2171,
  "text_len": 47
 },
 {
  "id": "sce200:008AE",
  "jp": "レデュース「‥‥いえ、もったいないお言葉‥‥{nl}　かしこまりました。では具体的な作戦を‥‥」",
  "off": 2222,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2224,
  "text_len": 59
 },
 {
  "id": "sce200:00900",
  "jp": "アルフォリナ「‥‥あっ」",
  "off": 2304,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2306,
  "text_len": 14
 },
 {
  "id": "sce200:00914",
  "jp": "アイ「アルフォリナ！」",
  "off": 2324,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2326,
  "text_len": 12
 },
 {
  "id": "sce200:00926",
  "jp": "レデュース「陛下！」",
  "off": 2342,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2344,
  "text_len": 14
 },
 {
  "id": "sce200:0093A",
  "jp": "アルフォリナ「‥‥大丈夫です。少し目眩がしただけです」",
  "off": 2362,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2364,
  "text_len": 35
 },
 {
  "id": "sce200:00963",
  "jp": "アイ「あまり身体は丈夫じゃないんだから、{nl}　無理しちゃダメ！　ホラ、医務室へ‥‥」",
  "off": 2403,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2405,
  "text_len": 53
 },
 {
  "id": "sce200:009A8",
  "jp": "オズ<E1>ァルド「では私がお運び致しましょう。{nl}　貴方は作戦の打ち合わせもあるでしょうし‥‥」",
  "off": 2472,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2474,
  "text_len": 56
 },
 {
  "id": "sce200:009E6",
  "jp": "アイ「そ、そうだけど‥‥」",
  "off": 2534,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2536,
  "text_len": 15
 },
 {
  "id": "sce200:00A11",
  "jp": "ミヤスコ「では私もお供いたします。{nl}　デロック、お願いね」",
  "off": 2577,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2579,
  "text_len": 32
 },
 {
  "id": "sce200:00A37",
  "jp": "デロック「了解したんだな。任せておくんだな」",
  "off": 2615,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2617,
  "text_len": 25
 },
 {
  "id": "sce200:00A56",
  "jp": "カイン「‥‥」",
  "off": 2646,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2648,
  "text_len": 9
 },
 {
  "id": "sce200:00A65",
  "jp": "オズ<E1>ァルド「‥‥では参りましょう‥‥」",
  "off": 2661,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2663,
  "text_len": 25
 },
 {
  "id": "sce200:00A99",
  "jp": "アイ「‥‥」",
  "off": 2713,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2715,
  "text_len": 8
 },
 {
  "id": "sce200:00AA7",
  "jp": "アーサー「心配しなくても大丈夫ですよ」",
  "off": 2727,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2729,
  "text_len": 26
 },
 {
  "id": "sce200:00AC7",
  "jp": "アイ「うん‥‥」",
  "off": 2759,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2761,
  "text_len": 10
 },
 {
  "id": "sce200:00AEF",
  "jp": "ガリュード「貴公、どういうつもりだ？{nl}　本気で一騎討ちを申し込むつもりか？」",
  "off": 2799,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2803,
  "text_len": 50
 },
 {
  "id": "sce200:00B26",
  "jp": "グラード「私も騎士の端くれ。{nl}　剣煌幻聖（けんこうげんせい）と手合わせしたい‥‥{nl}　変ですかな？{nl}　それに互いの胸中は同じものを抱いているようですしね」",
  "off": 2854,
  "len": 101,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2858,
  "text_len": 96
 },
 {
  "id": "sce200:00B8B",
  "jp": "ガリュード「貴公‥‥」",
  "off": 2955,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2959,
  "text_len": 16
 },
 {
  "id": "sce200:00BA0",
  "jp": "グラード「お互い、不器用な生き方しか{nl}　できないようですね」",
  "off": 2976,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2980,
  "text_len": 37
 },
 {
  "id": "sce200:00BCA",
  "jp": "ガリュード「フッ‥‥グラード・バーグリー。{nl}　噂に違わぬ男のようだな。よろしい。{nl}　その申し出、受けるとしよう。{nl}　しかし手加減はせぬ。全力でいかせてもらうぞ」",
  "off": 3018,
  "len": 102,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3022,
  "text_len": 97
 },
 {
  "id": "sce200:00C30",
  "jp": "グラード「ええ。そうしてもらわなければ困ります‥‥」",
  "off": 3120,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3124,
  "text_len": 30
 },
 {
  "id": "sce200:00C62",
  "jp": "デロック「確認したんだな。{nl}　ヨークの装兵機はベーゼンドルファーなんだな」",
  "off": 3170,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3172,
  "text_len": 45
 },
 {
  "id": "sce200:00C95",
  "jp": "フェイン「おぉっ！　やっぱりいいよなぁ！　格好いいぜ！{nl}　俺もいつかあんな機体に‥‥」",
  "off": 3221,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3223,
  "text_len": 53
 },
 {
  "id": "sce200:00CD0",
  "jp": "レデュース「あれは‥‥もしや一騎討ちか？」",
  "off": 3280,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3282,
  "text_len": 28
 },
 {
  "id": "sce200:00CF2",
  "jp": "トウヤ「それって1対1で戦うあれか？」",
  "off": 3314,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3316,
  "text_len": 22
 },
 {
  "id": "sce200:00D0E",
  "jp": "レデュース「ああ。それにあの構えは古来からのしきたりに{nl}　のっとった正式な一騎討ちのようだ」",
  "off": 3342,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3344,
  "text_len": 55
 },
 {
  "id": "sce200:00D4B",
  "jp": "トウヤ「なにか違うのか？」",
  "off": 3403,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3405,
  "text_len": 15
 },
 {
  "id": "sce200:00D60",
  "jp": "レデュース「ただ、己の力を誇示したり名声を{nl}　高めたりするものではない。両軍の代表者が戦い、{nl}　その勝敗がそのまま戦の勝敗となるのだ」",
  "off": 3424,
  "len": 89,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3426,
  "text_len": 86
 },
 {
  "id": "sce200:00DBC",
  "jp": "トウヤ「それじゃ、今のうちに‥‥」",
  "off": 3516,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3518,
  "text_len": 20
 },
 {
  "id": "sce200:00DD6",
  "jp": "レデュース「いや、一騎討ちの間、両軍とも一切の{nl}　手出しはできん。もし、それを破るものがいれば{nl}　神聖な一騎討ちを汚したとして{nl}　両軍の手により処罰される決まりだ」",
  "off": 3542,
  "len": 109,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3544,
  "text_len": 106
 },
 {
  "id": "sce200:00E46",
  "jp": "トウヤ「それじゃ、見ている事しかできねぇのか？」",
  "off": 3654,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3656,
  "text_len": 27
 },
 {
  "id": "sce200:00E67",
  "jp": "レデュース「そうなる。たとえ我々が第三者的な{nl}　立場であろうともな」",
  "off": 3687,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3689,
  "text_len": 42
 },
 {
  "id": "sce200:00E97",
  "jp": "フェイン「おぉ、あれはやはりグラード・バーグリー様の{nl}　機体。退役したと聞いていたが‥‥本物をこの目で{nl}　見ることができるなんて感激だっ！」",
  "off": 3735,
  "len": 91,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3737,
  "text_len": 88
 },
 {
  "id": "sce200:00EF5",
  "jp": "トウヤ「なんかよくわからねえが、{nl}　それだけ凄い人物ってことか？」",
  "off": 3829,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3831,
  "text_len": 37
 },
 {
  "id": "sce200:00F20",
  "jp": "レデュース「ガリュード様を含む剣煌（けんこう）の{nl}　お三方は別として、大陸三強騎士の一人と{nl}　されているのがあのグラード・バーグリー殿だ」",
  "off": 3872,
  "len": 93,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3874,
  "text_len": 90
 },
 {
  "id": "sce200:00F80",
  "jp": "トウヤ「へー。でもよ、“剣煌（けんこう）”といい、{nl}　“三強”といい、あんたら三剣騎士といい、{nl}　へんなところで時代がかってるよなぁ、この世界」",
  "off": 3968,
  "len": 92,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3970,
  "text_len": 89
 },
 {
  "id": "sce200:00FDF",
  "jp": "クロビス「たしかに。まぁ、技術レベルじゃ俺達の世界より{nl}　遥かに上だがな。しかしこんな庄倒的有利な状態で{nl}　一騎討ちなど‥‥どういうつもりなんだ？」",
  "off": 4063,
  "len": 98,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4065,
  "text_len": 95
 },
 {
  "id": "sce200:01044",
  "jp": "レデュース「それは私も疑問には思っていた。{nl}　グラード殿といえどガリュード様の力を知っているはず。{nl}　それでもなお一騎討ちに応じるとは‥‥」",
  "off": 4164,
  "len": 90,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4166,
  "text_len": 87
 },
 {
  "id": "sce200:010A1",
  "jp": "トウヤ「とにかく今は手をだすことはできねぇんだろ？{nl}　だったら見てるしかねぇ」",
  "off": 4257,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4259,
  "text_len": 43
 },
 {
  "id": "sce200:010D9",
  "jp": "グラード「この勝負、武人と武人の一騎打ち。{nl}　この勝敗が両軍の結果となる。よろしいか？」",
  "off": 4313,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4317,
  "text_len": 61
 },
 {
  "id": "sce200:0111B",
  "jp": "ガリュード「‥‥委細承知」",
  "off": 4379,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4383,
  "text_len": 20
 },
 {
  "id": "sce200:01134",
  "jp": "グラード「では‥‥まいる！」",
  "off": 4404,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4408,
  "text_len": 18
 },
 {
  "id": "sce200:0114B",
  "jp": "グラード（すまん、トーラ‥‥クルル‥‥）",
  "off": 4427,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4431,
  "text_len": 26
 },
 {
  "id": "sce200:011A5",
  "jp": "グラード「‥‥さすがに強い」",
  "off": 4517,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4521,
  "text_len": 18
 },
 {
  "id": "sce200:011BC",
  "jp": "ガリュード「貴公もな」",
  "off": 4540,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4544,
  "text_len": 14
 },
 {
  "id": "sce200:011F0",
  "jp": "グラード「‥‥このような気持ち、久しく忘れていました」",
  "off": 4592,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4596,
  "text_len": 34
 },
 {
  "id": "sce200:01217",
  "jp": "ガリュード「お互い、武人だということだな」",
  "off": 4631,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4635,
  "text_len": 25
 },
 {
  "id": "sce200:01235",
  "jp": "グラード「ふふふ‥‥」",
  "off": 4661,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4665,
  "text_len": 14
 },
 {
  "id": "sce200:01256",
  "jp": "ガリュード「⁉」",
  "off": 4694,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4698,
  "text_len": 10
 },
 {
  "id": "sce200:0126C",
  "jp": "ジグリム兵士「クククク‥‥もう遅い‥‥」",
  "off": 4716,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4718,
  "text_len": 27
 },
 {
  "id": "sce200:0128A",
  "jp": "グラード「なにっ⁈」",
  "off": 4746,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4750,
  "text_len": 12
 },
 {
  "id": "sce200:012A2",
  "jp": "ジグリム兵士「‥‥死ね」",
  "off": 4770,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4772,
  "text_len": 17
 },
 {
  "id": "sce200:012C2",
  "jp": "シエル「‥‥」",
  "off": 4802,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4806,
  "text_len": 9
 },
 {
  "id": "sce200:012D7",
  "jp": "ジグリム兵士「なっ！」",
  "off": 4823,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4825,
  "text_len": 14
 },
 {
  "id": "sce200:01304",
  "jp": "ジグリム兵士「ぬおぉぉぉぉぉ‼」",
  "off": 4868,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4870,
  "text_len": 19
 },
 {
  "id": "sce200:01323",
  "jp": "グラード「我が軍はここまで腐敗していたのか‥‥{nl}　そこまでして勝つことに意味があるのか‥‥{nl}　背後から狙撃など‥‥くっ」",
  "off": 4899,
  "len": 83,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4903,
  "text_len": 78
 },
 {
  "id": "sce200:01376",
  "jp": "ガリュード「シエル！　なぜ‥‥」",
  "off": 4982,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4986,
  "text_len": 20
 },
 {
  "id": "sce200:0139A",
  "jp": "シエル「父上はタイロン並に演技が下手ですから」",
  "off": 5018,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5022,
  "text_len": 30
 },
 {
  "id": "sce200:013BD",
  "jp": "ガリュード「聞き分けがいいと思っていたが‥‥{nl}　まさか他の者達も‥‥？」",
  "off": 5053,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5057,
  "text_len": 48
 },
 {
  "id": "sce200:013F2",
  "jp": "シエル「御心配なく。皆はすでに発たせました。{nl}　この砦にいるのは私達二人だけです」",
  "off": 5106,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5110,
  "text_len": 51
 },
 {
  "id": "sce200:0142A",
  "jp": "グラード「<E1>ラッツェン殿、申し訳ありません。{nl}　かくなる上は‥‥」",
  "off": 5162,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5166,
  "text_len": 40
 },
 {
  "id": "sce200:01457",
  "jp": "ガリュード「グラード殿‥‥これは貴公の意志でないことは{nl}　わかっている。いま一度‥‥」",
  "off": 5207,
  "len": 61,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5211,
  "text_len": 56
 },
 {
  "id": "sce200:01494",
  "jp": "ジグリム兵士「グラード様！」",
  "off": 5268,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5272,
  "text_len": 19
 },
 {
  "id": "sce200:014AC",
  "jp": "グラード「騒ぐな！　これは介入ではない。{nl}　むしろ一騎討ちを汚したのは我々の方。{nl}　手出しは‥‥」",
  "off": 5292,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5296,
  "text_len": 64
 },
 {
  "id": "sce200:014F8",
  "jp": "ジグリム兵士「ヨークの装兵機が一騎討ちに{nl}　介入したぞ！」",
  "off": 5368,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5370,
  "text_len": 41
 },
 {
  "id": "sce200:0152B",
  "jp": "ジグリム兵士「少佐を守れ！」",
  "off": 5419,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5421,
  "text_len": 20
 },
 {
  "id": "sce200:01549",
  "jp": "ジグリム兵士「う、うわぁぁぁぁぁ！」",
  "off": 5449,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5451,
  "text_len": 21
 },
 {
  "id": "sce200:01576",
  "jp": "グラード「煽動している？　閣下の‥‥いや、まさか‥‥」",
  "off": 5494,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5498,
  "text_len": 37
 },
 {
  "id": "sce200:015E1",
  "jp": "トウヤ「おいおい、なんか大変なことになってきたぞ‥‥」",
  "off": 5601,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5603,
  "text_len": 31
 },
 {
  "id": "sce200:0160E",
  "jp": "カイン「どうするんだい？{nl}　このまま傍観していたら確実にあの二人は{nl}　死んじゃうよ」",
  "off": 5646,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5648,
  "text_len": 50
 },
 {
  "id": "sce200:01646",
  "jp": "レデュース「すまないが、私は出させてもらう。{nl}　リーボーフェンはここを離脱してください」",
  "off": 5702,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5704,
  "text_len": 51
 },
 {
  "id": "sce200:0167F",
  "jp": "ユミール「ちょっとまってください！{nl}　一度交渉してみる価値は‥‥」",
  "off": 5759,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5761,
  "text_len": 43
 },
 {
  "id": "sce200:016B0",
  "jp": "カイン「それはやめたほうがいいね。{nl}　見てみなよ。ジグリム兵の動き、てんでバラバラだ。{nl}　すでに指揮官の指示が伝わらなくなっている証拠だよ。{nl}　ここは一気に降下して相手の動揺を誘い、{nl}　二機を回収。{nl}　その後一気に離脱するというのはどうだい？」",
  "off": 5808,
  "len": 155,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5810,
  "text_len": 152
 },
 {
  "id": "sce200:0174E",
  "jp": "セリカ「私もカインの意見に賛成よ。{nl}　二人を見捨てることなんてできないわ」",
  "off": 5966,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5968,
  "text_len": 46
 },
 {
  "id": "sce200:01782",
  "jp": "フェイン「行きましょう！」",
  "off": 6018,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6020,
  "text_len": 15
 },
 {
  "id": "sce200:01797",
  "jp": "ユミール「‥‥そうね。逃げるのは簡単だけど、{nl}　二人を助けられなくて、世界を救うことなんて{nl}　できないわね。　‥‥行きましょう！」",
  "off": 6039,
  "len": 84,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6041,
  "text_len": 81
 },
 {
  "id": "sce200:017EE",
  "jp": "セリカ「よぉーっし、{nl}　光学遮蔽解除後、聖霊機出撃！」",
  "off": 6126,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6128,
  "text_len": 41
 },
 {
  "id": "sce200:0183F",
  "jp": "ミヤスコ「どうですか？」",
  "off": 6207,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6209,
  "text_len": 13
 },
 {
  "id": "sce200:01852",
  "jp": "アルフォリナ「はい。おかげさまで楽になりました」",
  "off": 6226,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6228,
  "text_len": 25
 },
 {
  "id": "sce200:01871",
  "jp": "オズ<E1>ァルド「‥‥」",
  "off": 6257,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6259,
  "text_len": 12
 },
 {
  "id": "sce200:01883",
  "jp": "アルフォリナ「？　どうかしましたか？{nl}　顔色がすぐれませんよ？」",
  "off": 6275,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6277,
  "text_len": 37
 },
 {
  "id": "sce200:018AE",
  "jp": "オズ<E1>ァルド「‥‥は、はい。申し訳ございません。{nl}　少々気分が‥‥」",
  "off": 6318,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6320,
  "text_len": 43
 },
 {
  "id": "sce200:018DF",
  "jp": "ミヤスコ「お薬を注射しましょうか？」",
  "off": 6367,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6369,
  "text_len": 22
 },
 {
  "id": "sce200:018FB",
  "jp": "オズ<E1>ァルド「いえ、それには及びません。{nl}　少し休ませていただきます‥‥」",
  "off": 6395,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6397,
  "text_len": 42
 },
 {
  "id": "sce200:0192B",
  "jp": "アルフォリナ「そうですね」",
  "off": 6443,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6445,
  "text_len": 13
 },
 {
  "id": "sce200:0193E",
  "jp": "オズ<E1>ァルド「それでは、失礼します‥‥」",
  "off": 6462,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6464,
  "text_len": 24
 },
 {
  "id": "sce200:01963",
  "jp": "ミヤスコ「大丈夫でしょうか？」",
  "off": 6499,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6501,
  "text_len": 19
 },
 {
  "id": "sce200:0197C",
  "jp": "アルフォリナ「彼は神経質なところがありますから。{nl}　精神的負荷も相当なものなのでしょう」",
  "off": 6524,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6526,
  "text_len": 55
 },
 {
  "id": "sce200:019C8",
  "jp": "ガボン「おい、ミヤスコ、戦闘だぞ。{nl}　俺は機関室へ行く。お前もブリッジへ戻れ」",
  "off": 6600,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6602,
  "text_len": 48
 },
 {
  "id": "sce200:01A09",
  "jp": "ミヤスコ「あっ、先生！」",
  "off": 6665,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6667,
  "text_len": 15
 },
 {
  "id": "sce200:01A1E",
  "jp": "アルフォリナ「行ってください。{nl}　わたくしはもう大丈夫ですから」",
  "off": 6686,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6688,
  "text_len": 36
 },
 {
  "id": "sce200:01A48",
  "jp": "ミヤスコ「ですが‥‥」",
  "off": 6728,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6730,
  "text_len": 13
 },
 {
  "id": "sce200:01A5B",
  "jp": "アルフォリナ「それに少し眠らせていただきたいので‥‥」",
  "off": 6747,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6749,
  "text_len": 31
 },
 {
  "id": "sce200:01A80",
  "jp": "ミヤスコ「‥‥あっ。私がいたら眠りにくいですよね。{nl}　わかりました。それでは遠慮なく失礼させていただきます」",
  "off": 6784,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6786,
  "text_len": 62
 },
 {
  "id": "sce200:01AC4",
  "jp": "アルフォリナ「頑張ってください」",
  "off": 6852,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6854,
  "text_len": 18
 },
 {
  "id": "sce200:01ADC",
  "jp": "ミヤスコ「はい。それでは、失礼いたします」",
