  "style": 0,
  "text_off": 6914,
  "text_len": 12
 },
 {
  "id": "sce200:01B1D",
  "jp": "アルフォリナ「？　ミヤスコさん？」",
  "off": 6941,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6943,
  "text_len": 19
 },
 {
  "id": "sce200:01B42",
  "jp": "オズ<E1>ァルド「‥‥」",
