  "status": "todo",
  "style": 0,
  "text_off": 5040,
  "text_len": 30
 },
 {
  "id": "sce009:013D2",
  "jp": "トウヤ「だったらなおさらやベぇじゃねぇか！{nl}　なにグズグズやってんだよ！」",
