  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4144,
  "text_len": 18
 },
 {
  "id": "sce009:01046",
  "jp": "トウヤ「ああ。ガキの頃から一緒にいる‥‥{nl}　いわゆる幼なじみって奴だ」",
