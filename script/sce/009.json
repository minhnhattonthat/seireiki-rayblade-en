  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4064,
  "text_len": 32
 },
 {
  "id": "sce009:01004",
  "jp": "トウヤ「ったく！　カスミにもしものことがあったら{nl}　どうすんだよ！」",
