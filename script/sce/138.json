[
 {
  "id": "sce138:0003E",
  "jp": "トウヤ「‥‥あれが＜ゼ＝オード＞か‥‥」",
  "off": 62,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 64,
  "text_len": 28
 },
 {
  "id": "sce138:0006A",
  "jp": "ユミール「大丈夫ですか？　顔色が悪いですよ？」",
  "off": 106,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 108,
  "text_len": 32
 },
 {
  "id": "sce138:00090",
  "jp": "トウヤ「あ、ああ。ちょっと疲れた‥‥でも大丈夫だ。{nl}　しかし、どうして封印されていたライブレードが{nl}　動いたんだ？」",
  "off": 144,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 146,
  "text_len": 69
 },
 {
  "id": "sce138:000DB",
  "jp": "ユミール「わかりません‥‥ですが、共鳴結晶の音色が{nl}　トウヤさんだけに聞こえていたことも関係があるのかも‥‥{nl}　とにかくライブレードが動いてくれて助かりました」",
  "off": 219,
  "len": 100,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 221,
  "text_len": 97
 },
 {
  "id": "sce138:00142",
  "jp": "イ<E1>ェル「‥‥」",
  "off": 322,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 324,
  "text_len": 10
 },
 {
  "id": "sce138:0015E",
  "jp": "セリカ「でも＜ゼ＝オード＞のフィールドが{nl}　あれほど強力だったなんて‥‥{nl}　あんなのがあと五機もいるんだからゾッとするわ」",
  "off": 350,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 352,
  "text_len": 72
 },
 {
  "id": "sce138:001AC",
  "jp": "トウヤ「五機？　そんなもん一度にこられたら{nl}　ひとたまりもねぇぞ‥‥」",
  "off": 428,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 430,
  "text_len": 42
 },
 {
  "id": "sce138:001EE",
  "jp": "アイ「ねぇ、さっきのパイロットが叫んでたレニスって誰？{nl}　なんかトウヤのことを言ってたみたいだけど‥‥」",
  "off": 494,
  "len": 61,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 496,
  "text_len": 58
 },
 {
  "id": "sce138:0023A",
  "jp": "エミィ「そんなことも知りませんの？{nl}　レニス・エンロード。109年前、＜ゼ＝オード＞を{nl}　研究していた錬金学士の一人。{nl}　そして＜ゼ＝オードの恐怖＞が起きる前にもう一人の{nl}　錬金学士ウェニマス・ラティーアと協力して{nl}　デビッシュ博士の計画を阻止しようとした人物。{nl}　‥‥という記録がありますわ」",
  "off": 570,
  "len": 196,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 572,
  "text_len": 193
 },
 {
  "id": "sce138:00301",
  "jp": "トウヤ「それは聞いた」",
  "off": 769,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 771,
  "text_len": 12
 },
 {
  "id": "sce138:00313",
  "jp": "アイ「え？　なんで知ってんの？」",
  "off": 787,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 789,
  "text_len": 19
 },
 {
  "id": "sce138:00338",
  "jp": "ユミール「あなた、ここにくる途中で説明うけなかったの？」",
  "off": 824,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 826,
  "text_len": 34
 },
 {
  "id": "sce138:00360",
  "jp": "アイ「‥‥そういえばそんなこと聞いたような気も‥‥」",
  "off": 864,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 866,
  "text_len": 32
 },
 {
  "id": "sce138:00386",
  "jp": "ユミール「＜ゼ＝オード＞と呼ばれている機体は、{nl}　全部で六機あるらしいけど、さっきのレイオードを{nl}　はじめ、エレアナ、ガイオゾン、パルテノス、{nl}　そしてゴーデリウスの五機の存在が確認されて{nl}　いるだけで、詳しいことはわかっていないの。{nl}　あと判明していることと言えば、バフレッド・デビッシュ、{nl}　ウェニマス・ラティーア、レニス・エンロードという三人の{nl}　研究者の名前ぐらいね。{nl}　彼らは同時に操者でもあったらしいけど‥‥」",
  "off": 902,
  "len": 254,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 904,
  "text_len": 251
 },
 {
  "id": "sce138:00487",
  "jp": "トウヤ「‥‥ということはあの機体にのっていた奴は{nl}　100年以上も前の人間ってことか？」",
  "off": 1159,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1161,
  "text_len": 56
 },
 {
  "id": "sce138:004C5",
  "jp": "ユミール「もしくはそう思い込んでいるか‥‥」",
  "off": 1221,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1223,
  "text_len": 27
 },
 {
  "id": "sce138:004E6",
  "jp": "アイ「にしてはちょっと感情がこもりすぎてたわね。{nl}　＜ゼ＝オード＞の狂信者という感じでもなかったし」",
  "off": 1254,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1256,
  "text_len": 60
 },
 {
  "id": "sce138:00534",
  "jp": "イ<E1>ェル「‥‥あの者は間違いなく109年前の{nl}　研究者の一人でしょう」",
  "off": 1332,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1334,
  "text_len": 47
 },
 {
  "id": "sce138:00569",
  "jp": "ユミール「イ<E1>ェル様‥‥それは死んだ人間が{nl}　復活したということですか？」",
  "off": 1385,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1387,
  "text_len": 47
 },
 {
  "id": "sce138:0059E",
  "jp": "イ<E1>ェル「復活という言葉は適切ではありませんね。{nl}　彼らはこの時代へ“やってきた”のです」",
  "off": 1438,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1440,
  "text_len": 56
 },
 {
  "id": "sce138:005DC",
  "jp": "トウヤ「タイムスリップか‥‥それであいつは{nl}　100年前の亡霊とか言ってたのか‥‥」",
  "off": 1500,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1502,
  "text_len": 51
 },
 {
  "id": "sce138:00615",
  "jp": "イ<E1>ェル「なぜ我々の時代なのかはわかりません、{nl}　ですが、運命という名の歯車は回り始めている。{nl}　29年前のあの日から‥‥」",
  "off": 1557,
  "len": 80,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1559,
  "text_len": 77
 },
 {
  "id": "sce138:00668",
  "jp": "ユミール「29年前？」",
  "off": 1640,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1642,
  "text_len": 15
 },
 {
  "id": "sce138:0067D",
  "jp": "イ<E1>ェル「あ、いえ、なんでもありません。{nl}　それよりもあの機体に聖霊機の攻撃が{nl}　ほとんど効かなかったことが問題です」",
  "off": 1661,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1663,
  "text_len": 69
 },
 {
  "id": "sce138:006C8",
  "jp": "エミィ「今、データの解析を急いでいます。{nl}　おそらくあのフィールドに干渉する方法が見つかれば{nl}　あとは聖霊機のパワーで対抗できるとおもいますわ」",
  "off": 1736,
  "len": 92,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1738,
  "text_len": 89
 },
 {
  "id": "sce138:00727",
  "jp": "イ<E1>ェル「殿下、これから忙しくなりますよ。{nl}　ライブレードが動いたとなると‥‥」",
  "off": 1831,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1833,
  "text_len": 47
 },
 {
  "id": "sce138:0075C",
  "jp": "ローディス「ええ。まずアガルティア王国評議会が{nl}　黙っていないでしょうね‥‥」",
  "off": 1884,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1886,
  "text_len": 48
 },
 {
  "id": "sce138:007B2",
  "jp": "トウヤ「‥‥どうだ？」",
  "off": 1970,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1972,
  "text_len": 14
 },
 {
  "id": "sce138:007D0",
  "jp": "セリカ「う～ん‥‥どうしたんだろ？{nl}　システムは生きてるみたいなんだけど、{nl}　うんともすんとも言わないの」",
  "off": 2000,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2002,
  "text_len": 59
 },
 {
  "id": "sce138:00811",
  "jp": "トウヤ「壊れたのか？」",
  "off": 2065,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2067,
  "text_len": 13
 },
 {
  "id": "sce138:00824",
  "jp": "セリカ「違うと思うけど‥‥{nl}　ま、いろいろ試してみるわ」",
  "off": 2084,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2086,
  "text_len": 33
 },
 {
  "id": "sce138:0084B",
  "jp": "ヤマト「ニャんか楽しそうね」",
  "off": 2123,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2125,
  "text_len": 15
 },
 {
  "id": "sce138:00860",
  "jp": "セリカ「え？　そぉ？　ふふふふふ‥‥{nl}　そりゃ、以前に私が調査しようとしたときは、{nl}　すでに封印されてたモンねぇ～{nl}　健全な女の子なら誰でもワクワクするでしょ？」",
  "off": 2144,
  "len": 102,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2146,
  "text_len": 99
 },
 {
  "id": "sce138:008C9",
  "jp": "トウヤ「‥‥お前だけじゃねぇか？」",
  "off": 2249,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2251,
  "text_len": 21
 },
 {
  "id": "sce138:008E4",
  "jp": "セリカ「とにかく、ヨークから一緒に来ている{nl}　整備の人達もいるし、バッチリ修理してみせるわ」",
  "off": 2276,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2278,
  "text_len": 56
 },
 {
  "id": "sce138:00922",
  "jp": "ヤマト「じゃ、ユミール達がフィールドの調査をしてるの？」",
  "off": 2338,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2340,
  "text_len": 34
 },
 {
  "id": "sce138:0094A",
  "jp": "セリカ「ええ。幸いライブレードの戦闘記録は{nl}　抽出できたから、クロビス達のデータと照らし合わせて{nl}　解析中よ」",
  "off": 2378,
  "len": 73,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2380,
  "text_len": 70
 },
 {
  "id": "sce138:00996",
  "jp": "トウヤ「俺に手伝えることはあるか？」",
  "off": 2454,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2456,
  "text_len": 22
 },
 {
  "id": "sce138:009B2",
  "jp": "セリカ「うーん‥‥その気持ちだけもらっておくわ。{nl}　ここは専門家にまかせといて！　でもある程度メドが{nl}　ついたらトウヤにも手伝ってもらうかもしれないわ」",
  "off": 2482,
  "len": 92,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2484,
  "text_len": 89
 },
 {
  "id": "sce138:00A11",
  "jp": "トウヤ「わかった。それじゃその時までは任せる。{nl}　手がいるときはいつでも言ってくれ」",
  "off": 2577,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2579,
  "text_len": 46
 },
 {
  "id": "sce138:00A45",
  "jp": "セリカ「もちろん。その時は遠慮なく{nl}　こき使わせてもらうからね」",
  "off": 2629,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2631,
  "text_len": 36
 },
 {
  "id": "sce138:00A6F",
  "jp": "トウヤ「ああ。それじゃ」",
  "off": 2671,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2673,
  "text_len": 12
 },
 {
  "id": "sce138:00A92",
  "jp": "ヤマト「あっ‥‥あれ、シィウチェンさんじゃニャい？」",
  "off": 2706,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2708,
  "text_len": 29
 },
 {
  "id": "sce138:00AB5",
  "jp": "トウヤ「ああ、そうみたいだな‥‥なにしてんだろ？」",
  "off": 2741,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2743,
  "text_len": 28
 },
 {
  "id": "sce138:00AD7",
  "jp": "ヤマト「あの聖霊機の整備をしてるみたいね‥‥」",
  "off": 2775,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2777,
  "text_len": 30
 },
 {
  "id": "sce138:00AFB",
  "jp": "整備士F「話しかけるの、よしといたほうがいいよ」",
  "off": 2811,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2813,
  "text_len": 28
 },
 {
  "id": "sce138:00B1D",
  "jp": "トウヤ「え？　なんでだ？」",
  "off": 2845,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2847,
  "text_len": 15
 },
 {
  "id": "sce138:00B4E",
  "jp": "整備士F「あの機体、アハティって言うんだけど、{nl}　彼の恋人が乗っていたらしいんだ。{page}　で、その恋人が行方不明になって、それ以来、誰にも{nl}　触らせようとしないって話よ。{page}　あたしもこの前、知らずにチェックしようとして、{nl}　危うく“おとされる”とこだったもの」",
  "off": 2894,
  "len": 157,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2896,
  "text_len": 154
 },
 {
  "id": "sce138:00C07",
  "jp": "　声をかける{nl}　やめとく",
  "off": 3079,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 128,
  "text_off": 3081,
  "text_len": 13
 },
 {
  "id": "sce138:00C2A",
  "jp": "シィウチェン「‥‥なんだ？」",
  "off": 3114,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3116,
  "text_len": 17
 },
 {
  "id": "sce138:00C41",
  "jp": "トウヤ「え？　あ、別に用事というようなものは‥‥」",
  "off": 3137,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3139,
  "text_len": 31
 },
 {
  "id": "sce138:00C66",
  "jp": "シィウチェン「‥‥だったら邪魔をするな。{nl}　私は今いそがしい」",
  "off": 3174,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3176,
  "text_len": 37
 },
 {
  "id": "sce138:00C91",
  "jp": "トウヤ「‥‥なぁ、その機体、あんたの恋人が{nl}　乗っていたって本当かい？」",
  "off": 3217,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3219,
  "text_len": 46
 },
 {
  "id": "sce138:00CC5",
  "jp": "シィウチェン「‥‥あの整備士か‥‥{nl}　まったく余計なことを‥‥」",
  "off": 3269,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3271,
  "text_len": 43
 },
 {
  "id": "sce138:00CF6",
  "jp": "トウヤ「どうして誰にも触らせないんだ？{nl}　信用してないのか？」",
  "off": 3318,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3320,
  "text_len": 37
 },
 {
  "id": "sce138:00D25",
  "jp": "シィウチェン「ふっ‥‥」",
  "off": 3365,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3367,
  "text_len": 14
 },
 {
  "id": "sce138:00D39",
  "jp": "トウヤ「なんだ？　なにがおかしいんだ？」",
  "off": 3385,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3387,
  "text_len": 22
 },
 {
  "id": "sce138:00D55",
  "jp": "シィウチェン「お前の素質は大したものだが、{nl}　聖霊機操者としてはまだまだだな」",
  "off": 3413,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3415,
  "text_len": 48
 },
 {
  "id": "sce138:00D8B",
  "jp": "トウヤ「どういうことだ？」",
  "off": 3467,
  "len": 17,
  "en": "Touya: What do you mean?",
  "status": "translated",
  "style": 0,
  "text_off": 3469,
  "text_len": 14
 },
 {
  "id": "sce138:00D9F",
  "jp": "シィウチェン「自分でメンテナンスまでしろとは言わんが、{nl}　自分の乗る機体の調整ぐらいは自分ですべきだ。{nl}　結局は自分を守れるのは自分自身だけなんだからな」",
  "off": 3487,
  "len": 101,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3489,
  "text_len": 98
 },
 {
  "id": "sce138:00E07",
  "jp": "トウヤ「‥‥たしかに任せっきりだが‥‥」",
  "off": 3591,
