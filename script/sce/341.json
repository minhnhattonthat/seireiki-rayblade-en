  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 135,
  "text_len": 19
 },
 {
  "id": "sce341:0009E",
  "jp": "ベルンスト「以前にも言いませんでしたか？{nl}　トウヤ‥‥君に死んでもらっては困る、と」",
  "off": 158,
  "len": 54,
  "en": "",
