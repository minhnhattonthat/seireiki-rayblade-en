  "status": "todo",
  "style": 0,
  "text_off": 1029,
  "text_len": 107
 },
 {
  "id": "sce197:00471",
  "jp": "トウヤ「ああ、わかった。そして突入後に聖霊機による{nl}　内部破壊‥‥だな？」",
