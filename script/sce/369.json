  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2923,
  "text_len": 13
 },
 {
  "id": "sce369:00B7C",
  "jp": "グラード「君が、あの聖霊機を操縦していたのか‥‥{nl}　私も老いたということか‥‥認めたくはないものだな‥‥」",
  "off": 2940,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2942,
  "text_len": 69
 },
