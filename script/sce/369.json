  "off": 2851,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2853,
  "text_len": 21
 },
 {
  "id": "sce369:00B3E",
  "jp": "グラード「まだ少し痛むが、たいしたことはない」",
