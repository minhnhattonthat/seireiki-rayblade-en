 },
 {
  "id": "sce369:00103",
  "jp": "セリカ「グラード・バーグリー‥‥どうして特攻なんか‥‥」",
  "off": 259,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 261,
  "text_len": 37
 },
 {
  "id": "sce369:0012E",
  "jp": "フェイン「そうです！　グラード様ともあろう方が{nl}　そのような無謀な行いをするはずがありません！」",
  "off": 302,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 304,
  "text_len": 56
 },
 {
  "id": "sce369:0016C",
  "jp": "アーサー「守るべき人がいるとおっしゃっていました。{nl}　そのために自分は退くわけにはいかないと‥‥」",
  "off": 364,
  "len": 61,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 366,
  "text_len": 58
 },
 {
  "id": "sce369:001AC",
  "jp": "セリカ「それって、誰かが人質にとられているって{nl}　ことじゃないの？」",
  "off": 428,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 430,
  "text_len": 38
 },
 {
  "id": "sce369:001D8",
  "jp": "シィウチェン「‥‥十分に考えられるな」",
  "off": 472,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 474,
  "text_len": 24
 },
 {
  "id": "sce369:001F6",
  "jp": "オーレリィ「家族とか‥‥？」",
  "off": 502,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 504,
  "text_len": 20
 },
 {
  "id": "sce369:00210",
  "jp": "フェイン「馬鹿な！　あの高潔な騎止たるグラード殿の{nl}　ご家族を人質にとるなど‥‥そんなことをすれば、{nl}　ジグリムの麹民が黙っていないですよ！」",
  "off": 528,
  "len": 93,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 530,
  "text_len": 90
 },
 {
  "id": "sce369:00270",
  "jp": "セリカ「確かにね。第一、そんなこと星#5D6気の沙汰とは{nl}　思えないし‥‥」",
  "off": 624,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 626,
  "text_len": 44
 },
 {
  "id": "sce369:002AC",
  "jp": "ガリュード「シエル！　それは審か⁈」",
  "off": 684,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 686,
  "text_len": 22
 },
 {
  "id": "sce369:002DA",
  "jp": "シエル「‥‥あの動き、間違いありません」",
  "off": 730,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 732,
  "text_len": 25
 },
 {
  "id": "sce369:002F9",
  "jp": "クロビス「‥‥どうしたんだ？」",
  "off": 761,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 763,
  "text_len": 18
 },
 {
  "id": "sce369:00311",
  "jp": "レデュース「タイロンが敵軍にいたらしい」",
  "off": 785,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 787,
  "text_len": 23
 },
 {
  "id": "sce369:0032E",
  "jp": "クロビス「おい、タイロンって、あのタイロンだろ？」",
  "off": 814,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 816,
  "text_len": 26
 },
 {
  "id": "sce369:0034E",
  "jp": "アーサー「ええ。生きておられたことは喜ばしいことですが、{nl}　それがなぜ‥‥？」",
  "off": 846,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 848,
  "text_len": 46
 },
 {
  "id": "sce369:00382",
  "jp": "シエル「訊いても答えてはくれませんでした」",
  "off": 898,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 900,
  "text_len": 23
 },
 {
  "id": "sce369:0039F",
  "jp": "レデュース「疑うことはありません。{nl}　奴は不器揖な男です。“敵”となったのでしょう」",
  "off": 927,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 929,
  "text_len": 52
 },
 {
  "id": "sce369:003D9",
  "jp": "トウヤ「お、おい！　本気で言ってるのか⁈{nl}　仲間だったんじゃねぇのかよ⁉」",
  "off": 985,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 987,
  "text_len": 45
 },
 {
  "id": "sce369:0040C",
  "jp": "レデュース「だからこそわかるのだ。{nl}　奴は脅しや賄賂などには屈しない男だ。つまりそれは{nl}　自らの意志でジグリムに身を置#674いているということ。{nl}　“敵”となったということだ」",
  "off": 1036,
  "len": 103,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1038,
  "text_len": 100
 },
 {
  "id": "sce369:0047A",
  "jp": "シエル「レデュース‥‥」",
  "off": 1146,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1148,
  "text_len": 15
 },
 {
  "id": "sce369:0048F",
  "jp": "トウヤ「仲間をそんな簡単に“敵”だとか{nl}　決めつけるなよ。{nl}　あいつだってなにか理由が‥‥」",
  "off": 1167,
  "len": 61,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1169,
  "text_len": 58
 },
 {
  "id": "sce369:004E1",
  "jp": "レデュース「そんなことは自#94Fも承知だ。{nl}　タイロンの行動は確固とした意志に基づいている。{nl}　だからこそ“敵”として認識するのだ。{nl}　そして、奴がしようとしていることの邪魔をしない。{nl}　たとえ、戦場でまみえ、どちらかが倒れようともな」",
  "off": 1249,
  "len": 140,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1251,
  "text_len": 137
 },
 {
  "id": "sce369:00570",
  "jp": "オーレリィ「アタシにはよくわからないけど、{nl}　それって信頼してるってこと？」",
  "off": 1392,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1394,
  "text_len": 42
 },
 {
  "id": "sce369:005A0",
  "jp": "クロビス「ああ。ここまで信じてくれる人間がいるとはな。{nl}　タイロンも恵#95Eまれた奴だ」",
  "off": 1440,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1442,
  "text_len": 46
 },
 {
  "id": "sce369:005D4",
  "jp": "オーレリィ「やっぱりわからないねぇ‥‥」",
  "off": 1492,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1494,
  "text_len": 23
 },
 {
  "id": "sce369:005F1",
  "jp": "シエル「タイロンはこうも言っておりました。{nl}　“私がヨークを導く”と。これはどういうことですか？」",
  "off": 1521,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1523,
  "text_len": 56
 },
 {
  "id": "sce369:0062F",
  "jp": "ガリュード「⁉」",
  "off": 1583,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1585,
  "text_len": 10
 },
 {
  "id": "sce369:0063F",
  "jp": "シエル「‥‥やはりなにかあるのですね？{nl}　お父さま、いったいどういうことですか？」",
  "off": 1599,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1601,
  "text_len": 46
 },
