  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2607,
  "text_len": 11
 },
 {
  "id": "sce369:00A61",
  "jp": "カスミ「‥‥」",
  "off": 2657,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2659,
  "text_len": 9
 },
 {
  "id": "sce369:00A70",
  "jp": "トウヤ「あっ‥‥」",
  "off": 2672,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2674,
  "text_len": 11
 },
 {
  "id": "sce369:00A81",
  "jp": "アイ「ねぇ！　あの人が助かったって本当⁈」",
  "off": 2689,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2691,
  "text_len": 27
 },
 {
  "id": "sce369:00AA2",
  "jp": "トウヤ「あ、ああ。貰の前に立ってるだろ」",
  "off": 2722,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2724,
  "text_len": 23
 },
 {
  "id": "sce369:00ABF",
  "jp": "アイ「へぇー、みたところ、ちょっと痛そうだけど、{nl}　この程度ですむなんて運がいいわね」",
  "off": 2751,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2753,
  "text_len": 48
 },
 {
  "id": "sce369:00AF5",
  "jp": "グラード「あ、ああ‥‥」",
  "off": 2805,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2807,
  "text_len": 15
 },
 {
