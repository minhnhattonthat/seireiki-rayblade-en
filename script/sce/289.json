  "status": "translated",
  "style": 0,
  "text_off": 6570,
  "text_len": 11
 },
 {
  "id": "sce289:019CB",
  "jp": "アイ「大丈夫。死にはしないって。{nl}　根拠はないけど」",
  "off": 6603,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6605,
  "text_len": 32
 },
 {
  "id": "sce289:019F1",
  "jp": "トウヤ「でもなあ、精神衛生的に‥‥」",
  "off": 6641,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6643,
  "text_len": 25
 },
 {
  "id": "sce289:01A1B",
  "jp": "アイ「これだから消費世代の人間は‥‥{nl}{ctl:3C3E}{face:041602}　そんなことじゃ戦後の混乱を生き抜いてきた人に{nl}　申し訳が立たないでしょ？」",
  "off": 6683,
  "len": 87,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6685,
  "text_len": 84
 },
 {
  "id": "sce289:01A75",
  "jp": "トウヤ「‥‥世代でいったらお前も同じだろ」",
  "off": 6773,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6775,
  "text_len": 27
 },
 {
  "id": "sce289:01AA8",
  "jp": "アイ「とにかく。なんでもかんでもポイポイ捨てるのは{nl}　よくないってことよ。{nl}　わかったらちゃんと持って帰って食べる。いい⁈」",
  "off": 6824,
  "len": 70,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6826,
  "text_len": 67
 },
 {
  "id": "sce289:01AF1",
  "jp": "ヤマト「‥‥」",
  "off": 6897,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6899,
  "text_len": 9
 },
 {
  "id": "sce289:01B04",
  "jp": "アイ「‥‥な、なに？」",
  "off": 6916,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6918,
  "text_len": 14
 },
 {
  "id": "sce289:01B18",
  "jp": "ヤマト「捨てるのが嫌だからあたし達に押し付けた」",
  "off": 6936,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6938,
  "text_len": 29
 },
 {
  "id": "sce289:01B4F",
  "jp": "アイ「うっ‥‥そ、そんなワケあるはずないこともないかも{nl}　しれないじゃない‥‥ははははは‥‥」",
  "off": 6991,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6993,
  "text_len": 53
 },
 {
  "id": "sce289:01B8A",
  "jp": "トウヤ「‥‥」",
  "off": 7050,
  "len": 12,
  "en": "Touya: ...",
  "status": "translated",
  "style": 0,
  "text_off": 7052,
  "text_len": 9
 },
 {
  "id": "sce289:01BA4",
  "jp": "アイ「‥‥ごめん。協力して。{nl}　あたし、本当に物を捨てたりするの嫌いなんだ。{nl}　でも、さすがにこんだけ食べきれないし‥‥」",
  "off": 7076,
  "len": 76,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7078,
  "text_len": 73
 },
 {
  "id": "sce289:01BF3",
  "jp": "トウヤ「‥‥そんならそうと言えばいいじゃねえか」",
  "off": 7155,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7157,
  "text_len": 27
 },
 {
  "id": "sce289:01C18",
  "jp": "アイ「なんか照れくさくって‥‥」",
  "off": 7192,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7194,
  "text_len": 19
 },
 {
  "id": "sce289:01C31",
  "jp": "ヤマト「でも、アイの年代でそんニャこと言う子って{nl}　結構珍しいんじゃニャい？」",
  "off": 7217,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7219,
  "text_len": 47
 },
 {
  "id": "sce289:01C78",
  "jp": "アイ「そう？　まあ、あたし、おばあちゃん子だったし、{nl}　その影響かな？」",
  "off": 7288,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7290,
  "text_len": 41
 },
 {
  "id": "sce289:01CA7",
  "jp": "トウヤ「そっか。まぁ、そういうことなら協力してやるよ」",
  "off": 7335,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7337,
  "text_len": 29
 },
 {
  "id": "sce289:01CDF",
  "jp": "アイ「ありがと」",
  "off": 7391,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7393,
  "text_len": 8
 },
 {
  "id": "sce289:01CED",
  "jp": "トウヤ「それじゃ、もらっていくぞ」",
  "off": 7405,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7407,
  "text_len": 17
 },
 {
  "id": "sce289:01D04",
  "jp": "アイ「うん。よろしくね」",
  "off": 7428,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7430,
  "text_len": 12
 },
 {
  "id": "sce289:01D1A",
  "jp": "ヤマト「さて、とりあえず持ち歩くわけにもいかニャいし、{nl}　一度部屋に戻ろうよ」",
  "off": 7450,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7452,
  "text_len": 46
 },
 {
  "id": "sce289:01D4E",
  "jp": "トウヤ「そうだな」",
  "off": 7502,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7504,
  "text_len": 9
 },
 {
  "id": "sce289:01D60",
  "jp": "トウヤ「‥‥おい、これ賞味期限切れかけてるぞ」",
  "off": 7520,
  "len": 33,
  "en": "",
