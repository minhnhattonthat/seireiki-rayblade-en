  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6128,
  "text_len": 17
 },
 {
  "id": "sce289:01805",
  "jp": "アイ「なにってチョコバーよ。{nl}　これがビターで、これがナッツ入りで、こっちがホワイト」",
  "off": 6149,
  "len": 49,
