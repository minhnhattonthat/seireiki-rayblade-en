  "status": "todo",
  "style": 0,
  "text_off": 8181,
  "text_len": 29
 },
 {
  "id": "sce289:02016",
  "jp": "ヤマト「う～ん。あたし、あんまり食べれニャいよ。{nl}　虫歯にニャるのもイヤだし」",
