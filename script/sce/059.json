  "status": "todo",
  "style": 2,
  "text_off": 8540,
  "text_len": 8
 },
 {
  "id": "sce059:02165",
  "jp": "カスミ「‥‥きっとトウヤちゃんに考えがあるのよ。{nl}　トウヤちゃんを信じよう、ね？」",
  "off": 8549,
