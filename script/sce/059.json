  "style": 1,
  "text_off": 8453,
  "text_len": 15
 },
 {
  "id": "sce059:02115",
  "jp": "ヤマト「あれ？　どうして送信モードにしてるの？{nl}　ねぇ。ねぇ、トウ‥‥」",
