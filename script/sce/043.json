  "jp": "メル<E1>ィ「そうかなぁ？」",
  "off": 7474,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7476,
  "text_len": 13
 },
 {
  "id": "sce043:01D45",
  "jp": "トウヤ「メル<E1>ィは優しいな」",
  "off": 7493,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7495,
  "text_len": 15
 },
 {
  "id": "sce043:01D8A",
  "jp": "メル<E1>ィ「え‥‥？　あっ、そ、そんなこと‥‥」",
