  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8180,
  "text_len": 25
 },
 {
  "id": "sce043:02011",
  "jp": "トウヤ「ちょっと、な」",
  "off": 8209,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8211,
  "text_len": 11
 },
 {
  "id": "sce043:02034",
  "jp": "レオーネ「そう‥‥わかった。{nl}　‥‥ゴメンね。なんか困らせちゃったみたいだね。{nl}　それじゃ、おやすみ‥‥」",
