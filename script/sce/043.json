  "status": "todo",
  "style": 0,
  "text_off": 7564,
  "text_len": 28
 },
 {
  "id": "sce043:01DAC",
  "jp": "トウヤ「ユミールにもちゃんとメル<E1>ィの気持ちが{nl}　伝わってるって。だから心配しなくても大丈夫だよ」",
