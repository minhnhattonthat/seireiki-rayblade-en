  "jp": "メル<E1>ィ「ホントぉ？」",
  "off": 7221,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7223,
  "text_len": 12
 },
 {
  "id": "sce043:01C47",
  "jp": "トウヤ「ああ、本当だとも！」",
  "off": 7239,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7241,
  "text_len": 17
 },
 {
  "id": "sce043:01C77",
  "jp": "メル<E1>ィ「えへへへ‥‥{nl}　そ、それじゃ、お願いね、お兄ちゃん」",
  "off": 7287,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7289,
  "text_len": 35
 },
 {
