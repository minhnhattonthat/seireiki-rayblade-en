[
 {
  "id": "sce043:00047",
  "jp": "トウヤ「‥‥ユミールは？」",
  "off": 71,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 73,
  "text_len": 17
 },
 {
  "id": "sce043:0006D",
  "jp": "フォルゼン「とりあえず家で休んでもらっていますよ。{nl}　今、パルディアさんとメル<E1>ィさん、それからレオーネさんが{nl}　付き添っています」",
  "off": 109,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 111,
  "text_len": 72
 },
 {
  "id": "sce043:000BB",
  "jp": "トウヤ「レオーネが？」",
  "off": 187,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 189,
  "text_len": 13
 },
 {
  "id": "sce043:000CE",
  "jp": "フォルゼン「ライルさんのことで少しでも自分が力に{nl}　なれたらって‥‥」",
  "off": 206,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 208,
  "text_len": 41
 },
 {
  "id": "sce043:000FD",
  "jp": "ヤマト「あの子らしいと言えばらしいけど‥‥」",
  "off": 253,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 255,
  "text_len": 26
 },
 {
  "id": "sce043:00120",
  "jp": "フォルゼン「とりあえず家で休んでもらっていますよ。{nl}　今、パルディアさんとメル<E1>ィさんが付き添っています」",
  "off": 288,
  "len": 61,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 290,
  "text_len": 58
 },
 {
  "id": "sce043:00163",
  "jp": "アイ「ユミール、大丈夫なの？」",
  "off": 355,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 357,
  "text_len": 20
 },
 {
  "id": "sce043:0017D",
  "jp": "フォルゼン「ユミールさんはとても傷つきやすく、{nl}　優しい子です。それゆえ自分を偽って強くあろうと{nl}　している‥‥どうも私達では頼りないようですね」",
  "off": 381,
  "len": 89,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 383,
  "text_len": 86
 },
 {
  "id": "sce043:001D9",
  "jp": "トウヤ「‥‥んなことねぇ。そう思っているんなら、{nl}　あんたの家には戻らねぇよ。家族だって言ってくれた{nl}　あんた達だから、心配かけたくねぇんだよ」",
  "off": 473,
  "len": 86,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 475,
  "text_len": 83
 },
 {
  "id": "sce043:00232",
  "jp": "フォルゼン「そう‥‥でしょうか？」",
  "off": 562,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 564,
  "text_len": 20
 },
 {
  "id": "sce043:0024C",
  "jp": "カスミ「私もそう思います。{page}　フォルゼンさんもパルディアさんも、{nl}　もちろんメル<E1>ィちゃんもユミールさんにとって{nl}　大切な“家族”なのですから」",
  "off": 588,
  "len": 84,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 590,
  "text_len": 81
 },
 {
  "id": "sce043:002A3",
  "jp": "フォルゼン「‥‥ユミールさんはいい仲間に恵まれましたね。{nl}　これからもあの子のことをお願いします」",
  "off": 675,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 677,
  "text_len": 57
 },
 {
  "id": "sce043:002E2",
  "jp": "トウヤ「そんな殊勝な態度、らしくねぇぜ？」",
  "off": 738,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 740,
  "text_len": 26
 },
 {
  "id": "sce043:00302",
  "jp": "フォルゼン「おや、これは心外ですね。{nl}　私だって家族を愛する善良な一市民なんですよ？」",
  "off": 770,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 772,
  "text_len": 55
 },
 {
  "id": "sce043:0033F",
  "jp": "トウヤ「善良な一市民が強請同然の方法を使って{nl}　人を拉致するか？」",
  "off": 831,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 833,
  "text_len": 49
 },
 {
  "id": "sce043:00376",
  "jp": "フォルゼン「はて？　なんのことでしょうか？」",
  "off": 886,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 888,
  "text_len": 24
 },
 {
  "id": "sce043:00394",
  "jp": "トウヤ「‥‥フッ。そういうほうがあんたらしいぜ」",
  "off": 916,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 918,
  "text_len": 26
 },
 {
  "id": "sce043:003B4",
  "jp": "フォルゼン「ふふふふふ。そうですね。{nl}　では私はイ<E1>ェル様のところへ行って、それから戻ります。{nl}　トウヤ君も片付いたら家へ来てください」",
  "off": 948,
  "len": 80,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 950,
  "text_len": 77
 },
 {
  "id": "sce043:00407",
  "jp": "トウヤ「ああ。わかったよ」",
  "off": 1031,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1033,
  "text_len": 13
 },
 {
  "id": "sce043:0041A",
  "jp": "フォルゼン「それでは‥‥」",
  "off": 1050,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1052,
  "text_len": 15
 },
 {
  "id": "sce043:0043A",
  "jp": "トウヤ「‥‥」",
  "off": 1082,
  "len": 12,
  "en": "Touya: ...",
  "status": "translated",
  "style": 0,
  "text_off": 1084,
  "text_len": 9
 },
 {
  "id": "sce043:00449",
  "jp": "ヤマト「どうしたの？」",
  "off": 1097,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1099,
  "text_len": 12
 },
 {
  "id": "sce043:0045B",
  "jp": "トウヤ「ちょっと、ライルのことを、な」",
  "off": 1115,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1117,
  "text_len": 19
 },
 {
  "id": "sce043:00474",
  "jp": "ヤマト「そうねぇ、ライルって、本当にウェニマスさんを{nl}　愛していたのね。だから初め、あれだけトウヤを目の敵に{nl}　してたんだね」",
  "off": 1140,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1142,
  "text_len": 69
 },
 {
  "id": "sce043:004BF",
  "jp": "トウヤ「ああ。あいつ、最後まで無茶苦茶な{nl}　奴だったよな」",
  "off": 1215,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1217,
  "text_len": 36
 },
 {
  "id": "sce043:004E9",
  "jp": "セリカ「でもどうして、あそこまでしたんだろ？」",
  "off": 1257,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1259,
  "text_len": 24
 },
 {
  "id": "sce043:00507",
  "jp": "<E1>ァルガ「‥‥おそらくは、奴等の目的がライブレードの{nl}　“コア”に変わったのじゃろ」",
  "off": 1287,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1289,
  "text_len": 52
 },
 {
  "id": "sce043:00541",
  "jp": "アイ「きゃっ‼　と、突然背後から現れないでよね！」",
  "off": 1345,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1347,
  "text_len": 32
 },
 {
  "id": "sce043:00571",
  "jp": "<E1>ァルガ「ほっほっほっ」",
  "off": 1393,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1395,
  "text_len": 12
 },
 {
  "id": "sce043:00583",
  "jp": "トウヤ「おい、それどういうことだ？」",
  "off": 1411,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1413,
  "text_len": 19
 },
 {
  "id": "sce043:0059C",
  "jp": "<E1>ァルガ「この前もリシュナが言っておったじゃろ？{nl}　<E1>ォーリアへの道が開かれた今、＜ゼ＝オード＞が{nl}　すべて揃わなくてもいいかもしれぬ、と」",
  "off": 1436,
  "len": 85,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1438,
  "text_len": 82
 },
 {
  "id": "sce043:005F4",
  "jp": "セリカ「ええ、覚えている‥‥！{nl}　‥‥ということは<E1>ォーリアを呼び出す活動を本格的に{nl}　再開したってこと？　そのために“コア”が‥‥」",
  "off": 1524,
  "len": 91,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1526,
  "text_len": 88
 },
 {
  "id": "sce043:00652",
  "jp": "トウヤ「“コア”？」",
  "off": 1618,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1620,
  "text_len": 13
 },
 {
  "id": "sce043:00665",
  "jp": "セリカ「聖霊機はもちろん装兵機にも使われている{nl}　主動力物質よ。私達が唯一作り出せないもの。{nl}　装兵機の数がそれほど多くないのは{nl}　この“コア”がそんなに発見されないからなの」",
  "off": 1637,
  "len": 118,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1639,
  "text_len": 115
 },
 {
  "id": "sce043:006DE",
  "jp": "トウヤ「発見って‥‥遺跡みたいに埋まっていて、それを{nl}　発掘してるってことか？」",
  "off": 1758,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1760,
  "text_len": 50
 },
 {
  "id": "sce043:00716",
  "jp": "セリカ「ええ。“コア”がなければ動かすこともできない。{nl}　でも、ライブレードの“コア”にそんな力が{nl}　あったなんて‥‥」",
  "off": 1814,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1816,
  "text_len": 69
 },
 {
  "id": "sce043:00761",
  "jp": "<E1>ァルガ「“コア”の本当の役割はそっちなんじゃ。{nl}　しかし、そんなことをすれば、ゴーデリウスに{nl}　過度の負担がかかる‥‥そこまでするということは‥‥」",
  "off": 1889,
  "len": 93,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1891,
  "text_len": 90
 },
 {
  "id": "sce043:007C1",
  "jp": "アイ「相当焦っている‥‥？」",
  "off": 1985,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1987,
  "text_len": 20
 },
 {
  "id": "sce043:007DB",
  "jp": "<E1>ァルガ「うむ。攻めるなら今かもしれぬが、{nl}　こちらも無傷というワケではない。{nl}　焦ったところでなにもないからな」",
  "off": 2011,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2013,
  "text_len": 62
 },
 {
  "id": "sce043:0081F",
  "jp": "トウヤ「リシュナは大丈夫なのか？」",
  "off": 2079,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2081,
  "text_len": 21
 },
 {
  "id": "sce043:0083A",
  "jp": "<E1>ァルガ「心配はいらぬ。今は眠っているが、すぐに{nl}　回復するじゃろう。しかし、ああいう無茶をするような{nl}　娘ではないと思っていたが‥‥」",
  "off": 2106,
  "len": 83,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2108,
  "text_len": 80
 },
 {
  "id": "sce043:00890",
  "jp": "オーレリィ「とりあえず、ここで話していても仕方ないよ。{nl}　休める時に身体を休めておかないと」",
  "off": 2192,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2194,
  "text_len": 55
 },
 {
  "id": "sce043:008CD",
  "jp": "アイ「それもそうね‥‥」",
  "off": 2253,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2255,
  "text_len": 14
 },
 {
  "id": "sce043:00905",
  "jp": "シャール「‥‥申し訳ございません‥‥{nl}　ライブレードの“コア”の回収に失敗いたしました」",
  "off": 2309,
  "len": 61,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2311,
  "text_len": 58
 },
 {
  "id": "sce043:00945",
  "jp": "デビッシュ「‥‥」",
  "off": 2373,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2375,
  "text_len": 11
 },
 {
  "id": "sce043:00956",
  "jp": "シャール「‥‥博士？」",
  "off": 2390,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2392,
  "text_len": 17
 },
 {
  "id": "sce043:0096D",
  "jp": "デビッシュ「‥‥あ、ああ‥‥すまん。{nl}　失敗は次の成功で償えばよい。{nl}　それより、ライルはどうした？」",
  "off": 2413,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2415,
  "text_len": 62
 },
 {
  "id": "sce043:009B1",
  "jp": "シャール「死にました。ですが、ご心配には及びません。{nl}　“コア”の回収は終わっております」",
  "off": 2481,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2483,
  "text_len": 55
 },
 {
  "id": "sce043:009EE",
  "jp": "デビッシュ「そうか。ならば、そろそろ動くか‥‥」",
  "off": 2542,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2544,
  "text_len": 27
 },
 {
  "id": "sce043:00A0F",
  "jp": "シャール「まさか、ライブレードの“コア”抜きで{nl}　召喚を行うのですか？」",
  "off": 2575,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2577,
  "text_len": 45
 },
 {
  "id": "sce043:00A42",
  "jp": "デビッシュ「なにか問題があるのか？」",
  "off": 2626,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2628,
  "text_len": 21
 },
 {
  "id": "sce043:00A5D",
  "jp": "シャール「しかし、そんなことをすればお身体が‥‥」",
  "off": 2653,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2655,
  "text_len": 30
 },
 {
  "id": "sce043:00A81",
  "jp": "デビッシュ「心配してくれるのか？　ふふふ‥‥{nl}　だが、これはもう決めたことだ。{nl}　協力してくれるな？」",
  "off": 2689,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2691,
  "text_len": 60
 },
 {
  "id": "sce043:00AC3",
  "jp": "シャール「‥‥はい」",
  "off": 2755,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2757,
  "text_len": 13
 },
 {
  "id": "sce043:00AD6",
  "jp": "デビッシュ「いい子だ」",
  "off": 2774,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2776,
  "text_len": 12
 },
 {
  "id": "sce043:00B04",
  "jp": "ヤマト「‥‥ユミール、部屋から出てこニャかったね」",
  "off": 2820,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2822,
  "text_len": 31
 },
 {
  "id": "sce043:00B29",
  "jp": "トウヤ「ああ‥‥食欲がないからって言っていたが‥‥」",
  "off": 2857,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2859,
  "text_len": 33
 },
 {
  "id": "sce043:00B5F",
  "jp": "トウヤ「ん？　どうぞ」",
  "off": 2911,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2913,
  "text_len": 12
 },
 {
  "id": "sce043:00B84",
  "jp": "トウヤ「‥‥どうした？」",
  "off": 2948,
  "len": 18,
  "en": "Touya: ...What's wrong?",
  "status": "translated",
  "style": 0,
  "text_off": 2950,
  "text_len": 15
 },
 {
  "id": "sce043:00BAB",
  "jp": "メル<E1>ィ「あのね‥‥お兄ちゃんにお願いがあるの」",
  "off": 2987,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2989,
  "text_len": 28
 },
 {
  "id": "sce043:00BCD",
  "jp": "トウヤ「？」",
  "off": 3021,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3023,
  "text_len": 7
 },
 {
  "id": "sce043:00BEC",
  "jp": "メル<E1>ィ「その‥‥お姉ちゃんを励ましてあげてほしいの。{nl}　お姉ちゃん平気だって言ってるけど‥‥」",
  "off": 3052,
  "len": 61,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3054,
  "text_len": 58
 },
 {
  "id": "sce043:00C3C",
  "jp": "　よし、任せておけ{nl}　メル<E1>ィは優しいな{nl}　ユミールは大丈夫だよ",
  "off": 3132,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 192,
  "text_off": 3134,
  "text_len": 38
 },
 {
  "id": "sce043:00C80",
  "jp": "メル<E1>ィ「‥‥ありがとう、お兄ちゃん。{nl}　そ、それじゃ、お願い‥‥」",
  "off": 3200,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3202,
  "text_len": 40
 },
 {
  "id": "sce043:00CBE",
