  "jp": "トウヤ「おう」",
  "off": 7328,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7330,
  "text_len": 7
 },
 {
  "id": "sce043:01CB8",
  "jp": "メル<E1>ィ「じゃ‥‥」",
  "off": 7352,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7354,
  "text_len": 12
 },
 {
  "id": "sce043:01CE5",
  "jp": "メル<E1>ィ「でもぉ‥‥」",
  "off": 7397,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7399,
  "text_len": 13
 },
 {
  "id": "sce043:01CF8",
  "jp": "トウヤ「きっと、いろいろなことがありすぎて{nl}　混乱してるだけだよ。そんなに心配することないって」",
  "off": 7416,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7418,
  "text_len": 52
 },
 {
