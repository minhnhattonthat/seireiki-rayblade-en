  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1152,
  "text_len": 8
 },
 {
  "id": "sce095:0048C",
  "jp": "トウヤ「なんでもいいぞ」",
  "off": 1164,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1166,
  "text_len": 12
 },
 {
  "id": "sce095:0049E",
  "jp": "ヤマト「そうよ。この際、日頃の分もまとめて{nl}　請求しちゃえ」",
