 {
  "id": "sce095:00200",
  "jp": "ヤマト「‥‥ちゃんとニャかにいるはずニャんだけど‥‥」",
  "off": 512,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 514,
  "text_len": 31
 },
 {
  "id": "sce095:00225",
  "jp": "トウヤ「寝ちまったのか？」",
  "off": 549,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 551,
  "text_len": 15
 },
 {
  "id": "sce095:0023A",
  "jp": "ヤマト「う～ん‥‥あっ！　カスミってニャにかに集中すると{nl}　周りの音とか聞こえニャくニャるんじゃニャかった？」",
  "off": 570,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 572,
  "text_len": 65
 },
 {
  "id": "sce095:00281",
  "jp": "トウヤ「‥‥そういえばそうだったような‥‥{nl}　ん？　てぇーことは‥‥」",
  "off": 641,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 643,
  "text_len": 43
 },
 {
  "id": "sce095:002B2",
  "jp": "ヤマト「ボタンを縫ってるのよ。{nl}　すぐ終わるだろうし、また後で来てみようよ」",
  "off": 690,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 692,
  "text_len": 42
 },
 {
