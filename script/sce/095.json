  "off": 910,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 912,
  "text_len": 19
 },
 {
  "id": "sce095:003A7",
  "jp": "トウヤ「そうか、なんかそんな気がしたんだ」",
