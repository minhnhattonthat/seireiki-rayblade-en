  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1671,
  "text_len": 30
 },
 {
  "id": "sce095:006A9",
  "jp": "カスミ「でも、この戦いが終わったら、一緒に帰ろうね。{nl}　晃一郎君もまってるあの世界に」",
  "off": 1705,
  "len": 57,
  "en": "",
