 },
 {
  "id": "sce445:01066",
  "jp": "ユミール「あっ！」",
  "off": 4198,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4200,
  "text_len": 11
 },
 {
  "id": "sce445:01077",
  "jp": "ヤマト「目が覚めたみたいね」",
  "off": 4215,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4217,
  "text_len": 16
 },
 {
  "id": "sce445:0108D",
  "jp": "トウヤ「‥‥だな」",
  "off": 4237,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4239,
  "text_len": 11
 },
 {
  "id": "sce445:010A6",
  "jp": "ユミール「はは、はははは‥‥お、おはよう」",
  "off": 4262,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4264,
  "text_len": 24
 },
 {
  "id": "sce445:010C4",
  "jp": "トウヤ「おはよう」",
  "off": 4292,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4294,
  "text_len": 9
 },
 {
  "id": "sce445:010DE",
  "jp": "ユミール「あ、あの‥‥私、ヘンなこと言わなかった？」",
  "off": 4318,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4320,
  "text_len": 32
 },
 {
  "id": "sce445:0110C",
  "jp": "トウヤ「そういやぁ、この前も同じこと言ってたよな？」",
  "off": 4364,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4366,
  "text_len": 30
 },
 {
  "id": "sce445:01142",
  "jp": "ユミール「え？　そ、そうだったかしら‥‥？」",
  "off": 4418,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4420,
  "text_len": 27
 },
 {
  "id": "sce445:01163",
  "jp": "トウヤ「ああ」",
  "off": 4451,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4453,
  "text_len": 7
 },
 {
  "id": "sce445:01182",
  "jp": "ユミール「‥‥なんだか、よく見られちゃうわね」",
  "off": 4482,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4484,
  "text_len": 27
 },
 {
  "id": "sce445:011A3",
  "jp": "トウヤ「そういえば、そうだな」",
  "off": 4515,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4517,
  "text_len": 15
 },
 {
  "id": "sce445:011B8",
  "jp": "ヤマト「二人は運命で結ばれているのかもねぇ」",
  "off": 4536,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4538,
  "text_len": 27
 },
 {
  "id": "sce445:011D9",
  "jp": "ユミール「も、もぅ、ヤマトちゃん⁈」",
  "off": 4569,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4571,
  "text_len": 20
 },
 {
  "id": "sce445:011F3",
  "jp": "ヤマト「はははは、冗談よ、冗談」",
  "off": 4595,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4597,
  "text_len": 20
 },
 {
  "id": "sce445:01218",
  "jp": "ユミール「もぅ。{nl}{ctl:3C3E}{face:841910}{ctl:023E}{face:8419F4}　あ、あの‥‥本当に私、なにも言ってなかった？」",
  "off": 4632,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4634,
  "text_len": 57
 },
 {
  "id": "sce445:01257",
  "jp": "トウヤ「ああ、別になにも‥‥起きた時は寝ぼけてたがな」",
  "off": 4695,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4697,
  "text_len": 33
 },
 {
  "id": "sce445:01290",
  "jp": "ユミール「そ、そう。うん、私、寝起きがちょっと弱いの。{nl}　だから朝とか辛くて‥‥」",
  "off": 4752,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4754,
  "text_len": 50
 },
 {
  "id": "sce445:012C8",
  "jp": "ヤマト「‥‥みたいね。あっ、ねぇねぇ、ところでさ、{nl}　ニャんでこんニャところで寝てたの？」",
  "off": 4808,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4810,
  "text_len": 49
 },
 {
  "id": "sce445:01303",
  "jp": "ユミール「ちょっと、対フィールドユニットの出力に{nl}　ゆらぎがあって、それの解決策を考えてたの」",
  "off": 4867,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4869,
  "text_len": 56
 },
 {
  "id": "sce445:01341",
  "jp": "ヤマト「それって不安定ってこと？」",
  "off": 4929,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4931,
  "text_len": 21
 },
 {
  "id": "sce445:0135C",
  "jp": "ユミール「いいえ。動作や効果に関しては問題ないわ。{nl}　ただ、こういうのって関係ないようなちょっとしたことでも{nl}　不具合につながる可能性があるから」",
  "off": 4956,
  "len": 92,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4958,
  "text_len": 89
 },
 {
  "id": "sce445:013BB",
  "jp": "トウヤ「そりゃそうだが‥‥ずっと休みなしだろ？{nl}　少しぐらい休まねぇと身体壊すぞ？」",
  "off": 5051,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5053,
  "text_len": 52
 },
 {
  "id": "sce445:01407",
  "jp": "ユミール「心配してくれて、ありがとう。{nl}{ctl:3C3E}{face:041902}{ctl:023E}{face:0419F0}　でも、私は大丈夫よ。それにこういうことでしか役に{nl}　立てないから‥‥」",
  "off": 5127,
  "len": 86,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5129,
  "text_len": 83
 },
 {
  "id": "sce445:01460",
  "jp": "トウヤ「そんなことねぇよ。ユミールは十分やってるって。{nl}　それに聖霊機だって、セリカが設計したとしても{nl}　ユミールがいなければここまでにならなかったんだろ？」",
  "off": 5216,
  "len": 92,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5218,
  "text_len": 89
 },
 {
  "id": "sce445:014BF",
  "jp": "ヤマト「そうよ。どうしてそんニャ風に思うの？」",
  "off": 5311,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5313,
  "text_len": 26
 },
 {
  "id": "sce445:014F1",
  "jp": "ユミール「トウヤだって、他のみんなだって命をはって{nl}　戦ってるのに私はただ見てることしかできないし‥‥」",
  "off": 5361,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5363,
  "text_len": 60
 },
 {
  "id": "sce445:01533",
  "jp": "トウヤ「すべてのことができる人間なんていねぇと思うぜ。{nl}　ユミールにはユミールにしかできないことがあるし、{nl}　リーボーフェンを守るのも俺達が帰ってこれる場所を{nl}　守ることだし、十分役に立ってるって。{nl}　なにより、ユミールが後方でサポートしてくれるってことは{nl}　結構、安心してるんだぜ？」",
  "off": 5427,
  "len": 173,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5429,
  "text_len": 170
 },
 {
  "id": "sce445:015E3",
  "jp": "ユミール「そ、そう‥‥？」",
  "off": 5603,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5605,
  "text_len": 17
 },
 {
  "id": "sce445:015FA",
  "jp": "ヤマト「誰も文句ニャんて言わニャいでしょ？{nl}　みんニャ、信頼してるのよ」",
  "off": 5626,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5628,
  "text_len": 43
 },
 {
  "id": "sce445:0163D",
  "jp": "ユミール「そうだとうれしいな。{nl}{ctl:3C3E}{face:04160A}{ctl:023E}{face:041909}{ctl:013E}{face:0419F2}　よし、それじゃ、みんなの為にももっと頑張らないと{nl}　いけないわね」",
  "off": 5693,
  "len": 81,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5695,
  "text_len": 78
 },
 {
  "id": "sce445:01691",
  "jp": "トウヤ「え？」",
  "off": 5777,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5779,
  "text_len": 8
 },
 {
  "id": "sce445:0169F",
  "jp": "ユミール「ありがとう。なんだかモヤモヤが晴れた気分よ。{nl}　それじゃ」",
  "off": 5791,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5793,
  "text_len": 38
 },
 {
  "id": "sce445:016CF",
  "jp": "ヤマト「‥‥逆効果だったかニャ？」",
  "off": 5839,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5841,
  "text_len": 23
 },
 {
  "id": "sce445:016EC",
  "jp": "トウヤ「うーん‥‥」",
  "off": 5868,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5870,
  "text_len": 13
 }
]
