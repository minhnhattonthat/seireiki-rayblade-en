  "status": "todo",
  "style": 0,
  "text_off": 9786,
  "text_len": 26
 },
 {
  "id": "sce012:02658",
  "jp": "クロビス「アイが着てるとなんとも思わんが‥‥{nl}　こうしてみるとなかな‥‥」",
