  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9271,
  "text_len": 30
 },
 {
  "id": "sce012:02459",
  "jp": "ユミール「あれ？　結構、明るめのやつを{nl}　持ってきたんだけど‥‥」",
