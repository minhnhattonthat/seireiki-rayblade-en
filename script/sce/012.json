  "style": 0,
  "text_off": 8490,
  "text_len": 40
 },
 {
  "id": "sce012:0216B",
  "jp": "レオーネ「‥‥というワケなの。わかってくれた？」",
  "off": 8555,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8557,
  "text_len": 28
 },
 {
  "id": "sce012:02199",
  "jp": "アイ「ふぅ～ん‥‥まぁ、嘘はついてないみたいね。{nl}　それで、どうするつもりだったの？」",
  "off": 8601,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8603,
  "text_len": 48
 },
 {
  "id": "sce012:021CF",
  "jp": "トウヤ「とりあえず服#772を調達しようかなぁ‥‥と」",
  "off": 8655,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8657,
  "text_len": 28
 },
 {
  "id": "sce012:021FD",
  "jp": "オーレリィ「なるほど。話は聞かせてもらったよ。{nl}　そういうことだったらアタシ達で揖意して{nl}　その子に好きなのを選んでもらったら？」",
  "off": 8701,
  "len": 78,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8703,
  "text_len": 75
 },
 {
  "id": "sce012:0224E",
  "jp": "クロビス「俺はそのままのほうが‥‥」",
  "off": 8782,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8784,
  "text_len": 21
 },
 {
  "id": "sce012:02274",
  "jp": "クロビス「いてっ！」",
  "off": 8820,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8822,
  "text_len": 11
 },
 {
  "id": "sce012:02297",
  "jp": "オーレリィ「はいはい、それじゃ各自揖意してくるように！」",
  "off": 8855,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8857,
  "text_len": 34
 },
 {
  "id": "sce012:022BF",
  "jp": "ユミール「そうですね。{nl}　その格好でいるわけにもいきませんし‥‥」",
  "off": 8895,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8897,
  "text_len": 38
 },
 {
  "id": "sce012:022EB",
  "jp": "アイ「だったらセリカにも声かけようよ。{nl}　あの子、いっぱいもってたし」",
  "off": 8939,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8941,
  "text_len": 37
 },
 {
  "id": "sce012:02328",
  "jp": "オーレリィ「それじゃそういうことで。{nl}　集合はトウヤの部屋ということで。解散！」",
  "off": 9000,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9002,
  "text_len": 48
 },
 {
  "id": "sce012:02369",
  "jp": "レオーネ「なんだか決まっちゃったみたいね」",
  "off": 9065,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9067,
  "text_len": 23
 },
 {
  "id": "sce012:02386",
  "jp": "トウヤ「ああ‥‥とりあえず行くか」",
  "off": 9094,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9096,
  "text_len": 20
 },
 {
  "id": "sce012:023A0",
  "jp": "レオーネ「うん」",
  "off": 9120,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9122,
  "text_len": 9
 },
 {
  "id": "sce012:023D1",
  "jp": "オーレリィ「はぁーい、それじゃ、まずは{nl}　ユミールの提供品！」",
  "off": 9169,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9171,
  "text_len": 38
 },
