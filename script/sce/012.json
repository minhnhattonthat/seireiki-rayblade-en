  "off": 2950,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2952,
  "text_len": 23
 },
 {
  "id": "sce012:00BA3",
  "jp": "整備止C「は、はい！　うわっ、わーっ！」",
  "off": 2979,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2981,
  "text_len": 26
 },
 {
  "id": "sce012:00BCA",
  "jp": "整備止D「だ、大丈夫ですか⁉」",
  "off": 3018,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3020,
  "text_len": 22
 },
 {
  "id": "sce012:00BE6",
  "jp": "セリカ「ふぅーっ、危うくミンチになるところだったわ‥‥」",
  "off": 3046,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3048,
  "text_len": 32
 },
 {
  "id": "sce012:00C0C",
  "jp": "整備止C「す、すみません！」",
  "off": 3084,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3086,
  "text_len": 18
 },
 {
  "id": "sce012:00C24",
  "jp": "整備止A「馬鹿野郎！　こともあろうにチーフを‥‥」",
  "off": 3108,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3110,
  "text_len": 36
 },
 {
  "id": "sce012:00C4E",
  "jp": "セリカ「いいって。別になんともないし、{nl}　それにわざとじゃないんだから」",
  "off": 3150,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3152,
  "text_len": 37
 },
 {
  "id": "sce012:00C79",
  "jp": "整備止D「おおっ！　なんと広い心の持ち主だぁっ！{nl}　私は、今、猛烈な感動にうちひしがれているぅ！」",
  "off": 3193,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3195,
  "text_len": 65
 },
 {
  "id": "sce012:00CC0",
  "jp": "セリカ「いや、そこまで感動してもらわなくても‥‥」",
  "off": 3264,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3266,
  "text_len": 29
 },
 {
  "id": "sce012:00CE3",
  "jp": "ヤマト「あっ、やってるやってる」",
  "off": 3299,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3301,
  "text_len": 16
 },
 {
  "id": "sce012:00CF9",
  "jp": "トウヤ「どうだ調子は？」",
  "off": 3321,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3323,
  "text_len": 15
 },
 {
  "id": "sce012:00D18",
  "jp": "セリカ「あ、うん、まあまあってとこかな‥‥」",
  "off": 3352,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3354,
  "text_len": 24
 },
 {
  "id": "sce012:00D36",
  "jp": "ヤマト「あれ？　ニャんか顔色悪くニャい？」",
  "off": 3382,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3384,
  "text_len": 26
 },
 {
  "id": "sce012:00D56",
  "jp": "セリカ「う、うん‥‥昨日はライブレードの{nl}　最終調整で徹夜だったから‥‥」",
  "off": 3414,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3416,
  "text_len": 50
 },
 {
  "id": "sce012:00D8E",
  "jp": "トウヤ「おいおい、大丈夫か？」",
  "off": 3470,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3472,
  "text_len": 19
 },
 {
  "id": "sce012:00DA7",
  "jp": "整備止F「あたしだったら自分の彼氏でもそこまで{nl}　できませんよ。まぁ、そのおかげでシステム関係を{nl}　残してほとんど調整は終わったんですからね。{nl}　ほんと、寝る間も惜しむとはチーフの為に{nl}　あるような言葉ですね」",
  "off": 3495,
  "len": 128,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3497,
  "text_len": 125
 },
 {
  "id": "sce012:00E2A",
  "jp": "セリカ「ち、ちょっと‥‥」",
  "off": 3626,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3628,
  "text_len": 15
 },
 {
  "id": "sce012:00E3F",
  "jp": "トウヤ「そっか‥‥セリカ、ありがとうな」",
  "off": 3647,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3649,
  "text_len": 22
 },
 {
  "id": "sce012:00E5B",
  "jp": "セリカ「え？　う、うん‥‥」",
  "off": 3675,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3677,
  "text_len": 17
 },
 {
  "id": "sce012:00E72",
  "jp": "トウヤ「でも、あまり無理はすんなよ。{nl}　お前に倒れられたら安心して任せられるやつが{nl}　いなくなるんだからな」",
  "off": 3698,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3700,
  "text_len": 61
 },
 {
  "id": "sce012:00EB5",
  "jp": "セリカ「え？」",
  "off": 3765,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3767,
  "text_len": 8
 },
 {
  "id": "sce012:00EC3",
  "jp": "整備止F「それだけチーフを信頼してるってことですね。{nl}　その信頼がやがて燃え上がる恋に‥‥{nl}　ああ、なんかあこがれちゃうなぁ」",
  "off": 3779,
  "len": 79,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3781,
  "text_len": 76
 },
 {
  "id": "sce012:00F1A",
  "jp": "セリカ「ちょっと⁉　な、なに言い出すのよ！」",
  "off": 3866,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3868,
  "text_len": 26
 },
 {
  "id": "sce012:00F3A",
  "jp": "整備止F「あれ？{nl}　まんざらでもないって顔に薯いてますよぉ」",
  "off": 3898,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3900,
  "text_len": 36
 },
 {
  "id": "sce012:00F64",
  "jp": "セリカ「もぅ！　そんなんじゃないよ。{nl}　ねぇ、トウヤ‥‥？」",
  "off": 3940,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3942,
  "text_len": 34
 },
 {
  "id": "sce012:00F8C",
  "jp": "トウヤ「そっか‥‥ようやく直るのかぁ‥‥」",
  "off": 3980,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3982,
  "text_len": 26
 },
 {
  "id": "sce012:00FAC",
  "jp": "ヤマト「こうして見るとニャんか“威厳”みたいニャのを{nl}　感じるわねぇ‥‥」",
  "off": 4012,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4014,
  "text_len": 45
 },
 {
  "id": "sce012:00FDF",
  "jp": "整備止F「‥‥全然聞いちゃいませんね」",
  "off": 4063,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4065,
  "text_len": 27
 },
 {
  "id": "sce012:01000",
  "jp": "セリカ「‥‥」",
  "off": 4096,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4098,
  "text_len": 9
 },
 {
  "id": "sce012:0100F",
  "jp": "トウヤ「ん？　なに？」",
  "off": 4111,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4113,
  "text_len": 13
 },
 {
  "id": "sce012:01022",
  "jp": "セリカ「なんでもない！」",
  "off": 4130,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4132,
  "text_len": 13
 },
 {
  "id": "sce012:01035",
  "jp": "トウヤ「なに努ってんだ？」",
  "off": 4149,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4151,
  "text_len": 15
 },
 {
  "id": "sce012:0104A",
  "jp": "セリカ「まだやることあるんだからね！{nl}　ほらほら、どいたどいた！」",
  "off": 4170,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4172,
  "text_len": 35
 },
 {
  "id": "sce012:01073",
  "jp": "ヤマト「ここは退散したほうがいいみたいね」",
  "off": 4211,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4213,
  "text_len": 23
 },
 {
  "id": "sce012:01090",
  "jp": "トウヤ「‥‥だな」",
  "off": 4240,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4242,
  "text_len": 11
 },
 {
  "id": "sce012:010A4",
  "jp": "セリカ「そんなことあるワケないでしょ」",
  "off": 4260,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4262,
  "text_len": 19
 },
 {
  "id": "sce012:010BD",
  "jp": "整備止F「あれ？　そうですか？　あたしはてっきり‥‥」",
  "off": 4285,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4287,
  "text_len": 34
 },
 {
  "id": "sce012:010E5",
  "jp": "セリカ「ないない。ねっ、トウヤ？」",
  "off": 4325,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4327,
  "text_len": 18
 },
 {
  "id": "sce012:010FD",
  "jp": "トウヤ「そっか‥‥ようやく直るのかぁ‥‥」",
  "off": 4349,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4351,
  "text_len": 26
 },
 {
  "id": "sce012:0111D",
  "jp": "ヤマト「こうして見るとニャんか“威厳”みたいニャのを{nl}　感じるわねぇ‥‥」",
  "off": 4381,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4383,
  "text_len": 45
 },
 {
  "id": "sce012:01150",
  "jp": "整備止F「‥‥全然聞いちゃいませんね」",
  "off": 4432,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4434,
  "text_len": 27
 },
 {
  "id": "sce012:01171",
  "jp": "セリカ「‥‥そうみたいね」",
  "off": 4465,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4467,
  "text_len": 15
 },
 {
  "id": "sce012:01186",
  "jp": "トウヤ「ん？　なんか言ったか？」",
  "off": 4486,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4488,
  "text_len": 19
 },
 {
  "id": "sce012:0119F",
  "jp": "セリカ「う、ううん、別になんでもないわ。{nl}　それより、ライブレードはこっちに任せといて。{nl}　完璧に仕上げてみせるから」",
  "off": 4511,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4513,
  "text_len": 66
 },
 {
  "id": "sce012:011E7",
  "jp": "トウヤ「わかった。でもまぁ、あんまり無理はすんなよ」",
  "off": 4583,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4585,
  "text_len": 28
 },
 {
  "id": "sce012:01209",
  "jp": "セリカ「わかってるって」",
  "off": 4617,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4619,
  "text_len": 12
 },
 {
  "id": "sce012:0121B",
  "jp": "トウヤ「それじゃあな」",
  "off": 4635,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4637,
  "text_len": 11
 },
 {
  "id": "sce012:01250",
  "jp": "ヤマト「あれ？　みんニャこんニャとこでニャにやってるの？」",
  "off": 4688,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4690,
  "text_len": 31
 },
 {
  "id": "sce012:01275",
  "jp": "シィウチェン「またエンジンの調子がおかしくなったようでな。{nl}　見てのとおり休息中だ」",
  "off": 4725,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4727,
  "text_len": 48
 },
 {
  "id": "sce012:012B7",
  "jp": "オーレリィ「ヤマトちゃんもこっちおいで。{nl}　ほら、アタシの膝の上に」",
  "off": 4791,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4793,
  "text_len": 37
 },
 {
  "id": "sce012:012E2",
  "jp": "トウヤ「おいおい、そんな悠長なことしてていいのか？{nl}　もっと他にやることあんだろ？{nl}　ガボンのおっちゃんを手田うとかよ」",
  "off": 4834,
  "len": 70,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4836,
  "text_len": 67
 },
 {
  "id": "sce012:01337",
  "jp": "アーサー「今の私達の仕事は休むことです。{nl}　なんでも手田うのは悪いことではありませんが、{nl}　信頼して任せるのも一つの方法です。{nl}　ま、気晴らしにそのへんを散歩してきたらどうですか？」",
  "off": 4919,
  "len": 116,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4921,
  "text_len": 113
 },
 {
  "id": "sce012:013BA",
  "jp": "シィウチェン「我々のいた世界と違って{nl}　“生きた自然”が見られるぞ。{nl}　緑は心を癒してくれるからな」",
  "off": 5050,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5052,
  "text_len": 63
 },
 {
  "id": "sce012:013FF",
  "jp": "ヤマト「ね、行ってみようよ。{nl}　こんニャ時間ってめったにニャいかもしれニャいもの。{nl}　それに姉弟水入らずで散歩もたまにはいいじゃニャい」",
  "off": 5119,
  "len": 80,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5121,
  "text_len": 77
 },
 {
  "id": "sce012:01452",
  "jp": "トウヤ「誰が姉だ、誰が。{nl}　‥‥まぁ、艦内にばかりいるのもなんだし、{nl}　行ってみるか」",
  "off": 5202,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5204,
  "text_len": 51
 },
 {
  "id": "sce012:0148B",
  "jp": "ヤマト「そうこニャくっちゃ！」",
  "off": 5259,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5261,
  "text_len": 16
 },
 {
  "id": "sce012:014C6",
  "jp": "ヤマト「あっ、こっちで水の音がするよ。{nl}　いってみよう！」",
  "off": 5318,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5320,
  "text_len": 32
 },
 {
  "id": "sce012:014EC",
  "jp": "トウヤ「お、おい！　まてよ！」",
  "off": 5356,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5358,
  "text_len": 17
 },
 {
  "id": "sce012:01517",
  "jp": "ヤマト「ほら、綺麗ニャ小川があるよ！{nl}　おさかニャいるかニャぁ？」",
  "off": 5399,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5401,
  "text_len": 39
 },
 {
  "id": "sce012:01544",
  "jp": "トウヤ「‥‥そういうことかよ。{nl}　ま、いいや。俺も手田ってやるよ」",
  "off": 5444,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5446,
  "text_len": 38
 },
 {
  "id": "sce012:01577",
  "jp": "トウヤ「よし、このあたりならいいだろう。{nl}　こういう木の下とかに魚は‥‥ん？{nl}　この服#772はなんだ？」",
  "off": 5495,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5497,
  "text_len": 57
 },
 {
  "id": "sce012:015B6",
  "jp": "ヤマト「‥‥きれいにたたまれてるわね。{nl}　ということは‥‥」",
  "off": 5558,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5560,
  "text_len": 34
 },
 {
  "id": "sce012:015E5",
