  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 10238,
  "text_len": 27
 },
 {
  "id": "sce012:02837",
  "jp": "セリカ「トウヤ！　ダメって言ってるでしょ！{nl}　調整が終わってないんだから！」",
  "off": 10295,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 10297,
  "text_len": 45
 },
 {
  "id": "sce012:0286A",
  "jp": "トウヤ「ヤツに対抗できるのはライブレードしかねぇ！」",
