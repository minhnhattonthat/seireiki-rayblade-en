  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6463,
  "text_len": 37
 },
 {
  "id": "sce012:01968",
  "jp": "トウヤ「いや、そういう問題じゃなくて‥‥{nl}　それ、再生不可能な状態じゃ‥‥」",
