  "jp": "レオーネ「ち、ちょっと、地味‥‥かなぁ、なんて‥‥」",
  "off": 9352,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9354,
  "text_len": 33
 },
 {
  "id": "sce012:024AF",
  "jp": "ユミール「そ、そう‥‥」",
  "off": 9391,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9393,
  "text_len": 15
 },
 {
  "id": "sce012:024C4",
