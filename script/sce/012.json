  "status": "todo",
  "style": 0,
  "text_off": 111,
  "text_len": 10
 },
 {
  "id": "sce012:0007D",
  "jp": "ユミール「ミヤスコ？」",
  "off": 125,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 127,
  "text_len": 13
 },
 {
  "id": "sce012:00090",
  "jp": "ミヤスコ「え？　あ、すみません‥‥」",
  "off": 144,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 146,
  "text_len": 21
 },
 {
  "id": "sce012:000AB",
  "jp": "シスク「ねぇ、本当に大丈夫？　休んだほうがいいよ。{nl}　“医者の不養生”って言葉があるらしいけど、{nl}　今のミヤスコはまさにそれだよ」",
  "off": 171,
  "len": 85,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 173,
  "text_len": 82
 },
 {
  "id": "sce012:00103",
  "jp": "ミヤスコ「ううん、大丈夫。{nl}　それに、病気じゃないから‥‥」",
  "off": 259,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 261,
  "text_len": 37
 },
 {
  "id": "sce012:0012E",
  "jp": "シスク「‥‥」",
  "off": 302,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 304,
  "text_len": 9
 },
 {
  "id": "sce012:0013D",
  "jp": "ミヤスコ「大丈夫だって。{nl}　‥‥ホラ」",
  "off": 317,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 319,
  "text_len": 24
 },
 {
  "id": "sce012:0015B",
  "jp": "シスク「‥‥ねぇ。あたし達、友達だよね？{nl}　友達に隠し事はダメだよ」",
  "off": 347,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 349,
  "text_len": 44
 },
 {
  "id": "sce012:0018D",
  "jp": "ミヤスコ「え？　う、うん‥‥」",
  "off": 397,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 399,
  "text_len": 18
 },
 {
  "id": "sce012:001A5",
  "jp": "シスク「ミヤスコぉ～」",
  "off": 421,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 423,
  "text_len": 12
 },
 {
  "id": "sce012:001B7",
  "jp": "ミヤスコ「‥‥そうね。でも‥‥」",
  "off": 439,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 441,
  "text_len": 20
 },
 {
  "id": "sce012:001D1",
  "jp": "シスク「う～ん、あたしってそんなに頼りないかな？」",
  "off": 465,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 467,
  "text_len": 28
 },
 {
  "id": "sce012:001F3",
  "jp": "ミヤスコ「‥‥思いやりは友をつくる‥‥{nl}　でも真実は敵をつくる‥‥」",
  "off": 499,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 501,
  "text_len": 45
 },
 {
  "id": "sce012:00226",
  "jp": "シスク「‥‥ミヤスコ？」",
  "off": 550,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 552,
  "text_len": 15
 },
 {
  "id": "sce012:0023B",
  "jp": "ミヤスコ「‥‥あっ‥‥ごめん、私ったら‥‥」",
  "off": 571,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 573,
  "text_len": 29
 },
 {
  "id": "sce012:0025E",
  "jp": "シスク「ううん‥‥わかった。{nl}　それじゃ、話してくれるまで待つことにする」",
  "off": 606,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 608,
  "text_len": 41
 },
 {
  "id": "sce012:0028D",
  "jp": "ミヤスコ「‥‥ごめんね」",
  "off": 653,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 655,
  "text_len": 14
 },
 {
  "id": "sce012:002A1",
  "jp": "シスク「いいって。‥‥でも、本当の友達は{nl}　決して裏切らないってことも覚えておいてね」",
  "off": 673,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 675,
  "text_len": 53
 },
 {
  "id": "sce012:002ED",
  "jp": "ミヤスコ「あっ！　か、艦長！{nl}　ローディス殿下から通信が入っています」",
  "off": 749,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 751,
  "text_len": 45
 },
 {
  "id": "sce012:00320",
  "jp": "ロア艦長「うむ」",
  "off": 800,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 802,
  "text_len": 10
 },
 {
  "id": "sce012:00330",
  "jp": "ユミール「‥‥はい。ミヤスコ、モニターに回して」",
  "off": 816,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 818,
  "text_len": 29
 },
 {
  "id": "sce012:00353",
  "jp": "ミヤスコ「り、了解」",
  "off": 851,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 853,
  "text_len": 12
 },
 {
  "id": "sce012:00374",
  "jp": "ローディス「やあ。そちらはどうだった？」",
  "off": 884,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 886,
  "text_len": 22
 },
 {
  "id": "sce012:00395",
  "jp": "ユミール「いえ、ダメでした。{nl}　そのかわりと言ってはなんですが、{nl}　リンバーグのカイン王子と戦いました」",
  "off": 917,
  "len": 61,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 919,
  "text_len": 58
 },
 {
  "id": "sce012:003D5",
  "jp": "ローディス「カイン！　まさか‥‥」",
  "off": 981,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 983,
  "text_len": 21
 },
 {
  "id": "sce012:003F0",
  "jp": "セリカ「間違いないわ。私も話したもの」",
  "off": 1008,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1010,
  "text_len": 23
 },
 {
  "id": "sce012:0040D",
  "jp": "ローディス「そうか‥‥しかしなぜカインが‥‥」",
  "off": 1037,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1039,
  "text_len": 28
 },
 {
  "id": "sce012:0042F",
  "jp": "クロビス「そんなことより、そっちの反応のほうは{nl}　どうだったんだ？」",
  "off": 1071,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1073,
  "text_len": 37
 },
 {
  "id": "sce012:0045D",
  "jp": "ユミール「‥‥いえ‥‥そちらはいかがでした？」",
  "off": 1117,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1119,
  "text_len": 29
 },
 {
  "id": "sce012:00480",
  "jp": "ローディス「ああ、あれ以来まったく反応がない。{nl}　そのかわり、例のテロリストが現れた」",
  "off": 1152,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1154,
  "text_len": 50
 },
 {
  "id": "sce012:004B8",
  "jp": "トウヤ「なに⁈」",
  "off": 1208,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1210,
  "text_len": 9
 },
 {
  "id": "sce012:004C7",
  "jp": "ローディス「しかし、まったく統制がとれてなく、{nl}　すぐに鎮庄されたがな。{nl}　どうも向こうも内部で色々あるようだ」",
  "off": 1223,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1225,
  "text_len": 65
 },
 {
  "id": "sce012:0050E",
  "jp": "クロビス「内部分裂か‥‥」",
  "off": 1294,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1296,
  "text_len": 19
 },
 {
  "id": "sce012:00527",
  "jp": "ローディス「しかし、それ以上に困った事が起こった。{nl}　実はジグリムが宣戦を布告してきたんだ」",
  "off": 1319,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1321,
  "text_len": 57
 },
 {
  "id": "sce012:00566",
  "jp": "ユミール「⁉　も、もうですか？」",
  "off": 1382,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1384,
  "text_len": 19
 },
 {
  "id": "sce012:0057F",
  "jp": "ローディス「ああ。すでに麹境付近に展開しはじめている」",
  "off": 1407,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1409,
  "text_len": 34
 },
 {
  "id": "sce012:005A7",
  "jp": "セリカ「え？　議会のほうはなにをしてるの？」",
  "off": 1447,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1449,
  "text_len": 26
 },
 {
  "id": "sce012:005C7",
  "jp": "ローディス「まったく危機感がないよ。{nl}　“山猿どもがいきり立っておるわ！”と言って{nl}　とくに何かしようというつもりはないようだ。{nl}　まぁ、それは彼らの判断#66Cだからいいが、どうもこちらの{nl}　情報が漏れているようなんだ。もしかしたら評議会内に{nl}　情報を流している者がいるかもしれない。{nl}　もちろん、そこまで腐敗してはいないと信じたいがね」",
  "off": 1479,
  "len": 198,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1481,
  "text_len": 195
 },
 {
  "id": "sce012:00690",
  "jp": "ユミール「では、王都へ直接向かうのは‥‥」",
  "off": 1680,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1682,
  "text_len": 29
 },
 {
  "id": "sce012:006B3",
  "jp": "ローディス「私は構わないが、君達の行動が筒抜けになる{nl}　可能性もある。とりあえず近くに着陸して{nl}　それから調査をするほうがいいだろう」",
  "off": 1715,
  "len": 87,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1717,
  "text_len": 84
 },
 {
  "id": "sce012:0070D",
  "jp": "ユミール「わかりました。{nl}　それではそのようにします」",
  "off": 1805,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1807,
  "text_len": 28
 },
 {
  "id": "sce012:0072F",
  "jp": "ローディス「ああ。こちらもなにか情報をつかみ次第{nl}　また連絡するよ。それでは」",
  "off": 1839,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1841,
  "text_len": 46
 },
 {
  "id": "sce012:00773",
  "jp": "セリカ「兄さん‥‥危ない橋を渡らなければいいけど‥‥」",
  "off": 1907,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1909,
  "text_len": 35
 },
 {
  "id": "sce012:0079C",
  "jp": "トウヤ「心配したところでどうにもならねぇぞ。{nl}　それにお前は自分の兄を信揖できねぇのか？」",
  "off": 1948,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1950,
  "text_len": 54
 },
 {
  "id": "sce012:007D8",
  "jp": "セリカ「そんなことない！　でも‥‥」",
  "off": 2008,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2010,
  "text_len": 21
 },
 {
  "id": "sce012:007F3",
  "jp": "トウヤ「不安か？」",
  "off": 2035,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2037,
  "text_len": 12
 },
 {
  "id": "sce012:00805",
  "jp": "セリカ「‥‥うん」",
  "off": 2053,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2055,
  "text_len": 11
 },
 {
  "id": "sce012:00816",
  "jp": "トウヤ「好きなんだな」",
  "off": 2070,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2072,
  "text_len": 12
 },
 {
  "id": "sce012:00828",
  "jp": "セリカ「な、なにを急に言うのよ！　私達兄妹よ⁈{nl}　それに私にはもう‥‥」",
  "off": 2088,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2090,
  "text_len": 47
 },
 {
  "id": "sce012:0085D",
  "jp": "トウヤ「は？　そんなのあたりめぇだろ？{nl}　兄妹愛のことを言ったんだよ」",
  "off": 2141,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2143,
  "text_len": 41
 },
 {
  "id": "sce012:0088C",
  "jp": "セリカ「そ、そう‥‥そうよね」",
  "off": 2188,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2190,
  "text_len": 17
 },
 {
  "id": "sce012:008A3",
  "jp": "トウヤ「変な奴。‥‥で、いま言いかけたのはなんだ？」",
  "off": 2211,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2213,
  "text_len": 32
 },
 {
  "id": "sce012:008C9",
  "jp": "セリカ「な、なんでもない！{nl}　それじゃ私はライブレードの調整を‥‥」",
  "off": 2249,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2251,
  "text_len": 41
 },
 {
  "id": "sce012:00901",
  "jp": "トウヤ「なに慌ててんだ？」",
  "off": 2305,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2307,
  "text_len": 15
 },
 {
  "id": "sce012:00916",
  "jp": "ヤマト「ふふ～ん」",
  "off": 2326,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2328,
  "text_len": 10
 },
 {
  "id": "sce012:00926",
  "jp": "デロック「そういうことだったんだな。{nl}　これはチェックしておくんだな」",
  "off": 2342,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2344,
  "text_len": 35
 },
 {
  "id": "sce012:0094F",
  "jp": "ヤマト「‥‥あニャた、今度はニャにをメモってるの？」",
  "off": 2383,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2385,
  "text_len": 31
 },
 {
  "id": "sce012:00974",
  "jp": "デロック「“セリカ様観察日記”なんだな。{nl}　これは僕のライフワークなんだな」",
  "off": 2420,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2422,
  "text_len": 47
 },
 {
  "id": "sce012:009A9",
  "jp": "ヤマト「そ、そう‥‥がんばってね」",
  "off": 2473,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2475,
  "text_len": 19
 },
 {
  "id": "sce012:009C2",
  "jp": "デロック「‥‥君、けっこういい奴なんだな。{nl}　僕の補欠友達にしてあげてもいいんだな」",
  "off": 2498,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2500,
  "text_len": 51
 },
 {
  "id": "sce012:009FB",
  "jp": "ヤマト「‥‥遠慮しとく」",
  "off": 2555,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2557,
  "text_len": 16
 },
 {
  "id": "sce012:00A11",
  "jp": "アーサー「それでは、王都へ向かいましょうか」",
  "off": 2577,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2579,
  "text_len": 27
 },
 {
  "id": "sce012:00A32",
  "jp": "トウヤ「王都へ行くのはいいが、どこに降ろすんだ？{nl}　さっきの話じゃ、王都に入るワケにはいかねぇだろ？」",
  "off": 2610,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2612,
  "text_len": 61
 },
 {
  "id": "sce012:00A75",
  "jp": "デロック「‥‥王都の東の森の中とかいい感じなんだな。{nl}　リーボーフェンを停泊できる丁度いいスペースも{nl}　あるんだな」",
  "off": 2677,
  "len": 76,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2679,
  "text_len": 73
 },
 {
  "id": "sce012:00AC4",
  "jp": "ユミール「そうね。シスク、そこに誰か住んでいないか{nl}　調べてくれない？」",
  "off": 2756,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2758,
  "text_len": 41
 },
 {
  "id": "sce012:00AF3",
  "jp": "シスク「あ、はい。　‥‥えっと‥‥{nl}　近くに民家はないようです」",
  "off": 2803,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2805,
  "text_len": 39
 },
 {
  "id": "sce012:00B20",
  "jp": "ユミール「ありがとう。それじゃ、そこへ向かいましょう」",
  "off": 2848,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2850,
  "text_len": 29
 },
 {
