  "off": 1274,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1276,
  "text_len": 9
 },
 {
  "id": "sce089:00509",
  "jp": "トウヤ「俺達には多くの人の想いが託されているんだ。{nl}　それを無駄にしないためにも頑張ろうぜ。な？」",
  "off": 1289,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1291,
  "text_len": 60
 },
 {
  "id": "sce089:00555",
  "jp": "カスミ「‥‥そうだね。私、辛い現実から貰を背けようと{nl}　していただけなのかも‥‥逃げようとしていたのかも‥‥」",
  "off": 1365,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1367,
  "text_len": 68
 },
 {
