  "jp": "トウヤ「なに勝手なことぬかしてやがる！」",
  "off": 1328,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1330,
  "text_len": 23
 },
 {
  "id": "sce157:0054D",
