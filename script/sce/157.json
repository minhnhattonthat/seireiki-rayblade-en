  "status": "todo",
  "style": 0,
  "text_off": 921,
  "text_len": 42
 },
 {
  "id": "sce157:003C7",
  "jp": "セリカ「社交辞令は結構。{nl}　単刀直入に言うわ。ユミールを返して」",
