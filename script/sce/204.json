  "len": 93,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5436,
  "text_len": 90
 },
 {
  "id": "sce204:0159A",
  "jp": "トウヤ「あんまり無理すんなよ。{nl}　強がるのもいいけど、俺達もいるってことを{nl}　忘れないでくれよな」",
