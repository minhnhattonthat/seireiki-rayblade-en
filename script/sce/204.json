  "text_len": 17
 },
 {
  "id": "sce204:01251",
  "jp": "ガリュード「人を憎しみによって殺せば、その心は{nl}　闇へと堕ちる。これは、年長者からの忠告だ」",
  "off": 4689,
  "len": 61,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4691,
  "text_len": 58
 },
 {
  "id": "sce204:01291",
  "jp": "アイ「‥‥はい。あの、さっきはありがとうございました」",
