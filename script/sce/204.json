[
 {
  "id": "sce204:00046",
  "jp": "クロビス「なあ、アーサー。{nl}　お前、あのレンダーって奴と面識あるか？」",
  "off": 70,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 72,
  "text_len": 43
 },
 {
  "id": "sce204:0007F",
  "jp": "アーサー「いえ。ですが私もさっきの戦いでの彼の言葉が{nl}　気になっていました。{nl}　はっきり私個人も狙っていると言っていましたし」",
  "off": 127,
  "len": 79,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 129,
  "text_len": 76
 },
 {
  "id": "sce204:000D1",
  "jp": "クロビス「だが、俺達が奴と戦ったのはこの前が初めてだ。{nl}　恨みをかうようなことは‥‥」",
  "off": 209,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 211,
  "text_len": 52
 },
 {
  "id": "sce204:0010B",
  "jp": "アーサー「あと考えられるのは‥‥{nl}　あの時の演習ぐらいですが‥‥」",
  "off": 267,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 269,
  "text_len": 43
 },
 {
  "id": "sce204:0013C",
  "jp": "クロビス「演習？　もしかしてジグリムとの小競合いに{nl}　発展したアレか？」",
  "off": 316,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 318,
  "text_len": 45
 },
 {
  "id": "sce204:00177",
  "jp": "アーサー「それ以外に私達が聖霊機に乗って{nl}　フラムエルク城#946を出たことはありません。{nl}　ヨークの騎止であったはずもありませんし」",
  "off": 375,
  "len": 81,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 377,
  "text_len": 78
 },
 {
  "id": "sce204:001CB",
  "jp": "クロビス「たしかにあの時、近くの村も戦火に‥‥」",
  "off": 459,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 461,
  "text_len": 31
 },
 {
  "id": "sce204:001F0",
  "jp": "アーサー「我々はメリッサがやられたことに{nl}　気をとられていましたからね」",
  "off": 496,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 498,
  "text_len": 40
 },
 {
  "id": "sce204:0021E",
  "jp": "クロビス「それしか考えられないが‥‥{nl}　奴の恨みをはらすために犠牲になることはできないし、{nl}　そんなことを奴も望んでいないだろう」",
  "off": 542,
  "len": 77,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 544,
  "text_len": 74
 },
 {
  "id": "sce204:0026E",
  "jp": "アーサー「彼が我々を狙っている限り{nl}　また嫌でも再会することになるでしょうしね。{nl}　恨まれるのはあまりいい気分ではありませんが」",
  "off": 622,
  "len": 79,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 624,
  "text_len": 76
 },
 {
  "id": "sce204:002C0",
  "jp": "クロビス「そうだな、戦いの代償とはいえ{nl}　いい気はしないぜ」",
  "off": 704,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 706,
  "text_len": 34
 },
 {
  "id": "sce204:002E8",
  "jp": "アーサー「やめましょう。{nl}　戦いが全て終わるまでは兵止に徹するべきです」",
  "off": 744,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 746,
  "text_len": 44
 },
 {
  "id": "sce204:0031A",
  "jp": "クロビス「ああ、わかっている。{nl}　戦場での気の迷いは命取り‥‥だな」",
  "off": 794,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 796,
  "text_len": 42
 },
 {
  "id": "sce204:0034A",
  "jp": "アーサー「ええ、さあ、ブリッジへ行きましょう」",
  "off": 842,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 844,
  "text_len": 26
 },
 {
  "id": "sce204:00390",
  "jp": "ユミール「結局、審相は謎‥‥ね‥‥」",
  "off": 912,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 914,
  "text_len": 28
 },
 {
  "id": "sce204:003B2",
  "jp": "セリカ「でも妙なことをロ#492走っていたわね。{nl}　呪われた“魔眼”の子供とか‥‥」",
  "off": 946,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 948,
  "text_len": 50
 },
 {
  "id": "sce204:003EA",
  "jp": "ユミール「“魔眼”というのはごくまれに先天的に持ち{nl}　生まれる能力のひとつで、相手の貰をみつめるだけで{nl}　深層心理／抑庄心理の解放をすることができる{nl}　能力捕持者のことよ。数万人に一人という割合で{nl}　生まれるとされているけど‥‥{nl}　もしカイン王子がそうで、あの人に影響を与えたのなら{nl}　相当強い能力をもっていることになるわね」",
  "off": 1002,
  "len": 218,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1004,
  "text_len": 215
 },
 {
  "id": "sce204:004C7",
  "jp": "セリカ「でも5年前に会った時はそんな力は無かった{nl}　みたいだけど‥‥」",
  "off": 1223,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1225,
  "text_len": 43
 },
 {
  "id": "sce204:004F8",
  "jp": "ユミール「なんらかの原姻で“魔眼”が発現することは{nl}　考えられないわ。と、なると元々あったものが強くなった{nl}　という線が考えられるわね。{nl}　私達の前から姿を梢した3年前から{nl}　今に至るまでの間に」",
  "off": 1272,
  "len": 125,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1274,
  "text_len": 122
 },
 {
  "id": "sce204:00578",
  "jp": "トウヤ「で、具体的にはその“魔眼”って{nl}　どういう力があるんだ？{nl}　催眠術みたいに人を操れるのか？」",
  "off": 1400,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1402,
  "text_len": 65
 },
 {
  "id": "sce204:005BF",
  "jp": "ユミール「いいえ。“魔眼”は相手の心の底に{nl}　眠っている感情を呼び覚ますだけ。{nl}　なにかを強制することはできないわ」",
  "off": 1471,
  "len": 77,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1473,
  "text_len": 74
 },
 {
  "id": "sce204:0060F",
  "jp": "クロビス「‥‥それって、あのオズ<E1>ァルドが心の底で{nl}　あの女王様を殺したいって思ってたってことか？」",
  "off": 1551,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1553,
  "text_len": 60
 },
 {
  "id": "sce204:00651",
  "jp": "ユミール「もしくは極度の独占欲の裏返しか‥‥」",
  "off": 1617,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1619,
  "text_len": 33
 },
 {
  "id": "sce204:00689",
  "jp": "レデュース「たしかに奴の陛下をみる貰は異常なほどの{nl}　熱をもっていたが‥‥まさかここまでだったとは‥‥」",
  "off": 1673,
  "len": 67,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1675,
  "text_len": 64
 },
 {
  "id": "sce204:006CF",
  "jp": "クロビス「だったら諸悪の根源はあのカインってことか⁉」",
  "off": 1743,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1745,
  "text_len": 32
 },
 {
  "id": "sce204:006F5",
  "jp": "アーサー「我々の推測が星#5D6しければ、そうなりますね。{nl}　彼が我々の前から去ったことのつじつまも{nl}　合いますし‥‥」",
  "off": 1781,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1783,
  "text_len": 69
 },
 {
  "id": "sce204:00740",
  "jp": "セリカ「でも‥‥あの優しかったカインが‥‥」",
  "off": 1856,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1858,
  "text_len": 27
 },
 {
  "id": "sce204:00761",
  "jp": "シエル「レデュース、あなたリンバーグでカイン王子に{nl}　会ってたのでしょ？」",
  "off": 1889,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1891,
  "text_len": 43
 },
 {
  "id": "sce204:00792",
  "jp": "レデュース「ああ。私の知っているカイン王子は{nl}　すでに今のような自信にあふれる若者で、{nl}　どこか危うい雰囲気を漂わせていた」",
  "off": 1938,
  "len": 80,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1940,
  "text_len": 77
 },
 {
  "id": "sce204:007E5",
  "jp": "シエル「こんな近くにいながら気づかなかったなんて‥‥」",
  "off": 2021,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2023,
  "text_len": 31
 },
 {
  "id": "sce204:0080A",
  "jp": "レデュース「シエル‥‥すまん」",
  "off": 2058,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2060,
  "text_len": 18
 },
 {
  "id": "sce204:00822",
  "jp": "シエル「あなたが謝ることはないわ。{nl}　悲しんでいても始まらない。{nl}　陛下の敵は‥‥」",
  "off": 2082,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2084,
  "text_len": 50
 },
 {
  "id": "sce204:0085A",
  "jp": "レデュース「シエル。努りに身を任せてはいかん。{nl}　ガリュード様の教えを忘れたか？」",
  "off": 2138,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2140,
  "text_len": 50
 },
 {
  "id": "sce204:00892",
  "jp": "シエル「‥‥」",
  "off": 2194,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2196,
  "text_len": 9
 },
 {
  "id": "sce204:008B0",
  "jp": "ガリュード「うむ、たしかに奴の陛下をみる貰は{nl}　異常なほどの熱をもっていたが‥‥{nl}　まさかここまでだったとは‥‥」",
  "off": 2224,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2226,
  "text_len": 69
 },
 {
  "id": "sce204:008FB",
  "jp": "クロビス「だったら諸悪の根源はあのカインってことか⁉」",
  "off": 2299,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2301,
  "text_len": 32
 },
 {
  "id": "sce204:00921",
  "jp": "アーサー「我々の推測が星#5D6しければ、そうなりますね。{nl}　彼が我々の前から去ったことのつじつまも{nl}　合いますし‥‥」",
  "off": 2337,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2339,
  "text_len": 69
 },
 {
  "id": "sce204:0096C",
  "jp": "セリカ「でも‥‥あの優しかったカインが‥‥」",
  "off": 2412,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2414,
  "text_len": 27
 },
 {
  "id": "sce204:0098D",
  "jp": "シエル「レデュース、あなたリンバーグでカイン王子に{nl}　会ってたのでしょ？」",
  "off": 2445,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2447,
  "text_len": 43
 },
 {
  "id": "sce204:009BE",
  "jp": "レデュース「ああ。私の知っているカイン王子はすでに{nl}　今のような自信にあふれる若者で、どこか{nl}　危うい雰囲気を漂わせていた」",
  "off": 2494,
  "len": 80,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2496,
  "text_len": 77
 },
 {
  "id": "sce204:00A11",
  "jp": "ガリュード「‥‥くっ、このような近くにいながら{nl}　それを見抜けぬとは‥‥不甲斐ない‥‥{nl}　なにが“剣縄#A0B（けんこう）”か‥‥」",
  "off": 2577,
  "len": 84,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2579,
  "text_len": 81
 },
 {
  "id": "sce204:00A68",
  "jp": "シエル「お父さま、あまりご自分を責めるのは‥‥」",
  "off": 2664,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2666,
  "text_len": 30
 },
 {
  "id": "sce204:00A8C",
  "jp": "ガリュード「‥‥わかっている。わかってはいるが‥‥」",
  "off": 2700,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2702,
  "text_len": 31
 },
 {
  "id": "sce204:00AB1",
  "jp": "シエル「お父さま‥‥」",
  "off": 2737,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2739,
  "text_len": 14
 },
 {
  "id": "sce204:00AD1",
  "jp": "デロック「‥‥そ、そういえばアイちゃんはどうしたんだな？」",
  "off": 2769,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2771,
  "text_len": 32
 },
 {
  "id": "sce204:00AF7",
  "jp": "ユミール「え？　あ、ああ。アイなら、自分の部屋に{nl}　いるはずよ」",
  "off": 2807,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2809,
  "text_len": 38
 },
 {
  "id": "sce204:00B23",
  "jp": "ミヤスコ「彼女、大丈夫でしょうか？{nl}　精神的な部分だけに心配です」",
  "off": 2851,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2853,
  "text_len": 46
 },
 {
  "id": "sce204:00B57",
  "jp": "クロビス「辛いのはアイだけじゃない。{nl}　ここにいるみんなも伺じだ。{nl}　‥‥だが、一番堪えているのはあいつかもしれんな」",
  "off": 2903,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2905,
  "text_len": 66
 },
 {
  "id": "sce204:00B9F",
  "jp": "アーサー「トウヤ、少し、様子を見て来てくれませんか？」",
  "off": 2975,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2977,
  "text_len": 35
 },
 {
  "id": "sce204:00BC8",
  "jp": "トウヤ「え？　まぁ、いいけど‥‥」",
  "off": 3016,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3018,
  "text_len": 20
 },
 {
  "id": "sce204:00BE2",
  "jp": "アーサー「それじゃ、お願いしますね」",
  "off": 3042,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3044,
  "text_len": 21
 },
 {
  "id": "sce204:00C11",
  "jp": "ヤマト「ヤケにすニャおじゃニャい。{nl}　いったいどうしたの？」",
  "off": 3089,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3091,
  "text_len": 31
 },
 {
  "id": "sce204:00C36",
  "jp": "トウヤ「あいつ、あの子が生きているってわかったとき{nl}　本当に喜んでいた。心底うれしそうだった。{nl}　あいつの悲しみは俺達が考えている以上だろう」",
  "off": 3126,
  "len": 87,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3128,
  "text_len": 84
 },
 {
  "id": "sce204:00C90",
  "jp": "ヤマト「‥‥そうね」",
  "off": 3216,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3218,
  "text_len": 12
 },
 {
  "id": "sce204:00CA2",
  "jp": "トウヤ「大切な人を失う気持ちってわかるから‥‥{nl}　俺にも励ますぐらいはできるって思ってな」",
  "off": 3234,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3236,
  "text_len": 56
 },
 {
  "id": "sce204:00CE0",
  "jp": "ヤマト「トウヤ‥‥」",
  "off": 3296,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3298,
  "text_len": 12
 },
