  "status": "translated",
  "style": 0,
  "text_off": 778,
  "text_len": 9
 },
 {
  "id": "sce076:00323",
  "jp": "シスク「‥‥まぁ、とにかく、みんな無事でよかったね。{nl}　トウヤも無事に合流できたし」",
