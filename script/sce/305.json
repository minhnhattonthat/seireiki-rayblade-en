  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4791,
  "text_len": 19
 },
 {
  "id": "sce305:012D4",
  "jp": "トウヤ「またタイミングよく故障が直ったみたいだな？」",
  "off": 4820,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4822,
  "text_len": 30
 },
 {
  "id": "sce305:012F8",
  "jp": "デロック「ぼ、僕は急いでいるんだな。{nl}　お前達が降りれば大丈夫なんだな。{nl}　さっさと替わるんだな」",
  "off": 4856,
  "len": 61,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4858,
  "text_len": 58
 },
 {
  "id": "sce305:01338",
  "jp": "ヤマト「ニャによそれ⁈」",
  "off": 4920,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4922,
  "text_len": 13
 },
 {
  "id": "sce305:0134B",
  "jp": "　いいぜ{nl}　いやだね",
  "off": 4939,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 128,
  "text_off": 4941,
  "text_len": 10
 },
 {
  "id": "sce305:01383",
  "jp": "デロック「キミ、いい奴なんだな」",
