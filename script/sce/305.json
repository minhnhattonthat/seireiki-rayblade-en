  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4997,
  "text_len": 17
 },
 {
  "id": "sce305:0139A",
  "jp": "トウヤ「でも俺らが降りたって一緒だと思うけどな‥‥」",
