  "status": "todo",
  "style": 128,
  "text_off": 2137,
  "text_len": 23
 },
 {
  "id": "sce305:00880",
  "jp": "フェイン「だろ？　特に最後のとこなんか言ってる俺が{nl}　しびれるぐらいだからな」",
