  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5020,
  "text_len": 33
 },
 {
  "id": "sce305:013C1",
  "jp": "デロック「そ、そんなことないんだな。{nl}　絶対大丈夫なんだな」",
  "off": 5057,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5059,
  "text_len": 35
 },
 {
  "id": "sce305:013EA",
  "jp": "ヤマト「はい、どうぞ」",
  "off": 5098,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5100,
  "text_len": 11
 },
 {
  "id": "sce305:01400",
  "jp": "デロック「‥‥」",
  "off": 5120,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5122,
  "text_len": 10
 },
 {
  "id": "sce305:01410",
  "jp": "トウヤ「お？　大丈夫みたいだな」",
  "off": 5136,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5138,
  "text_len": 20
 },
 {
  "id": "sce305:0142A",
  "jp": "デロック「当然なんだな。先に行かせてもらうんだな」",
  "off": 5162,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5164,
  "text_len": 29
 },
 {
  "id": "sce305:0144D",
  "jp": "ヤマト「あっ‥‥」",
  "off": 5197,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5199,
  "text_len": 11
 },
 {
  "id": "sce305:0146C",
  "jp": "デロック「だ、誰か助けてくれなんだな！{nl}　エレベーターが途中で止まったんだな！{nl}　電気も消えてなにも見えないんだな。{nl}　助けてぇーなんだな！」",
  "off": 5228,
  "len": 90,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5230,
  "text_len": 87
 },
 {
  "id": "sce305:014C9",
  "jp": "トウヤ「やっぱ、ダメだったか‥‥」",
  "off": 5321,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5323,
  "text_len": 19
 },
 {
  "id": "sce305:014EA",
  "jp": "デロック「う‥‥動き出したんだな。{nl}　た、助かったんだな‥‥」",
  "off": 5354,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5356,
  "text_len": 38
 },
 {
  "id": "sce305:01516",
  "jp": "ヤマト「ギリギリセーフみたいね‥‥」",
  "off": 5398,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5400,
  "text_len": 21
 },
 {
  "id": "sce305:0153F",
  "jp": "トウヤ「いやだね。俺達も急いでるんで{nl}　先に行かせてもらう」",
  "off": 5439,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5441,
  "text_len": 35
 },
 {
  "id": "sce305:01568",
  "jp": "デロック「な、なんて嫌なヤツなんだな。{nl}　僕が急いでいるのを知ってて邪魔するなんて{nl}　最低な人間なんだな」",
  "off": 5480,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5482,
  "text_len": 63
 },
 {
  "id": "sce305:015AD",
  "jp": "ヤマト「ごめんニャさいね」",
  "off": 5549,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5551,
  "text_len": 13
 },
 {
  "id": "sce305:015C0",
  "jp": "デロック「さっさと行くんだな！」",
  "off": 5568,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5570,
  "text_len": 18
 },
 {
  "id": "sce305:01699",
  "jp": "クロビス「だから、部屋まで運んでやるって‥‥」",
  "off": 5785,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5787,
  "text_len": 28
 },
 {
  "id": "sce305:016BB",
  "jp": "アイ「いいって言ってるでしょ⁈」",
  "off": 5819,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5821,
  "text_len": 18
 },
 {
  "id": "sce305:016D3",
  "jp": "ヤマト「あれは‥‥アイとクロビスみたいね‥‥」",
  "off": 5843,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5845,
  "text_len": 27
 },
 {
  "id": "sce305:016F4",
  "jp": "トウヤ「なにもめてんだ？」",
  "off": 5876,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5878,
  "text_len": 14
 },
 {
  "id": "sce305:01722",
  "jp": "トウヤ「よう。いったいどうした？」",
  "off": 5922,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5924,
  "text_len": 18
 },
 {
  "id": "sce305:01742",
  "jp": "クロビス「おお、トウヤ‥‥‼　ヤ、ヤマト！」",
  "off": 5954,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5956,
  "text_len": 26
 },
 {
  "id": "sce305:01762",
  "jp": "ヤマト「あっ、見つかっちゃった」",
  "off": 5986,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5988,
  "text_len": 17
 },
 {
  "id": "sce305:01779",
  "jp": "クロビス「よ、よし、ではここまでということで。{nl}　それじゃあな！」",
  "off": 6009,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6011,
  "text_len": 34
 },
 {
  "id": "sce305:017AC",
  "jp": "ヤマト「う～んここまでとは‥‥{nl}　そうとう酷い目にあったのねぇ～」",
  "off": 6060,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6062,
  "text_len": 39
 },
 {
  "id": "sce305:017E1",
  "jp": "トウヤ「どうしたんだ？」",
  "off": 6113,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6115,
  "text_len": 13
 },
 {
  "id": "sce305:017F4",
  "jp": "アイ「別になんでもない」",
  "off": 6132,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6134,
  "text_len": 13
 },
 {
  "id": "sce305:01807",
  "jp": "トウヤ「そうか？　言い争ってたみたいだが‥‥」",
  "off": 6151,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6153,
  "text_len": 28
 },
 {
  "id": "sce305:0183B",
  "jp": "アイ「だからなんでもないって」",
  "off": 6203,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6205,
  "text_len": 15
 },
 {
  "id": "sce305:01850",
  "jp": "トウヤ「ならいいけど‥‥ん？{nl}　その荷物はなんだ？」",
  "off": 6224,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6226,
  "text_len": 32
 },
 {
  "id": "sce305:01881",
  "jp": "アイ「ちょっとね。本とかいろいろ。一人じゃ{nl}　運べなかったからクロビスに手伝ってもらってたんだ」",
  "off": 6273,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6275,
  "text_len": 54
 },
 {
  "id": "sce305:018BD",
  "jp": "トウヤ「ふぅ～ん、それじゃ、部屋の中まで運んでやるよ」",
  "off": 6333,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6335,
  "text_len": 32
 },
 {
  "id": "sce305:018EE",
  "jp": "アイ「い、いいよ。あとは一人でできるし」",
  "off": 6382,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6384,
  "text_len": 22
 },
 {
  "id": "sce305:0190A",
  "jp": "トウヤ「遠慮するなって」",
  "off": 6410,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6412,
  "text_len": 14
 },
 {
  "id": "sce305:01930",
  "jp": "アイ「いいって言ってるでしょ！」",
  "off": 6448,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6450,
  "text_len": 18
 },
 {
  "id": "sce305:01953",
  "jp": "トウヤ「ア、アイ‥‥？」",
  "off": 6483,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6485,
  "text_len": 15
 },
 {
  "id": "sce305:0197A",
  "jp": "アイ「‥‥ご、ごめん。{nl}{ctl:3C3E}{face:041710}{ctl:013E}{face:041611}{ctl:023E}{face:041615}　でも本当にいいの。ありがとう」",
  "off": 6522,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6524,
  "text_len": 56
 },
 {
  "id": "sce305:019B8",
  "jp": "トウヤ「‥‥」",
  "off": 6584,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6586,
  "text_len": 9
 },
 {
  "id": "sce305:019C7",
  "jp": "ヤマト「アイ、もしかして部屋に入られたくニャいの？」",
  "off": 6599,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6601,
  "text_len": 30
 },
 {
  "id": "sce305:019EB",
  "jp": "アイ「‥‥う、うん」",
  "off": 6635,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6637,
  "text_len": 12
 },
 {
  "id": "sce305:019FD",
  "jp": "トウヤ「なんだ、信用ねぇんだな」",
  "off": 6653,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6655,
  "text_len": 18
 },
 {
  "id": "sce305:01A27",
  "jp": "アイ「違う！　違うよ。{nl}　別に‥‥信用してないワケじゃないわ‥‥」",
  "off": 6695,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6697,
  "text_len": 43
 },
 {
  "id": "sce305:01A58",
  "jp": "トウヤ「え？　どういうことだ？」",
  "off": 6744,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6746,
  "text_len": 18
 },
 {
  "id": "sce305:01A7B",
  "jp": "アイ「‥‥笑わない？」",
  "off": 6779,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6781,
  "text_len": 15
 },
 {
  "id": "sce305:01A90",
  "jp": "トウヤ「だからどういうことなんだ？{nl}　笑わねぇから言ってみろよ」",
  "off": 6800,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6802,
  "text_len": 35
 },
 {
  "id": "sce305:01ACB",
  "jp": "アイ「あたし‥‥自分の部屋に男の人とか{nl}　入れたことないんだ‥‥っていうより、入れなかったの」",
  "off": 6859,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6861,
  "text_len": 59
 },
 {
  "id": "sce305:01B0C",
  "jp": "ヤマト「ああ‥‥だから、クロビスと‥‥」",
  "off": 6924,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6926,
  "text_len": 24
 },
 {
  "id": "sce305:01B3C",
  "jp": "アイ「うん。親切で言ってくれてるのはわかってるんだけど、{nl}{ctl:3C3E}{face:041610}{ctl:013E}{face:041611}{ctl:013E}{face:041610}　でもダメなんだ。どうしても‥‥」",
  "off": 6972,
  "len": 78,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6974,
  "text_len": 75
 },
 {
  "id": "sce305:01B8D",
  "jp": "ヤマト「気持ち悪いとかの嫌悪感？」",
  "off": 7053,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7055,
  "text_len": 24
 },
 {
  "id": "sce305:01BBD",
  "jp": "アイ「ううん。そうじゃない‥‥」",
  "off": 7101,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7103,
  "text_len": 18
 },
 {
  "id": "sce305:01BD5",
  "jp": "ヤマト「じゃあ‥‥{nl}　好きニャ人しか入れたくニャいってこと？」",
  "off": 7125,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7127,
  "text_len": 37
 },
 {
  "id": "sce305:01C08",
  "jp": "アイ「‥‥うん。でもそれだけじゃなくて、{nl}{ctl:3C3E}{face:84FF10}{ctl:013E}{face:84FF11}　やっぱりお互いに気持ちの通じ合えてる人、かな」",
  "off": 7176,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7178,
  "text_len": 69
 },
 {
  "id": "sce305:01C53",
  "jp": "ヤマト「ニャるほどねぇ‥‥意外と古風ニャとこあるのね」",
  "off": 7251,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7253,
  "text_len": 33
 },
 {
  "id": "sce305:01C7A",
  "jp": "トウヤ「‥‥まぁ、そういうことだったら仕方ねぇな」",
  "off": 7290,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7292,
  "text_len": 29
 },
 {
  "id": "sce305:01C9D",
  "jp": "ヤマト「え？　どこ行くの？」",
  "off": 7325,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7327,
  "text_len": 17
 },
 {
  "id": "sce305:01CB4",
  "jp": "トウヤ「無理に入ることはできねぇだろ？」",
  "off": 7348,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7350,
  "text_len": 24
 },
 {
  "id": "sce305:01CD2",
  "jp": "ヤマト「ま、まぁ、そうだけど‥‥」",
  "off": 7378,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7380,
  "text_len": 19
 },
 {
  "id": "sce305:01CEB",
  "jp": "アイ「‥‥」",
  "off": 7403,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7405,
  "text_len": 8
 },
 {
  "id": "sce305:01CF9",
  "jp": "ヤマト「これはニャがい道のりにニャりそうね」",
  "off": 7417,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7419,
  "text_len": 23
 },
 {
  "id": "sce305:01D21",
  "jp": "アイ「‥‥かもね」",
  "off": 7457,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7459,
  "text_len": 11
 },
 {
  "id": "sce305:01D32",
  "jp": "トウヤ「おい、ヤマト、行くぞ」",
  "off": 7474,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7476,
  "text_len": 16
 },
 {
  "id": "sce305:01D48",
  "jp": "ヤマト「はぁ～い」",
