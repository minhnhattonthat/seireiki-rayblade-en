  "style": 0,
  "text_off": 4117,
  "text_len": 54
 },
 {
  "id": "sce274:0104F",
  "jp": "　ああ、わかった。それじゃ、行くか{nl}　もう一度説明してくれねぇか？",
  "off": 4175,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 128,
  "text_off": 4177,
  "text_len": 39
 },
 {
  "id": "sce274:01082",
  "jp": "ヤマト「そう？　じゃ、これからどうするの？」",
  "off": 4226,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4228,
  "text_len": 24
 },
 {
