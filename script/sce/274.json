  "en": "",
  "status": "todo",
  "style": 128,
  "text_off": 1776,
  "text_len": 17
 },
 {
  "id": "sce274:0070B",
  "jp": "ヤマト「‥‥おっほん！　えっと、まず大切ニャのは誰かに{nl}　会うこと。そうじゃニャいとニャにもはじまらニャいわよ」",
  "off": 1803,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1805,
  "text_len": 63
 },
 {
  "id": "sce274:00750",
  "jp": "トウヤ「は？　んなこと当たり前だろ？」",
  "off": 1872,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1874,
  "text_len": 23
 },
 {
  "id": "sce274:0076D",
  "jp": "ヤマト「それじゃ、どうやって会うかわかる？{nl}　誰がどこにいるかニャんてわかるの？」",
