  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4991,
  "text_len": 35
 },
 {
  "id": "sce274:013E3",
  "jp": "アーサー「はい」",
  "off": 5091,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5093,
  "text_len": 10
 },
 {
  "id": "sce274:013F3",
  "jp": "トウヤ「トウヤだけど‥‥」",
  "off": 5107,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5109,
  "text_len": 15
 },
 {
  "id": "sce274:0140E",
  "jp": "アーサー「ああ、どうぞお入りください」",
  "off": 5134,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5136,
  "text_len": 22
 },
 {
  "id": "sce274:01459",
  "jp": "ヤマト「へぇ‥‥」",
  "off": 5209,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5211,
  "text_len": 11
 },
 {
  "id": "sce274:0146A",
  "jp": "アーサー「どうかしましたか？」",
  "off": 5226,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5228,
  "text_len": 18
 },
 {
  "id": "sce274:01482",
  "jp": "トウヤ「いや、色んな部屋があるんだなって思って‥‥」",
  "off": 5250,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5252,
  "text_len": 32
 },
 {
  "id": "sce274:014A8",
  "jp": "アーサー「そうですか？　でも、みんな同じでしょう」",
  "off": 5288,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5290,
  "text_len": 29
 },
 {
  "id": "sce274:014CB",
  "jp": "ヤマト「部屋の大きさはおニャじだけど‥‥ニャかみが‥‥」",
  "off": 5323,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5325,
  "text_len": 35
 },
 {
  "id": "sce274:014F4",
  "jp": "トウヤ「すごく個性的だよな‥‥」",
  "off": 5364,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5366,
  "text_len": 21
 },
 {
  "id": "sce274:0150F",
  "jp": "アーサー「そうですか、それは素直に喜んで{nl}　よろしいのでしょうか？」",
  "off": 5391,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5393,
  "text_len": 40
 },
 {
  "id": "sce274:0153D",
  "jp": "トウヤ「ああ、レイアウトがアーサーらしくて{nl}　いい感じだと思う」",
  "off": 5437,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5439,
  "text_len": 36
 },
 {
  "id": "sce274:01567",
  "jp": "ヤマト「そこはかとニャく呪術のニオイがするけど‥‥」",
  "off": 5479,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5481,
  "text_len": 30
 },
 {
  "id": "sce274:0158B",
  "jp": "アーサー「そ、そうですか‥‥？」",
  "off": 5515,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5517,
  "text_len": 21
 },
 {
  "id": "sce274:015A6",
  "jp": "ヤマト「わぁ～　これニャにかしら？{nl}　みたこともニャい物がたくさんあるわ～」",
  "off": 5542,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5544,
  "text_len": 42
 },
 {
  "id": "sce274:015D6",
  "jp": "トウヤ「おい、勝手に触るんじゃねぇぞ」",
  "off": 5590,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5592,
  "text_len": 22
 },
 {
  "id": "sce274:015F2",
  "jp": "ヤマト「わかってるわよ」",
  "off": 5618,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5620,
  "text_len": 12
 },
 {
  "id": "sce274:0160E",
  "jp": "アーサー「ふふふ‥‥あなたにはこれからも期待してますよ」",
  "off": 5646,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5648,
  "text_len": 34
 },
 {
  "id": "sce274:01636",
  "jp": "トウヤ「期待って言われてもなぁ」",
  "off": 5686,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5688,
  "text_len": 19
 },
 {
  "id": "sce274:0164F",
  "jp": "アーサー「なにを言っているのですか。{nl}　こんなに早く聖霊機を操り、実戦で成果を上げた{nl}　操者はあなたがはじめてです。{nl}　私達でもそれなりの訓練をしてここまできたのですから{nl}　自信を持ってください」",
  "off": 5711,
  "len": 123,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5713,
  "text_len": 120
 },
 {
  "id": "sce274:016CD",
  "jp": "トウヤ「自信か‥‥」",
  "off": 5837,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5839,
  "text_len": 14
 },
 {
  "id": "sce274:016E1",
  "jp": "アーサー「とにかく、いつ敵が動きだすかはわかりません。{nl}　今すぐにも襲ってくるかもしれませんし、{nl}　これからも私達と共に戦っていきましょう」",
  "off": 5857,
  "len": 83,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5859,
  "text_len": 80
 },
 {
  "id": "sce274:01737",
  "jp": "トウヤ「すまねえが、まだちゃんとした返事はできねえよ。{nl}　俺の心の中で何か引っかかるものがあるからな‥‥」",
  "off": 5943,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5945,
  "text_len": 62
 },
 {
  "id": "sce274:0177B",
  "jp": "アーサー「そうですか‥‥」",
  "off": 6011,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6013,
  "text_len": 17
 },
 {
  "id": "sce274:01792",
  "jp": "ヤマト「トウヤ、トウヤ！{nl}　これみてよ、こんニャの見たことニャいわ」",
  "off": 6034,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6036,
  "text_len": 36
 },
 {
  "id": "sce274:017BC",
  "jp": "トウヤ「あーっ！　だから勝手に‥‥」",
  "off": 6076,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6078,
  "text_len": 24
 },
 {
  "id": "sce274:017DA",
  "jp": "アーサー「ははは、別に構いませんよ。{nl}　それから、なにか悩み事があったらいつでも{nl}　相談してください。{nl}　我々は数少ない“同郷の者”なのですからね」",
  "off": 6106,
  "len": 93,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6108,
  "text_len": 90
 },
 {
  "id": "sce274:0183A",
  "jp": "トウヤ「ああ。こんなことでもなければ出会わなかった{nl}　だろうしな。すまねぇ、邪魔したな」",
  "off": 6202,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6204,
  "text_len": 48
 },
 {
  "id": "sce274:01870",
  "jp": "アーサー「え？　私に揖事があったのでは？」",
  "off": 6256,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6258,
  "text_len": 28
 },
 {
  "id": "sce274:01892",
  "jp": "トウヤ「もう済んだ。とりあえず挨拶だけだがな」",
  "off": 6290,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6292,
  "text_len": 26
 },
 {
  "id": "sce274:018B2",
  "jp": "アーサー「なるほど。それはいいことですね。{nl}　それでは、頑張ってください」",
  "off": 6322,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6324,
  "text_len": 41
 },
 {
  "id": "sce274:018E1",
  "jp": "トウヤ「ああ。ホラ行くぞ、ヤマト」",
  "off": 6369,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6371,
  "text_len": 18
 },
 {
  "id": "sce274:018F9",
  "jp": "ヤマト「え？　あーっ、待って～」",
  "off": 6393,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6395,
  "text_len": 20
 },
 {
  "id": "sce274:01944",
  "jp": "ヤマト「世界にはあたし達の知らニャいものが{nl}　山ほどあるのね、ビックリしちゃった」",
  "off": 6468,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6470,
  "text_len": 46
 },
 {
  "id": "sce274:01978",
  "jp": "トウヤ「当たり前だろ、俺達の住む日本でも、{nl}　まだ知らねえものは沢山あるよ。{nl}　目の前にあるものがすべてじゃねえってことだ」",
  "off": 6520,
  "len": 77,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6522,
  "text_len": 74
 },
 {
  "id": "sce274:019C8",
  "jp": "ヤマト「それもそうね」",
  "off": 6600,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6602,
  "text_len": 11
 },
 {
  "id": "sce274:01A26",
  "jp": "アイ「♪♪♪」",
  "off": 6694,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6696,
  "text_len": 10
 },
 {
