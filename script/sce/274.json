  "status": "todo",
  "style": 0,
  "text_off": 1659,
  "text_len": 34
 },
 {
  "id": "sce274:006BB",
  "jp": "ヤマト「また？　別にいいよ。{nl}　理解できるまでニャんどでも説明してあげるわよ」",
  "off": 1723,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1725,
  "text_len": 45
 },
 {
  "id": "sce274:006EE",
  "jp": "　ちゃんと聞く{nl}　やっぱりいいや",
  "off": 1774,
