  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4778,
  "text_len": 11
 },
 {
  "id": "sce274:012B9",
  "jp": "トウヤ『いいって、別にたいした揖事があるワケでもねぇし』",
