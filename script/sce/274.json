  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4795,
  "text_len": 31
 },
 {
  "id": "sce274:012DE",
  "jp": "ヤマト『そう？』",
  "off": 4830,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4832,
  "text_len": 9
 },
 {
  "id": "sce274:012ED",
  "jp": "トウヤ「クロビス！　俺達揖事を思い出したから、{nl}　行くよ」",
  "off": 4845,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4847,
  "text_len": 37
 },
 {
  "id": "sce274:01318",
  "jp": "クロビス「ほんと、すまん！　また来てくれよ‥‥{nl}　あ、相棒がいないときにな」",
  "off": 4888,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4890,
  "text_len": 44
 },
 {
  "id": "sce274:0134A",
  "jp": "トウヤ「ああ、またな」",
  "off": 4938,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4940,
  "text_len": 11
 },
 {
  "id": "sce274:0135B",
  "jp": "ヤマト「ニャんであんニャに猫が嫌いニャんだろね？」",
  "off": 4955,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4957,
  "text_len": 28
 },
 {
  "id": "sce274:0137D",
  "jp": "トウヤ「さぁな、いつか話したい時に本人が{nl}　教えてくれるさ」",
  "off": 4989,
