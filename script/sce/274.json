  "status": "todo",
  "style": 0,
  "text_off": 6727,
  "text_len": 9
 },
 {
  "id": "sce274:01A5C",
  "jp": "アイ「ん？　あっ、トウヤ」",
  "off": 6748,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6750,
  "text_len": 14
 },
 {
  "id": "sce274:01A70",
  "jp": "トウヤ「お前‥‥なにしてんだ？」",
  "off": 6768,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6770,
  "text_len": 20
 },
 {
  "id": "sce274:01A8E",
  "jp": "アイ「なにって‥‥見てのとおりクッキー焼いてるんだけど」",
  "off": 6798,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6800,
  "text_len": 33
 },
 {
  "id": "sce274:01AB5",
  "jp": "トウヤ「クッキー‥‥？」",
  "off": 6837,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6839,
  "text_len": 16
 },
 {
  "id": "sce274:01AE1",
  "jp": "アイ「だって‥‥約束したんだもん‥‥{nl}　今度一緒にクッキー作ろうって‥‥{nl}　あの子‥‥14才の、普通の女の子だったんだよ‥‥」",
  "off": 6881,
  "len": 90,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6883,
  "text_len": 87
 },
 {
  "id": "sce274:01B5C",
  "jp": "アイ「ん？　どうしたの？」",
  "off": 7004,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7006,
  "text_len": 15
 },
 {
  "id": "sce274:01B71",
  "jp": "トウヤ「‥‥い、いや‥‥それより‥‥{nl}　クッキー焼くだけでどーやったら{nl}　ここまで破壊できるんだ？」",
  "off": 7025,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7027,
  "text_len": 62
 },
 {
  "id": "sce274:01BC7",
