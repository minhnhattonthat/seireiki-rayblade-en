  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 10289,
  "text_len": 16
 },
 {
  "id": "sce356:02842",
  "jp": "カスミ「‥‥ライブレード自体を使うの？」",
  "off": 10306,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 10311,
  "text_len": 27
 },
 {
  "id": "sce356:02863",
  "jp": "トウヤ「おっ、さすがにわかってるじゃねぇか」",
  "off": 10339,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 10343,
  "text_len": 22
 },
 {
  "id": "sce356:0287E",
  "jp": "カスミ「トウヤちゃん、思い詰めた顔してたもの。{nl}　でも‥‥ライブレードが壊れちゃうね」",
  "off": 10366,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 10371,
  "text_len": 50
 },
 {
  "id": "sce356:028B6",
  "jp": "トウヤ「失敗するとは思わねぇのか？」",
  "off": 10422,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 10426,
  "text_len": 22
 },
 {
  "id": "sce356:028D6",
  "jp": "カスミ「もし、失敗してもトウヤちゃんと一緒なら{nl}　悔いはないわ‥‥」",
  "off": 10454,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 10459,
  "text_len": 41
 },
 {
  "id": "sce356:02905",
  "jp": "トウヤ「‥‥カスミ‥‥」",
  "off": 10501,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 10505,
  "text_len": 16
 },
 {
  "id": "sce356:0291A",
  "jp": "カスミ「な、なに？」",
  "off": 10522,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 10527,
  "text_len": 11
 },
 {
  "id": "sce356:0292B",
  "jp": "トウヤ「こっちこないか？」",
  "off": 10539,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 10543,
  "text_len": 14
 },
 {
  "id": "sce356:0293E",
  "jp": "カスミ「え？　でも操縦は‥‥」",
  "off": 10558,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 10563,
  "text_len": 20
 },
 {
  "id": "sce356:02958",
  "jp": "トウヤ「戦うワケじゃねぇし、あとはこっちだけでも{nl}　操縦はできる‥‥嫌か？」",
  "off": 10584,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 10588,
  "text_len": 45
 },
 {
  "id": "sce356:0298A",
  "jp": "カスミ「‥‥ううん」",
  "off": 10634,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 10639,
  "text_len": 12
 },
 {
  "id": "sce356:0299C",
  "jp": "トウヤ「大丈夫か？　気をつけろよ」",
  "off": 10652,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 10656,
  "text_len": 22
 },
 {
  "id": "sce356:029B7",
  "jp": "カスミ「‥‥この前と一緒だね‥‥」",
  "off": 10679,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 10684,
  "text_len": 24
 },
 {
  "id": "sce356:029D5",
  "jp": "トウヤ「ああ‥‥でも今はお互いを一番必要としている。{nl}　前とは違う」",
  "off": 10709,
  "len": 49,
  "en": "",
