  "status": "todo",
  "style": 1,
  "text_off": 7825,
  "text_len": 22
 },
 {
  "id": "sce356:01EA8",
  "jp": "声（たしかに私は消える。{nl}　だが、コアを消滅させないかぎり、{nl}　<E1>ォーリアを止めることはできん‥‥）",
  "off": 7848,
  "len": 64,
