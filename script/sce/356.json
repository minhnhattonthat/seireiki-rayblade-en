  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 7992,
  "text_len": 31
 },
 {
  "id": "sce356:01F58",
  "jp": "声（‥‥ライブレードがその鍵だと言ったはずだ‥‥{nl}　どうすればいいかは自分で考えることだ‥‥）",
  "off": 8024,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 8028,
  "text_len": 60
 },
 {
  "id": "sce356:01F99",
  "jp": "トウヤ（鍵‥‥自分で‥‥）",
  "off": 8089,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 8093,
  "text_len": 20
 },
 {
  "id": "sce356:01FB2",
  "jp": "声（‥‥クククク‥‥最後まで見届けることができないのは{nl}　残念だが、君の健闘を祈っているよ‥‥さらばだ‥‥）",
  "off": 8114,
  "len": 78,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 8118,
  "text_len": 73
 },
 {
  "id": "sce356:0201B",
  "jp": "カスミ「え？　な、なに‥‥？」",
  "off": 8219,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 8224,
  "text_len": 19
 },
 {
  "id": "sce356:02034",
  "jp": "ヤマト「<E1>ォーリアが動いている？{nl}　いったいニャにが‥‥」",
  "off": 8244,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 8249,
  "text_len": 34
 },
 {
  "id": "sce356:0205C",
  "jp": "トウヤ「‥‥ちっ、考えさせる時間もくれねぇのか‥‥」",
  "off": 8284,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 8288,
  "text_len": 33
 },
 {
  "id": "sce356:02082",
  "jp": "カスミ「‥‥」",
  "off": 8322,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 8327,
  "text_len": 9
 },
 {
  "id": "sce356:020A4",
  "jp": "トウヤ「‥‥聞いてくれ」",
  "off": 8356,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 8360,
  "text_len": 15
 },
 {
  "id": "sce356:020B8",
  "jp": "ヤマト「あれ？　どうして送信モードにしてるの？{nl}　ねぇ。ねぇ、トウ‥‥」",
  "off": 8376,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 8381,
  "text_len": 43
 },
 {
  "id": "sce356:020E9",
  "jp": "カスミ「‥‥ダメ」",
  "off": 8425,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 8430,
  "text_len": 11
 },
 {
  "id": "sce356:020FA",
  "jp": "ヤマト「え？」",
  "off": 8442,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 8447,
  "text_len": 8
 },
 {
  "id": "sce356:02108",
  "jp": "カスミ「‥‥きっとトウヤちゃんに考えがあるのよ。{nl}　トウヤちゃんを信じよう、ね？」",
  "off": 8456,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 8461,
  "text_len": 46
 },
 {
  "id": "sce356:0213C",
  "jp": "ヤマト「う、うん‥‥」",
  "off": 8508,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 8513,
  "text_len": 13
 },
 {
  "id": "sce356:0214F",
  "jp": "トウヤ「‥‥これから<E1>ォーリアのコアを破壊する。{nl}　だが、それができるのはこのライブレードだけだ。{nl}　だから、一足先に戻っていてほしい」",
  "off": 8527,
  "len": 83,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 8531,
  "text_len": 78
 },
 {
  "id": "sce356:021B5",
  "jp": "フェイン「おい！　いったいどういうことだ⁈」",
  "off": 8629,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 8633,
  "text_len": 24
 },
 {
  "id": "sce356:021D2",
  "jp": "トウヤ「‥‥ここまで来て勝手なことを{nl}　言っているのはわかっている。{nl}　だが、みんなを信じていないワケじゃない。{nl}　信じているから、信頼しているから戻ってほしいんだ。{nl}　そして、俺に戻る場所が、戻らなければならねぇ場所が{nl}　あるって安心させてくれ‥‥」",
  "off": 8658,
  "len": 153,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 8662,
  "text_len": 148
 },
 {
  "id": "sce356:02298",
  "jp": "クロビス「おい、ここまで来て、そりゃないだろ？{nl}　最後まで付き合うぜ」",
  "off": 8856,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 8860,
  "text_len": 41
 },
 {
  "id": "sce356:022D7",
  "jp": "シィウチェン「フッ‥‥戻れと言われて素直に従うと{nl}　思うか？　仲間に押し付けて自分だけ去るほど{nl}　落ちぶれてはいない」",
  "off": 8919,
  "len": 81,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 8923,
  "text_len": 76
 },
 {
  "id": "sce356:02339",
  "jp": "アーサー「つれないことを‥‥最後までお供しますよ」",
  "off": 9017,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9021,
  "text_len": 32
 },
 {
  "id": "sce356:0236C",
  "jp": "フェイン「なにを言う⁉　俺も最後まで付き合うぞ！」",
  "off": 9068,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9072,
  "text_len": 33
 },
 {
  "id": "sce356:023EC",
  "jp": "レイフォン「冷静に現実を受け止めるべきだよ。{nl}　今の我々にはどうすることもできないんだ。{nl}　悔しいけどね‥‥でもそれは事実なんだ。{nl}　だからこれ以上、彼を困らせることはすべきではないよ。{nl}　本当に信じているなら、本当の仲間なら、{nl}　ここは彼に任せるべきだ」",
  "off": 9196,
  "len": 159,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9200,
  "text_len": 154
 },
 {
  "id": "sce356:02499",
  "jp": "レイフォン「‥‥でも、戻るという約束はちゃんと{nl}　守らないといけないよ」",
  "off": 9369,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9373,
  "text_len": 42
 },
 {
  "id": "sce356:024CD",
  "jp": "トウヤ「‥‥ああ。努力してみるよ」",
  "off": 9421,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9425,
  "text_len": 21
 },
 {
  "id": "sce356:02514",
  "jp": "クロビス「トウヤ‥‥いや、よそう。{nl}　少しの別れだな」",
  "off": 9492,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9496,
  "text_len": 31
 },
 {
  "id": "sce356:02538",
  "jp": "トウヤ「‥‥そっちは任せたぜ」",
  "off": 9528,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9532,
  "text_len": 18
 },
 {
  "id": "sce356:0254F",
  "jp": "クロビス「ああ。死ぬなよ！」",
  "off": 9551,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9555,
  "text_len": 16
 },
 {
  "id": "sce356:02575",
  "jp": "シィウチェン「‥‥‥‥別れは告げぬ」",
  "off": 9589,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9593,
  "text_len": 24
 },
 {
  "id": "sce356:02592",
  "jp": "トウヤ「ああ‥‥そっちは任せたぜ」",
