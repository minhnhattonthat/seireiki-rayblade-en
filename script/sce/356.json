  "len": 50,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9820,
  "text_len": 45
 },
 {
  "id": "sce356:0268A",
  "jp": "トウヤ「ああ‥‥」",
  "off": 9866,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9870,
  "text_len": 11
 },
 {
  "id": "sce356:02713",
  "jp": "アイ「いい、絶対帰ってくるんだからね‥‥絶対に‥‥」",
  "off": 10003,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 10007,
  "text_len": 35
 },
 {
  "id": "sce356:0273B",
  "jp": "トウヤ「‥‥心配するな。ちょっと行ってくるだけだ」",
