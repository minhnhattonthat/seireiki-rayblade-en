  "len": 25,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9622,
  "text_len": 20
 },
 {
  "id": "sce356:025AB",
  "jp": "シィウチェン「‥‥承知した」",
  "off": 9643,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9647,
  "text_len": 18
 },
 {
  "id": "sce356:025D3",
  "jp": "アーサー「‥‥さよならは言いませんよ」",
  "off": 9683,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9687,
  "text_len": 24
 },
 {
  "id": "sce356:025F0",
  "jp": "トウヤ「ああ。俺も言わねぇ」",
  "off": 9712,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9716,
  "text_len": 16
 },
 {
  "id": "sce356:02605",
  "jp": "アーサー「‥‥気をつけて‥‥」",
  "off": 9733,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9737,
  "text_len": 22
 },
 {
  "id": "sce356:0262E",
  "jp": "フェイン「‥‥‥‥くっ！」",
  "off": 9774,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9778,
  "text_len": 18
 },
 {
  "id": "sce356:02645",
  "jp": "トウヤ「そっちは任せたぜ」",
