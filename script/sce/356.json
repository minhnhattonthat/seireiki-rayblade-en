  "len": 35,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 10047,
  "text_len": 30
 },
 {
  "id": "sce356:0275E",
  "jp": "アイ「ふ、ふん！　あ、あたしはカスミの心配をしてるの！{nl}　絶対無事につれて帰って来なさいよね！」",
