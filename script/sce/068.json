  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6557,
  "text_len": 38
 },
 {
  "id": "sce068:019E3",
  "jp": "フォルゼン「‥‥本当にいいのですか？」",
  "off": 6627,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6629,
  "text_len": 24
 },
 {
  "id": "sce068:01A01",
  "jp": "透夜「ああ‥‥それにセリカと約束したしな」",
  "off": 6657,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6659,
  "text_len": 27
 },
 {
  "id": "sce068:01A22",
  "jp": "フォルゼン「そうですか‥‥わかりました。{nl}　それでは参りましょうか」",
  "off": 6690,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6692,
  "text_len": 37
 },
 {
  "id": "sce068:01A6F",
  "jp": "セリカ「はあっ‥‥、はあっ‥‥！」",
  "off": 6767,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6769,
  "text_len": 22
 },
 {
  "id": "sce068:01A8B",
  "jp": "エミィ「きゃっ⁉」",
  "off": 6795,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6797,
  "text_len": 10
 },
 {
  "id": "sce068:01A9B",
  "jp": "セリカ「うわぁっ⁉」",
  "off": 6811,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6813,
  "text_len": 11
 },
 {
  "id": "sce068:01AC6",
  "jp": "セリカ「あいたたたぁ～」",
  "off": 6854,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6856,
  "text_len": 13
 },
 {
  "id": "sce068:01AD9",
  "jp": "エミィ「だ、大丈夫ですか、セリカ様⁉」",
  "off": 6873,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6875,
  "text_len": 24
 },
 {
  "id": "sce068:01AF7",
  "jp": "セリカ「え？　あぁ、平気、平気‥‥ちょっと、{nl}　息が‥‥あがっちゃって‥‥はぁ、ふぅ‥‥」",
  "off": 6903,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6905,
  "text_len": 59
 },
 {
  "id": "sce068:01B38",
  "jp": "エミィ「いったい何をそんなに急いでいるのか知りませんけど{nl}　廊下は静かに、ですわ。セリカ様」",
  "off": 6968,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6970,
  "text_len": 53
 },
 {
  "id": "sce068:01B73",
  "jp": "セリカ「へへへ、ごめんごめん、と、そうだ、急がなきゃ！」",
  "off": 7027,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7029,
  "text_len": 30
 },
 {
  "id": "sce068:01BBB",
  "jp": "エミィ「あ、セリカ様⁉」",
  "off": 7099,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7101,
  "text_len": 14
 },
 {
  "id": "sce068:01BCF",
  "jp": "セリカ「あぁー、ごめん！　ちょっと急いでるの！　じゃ！」",
  "off": 7119,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7121,
  "text_len": 33
 },
 {
  "id": "sce068:01BFA",
  "jp": "エミィ「え⁉　あ、ちょっとセリカ様～⁉」",
  "off": 7162,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7164,
  "text_len": 24
 },
 {
  "id": "sce068:01C18",
  "jp": "エミィ「行っちゃった‥‥{nl}　なんだったのかしら‥‥あんなにめかしこんで」",
  "off": 7192,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7194,
  "text_len": 41
 },
 {
  "id": "sce068:01C4E",
  "jp": "フェイン「姫！　姫～！」",
  "off": 7246,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7248,
  "text_len": 17
 },
 {
  "id": "sce068:01C65",
  "jp": "エミィ「はぁ‥‥今日はなんだか慌ただしい日ですわねぇ。{nl}　ほらそこっ、廊下は静かに！　ですわよっ！」",
  "off": 7269,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7271,
  "text_len": 61
 },
 {
  "id": "sce068:01CA8",
  "jp": "フェイン「あっ、二世！　姫を見なかったか？」",
  "off": 7336,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7338,
  "text_len": 28
 },
 {
  "id": "sce068:01CCA",
  "jp": "エミィ「うぐっ‥‥まだ言うか‥‥{nl}　まったく、あなたには記憶力というものが{nl}　ないようですわね」",
  "off": 7370,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7372,
  "text_len": 56
 },
 {
  "id": "sce068:01D08",
  "jp": "フェイン「うるさいぞ二世。知らんならお前に用はない」",
  "off": 7432,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7434,
  "text_len": 31
 },
 {
  "id": "sce068:01D2D",
  "jp": "エミィ「あっ、ちょ、ちょっと！」",
  "off": 7469,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7471,
  "text_len": 17
 },
 {
  "id": "sce068:01D44",
  "jp": "フェイン「なんだ？」",
  "off": 7492,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7494,
  "text_len": 11
 },
 {
  "id": "sce068:01D55",
  "jp": "エミィ「あ、あなた王宮騎士団への入団試験を{nl}　お受けになると聞きましたが‥‥」",
  "off": 7509,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7511,
  "text_len": 52
 },
 {
  "id": "sce068:01D8F",
  "jp": "フェイン「そうだか‥‥それがどうかしたのか？」",
  "off": 7567,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7569,
  "text_len": 26
 },
 {
  "id": "sce068:01DAF",
  "jp": "エミィ「試験には実技と筆記がありますわよね？{nl}　わたくしはご存じの通り錬金学士として将来を{nl}　嘱望されている身‥‥」",
  "off": 7599,
  "len": 81,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7601,
  "text_len": 78
 },
 {
  "id": "sce068:01E03",
  "jp": "フェイン「だからなにが言いたい？」",
  "off": 7683,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7685,
  "text_len": 19
 },
 {
  "id": "sce068:01E1C",
  "jp": "エミィ「だから、その‥‥勉強を教えてあげても{nl}　よろしくてよ？」",
  "off": 7708,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7710,
  "text_len": 38
 },
 {
  "id": "sce068:01E48",
  "jp": "フェイン「‥‥専門が違うだろ？」",
  "off": 7752,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7754,
  "text_len": 22
 },
 {
  "id": "sce068:01E64",
  "jp": "エミィ「わ、わたくしほどの才能があれば入団試験程度の{nl}　問題など教えることは容易いことですわ」",
  "off": 7780,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7782,
  "text_len": 60
 },
 {
  "id": "sce068:01EA6",
  "jp": "フェイン「でも‥‥」",
  "off": 7846,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7848,
  "text_len": 12
 },
 {
  "id": "sce068:01EC2",
  "jp": "イ<E1>ェル「‥‥教えてもらってはどうです？」",
  "off": 7874,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7876,
  "text_len": 25
 },
 {
  "id": "sce068:01EE1",
  "jp": "エミィ「イ、イ<E1>ェル様！」",
  "off": 7905,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7907,
  "text_len": 15
 },
 {
  "id": "sce068:01EF6",
  "jp": "フェイン「お言葉ですが‥‥」",
  "off": 7926,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7928,
  "text_len": 18
 },
 {
  "id": "sce068:01F0E",
  "jp": "イ<E1>ェル「その為に毎日遅くまで図書院で{nl}　騎士教本などを読んでいるのですから。{nl}　ね、エミィ？」",
  "off": 7950,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7952,
  "text_len": 61
 },
 {
  "id": "sce068:01F51",
  "jp": "エミィ「あ、いや、それは‥‥」",
  "off": 8017,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8019,
  "text_len": 17
 },
 {
  "id": "sce068:01F68",
  "jp": "フェイン「お前‥‥」",
  "off": 8040,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8042,
  "text_len": 13
 },
 {
  "id": "sce068:01F7B",
  "jp": "エミィ「‥‥」",
  "off": 8059,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8061,
  "text_len": 9
 },
 {
  "id": "sce068:01F8A",
  "jp": "イ<E1>ェル「あっ、そうそう。セリカ様ならもうとっくに{nl}　タワーへ向かいましたよ」",
  "off": 8074,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8076,
  "text_len": 42
 },
 {
  "id": "sce068:01FBA",
  "jp": "フェイン「なっ！　そ、そうですか！　では失礼します！」",
  "off": 8122,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8124,
  "text_len": 32
 },
 {
  "id": "sce068:01FE0",
  "jp": "エミィ「あ、ちょっと！　いったい今日は何があるって{nl}　言うんですの⁉」",
  "off": 8160,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8162,
  "text_len": 41
 },
 {
  "id": "sce068:0200F",
  "jp": "フェイン「アイツが返ってくるんだよ！{nl}　早くこの事を姫にお伝えしなければ‼」",
  "off": 8207,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8209,
  "text_len": 45
 },
 {
  "id": "sce068:02049",
  "jp": "エミィ「アイツ？　あっ！　ひょっとしてセリカ様が{nl}　急いでおられたのは‥‥」",
  "off": 8265,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8267,
  "text_len": 44
 },
 {
  "id": "sce068:0207B",
  "jp": "イ<E1>ェル「ええ。再びこの地へやってきた‥‥{nl}　いえ、帰ってきたのです」",
  "off": 8315,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8317,
  "text_len": 40
 },
 {
  "id": "sce068:020A9",
  "jp": "エミィ「そうですか‥‥」",
  "off": 8361,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8363,
  "text_len": 14
 },
 {
  "id": "sce068:020BD",
  "jp": "イ<E1>ェル「フェインも階位が上がり部下を持つ身と{nl}　なるのに相変わらずですね」",
  "off": 8381,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8383,
  "text_len": 47
 },
 {
  "id": "sce068:020F2",
  "jp": "エミィ「‥‥ええ、全然変りません‥‥」",
  "off": 8434,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8436,
  "text_len": 26
 },
 {
  "id": "sce068:02112",
  "jp": "イ<E1>ェル「もしかして余計なお世話でしたか？」",
  "off": 8466,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8468,
  "text_len": 27
 },
 {
  "id": "sce068:02133",
  "jp": "エミィ「‥‥いえ」",
  "off": 8499,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8501,
  "text_len": 11
 },
 {
  "id": "sce068:02144",
  "jp": "イ<E1>ェル「エミィ。そんなに焦る必要はありませんよ。{nl}　人を好きになるというのは走り続けるだけではダメです。{nl}　ときどき振り返って、相手を見ないとね」",
  "off": 8516,
  "len": 89,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8518,
  "text_len": 86
 },
 {
  "id": "sce068:021A0",
  "jp": "エミィ「‥‥難しい‥‥ですね」",
  "off": 8608,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8610,
  "text_len": 20
 },
 {
  "id": "sce068:021BA",
  "jp": "イ<E1>ェル「そうですよ。だから素敵なものなのです」",
  "off": 8634,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8636,
  "text_len": 26
 },
 {
  "id": "sce068:021DA",
  "jp": "エミィ「はい、そうですね。わたくしもそう思います」",
  "off": 8666,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8668,
  "text_len": 26
 },
 {
  "id": "sce068:02216",
  "jp": "フォルゼン「さっ、着きましたよ」",
  "off": 8726,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8728,
  "text_len": 17
 },
 {
  "id": "sce068:0222D",
  "jp": "トウヤ「あれからもう2週間か‥‥」",
  "off": 8749,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8751,
  "text_len": 21
 },
 {
  "id": "sce068:0224F",
  "jp": "トウヤ「あっ‥‥」",
  "off": 8783,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8785,
  "text_len": 11
 },
 {
  "id": "sce068:02260",
  "jp": "フォルゼン「おやおや、待ちきれなかったようですね‥‥」",
  "off": 8800,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8802,
  "text_len": 30
 },
 {
