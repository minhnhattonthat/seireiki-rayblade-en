  "text_len": 12
 },
 {
  "id": "sce068:01950",
  "jp": "晃一郎「‥‥佳澄美ちゃん、いいのかい？」",
  "off": 6480,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6482,
  "text_len": 29
 },
 {
  "id": "sce068:01973",
  "jp": "佳澄美「うん‥‥だって透夜ちゃんが選んだことだもの」",
  "off": 6515,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6517,
  "text_len": 34
 },
 {
  "id": "sce068:0199B",
  "jp": "晃一郎「‥‥そっか。{nl}　‥‥でも、あの透夜がねぇ‥‥」",
