  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6645,
  "text_len": 14
 },
 {
  "id": "sce103:01A07",
  "jp": "ヤマト「でも、あたしが見るときはいつも止#4FDまってるよ。{nl}　しかもちょうどその階に」",
