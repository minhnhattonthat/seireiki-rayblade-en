  "off": 3078,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3080,
  "text_len": 11
 },
 {
  "id": "sce103:00C17",
  "jp": "トウヤ「ははは、じゃあな」",
  "off": 3095,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3097,
  "text_len": 13
 },
 {
  "id": "sce103:00C37",
  "jp": "トウヤ「は？　いや、まだだけど‥‥」",
  "off": 3127,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3129,
  "text_len": 21
 },
 {
  "id": "sce103:00C56",
  "jp": "レオーネ「ボクもさっき行ったんだけど、まだ眠ってて‥‥{nl}{ctl:3C3E}{face:041602}{ctl:013E}{face:041C03}{ctl:023E}{face:041C07}　そっか‥‥それじゃ今はヒマなんだ」",
  "off": 3158,
  "len": 81,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3160,
  "text_len": 78
 },
 {
  "id": "sce103:00CAA",
  "jp": "トウヤ「はぁ？」",
  "off": 3242,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3244,
  "text_len": 9
 },
 {
