  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4179,
  "text_len": 14
 },
 {
  "id": "sce103:01065",
  "jp": "ミヤスコ「そうですか‥‥{nl}　あっ、すみません、立ち話は失礼ですよね。どうぞ」",
  "off": 4197,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4199,
  "text_len": 44
 },
