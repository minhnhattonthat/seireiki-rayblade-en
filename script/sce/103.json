[
 {
  "id": "sce103:00061",
  "jp": "　「1B0のフラグが立っていません。このプライベート{nl}　イベントをする場合は1B0のフラグを立てやり直して{nl}　ください。しない場合は、強制終了いたします。」{ctl:B43E}",
  "off": 97,
  "len": 96,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 99,
  "text_len": 93
 },
 {
  "id": "sce103:007B0",
  "jp": "レオーネ「あっ、トウヤ。どうしたの？」",
  "off": 1968,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1970,
  "text_len": 21
 },
 {
  "id": "sce103:007CB",
  "jp": "トウヤ「お前、そこでなにやってんだ？」",
  "off": 1995,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1997,
  "text_len": 21
 },
 {
  "id": "sce103:007E6",
  "jp": "レオーネ「なにって、部屋の片付けをしてるだけだよ」",
  "off": 2022,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2024,
  "text_len": 30
 },
 {
  "id": "sce103:0080A",
  "jp": "トウヤ「部屋？」",
  "off": 2058,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2060,
  "text_len": 11
 },
 {
  "id": "sce103:0081B",
  "jp": "レオーネ「そうだよ。ここ、ボクの部屋だもん」",
  "off": 2075,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2077,
  "text_len": 25
 },
 {
  "id": "sce103:0083A",
  "jp": "ヤマト「へぇー。あニャたも部屋を揖意してもらえたんだ」",
  "off": 2106,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2108,
  "text_len": 32
 },
 {
  "id": "sce103:00872",
  "jp": "レオーネ「うん！　なんだかうれしくって、{nl}　さっきまで部屋を掃除してたんだ」",
  "off": 2162,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2164,
  "text_len": 44
 },
 {
  "id": "sce103:008A4",
  "jp": "トウヤ「そんなに喜ぶようなことか？{nl}　お前も家には自分の部屋ぐらいあんだろ？」",
  "off": 2212,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2214,
  "text_len": 48
 },
 {
  "id": "sce103:008E5",
  "jp": "レオーネ「‥‥{nl}{ctl:3C3E}{face:041602}{ctl:013E}{face:041611}{ctl:023E}{face:041C10}　う、うん、まぁね」",
  "off": 2277,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2279,
  "text_len": 45
 },
 {
  "id": "sce103:00918",
  "jp": "トウヤ「？」",
  "off": 2328,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2330,
  "text_len": 7
 },
 {
  "id": "sce103:00937",
  "jp": "レオーネ「そ、そんなことよりさ、{nl}　ユミールさんのお見舞いにはちゃんと行ったの？」",
  "off": 2359,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2361,
  "text_len": 47
 },
 {
  "id": "sce103:00974",
  "jp": "トウヤ「は？　ま、まぁ、さっき行ってきたけど‥‥{nl}　少し話したが元気そうだった」",
  "off": 2420,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2422,
  "text_len": 48
 },
 {
  "id": "sce103:009BC",
  "jp": "レオーネ「ボクもさっき行ったんだけど、まだ眠ってて‥‥{nl}{ctl:3C3E}{face:041610}{ctl:013E}{face:041C03}{ctl:023E}{face:041C05}　そっか‥‥よし、それじゃ、行こうか」",
  "off": 2492,
  "len": 82,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2494,
  "text_len": 79
 },
 {
  "id": "sce103:00A11",
  "jp": "トウヤ「はぁ？」",
  "off": 2577,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2579,
  "text_len": 9
 },
 {
  "id": "sce103:00A2B",
  "jp": "レオーネ「だからお見舞い。付き合ってよ」",
  "off": 2603,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2605,
  "text_len": 25
 },
 {
  "id": "sce103:00A4A",
  "jp": "トウヤ「今はダメだ」",
  "off": 2634,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2636,
  "text_len": 11
 },
 {
  "id": "sce103:00A6D",
  "jp": "レオーネ「どうして？　一人だとなに話していいか{nl}　わからないし、付き合ってよぉ」",
  "off": 2669,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2671,
  "text_len": 47
 },
 {
  "id": "sce103:00AA2",
  "jp": "トウヤ「さっきは一人でいったんだろ？」",
  "off": 2722,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2724,
  "text_len": 22
 },
 {
  "id": "sce103:00AD0",
  "jp": "レオーネ「そんな昔のことは忘れた。ね、いいでしょ？」",
  "off": 2768,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2770,
  "text_len": 30
 },
 {
  "id": "sce103:00AF4",
  "jp": "トウヤ「ダメだって。それに今ユミールは寝ているんだ。{nl}　だからダメだ」",
  "off": 2804,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2806,
  "text_len": 38
 },
 {
  "id": "sce103:00B24",
  "jp": "レオーネ「え？　そうなの？{nl}　なーんだ。それじゃ、仕方ないよね。{nl}{ctl:3C3E}{face:041602}{ctl:013E}{face:041603}{ctl:023E}{face:041607}　そっか‥‥う～ん‥‥{nl}{ctl:3C3E}{face:041603}{ctl:023E}{face:041C04}　じゃ‥‥」",
  "off": 2852,
  "len": 107,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2854,
  "text_len": 104
 },
 {
  "id": "sce103:00B92",
  "jp": "トウヤ「もう案内はしねぇからな」",
  "off": 2962,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2964,
  "text_len": 18
 },
 {
  "id": "sce103:00BBC",
