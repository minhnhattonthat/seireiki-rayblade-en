  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3445,
  "text_len": 66
 },
 {
  "id": "sce103:00DBB",
  "jp": "トウヤ「‥‥言ってることが矛盾してるって気づいてるか？」",
