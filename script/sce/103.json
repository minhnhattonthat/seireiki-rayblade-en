  "status": "todo",
  "style": 0,
  "text_off": 4104,
  "text_len": 25
 },
 {
  "id": "sce103:01025",
  "jp": "ミヤスコ「ああ。いえ、そんな。{nl}　ユミールさんとはお話できましたか？」",
  "off": 4133,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4135,
  "text_len": 38
 },
 {
  "id": "sce103:01051",
  "jp": "トウヤ「ああ。おかげさまで」",
