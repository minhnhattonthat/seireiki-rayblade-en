  "len": 78,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1371,
  "text_len": 75
 },
 {
  "id": "sce170:005BC",
  "jp": "メル<E1>ィ「突然じゃないよ！{nl}　ずっと、ずっと考えてたんだから‥‥{nl}　メル<E1>ィも力になりたいの！{nl}　いっぱい、いっぱいお姉ちゃんが頑張ってるのに、{nl}　メル<E1>ィだけなにもしないなんてできないもん。{nl}　メル<E1>ィはずっとお姉ちゃんの味方だから、{nl}　お姉ちゃんのお手田いをしたいの」",
  "off": 1468,
  "len": 156,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1470,
  "text_len": 153
 },
