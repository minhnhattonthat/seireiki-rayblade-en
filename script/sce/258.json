  "status": "todo",
  "style": 0,
  "text_off": 6102,
  "text_len": 16
 },
 {
  "id": "sce258:017EA",
  "jp": "トウヤ「こんな狭いとこにあの巨体が入るのかよ？{nl}　見間違いじゃねぇのか？」",
  "off": 6122,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6124,
  "text_len": 46
 },
 {
  "id": "sce258:0181E",
  "jp": "ヤマト「ニャにと見間違えるのよぉ」",
