  "status": "todo",
  "style": 0,
  "text_off": 5296,
  "text_len": 11
 },
 {
  "id": "sce258:014BF",
  "jp": "ヤマト『ちょっと、トウヤ。あニャたセリカの気持ち{nl}　知ってるでしょ⁈』",
  "off": 5311,
