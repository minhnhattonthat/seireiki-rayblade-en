  "text_len": 93
 },
 {
  "id": "sce258:007F3",
  "jp": "ヤマト「やっぱりオーレリィだね。ニャにやってるんだろう？」",
  "off": 2035,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2037,
  "text_len": 31
 },
 {
  "id": "sce258:00818",
  "jp": "トウヤ「とりあえず、声をかけてみるか‥‥。{nl}　よっ！　こんなとこでなにやってんだ？」",
  "off": 2072,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2074,
  "text_len": 47
 },
