  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8449,
  "text_len": 14
 },
 {
  "id": "sce258:02113",
  "jp": "ヤマト「でも、あたしが見るときはいつも止#4FDまってるよ。{nl}　しかもちょうどその階に」",
