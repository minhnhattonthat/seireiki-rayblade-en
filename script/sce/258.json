  "text_len": 41
 },
 {
  "id": "sce258:022C5",
  "jp": "トウヤ「‥‥お前、いっぺんガボンに診てもらえ」",
  "off": 8901,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8903,
  "text_len": 27
 },
 {
  "id": "sce258:022E6",
  "jp": "フェイン「なにを！　俺はいたって健康そのもの！{nl}　病気になるほど軟弱にはできていない！{nl}　だっはっはっはっ！」",
  "off": 8934,
  "len": 69,
  "en": "",
  "status": "todo",
