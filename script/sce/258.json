  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5453,
  "text_len": 8
 },
 {
  "id": "sce258:0156B",
  "jp": "セリカ「トウヤはそれでいいの？」",
  "off": 5483,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5485,
  "text_len": 17
 },
 {
  "id": "sce258:01582",
  "jp": "トウヤ「それは‥‥」",
  "off": 5506,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5508,
  "text_len": 12
 },
 {
  "id": "sce258:01594",
  "jp": "　いいわけあるかよ{nl}　その程度で揺らぐのか？",
  "off": 5524,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 128,
  "text_off": 5526,
  "text_len": 26
 },
 {
  "id": "sce258:015CE",
  "jp": "セリカ「だったらどうしてそんなこと言うの？」",
  "off": 5582,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5584,
  "text_len": 24
 },
 {
  "id": "sce258:015EC",
  "jp": "トウヤ「お前はどうなんだ？{nl}　あいつと再会して、どう思ってるんだ？」",
  "off": 5612,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5614,
  "text_len": 40
 },
 {
  "id": "sce258:0162C",
  "jp": "セリカ「それは‥‥もちろんうれしいよ」",
  "off": 5676,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5678,
  "text_len": 21
 },
 {
  "id": "sce258:01647",
  "jp": "トウヤ「だったら‥‥」",
  "off": 5703,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5705,
  "text_len": 13
 },
 {
  "id": "sce258:0166C",
  "jp": "セリカ「‥‥でも、その気持ちの前に別の気持ちがあるの。{nl}　今の私にとって、大切な気持ち‥‥」",
