  "style": 0,
  "text_off": 5414,
  "text_len": 9
 },
 {
  "id": "sce258:01537",
  "jp": "セリカ「‥‥いいの？」",
  "off": 5431,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5433,
  "text_len": 14
 },
 {
  "id": "sce258:0154B",
  "jp": "トウヤ「え？」",
