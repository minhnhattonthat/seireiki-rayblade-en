  "text_off": 8936,
  "text_len": 66
 },
 {
  "id": "sce258:0232E",
  "jp": "ヤマト「‥‥讐傷ね」",
  "off": 9006,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9008,
  "text_len": 14
 },
 {
  "id": "sce258:0234A",
  "jp": "フェイン「‥‥で、どうだった？　今回のは結構自信が{nl}　あるんだがな。いやぁ、自分の才能が怖いぜ」",
  "off": 9034,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9036,
  "text_len": 62
 },
 {
  "id": "sce258:0238E",
  "jp": "　なかなかいいんじゃねぇか{nl}　演歌みてぇだ",
  "off": 9102,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 128,
  "text_off": 9104,
  "text_len": 23
 },
 {
  "id": "sce258:023B7",
  "jp": "フェイン「だろ？　特に最後のとこなんか言ってる俺が{nl}　しびれるぐらいだからな」",
  "off": 9143,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9145,
  "text_len": 45
 },
 {
  "id": "sce258:023EA",
  "jp": "ヤマト「陶酔してる‥‥これはもう末期ね」",
  "off": 9194,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9196,
  "text_len": 26
 },
 {
  "id": "sce258:0240A",
  "jp": "トウヤ「そ、そうか。まぁ、頑張れよ」",
  "off": 9226,
