  "status": "todo",
  "style": 0,
  "text_off": 1105,
  "text_len": 19
 },
 {
  "id": "sce006:00468",
  "jp": "セリカ「だ・か・ら！{nl}　あなたが無茶なことばっかりするからでしょ⁉{nl}　だいたいフェインのプラーナが高すぎるの」",
  "off": 1128,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1130,
  "text_len": 61
 },
 {
  "id": "sce006:004AB",
