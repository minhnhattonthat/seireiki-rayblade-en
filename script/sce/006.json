  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2087,
  "text_len": 36
 },
 {
  "id": "sce006:0084F",
  "jp": "クロビス「おいおい、俺か？」",
  "off": 2127,
