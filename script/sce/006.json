  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1362,
  "text_len": 39
 },
 {
  "id": "sce006:0057D",
  "jp": "セリカ「‥‥でもアガルティア王国の許可が{nl}　下りないでしょうね。あなた一応、騎士だしね」",
  "off": 1405,
