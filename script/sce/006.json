  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2129,
  "text_len": 16
 },
 {
  "id": "sce006:00865",
  "jp": "アーサー「この近くには街はもちろん村もありませんから{nl}　ナンパなんてできませんよ」",
