  "status": "translated",
  "style": 0,
  "text_off": 2695,
  "text_len": 14
 },
 {
  "id": "sce394:00A99",
  "jp": "トウヤ「まあ、そんなこんなで同じ高校に通うことになって、{nl}　現在に至るって感じだな」",
