  "status": "translated",
  "style": 0,
  "text_off": 2715,
  "text_len": 50
 },
 {
  "id": "sce394:00AE3",
  "jp": "アイ「なーんかさ、あの子の人生って{nl}　トウヤと一緒にあるって感じしない？」",
  "off": 2787,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2789,
  "text_len": 45
 },
 {
  "id": "sce394:00B16",
