  "style": 0,
  "text_off": 1316,
  "text_len": 9
 },
 {
  "id": "sce106:00539",
  "jp": "ミヤスコ「あれは‥‥烙印なのです」",
  "off": 1337,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1339,
  "text_len": 21
 },
 {
  "id": "sce106:00554",
  "jp": "トウヤ「？」",
  "off": 1364,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1366,
  "text_len": 7
 },
 {
  "id": "sce106:00561",
  "jp": "ミヤスコ「私は人間ではありません」",
  "off": 1377,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1379,
  "text_len": 20
 },
 {
  "id": "sce106:0057B",
  "jp": "トウヤ「⁉　どういうことだ？」",
  "off": 1403,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1405,
  "text_len": 17
 },
 {
  "id": "sce106:00592",
  "jp": "ミヤスコ「正確には普通の人間ではないのです。{nl}　私は遺田子操作で生み出された{nl}　“造られた人間”です」",
  "off": 1426,
  "len": 73,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1428,
  "text_len": 70
 },
 {
  "id": "sce106:005DE",
  "jp": "トウヤ「お、おい‥‥」",
  "off": 1502,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1504,
  "text_len": 13
 },
 {
  "id": "sce106:005F1",
  "jp": "ミヤスコ「そしてあのアザは私達を識別するためのコード」",
  "off": 1521,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1523,
  "text_len": 32
 },
 {
  "id": "sce106:00617",
  "jp": "トウヤ「“達”って、まだ他にいるのか？」",
  "off": 1559,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1561,
  "text_len": 25
 },
 {
  "id": "sce106:00636",
  "jp": "ミヤスコ「いえ、生き残っているのはおそらく私一人‥‥{nl}　他の者はすべて処理されたと聞いています」",
  "off": 1590,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1592,
  "text_len": 60
 },
 {
  "id": "sce106:00678",
  "jp": "トウヤ「処理って‥‥」",
  "off": 1656,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1658,
  "text_len": 15
 },
 {
  "id": "sce106:0068D",
  "jp": "ミヤスコ「私が造られた計画が中止#4FDになった時、{nl}　研究所ごと爆破されました。{nl}　その時、私はテスト中の事故で暴走し、{nl}　レスト少佐に救われ、かくまわれていたので、{nl}　難を逃れたのです」",
  "off": 1677,
  "len": 118,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1679,
  "text_len": 115
 },
 {
  "id": "sce106:00706",
  "jp": "ヤマト「レストって、フェインの師匠の？」",
  "off": 1798,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1800,
  "text_len": 23
 },
 {
  "id": "sce106:00723",
  "jp": "ミヤスコ「はい。私が今こうしていられるのもすべて{nl}　レスト少佐のおかげです」",
  "off": 1827,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1829,
  "text_len": 42
 },
 {
  "id": "sce106:00753",
  "jp": "トウヤ「そうか‥‥でも俺には普通の人間にしか{nl}　みえねぇが‥‥」",
  "off": 1875,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1877,
  "text_len": 41
 },
 {
  "id": "sce106:00782",
  "jp": "ミヤスコ「自然に受精するか、人工的に行うかの{nl}　違いで、誕生までの過程はほぼ同じですから」",
  "off": 1922,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1924,
  "text_len": 59
 },
 {
  "id": "sce106:007C3",
  "jp": "ヤマト「その計画っていったいニャんの為に存在したの？」",
  "off": 1987,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1989,
  "text_len": 33
 },
 {
  "id": "sce106:007EA",
  "jp": "ミヤスコ「完璧な兵止を作る計画です。{nl}　そしてその計画を推進していたのが{nl}　ジグリム共和麹です」",
  "off": 2026,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2028,
  "text_len": 62
 },
 {
  "id": "sce106:0082E",
  "jp": "トウヤ「‥‥あいつら‥‥」",
  "off": 2094,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2096,
  "text_len": 17
 },
 {
  "id": "sce106:00845",
  "jp": "ミヤスコ「ですが、計画を中止#4FDしたのもジグリム。{nl}　先代の大統領の命令ですべての記録を抹梢され、{nl}　施設も破壊されました」",
  "off": 2117,
  "len": 82,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2119,
  "text_len": 79
 },
 {
  "id": "sce106:0089A",
  "jp": "トウヤ「そ、そうか‥‥このことを知っているのは？」",
  "off": 2202,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2204,
  "text_len": 29
 },
 {
  "id": "sce106:008BD",
  "jp": "ミヤスコ「私を助けてくれたレスト少佐だけです。{nl}　ジグリム側の関係者で存命な方はいませんから。{nl}　ただ、もしかすると当時のジグリム大統領の{nl}　主席補佐官だったネル・ホーレム大統領が{nl}　知っているかもしれません」",
  "off": 2237,
  "len": 134,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2239,
  "text_len": 131
 },
 {
  "id": "sce106:00946",
  "jp": "トウヤ「あのじーさんか‥‥でもこの前は‥‥」",
  "off": 2374,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2376,
  "text_len": 28
 },
 {
  "id": "sce106:00968",
  "jp": "ミヤスコ「ええ。私に接触はしてきませんでした。{nl}　ただ、あの計画の存在については知っていると見て{nl}　まちがいないでしょう」",
  "off": 2408,
  "len": 73,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2410,
  "text_len": 70
 },
 {
  "id": "sce106:009B4",
  "jp": "トウヤ「なんだかややこしくなってきたな‥‥」",
  "off": 2484,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2486,
  "text_len": 24
 },
 {
  "id": "sce106:009D2",
  "jp": "ミヤスコ「黙っていてすみません。{nl}　できれば忘れたかったのですが‥‥{nl}　カイン王子の機体、あれはあの計画の技術が{nl}　使われているかもしれません。{nl}　もしそうなら、ことは世界規模の問題になります。{nl}　命令に忠実な殺りく兵止が造られるワケですから」",
  "off": 2514,
  "len": 152,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2516,
  "text_len": 149
 },
 {
  "id": "sce106:00A6D",
  "jp": "トウヤ「‥‥マジかよ‥‥」",
  "off": 2669,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2671,
  "text_len": 17
 },
 {
  "id": "sce106:00A84",
  "jp": "ミヤスコ「ですが、まだ私の推測にしか過ぎません。{nl}　このことはもう少しだけ内密にしてもらえませんか？」",
  "off": 2692,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2694,
  "text_len": 59
 },
 {
  "id": "sce106:00AC5",
  "jp": "トウヤ「それはかまわねぇけど‥‥」",
  "off": 2757,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2759,
  "text_len": 19
 },
 {
  "id": "sce106:00ADE",
  "jp": "ミヤスコ「ありがとうございます」",
  "off": 2782,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2784,
  "text_len": 16
 },
 {
  "id": "sce106:00AF4",
  "jp": "ヤマト「‥‥でも、どうしてあたし達にそんニャ讐要ニャこと{nl}　はニャしたの？」",
  "off": 2804,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2806,
  "text_len": 44
 },
 {
  "id": "sce106:00B26",
  "jp": "ミヤスコ「なぜでしょう？　不思議ですよね。{nl}　でも、話したことは後悔していません。{nl}　どちらかといえば楽になった気がします」",
  "off": 2854,
  "len": 74,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2856,
  "text_len": 71
 },
 {
  "id": "sce106:00B73",
  "jp": "トウヤ「まぁ、ずっと一人で抱えていたワケだもんな。{nl}　それじゃ、これで秘密を共有する仲に{nl}　なったってことだな」",
  "off": 2931,
  "len": 67,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2933,
  "text_len": 64
 },
 {
  "id": "sce106:00BB9",
  "jp": "ミヤスコ「はい」",
  "off": 3001,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3003,
  "text_len": 8
 },
 {
  "id": "sce106:00BC7",
  "jp": "トウヤ「でも、みんなには無理して話さなくていいと思うぜ。{nl}　話したところで態度を変えるような奴らじゃねぇけど、{nl}　ヘンな気をつかうかもしれねぇし、そんなの嫌だろ？」",
  "off": 3015,
  "len": 97,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3017,
  "text_len": 94
 },
 {
  "id": "sce106:00C2B",
  "jp": "ミヤスコ「そうですね。ありがとうございます。{nl}　でも、トウヤさんも同じですよ？」",
  "off": 3115,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3117,
  "text_len": 42
 },
 {
  "id": "sce106:00C5B",
  "jp": "トウヤ「え？」",
  "off": 3163,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3165,
  "text_len": 8
 },
 {
  "id": "sce106:00C69",
  "jp": "ミヤスコ「これまでどおり接していただけると{nl}　うれしいのですが‥‥」",
  "off": 3177,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3179,
  "text_len": 37
 },
 {
  "id": "sce106:00C94",
  "jp": "トウヤ「あ、ああそうだな。わかったよ」",
  "off": 3220,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3222,
  "text_len": 19
 },
 {
  "id": "sce106:00CAD",
  "jp": "ミヤスコ「ふふふふふ。すみません、時間をとらせてしまって。{nl}　それでは私はこれで失礼します」",
  "off": 3245,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3247,
  "text_len": 51
 },
 {
  "id": "sce106:00CE6",
  "jp": "トウヤ「ああ」",
  "off": 3302,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3304,
  "text_len": 7
 },
 {
  "id": "sce106:00D07",
  "jp": "ミヤスコ「ごめんなさい」",
  "off": 3335,
