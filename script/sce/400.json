  "text_off": 1044,
  "text_len": 7
 },
 {
  "id": "sce400:0041F",
  "jp": "ミヤスコ「‥‥私に訊きたいことがあるみたいですね」",
  "off": 1055,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1057,
  "text_len": 29
 },
 {
