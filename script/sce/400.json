  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1092,
  "text_len": 20
 },
 {
  "id": "sce400:0045C",
  "jp": "ミヤスコ「‥‥さっき、私の首のアザを見ましたね？」",
