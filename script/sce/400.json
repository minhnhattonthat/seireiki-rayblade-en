  "off": 1202,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1204,
  "text_len": 10
 },
 {
  "id": "sce400:004C2",
  "jp": "トウヤ「‥‥」",
  "off": 1218,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1220,
  "text_len": 9
 },
 {
  "id": "sce400:004D9",
  "jp": "ミヤスコ「あれは‥‥烙印なのです」",
  "off": 1241,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1243,
  "text_len": 21
 },
 {
  "id": "sce400:004F4",
  "jp": "トウヤ「？」",
  "off": 1268,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1270,
  "text_len": 7
 },
 {
  "id": "sce400:00501",
  "jp": "ミヤスコ「私は人間ではありません」",
  "off": 1281,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1283,
  "text_len": 20
 },
 {
  "id": "sce400:0051B",
  "jp": "トウヤ「⁉　どういうことだ？」",
  "off": 1307,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1309,
  "text_len": 17
 },
 {
  "id": "sce400:00532",
  "jp": "ミヤスコ「正確には普通の人間ではないのです。{nl}　私は遺田子操作で生み出された{nl}　“造られた人間”です」",
  "off": 1330,
  "len": 73,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1332,
  "text_len": 70
 },
 {
  "id": "sce400:0057E",
  "jp": "トウヤ「お、おい‥‥」",
  "off": 1406,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1408,
  "text_len": 13
 },
 {
  "id": "sce400:00591",
  "jp": "ミヤスコ「そしてあのアザは私達を識別するためのコード」",
  "off": 1425,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1427,
  "text_len": 32
 },
 {
  "id": "sce400:005B7",
  "jp": "トウヤ「“達”って、まだ他にいるのか？」",
  "off": 1463,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1465,
  "text_len": 25
 },
 {
  "id": "sce400:005D6",
  "jp": "ミヤスコ「いえ、生き残っているのはおそらく私一人‥‥{nl}　他の者はすべて処理されたと聞いています」",
  "off": 1494,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1496,
  "text_len": 60
 },
 {
  "id": "sce400:00618",
  "jp": "トウヤ「処理って‥‥」",
  "off": 1560,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1562,
  "text_len": 15
 },
 {
  "id": "sce400:0062D",
  "jp": "ミヤスコ「私が造られた計画が中止#4FDになった時、{nl}　研究所ごと爆破されました。{nl}　その時、私はテスト中の事故で暴走し、{nl}　レスト少佐に救われ、かくまわれていたので、{nl}　難を逃れたのです」",
  "off": 1581,
  "len": 118,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1583,
  "text_len": 115
 },
 {
  "id": "sce400:006A6",
  "jp": "ヤマト「レストって、フェインの師匠の？」",
  "off": 1702,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1704,
  "text_len": 23
 },
 {
  "id": "sce400:006C3",
  "jp": "ミヤスコ「はい。私が今こうしていられるのもすべて{nl}　レスト少佐のおかげです」",
  "off": 1731,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1733,
  "text_len": 42
 },
 {
  "id": "sce400:006F3",
  "jp": "トウヤ「そうか‥‥でも俺には普通の人間にしか{nl}　みえねぇが‥‥」",
  "off": 1779,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1781,
  "text_len": 41
 },
 {
  "id": "sce400:00722",
  "jp": "ミヤスコ「自然に受精するか、人工的に行うかの{nl}　違いで、誕生までの過程はほぼ同じですから」",
  "off": 1826,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1828,
  "text_len": 59
 },
 {
  "id": "sce400:00763",
  "jp": "ヤマト「その計画っていったいニャんの為に存在したの？」",
  "off": 1891,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1893,
  "text_len": 33
 },
 {
  "id": "sce400:0078A",
  "jp": "ミヤスコ「完璧な兵止を作る計画です。{nl}　そしてその計画を推進していたのが{nl}　ジグリム共和麹です」",
  "off": 1930,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1932,
  "text_len": 62
 },
 {
  "id": "sce400:007CE",
  "jp": "トウヤ「‥‥あいつら‥‥」",
  "off": 1998,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2000,
  "text_len": 17
 },
 {
  "id": "sce400:007E5",
  "jp": "ミヤスコ「ですが、計画を中止#4FDしたのもジグリム。{nl}　先代の大統領の命令ですべての記録を抹梢され、{nl}　施設も破壊されました」",
  "off": 2021,
  "len": 82,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2023,
  "text_len": 79
 },
 {
  "id": "sce400:0083A",
  "jp": "トウヤ「そ、そうか‥‥このことを知っているのは？」",
  "off": 2106,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2108,
  "text_len": 29
 },
 {
  "id": "sce400:0085D",
  "jp": "ミヤスコ「私を助けてくれたレスト少佐だけです。{nl}　ジグリム側の関係者で存命な方はいませんから。{nl}　ただ、もしかすると当時のジグリム大統領の{nl}　主席補佐官だったネル・ホーレム大統領が{nl}　知っているかもしれません」",
  "off": 2141,
  "len": 134,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2143,
  "text_len": 131
 },
 {
  "id": "sce400:008E6",
  "jp": "トウヤ「あのじーさんか‥‥でもこの前は‥‥」",
  "off": 2278,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2280,
  "text_len": 28
 },
 {
  "id": "sce400:00908",
  "jp": "ミヤスコ「ええ。私に接触はしてきませんでした。{nl}　ただ、あの計画の存在については知っていると見て{nl}　まちがいないでしょう」",
  "off": 2312,
  "len": 73,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2314,
  "text_len": 70
 },
 {
  "id": "sce400:00954",
  "jp": "トウヤ「なんだかややこしくなってきたな‥‥」",
  "off": 2388,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2390,
  "text_len": 24
 },
 {
  "id": "sce400:00972",
  "jp": "ミヤスコ「黙っていてすみません。{nl}　できれば忘れたかったのですが‥‥{nl}　カイン王子の機体、あれはあの計画の技術が{nl}　使われているかもしれません。{nl}　もしそうなら、ことは世界規模の問題になります。{nl}　命令に忠実な殺りく兵止が造られるワケですから」",
  "off": 2418,
  "len": 152,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2420,
  "text_len": 149
 },
 {
  "id": "sce400:00A0D",
  "jp": "トウヤ「‥‥マジかよ‥‥」",
  "off": 2573,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2575,
  "text_len": 17
 },
 {
  "id": "sce400:00A24",
  "jp": "ミヤスコ「ですが、まだ私の推測にしか過ぎません。{nl}　このことはもう少しだけ内密にしてもらえませんか？」",
  "off": 2596,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2598,
  "text_len": 59
 },
 {
  "id": "sce400:00A65",
  "jp": "トウヤ「それはかまわねぇけど‥‥」",
  "off": 2661,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2663,
  "text_len": 19
 },
 {
  "id": "sce400:00A7E",
  "jp": "ミヤスコ「ありがとうございます」",
  "off": 2686,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2688,
  "text_len": 16
 },
 {
  "id": "sce400:00A94",
  "jp": "ヤマト「‥‥でも、どうしてあたし達にそんニャ讐要ニャこと{nl}　はニャしたの？」",
  "off": 2708,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2710,
  "text_len": 44
 },
 {
  "id": "sce400:00AC6",
  "jp": "ミヤスコ「なぜでしょう？　不思議ですよね。{nl}　でも、話したことは後悔していません。{nl}　どちらかといえば楽になった気がします」",
  "off": 2758,
  "len": 74,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2760,
  "text_len": 71
 },
 {
  "id": "sce400:00B13",
  "jp": "トウヤ「まぁ、ずっと一人で抱えていたワケだもんな。{nl}　それじゃ、これで秘密を共有する仲に{nl}　なったってことだな」",
  "off": 2835,
  "len": 67,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2837,
  "text_len": 64
 },
 {
  "id": "sce400:00B59",
  "jp": "ミヤスコ「はい」",
  "off": 2905,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2907,
  "text_len": 8
 },
 {
  "id": "sce400:00B67",
  "jp": "トウヤ「でも、みんなには無理して話さなくていいと思うぜ。{nl}　話したところで態度を変えるような奴らじゃねぇけど、{nl}　ヘンな気をつかうかもしれねぇし、そんなの嫌だろ？」",
  "off": 2919,
  "len": 97,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2921,
  "text_len": 94
 },
 {
  "id": "sce400:00BCB",
  "jp": "ミヤスコ「そうですね。ありがとうございます。{nl}　でも、トウヤさんも同じですよ？」",
  "off": 3019,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3021,
  "text_len": 42
 },
 {
  "id": "sce400:00BFB",
  "jp": "トウヤ「え？」",
  "off": 3067,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3069,
  "text_len": 8
 },
 {
  "id": "sce400:00C09",
  "jp": "ミヤスコ「これまでどおり接していただけると{nl}　うれしいのですが‥‥」",
  "off": 3081,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3083,
  "text_len": 37
 },
 {
  "id": "sce400:00C34",
  "jp": "トウヤ「あ、ああそうだな。わかったよ」",
  "off": 3124,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3126,
  "text_len": 19
 },
 {
  "id": "sce400:00C4D",
  "jp": "ミヤスコ「ふふふふふ。すみません、時間をとらせてしまって。{nl}　それでは私はこれで失礼します」",
  "off": 3149,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3151,
  "text_len": 51
 },
 {
  "id": "sce400:00C86",
  "jp": "トウヤ「ああ」",
  "off": 3206,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3208,
  "text_len": 7
 },
 {
  "id": "sce400:00CAA",
  "jp": "ミヤスコ「ごめんなさい」",
