  "off": 2851,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2853,
  "text_len": 41
 },
 {
  "id": "sce398:00B52",
  "jp": "　その一歩はお前のおかげだな{nl}　だが、その一歩はかなり大きな一歩だな",
