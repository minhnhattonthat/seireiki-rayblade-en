[
 {
  "id": "sce398:00055",
  "jp": "　「1B0のフラグが立っていません。このプライベート{nl}　イベントをする場合は1B0のフラグを立てやり直して{nl}　ください。しない場合は、強制終了いたします。」{ctl:B43E}",
  "off": 85,
  "len": 96,
  "en": "\"Flag 1B0 is not set. To run this private event, set flag 1B0 and start again. Otherwise, the event will be force-quit.\"{ctl:B43E}",
  "status": "translated",
  "style": 0,
  "text_off": 87,
  "text_len": 93
 },
 {
  "id": "sce398:003A1",
  "jp": "ヤマト「あれ？　フェインの反応が消えた‥‥」",
  "off": 929,
  "len": 31,
  "en": "Yamato: Huh? Fain's signal just vanished...",
  "status": "translated",
  "style": 0,
  "text_off": 931,
  "text_len": 28
 },
 {
  "id": "sce398:003C3",
  "jp": "フェイン「ふふふふふふふふ‥‥」",
  "off": 963,
  "len": 21,
  "en": "Fain: Heheheheheheheh...",
  "status": "translated",
  "style": 0,
  "text_off": 965,
  "text_len": 18
 },
 {
  "id": "sce398:003DB",
  "jp": "トウヤ「おい、ヤマト、あいつならあそこだ」",
  "off": 987,
  "len": 24,
  "en": "Touya: Hey, Yamato. If you're looking for him, he's over there.",
  "status": "translated",
  "style": 0,
  "text_off": 989,
  "text_len": 21
 },
 {
  "id": "sce398:003F6",
  "jp": "ヤマト「あっ、あれってデュッセルドフじゃニャい？{nl}　うーん‥‥頬擦りしてるわね、フェイン‥‥」",
  "off": 1014,
  "len": 58,
  "en": "Yamato: Oh, isn't that the Dusseldorf, nya? Hmmm... He's rubbing his cheek against it. Fain...",
  "status": "translated",
  "style": 0,
  "text_off": 1016,
  "text_len": 55
 },
 {
  "id": "sce398:00433",
  "jp": "トウヤ「そんだけうれしいんだろ？」",
  "off": 1075,
  "len": 21,
  "en": "Touya: Guess he's just that happy, huh?",
  "status": "translated",
  "style": 0,
  "text_off": 1077,
  "text_len": 18
 },
 {
  "id": "sce398:0044B",
  "jp": "フェイン「俺の聖霊機～{nl}　ふふ、ふふふふふふ‥‥」",
  "off": 1099,
  "len": 35,
  "en": "Fain: My Spirit Mech~ Heh, hehehehehe...",
  "status": "translated",
  "style": 0,
  "text_off": 1101,
  "text_len": 32
 },
 {
  "id": "sce398:00471",
  "jp": "ヤマト「今はそっとしておいてあげましょうか」",
  "off": 1137,
  "len": 26,
  "en": "Yamato: Let's just leave him be for now.",
  "status": "translated",
  "style": 0,
  "text_off": 1139,
  "text_len": 23
 },
 {
  "id": "sce398:0048E",
  "jp": "トウヤ「そうだな‥‥」",
  "off": 1166,
  "len": 16,
  "en": "Touya: Yeah...",
  "status": "translated",
  "style": 0,
  "text_off": 1168,
  "text_len": 13
 },
 {
  "id": "sce398:0050F",
  "jp": "フェイン「ん？　おお、どうした？{nl}　お前も格好いい前口上の研究にやってきたのか？」",
  "off": 1295,
  "len": 55,
  "en": "Fain: Hm? Oh, what is it? Have you come to research cool battle-cry speeches too?",
  "status": "translated",
  "style": 0,
  "text_off": 1297,
  "text_len": 52
 },
 {
  "id": "sce398:00549",
  "jp": "トウヤ「‥‥いや、そういう趣味はない」",
  "off": 1353,
  "len": 26,
  "en": "Touya: ...Nah, I'm not into that.",
  "status": "translated",
  "style": 0,
  "text_off": 1355,
  "text_len": 23
 },
 {
  "id": "sce398:00566",
  "jp": "フェイン「‥‥おかしな奴だな。それ以外にここに来る{nl}　理由はあるまい？」",
  "off": 1382,
  "len": 48,
  "en": "Fain: ...Odd fellow. There's no other reason to come here, surely?",
  "status": "translated",
  "style": 0,
  "text_off": 1384,
  "text_len": 45
 },
 {
  "id": "sce398:00599",
  "jp": "トウヤ「お前と一緒にしねぇでくれ」",
  "off": 1433,
  "len": 23,
  "en": "Touya: Don't lump me in with you.",
  "status": "translated",
  "style": 0,
  "text_off": 1435,
  "text_len": 20
 },
 {
  "id": "sce398:005B3",
  "jp": "フェイン「そうか！　さては俺に隠れて自分だけのモノを{nl}　作るつもりだな⁉」",
  "off": 1459,
  "len": 47,
  "en": "Fain: I see! You plan to create one all your own behind my back, don't you!?",
  "status": "translated",
  "style": 0,
  "text_off": 1461,
  "text_len": 44
 },
 {
  "id": "sce398:005E5",
  "jp": "トウヤ「‥‥」",
