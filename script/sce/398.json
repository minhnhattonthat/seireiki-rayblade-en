  "len": 12,
  "en": "Touya: ...",
  "status": "translated",
  "style": 0,
  "text_off": 1511,
  "text_len": 9
 },
 {
  "id": "sce398:005F4",
  "jp": "ヤマト「‥‥さて、行きましょうか」",
  "off": 1524,
  "len": 23,
  "en": "Yamato: ...Well, shall we go?",
  "status": "translated",
  "style": 0,
  "text_off": 1526,
  "text_len": 20
 },
 {
  "id": "sce398:0060E",
  "jp": "トウヤ「あ、ああ‥‥」",
