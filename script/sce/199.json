 },
 {
  "id": "sce199:01518",
  "jp": "アイ「そ、そんなワケないじゃない！{nl}　わかったわよ。行けばいいんでしょ！」",
  "off": 5400,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5402,
  "text_len": 40
 },
 {
  "id": "sce199:0155F",
  "jp": "トウヤ「‥‥なにをやったらこんなことになるんだ？」",
  "off": 5471,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
