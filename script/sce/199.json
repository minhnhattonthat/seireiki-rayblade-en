 },
 {
  "id": "sce199:014A9",
  "jp": "アイ「え～」",
  "off": 5289,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5291,
  "text_len": 7
 },
 {
  "id": "sce199:014B6",
  "jp": "ヤマト「“え～”じゃニャいの！{nl}　焼きたてじゃニャくても大丈夫でしょ？{nl}　それとも焼きたてじゃニャいと美味しくニャいの？」",
  "off": 5302,
