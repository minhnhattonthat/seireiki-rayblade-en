 {
  "id": "sce199:00B93",
  "jp": "カイン「なかなか良い機体だろ？{nl}　そんなところに隠れてないで出ておいでよ」",
  "off": 2963,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2965,
  "text_len": 43
 },
 {
  "id": "sce199:00BC4",
  "jp": "トウヤ「なんだ‥‥バレてたか‥‥」",
  "off": 3012,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3014,
  "text_len": 21
 },
 {
  "id": "sce199:00C03",
  "jp": "カイン「そんなに僕って信用ないのかい？{nl}　‥‥まぁ、信用しろというのも無理な話かもね」",
  "off": 3075,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3077,
  "text_len": 54
 },
 {
  "id": "sce199:00C3F",
  "jp": "トウヤ「‥‥」",
  "off": 3135,
  "len": 12,
  "en": "Touya: ...",
  "status": "translated",
  "style": 0,
  "text_off": 3137,
  "text_len": 9
 },
 {
  "id": "sce199:00C4E",
  "jp": "カイン「別にいいさ。僕は僕のなすべきことをするだけ。{nl}　そのためにこいつを作り上げたんだ」",
  "off": 3150,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3152,
  "text_len": 50
 },
 {
  "id": "sce199:00C86",
  "jp": "ヤマト「でも、それってアガルティア王国の機体{nl}　ニャんでしょ？」",
  "off": 3206,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3208,
  "text_len": 37
 },
 {
  "id": "sce199:00CB1",
  "jp": "カイン「そうさ。でも中身は別物だよ。{nl}　それにまだ本当の力を使ってないしね」",
  "off": 3249,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3251,
  "text_len": 46
 },
 {
  "id": "sce199:00CE5",
  "jp": "トウヤ「本当の力？」",
  "off": 3301,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3303,
  "text_len": 14
 },
 {
  "id": "sce199:00CF9",
  "jp": "カイン「ふふふふ‥‥秘密。{nl}　でも、もうすぐ公開できるかもね。キミ達の前でさ」",
  "off": 3321,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3323,
  "text_len": 47
 },
 {
  "id": "sce199:00D2E",
  "jp": "トウヤ「なんかひっかかる言い方だが、まぁいいや。{nl}　それより、なんでこんなところに来たんだ？」",
  "off": 3374,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3376,
  "text_len": 51
 },
 {
  "id": "sce199:00D67",
  "jp": "カイン「キミと話すためさ」",
  "off": 3431,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3433,
  "text_len": 14
 },
 {
  "id": "sce199:00D7B",
  "jp": "トウヤ「お、俺と？」",
  "off": 3451,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3453,
  "text_len": 12
 },
 {
  "id": "sce199:00D8D",
  "jp": "カイン「個人的興味かな？{nl}　キミは今の状態に満足かい？{page}　突然連れてこられて聖霊機にのって戦うことを{nl}　強要されるこの現状に」",
  "off": 3469,
  "len": 89,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3471,
  "text_len": 86
 },
 {
  "id": "sce199:00DE9",
  "jp": "トウヤ「満足もなにも俺自身ワケがわかんねぇよ。{page}　でも今はジグリムとかいう国のやつらは許せねぇし、{nl}　＜ゼ＝オード＞という奴等も気にいらねぇって{nl}　思っている」",
  "off": 3561,
  "len": 99,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3563,
  "text_len": 96
 },
 {
  "id": "sce199:00E4F",
  "jp": "カイン「キミは‥‥正直なんだね。{nl}　でも、戦うことに疑問を持っている。{nl}　ちがうかい？」",
  "off": 3663,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3665,
  "text_len": 53
 },
 {
  "id": "sce199:00E8A",
  "jp": "トウヤ「そりゃそうさ。{nl}　ロボットに乗って戦うことになるなんて思いも{nl}　しなかったからな。だが俺に出来ることがあるなら{nl}　俺はそれをしたいと思ってる。{nl}　第一、見ているだけってのも性にあわねぇしな」",
  "off": 3722,
  "len": 114,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3724,
  "text_len": 111
 },
 {
  "id": "sce199:00EFF",
  "jp": "カイン「だったらもっとやりがいのある所へ行かないかい？{nl}　キミの‥‥初めて聖霊機にのって苦もなく操ってみせた{nl}　その才能をいかんなく発揮できる場所へ」",
  "off": 3839,
  "len": 95,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3841,
  "text_len": 92
 },
 {
  "id": "sce199:00F61",
  "jp": "トウヤ「どういうことだ？」",
  "off": 3937,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3939,
  "text_len": 14
 },
 {
  "id": "sce199:00F75",
  "jp": "カイン「この世界を革命できるところさ」",
  "off": 3957,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3959,
  "text_len": 23
 },
 {
  "id": "sce199:00F92",
  "jp": "トウヤ「あんた‥‥何者だ？」",
  "off": 3986,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3988,
  "text_len": 19
 },
 {
  "id": "sce199:00FAB",
  "jp": "カイン「ただの“元”王子様さ。{nl}　トウヤ君‥‥今の話、考えておいてね‥‥{nl}　ここにいてもキミは不幸になるだけだから。{nl}　さて、僕もそろそろブリッジへ戻ろうかな」",
  "off": 4011,
  "len": 101,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4013,
  "text_len": 98
 },
 {
  "id": "sce199:01017",
  "jp": "トウヤ「お、おい！　ちょっと待てよ！{nl}　‥‥ったく、なんなんだあいつ？」",
  "off": 4119,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4121,
  "text_len": 42
 },
 {
  "id": "sce199:01047",
  "jp": "ヤマト「‥‥」",
  "off": 4167,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4169,
  "text_len": 9
 },
 {
  "id": "sce199:01056",
  "jp": "トウヤ「まぁ、いいや。それじゃ、アイを呼びに行くか」",
  "off": 4182,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4184,
  "text_len": 28
 },
 {
  "id": "sce199:0109F",
  "jp": "アイ「やっとできたよ～{nl}　よし、あとはこれをオーブンに入れて‥‥」",
  "off": 4255,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4257,
  "text_len": 38
 },
 {
  "id": "sce199:010CB",
  "jp": "トウヤ「‥‥お前、まだ作ってたのか？」",
  "off": 4299,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4301,
  "text_len": 24
 },
 {
  "id": "sce199:010E9",
  "jp": "アイ「うわっ！　と、突然、背後から声かけないでよね！」",
  "off": 4329,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4331,
  "text_len": 34
 },
 {
  "id": "sce199:01111",
  "jp": "トウヤ「どうだ？　うまくできそうか？」",
  "off": 4369,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4371,
  "text_len": 21
 },
 {
  "id": "sce199:0112C",
  "jp": "アイ「あったり前じゃない！　アイちゃんに不可能はないの」",
  "off": 4396,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4398,
  "text_len": 33
 },
 {
  "id": "sce199:01153",
  "jp": "トウヤ「まあ、こんなに時間をかけて作ったんだからな。{nl}　コクのあるクッキーになったんじゃねぇか？」",
  "off": 4435,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4437,
  "text_len": 54
 },
 {
  "id": "sce199:0118F",
  "jp": "アイ「なによそれ？　ケンカ売ってんの？」",
  "off": 4495,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4497,
  "text_len": 23
 },
 {
  "id": "sce199:011AC",
  "jp": "ヤマト「はいストップ、ストップ。{nl}　それより、そろそろベルネア砦よ。{nl}　打ち合わせがあるからはやくブリッジへ来て」",
  "off": 4524,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4526,
  "text_len": 61
 },
 {
  "id": "sce199:011EF",
  "jp": "アイ「え～」",
  "off": 4591,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4593,
  "text_len": 7
 },
 {
  "id": "sce199:011FC",
  "jp": "ヤマト「“え～”じゃニャいの！{nl}　焼きたてじゃニャくても大丈夫でしょ？{nl}　それとも焼きたてじゃニャいと美味しくニャいの？」",
  "off": 4604,
  "len": 77,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4606,
  "text_len": 74
 },
 {
  "id": "sce199:0124C",
  "jp": "アイ「そ、そんなワケないじゃない！{nl}　わかったわよ。行けばいいんでしょ！」",
  "off": 4684,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4686,
  "text_len": 40
 },
 {
  "id": "sce199:0127D",
  "jp": "アイ「やっとできたよ～{nl}　よし、あとはこれをオーブンに入れて‥‥」",
  "off": 4733,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4735,
  "text_len": 38
 },
 {
  "id": "sce199:012A9",
  "jp": "トウヤ「‥‥なにをやったらこんなことになるんだ？」",
  "off": 4777,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4779,
  "text_len": 28
 },
 {
  "id": "sce199:012D3",
  "jp": "アイ「うわっ！　と、突然、背後から声かけないでよね！」",
  "off": 4819,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4821,
  "text_len": 34
 },
 {
  "id": "sce199:012FB",
  "jp": "トウヤ「そんなことより、この惨状はなんだ？」",
  "off": 4859,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4861,
  "text_len": 25
 },
 {
  "id": "sce199:0132C",
  "jp": "アイ「うっさいわね。{nl}　これはまったくもって偶発的におきた不幸な事故よ」",
  "off": 4908,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4910,
  "text_len": 43
 },
 {
  "id": "sce199:0135D",
  "jp": "トウヤ「俺には必然的に起きた{nl}　人為的な結果だとおもうが」",
  "off": 4957,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4959,
  "text_len": 39
 },
 {
  "id": "sce199:0138E",
  "jp": "アイ「な、なによ！　そんなこと言うと後で分けて{nl}　あげないからね！」",
  "off": 5006,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5008,
  "text_len": 39
 },
 {
  "id": "sce199:013BB",
  "jp": "トウヤ「へぇ、そんなこと考えてくれてたのか？」",
  "off": 5051,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5053,
  "text_len": 25
 },
 {
  "id": "sce199:013EC",
  "jp": "アイ「残ったらね。とにかくアルフォリナにあたしの{nl}　腕前をみせなくっちゃ。それからよ」",
  "off": 5100,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5102,
  "text_len": 46
 },
 {
  "id": "sce199:01420",
  "jp": "トウヤ「その過程をみていないことは幸せだな」",
  "off": 5152,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5154,
  "text_len": 25
 },
 {
  "id": "sce199:01443",
  "jp": "アイ「むっかー！」",
  "off": 5187,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5189,
  "text_len": 11
 },
 {
