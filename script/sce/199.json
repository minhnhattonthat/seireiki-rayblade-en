[
 {
  "id": "sce199:00058",
  "jp": "？？？「お父さま！　お父さま！」",
  "off": 88,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 90,
  "text_len": 23
 },
 {
  "id": "sce199:00075",
  "jp": "？？？？？「騒々しいな。どうした、シエル？」",
  "off": 117,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 119,
  "text_len": 29
 },
 {
  "id": "sce199:00098",
  "jp": "シエル「どうしたではありません！{nl}　フラムエルクが陥落したとは真ですか⁈」",
  "off": 152,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 154,
  "text_len": 42
 },
 {
  "id": "sce199:000C8",
  "jp": "？？？？？「‥‥落ち着け、いったい誰がそのような{nl}　流言を吹聴しているのだ？」",
  "off": 200,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 202,
  "text_len": 54
 },
 {
  "id": "sce199:00104",
  "jp": "シエル「流言‥‥？　嘘だとおっしゃるのですか？{nl}　ですが、フラムエルクへの回線も不通となっています。{nl}　それにここ数日、敵の動きが活性化しています。{nl}　これらのことは城#946が陥落したと考えればすべて{nl}　つじつまが合います」",
  "off": 260,
  "len": 135,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 262,
  "text_len": 132
 },
 {
  "id": "sce199:0018E",
  "jp": "？？？？？「お前はこの父の言葉を信じられぬ、{nl}　そう言うのか？{nl}　このガリュード・ビア・<E1>ラッツェンの言葉を？」",
  "off": 398,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 400,
  "text_len": 72
 },
 {
  "id": "sce199:001DC",
  "jp": "シエル「‥‥」",
  "off": 476,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 478,
  "text_len": 9
 },
 {
  "id": "sce199:001EB",
  "jp": "ガリュード「シエル。{nl}　これは我等を動揺させるジグリムの策だ。{nl}　そのように流言蜚語に惑わされてはならん」",
  "off": 491,
  "len": 67,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 493,
  "text_len": 64
 },
 {
  "id": "sce199:00231",
  "jp": "シエル「‥‥なるほど。“ジグリムの策”ですか」",
  "off": 561,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 563,
  "text_len": 28
 },
 {
  "id": "sce199:00253",
  "jp": "ガリュード「うむ。{nl}　これは敵も余裕がなくなってきている証拠だ。{nl}　勝負に出る時なのかもしれん。{nl}　シエル、お前は砦を発ち、クロンデェムへ向かえ。{nl}　そこにはすでにタイロンが部隊を集結させているはずだ。{page}　そのままジグリム軍の側面から攻撃をかけ、{nl}　挟撃をする」",
  "off": 595,
  "len": 159,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 597,
  "text_len": 156
 },
 {
  "id": "sce199:002F5",
  "jp": "シエル「‥‥クロンデェム？　あそこにタイロンが？」",
  "off": 757,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 759,
  "text_len": 29
 },
 {
  "id": "sce199:00318",
  "jp": "ガリュード「そうだ。シエル行ってくれるな？」",
  "off": 792,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 794,
  "text_len": 25
 },
 {
  "id": "sce199:00337",
  "jp": "シエル「ご命令とあれば」",
  "off": 823,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 825,
  "text_len": 14
 },
 {
  "id": "sce199:0034B",
  "jp": "ガリュード「うむ。では命令する」",
  "off": 843,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 845,
  "text_len": 19
 },
 {
  "id": "sce199:00364",
  "jp": "シエル「了解しました。シエル・レン・<E1>ラッツェン、{nl}　ただいまより作戦行動に移ります！」",
  "off": 868,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 870,
  "text_len": 52
 },
 {
  "id": "sce199:0039E",
  "jp": "ガリュード「う、うむ。なかなかよい返事だ」",
  "off": 926,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 928,
  "text_len": 24
 },
 {
  "id": "sce199:003BC",
  "jp": "シエル「お父さまという手本がありますから」",
  "off": 956,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 958,
  "text_len": 24
 },
 {
  "id": "sce199:003DA",
  "jp": "ガリュード「ふっ‥‥言いよるわ。{nl}　‥‥シエル」",
  "off": 986,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 988,
  "text_len": 30
 },
 {
  "id": "sce199:003FE",
  "jp": "シエル「はい」",
  "off": 1022,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1024,
  "text_len": 7
 },
 {
  "id": "sce199:0040B",
  "jp": "ガリュード「お前は女だ。{nl}　いつまでも騎士としてあるだけが人生でもあるまい。{nl}　そろそろお前も‥‥」",
  "off": 1035,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1037,
  "text_len": 60
 },
 {
  "id": "sce199:0044D",
  "jp": "シエル「またその話ですか。{nl}　私は結婚をする気はありません」",
  "off": 1101,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1103,
  "text_len": 35
 },
 {
  "id": "sce199:00476",
  "jp": "ガリュード「そんなことを言っていると{nl}　そのうちもらい手がなくなるぞ」",
  "off": 1142,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1144,
  "text_len": 38
 },
 {
  "id": "sce199:004A2",
  "jp": "シエル「そうなったらなったで構いません。{nl}　今のままお父さまの世話をするだけです。{page}　それに、女は子供を産む道具だと思っている男が{nl}　多すぎます。女も男も本質は同じ。女だから子を産み{nl}　育てなければならないと思っているのは男のエゴです。{nl}　男とはそのような勝手な生き物です」",
  "off": 1186,
  "len": 170,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1188,
  "text_len": 167
 },
 {
  "id": "sce199:0054F",
  "jp": "ガリュード「だが、すべての男がそうだとはかぎらんぞ」",
  "off": 1359,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1361,
  "text_len": 28
 },
 {
  "id": "sce199:00571",
  "jp": "シエル「ええ、そうですね。お父さまのように」",
  "off": 1393,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1395,
  "text_len": 23
 },
 {
  "id": "sce199:0058E",
  "jp": "ガリュード「ふぅ‥‥まぁ、いい。{nl}　とにかく急ぎ支度をし、出発しろ。{nl}　作戦は一刻を争う」",
  "off": 1422,
  "len": 61,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1424,
  "text_len": 58
 },
 {
  "id": "sce199:005CE",
  "jp": "シエル「了解しました。では失礼します」",
  "off": 1486,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1488,
  "text_len": 23
 },
 {
  "id": "sce199:00605",
  "jp": "ガリュード「今日は素直だったな。{nl}　それだけ大人になられたということか？{nl}　しかし、ますますフィリス様に似てこられた‥‥」",
  "off": 1541,
  "len": 76,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1543,
  "text_len": 73
 },
 {
  "id": "sce199:00670",
  "jp": "ユミール「みんな、集まった？」",
  "off": 1648,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1650,
  "text_len": 18
 },
 {
  "id": "sce199:00688",
  "jp": "セリカ「ん？　アイがいないわね」",
  "off": 1672,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1674,
  "text_len": 17
 },
 {
  "id": "sce199:0069F",
  "jp": "アーサー「そういえば厨房#915でみかけましたよ」",
  "off": 1695,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1697,
  "text_len": 25
 },
 {
  "id": "sce199:006C6",
  "jp": "クロビス「まったく、あいつはなにをやっているんだ？{nl}　おい、トウヤ。呼んで来い」",
  "off": 1734,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1736,
  "text_len": 43
 },
 {
  "id": "sce199:006F7",
  "jp": "トウヤ「え？」",
  "off": 1783,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1785,
  "text_len": 8
 },
 {
  "id": "sce199:00705",
  "jp": "クロビス「あいつとお前は妙に相性がいいみたいだしな。{nl}　適任だろう。それとも嫌か？」",
  "off": 1797,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1799,
  "text_len": 50
 },
 {
  "id": "sce199:0073D",
  "jp": "トウヤ「‥‥別に嫌じゃねぇけど‥‥」",
  "off": 1853,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1855,
  "text_len": 24
 },
 {
  "id": "sce199:0075B",
  "jp": "クロビス「なら行ってこい」",
  "off": 1883,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1885,
  "text_len": 14
 },
 {
  "id": "sce199:0076F",
  "jp": "トウヤ「‥‥わかったよ。行けばいいんだろ！{nl}　人使いの荒いやつだぜまったく‥‥{nl}　ホラ、行くぞヤマト」",
  "off": 1903,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1905,
  "text_len": 61
 },
 {
  "id": "sce199:007B2",
