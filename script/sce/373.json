[
 {
  "id": "sce373:0007A",
  "jp": "ガリュード「‥‥なるほど。そういうことならば、{nl}　しばらくこの国に留まられるとよい。{nl}　ご迷惑でなければな」",
  "off": 122,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 124,
  "text_len": 61
 },
 {
  "id": "sce373:000BD",
  "jp": "トーラ「しかし、私はジグリムの‥‥」",
  "off": 189,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 191,
  "text_len": 22
 },
 {
  "id": "sce373:000D9",
  "jp": "ガリュード「では訊きますが、あなたは我々の敵かな？{nl}　それとも敵となりたいのですかな？」",
  "off": 217,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 219,
  "text_len": 51
 },
 {
  "id": "sce373:00112",
  "jp": "トーラ「い、いえ。そのようなことは」",
  "off": 274,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 276,
  "text_len": 19
 },
 {
  "id": "sce373:0012B",
  "jp": "ガリュード「ならば気にせず、留まってくだされ。{nl}　あなた方を守るぐらいの力はあるつもりですが」",
  "off": 299,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 301,
  "text_len": 53
 },
 {
