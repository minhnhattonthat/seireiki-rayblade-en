  "off": 358,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 360,
  "text_len": 22
 },
 {
  "id": "sce373:00182",
  "jp": "トーラ「‥‥あなた、よろしいのですか？」",
