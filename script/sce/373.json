  "off": 517,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 519,
  "text_len": 17
 },
 {
  "id": "sce373:00228",
  "jp": "カスミ「‥‥よかった」",
  "off": 552,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 554,
  "text_len": 13
 },
 {
  "id": "sce373:0023B",
  "jp": "グラード「君にも感謝せねばな。{nl}　あの時、君に止められなければ、{nl}　今こうしていることはできなかったのだからね」",
  "off": 571,
  "len": 67,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 573,
  "text_len": 64
 },
 {
  "id": "sce373:00293",
  "jp": "カスミ「そんな‥‥私の方こそ、怪我をさせてしまって」",
  "off": 659,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 661,
  "text_len": 32
 },
 {
  "id": "sce373:002B9",
  "jp": "グラード「はははは、この程度、怪我のうちには入らんよ」",
  "off": 697,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 699,
  "text_len": 33
 },
 {
  "id": "sce373:002E0",
  "jp": "トーラ「もうあまり若くはないのですから、{nl}　調子に乗らないでください」",
  "off": 736,
