  "text_len": 8
 },
 {
  "id": "sce382:018A1",
  "jp": "トウヤ「はっ！」",
  "off": 6305,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6307,
  "text_len": 9
 },
 {
  "id": "sce382:018C4",
  "jp": "？？？？？「‥‥君に徇かう力がどんどん強まっている‥‥{nl}　きっと、誰かが君を呼んでいるんだね」",
  "off": 6340,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6342,
  "text_len": 63
 },
 {
  "id": "sce382:01909",
  "jp": "トウヤ「それは、戻れるってことか？」",
  "off": 6409,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6411,
  "text_len": 20
 },
 {
  "id": "sce382:01923",
  "jp": "？？？？？「‥‥おそらく。これで僕も戻れそうだよ」",
  "off": 6435,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6437,
  "text_len": 34
 },
 {
  "id": "sce382:0194B",
  "jp": "トウヤ「そういえばあんたはなんでここに？」",
  "off": 6475,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6477,
  "text_len": 22
 },
 {
  "id": "sce382:01967",
  "jp": "？？？？？「3年前の爆発に巻き込まれてね。{nl}　でも、後悔はしていないよ。だって、そのおかげで僕は{nl}　するべきことが見つかったし、そのための力も手に入れた。{nl}　今は感謝したいぐらいだよ」",
  "off": 6503,
  "len": 116,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6505,
  "text_len": 113
 },
 {
  "id": "sce382:019DE",
  "jp": "トウヤ「力？」",
  "off": 6622,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6624,
  "text_len": 9
 },
 {
  "id": "sce382:019ED",
  "jp": "？？？？？「僕を絶望の淵から救ってくれたものさ」",
  "off": 6637,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6639,
  "text_len": 34
 },
 {
  "id": "sce382:01A15",
  "jp": "トウヤ「それは‥‥ん？」",
  "off": 6677,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6679,
  "text_len": 15
 },
 {
  "id": "sce382:01A2A",
  "jp": "？？？？？「これでお別れのようだね。{nl}　さぁ、もう一度思い浮かべるんだ。君が大切に{nl}　想うひとを、君を大切に想ってくれるひとを」",
  "off": 6698,
  "len": 85,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6700,
  "text_len": 82
 },
 {
  "id": "sce382:01A82",
  "jp": "トウヤ「あ、ああ‥‥」",
  "off": 6786,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6788,
  "text_len": 13
 },
 {
  "id": "sce382:01A95",
  "jp": "　違う人を思い浮かべる{nl}　アイを思い浮かべる{nl}　カスミを思い浮かべる",
  "off": 6805,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 192,
  "text_off": 6807,
  "text_len": 42
 },
 {
  "id": "sce382:01ACD",
  "jp": "　違う人を思い浮かべる{nl}　セリカを思い浮かべる{nl}　オーレリィを思い浮かべる",
  "off": 6861,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 192,
  "text_off": 6863,
  "text_len": 46
 },
 {
  "id": "sce382:01B09",
  "jp": "　違う人を思い浮かべる{nl}　ユミールを思い浮かべる{nl}　クルルを思い浮かべる",
  "off": 6921,
  "len": 48,
  "en": "",
  "status": "todo",
