[
 {
  "id": "sce077:00027",
  "jp": "レイフォン「ローディス‥‥そんなに落ち込まないで‥‥{nl}　君が僕の味方でいてくれたように僕もずっと君の‥‥」",
  "off": 39,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 41,
  "text_len": 68
 },
 {
  "id": "sce077:00071",
  "jp": "ローディス「同情なんてたくさんだ！{nl}　私は王家の嫡子なんだ。{nl}　嫡子でなければいけないんだ！」",
  "off": 113,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 115,
  "text_len": 59
 },
 {
  "id": "sce077:000B2",
  "jp": "レイフォン「ロ、ローディス‥‥どうしたんだい？{nl}　君らしくないじゃないか‥‥{nl}　陛下の息子じゃないからどうだって言うんだい？{nl}　皇太子という地位なんて、君という存在に比べたら{nl}　ちっぽけなものだよ。だから‥‥」",
  "off": 178,
  "len": 132,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 180,
  "text_len": 129
 },
 {
  "id": "sce077:00139",
  "jp": "ローディス「‥‥たしかに地位など私個人にとって{nl}　讐要なものではない。だが、皇太子としての私はすでに{nl}　私個人の範ちゅうを越えてしまっているんだ。{nl}　レイフォン、私は君とは違う！{nl}　皇太子たる私が背負うものは君とは比べようもなく{nl}　讐いものなんだっ！」",
  "off": 313,
  "len": 162,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 315,
  "text_len": 159
 },
 {
  "id": "sce077:001DE",
  "jp": "レイフォン「‥‥ローディス、君が責任感の強い人だって{nl}　ことは僕が一番知っているよ。{nl}　でも、それに押し潰されることはないんだ」",
  "off": 478,
  "len": 82,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 480,
  "text_len": 79
 },
 {
  "id": "sce077:00233",
  "jp": "ローディス「くっ‥‥君にはわからない‥‥{nl}　叔父上の愛妾の子供である君には！」",
  "off": 563,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 565,
  "text_len": 54
 },
 {
  "id": "sce077:0026F",
  "jp": "レイフォン「‥‥ローディス‥‥」",
  "off": 623,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 625,
  "text_len": 21
 },
 {
  "id": "sce077:0028A",
  "jp": "ローディス「‥‥あっ、す、すまない。言い過ぎた‥‥」",
  "off": 650,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 652,
  "text_len": 33
 },
 {
  "id": "sce077:002B1",
  "jp": "レイフォン「ローディス‥‥それが君の本心なんだね。{nl}　‥‥君が励ましてくれた時、僕は救われたんだ。{nl}　王族の中にもこういう考えをする人がいるんだって{nl}　わかって、とてもうれしかった‥‥{nl}　でもそれは、僕に同情していただけなんだね」",
  "off": 689,
  "len": 141,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 691,
  "text_len": 138
 },
 {
  "id": "sce077:00341",
  "jp": "ローディス「ち、違う‥‥」",
  "off": 833,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 835,
  "text_len": 17
 },
 {
  "id": "sce077:00358",
  "jp": "レイフォン「単なる気まぐれで可愛そうな庶子に{nl}　救いの手を差し伸べてみただけ。{nl}　ただ、それだけだったんだ‥‥」",
  "off": 856,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 858,
  "text_len": 68
 },
 {
  "id": "sce077:003A2",
  "jp": "ローディス「聞いてくれ！　私はそういうつもりじゃ‥‥」",
  "off": 930,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 932,
  "text_len": 33
 },
 {
  "id": "sce077:003C9",
  "jp": "レイフォン「‥‥そうだね。君は僕とちがって{nl}　“正統”でなければならないからね。{nl}　だけど、僕は父上も母上も尊敬している。{nl}　たとえ、妾腹の子と言われても、二人の子供であって{nl}　よかったと思っているんだ。君が僕のことをそんなふうに{nl}　見ていたなんて残念だよ‥‥」",
  "off": 969,
  "len": 165,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 971,
  "text_len": 162
 },
 {
  "id": "sce077:00471",
  "jp": "ローディス「レ、レイフォン！」",
  "off": 1137,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1139,
  "text_len": 17
 },
 {
  "id": "sce077:00488",
  "jp": "レイフォン「‥‥さようなら、ローディスさん‥‥」",
  "off": 1160,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1162,
  "text_len": 29
 },
 {
  "id": "sce077:004C7",
  "jp": "ローディス「レイフォン‼」",
  "off": 1223,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1225,
  "text_len": 15
 },
