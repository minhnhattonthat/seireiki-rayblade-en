  "len": 14,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 6913,
  "text_len": 9
 },
 {
  "id": "sce077:01B0B",
  "jp": "カイン「それを‥‥それなのに‥‥あの男は、ローディスは、{nl}　レイフォンを傷つけたんだ！」",
