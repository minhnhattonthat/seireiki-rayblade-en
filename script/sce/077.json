 },
 {
  "id": "sce077:0063F",
  "jp": "ローディス「‥‥ま、また、あの夢か‥‥」",
  "off": 1599,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1601,
  "text_len": 26
 },
 {
  "id": "sce077:0066F",
  "jp": "カイン「‥‥目が覚めたようだね」",
  "off": 1647,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1649,
  "text_len": 20
 },
 {
  "id": "sce077:00689",
  "jp": "ローディス「‥‥」",
  "off": 1673,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1675,
  "text_len": 12
 },
 {
  "id": "sce077:006B4",
  "jp": "カイン「死んじゃったのかと思ったよ。{nl}　でもまだ死ぬのは早いからね‥‥{nl}　キミにはもっと苦しんでもらわなければ‥‥」",
  "off": 1716,
  "len": 70,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1718,
  "text_len": 67
 },
 {
  "id": "sce077:006FD",
  "jp": "ローディス「‥‥ティックスは‥‥」",
  "off": 1789,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1791,
  "text_len": 22
 },
 {
  "id": "sce077:00719",
  "jp": "カイン「おやおや、自分よりもティックスのほうが{nl}　心配なのか？{nl}　フッ‥‥あんたが人を思いやることを知っていたとはね。{nl}　それともあの時のことにたいする悔恨かい？{nl}　だけどね‥‥そんなことしたってレイフォンはもう帰って{nl}　こないんだ！　おまえが、殺し‥‥グフッ！",
  "off": 1817,
  "len": 156,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1819,
  "text_len": 153
 },
 {
  "id": "sce077:007B8",
  "jp": "　ゴホゴホッ‥‥ゴホ‥‥」",
  "off": 1976,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1978,
  "text_len": 17
 },
 {
  "id": "sce077:007CF",
  "jp": "ローディス「カイン、君は‥‥」",
  "off": 1999,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2001,
  "text_len": 19
 },
 {
  "id": "sce077:007E8",
  "jp": "カイン「はぁ、はぁはぁ‥‥ふふ、ふふふふふふ。{nl}　残念だけど‥‥僕には、時間がないんだ‥‥。{page}　だから安心して‥‥もう少しで君もその苦しみから{nl}　解放してあげるよ‥‥」",
  "off": 2024,
  "len": 109,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2026,
  "text_len": 106
 },
 {
  "id": "sce077:00858",
  "jp": "ローディス「‥‥私を憎むならその手で殺せばいい。{nl}　だが、ティックスは関係ない‥‥あの子は‥‥」",
  "off": 2136,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2138,
  "text_len": 62
 },
 {
  "id": "sce077:0089C",
  "jp": "カイン「はぁはぁ、そ、そうとも。{nl}　ティックスは関係ないさ‥‥でもね。{nl}　あの子を利揖することが君を苦しめることになる。{nl}　僕にとってはそれで十分なんだ。{nl}　彼自身のことなんかどうだっていいんだよ」",
  "off": 2204,
  "len": 117,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2206,
  "text_len": 114
 },
 {
  "id": "sce077:00914",
  "jp": "ローディス「カイン‥‥君はティックスの友達だったはず‥‥{nl}　なのに‥‥どうして‥‥？」",
  "off": 2324,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2326,
  "text_len": 56
 },
 {
  "id": "sce077:00952",
  "jp": "カイン「友達？　フッ‥‥おめでたい人だ。そんなものが{nl}　本当にいるなんて思っている人間はバカだよ‥‥」",
  "off": 2386,
  "len": 67,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2388,
  "text_len": 64
 },
 {
  "id": "sce077:00998",
  "jp": "ローディス「カイン‥‥」",
  "off": 2456,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2458,
  "text_len": 15
 },
 {
  "id": "sce077:009DF",
  "jp": "セリカ「ねぇ、本当に大丈夫？{nl}　向こうだって警戒#37Dしてるんでしょ？」",
  "off": 2527,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2529,
  "text_len": 43
 },
 {
  "id": "sce077:00A10",
  "jp": "フェイン「姫。それは問題ありません。{nl}　すでにマキ姉が手筈を整えているはずです」",
  "off": 2576,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2578,
  "text_len": 47
 },
 {
  "id": "sce077:00A45",
  "jp": "セリカ「‥‥だから心配なのよねぇ」",
  "off": 2629,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2631,
  "text_len": 21
 },
 {
  "id": "sce077:00A60",
  "jp": "レスト「心配ありませんよ。{nl}　あいつはああ見えて、やると決めたことはやり遂げる{nl}　強い女です。任せていて安心ですよ」",
  "off": 2656,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2658,
  "text_len": 68
 },
 {
  "id": "sce077:00AAA",
  "jp": "カスミ「信じていらっしゃるんですね」",
  "off": 2730,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2732,
  "text_len": 19
 },
 {
  "id": "sce077:00AC3",
  "jp": "レスト「ああ。あいつとの付き合いも長いからな」",
  "off": 2755,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2757,
  "text_len": 26
 },
 {
  "id": "sce077:00AE3",
  "jp": "セリカ「え？　ちょっと待って。{nl}　もしかしてレストとマキって、付き合ってたの？」",
  "off": 2787,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2789,
  "text_len": 45
 },
 {
  "id": "sce077:00B16",
  "jp": "レスト「え？　え、ええ‥‥まぁ」",
  "off": 2838,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2840,
  "text_len": 19
 },
 {
  "id": "sce077:00B2F",
  "jp": "フェイン「え？　言ってませんでしたか？{nl}　だから俺とマキ姉が知り合いだったのですが‥‥」",
  "off": 2863,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2865,
  "text_len": 53
 },
 {
  "id": "sce077:00B6A",
  "jp": "トウヤ「へぇ、わからないもんだ」",
  "off": 2922,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2924,
  "text_len": 16
 },
 {
  "id": "sce077:00B80",
  "jp": "アーサー「恋とはそいうものですよ。{nl}　さて、そろそろ潜入に際しての最終的な打ち合わせを{nl}　したほうがいいのではありませんか？」",
  "off": 2944,
  "len": 78,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2946,
  "text_len": 75
 },
 {
  "id": "sce077:00BD1",
  "jp": "レスト「あ、ああ、そうだな‥‥」",
  "off": 3025,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3027,
  "text_len": 18
 },
 {
  "id": "sce077:00BE9",
  "jp": "アガルティア兵止「お話中、申し訳ございません！」",
  "off": 3049,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3051,
  "text_len": 31
 },
 {
  "id": "sce077:00C0E",
  "jp": "レスト「どうした？」",
  "off": 3086,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3088,
  "text_len": 11
 },
 {
  "id": "sce077:00C1F",
  "jp": "アガルティア兵止「はっ！　ただいま偵察部隊からの{nl}　報告で、装兵機部隊がこちらへ向かい{nl}　進軍していると‥‥」",
  "off": 3103,
  "len": 77,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3105,
  "text_len": 74
 },
 {
  "id": "sce077:00C6F",
  "jp": "トウヤ「なにっ⁉」",
  "off": 3183,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3185,
  "text_len": 10
 },
 {
  "id": "sce077:00C7F",
  "jp": "レスト「‥‥早いな。どういうことだ？」",
  "off": 3199,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3201,
  "text_len": 23
 },
 {
  "id": "sce077:00C9C",
  "jp": "セリカ「とにかく、戦闘態勢に入りましょう！」",
  "off": 3228,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3230,
  "text_len": 28
 },
 {
  "id": "sce077:00CBE",
  "jp": "レスト「はい。よし、全員搭乗！」",
  "off": 3262,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3264,
  "text_len": 21
 },
 {
  "id": "sce077:00E5F",
  "jp": "ヤマト「ちょっと、トウヤ。わかってるとは思うけど、{nl}　あまり安易にプラーニャの補給を考えてたらダメよ」",
  "off": 3679,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 3684,
  "text_len": 58
 },
 {
  "id": "sce077:00E9F",
  "jp": "トウヤ「補給？　あ、ああ‥‥わかってる」",
  "off": 3743,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3747,
  "text_len": 25
 },
 {
  "id": "sce077:00EBD",
  "jp": "ヤマト「本当？　おんニャの子の唇はそんニャに{nl}　安いものじゃニャいんだからね」",
  "off": 3773,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 3778,
  "text_len": 45
 },
 {
  "id": "sce077:00EF0",
  "jp": "トウヤ「俺だって安易にしたくねぇよ」",
  "off": 3824,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3828,
  "text_len": 21
 },
 {
  "id": "sce077:00F0A",
  "jp": "ヤマト「だったらいいけど」",
  "off": 3850,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 3855,
  "text_len": 13
 },
 {
  "id": "sce077:00F2F",
  "jp": "アーサー「すみません、今回は勝手に行動させて{nl}　もらいます」",
  "off": 3887,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3891,
  "text_len": 38
 },
 {
  "id": "sce077:00F74",
  "jp": "セリカ「悪いけど今回は指示に従えないわ」",
  "off": 3956,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3960,
  "text_len": 26
 },
 {
  "id": "sce077:00FAD",
  "jp": "フェイン「お前の中にはまだ熱き正義の魂が{nl}　宿っていない！　そんな者の命令に従うことはできん！{nl}　ということで、俺は俺の正義を貫く！　以上！」",
  "off": 4013,
  "len": 98,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4017,
  "text_len": 93
 },
 {
  "id": "sce077:01017",
  "jp": "アガルティア兵止「少佐！　通信が入っています！{nl}　共通回線へ回します！」",
  "off": 4119,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4123,
  "text_len": 51
 },
 {
