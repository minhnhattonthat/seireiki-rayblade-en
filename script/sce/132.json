  "status": "todo",
  "style": 1,
  "text_off": 670,
  "text_len": 30
 },
 {
  "id": "sce132:002BD",
  "jp": "レシュ「ば、バカ野郎！　ジグリムの方へ送って{nl}　どおすんだ⁉」",
  "off": 701,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 705,
  "text_len": 37
 },
 {
  "id": "sce132:002E7",
  "jp": "バーキン「しかし、奴等の聖霊機もいるぞ」",
