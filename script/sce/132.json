  "status": "todo",
  "style": 1,
  "text_off": 747,
  "text_len": 26
 },
 {
  "id": "sce132:00306",
  "jp": "レシュ「そんなもん、偶然だ。{nl}　このままジグリムも巻き込んだらえらいことになる‥‥」",
  "off": 774,
  "len": 53,
  "en": "",
