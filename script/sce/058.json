  "off": 3640,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3642,
  "text_len": 9
 },
 {
  "id": "sce058:00E47",
  "jp": "声（ライブレードを使ってこの“コア”を破壊すれば{nl}　<E1>ォーリアも私もその存在を捕てなくなり、梢滅する。{nl}　そしてこの世界は救われるのだ‥‥{nl}　クククク‥‥さて、そろそろ始めさせて貫#7E9ってもいいかな？）",
  "off": 3655,
