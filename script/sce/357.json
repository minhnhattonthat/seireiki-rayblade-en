  "status": "todo",
  "style": 2,
  "text_off": 8024,
  "text_len": 9
 },
 {
  "id": "sce357:01F75",
  "jp": "トウヤ「‥‥聞いてくれ」",
  "off": 8053,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 8057,
  "text_len": 15
 },
 {
  "id": "sce357:01F89",
  "jp": "ヤマト「あれ？　どうして送信モードにしてるの？{nl}　ねぇ。ねぇ、トウ‥‥」",
