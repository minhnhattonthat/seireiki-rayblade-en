  "len": 25,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 7921,
  "text_len": 19
 },
 {
  "id": "sce357:01F05",
  "jp": "ヤマト「<E1>ォーリアが動いている？{nl}　いったいニャにが‥‥」",
  "off": 7941,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 7946,
  "text_len": 34
 },
 {
