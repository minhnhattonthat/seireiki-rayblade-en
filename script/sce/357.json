  "off": 9183,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9187,
  "text_len": 31
 },
 {
  "id": "sce357:02403",
  "jp": "トウヤ「‥‥そっちは任せたぜ」",
  "off": 9219,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9223,
  "text_len": 18
 },
