  "en": "",
  "status": "todo",
  "style": 128,
  "text_off": 1733,
  "text_len": 23
 },
 {
  "id": "sce414:006EC",
  "jp": "フェイン「だろ？　特に最後のとこなんか言ってる俺が{nl}　しびれるぐらいだからな」",
  "off": 1772,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1774,
  "text_len": 45
 },
