  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4902,
  "text_len": 15
 },
 {
  "id": "sce414:01339",
  "jp": "セリカ「‥‥あっ」",
  "off": 4921,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4923,
  "text_len": 11
 },
 {
  "id": "sce414:0134A",
  "jp": "セリカ「う、うん。またね」",
  "off": 4938,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4940,
  "text_len": 13
 },
 {
  "id": "sce414:01377",
  "jp": "ヤマト「ちょっと、ニャに‥‥あっ、まさか照れてるの？」",
  "off": 4983,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4985,
  "text_len": 31
 },
 {
  "id": "sce414:0139C",
  "jp": "トウヤ「‥‥うるさい」",
  "off": 5020,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5022,
  "text_len": 13
 },
 {
  "id": "sce414:013AF",
  "jp": "ヤマト「やれやれ‥‥ホント、ニャにやってんだか‥‥{nl}　中学生でももうちょっとはマシよ？{nl}　意識しすぎだって。もっと自然に接したほうがいいよ」",
  "off": 5039,
  "len": 86,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5041,
  "text_len": 83
 },
 {
