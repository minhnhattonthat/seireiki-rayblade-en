 },
 {
  "id": "sce414:01127",
  "jp": "トウヤ「ふぅーん。これって、なんだ？」",
  "off": 4391,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4393,
  "text_len": 21
 },
 {
  "id": "sce414:01142",
  "jp": "セリカ「‥‥聖霊機操者の訓練ように設計した{nl}　仮想戦闘訓練機よ。{nl}　ホラ、聖地でも同じようなのやったでしょ？」",
  "off": 4418,
  "len": 80,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4420,
  "text_len": 77
 },
 {
  "id": "sce414:01195",
  "jp": "トウヤ「あぁ、あれか」",
  "off": 4501,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4503,
  "text_len": 11
 },
 {
  "id": "sce414:011A6",
  "jp": "セリカ「これが使えるようになったらいい訓練にも{nl}　なるんだけどね」",
  "off": 4518,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4520,
  "text_len": 36
 },
 {
  "id": "sce414:011D0",
  "jp": "トウヤ「ダメなのか？」",
  "off": 4560,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4562,
  "text_len": 12
 },
 {
  "id": "sce414:011E2",
  "jp": "セリカ「正直、難しいわね。あとΞ人、技術者がいれば{nl}　なんとかなるかもしれないけど‥‥」",
  "off": 4578,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4580,
  "text_len": 54
 },
 {
  "id": "sce414:0121E",
  "jp": "トウヤ「そうか‥‥」",
  "off": 4638,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4640,
  "text_len": 12
 },
 {
  "id": "sce414:01230",
  "jp": "セリカ「だから、まあ、期待せずに待ってて」",
  "off": 4656,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4658,
  "text_len": 24
 },
 {
  "id": "sce414:0124E",
  "jp": "トウヤ「ああ、そうするよ」",
  "off": 4686,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4688,
  "text_len": 13
 },
 {
  "id": "sce414:01261",
  "jp": "ヤマト「トウヤ、セリカの邪魔にニャりそうだし、{nl}　そろそろ行こうよ」",
  "off": 4705,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4707,
  "text_len": 37
 },
 {
  "id": "sce414:0128C",
  "jp": "トウヤ「そうだな。邪魔したな」",
  "off": 4748,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4750,
  "text_len": 17
 },
 {
  "id": "sce414:012A3",
  "jp": "セリカ「いいよ。それじゃあね」",
  "off": 4771,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4773,
  "text_len": 15
 },
 {
  "id": "sce414:012C2",
  "jp": "セリカ「‥‥どうしたの？」",
  "off": 4802,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4804,
  "text_len": 16
 },
 {
  "id": "sce414:012D8",
  "jp": "トウヤ「あ、いや、別にこれといって‥‥」",
  "off": 4824,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4826,
  "text_len": 23
 },
 {
  "id": "sce414:012F5",
  "jp": "セリカ「そう‥‥」",
  "off": 4853,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4855,
  "text_len": 11
 },
