  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5193,
  "text_len": 11
 },
 {
  "id": "sce414:01458",
  "jp": "トウヤ「よ、よう」",
  "off": 5208,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5210,
  "text_len": 9
 },
 {
  "id": "sce414:01467",
  "jp": "セリカ「うん」",
  "off": 5223,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5225,
  "text_len": 7
 },
 {
  "id": "sce414:01474",
  "jp": "トウヤ「もしかして、今、忙しい？」",
  "off": 5236,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5238,
  "text_len": 20
 },
 {
  "id": "sce414:0148E",
  "jp": "セリカ「‥‥ううん。大丈夫」",
  "off": 5262,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5264,
  "text_len": 19
 },
 {
  "id": "sce414:014A7",
  "jp": "トウヤ「やっぱり気になってさ‥‥」",
  "off": 5287,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5289,
  "text_len": 20
 },
 {
  "id": "sce414:014C5",
  "jp": "セリカ「‥‥この前のこと？」",
