  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7165,
  "text_len": 27
 },
 {
  "id": "sce114:01C1C",
  "jp": "フェイン「なにを！　俺はいたって健康そのもの！{nl}　病気になるほど軟弱にはできていない！{nl}　だっはっはっはっ！」",
  "off": 7196,
  "len": 69,
