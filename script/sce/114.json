  "style": 0,
  "text_off": 5050,
  "text_len": 8
 },
 {
  "id": "sce114:013C6",
  "jp": "トウヤ「俺、お前に言われるまで忘れていた。{nl}　あの時だって、あそこまで言われてやっと‥‥」",
  "off": 5062,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5064,
  "text_len": 53
 },
 {
  "id": "sce114:01405",
  "jp": "カスミ「ううん。ちゃんと思い出してくれたもん。{nl}　それだけで十分だよ」",
  "off": 5125,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5127,
  "text_len": 39
 },
 {
  "id": "sce114:01432",
  "jp": "トウヤ「そ、そうか。{nl}　でもまあ、全然ロマンチックじゃなかったけどな」",
  "off": 5170,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5172,
  "text_len": 37
 },
 {
  "id": "sce114:0145D",
  "jp": "カスミ「‥‥ううん。そんなことないよ。{nl}{ctl:3C3E}{face:84FF10}　それに‥‥」",
  "off": 5213,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5215,
  "text_len": 39
 },
