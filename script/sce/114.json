  "off": 5258,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5260,
  "text_len": 10
 },
 {
  "id": "sce114:014A4",
  "jp": "カスミ「大切な思い出だから」",
  "off": 5284,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5286,
  "text_len": 18
 },
 {
  "id": "sce114:014BC",
  "jp": "トウヤ「思い出、か」",
  "off": 5308,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5310,
  "text_len": 12
 },
 {
  "id": "sce114:014D9",
  "jp": "カスミ「あっ‥‥え、えっと、そういう意味じゃなくて、{nl}　大切な思い出で、でもそれは終わったとかそういうんじゃ{nl}　なくて、まだこれからもたくさん思い出を作りたいって{nl}　思ってるし、それにこれで終わりとかしたくないし、{nl}　ずっと、ずっと終わりにしたくないって思ってるし、{nl}{ctl:3C3E}{face:841A02}{ctl:013E}{face:841903}{ctl:023E}{face:841907}　えっと、えっと‥‥」",
  "off": 5337,
  "len": 190,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5339,
  "text_len": 187
 },
