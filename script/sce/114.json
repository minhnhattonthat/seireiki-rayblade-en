  "len": 17,
  "en": "Fain: ...Huh?",
  "status": "translated",
  "style": 0,
  "text_off": 7036,
  "text_len": 14
 },
 {
  "id": "sce114:01B8E",
  "jp": "ヤマト「‥‥」",
