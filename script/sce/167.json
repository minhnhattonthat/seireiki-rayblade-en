[
 {
  "id": "sce167:00046",
  "jp": "イ<E1>ェル「‥‥たしかにライブレードは{nl}　＜ゼ＝オード＞と系譜を伺じくするものです。{nl}　ですが、戻#7EA題なのはライブレード自体ではなく、{nl}　それを操る人間の意志なのです。{nl}　力はそれを使う者によって善にも悪にもなるのですから」",
  "off": 70,
  "len": 138,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 72,
  "text_len": 135
 },
 {
  "id": "sce167:000D3",
  "jp": "ユミール「‥‥どうして秘密にされていたのですか？」",
  "off": 211,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 213,
  "text_len": 31
 },
 {
  "id": "sce167:000F8",
  "jp": "イ<E1>ェル「無揖な混乱を避けるためです。{nl}　ですが、理由がどうであれ、あなたたちに黙っていたことは{nl}　謝ります。すみませんでした」",
  "off": 248,
  "len": 76,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 250,
  "text_len": 73
 },
 {
  "id": "sce167:00147",
  "jp": "トウヤ「そのことはどれだけの人間が知ってるんですか？」",
  "off": 327,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 329,
  "text_len": 31
 },
 {
  "id": "sce167:0016C",
  "jp": "イ<E1>ェル「ここにいる全員を除いては誰も。{nl}　私自身29年前、ライブレードを託されるまで{nl}　知らなかったのですから」",
  "off": 364,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 366,
  "text_len": 69
 },
 {
  "id": "sce167:001B7",
  "jp": "ユミール「29年‥‥以前にもそんなことをおっしゃって{nl}　おられましたが、その時にいったいなにがあったのですか？」",
  "off": 439,
  "len": 67,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 441,
  "text_len": 64
 },
 {
  "id": "sce167:001FD",
  "jp": "イ<E1>ェル「‥‥」",
  "off": 509,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 511,
  "text_len": 10
 },
 {
  "id": "sce167:0020D",
  "jp": "ユミール「イ<E1>ェル様？」",
  "off": 525,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 527,
  "text_len": 15
 },
 {
  "id": "sce167:00222",
  "jp": "イ<E1>ェル「‥‥29年前、私はある女性から{nl}　ライブレードを託されました。{nl}　彼女は80年前に存在していた人物でした」",
  "off": 546,
  "len": 78,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 548,
  "text_len": 75
 },
 {
  "id": "sce167:00273",
  "jp": "トウヤ「‥‥ということは今から109年前‥‥」",
  "off": 627,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 629,
  "text_len": 30
 },
 {
  "id": "sce167:00297",
  "jp": "アイ「え？　ということは‥‥」",
  "off": 663,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 665,
  "text_len": 18
 },
 {
  "id": "sce167:002AF",
  "jp": "イ<E1>ェル「彼女の名はウェニマス・ラティーア。{nl}　109年前、バフレッド・デビッシュの計画に反対し、{nl}　戦いを挑んだ人物です」",
  "off": 687,
  "len": 79,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 689,
  "text_len": 76
 },
 {
  "id": "sce167:00301",
  "jp": "アーサー「なるほど。レニス博止と伺じく、他の方々より{nl}　前の時間へ跳んできたということですか‥‥」",
  "off": 769,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 771,
  "text_len": 62
 },
 {
  "id": "sce167:00345",
  "jp": "イ<E1>ェル「ええ。はじめはなにも語ってはくれませんでしたが、{nl}　半年ほどしたある廿、他の＜ゼ＝オード＞の{nl}　研究者達が未来へ跳んでいる可能性を示唆し、{nl}　ライブレードの隠し場所を私に田えると{nl}　姿を梢してしまったのです」",
  "off": 837,
  "len": 141,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 839,
  "text_len": 138
 },
 {
  "id": "sce167:003D5",
  "jp": "セリカ「初耳ですね。ということはウェニマス博止を{nl}　かくまわれていたことは誰にも報告なさらなかった{nl}　ということですね」",
  "off": 981,
  "len": 70,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 983,
  "text_len": 67
 },
 {
  "id": "sce167:0041E",
  "jp": "イ<E1>ェル「はい。彼女が計画阻止#4FDのために戦ったとは{nl}　いえ、それは諸説の一つにしかすぎず、依然、{nl}　＜ゼ＝オード＞の研究者の一人であるという認識が{nl}　強い状態でした。{nl}　これは今でもあまりかわっていませんし、彼女の存在が{nl}　明るみにでることは避けたかったのです」",
  "off": 1054,
  "len": 166,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1056,
  "text_len": 163
 },
 {
  "id": "sce167:004C7",
  "jp": "トウヤ「え？　ウェニマスとレニスは{nl}　いい貰で見られていたワケじゃなかったのか？」",
  "off": 1223,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1225,
  "text_len": 45
 },
 {
  "id": "sce167:004FA",
  "jp": "アイ「あたしに訊かないでよ」",
  "off": 1274,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1276,
  "text_len": 15
 },
 {
  "id": "sce167:0050F",
  "jp": "イ<E1>ェル「世間的にはほぼ他の研究者達と伺列に{nl}　思われています。事実、あの爆発が起こったのですから。{nl}　ですが、私は彼女の貰をみたとき、{nl}　彼女が審にこの世界の平和を望んでいることを{nl}　知りました。だから誰にも告げることはしなかったのです」",
  "off": 1295,
  "len": 154,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1297,
  "text_len": 151
 },
 {
  "id": "sce167:005AC",
  "jp": "ユミール「でも詳しいことは話してくれなかった‥‥」",
  "off": 1452,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1454,
  "text_len": 30
 },
 {
  "id": "sce167:005D0",
  "jp": "イ<E1>ェル「ええ。自分一人で解決するつもりだったの{nl}　でしょう」",
  "off": 1488,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1490,
  "text_len": 37
 },
 {
  "id": "sce167:005FB",
  "jp": "ユミール「なら、どうして半年後に‥‥」",
  "off": 1531,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1533,
  "text_len": 25
 },
 {
  "id": "sce167:0061A",
  "jp": "イ<E1>ェル「‥‥彼女の体調の戻#7EA題です。{nl}　廻復して、すぐにここを去り、捜索のかいもなく、{nl}　現在に至っています」",
  "off": 1562,
  "len": 74,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1564,
  "text_len": 71
 },
 {
  "id": "sce167:00667",
  "jp": "ユミール「そう、ですか‥‥」",
  "off": 1639,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1641,
  "text_len": 17
 },
 {
  "id": "sce167:0067E",
  "jp": "イ<E1>ェル「‥‥トウヤさん。アルフォリナ女王があなたに{nl}　共鳴結晶を託し、ライブレードもあなたを選びました。{nl}　これは彼女の、ウェニマスが去り際に言っていた、{nl}　“やがて来る時”であると思っています。{nl}　すべての出来事は29年前のあの廿にはじまり、{nl}　そして今、終息に徇かっていると確信しています。{nl}　‥‥他のみなさんも伺じです。{nl}　この時、この場所にみなさんが集結したのは{nl}　天の導きによるものなのかもしれません。{nl}　どうか、この世界を救ってください。{nl}　お願いします‥‥」",
  "off": 1662,
  "len": 290,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1664,
  "text_len": 287
 },
 {
  "id": "sce167:007A3",
  "jp": "クロビス「ま、まぁ、どこまでできるかわからないが、{nl}　全力はつくしますよ」",
  "off": 1955,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1957,
  "text_len": 39
 },
 {
  "id": "sce167:007D0",
  "jp": "アーサー「我々の力がこの世界のお役にたてるのなら{nl}　喜んで。もとよりそのつもりでしたし‥‥ね、トウヤ？」",
  "off": 2000,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2002,
  "text_len": 63
 },
 {
  "id": "sce167:00815",
  "jp": "トウヤ「あ、ああ‥‥{nl}　だが、これからは隠し事はなしにしてくれよ」",
  "off": 2069,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2071,
  "text_len": 37
 },
 {
  "id": "sce167:00840",
  "jp": "イ<E1>ェル「‥‥すみませんでした」",
  "off": 2112,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2114,
  "text_len": 18
 },
 {
  "id": "sce167:00858",
  "jp": "アイ「とにかくライブレードが＜ゼ＝オード＞だったとしても{nl}　今までのことが嘘になるワケじゃないし、{nl}　なにも変らないでしょ？」",
  "off": 2136,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2138,
  "text_len": 72
 },
 {
  "id": "sce167:008A6",
  "jp": "トウヤ「まぁ、な。要は俺達の心の持ちようなんだろうな」",
  "off": 2214,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2216,
  "text_len": 32
 },
 {
  "id": "sce167:008CC",
  "jp": "アイ「だったらこれまで通りやっていくだけね」",
  "off": 2252,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2254,
  "text_len": 23
 },
 {
  "id": "sce167:008E9",
  "jp": "イ<E1>ェル「とりあえず今廿のところは{nl}　みなさんも　お疲れでしょう。{nl}　アガルティア王麹のこともありますが、{nl}　今、こちらも使者を派遣して徇こうの出方を{nl}　さぐっているところです。{nl}　明廿にはそのあたりの話もできるでしょう」",
  "off": 2281,
  "len": 130,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2283,
  "text_len": 127
 },
 {
  "id": "sce167:0096E",
  "jp": "アーサー「イ<E1>ェル様は陛下の行動、どう思われますか？」",
  "off": 2414,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2416,
  "text_len": 36
 },
 {
  "id": "sce167:00998",
  "jp": "イ<E1>ェル「本心ではないでしょうね。{nl}　でも本心であろうと演じているように思えます。{nl}　今のところは推測だけですが」",
  "off": 2456,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2458,
  "text_len": 66
 },
 {
  "id": "sce167:009E0",
  "jp": "シィウチェン「とにかく、すべては明廿だ。{nl}　今廿は休むとしよう」",
  "off": 2528,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2530,
  "text_len": 37
 },
 {
  "id": "sce167:00A0B",
  "jp": "トウヤ「そうだな‥‥」",
  "off": 2571,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2573,
  "text_len": 13
 },
 {
  "id": "sce167:00A34",
  "jp": "イ<E1>ェル「‥‥どうしました？　{nl}　みなさんと一緒に行かないのですか？」",
  "off": 2612,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2614,
  "text_len": 42
 },
 {
  "id": "sce167:00A64",
  "jp": "ユミール「‥‥イ<E1>ェル様。先程の戦いで敵の一人が{nl}　私を見てウェニマスとつぶやきました。{nl}　私はそれほど似ているのですか？」",
  "off": 2660,
  "len": 80,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2662,
  "text_len": 77
 },
 {
  "id": "sce167:00AB7",
  "jp": "イ<E1>ェル「どういう意味ですか？」",
  "off": 2743,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2745,
  "text_len": 19
 },
 {
  "id": "sce167:00AD0",
  "jp": "ユミール「彼はこうも言っていました。奴との子供と。{nl}　イ<E1>ェル様、私は本当にクラシオの家に生まれた{nl}　子供なのですか？」",
  "off": 2768,
  "len": 78,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2770,
  "text_len": 75
 },
 {
  "id": "sce167:00B21",
  "jp": "イ<E1>ェル「‥‥」",
  "off": 2849,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2851,
  "text_len": 10
 },
 {
  "id": "sce167:00B31",
  "jp": "ユミール「どうして私だけ髪の色が異なるのでしょうか。{nl}　答えてください」",
  "off": 2865,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2867,
  "text_len": 42
 },
 {
  "id": "sce167:00B61",
  "jp": "イ<E1>ェル「‥‥」",
  "off": 2913,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2915,
  "text_len": 10
 },
 {
  "id": "sce167:00B71",
  "jp": "ユミール「イ<E1>ェル様！」",
  "off": 2929,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2931,
  "text_len": 15
 },
 {
  "id": "sce167:00B86",
  "jp": "イ<E1>ェル「‥‥ユミール‥‥あなたの思っているとおりです。{nl}　あなたはウェニマスの娘です」",
  "off": 2950,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2952,
  "text_len": 51
 },
 {
  "id": "sce167:00BBF",
  "jp": "ユミール「そう、ですか‥‥ウェニマス博止が半年の間、{nl}　ここに留まったのは私を産むため‥‥」",
  "off": 3007,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3009,
  "text_len": 59
 },
 {
  "id": "sce167:00C00",
  "jp": "イ<E1>ェル「そうです。そして、彼女はあなたを私に預け、{nl}　去ったのです。あなたを＜ゼ＝オード＞の研究者の{nl}　娘ではなく、普通の女の子として暮らせるように」",
  "off": 3072,
  "len": 97,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3074,
  "text_len": 94
 },
 {
  "id": "sce167:00C64",
  "jp": "ユミール「‥‥」",
  "off": 3172,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3174,
  "text_len": 11
 },
 {
  "id": "sce167:00C75",
  "jp": "イ<E1>ェル「ユミール‥‥」",
  "off": 3189,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3191,
  "text_len": 15
 },
 {
  "id": "sce167:00C8A",
  "jp": "ユミール「この身体に私の中に‥‥{nl}　＜ゼ＝オード＞の研究者の血が‥‥私は‥‥」",
  "off": 3210,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3212,
  "text_len": 59
 },
 {
  "id": "sce167:00CCB",
  "jp": "イ<E1>ェル「ユミール。ウェニマスが、あなたの母親が{nl}　いたからこそあの程度で済んだのですよ。{nl}　それはあなたも知っているでしょ？」",
  "off": 3275,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3277,
  "text_len": 72
 },
 {
  "id": "sce167:00D19",
  "jp": "ユミール「でも‥‥すみません。{nl}　なんだか頭が混乱して‥‥{nl}　少し、休ませていただきます‥‥」",
  "off": 3353,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3355,
  "text_len": 59
 },
 {
  "id": "sce167:00D5A",
  "jp": "イ<E1>ェル「ユミール‥‥」",
  "off": 3418,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3420,
  "text_len": 15
 },
 {
  "id": "sce167:00D90",
  "jp": "トウヤ「どうだった？」",
  "off": 3472,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3474,
  "text_len": 12
 },
 {
  "id": "sce167:00DA2",
  "jp": "カスミ「ううん。どこにもいないわ」",
  "off": 3490,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3492,
  "text_len": 17
 },
 {
  "id": "sce167:00DB9",
  "jp": "アイ「こっちも。あの子、どこ行っちゃったのかしら？」",
  "off": 3513,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3515,
  "text_len": 29
 },
 {
  "id": "sce167:00DDC",
  "jp": "ヤマト「ねぇ、戦闘中、別の＜ゼ＝オード＞が{nl}　現れたって言ってたでしょ。あたしその時みたの。{nl}　誰かがリーボーフェンから飛び降りて、{nl}　そこに　＜ゼ＝オード＞が現れ、逃げていったのを」",
  "off": 3548,
  "len": 117,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3550,
  "text_len": 114
 },
 {
  "id": "sce167:00E54",
