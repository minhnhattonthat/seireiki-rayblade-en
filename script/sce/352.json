  "text_off": 7301,
  "text_len": 10
 },
 {
  "id": "sce352:01C93",
  "jp": "クルル「‥‥もぅ、遅いぃ！　待ちくたびれちゃう{nl}　ところだったよぉ？」",
  "off": 7315,
  "len": 44,
  "en": "",
