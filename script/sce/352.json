 },
 {
  "id": "sce352:0057C",
  "jp": "トウヤ「‥‥あ、ああ。ただいま」",
  "off": 1404,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1406,
  "text_len": 18
 },
 {
  "id": "sce352:005B0",
  "jp": "トウヤ「ウェニマス‥‥{nl}　おい、これどういうことだ？{nl}　俺は‥‥今までのことは夢だったのか？」",
  "off": 1456,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1458,
  "text_len": 56
 },
 {
  "id": "sce352:005EE",
  "jp": "ウェニマス「いいえ。すべて現実よ。{nl}　そして、あなたの活躍で<E1>ォーリアは滅びたわ」",
  "off": 1518,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1520,
  "text_len": 47
 },
 {
  "id": "sce352:00623",
  "jp": "トウヤ「滅びた‥‥それじゃ、俺達は勝ったのか？」",
  "off": 1571,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1573,
  "text_len": 31
 },
 {
  "id": "sce352:00648",
  "jp": "ウェニマス「ええ」",
  "off": 1608,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1610,
  "text_len": 9
 },
 {
  "id": "sce352:00657",
  "jp": "トウヤ「そう、か‥‥勝ったか‥‥」",
  "off": 1623,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1625,
  "text_len": 22
 },
 {
  "id": "sce352:00673",
  "jp": "ウェニマス「ありがとう。{nl}　あなたのおかげでアガルティアは‥‥いえ、{nl}　この世界も救われたわ‥‥」",
  "off": 1651,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1653,
  "text_len": 56
 },
 {
  "id": "sce352:006B1",
  "jp": "トウヤ「俺だけの力じゃねぇよ。{nl}　みんなの想いがあったからだ。{nl}　信じる仲間達のな」",
  "off": 1713,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1715,
  "text_len": 49
 },
 {
  "id": "sce352:006E8",
  "jp": "ウェニマス「ふふふ‥‥そうですね」",
  "off": 1768,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1770,
  "text_len": 19
 },
 {
  "id": "sce352:00701",
  "jp": "トウヤ「それより、ここはどうなってやがるんだ？{nl}　俺がアガルティアへ行く前の光景と同じだが‥‥」",
  "off": 1793,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1795,
  "text_len": 57
 },
 {
  "id": "sce352:00740",
  "jp": "ウェニマス「こちらの世界では時間は{nl}　経過していないの」",
  "off": 1856,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1858,
  "text_len": 34
 },
 {
  "id": "sce352:00768",
  "jp": "トウヤ「‥‥どういうことだ？」",
  "off": 1896,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1898,
  "text_len": 18
 },
 {
  "id": "sce352:00780",
  "jp": "ウェニマス「あなたがこれまでいた所はすべて{nl}　“平行宇宙”よ。{nl}　そこから元の宇宙へ戻って来たの」",
  "off": 1920,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1922,
  "text_len": 61
 },
 {
  "id": "sce352:007C3",
  "jp": "トウヤ「平行宇宙？」",
  "off": 1987,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1989,
  "text_len": 15
 },
 {
  "id": "sce352:007D8",
  "jp": "ウェニマス「量子のパラドックスを説明する存在。{nl}　状態ベクトルの確率的ゆらぎを“すべての確率的{nl}　場合”が実在しているとし、{nl}　この宇宙は無限次元空間である{nl}　“多次元宇宙”の一部にすぎないという考えよ。{nl}　それは物理学的な実在としてあるのではなく、{nl}　我々人間の主観の限界にすぎないということ。{page}　つまり人間には認識できないだけでそこに存在する{nl}　世界があるということよ」",
  "off": 2008,
  "len": 249,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2010,
  "text_len": 246
 },
 {
  "id": "sce352:008D4",
  "jp": "トウヤ「‥‥」",
  "off": 2260,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2262,
  "text_len": 9
 },
 {
  "id": "sce352:008E3",
  "jp": "ウェニマス「う～ん‥‥そうねぇ‥‥」",
  "off": 2275,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2277,
  "text_len": 23
 },
 {
  "id": "sce352:00900",
  "jp": "トウヤ「いや、もういいよ。{nl}　とにかく、俺の住んでいた世界とは別に{nl}　複数の世界があるってことだろ？」",
  "off": 2304,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2306,
  "text_len": 61
 },
 {
  "id": "sce352:00943",
  "jp": "ウェニマス「ま、まぁ、そういうことね」",
  "off": 2371,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2373,
  "text_len": 19
 },
 {
  "id": "sce352:0095C",
  "jp": "トウヤ「それじゃ、カスミがいた世界というのもまた{nl}　別の世界ということか？」",
  "off": 2396,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2398,
  "text_len": 44
 },
 {
  "id": "sce352:0098E",
  "jp": "ウェニマス「ええ。さっきも言ったけど、{nl}　この世界で起こりうるあらゆる可能性の数だけ{nl}　世界があるの」",
  "off": 2446,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2448,
  "text_len": 61
 },
 {
  "id": "sce352:009D1",
  "jp": "トウヤ「それじゃ、アガルティアも‥‥」",
  "off": 2513,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2515,
  "text_len": 21
 },
 {
  "id": "sce352:009EC",
  "jp": "ウェニマス「いえ、少し違うわ。平行世界なら、{nl}　必ず本人と対となるべき存在がいるの。{nl}　でもアガルティアにはいなかったでしょ？{nl}　あそこはこの世界と別の世界の狭間にある世界なの」",
  "off": 2540,
  "len": 114,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2542,
  "text_len": 111
 },
 {
  "id": "sce352:00A61",
  "jp": "トウヤ「‥‥あんた、どこまで知っていたんだ‥‥？」",
  "off": 2657,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2659,
  "text_len": 31
 },
 {
  "id": "sce352:00A86",
  "jp": "ウェニマス「意識を解放したとき、{nl}　宇宙の意志というべき存在に触れたのかもね。{page}　でも私には自分がどのようなことができて、{nl}　どういう力をもったのかわからないの。{page}　ただ、アガルティアを救いたいと強く願った時、{nl}　自分がなにをすべきかがわかっただけ。{nl}　そしてそのとおりに行動したの。{page}　結果的にあなた達を利揖したことになった‥‥」",
  "off": 2694,
  "len": 200,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2696,
  "text_len": 197
 },
 {
  "id": "sce352:00B51",
  "jp": "トウヤ「でも、あらゆる確率の世界が存在するなら、{nl}　こんなことをしなくてもよかったってことにならねぇか？」",
  "off": 2897,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2899,
  "text_len": 60
 },
 {
  "id": "sce352:00B93",
  "jp": "ウェニマス「それは違うわ。世界は存在するけど、{nl}　その世界はそれぞれの世界の中で完結しているの。{page}　だから、他の世界があったとしてもその世界の中で{nl}　起こることはそのまま時間として積み讐ねられていくわ。{page}　私はただ、アガルティア世界を救うために他の世界の{nl}　協力者を集めただけ」",
  "off": 2963,
  "len": 176,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2965,
  "text_len": 173
 },
 {
  "id": "sce352:00C46",
  "jp": "トウヤ「てぇことは俺がいたあのアガルティア世界は{nl}　“救われた”確率の世界として{nl}　進み始めたってことか？」",
  "off": 3142,
  "len": 70,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3144,
  "text_len": 67
 },
 {
  "id": "sce352:00C8F",
  "jp": "ウェニマス「ええ。そしてあなたは本来いるべき世界に{nl}　帰って来たの」",
  "off": 3215,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3217,
  "text_len": 40
 },
 {
  "id": "sce352:00CBD",
  "jp": "トウヤ「それじゃ、クルルは、みんなはどうなったんだ？」",
  "off": 3261,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3263,
  "text_len": 28
 },
 {
  "id": "sce352:00CDF",
  "jp": "ウェニマス「大丈夫。クルルちゃんもアガルティア世界に{nl}　帰ったわ。それにみんなも無事よ」",
  "off": 3295,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3297,
  "text_len": 52
 },
 {
  "id": "sce352:00D19",
  "jp": "トウヤ「‥‥そうか‥‥‼{nl}　お、おい‥‥まさか、みんなはこの世界ではなく、{nl}　別の世界の住人だったんじゃねぇだろうな‥‥」",
  "off": 3353,
  "len": 80,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3355,
  "text_len": 77
 },
 {
  "id": "sce352:00D6C",
  "jp": "ウェニマス「フフフ‥‥」",
  "off": 3436,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3438,
  "text_len": 14
 },
 {
  "id": "sce352:00D80",
  "jp": "トウヤ「笑いごとじゃねぇぞ！　もしそうなら、{nl}　この世界のクルルは俺のことなんか知らないってことに{nl}　ならねぇのか⁈」",
  "off": 3456,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3458,
  "text_len": 66
 },
 {
  "id": "sce352:00DC8",
  "jp": "ウェニマス「フフフ‥‥大丈夫よ。{nl}　この世界の人よ。だから心配しないで」",
  "off": 3528,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3530,
  "text_len": 46
 },
 {
  "id": "sce352:00DFC",
  "jp": "トウヤ「そ、そうか‥‥」",
  "off": 3580,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3582,
  "text_len": 14
 },
 {
  "id": "sce352:00E10",
  "jp": "ウェニマス「あっ‥‥ごめんなさい。{nl}　そろそろ私も行かないと‥‥」",
  "off": 3600,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3602,
  "text_len": 39
 },
 {
  "id": "sce352:00E3D",
  "jp": "トウヤ「‥‥行くってどこへ？」",
  "off": 3645,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3647,
  "text_len": 19
 },
 {
  "id": "sce352:00E56",
  "jp": "ウェニマス「愛する人のもとへ‥‥」",
  "off": 3670,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3672,
  "text_len": 21
 },
 {
  "id": "sce352:00E71",
  "jp": "トウヤ「？」",
  "off": 3697,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3699,
  "text_len": 7
 },
 {
  "id": "sce352:00E92",
  "jp": "ウェニマス「‥‥本当にありがとう。{nl}　私の愛した世界は救われた‥‥あの人も‥‥」",
  "off": 3730,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3732,
  "text_len": 54
 },
 {
  "id": "sce352:00ECE",
  "jp": "トウヤ「‥‥そうか。それじゃお別れだな」",
  "off": 3790,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3792,
  "text_len": 23
 },
 {
  "id": "sce352:00EEB",
  "jp": "ウェニマス「ええ。それじゃ‥‥」",
  "off": 3819,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3821,
  "text_len": 18
 },
 {
  "id": "sce352:00F03",
  "jp": "トウヤ「ああ‥‥」",
  "off": 3843,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3845,
  "text_len": 11
 },
 {
  "id": "sce352:00F39",
  "jp": "綾華「おはよう。風見透夜クン」",
  "off": 3897,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3899,
  "text_len": 21
 },
 {
  "id": "sce352:00F54",
  "jp": "透夜「おはようごさいます、先生」",
  "off": 3924,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3926,
  "text_len": 20
 },
 {
  "id": "sce352:00F6E",
  "jp": "綾華「‥‥堂々としたものね？」",
  "off": 3950,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3952,
  "text_len": 21
 },
 {
  "id": "sce352:00F89",
  "jp": "透夜「すみません。以後気をつけます」",
  "off": 3977,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3979,
  "text_len": 23
 },
 {
  "id": "sce352:00FA6",
  "jp": "綾華「そ、そう‥‥だったらお願いね。{nl}　あと、次からは起きてから言ってね」",
  "off": 4006,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4008,
  "text_len": 45
 },
 {
  "id": "sce352:00FD9",
  "jp": "透夜「はぁ‥‥」",
  "off": 4057,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4059,
  "text_len": 12
 },
 {
  "id": "sce352:01005",
  "jp": "　こうして俺の戦いは終わった。",
  "off": 4101,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4103,
  "text_len": 18
 },
 {
  "id": "sce352:0102A",
  "jp": "　アガルティアで過ごした日々は大切な思い出となり、{nl}{ctl:5A3E}　そこで出会った人々はかけがえのない友となった。{nl}{ctl:5A3E}　みんながどうなったのか俺にはわからない。",
  "off": 4138,
  "len": 92,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4140,
  "text_len": 89
 },
 {
  "id": "sce352:0108A",
  "jp": "　ただ、きっとこの青い空と同じ様に{nl}{ctl:5A3E}　晴れ晴れとした気持ちでいるだろう‥‥{nl}{ctl:5A3E}　なぜか、そう思えた。{nl}　再びはじまるありふれた日常と新しくはじまった日常‥‥{nl}{ctl:5A3E}　退屈だったそれも今は輝いてみえる。{nl}{ctl:5A3E}　なぜなら‥‥",
  "off": 4234,
  "len": 144,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4236,
  "text_len": 141
 },
 {
  "id": "sce352:01141",
  "jp": "ヤマト「おはよ、透夜！」",
  "off": 4417,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4419,
  "text_len": 15
 },
 {
  "id": "sce352:01156",
  "jp": "透夜「あ、ああ‥‥おはよう」",
  "off": 4438,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4440,
  "text_len": 18
 },
 {
  "id": "sce352:01178",
  "jp": "晃一郎「おはよう、透夜」",
  "off": 4472,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4474,
  "text_len": 17
 },
 {
  "id": "sce352:0118F",
  "jp": "透夜「おはよう‥‥って、なんでお前がいんだよ⁉」",
  "off": 4495,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4497,
  "text_len": 30
 },
 {
  "id": "sce352:011B3",
  "jp": "晃一郎「まぁ、立ち話もなんだから、座ろうよ」",
  "off": 4531,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4533,
  "text_len": 28
 },
 {
  "id": "sce352:011D7",
  "jp": "佳澄美「はいどうぞ」",
  "off": 4567,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4569,
  "text_len": 13
 },
 {
  "id": "sce352:011EA",
  "jp": "晃一郎「あ、おかまいなく‥‥」",
  "off": 4586,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4588,
  "text_len": 20
 },
 {
  "id": "sce352:01204",
  "jp": "透夜「だぁーっ！　俺の家で和むなーっ！」",
  "off": 4612,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4614,
  "text_len": 29
 },
 {
  "id": "sce352:01227",
  "jp": "晃一郎「なにぷんぷんしてるんだい？{nl}　カルシウムが足りないんだね。{nl}　現代人は不足がちだっていわれてるしね」",
  "off": 4647,
  "len": 67,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4649,
  "text_len": 64
 },
 {
  "id": "sce352:0126D",
  "jp": "佳澄美「まぁまぁ、いいじゃない透夜ちゃん。{nl}　晃一郎君も心配して来てくれてるのよ？{nl}　ホラ座って」",
  "off": 4717,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4719,
  "text_len": 63
 },
 {
  "id": "sce352:012B2",
  "jp": "透夜「あ、ああ‥‥」",
  "off": 4786,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4788,
  "text_len": 14
 },
 {
  "id": "sce352:012C6",
  "jp": "ヤマト「もぅ、肘をついて食べニャいの！」",
  "off": 4806,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4808,
  "text_len": 23
 },
 {
  "id": "sce352:012E3",
  "jp": "透夜「へいへい」",
  "off": 4835,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4837,
  "text_len": 10
 },
 {
  "id": "sce352:012F3",
  "jp": "ヤマト「迷い箸はダメ！」",
  "off": 4851,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4853,
  "text_len": 15
 },
 {
  "id": "sce352:01308",
  "jp": "透夜「‥‥」",
  "off": 4872,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4874,
  "text_len": 10
 },
 {
  "id": "sce352:01318",
  "jp": "ヤマト「音を立ててお味噌汁を飲まニャい！」",
  "off": 4888,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4890,
  "text_len": 28
 },
 {
  "id": "sce352:0133A",
  "jp": "透夜「だぁーっ！　メシぐらい好きに食わせろよな！」",
  "off": 4922,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4924,
  "text_len": 32
 },
 {
  "id": "sce352:01360",
  "jp": "ヤマト「ダメ。今のまんまじゃ恥ずかしくて人様の前に{nl}　出せニャいわ」",
  "off": 4960,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4962,
  "text_len": 40
 },
 {
  "id": "sce352:0138E",
  "jp": "透夜「うっせーなぁ‥‥」",
  "off": 5006,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5008,
  "text_len": 17
 },
 {
  "id": "sce352:013A5",
  "jp": "ヤマト「ニャに⁈　その口の聞き方⁉」",
  "off": 5029,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5031,
  "text_len": 23
 },
 {
  "id": "sce352:013C2",
  "jp": "透夜「なんだよ！」",
  "off": 5058,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5060,
  "text_len": 12
 },
 {
  "id": "sce352:013D4",
  "jp": "晃一郎「‥‥透夜も佳澄美ちゃんも{nl}　異世界へ行っていたなんてね。{page}　正直、まだ信じきれない部分があるけど、{nl}　こうやってしゃべるヤマトちゃんを見ると{nl}　本当だったんだなぁって思えるよ」",
  "off": 5076,
  "len": 118,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5078,
  "text_len": 115
 },
 {
  "id": "sce352:0144D",
  "jp": "佳澄美「うふふふ‥‥そうだね。私も透夜ちゃんも{nl}　不思議な体験をしたけど、この世界のみんなに{nl}　とっては一瞬の出来事だったしね」",
  "off": 5197,
  "len": 87,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5199,
  "text_len": 84
 },
 {
  "id": "sce352:014A7",
  "jp": "透夜「そうそう。それだ。{nl}　本当に校庭でゼイフォンの戦いを見なかったのか？」",
  "off": 5287,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5289,
  "text_len": 47
 },
 {
  "id": "sce352:014DC",
  "jp": "晃一郎「嘘言ってどうするんだよ。{nl}　透夜達が戻って来たのは4月8日の金曜日。{nl}　授業初日の1限目。それは間違いないよ」",
  "off": 5340,
  "len": 85,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5342,
  "text_len": 82
 },
 {
  "id": "sce352:01534",
  "jp": "佳澄美「不思議よね。私も校庭でゼイフォンと{nl}　ライブレードが戦っていたなんて知らないし‥‥」",
  "off": 5428,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5430,
  "text_len": 60
 },
 {
  "id": "sce352:01576",
  "jp": "晃一郎「結局、透夜が異常な体験をした日、{nl}　つまり4月8日の金曜日から、僕達との記憶が{nl}　異なったワケで、戻って来たのはその同じ日‥‥{nl}　ほころびた時間の輪が元どおりに繋がったってとこかな？{nl}　でも、巨大ロボットか‥‥僕も選ばれたかったなぁ‥‥{nl}　ねぇ、もうそこには行けないの？」",
  "off": 5494,
  "len": 187,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5496,
  "text_len": 184
 },
 {
  "id": "sce352:01634",
  "jp": "佳澄美「また、そんなこと言ってる‥‥{nl}　そんなことより、早く食べないと冷めちゃうよ？」",
  "off": 5684,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5686,
  "text_len": 53
 },
 {
  "id": "sce352:0166F",
  "jp": "晃一郎「それもそうだね。過ぎた過去のことより、{nl}　今日の朝ご飯の方が大切だよね。それじゃ、さっそく{nl}　このメザシを‥‥はい、透夜、あぁ～ん‥‥」",
  "off": 5743,
  "len": 95,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5745,
  "text_len": 92
 },
 {
  "id": "sce352:016D1",
  "jp": "透夜「お、おい！　やめろって！」",
  "off": 5841,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5843,
  "text_len": 20
 },
 {
  "id": "sce352:016EB",
  "jp": "晃一郎「もぅ、なにを恥ずかしがってるんだよぉ？{nl}　僕と透夜の仲じゃないか‥‥」",
  "off": 5867,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5869,
  "text_len": 50
 },
 {
  "id": "sce352:01723",
  "jp": "透夜「妄想の世界を創るんじゃねぇ」",
  "off": 5923,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5925,
  "text_len": 24
 },
 {
  "id": "sce352:01741",
  "jp": "晃一郎「ひ、ひどい‥‥僕のこと‥‥遊びだったの‥‥」",
  "off": 5953,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5955,
  "text_len": 37
 },
 {
  "id": "sce352:0176C",
  "jp": "透夜「‥‥殴るぞ？」",
  "off": 5996,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5998,
  "text_len": 16
 },
 {
  "id": "sce352:01782",
  "jp": "晃一郎「もぅ～軽いジョークじゃないか」",
  "off": 6018,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6020,
  "text_len": 25
 },
 {
  "id": "sce352:017A1",
  "jp": "透夜「‥‥お前がするとシャレになんねぇからやめてくれ」",
  "off": 6049,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6051,
  "text_len": 32
 },
 {
  "id": "sce352:017C7",
  "jp": "佳澄美「はいはい。それぐらいにしたら？{nl}　今日は大事な日なんでしょ。ね、透夜ちゃん？」",
  "off": 6087,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6089,
  "text_len": 55
 },
 {
  "id": "sce352:01804",
  "jp": "透夜「え？　お、おう」",
  "off": 6148,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6150,
  "text_len": 14
 },
 {
  "id": "sce352:0181F",
  "jp": "佳澄美「あっ、噂をすれば‥‥」",
  "off": 6175,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6177,
  "text_len": 21
 },
 {
  "id": "sce352:0183A",
  "jp": "透夜「ん？　早いな‥‥揖意なんか‥‥」",
  "off": 6202,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6204,
  "text_len": 29
 },
 {
  "id": "sce352:0185D",
  "jp": "晃一郎「‥‥はい」",
  "off": 6237,
