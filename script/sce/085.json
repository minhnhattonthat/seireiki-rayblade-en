  "style": 0,
  "text_off": 175,
  "text_len": 16
 },
 {
  "id": "sce085:000C3",
  "jp": "カスミ「ううん。なんでもない。入って、入って」",
  "off": 195,
  "len": 28,
  "en": "Kasumi: Oh, nothing. Come in, come in.",
  "status": "translated",
  "style": 0,
  "text_off": 197,
  "text_len": 25
 },
 {
  "id": "sce085:000E2",
