[
 {
  "id": "sce039:00061",
  "jp": "ローディス「‥‥すまない。君達に苦労をかけてばかりだな」",
  "off": 97,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 99,
  "text_len": 35
 },
 {
  "id": "sce039:0008A",
  "jp": "トウヤ「いいって。それより、そっちはどうなんだ？」",
  "off": 138,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 140,
  "text_len": 26
 },
 {
  "id": "sce039:000AA",
  "jp": "ローディス「軽傷者が数人いただけで、{nl}　それ以上の被害は王宮の一部が壊れたぐらいだ。{nl}　ティックスも無事だよ」",
  "off": 170,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 172,
  "text_len": 72
 },
 {
  "id": "sce039:000F8",
  "jp": "セリカ「よかった‥‥」",
  "off": 248,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 250,
  "text_len": 13
 },
 {
  "id": "sce039:0010B",
  "jp": "ローディス「今は気分がすぐれないみたいで、{nl}　自室で寝ているがね」",
  "off": 267,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 269,
  "text_len": 40
 },
 {
  "id": "sce039:00139",
  "jp": "ユミール「ご無事でなによりでした。{nl}　こちらのことは心配いりません。麹内の安定を{nl}　第一に考えてください」",
  "off": 313,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 315,
  "text_len": 65
 },
 {
  "id": "sce039:00180",
  "jp": "ローディス「ああ。そうさせてもらうよ。{nl}　‥‥できれば私も伺行したいが‥‥そうもいかないしな。{nl}　だが、我々の助けが必要な時はいつでも言ってくれ」",
  "off": 384,
  "len": 90,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 386,
  "text_len": 87
 },
 {
  "id": "sce039:001DD",
  "jp": "セリカ「ええ。その時は遠慮なく言わせてもらうわよ」",
  "off": 477,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 479,
  "text_len": 29
 },
 {
  "id": "sce039:00200",
  "jp": "ローディス「おいおい、少しは遠慮してくれよ。{nl}　‥‥では、君達に希望の風があらんことを‥‥」",
  "off": 512,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 514,
  "text_len": 59
 },
 {
  "id": "sce039:0024A",
  "jp": "トウヤ「希望の風‥‥か」",
  "off": 586,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 588,
  "text_len": 17
 },
 {
  "id": "sce039:0026E",
  "jp": "アイ「あっ、リシュナ、あなた大丈夫なの？」",
  "off": 622,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 624,
  "text_len": 25
 },
 {
  "id": "sce039:0028D",
  "jp": "リシュナ「はい。もう平気です」",
  "off": 653,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 655,
  "text_len": 17
 },
 {
  "id": "sce039:002A4",
  "jp": "<E1>ァルガ「じゃが、こういうことを繰り返していると{nl}　危ない。お前は操者となって廿が浅いのだ、{nl}　気をつけるんじゃぞ」",
  "off": 676,
  "len": 70,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 678,
  "text_len": 67
 },
 {
  "id": "sce039:002ED",
  "jp": "リシュナ「はい‥‥」",
  "off": 749,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 751,
  "text_len": 12
 },
 {
  "id": "sce039:002FF",
  "jp": "トウヤ「まったく無茶しやがって‥‥」",
  "off": 767,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 769,
  "text_len": 22
 },
 {
  "id": "sce039:0031B",
  "jp": "リシュナ「ご、ごめんなさい‥‥」",
  "off": 795,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 797,
  "text_len": 18
 },
 {
  "id": "sce039:00333",
  "jp": "トウヤ「でもお前がいたからみんなを守れた‥‥ありがとよ」",
  "off": 819,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 821,
  "text_len": 32
 },
 {
  "id": "sce039:00359",
  "jp": "リシュナ「はい」",
  "off": 857,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 859,
  "text_len": 8
 },
 {
  "id": "sce039:00367",
  "jp": "<E1>ァルガ「さて、これからどうするんじゃ？{nl}　ワシとしてはあのベルンストという男が言っておった{nl}　アルテリアス渓谷へ行くことを提案するが‥‥」",
  "off": 871,
  "len": 83,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 873,
  "text_len": 80
 },
 {
  "id": "sce039:003BD",
  "jp": "トウヤ「そういやぁ、そんなことを言っていたよな。{nl}　で、そこってどこなんだ？」",
  "off": 957,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 959,
  "text_len": 41
 },
 {
  "id": "sce039:003F3",
  "jp": "マキ「ここから北西に行ったところにある渓谷よ」",
  "off": 1011,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1013,
  "text_len": 28
 },
 {
  "id": "sce039:0041D",
  "jp": "フェイン「マキ姉！　もういいのか？」",
  "off": 1053,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1055,
  "text_len": 21
 },
 {
  "id": "sce039:00438",
  "jp": "マキ「いつまでも寝てばっかりいられないしね。{nl}　それより、うまいところに隠れていたものね。{nl}　そこって、ゾルゲの場が形成されてるとこでしょ？」",
  "off": 1080,
  "len": 80,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1082,
  "text_len": 77
 },
 {
  "id": "sce039:004A9",
  "jp": "トウヤ「“ゾルゲの場”？」",
  "off": 1193,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1195,
  "text_len": 17
 },
 {
  "id": "sce039:004C0",
  "jp": "ユミール「詳しくは解明されていないんだけど、{nl}　一種の障壁のようなものよ。質量が増大すればするほど{nl}　その空域に侵入できなくなるの」",
  "off": 1216,
  "len": 85,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1218,
  "text_len": 82
 },
 {
  "id": "sce039:00518",
  "jp": "アイ「バリアーってやつね。でもそんなあからさまに{nl}　怪しい場所がどうしてノーマークだったの？」",
  "off": 1304,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1306,
  "text_len": 54
 },
 {
  "id": "sce039:00554",
  "jp": "ユミール「人間ならまだしも、装兵機クラスでは{nl}　もう入れないのよ？　そんなところに入れるなんて{nl}　思わないわ」",
  "off": 1364,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1366,
  "text_len": 65
 },
 {
  "id": "sce039:0059B",
  "jp": "カスミ「では、そこにいる可能性は‥‥」",
  "off": 1435,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1437,
  "text_len": 24
 },
 {
  "id": "sce039:005B9",
  "jp": "セリカ「蕃定はできない‥‥いえ、むしろ高いわね。{nl}　でも今すぐに徇かうのはちょっと無理ね」",
  "off": 1465,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1467,
  "text_len": 54
 },
 {
  "id": "sce039:005F5",
  "jp": "トウヤ「なんで？」",
  "off": 1525,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1527,
  "text_len": 10
 },
 {
  "id": "sce039:00605",
  "jp": "セリカ「聖霊機の資材も不足してきてるし、{nl}　リーボーフェンの調整もしなきゃならないの。{nl}　だから一度、聖地へ寄ってからになるわ」",
  "off": 1541,
  "len": 83,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1543,
  "text_len": 80
 },
 {
  "id": "sce039:0065B",
  "jp": "トウヤ「まぁ、途中だし‥‥それじゃ早速行こうぜ。{nl}　できるだけ早く行くにこしたことはねぇ」",
  "off": 1627,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1629,
  "text_len": 54
 },
 {
  "id": "sce039:00697",
  "jp": "ユミール「そうね。王都のほうはもう騎止断も帰還した{nl}　みたいだし、大丈夫そうね」",
  "off": 1687,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1689,
  "text_len": 51
 },
 {
  "id": "sce039:006D0",
  "jp": "アイ「よぉーしっ、そんじゃ、早速、れっつごー！」",
  "off": 1744,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1746,
  "text_len": 29
 },
 {
  "id": "sce039:0074F",
  "jp": "ゲン「本当に大丈夫？」",
  "off": 1871,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1873,
  "text_len": 17
 },
 {
  "id": "sce039:00766",
  "jp": "<E1>ァレス「ああ。これぐらい怪我に入らんといっただろ？{nl}　いつまでも寝てはおられん」",
  "off": 1894,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1896,
  "text_len": 46
 },
 {
  "id": "sce039:0079A",
  "jp": "ゲン「‥‥ねぇ、父ちゃん」",
  "off": 1946,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1948,
  "text_len": 16
 },
 {
  "id": "sce039:007B0",
  "jp": "<E1>ァレス「ん？」",
  "off": 1968,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1970,
  "text_len": 9
 },
 {
  "id": "sce039:007BF",
  "jp": "ゲン「どうして‥‥オイラ達を置#674いて家を出たの？」",
  "off": 1983,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1985,
  "text_len": 31
 },
 {
  "id": "sce039:007E4",
  "jp": "<E1>ァレス「‥‥」",
  "off": 2020,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2022,
  "text_len": 10
 },
 {
  "id": "sce039:007F4",
  "jp": "ゲン「オイラは別にいいんだ。{nl}　でも姉ちゃんはそれがどうしても許せないって‥‥{nl}　だからその理由を訊きたいんだ」",
  "off": 2036,
  "len": 67,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2038,
  "text_len": 64
 },
 {
  "id": "sce039:0083A",
  "jp": "<E1>ァレス「‥‥ロザリーはお前になんと聞かせているんだ？」",
  "off": 2106,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2108,
  "text_len": 34
 },
 {
  "id": "sce039:00862",
  "jp": "ゲン「父ちゃんは戦いの中でしか生きれないって‥‥」",
  "off": 2146,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2148,
  "text_len": 31
 },
 {
  "id": "sce039:00887",
  "jp": "<E1>ァレス「そうか‥‥」",
  "off": 2183,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2185,
  "text_len": 13
 },
 {
  "id": "sce039:0089A",
  "jp": "ゲン「嘘だろ？　父ちゃんがそんなことだけでオイラ達を{nl}　捨てるなんて‥‥」",
  "off": 2202,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2204,
  "text_len": 44
 },
 {
  "id": "sce039:008CC",
  "jp": "<E1>ァレス「ゲン‥‥残念だが、事実だ。{nl}　他にもいろいろあったが、置接的な理由はな」",
  "off": 2252,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2254,
  "text_len": 53
 },
 {
  "id": "sce039:00907",
  "jp": "ゲン「他にもって‥‥それってなに？」",
  "off": 2311,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2313,
  "text_len": 22
 },
 {
  "id": "sce039:00923",
  "jp": "<E1>ァレス「‥‥つまらん話だ。よくある権力争いというな。{nl}　当時、私とレビオスは軍の最高責任者の座をめぐり、{nl}　派閥という下らんものとともに{nl}　競争に巻き込まれていた。{nl}　私は地位などどうでもよかった。{nl}　だが、周りの者はそうは見てくれなかったんだ。{nl}　レビオス派の筆頭のギールが中心となり、{nl}　私を陥れようとしてきた。それが失敗すると今度は{nl}　言外に脅しをかけてきた。家族のな」",
  "off": 2339,
  "len": 238,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2341,
  "text_len": 235
 },
 {
  "id": "sce039:00A14",
  "jp": "ゲン「それって母ちゃんや姉ちゃんにってこと？」",
  "off": 2580,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2582,
  "text_len": 26
 },
 {
  "id": "sce039:00A34",
  "jp": "<E1>ァレス「そうだ。星#5D6置うんざりもしていた。{nl}　そこで私は家族に手を出さないという条件で{nl}　身を引いた。{nl}　だが、奴等はそれだけでは不安だったのだろうな。{nl}　それからもいろいろと理由をつけては手をだしてきた。{nl}　‥‥私はすべてを投げ出した。{nl}　武人として、騎止として最低の行為を犯した。{nl}　そして父親としても。私は麹を出奔した。{nl}　最低の人間に成り下がって‥‥」",
  "off": 2612,
  "len": 229,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2614,
  "text_len": 226
 },
 {
  "id": "sce039:00B1C",
  "jp": "ゲン「どうしてそんなこと‥‥{nl}　そんな奴等やっつけちゃえばよかったんだ！」",
  "off": 2844,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2846,
  "text_len": 42
 },
 {
  "id": "sce039:00B4C",
  "jp": "<E1>ァレス「‥‥すまん‥‥私にはああすることでしか{nl}　お前達を守れなかった‥‥だが、傭兵に身をやつしても{nl}　お前達のことを忘れたことは一度としてない。{nl}　それだけは信じてくれ‥‥」",
  "off": 2892,
  "len": 113,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2894,
  "text_len": 110
 },
 {
  "id": "sce039:00BC7",
  "jp": "ゲン「誰？　まさか‥‥」",
  "off": 3015,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3017,
  "text_len": 16
 },
 {
  "id": "sce039:00C05",
  "jp": "ゲン「‥‥姉ちゃん‥‥」",
  "off": 3077,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3079,
  "text_len": 17
 },
 {
  "id": "sce039:00C68",
  "jp": "ローディス「雨‥‥か」",
  "off": 3176,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3178,
  "text_len": 15
 },
 {
  "id": "sce039:00C92",
  "jp": "？？？？？「‥‥」",
  "off": 3218,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3220,
  "text_len": 16
 },
 {
  "id": "sce039:00CA8",
  "jp": "ローディス「‥‥」",
  "off": 3240,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3242,
  "text_len": 12
 },
 {
  "id": "sce039:00CCC",
  "jp": "？？？？？「‥‥さん‥‥に、逃げ‥‥て‥‥」",
  "off": 3276,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3278,
  "text_len": 36
 },
 {
  "id": "sce039:00D18",
  "jp": "ティックス「‥‥」",
  "off": 3352,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3354,
  "text_len": 11
 },
 {
  "id": "sce039:00D30",
  "jp": "ティックス「‥‥だ、ダメ‥‥くっ‥‥」",
  "off": 3376,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3378,
  "text_len": 25
 },
 {
  "id": "sce039:00D4F",
  "jp": "ローディス「ティックス‥‥やはり、カインの‥‥」",
  "off": 3407,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3409,
  "text_len": 29
 },
 {
  "id": "sce039:00D72",
  "jp": "ティックス「‥‥」",
  "off": 3442,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3444,
  "text_len": 11
 },
 {
  "id": "sce039:00D90",
  "jp": "ローディス「その剣で私を殺すのかい？{nl}　‥‥たしかにもう私の役貰は終わった。{nl}　あとはティックス。お前の時代だ‥‥」",
  "off": 3472,
  "len": 77,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3474,
  "text_len": 74
 },
 {
  "id": "sce039:00DE0",
  "jp": "ティックス「‥‥」",
  "off": 3552,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3554,
  "text_len": 11
 },
 {
  "id": "sce039:00DF1",
  "jp": "ローディス「お前が望むのならこの命、喜んで差し出そう。{nl}　だが、今のお前は呪縛に周#8A4われている。自分で考え、{nl}　決断#66Cしたことではない‥‥」",
  "off": 3569,
  "len": 90,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3571,
  "text_len": 87
 },
 {
  "id": "sce039:00E4E",
  "jp": "ティックス「‥‥くっ」",
  "off": 3662,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3664,
  "text_len": 13
 },
 {
  "id": "sce039:00E61",
  "jp": "ローディス「ティックス‥‥お前はそんなに弱い男か？{nl}　さぁ、ティックス‥‥」",
  "off": 3681,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3683,
  "text_len": 47
 },
 {
  "id": "sce039:00E96",
  "jp": "ティックス「うわぁぁぁぁ！」",
  "off": 3734,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3736,
  "text_len": 15
 },
 {
  "id": "sce039:00ECB",
  "jp": "ローディス「‥‥」",
  "off": 3787,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3789,
  "text_len": 12
 },
 {
  "id": "sce039:00EE4",
  "jp": "ティックス「に、兄さん‥‥」",
  "off": 3812,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3814,
  "text_len": 17
 },
 {
  "id": "sce039:00EFB",
  "jp": "ローディス「‥‥よく頑張ったね、ティックス。{nl}　それでこそ星#5D6当なる世継ぎだ」",
  "off": 3835,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3837,
  "text_len": 47
 },
 {
  "id": "sce039:00F30",
  "jp": "ティックス「兄さん‥‥血‥‥」",
  "off": 3888,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3890,
  "text_len": 21
 },
 {
  "id": "sce039:00F4B",
  "jp": "ローディス「心配はいらない。かすっただけだよ‥‥」",
  "off": 3915,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3917,
  "text_len": 30
 },
 {
  "id": "sce039:00F6F",
  "jp": "ティックス「僕‥‥僕‥‥」",
  "off": 3951,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3953,
  "text_len": 19
 },
 {
  "id": "sce039:00F88",
  "jp": "ローディス「大丈夫。お前はカインの呪縛に{nl}　打ち勝ったのだ。もう何も心配することはない‥‥」",
  "off": 3976,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3978,
  "text_len": 60
 },
 {
  "id": "sce039:00FCA",
  "jp": "ティックス「うっううっ‥‥」",
  "off": 4042,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4044,
  "text_len": 16
 },
 {
  "id": "sce039:01000",
  "jp": "デビッシュ「ベルンスト‥‥そろそろ貰障りか‥‥」",
  "off": 4096,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4098,
  "text_len": 30
 },
 {
  "id": "sce039:0102E",
  "jp": "シャール「私が始末いたしましょうか？」",
  "off": 4142,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4144,
  "text_len": 24
 },
 {
  "id": "sce039:0104C",
  "jp": "デビッシュ「いや、まずはライブレードの“コア”を{nl}　手に入れることが先決だ。{nl}　あれがないとかなりの負担になる。少し急ぐか‥‥」",
  "off": 4172,
  "len": 80,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4174,
  "text_len": 77
 },
 {
  "id": "sce039:0109F",
  "jp": "シャール「‥‥」",
  "off": 4255,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4257,
  "text_len": 11
 },
 {
  "id": "sce039:010B0",
  "jp": "デビッシュ「我々にはもう時間が無い。{nl}　このような貧弱な身体を持つ人類に未来はない。{nl}　生命体として進化を行なうべきなのだ」",
  "off": 4272,
  "len": 84,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4274,
  "text_len": 81
 },
 {
  "id": "sce039:01107",
  "jp": "シャール「我々、ですか‥‥」",
  "off": 4359,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4361,
  "text_len": 18
 },
 {
  "id": "sce039:0111F",
  "jp": "デビッシュ「どうした？　なにか言いたいことがあるのか？」",
  "off": 4383,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4385,
  "text_len": 31
 },
 {
  "id": "sce039:01144",
  "jp": "シャール「‥‥いえ。ただ、あなたが本当に人類のことを{nl}　愁いているとは思えなかったもので」",
  "off": 4420,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4422,
  "text_len": 54
 },
 {
  "id": "sce039:01180",
  "jp": "デビッシュ「‥‥」",
  "off": 4480,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4482,
  "text_len": 11
 },
 {
  "id": "sce039:01191",
  "jp": "シャール「非難しているのではありません。{nl}　別のところに貰的がある。そう思えるのです」",
  "off": 4497,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4499,
  "text_len": 50
 },
 {
  "id": "sce039:011C9",
  "jp": "デビッシュ「なかなか面白いな。{nl}　ではその貰的とはどのようなものだと思う？」",
  "off": 4553,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4555,
  "text_len": 44
 },
 {
  "id": "sce039:011FB",
  "jp": "シャール「‥‥<E1>ォーリアの発動した結果。{nl}　そこにあるのではありませんか？」",
  "off": 4603,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4605,
  "text_len": 47
 },
 {
  "id": "sce039:01230",
  "jp": "デビッシュ「私は審剣に世界を愁いているつもりなのだが」",
  "off": 4656,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4658,
  "text_len": 33
 },
 {
  "id": "sce039:01257",
  "jp": "シャール「どうして私に隠し事をするのです。{nl}　それほど信じられないのですか？　それともあなたの中の{nl}　お父様が梢えてしまっているから？」",
  "off": 4695,
  "len": 82,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4697,
  "text_len": 79
 },
 {
  "id": "sce039:012AC",
  "jp": "デビッシュ「‥‥なにを言っている？{nl}　私はお前の父、バフレッド・デビッシュで‥‥」",
  "off": 4780,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4782,
  "text_len": 50
 },
 {
  "id": "sce039:012E4",
  "jp": "シャール「私は20年以上あなたを“見て”きたのです。{nl}　私にとって人の外見など戻#7EA題ではありません。{nl}　あなたは‥‥お父様ではありません」",
  "off": 4836,
  "len": 89,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4838,
  "text_len": 86
 },
 {
  "id": "sce039:01340",
  "jp": "デビッシュ「‥‥」",
  "off": 4928,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4930,
  "text_len": 11
 },
 {
  "id": "sce039:01351",
  "jp": "シャール「‥‥」",
  "off": 4945,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4947,
  "text_len": 11
 },
 {
  "id": "sce039:01362",
  "jp": "デビッシュ「‥‥いつから気づいた？」",
  "off": 4962,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4964,
  "text_len": 22
 },
 {
  "id": "sce039:0137E",
  "jp": "シャール「お父様が初めてゴーデリウスに乗った廿から」",
  "off": 4990,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4992,
  "text_len": 33
 },
 {
  "id": "sce039:013A5",
  "jp": "デビッシュ「はじめから、ということか。{nl}　ではなぜ今になって訊く？」",
  "off": 5029,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5031,
  "text_len": 37
 },
 {
  "id": "sce039:013D0",
  "jp": "シャール「気まぐれ‥‥ではいけませんか？」",
  "off": 5072,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5074,
  "text_len": 26
 },
 {
  "id": "sce039:013F0",
  "jp": "デビッシュ「‥‥気まぐれ、か‥‥」",
  "off": 5104,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5106,
  "text_len": 22
 },
 {
