  "text_len": 27
 },
 {
  "id": "sce434:000D2",
  "jp": "カスミ「‥‥あっ、トウヤちゃん」",
  "off": 210,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 212,
  "text_len": 18
 },
 {
  "id": "sce434:00102",
  "jp": "　カスミ、アイにいじめられてたのか？{nl}　アイ、カスミとなに話してんだ？",
  "off": 258,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 128,
  "text_off": 260,
  "text_len": 38
 },
 {
  "id": "sce434:0013A",
  "jp": "アイ「なによそれ！　失礼しちゃうわね！」",
  "off": 314,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 316,
  "text_len": 24
 },
 {
  "id": "sce434:00158",
  "jp": "カスミ「ちがうよ。アイちゃんは私を心配して‥‥」",
  "off": 344,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 346,
  "text_len": 29
 },
 {
  "id": "sce434:0017B",
  "jp": "トウヤ「え？　そうなのか？」",
  "off": 379,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 381,
  "text_len": 16
 },
 {
  "id": "sce434:00191",
  "jp": "アイ「いったいどーやったら“あたしがカスミを{nl}　いじめてる”って結論に達するのよ⁉」",
  "off": 401,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 403,
  "text_len": 49
 },
 {
  "id": "sce434:001C8",
  "jp": "トウヤ「いや、ただなんとなく‥‥」",
  "off": 456,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 458,
  "text_len": 19
 },
 {
  "id": "sce434:001E1",
  "jp": "アイ「ああ、そうですか。どーせあたしはその程度にしか{nl}　見られてないってことね。フンだ」",
  "off": 481,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 483,
  "text_len": 48
 },
 {
  "id": "sce434:00217",
  "jp": "カスミ「ア、アイちゃん‥‥」",
  "off": 535,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 537,
  "text_len": 16
 },
 {
  "id": "sce434:0022D",
  "jp": "トウヤ「そう、怒るなよ。悪かったって」",
  "off": 557,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 559,
  "text_len": 21
 },
 {
  "id": "sce434:00248",
  "jp": "アイ「あーっ！　全然誠意が感じられなぃ～」",
  "off": 584,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 586,
  "text_len": 29
 },
 {
  "id": "sce434:0026B",
  "jp": "トウヤ「ヤケにからむなぁ‥‥どうしたんだ？」",
  "off": 619,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 621,
  "text_len": 25
 },
 {
  "id": "sce434:0028A",
  "jp": "ヤマト「トウヤがカスミの肩を持つからよ。{nl}　これはアレね、いわゆるジェラシーってやつ？」",
  "off": 650,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 652,
  "text_len": 48
 },
 {
  "id": "sce434:002C0",
  "jp": "トウヤ「はぁ？」",
  "off": 704,
  "len": 12,
  "en": "Touya: Huh?",
  "status": "translated",
  "style": 0,
  "text_off": 706,
  "text_len": 9
 },
 {
  "id": "sce434:002CF",
  "jp": "アイ「なっ！　な、な、なに言ってるのよ！{nl}　そんなことあるワケないでしょ！　ま、まぁ。今日のところは{nl}　大目に見てあげるわ！　そ、それじゃ！」",
  "off": 719,
  "len": 85,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 721,
  "text_len": 82
 },
 {
  "id": "sce434:00329",
  "jp": "ヤマト「行っちゃった‥‥やれやれ」",
