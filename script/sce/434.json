  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1404,
  "text_len": 36
 },
 {
  "id": "sce434:005A4",
  "jp": "ヤマト「やっぱりね。そんニャことじゃニャいかと{nl}　思ったわ」",
  "off": 1444,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1446,
  "text_len": 31
 },
 {
  "id": "sce434:005C9",
  "jp": "トウヤ「いいだろ？　そういうことしか{nl}　思いつかなかったんだからよ」",
  "off": 1481,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1483,
  "text_len": 36
 },
 {
  "id": "sce434:005F3",
  "jp": "カスミ「誰の言葉でも、トウヤちゃんが言ってくれた{nl}　ことだから、私はうれしいよ。ありがとう」",
