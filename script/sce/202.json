  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 250,
  "text_len": 21
 },
 {
  "id": "sce202:00113",
  "jp": "クロビス「さっさと、どっか行ったぜ。{nl}　おおかた女王さんのところじゃないか？」",
