  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1480,
  "text_len": 35
 },
 {
  "id": "sce202:005F9",
  "jp": "シエル「陛下が無事なのならばこのまま聖地へ{nl}　徇かわれたほうがいいと思うのですが‥‥」",
  "off": 1529,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1531,
  "text_len": 53
 },
