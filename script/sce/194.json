  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1329,
  "text_len": 45
 },
 {
  "id": "sce194:00562",
  "jp": "トウヤ「‥‥で、どうなんだ、セリカ？」",
  "off": 1378,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1380,
  "text_len": 22
 },
 {
  "id": "sce194:0057E",
  "jp": "フェイン「おい！　俺を無視するな」",
  "off": 1406,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1408,
  "text_len": 21
 },
 {
  "id": "sce194:00599",
  "jp": "セリカ「実はね‥‥」",
  "off": 1433,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1435,
  "text_len": 13
 },
 {
  "id": "sce194:005AC",
  "jp": "フェイン「あーっ、姫までぇ‥‥シクシクシク」",
  "off": 1452,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1454,
  "text_len": 26
 },
 {
  "id": "sce194:005CC",
  "jp": "ユミール「あっ‥‥え、えっと‥‥フェイン君、ありがとう」",
  "off": 1484,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1486,
  "text_len": 34
 },
 {
  "id": "sce194:005F4",
  "jp": "フェイン「え⁈　あ、いえ、そ、そんな‥‥」",
  "off": 1524,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1526,
  "text_len": 24
 },
 {
  "id": "sce194:00612",
  "jp": "ユミール「でも、これからはあんな無茶をしないでね」",
  "off": 1554,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1556,
  "text_len": 28
 },
 {
  "id": "sce194:00634",
  "jp": "フェイン「は、はい！　ユミールさんがそうおっしゃるのなら{nl}　このフェイン・ジン・バリオン、身命を賭して{nl}　約束いたしますっ‼」",
  "off": 1588,
  "len": 74,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1590,
  "text_len": 71
 },
 {
  "id": "sce194:00681",
  "jp": "クロビス「‥‥分かりやすい性格だなぁ」",
  "off": 1665,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1667,
  "text_len": 24
 },
 {
  "id": "sce194:0069F",
  "jp": "アーサー「まぁ、いいんじゃありませんか。{nl}　彼が誰に好意をよせるかは本人の自由なんですから」",
  "off": 1695,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1697,
  "text_len": 56
 },
 {
  "id": "sce194:006E9",
  "jp": "セリカ「‥‥えっと、なんの話だったっけ？{nl}　ああ、そうそう、ここにいる理由よね。{nl}　えっと、まぁ、簡単にいえば、兄さんの指示かな？」",
  "off": 1769,
  "len": 81,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1771,
  "text_len": 78
 },
 {
  "id": "sce194:0073D",
  "jp": "ユミール「ローディス殿下の？」",
  "off": 1853,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1855,
  "text_len": 20
 },
 {
  "id": "sce194:0075B",
  "jp": "セリカ「そっ。だいたい私もあの帰還命令には{nl}　納得できてなかったの。だって‥‥」",
  "off": 1883,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1885,
  "text_len": 49
 },
 {
  "id": "sce194:00792",
  "jp": "フェイン「ひ、姫！」",
  "off": 1938,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1940,
  "text_len": 12
 },
 {
  "id": "sce194:007AF",
  "jp": "セリカ「いいの。どーせすぐにわかることなんだから。{nl}　私たちに帰還命令が出たのはアガルティアの諜報部が{nl}　ジグリム侵攻の情報を入手したからだったの」",
  "off": 1967,
  "len": 93,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1969,
  "text_len": 90
 },
 {
  "id": "sce194:0081A",
  "jp": "トウヤ「なにっ！　知ってて逃げ出したっていうのか⁉」",
  "off": 2074,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2076,
  "text_len": 31
 },
 {
  "id": "sce194:0083F",
  "jp": "ヤマト「トウヤ！」",
  "off": 2111,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2113,
  "text_len": 10
 },
 {
  "id": "sce194:00861",
  "jp": "セリカ「そう思うのは当然よね。{nl}　でも私達もそれを知ったのはフラムエルク城#946を{nl}　出たあとだったの。{nl}　それで兄さんがとりあえず私達だけでもって、{nl}　途中で降ろしたってワケ」",
  "off": 2145,
  "len": 103,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2147,
  "text_len": 100
 },
 {
  "id": "sce194:008CB",
  "jp": "クロビス「ということはアガルティア自体が情報を{nl}　握り潰したってことか？」",
  "off": 2251,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2253,
  "text_len": 44
 },
 {
  "id": "sce194:0090F",
  "jp": "セリカ「残念ながらね。こんなことするのって{nl}　レビオス元帥よ、きっと」",
  "off": 2319,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2321,
  "text_len": 39
 },
 {
  "id": "sce194:0093C",
  "jp": "アーサー「レビオスと言えば、アガルティア軍の{nl}　最高司令ではありませんでしたか？」",
  "off": 2364,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2366,
  "text_len": 50
 },
 {
  "id": "sce194:0097F",
  "jp": "セリカ「ええ。元帥はジグリムに侵略国という{nl}　レッテルをはって、自分たちの正当性を掲げて{nl}　ジグリムと戦争する口実がほしいのよ。{nl}　大陸の盟主たる国を、そして強いアガルティアを{nl}　示すためにね」",
  "off": 2431,
  "len": 122,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2433,
  "text_len": 119
 },
 {
  "id": "sce194:009FC",
  "jp": "ガボン「そろそろ、俺達も紹介してほしいんですが‥‥」",
  "off": 2556,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2558,
  "text_len": 32
 },
 {
  "id": "sce194:00A3B",
  "jp": "セリカ「え？　ああ、ごめん。{nl}　そういえばまだクルーの紹介が済んでなかったね。{nl}　全員は揃ってないけど、紹介しておくわ」",
  "off": 2619,
  "len": 73,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2621,
  "text_len": 70
 },
 {
  "id": "sce194:00A87",
  "jp": "セリカ「えー、まずは機関士兼船医のガボン」",
  "off": 2695,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2697,
  "text_len": 28
 },
 {
  "id": "sce194:00AB5",
  "jp": "トウヤ「あっ、あんた‥‥」",
  "off": 2741,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2743,
  "text_len": 15
 },
 {
  "id": "sce194:00ACA",
  "jp": "ガボン「ガボン・ジン・ボレイショだ。よろしく頼む。{nl}　あのネコちゃんは元気か？」",
  "off": 2762,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2764,
  "text_len": 44
 },
 {
  "id": "sce194:00AFC",
  "jp": "ヤマト「また会ったね！」",
  "off": 2812,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2814,
  "text_len": 14
 },
 {
  "id": "sce194:00B10",
  "jp": "ガボン「おお、元気そうだな。{nl}　どうだ、その生活にもなれたか？」",
  "off": 2832,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2834,
  "text_len": 37
 },
 {
  "id": "sce194:00B3B",
  "jp": "ヤマト「う～ん、ときどき頭にモヤがかかったように{nl}　ニャるけど、だいたいは問題ニャいわ」",
  "off": 2875,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2877,
  "text_len": 48
 },
 {
  "id": "sce194:00B71",
  "jp": "ガボン「たのもしいな。まっ、これからよろしくな」",
  "off": 2929,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2931,
  "text_len": 24
 },
