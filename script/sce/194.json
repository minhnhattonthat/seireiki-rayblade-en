  "status": "todo",
  "style": 0,
  "text_off": 307,
  "text_len": 27
 },
 {
  "id": "sce194:00152",
  "jp": "ムルク「‥‥お、おおっ！　あれが噂の聖霊機か！」",
  "off": 338,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 340,
  "text_len": 32
 },
 {
  "id": "sce194:00178",
  "jp": "助手「都合が悪くなるとすぐそうやって{nl}　ごまかそうとするぅ‥‥」",
  "off": 376,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 378,
  "text_len": 39
 },
 {
  "id": "sce194:001A5",
  "jp": "ムルク「細かいことをいちいち気にしていては{nl}　立派な錬金学士にはなれんぞ。{nl}　それよりも、まだ未完成とはいえアレを倒すとは‥‥」",
  "off": 421,
  "len": 81,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 423,
  "text_len": 78
 },
 {
  "id": "sce194:001F9",
  "jp": "助手「博士、あの装兵機は‥‥」",
  "off": 505,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 507,
  "text_len": 24
 },
 {
  "id": "sce194:00217",
  "jp": "ムルク「あれが噂の聖霊機じゃろう。{nl}　うむぅ‥‥噂に違わぬ性能。{nl}　それにあのリーボーフェンという船のなんと強力なこと‥‥{nl}　そうじゃ！　あーっと、君、名前はなんといったかの？」",
  "off": 535,
  "len": 115,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 537,
  "text_len": 112
 },
 {
  "id": "sce194:0028D",
  "jp": "助手「‥‥マーシャ・モンシアンですぅ{nl}　これで千と240回目ですよぉ～」",
  "off": 653,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 655,
  "text_len": 45
 },
 {
  "id": "sce194:002C0",
  "jp": "ムルク「おお、すまんすまん。えーと‥‥」",
  "off": 704,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 706,
  "text_len": 23
 },
 {
  "id": "sce194:002DD",
  "jp": "助手「マーシャですぅ‥‥シクシク」",
  "off": 733,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 735,
  "text_len": 22
 },
 {
  "id": "sce194:002F9",
  "jp": "ムルク「まぁ、そういう細かいことはどうでもよい。{nl}　助手よ。ちゃんと記録は撮ったか？」",
  "off": 761,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 763,
  "text_len": 50
 },
 {
  "id": "sce194:00331",
  "jp": "助手「は、はい！　もちろんです博士！{nl}　このとお‥‥」",
  "off": 817,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 819,
  "text_len": 35
 },
 {
  "id": "sce194:0035A",
  "jp": "ムルク「‥‥どうした？」",
  "off": 858,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 860,
  "text_len": 15
 },
 {
  "id": "sce194:0036F",
  "jp": "助手「は、ははははは‥‥{nl}　ディスク、入ってませんでした‥‥」",
  "off": 879,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 881,
  "text_len": 38
 },
 {
  "id": "sce194:0039B",
  "jp": "ムルク「減点2じゃ。あと4点でお前の脳みそを{nl}　研究に使わせてもらうぞ」",
  "off": 923,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 925,
  "text_len": 44
 },
 {
  "id": "sce194:003CD",
  "jp": "助手「もぅ！　博士ったらぁ冗談ばっか‥‥」",
  "off": 973,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 975,
  "text_len": 30
 },
 {
