  "id": "sce194:00B8F",
  "jp": "セリカ「それから操舵手で整備員兼任のバレン」",
  "off": 2959,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2961,
  "text_len": 30
 },
 {
  "id": "sce194:00BBF",
  "jp": "バレン「‥‥バレン・ジン・ヨークルだ」",
  "off": 3007,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3009,
  "text_len": 22
 },
 {
  "id": "sce194:00BDB",
  "jp": "トウヤ「‥‥なぁ、あの人、機嫌でも悪いのか？」",
  "off": 3035,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3037,
  "text_len": 30
 },
