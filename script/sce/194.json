  "style": 0,
  "text_off": 77,
  "text_len": 40
 },
 {
  "id": "sce194:00079",
  "jp": "ムルク「若いのにだらしがないのぅ。{nl}　ワシなぞまだ元気ハツラツじゃぞ」",
