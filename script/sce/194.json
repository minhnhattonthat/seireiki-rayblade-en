  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 123,
  "text_len": 38
 },
 {
  "id": "sce194:000A5",
  "jp": "助手「は、博士は“バルちゃん”に乗ってただけじゃ{nl}　ないですかぁ～　私はここまで走ってきたんですよぉ‥‥」",
