  "text_len": 13
 },
 {
  "id": "sce268:000A5",
  "jp": "フェイン「お前、守れもしない約束をしたのか⁈」",
  "off": 165,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 167,
  "text_len": 28
 },
 {
  "id": "sce268:000C7",
  "jp": "トウヤ「はあ？　なに言ってんだ？」",
  "off": 199,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 201,
  "text_len": 20
 },
 {
  "id": "sce268:000E1",
  "jp": "フェイン「‥‥まったく。初めて王都へ来たとき、{nl}　約束しただろ、カスミと！」",
  "off": 225,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 227,
  "text_len": 47
 },
 {
  "id": "sce268:00116",
  "jp": "トウヤ「‥‥」",
  "off": 278,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 280,
  "text_len": 9
 },
 {
  "id": "sce268:00125",
  "jp": "フェイン「時間ができれば王都見物へ連れて行ってやる{nl}　などと軽く約束したことだ！　どうだ思い出したか⁈」",
  "off": 293,
  "len": 70,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 295,
  "text_len": 67
 },
 {
  "id": "sce268:0016E",
  "jp": "トウヤ「あっ‥‥」",
  "off": 366,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 368,
  "text_len": 11
 },
 {
  "id": "sce268:0017F",
  "jp": "フェイン「カスミはずっと楽しみにしていたのだ！{nl}　それを‥‥」",
  "off": 383,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 385,
  "text_len": 35
 },
 {
  "id": "sce268:001A8",
  "jp": "ヤマト「あっ、でもその時、フェインはリーボーフェンに{nl}　残っていたよね。ニャんで知ってるの？」",
  "off": 424,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 426,
  "text_len": 53
 },
 {
  "id": "sce268:001E3",
  "jp": "フェイン「アイに聞いたのだ。それがどうした。{nl}　そんなことより男として、守れぬ約束をしたなら、{nl}　それなりの対処というものがあるだろ⁈」",
  "off": 483,
  "len": 79,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 485,
  "text_len": 76
 },
 {
  "id": "sce268:00235",
  "jp": "トウヤ「‥‥なにか言いてぇんだ？」",
  "off": 565,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 567,
  "text_len": 21
 },
 {
  "id": "sce268:00250",
  "jp": "フェイン「つまりだ！　男ならちゃんと謝れと言っている！」",
  "off": 592,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 594,
  "text_len": 33
 },
 {
  "id": "sce268:00277",
  "jp": "ヤマト「トウヤ。フェインの言うことはもっともだわ。{nl}　やっぱりちゃんとはニャしたほうがいいんじゃニャい」",
  "off": 631,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 633,
  "text_len": 53
 },
 {
  "id": "sce268:002B2",
  "jp": "トウヤ「‥‥そうだな。だが、あいつどこにいるのか‥‥」",
  "off": 690,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 692,
  "text_len": 31
 },
 {
  "id": "sce268:002D7",
  "jp": "フェイン「フッ‥‥この俺を誰だと思っている？」",
  "off": 727,
  "len": 32,
  "en": "",
  "status": "todo",
