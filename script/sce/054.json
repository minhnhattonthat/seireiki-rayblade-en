 },
 {
  "id": "sce054:00C9E",
  "jp": "メル<E1>ィ「はぁーい。それじゃお休みなさい」",
  "off": 3230,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3232,
  "text_len": 23
 },
 {
  "id": "sce054:00CF3",
  "jp": "？？「残念ながらライブレードは{nl}　聖地預かりのままになりそうだ」",
  "off": 3315,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3317,
  "text_len": 40
 },
 {
  "id": "sce054:00D2B",
  "jp": "ヨアニス「なーんだ。あなたの力もその程度なんだな」",
  "off": 3371,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3373,
  "text_len": 29
 },
 {
  "id": "sce054:00D4E",
  "jp": "？？「思い通りになることのほうが少ない。{nl}　私だって努#6BE力はしているんだ」",
  "off": 3406,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3408,
  "text_len": 44
 },
 {
  "id": "sce054:00D80",
  "jp": "ヨアニス「おやおや弱気なことで。{nl}　まぁ、あなただけが頼りだからねぇ。{nl}　そこの方々は頼りにならないし」",
  "off": 3456,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3458,
  "text_len": 57
 },
 {
  "id": "sce054:00DBF",
  "jp": "レンダー「‥‥」",
  "off": 3519,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3521,
  "text_len": 11
 },
 {
  "id": "sce054:00DD0",
  "jp": "レシュ「ケッ‥‥自分だけ安全なとこにいやがって‥‥{nl}　言うだけなら誰でもできるぜ‥‥」",
  "off": 3536,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3538,
  "text_len": 55
 },
 {
  "id": "sce054:00E0D",
  "jp": "ヨアニス「‥‥ん？　なにか言ったかい？」",
  "off": 3597,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3599,
  "text_len": 25
 },
 {
  "id": "sce054:00E2C",
  "jp": "レシュ「なんでもねぇよ！」",
  "off": 3628,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3630,
  "text_len": 14
 },
 {
  "id": "sce054:00E40",
  "jp": "ヨアニス「だめだなあ‥‥ちゃーんと聞こえてるんだよ。{nl}　誰が君達に援助していると思っているんだい？{nl}　そんなに嫌なら打ち切ってもいいんだよ？」",
  "off": 3648,
  "len": 89,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3650,
  "text_len": 86
 },
 {
  "id": "sce054:00E9C",
  "jp": "バーキン「‼」",
  "off": 3740,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3742,
  "text_len": 9
 },
 {
  "id": "sce054:00EAB",
  "jp": "レシュ「はっ！　だからあんたを敬えってか？{nl}　バカにするな‥‥」",
  "off": 3755,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3757,
  "text_len": 37
 },
 {
  "id": "sce054:00ED6",
  "jp": "バーキン「やめろ。言い過ぎだぞ」",
  "off": 3798,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3800,
  "text_len": 19
 },
 {
  "id": "sce054:00EEF",
  "jp": "レシュ「お、おい‥‥あんなにコケにされて黙っとくのか？{nl}　お前もなんか言えよ！　いつもなら‥‥」",
  "off": 3823,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3825,
  "text_len": 57
 },
 {
  "id": "sce054:00F2E",
  "jp": "ヨアニス「はははは！　バーキン君は{nl}　よく分かっているようだねぇ。{nl}　レシュ、君も少しは見習うべきだね。ふふふふ‥‥」",
  "off": 3886,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3888,
  "text_len": 69
 },
 {
  "id": "sce054:00F79",
  "jp": "？？「さて、今後のことだが‥‥聖霊機に関しては問題{nl}　ないが、トウヤというあの操者は注意が必要なようだ。{nl}　今はまだ脅威というわけではないが、そうなる日も近い」",
  "off": 3961,
  "len": 106,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3963,
  "text_len": 103
 },
 {
  "id": "sce054:00FE6",
  "jp": "レンダー「彼女の見立てですか？」",
  "off": 4070,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4072,
  "text_len": 22
 },
 {
  "id": "sce054:01002",
  "jp": "？？「ああ。実際に見てそう感じたようだ」",
  "off": 4098,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4100,
  "text_len": 26
 },
 {
  "id": "sce054:01022",
  "jp": "レシュ「姐さんにそんなことを言わすとはよほどですね」",
  "off": 4130,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4132,
  "text_len": 28
 },
 {
  "id": "sce054:01044",
  "jp": "？？「私も‥‥うっ‥‥」",
  "off": 4164,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4166,
  "text_len": 19
 },
 {
  "id": "sce054:0105D",
  "jp": "レンダー「‼　だ、大丈夫ですか⁈」",
  "off": 4189,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4191,
  "text_len": 23
 },
 {
  "id": "sce054:0107A",
  "jp": "？？「うっ‥‥また‥‥」",
  "off": 4218,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4220,
  "text_len": 18
 },
 {
  "id": "sce054:01092",
  "jp": "レンダー「さっ、お手を‥‥」",
  "off": 4242,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4244,
  "text_len": 18
 },
 {
  "id": "sce054:010AA",
  "jp": "？？「余計なことをするなっ！」",
  "off": 4266,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4268,
  "text_len": 20
 },
 {
  "id": "sce054:010C4",
  "jp": "レンダー「‥‥？」",
  "off": 4292,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4294,
  "text_len": 13
 },
 {
  "id": "sce054:010D7",
  "jp": "？？「‥‥あ、す、すまない‥‥私は‥‥」",
  "off": 4311,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4313,
  "text_len": 29
 },
 {
  "id": "sce054:010FA",
  "jp": "レンダー「きっとお疲れなのです。{nl}　少し休まれたほうが‥‥」",
  "off": 4346,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4348,
  "text_len": 36
 },
 {
  "id": "sce054:01124",
  "jp": "？？「ああ、そうさせてもらうよ‥‥」",
  "off": 4388,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4390,
  "text_len": 22
 },
 {
  "id": "sce054:01140",
  "jp": "ヨアニス「では私もこれで。{nl}　せいぜい頑張ってくれよ、諸君」",
  "off": 4416,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4418,
  "text_len": 35
 },
 {
  "id": "sce054:01184",
  "jp": "レシュ「‥‥なぁ、バーキン。{nl}　お前、どうしてこの＜時代の曙＞に{nl}　参加しようと思ったんだ？」",
  "off": 4484,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4486,
  "text_len": 60
 },
 {
  "id": "sce054:011C6",
  "jp": "バーキン「な、なんだいきなり‥‥{nl}　それは‥‥この腐りきった世界に{nl}　新たな秩序をだな‥‥」",
  "off": 4550,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4552,
  "text_len": 59
 },
 {
  "id": "sce054:01207",
  "jp": "レシュ「今は俺とお前しかいない。{nl}　そんな教科薯を読み上げてるような建前を{nl}　訊いているんじゃない。その理由を訊いているんだ」",
  "off": 4615,
  "len": 80,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4617,
  "text_len": 77
 },
 {
  "id": "sce054:0125A",
  "jp": "バーキン「‥‥」",
  "off": 4698,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4700,
  "text_len": 11
 },
 {
  "id": "sce054:0126B",
  "jp": "レシュ「‥‥俺は‥‥俺の父は＜ゼ＝オード＞の{nl}　有意性を証明する調査の責任者だった‥‥{nl}　だが、当時まだ＜ゼ＝オード＞の利揖について{nl}　世論の風当たりは強く、密かに行われていた。{nl}　しかし‥‥その調査がスッパぬかれ、{nl}　父はその全責任を取らされた。{nl}　ふっ‥‥いわゆるスケープゴートってやつだよ。{nl}　それからどこにいっても俺達にとっちゃ地獄だった‥‥{nl}　白い目でみられ、ひどい時には家に石まで{nl}　投げ込まれた。母さんは心労がたたってすぐ‥‥{nl}　下の妹だって医者にかかりさえすれば助かったのに‥‥{nl}　俺達に出す薬はねぇとぬかしやがった‥‥」",
  "off": 4715,
  "len": 354,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4717,
  "text_len": 351
 },
 {
  "id": "sce054:013D0",
  "jp": "バーキン「‥‥」",
  "off": 5072,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5074,
  "text_len": 11
 },
 {
  "id": "sce054:013E1",
  "jp": "レシュ「俺達をそんな目にあわせた奴等が今では{nl}　大手をふって＜ゼ＝オード＞を利揖しようとしている‥‥{nl}　麹家という後ろ盾を得てな！{nl}　‥‥だから俺はここに参加した。{nl}　自分の捕身のためなら他人を傷つけることさえも{nl}　いとわないこの腐った世の中に復讐#54Fするためにな‥‥」",
  "off": 5089,
  "len": 177,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5091,
  "text_len": 174
 },
 {
  "id": "sce054:01495",
  "jp": "バーキン「お前‥‥どうしてそんなことを俺に？」",
  "off": 5269,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5271,
  "text_len": 29
 },
 {
  "id": "sce054:014B8",
  "jp": "レシュ「どうしてだろうな？　俺にもわからん。{nl}　だが、こんなこと話したのはお前がはじめてだ」",
  "off": 5304,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5306,
  "text_len": 50
 },
 {
  "id": "sce054:014F0",
  "jp": "バーキン「そ、そんなこと言ってもなにも出んぞっ！」",
  "off": 5360,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5362,
  "text_len": 29
 },
 {
  "id": "sce054:01513",
  "jp": "レシュ「んなこと期待してねぇよ。{nl}　でもよ、はやまったことはするな」",
  "off": 5395,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5397,
  "text_len": 36
 },
 {
  "id": "sce054:0153D",
  "jp": "バーキン「‥‥どういう意味だ？」",
  "off": 5437,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5439,
  "text_len": 22
 },
 {
  "id": "sce054:01559",
  "jp": "レシュ「孤児院だよ」",
  "off": 5465,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5467,
  "text_len": 13
 },
 {
  "id": "sce054:0156C",
  "jp": "バーキン「ど、どうしてそのことを⁈」",
  "off": 5484,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5486,
  "text_len": 20
 },
 {
  "id": "sce054:01586",
  "jp": "レシュ「この前、偶然な。いつからだ？」",
  "off": 5510,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5512,
  "text_len": 23
 },
 {
  "id": "sce054:015A3",
  "jp": "バーキン「‥‥」",
  "off": 5539,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5541,
  "text_len": 11
 },
 {
  "id": "sce054:015B4",
  "jp": "レシュ「そうか‥‥ま、話したくねぇんなら‥‥」",
  "off": 5556,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5558,
  "text_len": 28
 },
 {
  "id": "sce054:015D6",
  "jp": "バーキン「‥‥5年前だ。{nl}　その時、俺の妹が一人の男の子を俺に託して、{nl}　そして死んだ」",
  "off": 5590,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5592,
  "text_len": 59
 },
 {
  "id": "sce054:01617",
  "jp": "レシュ「‥‥」",
  "off": 5655,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5657,
  "text_len": 9
 },
 {
  "id": "sce054:01626",
  "jp": "バーキン「妹はなにも言わなかった‥‥{nl}　だが、あの責任感の強かったジーナがリンバーグを{nl}　出奔してくるはずねぇ‥‥」",
  "off": 5670,
  "len": 76,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5672,
  "text_len": 73
 },
 {
  "id": "sce054:01675",
  "jp": "レシュ「リンバーグ？　お前って出身はジグリムだろ？」",
  "off": 5749,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5751,
  "text_len": 32
 },
 {
  "id": "sce054:0169B",
  "jp": "バーキン「亡命したんだよ。昔にな。{nl}　そこで妹は王宮で侍女として働いていた」",
  "off": 5787,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5789,
  "text_len": 48
 },
 {
  "id": "sce054:016D1",
  "jp": "レシュ「つまり王家のごたごたに巻き込まれたと？」",
  "off": 5841,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5843,
  "text_len": 29
 },
 {
  "id": "sce054:016F4",
  "jp": "バーキン「わからん。それを調べているところだ」",
  "off": 5876,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5878,
  "text_len": 25
 },
 {
  "id": "sce054:01713",
  "jp": "レシュ「それでその子を孤児院に預け{nl}　援助をしていたのか‥‥」",
  "off": 5907,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5909,
  "text_len": 40
 },
 {
  "id": "sce054:01741",
  "jp": "バーキン「ああ。だが、誰にも言うなよ」",
  "off": 5953,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5955,
  "text_len": 22
 },
 {
  "id": "sce054:0175D",
  "jp": "レシュ「分かってるよ。俺達はダチじゃねぇかよ。{nl}　それに‥‥お前はバカだがお前ほど気の合う奴は{nl}　他にいねぇからな」",
  "off": 5981,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5983,
  "text_len": 69
 },
 {
  "id": "sce054:017A8",
  "jp": "バーキン「ふ、ふん！　気持ち悪い！{nl}　俺はそんな趣味はねぇぞ」",
  "off": 6056,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6058,
  "text_len": 40
 },
 {
  "id": "sce054:017D6",
  "jp": "レシュ「ふっ‥‥俺もそっちの趣味はねぇよ」",
  "off": 6102,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6104,
  "text_len": 26
 },
 {
  "id": "sce054:017F6",
  "jp": "バーキン「‥‥だ、だが、まぁなんだ。{nl}　お前と酒を飲むのは嫌いじゃねぇ‥‥な」",
  "off": 6134,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6136,
  "text_len": 48
 },
 {
  "id": "sce054:0182C",
  "jp": "レシュ「‥‥素直じゃないねぇ。{nl}　正直に俺と気が合うって認めろよ」",
  "off": 6188,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6190,
  "text_len": 43
 },
 {
  "id": "sce054:0185D",
  "jp": "バーキン「ふん！」",
  "off": 6237,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6239,
  "text_len": 11
 }
]
