  "off": 9653,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9657,
  "text_len": 31
 },
 {
  "id": "sce358:025D9",
  "jp": "トウヤ「‥‥そっちは任せたぜ」",
  "off": 9689,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9693,
  "text_len": 18
 },
