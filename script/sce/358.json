  "status": "todo",
  "style": 1,
  "text_off": 8309,
  "text_len": 21
 },
 {
  "id": "sce358:0208B",
  "jp": "オーレリィ「え？」",
  "off": 8331,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 8336,
  "text_len": 11
 },
 {
  "id": "sce358:020A6",
  "jp": "オーレリィ「え？　な、なに‥‥？」",
