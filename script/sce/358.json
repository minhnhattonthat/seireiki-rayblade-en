  "status": "todo",
  "style": 1,
  "text_off": 8244,
  "text_len": 17
 },
 {
  "id": "sce358:02046",
  "jp": "オーレリィ「‥‥どうしたの？{nl}　アタシ達、勝ったんでしょ？」",
  "off": 8262,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 8267,
  "text_len": 37
 },
 {
  "id": "sce358:02071",
  "jp": "トウヤ「‥‥いや。まだ終わってねぇ」",
