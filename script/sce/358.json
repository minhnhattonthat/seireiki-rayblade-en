  "status": "todo",
  "style": 2,
  "text_off": 8363,
  "text_len": 22
 },
 {
  "id": "sce358:020C2",
  "jp": "ヤマト「<E1>ォーリアが動いている？{nl}　いったいニャにが‥‥」",
  "off": 8386,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 8391,
  "text_len": 34
 },
 {
  "id": "sce358:020EA",
  "jp": "トウヤ「‥‥ちっ、考えさせる時間もくれねぇのか‥‥」",
  "off": 8426,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 8430,
  "text_len": 33
 },
 {
  "id": "sce358:02110",
