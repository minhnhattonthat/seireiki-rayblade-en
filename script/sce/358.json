  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1063,
  "text_len": 46
 },
 {
  "id": "sce358:00459",
  "jp": "トウヤ（これは‥‥デビッシュ⁉{nl}　てめぇ、生きていたのか⁈）",
  "off": 1113,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1115,
  "text_len": 35
 },
 {
  "id": "sce358:00482",
