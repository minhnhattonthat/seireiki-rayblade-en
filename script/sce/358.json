  "status": "todo",
  "style": 2,
  "text_off": 8469,
  "text_len": 12
 },
 {
  "id": "sce358:02135",
  "jp": "トウヤ「‥‥聞いてくれ」",
  "off": 8501,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 8505,
  "text_len": 15
 },
 {
  "id": "sce358:02149",
  "jp": "ヤマト「あれ？　どうして送信モードにしてるの？{nl}　ねぇ。ねぇ、トウ‥‥」",
