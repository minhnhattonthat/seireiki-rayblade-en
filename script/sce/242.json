  "len": 104,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1582,
  "text_len": 99
 },
 {
  "id": "sce242:00692",
  "jp": "トウヤ「よくわからんが、その装置#674をつかえば{nl}　傷を修復できるんだな？{nl}　それじゃ、修理は任せるぜ」",
  "off": 1682,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1686,
  "text_len": 58
 },
