  "status": "todo",
  "style": 1,
  "text_off": 1425,
  "text_len": 59
 },
 {
  "id": "sce242:005CD",
  "jp": "セリカ「なんかヤな言い方～まっ、たしかにそうだけど。{nl}　でもこの子の秘められた能力を知ればそんなこと{nl}　言ってられないわよぉ」",
  "off": 1485,
  "len": 77,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1489,
  "text_len": 72
 },
 {
