  "status": "todo",
  "style": 1,
  "text_off": 1355,
  "text_len": 65
 },
 {
  "id": "sce242:0058D",
  "jp": "トウヤ「ああ、あの黙ってライブレードの技術を{nl}　盛り込んで、みんなを共犯者にしたてあげた機体か」",
