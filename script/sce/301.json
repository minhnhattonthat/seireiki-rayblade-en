  "status": "todo",
  "style": 0,
  "text_off": 4441,
  "text_len": 19
 },
 {
  "id": "sce301:01182",
  "jp": "ユミール「ええ。私、力仕事は得意じゃないから、{nl}　ちょっと大変だったけど」",
