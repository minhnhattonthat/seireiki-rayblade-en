  "jp": "　あっ、でも安心してください。{nl}　もう、システムの修正は終わりましたから」",
  "off": 4622,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4624,
  "text_len": 42
 },
 {
