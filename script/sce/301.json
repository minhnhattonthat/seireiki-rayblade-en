[
 {
  "id": "sce301:00061",
  "jp": "　「1B0のフラグが立っていません。このプライベート{nl}　イベントをする場合は1B0のフラグを立てやり直して{nl}　ください。しない場合は、強制終了いたします。」{ctl:B43E}",
  "off": 97,
  "len": 96,
  "en": "\"Flag 1B0 is not set. To run this private event, set flag 1B0 and start again. Otherwise, the event will be force-quit.\"{ctl:B43E}",
  "status": "translated",
  "style": 0,
  "text_off": 99,
  "text_len": 93
 },
 {
  "id": "sce301:00376",
  "jp": "ヤマト「あれ？　エレベーターが動いてる。めずらしいわね。{nl}　誰か乗ってるのかしら？」",
  "off": 886,
  "len": 52,
  "en": "Yamato: Huh? The elevator's moving. That's rare. I wonder if someone's riding it?",
  "status": "translated",
  "style": 0,
  "text_off": 888,
  "text_len": 49
 },
 {
  "id": "sce301:003AD",
  "jp": "トウヤ「そりゃ、乗るだろ」",
  "off": 941,
  "len": 17,
  "en": "Touya: Well, yeah, people ride it.",
  "status": "translated",
  "style": 0,
  "text_off": 943,
  "text_len": 14
 },
 {
  "id": "sce301:003C1",
  "jp": "ヤマト「でも、あたしが見るときはいつも止まってるよ。{nl}　しかもちょうどその階に」",
  "off": 961,
  "len": 46,
  "en": "Yamato: But whenever I look, it's always stopped. And right on this floor, too.",
  "status": "translated",
  "style": 0,
  "text_off": 963,
  "text_len": 43
 },
 {
  "id": "sce301:003F2",
  "jp": "トウヤ「気のせいだ。気のせい。それより‥‥」",
  "off": 1010,
  "len": 29,
  "en": "Touya: Your imagination. Just your imagination. More importantly...",
  "status": "translated",
  "style": 0,
  "text_off": 1012,
  "text_len": 26
 },
 {
  "id": "sce301:00419",
  "jp": "ヤマト「あっ、止まった」",
  "off": 1049,
  "len": 16,
  "en": "Yamato: Oh, it stopped.",
  "status": "translated",
  "style": 0,
  "text_off": 1051,
  "text_len": 13
 },
 {
  "id": "sce301:00433",
  "jp": "フェイン「はははははははっ！{nl}　愛する人を守る為、正義の刃が敵を撃つ！{nl}　赤い血潮を真っ赤に燃やし、それが男の生きる道！{nl}　正義と真実の男！{nl}　フェイィィン、ジィィン、バァァァリィオォォン‼{nl}　只今、推参！　正義のためなら‥‥死ねる」",
  "off": 1075,
  "len": 158,
  "en": "Fain: Hahahahahahaha! To protect the one I love, the blade of justice strikes the foe! Setting my red blood ablaze, such is the path a man must walk! The man of justice and truth! Faaaain, Jiiiin, Baaariooooon!! Now arriving! For justice... I would die.",
  "status": "translated",
  "style": 0,
  "text_off": 1077,
  "text_len": 155
 },
