  "status": "todo",
  "style": 0,
  "text_off": 2305,
  "text_len": 27
 },
 {
  "id": "sce262:00920",
  "jp": "フェイン「なにを！　俺はいたって健康そのもの！{nl}　病気になるほど軟弱にはできていない！{nl}　だっはっはっはっ！」",
  "off": 2336,
