  "text_off": 2338,
  "text_len": 66
 },
 {
  "id": "sce262:00968",
  "jp": "ヤマト「‥‥重傷ね」",
  "off": 2408,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2410,
  "text_len": 14
 },
 {
  "id": "sce262:00984",
  "jp": "フェイン「‥‥で、どうだった？　今回のは結構自信が{nl}　あるんだがな。いやぁ、自分の才能が怖いぜ」",
  "off": 2436,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2438,
  "text_len": 62
 },
 {
  "id": "sce262:009C8",
  "jp": "　なかなかいいんじゃねぇか{nl}　演歌みてぇだ",
  "off": 2504,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 128,
  "text_off": 2506,
  "text_len": 23
 },
 {
  "id": "sce262:009F1",
  "jp": "フェイン「だろ？　特に最後のとこなんか言ってる俺が{nl}　しびれるぐらいだからな」",
  "off": 2545,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2547,
  "text_len": 45
 },
 {
  "id": "sce262:00A24",
  "jp": "ヤマト「陶酔してる‥‥これはもう末期ね」",
  "off": 2596,
