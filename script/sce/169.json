  "text_len": 20
 },
 {
  "id": "sce169:01BD4",
  "jp": "ベイオ「ぐおっほん！　忙しそうじゃが{nl}　こっちもそんなことにかまっておれん。{page}　さっさと引き渡す‥‥と言いたいところじゃが、{nl}　タダでというワケにはいかん」",
  "off": 7124,
  "len": 91,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 7129,
  "text_len": 85
 },
 {
  "id": "sce169:01C2F",
  "jp": "メリッサ「博止‥‥？」",
  "off": 7215,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 7219,
  "text_len": 16
 },
 {
  "id": "sce169:01C44",
  "jp": "ベイオ「‥‥と言いたいところだが、今日のところは{nl}　特別に勘弁してやる！」",
  "off": 7236,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 7241,
  "text_len": 47
 },
 {
  "id": "sce169:01C7E",
  "jp": "ベイオ「なにをグズグズしている！　さっさと降りんか！」",
  "off": 7294,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 7299,
  "text_len": 30
 },
