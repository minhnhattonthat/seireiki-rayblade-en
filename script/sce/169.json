 },
 {
  "id": "sce169:00E25",
  "jp": "メリッサ「‥‥ええ。{nl}　会いたかったわ‥‥シィウチェン‥‥」",
  "off": 3621,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3625,
  "text_len": 37
 },
 {
  "id": "sce169:00E4F",
  "jp": "シィウチェン「俺もだ‥‥メリッサ」",
  "off": 3663,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3667,
  "text_len": 20
 },
 {
  "id": "sce169:00E68",
  "jp": "ベイオ「ぐおっほん！　忙しそうじゃが{nl}　こっちもそんなことにかまっておれん。{page}　さっさと引き渡す‥‥と言いたいところじゃが、{nl}　タダでというワケにはいかん」",
  "off": 3688,
  "len": 91,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 3693,
  "text_len": 85
 },
 {
  "id": "sce169:00EC3",
  "jp": "メリッサ「博止‥‥？」",
  "off": 3779,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3783,
  "text_len": 16
 },
 {
  "id": "sce169:00ED8",
  "jp": "ベイオ「ワシのバイン・ダーガに勝てたら返してやろう。{nl}　選択の権利はない。断#66Cっても問答無揖で{nl}　攻撃するからな！　以上、通信おわりだ！」",
  "off": 3800,
  "len": 94,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 3805,
  "text_len": 88
 },
 {
  "id": "sce169:00F36",
  "jp": "メリッサ「博止‥‥」",
  "off": 3894,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3898,
  "text_len": 14
 },
 {
  "id": "sce169:00F49",
  "jp": "ベイオ「ワシが一番バイン・ダーガをうまく操れるという{nl}　ことをみせてやる！　メリッサはそこでまっておれ。{nl}　ちなみにこの船は自動操縦に切り替えてある。{nl}　ワシの暗証番号を入力しなければ{nl}　空調すら変えることはできんぞ。{nl}　それではちょっと行ってくる」",
  "off": 3913,
  "len": 153,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 3918,
  "text_len": 147
 },
 {
  "id": "sce169:0100B",
  "jp": "ヤマト「トウヤ！　もうミサイルが発射しそうよ！」",
  "off": 4107,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 4112,
  "text_len": 28
 },
 {
  "id": "sce169:0102D",
  "jp": "トウヤ「‥‥ああ、わかってる。急ごう！」",
  "off": 4141,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4145,
  "text_len": 24
 },
 {
  "id": "sce169:01054",
  "jp": "セリカ「うそ‥‥間にあわなかった‥‥の？」",
  "off": 4180,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4184,
  "text_len": 27
 },
 {
  "id": "sce169:01074",
  "jp": "トウヤ「くっ‥‥」",
  "off": 4212,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4216,
  "text_len": 11
 },
 {
  "id": "sce169:0109F",
  "jp": "トウヤ「あれは‥‥」",
  "off": 4255,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4259,
  "text_len": 12
 },
 {
  "id": "sce169:010B0",
  "jp": "メル<E1>ィ「えっと、えっと‥‥これをこうして‥‥」",
  "off": 4272,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4276,
  "text_len": 28
 },
 {
  "id": "sce169:010D1",
  "jp": "ヤマト「メル<E1>ィ⁈」",
  "off": 4305,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 4310,
  "text_len": 11
 },
 {
  "id": "sce169:010E2",
  "jp": "トウヤ「いったい、いつの間に‥‥」",
  "off": 4322,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4326,
  "text_len": 20
 },
 {
  "id": "sce169:010FB",
  "jp": "メル<E1>ィ「う～ん‥‥あっ！　これだ！　えいっ」",
  "off": 4347,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4351,
  "text_len": 28
 },
 {
  "id": "sce169:0112A",
  "jp": "ヤマト「え？　これって電子共振？」",
  "off": 4394,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 4399,
  "text_len": 23
 },
 {
  "id": "sce169:01147",
  "jp": "トウヤ「‥‥俺にはなにも見えねぇし、{nl}　聞こえねぇけど‥‥」",
  "off": 4423,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4427,
  "text_len": 37
 },
 {
  "id": "sce169:01171",
  "jp": "ヤマト「あっ！　ニャるほど。制御機構を{nl}　逆に使ったのね！」",
  "off": 4465,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 4470,
  "text_len": 38
 },
 {
  "id": "sce169:0119D",
  "jp": "トウヤ「‥‥一人で納得するなよ。どういうことだ？{nl}　あっ、端的に言ってくれよ」",
  "off": 4509,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4513,
  "text_len": 49
 },
 {
  "id": "sce169:011D3",
  "jp": "ヤマト「‥‥ミサイルニャんかを制御する機構に{nl}　プラーニャを乗せて、施設にぶつけたのよ」",
  "off": 4563,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 4568,
  "text_len": 54
 },
 {
  "id": "sce169:0120F",
  "jp": "トウヤ「‥‥全然わからん」",
  "off": 4623,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4627,
  "text_len": 17
 },
 {
  "id": "sce169:01225",
  "jp": "ヤマト「要するに、指向性の電磁波を施設に浴びせて{nl}　制御機構だけを無力化したの。{nl}　これで、もう大丈夫ってことね」",
  "off": 4645,
  "len": 83,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 4650,
  "text_len": 77
 },
 {
  "id": "sce169:01278",
  "jp": "トウヤ「それってやっぱりすごいことじゃねぇのか？」",
  "off": 4728,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4732,
  "text_len": 26
 },
 {
  "id": "sce169:01297",
  "jp": "ヤマト「もちろん。こういう使い方もあるのねぇ～って{nl}　感心しちゃうわ。子供らしい柔ニャんさの賜物かもね」",
  "off": 4759,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 4764,
  "text_len": 62
 },
 {
  "id": "sce169:012DB",
  "jp": "トウヤ「まぁ、とにかく助かったってことか‥‥」",
  "off": 4827,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4831,
  "text_len": 26
 },
 {
  "id": "sce169:012FA",
  "jp": "シュテイニーズ「ちっ！」",
  "off": 4858,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4862,
  "text_len": 14
 },
 {
  "id": "sce169:01330",
  "jp": "ベイオ「ふ、ふん‥‥今日のところはこれぐらいで{nl}　勘弁してやる！」",
  "off": 4912,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4916,
  "text_len": 40
 },
