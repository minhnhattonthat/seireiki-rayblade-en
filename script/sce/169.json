  "len": 19,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 7334,
  "text_len": 14
 },
 {
  "id": "sce169:01CB5",
  "jp": "ベイオ「“どらいぶ”はここで終わりだ。{nl}　ここがお前の終点。帰るべき場所だ」",
  "off": 7349,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 7354,
  "text_len": 47
 },
