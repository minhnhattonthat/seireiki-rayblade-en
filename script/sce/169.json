  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 8148,
  "text_len": 18
 },
 {
  "id": "sce169:01FE7",
  "jp": "トウヤ「おいおい、なんかヤバくないか？」",
  "off": 8167,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 8171,
  "text_len": 21
 },
 {
  "id": "sce169:02001",
  "jp": "ヤマト「うそ！　まだ時間あるのに‥‥{nl}　まさか無理矢理発射するつもり⁈」",
  "off": 8193,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 8198,
  "text_len": 48
 },
 {
  "id": "sce169:02075",
  "jp": "ヤマト「着弾点はズレるけど‥‥アガルティア王麹に{nl}　被害を与えることはできるでしょうね」",
  "off": 8309,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 8314,
  "text_len": 54
 },
 {
  "id": "sce169:020B1",
  "jp": "トウヤ「おい、どうにかできねぇのか⁈」",
  "off": 8369,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 8373,
  "text_len": 20
 },
 {
  "id": "sce169:020CA",
  "jp": "ヤマト「あの制御施設だけを破壊できたら‥‥{nl}　でも下手したらミサイルが誘爆する可能性もあるわ」",
  "off": 8394,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 8399,
  "text_len": 62
 },
 {
  "id": "sce169:0210E",
