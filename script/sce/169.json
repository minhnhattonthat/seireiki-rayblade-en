  "status": "todo",
  "style": 1,
  "text_off": 7406,
  "text_len": 29
 },
 {
  "id": "sce169:01D0C",
  "jp": "ベイオ「う、うむ‥‥た、達者でな‥‥」",
  "off": 7436,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 7441,
  "text_len": 25
 },
