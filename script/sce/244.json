  "status": "todo",
  "style": 0,
  "text_off": 2847,
  "text_len": 27
 },
 {
  "id": "sce244:00B3E",
  "jp": "リーモンド「そんなつれないことを‥‥{nl}　あなたに逢うためじゃ‥‥」",
  "off": 2878,
