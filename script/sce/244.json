[
 {
  "id": "sce244:00046",
  "jp": "フォレス「‥‥閣下。本当に聖霊機の方は{nl}　放置しておいてよろしいのですか？{nl}　あのライブレードも起動したと聞きます。{nl}　危険ではありませんか？」",
  "off": 70,
  "len": 95,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 72,
  "text_len": 92
 },
 {
  "id": "sce244:000A8",
  "jp": "グロウスター「ふん、あんなものおおげさな田承が残って{nl}　美化されているにすぎん。第一、戦況はたった一機の{nl}　装兵機でどうこうなるものではない。{nl}　讐要なのはそれに乗る兵止の質と気合だ。{nl}　それは聖霊機とて同じこと」",
  "off": 168,
  "len": 137,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 170,
  "text_len": 134
 },
 {
  "id": "sce244:00134",
  "jp": "フォレス「かしこまりました‥‥」",
  "off": 308,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 310,
  "text_len": 18
 },
 {
  "id": "sce244:0014C",
  "jp": "グロウスター「‥‥どうした。{nl}　揖向きはそれだけではないのであろう？」",
  "off": 332,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 334,
  "text_len": 41
 },
 {
  "id": "sce244:0017B",
  "jp": "フォレス「はっ‥‥なぜ、先陣をファルモア大尉に{nl}　お任せになられたのか、その真意をお聞かせ願いたい{nl}　のですが‥‥同胞を侮辱するようなのですが、{nl}　大尉は目的の為なら手段を選ばない男です。{nl}　優秀ではありますが、なにをするかわからない危険性を{nl}　もっています」",
  "off": 379,
  "len": 164,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 381,
  "text_len": 161
 },
 {
  "id": "sce244:00222",
  "jp": "グロウスター「ワシもあやつのことは耳にしている。{nl}　グラードの軍への復帰に関しても脅迫まがいのことを{nl}　したともな。だが、ああいう男も使いようなのだ。{nl}　綺麗事だけでは麹も軍も動かせぬ」",
  "off": 546,
  "len": 113,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 548,
  "text_len": 110
 },
 {
  "id": "sce244:00296",
  "jp": "フォレス「それはわかっていますが‥‥」",
  "off": 662,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 664,
  "text_len": 21
 },
 {
  "id": "sce244:002B1",
  "jp": "グロウスター「心配するな。だからこそ君の{nl}　お気に入りであるダライム中尉をつけるのだからな」",
  "off": 689,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 691,
  "text_len": 54
 },
 {
  "id": "sce244:002ED",
  "jp": "フォレス「なっ⁉　だ、誰があんな‥‥」",
  "off": 749,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 751,
  "text_len": 23
 },
 {
  "id": "sce244:0030A",
  "jp": "グロウスター「ははははっ！　照れるな。{nl}　ワシは軍人に男も女もないとは思っておるが、{nl}　結婚し、子を産むことは女にしかできん特権だ。{nl}　お前もそろそろ‥‥」",
  "off": 778,
  "len": 99,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 780,
  "text_len": 96
 },
 {
  "id": "sce244:00370",
  "jp": "フォレス「閣下！」",
  "off": 880,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 882,
  "text_len": 12
 },
 {
  "id": "sce244:00382",
  "jp": "グロウスター「そう努るな。別に退役しろと{nl}　言っているのではないぞ」",
  "off": 898,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 900,
  "text_len": 40
 },
 {
  "id": "sce244:003B0",
  "jp": "フォレス「わかっています！　それに私は‥‥」",
  "off": 944,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 946,
  "text_len": 26
 },
 {
  "id": "sce244:003D0",
  "jp": "グロウスター「まんざらでもないのであろう？」",
  "off": 976,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 978,
  "text_len": 24
 },
 {
  "id": "sce244:003EE",
  "jp": "フォレス「閣下っ⁉」",
  "off": 1006,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1008,
  "text_len": 13
 },
 {
  "id": "sce244:00401",
  "jp": "グロウスター「がっはっはっはっはっ！{nl}　‥‥とにかく、我々は軍人の本分を果たすべく{nl}　麹の決定に従うまでだ。{nl}　今回ばかりはあの昼行灯に感謝せねばならんな。{nl}　ようやく、レビオスの奴めと決着をつけることができる。{nl}　こんなに遅くなったのもあの昼行灯のせいだ。{nl}　うむ。あやつがのんびりとしておるからアガルティアの{nl}　奴等になめられるのだ！」",
  "off": 1025,
  "len": 204,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1027,
  "text_len": 201
 },
 {
  "id": "sce244:004D0",
  "jp": "フォレス（こ、この展開は‥‥閣下の愚痴の‥‥）",
  "off": 1232,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1234,
  "text_len": 33
 },
 {
  "id": "sce244:004FC",
  "jp": "グロウスター「それにしてもあの男はこんな時に{nl}　のんびり別荘とは‥‥麹家元首がいったいなにを{nl}　やっておるのだ⁉」",
  "off": 1276,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1278,
  "text_len": 69
 },
 {
  "id": "sce244:00547",
  "jp": "フォレス（‥‥やっぱり‥‥）",
  "off": 1351,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1353,
  "text_len": 18
 },
 {
  "id": "sce244:0055F",
  "jp": "グロウスター「だいたいあんな親の七光で政界へ{nl}　入った奴に麹家元首たる大統領に就任させること{nl}　自体大きな間違いなのだ。やれ椙祉だ慈善事業だと{nl}　麹民の人気取りばかりに終始しおって、そして{nl}　当選したらどうだ？　奴がまっさきにしたことは{nl}　あの別荘を建てることだぞ？　名目はどうあれ、{nl}　やっていることは公費を使って自分の好き勝手に{nl}　しているにすぎん！　公約は口約と化し、{nl}　気持ち程度しか行おうとせん。{nl}　いつの時代もそうだが、あやつは特にひどい。{nl}　あれにくらべると今までのボンクラどものほうが{nl}　いくらもマシだ。{nl}　そもそもあやつぐらいだぞ、執務室で昼寝をするのは！{nl}　政治家どもは自分の利益しか顧みず、{nl}　業者と癒着し、汚職まみれ。{nl}　大統領は公費を平然と私揖に浪費する。{nl}　いったいどうなるんだ、この麹は⁈{nl}　なあ、お前もそう思わんか⁈　えぇ⁉」",
  "off": 1375,
  "len": 487,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1377,
  "text_len": 484
 },
 {
  "id": "sce244:00749",
  "jp": "フォレス「‥‥は、はぁ。そう思います‥‥」",
  "off": 1865,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1867,
  "text_len": 26
 },
 {
  "id": "sce244:00769",
  "jp": "グロウスター「いや、お前はまだわかっておらん。{nl}　よし、今日はじっくりと話してやろう。{nl}　ホラ、そこに座れ」",
  "off": 1897,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1899,
  "text_len": 60
 },
 {
  "id": "sce244:007AB",
  "jp": "フォレス「い、いえ、私は‥‥あっ」",
  "off": 1963,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1965,
  "text_len": 20
 },
 {
  "id": "sce244:007D1",
  "jp": "グロウスター「さて、どこまで話したかな？{nl}　おぉ、この麹の行く末についてだったな。{nl}　そもそも‥‥」",
  "off": 2001,
  "len": 61,
  "en": "",
  "status": "todo",
  "style": 0,
