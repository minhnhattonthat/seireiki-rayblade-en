  "status": "todo",
  "style": 0,
  "text_off": 3100,
  "text_len": 12
 },
 {
  "id": "sce244:00C2C",
  "jp": "リーモンド「痛い‥‥あ、あれ？　中佐、どちらに？」",
  "off": 3116,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3118,
  "text_len": 33
 },
 {
  "id": "sce244:00C53",
  "jp": "フォレス「ど、どこだってよかろう！」",
  "off": 3155,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3157,
  "text_len": 19
 },
 {
  "id": "sce244:00C6C",
  "jp": "リーモンド「ああ！　なるほど。トイレですか」",
