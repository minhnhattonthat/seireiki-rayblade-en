  "off": 547,
  "len": 11,
  "en": "Touya: Huh?",
  "status": "translated",
  "style": 0,
  "text_off": 549,
  "text_len": 8
 },
 {
  "id": "sce269:00231",
  "jp": "フェイン「このまま確執を抱いたまま別れるのは性に{nl}　合わん。だから、仲直りだ」",
  "off": 561,
  "len": 50,
  "en": "Fain: Parting ways with a grudge between us isn't my style. So, we make up.",
  "status": "translated",
  "style": 0,
  "text_off": 563,
  "text_len": 47
 },
 {
