 },
 {
  "id": "sce334:00704",
  "jp": "アーサー「‥‥え？　そ、そうですか？　残念ですね‥‥」",
  "off": 1796,
  "len": 40,
  "en": "Arthur: ...Eh? I-Is that so? What a shame...",
  "status": "translated",
  "style": 0,
  "text_off": 1798,
  "text_len": 37
 },
 {
  "id": "sce334:0072F",
  "jp": "トウヤ「また今度な。それじゃ！」",
  "off": 1839,
  "len": 22,
  "en": "Touya: Some other time. See ya!",
  "status": "translated",
  "style": 0,
  "text_off": 1841,
  "text_len": 19
 },
 {
  "id": "sce334:00756",
  "jp": "トウヤ「いや、その‥‥」",
  "off": 1878,
  "len": 17,
  "en": "Touya: No, uh...",
  "status": "translated",
  "style": 0,
  "text_off": 1880,
  "text_len": 14
 },
 {
  "id": "sce334:00770",
  "jp": "アーサー「ふふふ‥‥そうですか、やはり私の話を{nl}　聞きたい、ということですね。{nl}　わかりました。ではそこに座ってください」",
  "off": 1904,
  "len": 72,
  "en": "Arthur: Fufufu... I see, so you would like to hear my talk after all. Very well. Then please, have a seat there.",
  "status": "translated",
  "style": 0,
  "text_off": 1906,
  "text_len": 69
 },
 {
  "id": "sce334:007BB",
  "jp": "トウヤ「あ、ああ‥‥」",
  "off": 1979,
  "len": 16,
  "en": "Touya: Oh, r-right...",
  "status": "translated",
  "style": 0,
  "text_off": 1981,
  "text_len": 13
 },
 {
  "id": "sce334:007CE",
  "jp": "アーサー「えー、どこまで話したかわかりませんから、{nl}　また最初から話しますね‥‥」",
  "off": 1998,
  "len": 53,
  "en": "Arthur: Now, I'm not sure where I left off, so I'll start again from the beginning...",
  "status": "translated",
  "style": 0,
