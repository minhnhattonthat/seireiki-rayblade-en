[
 {
  "id": "sce334:00376",
  "jp": "アーサー「おや、トウヤじゃないですか。{nl}　どうかしましたか？」",
  "off": 886,
  "len": 37,
  "en": "Arthur: Oh, if it isn't Touya. Is something the matter?",
  "status": "translated",
  "style": 0,
  "text_off": 888,
  "text_len": 34
 },
 {
  "id": "sce334:003A3",
  "jp": "トウヤ「ああ。ちょっと質問があってな」",
  "off": 931,
  "len": 24,
  "en": "Touya: Yeah. I've got a question.",
  "status": "translated",
  "style": 0,
  "text_off": 933,
  "text_len": 21
 },
 {
  "id": "sce334:003C4",
  "jp": "アーサー「なんでしょう？　私に答えられることなら{nl}　いいのですが‥‥」",
  "off": 964,
  "len": 45,
  "en": "Arthur: What might that be? I hope it is something I can answer...",
  "status": "translated",
  "style": 0,
  "text_off": 966,
  "text_len": 42
 },
 {
  "id": "sce334:003F4",
  "jp": "トウヤ「読書のことだよ」",
  "off": 1012,
  "len": 17,
  "en": "Touya: It's about reading.",
  "status": "translated",
  "style": 0,
  "text_off": 1014,
  "text_len": 14
 },
 {
  "id": "sce334:00408",
  "jp": "アーサー「？」",
  "off": 1032,
  "len": 13,
  "en": "Arthur: ?",
  "status": "translated",
  "style": 0,
  "text_off": 1034,
  "text_len": 10
 },
 {
  "id": "sce334:00418",
  "jp": "トウヤ「この前に来たときも本を読んでたろ？{nl}　そんなに楽しいかなぁ‥‥って思ってな」",
  "off": 1048,
  "len": 54,
  "en": "Touya: You were reading a book the last time I came by too, right? I just wondered if it's really that fun...",
  "status": "translated",
  "style": 0,
  "text_off": 1050,
  "text_len": 51
 },
 {
  "id": "sce334:00451",
  "jp": "アーサー「‥‥」",
  "off": 1105,
  "len": 15,
  "en": "Arthur: ...",
  "status": "translated",
  "style": 0,
  "text_off": 1107,
  "text_len": 12
 },
 {
  "id": "sce334:00463",
  "jp": "トウヤ「‥‥？」",
  "off": 1123,
  "len": 14,
  "en": "Touya: ...?",
  "status": "translated",
  "style": 0,
  "text_off": 1125,
  "text_len": 11
 },
 {
  "id": "sce334:00474",
  "jp": "アーサー「なんと‥‥本は先人達の知恵の宝庫。{nl}　人類の宝ともいえるものです。{nl}　そもそも、人が言葉ではなく、文字というものを{nl}　会得したその瞬間からそのことは必然の出来事として{nl}　人類の偉大なる功績のひとつとして{nl}　歩み始めたのです‥‥たとえばですね‥‥」",
  "off": 1140,
  "len": 172,
  "en": "Arthur: Good heavens... Books are a treasure trove of our predecessors' wisdom. One could call them the treasure of humankind. Indeed, from the very moment people mastered not just speech but writing, this became an inevitability, and set out on its path as one of humanity's great achievements... For example, you see...",
  "status": "translated",
  "style": 0,
  "text_off": 1142,
  "text_len": 169
 },
 {
  "id": "sce334:00523",
  "jp": "ヤマト「ニャ、ニャんかこのはニャし、{nl}　すごくニャがそうニャ気が‥‥」",
  "off": 1315,
  "len": 41,
  "en": "Yamato: Nya-nyo, I have a feeling this story's going to be awfully lo-o-ong, nya...",
  "status": "translated",
  "style": 0,
  "text_off": 1317,
  "text_len": 38
 },
 {
  "id": "sce334:0054F",
  "jp": "　黙って聞く{nl}　断る",
  "off": 1359,
  "len": 16,
  "en": "Listen quietly{nl}Decline",
  "status": "translated",
  "style": 128,
  "text_off": 1361,
  "text_len": 13
 },
