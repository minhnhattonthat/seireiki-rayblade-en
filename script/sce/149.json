  "status": "todo",
  "style": 0,
  "text_off": 3143,
  "text_len": 23
 },
 {
  "id": "sce149:00C62",
  "jp": "メリッサ「はい、博止」",
  "off": 3170,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3172,
  "text_len": 13
 },
 {
  "id": "sce149:00C9D",
  "jp": "クロビス「‥‥やっぱり動かんか。{nl}　男同止じゃダメみたいだな」",
  "off": 3229,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3231,
  "text_len": 37
 },
 {
  "id": "sce149:00CC8",
  "jp": "レオーネ「へー、ライブレードの中ってこーなってるのかぁ」",
  "off": 3272,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3274,
  "text_len": 33
 },
 {
  "id": "sce149:00CEF",
  "jp": "トウヤ「おい、勝手にはいってくるなよ！」",
  "off": 3311,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3313,
  "text_len": 23
 },
 {
  "id": "sce149:00D0C",
  "jp": "レオーネ「別にいいじゃない。減るもんじゃなし」",
  "off": 3340,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3342,
  "text_len": 26
 },
 {
  "id": "sce149:00D2C",
  "jp": "トウヤ「そういう問題じゃねぇ！　ほら降りるぞ」",
  "off": 3372,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3374,
  "text_len": 27
 },
 {
  "id": "sce149:00D69",
  "jp": "ユミール「どうやら、トウヤと女性操者の組み合わせでしか{nl}　動かせないみたいね。セリカはどう思う？」",
  "off": 3433,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3435,
  "text_len": 59
 },
 {
  "id": "sce149:00DAA",
  "jp": "セリカ「‥‥」",
  "off": 3498,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3500,
  "text_len": 9
 },
 {
  "id": "sce149:00DB9",
  "jp": "ユミール「セリカ？」",
  "off": 3513,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3515,
  "text_len": 12
 },
 {
  "id": "sce149:00DCB",
  "jp": "セリカ「え⁈　あ、うん‥‥」",
  "off": 3531,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3533,
  "text_len": 17
 },
 {
  "id": "sce149:00DFC",
  "jp": "アイ「いったいどうしたの？{nl}　なんか戻ってきてから様子がヘンよ」",
  "off": 3580,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3582,
  "text_len": 36
 },
 {
  "id": "sce149:00E26",
  "jp": "セリカ「そ、そんなこと‥‥ない‥‥よ」",
  "off": 3622,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3624,
  "text_len": 23
 },
 {
  "id": "sce149:00E5C",
  "jp": "アイ「‥‥どうしてトウヤのほうを見るのよ？{nl}　ちょっと、あんたセリカになにしたの？」",
  "off": 3676,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3678,
  "text_len": 47
 },
 {
  "id": "sce149:00E91",
  "jp": "トウヤ「え⁉　な、なにって‥‥べ、別に‥‥{nl}　ただ、プラーナを梢費しすぎた俺をだな‥‥」",
  "off": 3729,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3731,
  "text_len": 56
 },
 {
  "id": "sce149:00EE1",
  "jp": "アイ「プラーナ？　たしかにさっきのプラーナは{nl}　すごかったけど‥‥」",
  "off": 3809,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3811,
  "text_len": 39
 },
 {
  "id": "sce149:00F20",
  "jp": "ユミール「セリカ、あなた‥‥」",
  "off": 3872,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3874,
  "text_len": 18
 },
 {
  "id": "sce149:00F38",
  "jp": "セリカ「そ、それじゃ、私揖事があるから！」",
  "off": 3896,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3898,
  "text_len": 25
 },
 {
  "id": "sce149:00F76",
  "jp": "アイ「‥‥」",
  "off": 3958,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3960,
  "text_len": 8
 },
 {
  "id": "sce149:00F92",
  "jp": "クロビス「別に詮索するつもりはないが、{nl}　ちゃんとケジメはつけろよ。中途半端にしておくのは{nl}　男として最低の行為だぞ」",
  "off": 3986,
  "len": 74,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3988,
  "text_len": 71
 },
 {
  "id": "sce149:00FDF",
  "jp": "ユミール「‥‥」",
  "off": 4063,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4065,
  "text_len": 11
 },
 {
  "id": "sce149:00FF0",
  "jp": "クロビス「ん？　まてよ、ライブレードにはお前と女しか{nl}　乗れない‥‥おまえなにか仕組んでるだろ？」",
  "off": 4080,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4082,
  "text_len": 59
 },
 {
  "id": "sce149:01031",
  "jp": "トウヤ「は、はぁ？　知るかよ、{nl}　だいたいなにするってんだ？」",
  "off": 4145,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4147,
  "text_len": 34
 },
 {
  "id": "sce149:01059",
  "jp": "カスミ「不思議よね‥‥」",
  "off": 4185,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4187,
  "text_len": 17
 },
 {
  "id": "sce149:01070",
  "jp": "アーサー「とりあえず動くことは確認されたわけですから、{nl}　今後はトウヤとアイ、カスミ、オーレリィそしてセリカの{nl}　誰かとペアで出撃することになりますね」",
  "off": 4208,
  "len": 90,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4210,
  "text_len": 87
 },
 {
  "id": "sce149:010D9",
  "jp": "フェイン「そのぶん、聖霊機が一機減るが、{nl}　ライブレードの性能を考えると戦力的には{nl}　問題ないだろう」",
  "off": 4313,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4315,
  "text_len": 66
 },
 {
  "id": "sce149:01121",
  "jp": "アイ「あんたにしてはまともな意見ね」",
  "off": 4385,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4387,
  "text_len": 20
 },
 {
  "id": "sce149:0113B",
  "jp": "フェイン「‥‥どういう意味だ⁉」",
  "off": 4411,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4413,
  "text_len": 21
 },
 {
  "id": "sce149:01156",
  "jp": "アイ「別に」",
  "off": 4438,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4440,
  "text_len": 7
 },
 {
  "id": "sce149:01163",
  "jp": "フェイン「あーっ！　なんなのだ、その態度⁉」",
  "off": 4451,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4453,
  "text_len": 27
 },
 {
  "id": "sce149:01190",
  "jp": "オーレリィ「はいはい、二人ともそれぐらいにしときな。{nl}　‥‥アイ、どうしたのさ？　そういうのあまり感心しないよ」",
  "off": 4496,
  "len": 67,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4498,
  "text_len": 64
 },
 {
  "id": "sce149:011D6",
  "jp": "アイ「なによ。ただ思ったことを言っただけでしょ」",
  "off": 4566,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4568,
  "text_len": 26
 },
 {
  "id": "sce149:01208",
  "jp": "オーレリィ「あんたがイラつくのは勝手だけど、{nl}　誰かに当たるのはよしな。そんなだと嫌われるよ」",
  "off": 4616,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4618,
  "text_len": 53
 },
 {
  "id": "sce149:01243",
  "jp": "アイ「あ、あたしがいつイラついたって言うのよ！{nl}　わかったふうなこと言わないでよね！」",
  "off": 4675,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4677,
  "text_len": 47
 },
 {
  "id": "sce149:0129D",
  "jp": "オーレリィ「やれやれ、もっと素直になればいいのに‥‥{nl}　ね、トウヤ」",
  "off": 4765,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4767,
  "text_len": 39
 },
 {
  "id": "sce149:012CA",
  "jp": "トウヤ「なんで俺に振るんだ？」",
  "off": 4810,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4812,
  "text_len": 18
 },
 {
  "id": "sce149:012E2",
  "jp": "クロビス「はははは！　ま、トウヤに言っても無駄だな。{nl}　それよりメシにしようぜ、メシに！」",
  "off": 4834,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4836,
  "text_len": 50
 },
 {
  "id": "sce149:0131A",
  "jp": "フェイン「そうだな。今日はシスクの当番だったからな。{nl}　あいつの料理の腕はプロ級#3FEだし、楽しみだなぁ」",
  "off": 4890,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4892,
  "text_len": 59
 },
 {
  "id": "sce149:0135B",
  "jp": "アーサー「それじゃ行きましょうか」",
  "off": 4955,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4957,
  "text_len": 20
 },
 {
  "id": "sce149:0138B",
  "jp": "レオーネ「ね、ね、キミ、モテモテだね」",
  "off": 5003,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5005,
  "text_len": 20
 },
 {
  "id": "sce149:013A5",
  "jp": "トウヤ「はぁ？　しょーもないこと言ってると置いていくぞ」",
  "off": 5029,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5031,
  "text_len": 32
 },
 {
  "id": "sce149:013DD",
  "jp": "レオーネ「あっ、ちょっとまってよ！{nl}　ボクも食べるっ！」",
  "off": 5085,
  "len": 35,
  "en": "",
  "status": "todo",
