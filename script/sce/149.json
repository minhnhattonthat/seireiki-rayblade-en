[
 {
  "id": "sce149:00047",
  "jp": "ユミール「わざわざ、すみません」",
  "off": 71,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 73,
  "text_len": 17
 },
 {
  "id": "sce149:00068",
  "jp": "レスト「いえ。しかし、先程の機体、{nl}　まだ本来の力を出してはいないようでした‥‥{nl}　いったいどれほどの力を持っているのか‥‥」",
  "off": 104,
  "len": 80,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 106,
  "text_len": 77
 },
 {
  "id": "sce149:000C2",
  "jp": "フェイン「師匠！」",
  "off": 194,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 196,
  "text_len": 12
 },
 {
  "id": "sce149:000D4",
  "jp": "レスト「フェインか。少し背が伸びたか？」",
  "off": 212,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 214,
  "text_len": 24
 },
 {
  "id": "sce149:000F2",
  "jp": "フェイン「あれから半年以上たちます。{nl}　伸びたのは身長だけではありません」",
  "off": 242,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 244,
  "text_len": 44
 },
 {
  "id": "sce149:00124",
  "jp": "レスト「ほぅ‥‥言うようになったではないか。{nl}　どれほど腕をあげたか見てやりたいが、{nl}　陛下への報告がある。それはまた次の機会にしよう」",
  "off": 292,
  "len": 83,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 294,
  "text_len": 80
 },
 {
  "id": "sce149:0017A",
  "jp": "フェイン「はい！」",
  "off": 378,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 380,
  "text_len": 10
 },
 {
  "id": "sce149:0018A",
  "jp": "ミヤスコ「‥‥レスト様‥‥」",
  "off": 394,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 396,
  "text_len": 19
 },
 {
  "id": "sce149:001A3",
  "jp": "レスト「ミヤスコも元気そうでなによりだ。{nl}　身体のほうは大丈夫か？」",
  "off": 419,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 421,
  "text_len": 42
 },
 {
  "id": "sce149:001D3",
  "jp": "ミヤスコ「は、はい。あ、あの‥‥」",
  "off": 467,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 469,
  "text_len": 19
 },
 {
  "id": "sce149:001F6",
  "jp": "マキ「レストぉ～！」",
  "off": 502,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 504,
  "text_len": 12
 },
 {
  "id": "sce149:00220",
  "jp": "レスト「おわっ！　マ、マキ！　君がどうして‥‥？」",
  "off": 544,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 546,
  "text_len": 31
 },
 {
  "id": "sce149:00245",
  "jp": "マキ「もちろん取材よ！{nl}　さっきの戦いもバッチリ記録させてもらったわ」",
  "off": 581,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 583,
  "text_len": 41
 },
 {
  "id": "sce149:00274",
  "jp": "レスト「そ、そうか‥‥」",
  "off": 628,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 630,
  "text_len": 14
 },
 {
  "id": "sce149:00288",
  "jp": "マキ「レストこそどうしてここへ？{nl}　あーっ！　私に逢いたくなったとか？」",
  "off": 648,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 650,
  "text_len": 42
 },
 {
  "id": "sce149:002B8",
  "jp": "レスト「ふっ‥‥相変わらずだな。{nl}　そういうことにしてもいいが、私は公人としてここにいる。{nl}　たとえこのリーボーフェンが聖地所属の組織とはいえ、{nl}　王都の近くで戦闘行動をおこしたのだ。{nl}　私はそれを調べ、陛下に報告する義務がある」",
  "off": 696,
  "len": 148,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 698,
  "text_len": 145
 },
 {
  "id": "sce149:0034F",
  "jp": "マキ「なーんだ。つまんないの。{nl}　久しぶりに恋人に逢ったっていうのに、冷たいのね。{nl}　でもそういうところがまたいいのよねぇ～」",
  "off": 847,
  "len": 73,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 849,
  "text_len": 70
 },
 {
  "id": "sce149:0039B",
  "jp": "ミヤスコ「‥‥」",
  "off": 923,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 925,
  "text_len": 10
 },
 {
  "id": "sce149:003AB",
  "jp": "マキ「‥‥ねぇ、彼女とは知り合い？」",
  "off": 939,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 941,
  "text_len": 25
 },
 {
  "id": "sce149:003CA",
  "jp": "レスト「ん？　ああ。そうだが、それがどうかしたか？」",
  "off": 970,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 972,
  "text_len": 28
 },
 {
  "id": "sce149:003EC",
  "jp": "マキ「ねぇ、あなた、レストとはどういう関係？」",
  "off": 1004,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1006,
  "text_len": 26
 },
 {
  "id": "sce149:0040C",
  "jp": "ミヤスコ「え⁉　ど、どういうって‥‥{nl}　昔、助けてもらって‥‥」",
  "off": 1036,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1038,
  "text_len": 39
 },
 {
  "id": "sce149:00439",
  "jp": "マキ「なるほど。それで惚れちゃったってワケね。{nl}　でも盗っちゃダメよ」",
  "off": 1081,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1083,
  "text_len": 37
 },
 {
  "id": "sce149:00464",
  "jp": "ミヤスコ「そ、そんな、盗るなんて‥‥」",
  "off": 1124,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1126,
  "text_len": 22
 },
 {
  "id": "sce149:00480",
  "jp": "レスト「おいおい‥‥」",
  "off": 1152,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1154,
  "text_len": 13
 },
 {
  "id": "sce149:00493",
  "jp": "マキ「まぁ、人を想う気持ちってのは{nl}　他人がどうこうできるもんじゃないからね。{nl}　それにレストってカッコいいからモテるのはしかたないし。{nl}　でも今は私のモノ。私達の間には{nl}　誰も入り込めないわよ」",
  "off": 1171,
  "len": 115,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1173,
  "text_len": 112
 },
 {
  "id": "sce149:00509",
  "jp": "シスク「すごい自信‥‥」",
  "off": 1289,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1291,
  "text_len": 16
 },
 {
  "id": "sce149:0051F",
  "jp": "レスト「‥‥マキ、私がそんなに信じられないのか？」",
  "off": 1311,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1313,
  "text_len": 30
 },
 {
  "id": "sce149:00543",
  "jp": "マキ「え？　う、ううん、そんなこと‥‥」",
  "off": 1347,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1349,
  "text_len": 23
 },
 {
  "id": "sce149:00560",
  "jp": "レスト「ならば彼女にあたるのはよせ。{nl}　そういうお前は好きではないな」",
  "off": 1376,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1378,
  "text_len": 39
 },
 {
  "id": "sce149:0058D",
  "jp": "マキ「あっ‥‥ご、ごめんなさい‥‥」",
  "off": 1421,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1423,
  "text_len": 22
 },
 {
  "id": "sce149:005A9",
  "jp": "レスト「あやまる相手が違うぞ」",
  "off": 1449,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1451,
  "text_len": 18
 },
 {
  "id": "sce149:005C1",
  "jp": "マキ「あ、あの‥‥ごめんね。{nl}　私ってすぐ攻撃的になっちゃうから‥‥」",
  "off": 1473,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1475,
  "text_len": 43
 },
 {
  "id": "sce149:005F2",
  "jp": "ミヤスコ「い、いえ‥‥」",
  "off": 1522,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1524,
  "text_len": 14
 },
 {
  "id": "sce149:00606",
  "jp": "レスト「さて、大体の事情は聞いたし、君達に{nl}　非はないことは明白だ。陛下へはその旨を報告し、{nl}　議会にも働きかけることを約束しよう」",
  "off": 1542,
  "len": 89,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1544,
  "text_len": 86
 },
 {
  "id": "sce149:00662",
  "jp": "ユミール「ありがとうございます」",
  "off": 1634,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1636,
  "text_len": 17
 },
 {
  "id": "sce149:00679",
  "jp": "レスト「トウヤ君。君からは強いプラーナを感じる。{nl}　だが、強すぎるがゆえに闇へと取り込まれることもある。{nl}　その力、よき方向につかってほしい‥‥{nl}　それでは失礼する」",
  "off": 1657,
  "len": 102,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1659,
  "text_len": 99
 },
 {
  "id": "sce149:006E6",
  "jp": "マキ「あ‥‥」",
  "off": 1766,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1768,
  "text_len": 9
 },
 {
  "id": "sce149:00703",
  "jp": "レスト「おっと、一つ忘れ物をした」",
  "off": 1795,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1797,
  "text_len": 20
 },
 {
  "id": "sce149:0071D",
  "jp": "マキ「あっ、ちょっ‥‥ン」",
  "off": 1821,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1823,
  "text_len": 15
 },
 {
  "id": "sce149:00732",
  "jp": "ミヤスコ「‼」",
  "off": 1842,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1844,
  "text_len": 8
 },
 {
  "id": "sce149:00740",
  "jp": "シスク「うわぁ～」",
  "off": 1856,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1858,
  "text_len": 10
 },
 {
  "id": "sce149:00750",
  "jp": "デロック「情熱的なんだな。あれは大人のキスなんだな」",
  "off": 1872,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1874,
  "text_len": 31
 },
 {
  "id": "sce149:00775",
  "jp": "マキ「ンン‥‥も、もぅ‥‥」",
  "off": 1909,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1911,
  "text_len": 18
 },
 {
  "id": "sce149:0078D",
  "jp": "レスト「では行ってくる」",
  "off": 1933,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1935,
  "text_len": 13
 },
 {
  "id": "sce149:007A0",
  "jp": "マキ「‥‥うん。頑張って‥‥」",
  "off": 1952,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1954,
  "text_len": 21
 },
 {
  "id": "sce149:007BB",
  "jp": "レスト「ああ」",
  "off": 1979,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1981,
  "text_len": 7
 },
 {
  "id": "sce149:007D5",
  "jp": "トウヤ「‥‥なんかすごい人だな、お前の師匠って」",
  "off": 2005,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2007,
  "text_len": 30
 },
 {
  "id": "sce149:00803",
  "jp": "フェイン「ふふふ、当然だ。ガリュード様と同じ{nl}　“剣煌（けんこう）”の称号をもつ、{nl}　マリエ・クリスティル様にただ一人師事した騎止、{nl}　そして、アガルティア王宮騎止断の実質的な{nl}　筆頭にしてアガルティア王麹最強の騎止。{nl}　それが師匠だからな！　どうだ！　恐れ入ったか？」",
  "off": 2051,
  "len": 179,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2053,
  "text_len": 176
 },
 {
  "id": "sce149:008B9",
  "jp": "トウヤ「おまえが偉そうにしてどうする？」",
  "off": 2233,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2235,
  "text_len": 22
 },
 {
  "id": "sce149:008D5",
  "jp": "フェイン「師匠と弟子は一心同体。{nl}　師匠の名誉は弟子の名誉だ！」",
  "off": 2261,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2263,
  "text_len": 49
 },
 {
  "id": "sce149:0090C",
  "jp": "トウヤ「よくわからん理屈‥‥」",
  "off": 2316,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2318,
  "text_len": 19
 },
 {
  "id": "sce149:00935",
  "jp": "マキ「さて、私も仕事仕事‥‥」",
  "off": 2357,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2359,
  "text_len": 22
 },
 {
  "id": "sce149:00951",
  "jp": "トウヤ「今度はなにをする気だ？」",
  "off": 2385,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2387,
  "text_len": 20
 },
 {
  "id": "sce149:0096B",
  "jp": "マキ「心配しないでよ。あなた達が＜ゼ＝オード＞と{nl}　本気で戦おうとしていることはわかったし、{nl}　ちゃんと真実を報道するだけよ。{nl}　あなた達といたら特ダネをものにできそうだし、{nl}　これからもよろしくね」",
  "off": 2411,
  "len": 119,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2413,
  "text_len": 116
 },
 {
  "id": "sce149:00A01",
  "jp": "ベイオ「とうとう開戦しよったか。ふふふ、これは絶好の{nl}　チャンス‥‥ワシのバイン・ダーガの素晴らしさを{nl}　見せつけることもできるというもの‥‥{nl}　さぁ、行くぞ、メリッサ！　はよう支度せい‼」",
  "off": 2561,
  "len": 115,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2563,
  "text_len": 112
 },
 {
  "id": "sce149:00A81",
  "jp": "メリッサ「は、はい博止‥‥」",
  "off": 2689,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2691,
  "text_len": 18
 },
 {
  "id": "sce149:00AA4",
  "jp": "メリッサ「うっ‥‥」",
  "off": 2724,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2726,
  "text_len": 12
 },
 {
  "id": "sce149:00AB6",
  "jp": "ベイオ「ん？　ど、どうしたメリッサ⁈」",
  "off": 2742,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2744,
  "text_len": 21
 },
 {
  "id": "sce149:00ADC",
  "jp": "メリッサ「うっ‥‥だ、大丈夫‥‥です‥‥」",
  "off": 2780,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2782,
  "text_len": 30
 },
 {
  "id": "sce149:00B00",
  "jp": "ベイオ「また、頭が痛むのか？　‥‥少し横になるか？{nl}　ああ、そうだ、薬を持ってこようか？{nl}　‥‥いやそれより精の出るものを‥‥いやいや‥‥」",
  "off": 2816,
  "len": 92,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2818,
  "text_len": 89
 },
 {
  "id": "sce149:00B6A",
  "jp": "メリッサ「あ、ありがとう、ございます、博止‥‥もう平気。{nl}　いけますわ‥‥出撃なされるのでしょう？」",
  "off": 2922,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2924,
  "text_len": 61
 },
 {
  "id": "sce149:00BAD",
  "jp": "ベイオ「そ、そうじゃが‥‥{nl}　バイン・ダーガに乗るのはおまえだ。{nl}　大丈夫か？　無理なら後にしても‥‥」",
  "off": 2989,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2991,
  "text_len": 65
 },
 {
  "id": "sce149:00BFF",
  "jp": "メリッサ「優しいのですね‥‥博止‥‥」",
  "off": 3071,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3073,
  "text_len": 26
 },
 {
  "id": "sce149:00C20",
  "jp": "メリッサ「でも本当に大丈夫。もう平気です。ほら」",
  "off": 3104,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3106,
  "text_len": 31
 },
 {
  "id": "sce149:00C45",
  "jp": "ベイオ「そ、そうか‥‥では、行くぞ！」",
  "off": 3141,
  "len": 26,
