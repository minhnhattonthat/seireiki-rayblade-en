  "off": 1435,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1437,
  "text_len": 24
 },
 {
  "id": "sce315:005B9",
  "jp": "トウヤ『ああ、そうか、すまねぇな』",
  "off": 1465,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1467,
  "text_len": 17
 },
 {
  "id": "sce315:005D0",
  "jp": "ヤマト『いいって。それじゃ』",
  "off": 1488,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1490,
  "text_len": 14
 },
 {
  "id": "sce315:0061B",
  "jp": "クロビス「よぉ、どうした？」",
  "off": 1563,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1565,
  "text_len": 15
 },
 {
  "id": "sce315:008E5",
  "jp": "トウヤ「訊きたいことがあるんだが‥‥」",
  "off": 2277,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2279,
  "text_len": 22
 },
 {
  "id": "sce315:00901",
  "jp": "クロビス「おう、なんだ？　女の口説き方か？」",
  "off": 2305,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2307,
  "text_len": 28
 },
 {
  "id": "sce315:00923",
  "jp": "トウヤ「‥‥あんたと一緒にしねぇでくれ。{nl}　オーレリィのことだよ」",
  "off": 2339,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2341,
  "text_len": 38
 },
 {
  "id": "sce315:0094F",
  "jp": "クロビス「なんだ、オーレリィの口説き方か？{nl}　そいつは難儀な問題だぞ」",
  "off": 2383,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2385,
  "text_len": 44
 },
 {
  "id": "sce315:00981",
  "jp": "トウヤ「あんたはそのことしか頭にねぇのか⁈」",
  "off": 2433,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2435,
  "text_len": 24
 },
 {
  "id": "sce315:0099F",
  "jp": "クロビス「まぁ、落ち着け。この前のことだろ？」",
  "off": 2463,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2465,
  "text_len": 27
 },
 {
  "id": "sce315:009C0",
  "jp": "トウヤ「ああ‥‥」",
  "off": 2496,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2498,
  "text_len": 11
 },
 {
  "id": "sce315:009D1",
  "jp": "クロビス「もうあいつには訊いたのか？」",
  "off": 2513,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2515,
  "text_len": 21
 },
 {
  "id": "sce315:009EC",
  "jp": "トウヤ「ああ。自分の問題だって答えてくれなかった。{nl}　あんたが落ち込んでいたあいつを励ましたことは聞いた。{nl}　なぁ、もしかしてあいつ、あんたのこと‥‥」",
  "off": 2540,
  "len": 90,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2542,
  "text_len": 87
 },
 {
  "id": "sce315:00A49",
  "jp": "クロビス「‥‥トウヤ。お前、あいつのことを{nl}　どう思っている？」",
  "off": 2633,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2635,
  "text_len": 37
 },
 {
  "id": "sce315:00A74",
  "jp": "トウヤ「え？　どうって‥‥」",
  "off": 2676,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2678,
  "text_len": 17
 },
 {
  "id": "sce315:00A8B",
  "jp": "クロビス「ただ、心配なだけなら、これ以上あいつに{nl}　かまうな。そうじゃないなら答えてやろう」",
  "off": 2699,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2701,
  "text_len": 51
 },
 {
  "id": "sce315:00AC4",
  "jp": "トウヤ「？」",
  "off": 2756,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2758,
  "text_len": 7
 },
 {
  "id": "sce315:00AD1",
  "jp": "クロビス「‥‥あいつのことを仲間として心配しているのか、{nl}　一人の女のとして心配しているのか、どっちだ？」",
  "off": 2769,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2771,
  "text_len": 65
 },
 {
  "id": "sce315:00B18",
  "jp": "トウヤ「え⁈　そ、それは‥‥」",
  "off": 2840,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2842,
  "text_len": 18
 },
 {
  "id": "sce315:00B30",
  "jp": "クロビス「‥‥」",
  "off": 2864,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2866,
  "text_len": 10
 },
 {
  "id": "sce315:00B40",
  "jp": "　そりゃ、仲間として‥‥{nl}　もちろん、仲間以上の存在として心配している",
  "off": 2880,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 128,
  "text_off": 2882,
  "text_len": 47
 },
 {
  "id": "sce315:00B81",
  "jp": "クロビス「‥‥本気でいってんのか？」",
  "off": 2945,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2947,
  "text_len": 23
 },
 {
  "id": "sce315:00B9E",
  "jp": "トウヤ「あ、ああ‥‥」",
  "off": 2974,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2976,
  "text_len": 13
 },
 {
  "id": "sce315:00BB1",
  "jp": "クロビス「‥‥」",
  "off": 2993,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2995,
  "text_len": 10
 },
 {
  "id": "sce315:00BC1",
  "jp": "トウヤ「‥‥」",
  "off": 3009,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3011,
  "text_len": 9
 },
 {
  "id": "sce315:00BD0",
  "jp": "　‥‥本当は仲間以上に思っている{nl}　‥‥‥‥",
  "off": 3024,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 128,
  "text_off": 3026,
  "text_len": 35
 },
 {
  "id": "sce315:00C05",
  "jp": "クロビス「‥‥そうか。わかった」",
  "off": 3077,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3079,
  "text_len": 18
 },
 {
  "id": "sce315:00C1D",
  "jp": "トウヤ「だが、心配してることには‥‥」",
  "off": 3101,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3103,
  "text_len": 23
 },
 {
  "id": "sce315:00C3A",
  "jp": "クロビス「そういう問題じゃない。{nl}　悪かったな。もう忘れてくれ」",
  "off": 3130,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3132,
  "text_len": 36
 },
 {
  "id": "sce315:00C66",
  "jp": "ヤマト「‥‥結局、聞けニャかったね‥‥」",
  "off": 3174,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3176,
  "text_len": 27
 },
 {
  "id": "sce315:00C87",
  "jp": "トウヤ「‥‥」",
  "off": 3207,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3209,
  "text_len": 9
 },
 {
  "id": "sce315:00CAA",
  "jp": "クロビス「そうか‥‥{nl}　よし、なら話そう。結果からいうと俺とあいつとの間には{nl}　仲間以上の関係はない。{nl}　だが、あいつはこんな俺に好意をよせてくれている。{nl}　しかし、俺はずっと気づかないフリをしてきた」",
  "off": 3242,
  "len": 122,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3244,
  "text_len": 119
 },
 {
  "id": "sce315:00D27",
  "jp": "トウヤ「‥‥なぜ？」",
  "off": 3367,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3369,
  "text_len": 13
 },
 {
  "id": "sce315:00D3A",
  "jp": "クロビス「俺にはあいつの想いを受け止める資格はない。{nl}　愛するひとを守れないような男ではな」",
  "off": 3386,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3388,
  "text_len": 55
 },
 {
  "id": "sce315:00D77",
  "jp": "トウヤ「愛するひと？」",
  "off": 3447,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3449,
  "text_len": 13
 },
 {
  "id": "sce315:00D8A",
  "jp": "クロビス「妻さ‥‥」",
  "off": 3466,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3468,
  "text_len": 13
 },
 {
  "id": "sce315:00D9D",
  "jp": "トウヤ「え⁈　あんた結婚してたのか⁉」",
  "off": 3485,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3487,
  "text_len": 23
 },
 {
  "id": "sce315:00DBA",
  "jp": "クロビス「ああ」",
  "off": 3514,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3516,
  "text_len": 8
 },
 {
  "id": "sce315:00DC8",
  "jp": "トウヤ「そうか‥‥それなら不倫ってことに‥‥ん？{nl}　でも、守れなかったって‥‥もしかして亡くなったのか？」",
  "off": 3528,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3530,
  "text_len": 65
 },
 {
  "id": "sce315:00E0F",
  "jp": "クロビス「‥‥ああ」",
  "off": 3599,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3601,
  "text_len": 12
 },
 {
  "id": "sce315:00E21",
  "jp": "トウヤ「‥‥す、すまねぇ‥‥」",
  "off": 3617,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3619,
  "text_len": 19
 },
 {
  "id": "sce315:00E3A",
  "jp": "クロビス「‥‥気にするな。{nl}　あいつが死んで、その大切さに気づくなんてな‥‥{nl}　俺はとんだ大馬鹿者だ‥‥」",
  "off": 3642,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3644,
  "text_len": 69
 },
 {
  "id": "sce315:00E85",
  "jp": "トウヤ「‥‥愛してなかったワケじゃねぇんだろ？」",
  "off": 3717,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3719,
  "text_len": 28
 },
 {
  "id": "sce315:00EA7",
  "jp": "クロビス「‥‥妻は、エレナは軍時代の上官の娘だった。{nl}　トップエースであることが当り前となり、それが{nl}　プレッシャーとなっていた俺はエレナの父親の権力を{nl}　頼るまでに腐っていた。{nl}　俺は自分の地位を確立するために{nl}　あいつを利用したんだ」",
  "off": 3751,
  "len": 151,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3753,
  "text_len": 148
 },
 {
  "id": "sce315:00F41",
  "jp": "トウヤ「‥‥」",
  "off": 3905,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3907,
  "text_len": 9
 },
 {
  "id": "sce315:00F50",
  "jp": "クロビス「あいつはそんな俺を愛してくれた。{nl}　だが、その時の俺はそれを苦痛としか感じられなかった。{nl}　エレナを利用したという罪悪感と自分の地位を{nl}　守る為の束縛感にな。{nl}　俺は表向きは良き夫を演じた。{nl}　‥‥最低な人間だった」",
  "off": 3920,
  "len": 149,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3922,
  "text_len": 146
 },
 {
  "id": "sce315:00FE8",
  "jp": "トウヤ「もしかして奥さんが亡くなったのって‥‥」",
  "off": 4072,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4074,
  "text_len": 28
 },
 {
  "id": "sce315:0100A",
  "jp": "クロビス「いや、交通事故だ。その時はたいしたことが{nl}　ないと言って病院にも行かなかったが、頭を打っていた{nl}　らしく、突然倒れて‥‥」",
  "off": 4106,
  "len": 85,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4108,
  "text_len": 82
 },
 {
  "id": "sce315:01062",
  "jp": "トウヤ「‥‥そのまま？」",
  "off": 4194,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4196,
  "text_len": 15
 },
 {
  "id": "sce315:01077",
  "jp": "クロビス「一度意識を取り戻した。その時、あいつ、{nl}　俺に微笑みかけてこう言った‥‥{nl}　“あなたは自由よ”ってな。{nl}　あいつはそんなことになっても自分のことよりも、{nl}　俺のことを気遣っていたんだ。{nl}　もうろうとする意識で俺の手を握ったエレナの最期の{nl}　言葉は“愛してる”だった‥‥{nl}　衝撃だった。後悔した。{nl}　全部わかっていながらそれでも、こんな俺を愛してると{nl}　言ってくれたんだ」",
  "off": 4215,
  "len": 238,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4217,
  "text_len": 235
 },
 {
  "id": "sce315:01168",
  "jp": "トウヤ「‥‥」",
  "off": 4456,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4458,
  "text_len": 9
 },
 {
  "id": "sce315:01177",
  "jp": "クロビス「親戚も友人もみんな俺を責めなかった。{nl}　それどころか励ましの言葉をかけてくれた。{nl}　俺はいたたまれなかった。{nl}　だから俺は軍を辞め、現実から目を背けた。{nl}　絶望という免罪符を振りかざし逃げたんだ」",
  "off": 4471,
  "len": 130,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4473,
  "text_len": 127
 },
 {
  "id": "sce315:011FC",
  "jp": "トウヤ「けど、今のあんたからはそんなこと想像も{nl}　できねぇぞ‥‥」",
  "off": 4604,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4606,
  "text_len": 38
 },
 {
  "id": "sce315:01228",
  "jp": "クロビス「今の俺は自分を騙して生きているようなもんだ。{nl}　戦うことで自分を見失わずにいる。{nl}　そんな人間に、人を愛する資格などない」",
  "off": 4648,
  "len": 86,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4650,
  "text_len": 83
 },
 {
  "id": "sce315:01281",
  "jp": "トウヤ「だからオーレリィの気持ちに応えられないのか‥‥{nl}　‥‥なんで、そこまで俺に話したんだ？」",
  "off": 4737,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4739,
  "text_len": 59
 },
 {
  "id": "sce315:012C2",
  "jp": "クロビス「フッ‥‥何故だろうな？{nl}　俺もヤキが回ったか」",
  "off": 4802,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4804,
  "text_len": 35
 },
 {
  "id": "sce315:012EB",
  "jp": "トウヤ「おいおい‥‥それ嫌味か？」",
  "off": 4843,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4845,
  "text_len": 22
 },
 {
  "id": "sce315:01307",
  "jp": "クロビス「ははは、冗談だ。{nl}　‥‥だが、いつまでも逃げているワケにもいかんな。{nl}　オーレリィとちゃんと話をつける時かもな」",
  "off": 4871,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4873,
  "text_len": 69
 },
 {
  "id": "sce315:01352",
  "jp": "トウヤ「‥‥しかしオーレリィはあんたのこと‥‥」",
  "off": 4946,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4948,
  "text_len": 29
 },
 {
  "id": "sce315:01375",
  "jp": "クロビス「あいつも愛されることに慣れていない人間だ。{nl}　ただ、優しさと憧れを恋と勘違いしているだけだ。{nl}　それに、今の俺は誰かを愛することはできそうにない。{nl}　これは逃げているとかじゃなく、本心だ。{nl}　こんな状態であいつの想いを受け止めても{nl}　傷つけるだけだ。誰かを悲しませるのは{nl}　もうたくさんだからな」",
  "off": 4981,
  "len": 180,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4983,
  "text_len": 177
 },
 {
  "id": "sce315:0142C",
  "jp": "トウヤ「そんなことして大丈夫なのか？{nl}　あいつ、強がってるが‥‥」",
  "off": 5164,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5166,
  "text_len": 40
 },
 {
  "id": "sce315:0145A",
  "jp": "クロビス「だからお前に話しているんだ。{nl}　あいつが自分のことを話したのはお前が初めてだろう。{nl}　あいつ自身気づいていないが、お前のことを信頼している{nl}　証拠だ。だから、あいつを支えてやってほしい」",
  "off": 5210,
