  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 12045,
  "text_len": 39
 },
 {
  "id": "sce212:02F38",
  "jp": "メル<E1>ィ「大丈夫だよ。もう一人でできるよぉ」",
