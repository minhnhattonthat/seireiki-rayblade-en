  "len": 79,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2798,
  "text_len": 76
 },
 {
  "id": "sce246:00B3E",
  "jp": "セリカ「ライブレードのほうもあとちょっとよ。{nl}　ま、いよいよというワケね」",
