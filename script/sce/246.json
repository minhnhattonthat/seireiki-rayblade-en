 },
 {
  "id": "sce246:00D86",
  "jp": "デロック「う～ん‥‥どっかで見た事のある顔なんだな‥‥」",
  "off": 3462,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3464,
  "text_len": 36
 },
 {
  "id": "sce246:00DB0",
  "jp": "マキ「さてと、それじゃ、そろそろ失礼‥‥」",
  "off": 3504,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3506,
  "text_len": 25
 },
 {
  "id": "sce246:00DD3",
  "jp": "デロック「待つんだな。思い出したんだな。{nl}　君はあのジャーナリストなんだな。{nl}　捕#791まえたんだな。もう逃げれないんだな」",
  "off": 3539,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3541,
  "text_len": 66
 },
 {
  "id": "sce246:00E1B",
  "jp": "マキ「え？　うそ、いつの間に‼」",
  "off": 3611,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3613,
  "text_len": 19
 },
 {
  "id": "sce246:00E34",
  "jp": "デロック「連行するんだな」",
  "off": 3636,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3638,
  "text_len": 15
 },
 {
  "id": "sce246:00E77",
  "jp": "ユミール「‥‥なるほど。あなたの言い分はわかりました。{nl}　つまり、我々が本当に＜ゼ＝オード＞と戦うために{nl}　活動しているのかを確かめたいということですね？」",
  "off": 3703,
  "len": 98,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3705,
  "text_len": 95
 },
 {
  "id": "sce246:00EDC",
  "jp": "マキ「ライブレードもね。あれは＜ゼ＝オードの恐怖＞を{nl}　引き起こした元凶という情報もあるし、{nl}　そのあたりをしっかりとね」",
  "off": 3804,
  "len": 77,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3806,
  "text_len": 74
 },
 {
  "id": "sce246:00F2C",
  "jp": "トウヤ「おいおい、まさか許可すんじゃねぇだろうな？{nl}　はじめから疑ってる言い方だぜ。{nl}　あることないこと薯かれるのがオチじゃねぇのか？」",
  "off": 3884,
  "len": 79,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3886,
  "text_len": 76
 },
 {
  "id": "sce246:00F7E",
  "jp": "アーサー「そうでもありませんよ。{nl}　我々はやましいことはなにひとつしていません。{nl}　それに外からでは見えないことを見てもらうのも{nl}　悪くありませんよ」",
  "off": 3966,
  "len": 85,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3968,
  "text_len": 82
 },
 {
  "id": "sce246:00FD6",
  "jp": "クロビス「まぁ、ここで追い返そうもんなら、{nl}　いろいろ薯き立てられるのは目に見えてるしな」",
  "off": 4054,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4056,
  "text_len": 51
 },
 {
  "id": "sce246:0100F",
  "jp": "マキ「まっ、そういうこと‥‥」",
  "off": 4111,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4113,
  "text_len": 17
 },
 {
  "id": "sce246:0102D",
  "jp": "フェイン「密航者を捕#791らえたというのは本当‥‥{nl}　うわっ⁈　マ、マキ姉⁈」",
  "off": 4141,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4143,
  "text_len": 47
 },
 {
  "id": "sce246:01062",
  "jp": "マキ「え？　あらフェインちゃんじゃな～い♪{nl}　へ～～、立派になっちゃって‥‥相変わらず燃えてる？」",
  "off": 4194,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4196,
  "text_len": 62
 },
 {
  "id": "sce246:010A6",
  "jp": "トウヤ「なんだよ、その“燃えてる？”ってのは‥‥」",
  "off": 4262,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4264,
  "text_len": 31
 },
 {
  "id": "sce246:010CB",
  "jp": "フェイン「マ、マキ姉‥‥その“ちゃん”っての、{nl}　いいかげんにやめてくれないか‥‥な？」",
  "off": 4299,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4301,
  "text_len": 52
 },
 {
  "id": "sce246:01105",
  "jp": "マキ「そっかぁ～、そういえばアガルティアの騎止が{nl}　聖霊機操者になったって情報もあったけど、{nl}　フェインちゃんだったんだねぇ～{nl}　ま、なんにしてもこれからしばらく厄介になるから{nl}　よろしくね♥」",
  "off": 4357,
  "len": 114,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4359,
  "text_len": 111
 },
 {
  "id": "sce246:011B1",
  "jp": "ベイオ「グロウスターのケチダヌキめ、ダーガばかり{nl}　採揖しよって‥‥！　たかが120億ミルごときの{nl}　値をつけただけで渋りおる。{nl}　アレの実力を考えれば安い買い物だという事も{nl}　解っておらんのだ！　そうは思わんかメリッサ？」",
  "off": 4529,
  "len": 136,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4531,
  "text_len": 133
 },
 {
  "id": "sce246:01246",
  "jp": "メリッサ「はい、博止‥‥でも、ケチダヌキはあんまりですわ」",
  "off": 4678,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4680,
  "text_len": 33
 },
 {
  "id": "sce246:0126D",
  "jp": "ベイオ「かまわぬ！　ワシのバイン・ダーガを{nl}　聖霊機なんぞと一緒にするような奴は{nl}　バカケチダヌキで十分だ！」",
  "off": 4717,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4719,
  "text_len": 66
 },
 {
  "id": "sce246:012B5",
  "jp": "メリッサ「はい、博止。　でもバカケチダヌキは‥‥{nl}{ctl:3C3E}{face:041F06}{ctl:1E3E}{face:041F0B}{ctl:023E}{face:041F03}{ctl:043E}{face:041F0C}　うっ‥‥」",
  "off": 4789,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4791,
  "text_len": 69
 },
 {
  "id": "sce246:01300",
  "jp": "ベイオ「どうした？　頭が痛むのか？」",
  "off": 4864,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4866,
  "text_len": 22
 },
 {
  "id": "sce246:0131C",
  "jp": "メリッサ「‥‥聖霊‥‥機‥‥うっ‥‥」",
  "off": 4892,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4894,
  "text_len": 30
 },
 {
  "id": "sce246:01340",
  "jp": "ベイオ「だ、大丈夫か⁈{nl}　と、とにかく休むのだ。さぁ‥‥」",
  "off": 4928,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4930,
  "text_len": 36
 },
 {
  "id": "sce246:01398",
  "jp": "メリッサ「は、はい‥‥すみません‥‥」",
  "off": 5016,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5018,
  "text_len": 23
 },
 {
  "id": "sce246:013B5",
  "jp": "ベイオ「気にするな。最近はバイン・ダーガのテストで{nl}　働きづめだったからな。無理もない。{nl}　今日はゆっくりと休めばいい」",
  "off": 5045,
  "len": 73,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5047,
  "text_len": 70
 },
 {
  "id": "sce246:0140C",
  "jp": "メリッサ「はい‥‥」",
  "off": 5132,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5134,
  "text_len": 12
 },
 {
  "id": "sce246:01425",
  "jp": "ベイオ「聖霊機‥‥なぜその名に‥‥まさか‥‥」",
  "off": 5157,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5159,
  "text_len": 33
 },
 {
  "id": "sce246:01472",
  "jp": "ドリス「ん、んん‥‥」",
  "off": 5234,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5236,
  "text_len": 13
 },
 {
  "id": "sce246:01485",
  "jp": "デイ「起こしてしまったかな？」",
  "off": 5253,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5255,
  "text_len": 17
 },
 {
  "id": "sce246:0149C",
  "jp": "ドリス「‥‥どうしたの？」",
  "off": 5276,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5278,
  "text_len": 16
 },
 {
  "id": "sce246:014B2",
  "jp": "デイ「なんでもない」",
  "off": 5298,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5300,
  "text_len": 10
 },
 {
  "id": "sce246:014C2",
  "jp": "ドリス「‥‥うそ。あの人のことでしょ？」",
  "off": 5314,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5316,
  "text_len": 24
 },
 {
  "id": "sce246:014E0",
  "jp": "デイ「ふっ‥‥バカなことを‥‥」",
  "off": 5344,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5346,
  "text_len": 20
 },
 {
  "id": "sce246:014FA",
  "jp": "ドリス「じゃあ、なに？」",
  "off": 5370,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5372,
  "text_len": 13
 },
 {
  "id": "sce246:0150D",
  "jp": "デイ「私自身のことだよ」",
  "off": 5389,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5391,
  "text_len": 15
 },
 {
  "id": "sce246:01522",
  "jp": "ドリス「‥‥」",
  "off": 5410,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5412,
  "text_len": 9
 },
 {
  "id": "sce246:01531",
  "jp": "デイ「‥‥やはりな。お前も気づいていたか‥‥{nl}　時々、私が私でない何者かになる‥‥{nl}　そんな気がするんだ‥‥。{nl}　昼間の会談からその感覚は強まる一方だ」",
  "off": 5425,
  "len": 104,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5427,
  "text_len": 101
 },
 {
  "id": "sce246:015A0",
  "jp": "ドリス「‥‥あなたはあなた。他の誰でもないのよ？{nl}　忘れないで。ここにあなたを一番知っている女が{nl}　いることを。デイ、自信をもって」",
  "off": 5536,
  "len": 81,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5538,
  "text_len": 78
 },
 {
  "id": "sce246:015F4",
  "jp": "デイ「そう、だな‥‥私はデイ・ラクバルだ。{nl}　‥‥すまんな」",
  "off": 5620,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5622,
  "text_len": 35
 },
 {
  "id": "sce246:0161D",
  "jp": "ドリス「そうよ。あなたがしっかりしなくちゃ。{nl}　私達の悲願達成のために‥‥」",
  "off": 5661,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5663,
  "text_len": 46
 },
 {
  "id": "sce246:01651",
  "jp": "デイ「ああ。そうだな。{nl}　ドリス‥‥例の件、頼んだぞ」",
  "off": 5713,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5715,
  "text_len": 32
 },
 {
  "id": "sce246:01677",
  "jp": "ドリス「ええ。任せて。{nl}　この前は邪魔が入ったけど次はかならず‥‥」",
  "off": 5751,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5753,
  "text_len": 42
 },
 {
  "id": "sce246:016A7",
  "jp": "デイ「ふふふふ、たのもしいことだな」",
  "off": 5799,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5801,
  "text_len": 18
 }
]
