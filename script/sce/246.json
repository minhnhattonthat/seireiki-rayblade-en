  "status": "todo",
  "style": 0,
  "text_off": 1890,
  "text_len": 10
 },
 {
  "id": "sce246:00770",
  "jp": "ユミール「わかりました。私も艦長の意見に賛成です。{nl}　バレン、進路をアガルティア王都シャングリアへ」",
  "off": 1904,
