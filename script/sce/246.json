  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2264,
  "text_len": 83
 },
 {
  "id": "sce246:0092F",
  "jp": "トウヤ「おお！」",
  "off": 2351,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2353,
  "text_len": 9
 },
 {
  "id": "sce246:0093E",
  "jp": "フェイン「姫！　さすがです！」",
