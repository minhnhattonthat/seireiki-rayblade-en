  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2087,
  "text_len": 23
 },
 {
  "id": "sce246:00842",
  "jp": "トウヤ「ん？　めずらしいパーツでも手に入れたのか？」",
