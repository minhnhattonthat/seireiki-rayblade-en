  "status": "todo",
  "style": 0,
  "text_off": 2587,
  "text_len": 27
 },
 {
  "id": "sce023:00A40",
  "jp": "アーサー「子供は大人と違って変なプライドに{nl}　縛られませんからね。すぐにお互いを認め合える。{nl}　成長するにつれて失ってしまう才能の一つですね」",
  "off": 2624,
  "len": 92,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2626,
  "text_len": 89
 },
