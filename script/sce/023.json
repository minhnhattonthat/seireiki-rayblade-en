  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 766,
  "text_len": 75
 },
 {
  "id": "sce023:0034D",
  "jp": "クロビス「んなもん付いてたのか⁈{nl}　道理で殴られるのとは違う痛みがあると思ったら‥‥」",
  "off": 845,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 847,
  "text_len": 53
 },
