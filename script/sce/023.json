  "status": "todo",
  "style": 0,
  "text_off": 3635,
  "text_len": 11
 },
 {
  "id": "sce023:00E42",
  "jp": "ホーレム「あっ、そうそう。あなたが友人と遊んでいる間に{nl}　こっちの研究の方は実用段階に入りましたよ」",
  "off": 3650,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3652,
  "text_len": 63
 },
 {
