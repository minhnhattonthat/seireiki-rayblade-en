  "style": 0,
  "text_off": 3562,
  "text_len": 9
 },
 {
  "id": "sce023:00DF7",
  "jp": "ホーレム「まぁ、無理にとはいいませんが、{nl}　あなたはローディス個人に恨みがあるようですね」",
  "off": 3575,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3577,
  "text_len": 52
 },
