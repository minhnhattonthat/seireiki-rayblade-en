  "style": 0,
  "text_off": 263,
  "text_len": 27
 },
 {
  "id": "sce023:00126",
  "jp": "ゲン「そうだ！　そうだ！　{nl}　艦長が見つけてくれたからよかったけど、{nl}　おかげで料理を食べそこなったんだからね！」",
