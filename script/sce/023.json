  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 910,
  "text_len": 21
 },
 {
  "id": "sce023:003B9",
  "jp": "アーサー「‥‥しかし、ユミールさんが正座を{nl}　知っていたなんて驚きでしたね。{nl}　あれで苦痛は倍増でしたよ」",
  "off": 953,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 955,
  "text_len": 66
 },
 {
  "id": "sce023:00401",
