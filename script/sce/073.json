  "style": 0,
  "text_off": 2028,
  "text_len": 22
 },
 {
  "id": "sce073:00806",
  "jp": "ウェニマス「ありがとう。{nl}　あなたのおかげでアガルティアは‥‥いえ、{nl}　この世界も救われたわ‥‥」",
  "off": 2054,
