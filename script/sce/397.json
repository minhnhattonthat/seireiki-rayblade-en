  "status": "translated",
  "style": 0,
  "text_off": 3778,
  "text_len": 11
 },
 {
  "id": "sce397:00EDB",
  "jp": "ミヤスコ「やめてくださいって言ったのですが‥‥すみません」",
  "off": 3803,
  "len": 35,
