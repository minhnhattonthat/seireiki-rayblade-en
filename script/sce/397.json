  "style": 0,
  "text_off": 3416,
  "text_len": 11
 },
 {
  "id": "sce397:00D67",
  "jp": "ガボン「フェイン！　おめぇが押すから！」",
  "off": 3431,
  "len": 26,
  "en": "Gabon: Fain! It's 'cause you were pushing!",
  "status": "translated",
  "style": 0,
  "text_off": 3433,
  "text_len": 23
 },
 {
  "id": "sce397:00D84",
  "jp": "フェイン「お、俺だけのせいですか⁈」",
