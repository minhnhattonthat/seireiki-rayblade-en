  "status": "translated",
  "style": 0,
  "text_off": 3488,
  "text_len": 17
 },
 {
  "id": "sce397:00DC1",
  "jp": "ガボン「い、いや、ちょっと、ユミールがカスミに{nl}　伝えることがあるって言ってたから‥‥」",
  "off": 3521,
  "len": 52,
  "en": "Gabon: N-now, hold on, Ymir said she had something to tell Kasumi, so...",
  "status": "translated",
  "style": 0,
  "text_off": 3523,
  "text_len": 49
 },
