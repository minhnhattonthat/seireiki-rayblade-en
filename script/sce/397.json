[
 {
  "id": "sce397:00064",
  "jp": "　「1B0のフラグが立っていません。このプライベート{nl}　イベントをする場合は1B0のフラグを立てやり直して{nl}　ください。しない場合は、強制終了いたします。」{ctl:B43E}",
  "off": 100,
  "len": 96,
  "en": "\"Flag 1B0 is not set. To run this private event, set flag 1B0 and start again. Otherwise, the event will be force-quit.\"{ctl:B43E}",
  "status": "translated",
  "style": 0,
  "text_off": 102,
  "text_len": 93
 },
 {
  "id": "sce397:0034A",
  "jp": "ガボン「ん？　ユミールの見舞いか？{nl}　すまんな。まだ寝ている」",
  "off": 842,
  "len": 40,
  "en": "Gabon: Hm? Here to see Ymir? Sorry. She's still asleep.",
  "status": "translated",
  "style": 0,
  "text_off": 844,
  "text_len": 37
 },
 {
  "id": "sce397:00375",
  "jp": "トウヤ「そうか‥‥わかった」",
  "off": 885,
  "len": 19,
  "en": "Touya: I see... Got it.",
  "status": "translated",
  "style": 0,
  "text_off": 887,
  "text_len": 16
 },
 {
  "id": "sce397:0038B",
  "jp": "ガボン「心配しねぇでも大丈夫だ。さっきも言ったろうが？{nl}　それにもうちょっとしたら目を覚ますだろうしな」",
  "off": 907,
  "len": 64,
  "en": "Gabon: No need to worry, she'll be fine. Didn't I tell ya earlier? Besides, she oughta wake up in a little while.",
  "status": "translated",
  "style": 0,
  "text_off": 909,
  "text_len": 61
 },
 {
  "id": "sce397:003CE",
  "jp": "トウヤ「ああ、それじゃ」",
  "off": 974,
  "len": 15,
  "en": "Touya: Yeah, see ya.",
  "status": "translated",
  "style": 0,
  "text_off": 976,
  "text_len": 12
 },
 {
  "id": "sce397:00412",
  "jp": "ヤマト「カスミ～お見舞いに来たよ～」",
  "off": 1042,
  "len": 26,
  "en": "Yamato: Kasumiii, we came to visit youuu~",
  "status": "translated",
  "style": 0,
  "text_off": 1044,
  "text_len": 23
 },
 {
  "id": "sce397:0042F",
  "jp": "トウヤ「あれ？　いねぇぞ」",
  "off": 1071,
  "len": 17,
  "en": "Touya: Huh? She's not here.",
  "status": "translated",
  "style": 0,
  "text_off": 1073,
  "text_len": 14
 },
 {
  "id": "sce397:00443",
  "jp": "カスミ「え⁈　ト、トウヤちゃん⁉」",
  "off": 1091,
  "len": 22,
  "en": "Kasumi: Wha!? T-Touya-chan!?",
  "status": "translated",
  "style": 0,
  "text_off": 1093,
  "text_len": 19
 },
 {
  "id": "sce397:0045C",
  "jp": "ヤマト「ニャーんだ、奥にいるの？」",
  "off": 1116,
  "len": 23,
  "en": "Yamato: Nyaa, so you're in the back?",
  "status": "translated",
  "style": 0,
  "text_off": 1118,
  "text_len": 20
 },
 {
  "id": "sce397:0047D",
  "jp": "ヤマト「カスミ‥‥あっ」",
  "off": 1149,
  "len": 17,
  "en": "Yamato: Kasumi... Oh.",
  "status": "translated",
  "style": 0,
  "text_off": 1151,
  "text_len": 14
 },
 {
  "id": "sce397:00491",
  "jp": "トウヤ「どうした‥‥そっちにいるんだろ？　俺も‥‥」",
  "off": 1169,
  "len": 35,
  "en": "Touya: What's up... She's over there, right? I'll just...",
  "status": "translated",
  "style": 0,
  "text_off": 1171,
  "text_len": 32
 },
 {
  "id": "sce397:004B7",
  "jp": "カスミ「ダメっ！」",
  "off": 1207,
  "len": 13,
  "en": "Kasumi: Don't!",
  "status": "translated",
  "style": 0,
  "text_off": 1209,
  "text_len": 10
 },
 {
  "id": "sce397:004C7",
  "jp": "ヤマト「う、うん、今はよしといたほうがいいわね」",
  "off": 1223,
  "len": 28,
  "en": "Yamato: Y-yeah, better leave it for now.",
  "status": "translated",
  "style": 0,
  "text_off": 1225,
  "text_len": 25
 },
 {
  "id": "sce397:004E6",
  "jp": "トウヤ「なんで？」",
  "off": 1254,
  "len": 13,
  "en": "Touya: How come?",
  "status": "translated",
  "style": 0,
  "text_off": 1256,
  "text_len": 10
 },
 {
  "id": "sce397:004F6",
  "jp": "ガボン「がっはっはっ！{nl}　ちっとばっかしそこで待ってろ。今検査が終わるから」",
  "off": 1270,
  "len": 47,
  "en": "Gabon: Gahahaha! Wait there a bit. The examination's almost done.",
  "status": "translated",
  "style": 0,
  "text_off": 1272,
  "text_len": 44
 },
 {
  "id": "sce397:00528",
  "jp": "トウヤ「‥‥検査？」",
  "off": 1320,
  "len": 18,
  "en": "Touya: ...Examination?",
  "status": "translated",
  "style": 0,
  "text_off": 1322,
  "text_len": 15
 },
 {
  "id": "sce397:0053D",
  "jp": "ガボン「はっきり言うと、今、カスミは上半身裸だ」",
  "off": 1341,
  "len": 33,
  "en": "Gabon: To put it bluntly, Kasumi's naked from the waist up right now.",
  "status": "translated",
  "style": 0,
  "text_off": 1343,
  "text_len": 30
 },
 {
  "id": "sce397:00561",
  "jp": "トウヤ「‼」",
  "off": 1377,
  "len": 10,
  "en": "Touya: !!",
  "status": "translated",
  "style": 0,
  "text_off": 1379,
  "text_len": 7
 },
 {
  "id": "sce397:0056E",
  "jp": "ミヤスコ「先生⁉　早くしてあげてください！」",
  "off": 1390,
  "len": 30,
  "en": "Miyasco: Doctor!? Hurry up and finish for her!",
  "status": "translated",
  "style": 0,
  "text_off": 1392,
  "text_len": 27
 },
 {
  "id": "sce397:0058F",
  "jp": "ガボン「怖い助手に殴られる前にちゃっちゃと{nl}　終わらせるか」",
  "off": 1423,
  "len": 39,
  "en": "Gabon: Guess I'd better wrap this up quick before my scary assistant clobbers me.",
  "status": "translated",
  "style": 0,
  "text_off": 1425,
  "text_len": 36
 },
 {
  "id": "sce397:005B9",
  "jp": "ミヤスコ「そんなことしません！」",
  "off": 1465,
  "len": 20,
  "en": "Miyasco: I would never do that!",
  "status": "translated",
  "style": 0,
  "text_off": 1467,
  "text_len": 17
 },
 {
  "id": "sce397:005D0",
  "jp": "ガボン「おお、怖い怖い‥‥」",
  "off": 1488,
  "len": 21,
  "en": "Gabon: Ooh, scary, scary...",
  "status": "translated",
  "style": 0,
  "text_off": 1490,
  "text_len": 18
 },
 {
  "id": "sce397:005E8",
  "jp": "ミヤスコ「まったく‥‥ごめんなさい、もう少しだけ{nl}　待ってくださいね」",
  "off": 1512,
  "len": 42,
  "en": "Miyasco: Honestly... I'm sorry, please wait just a little longer.",
  "status": "translated",
  "style": 0,
  "text_off": 1514,
  "text_len": 39
 },
 {
  "id": "sce397:00615",
  "jp": "トウヤ「あ、ああ‥‥」",
  "off": 1557,
  "len": 16,
  "en": "Touya: Oh, r-right...",
  "status": "translated",
  "style": 0,
  "text_off": 1559,
  "text_len": 13
 },
 {
  "id": "sce397:00641",
  "jp": "カスミ「‥‥」",
  "off": 1601,
  "len": 12,
  "en": "Kasumi: ...",
  "status": "translated",
  "style": 0,
  "text_off": 1603,
  "text_len": 9
 },
 {
  "id": "sce397:00650",
  "jp": "トウヤ「げ、元気そうだな」",
  "off": 1616,
  "len": 18,
  "en": "Touya: Y-you seem to be doing fine.",
  "status": "translated",
  "style": 0,
  "text_off": 1618,
  "text_len": 15
 },
 {
  "id": "sce397:00670",
  "jp": "カスミ「‥‥うん。異常はないって」",
  "off": 1648,
  "len": 24,
  "en": "Kasumi: ...Mm. They said nothing's wrong.",
  "status": "translated",
  "style": 0,
  "text_off": 1650,
  "text_len": 21
 },
 {
  "id": "sce397:0068B",
  "jp": "トウヤ「そっか‥‥よかったな」",
  "off": 1675,
  "len": 20,
  "en": "Touya: I see... That's good.",
  "status": "translated",
  "style": 0,
  "text_off": 1677,
  "text_len": 17
 },
 {
  "id": "sce397:006B4",
  "jp": "カスミ「うん」",
  "off": 1716,
  "len": 10,
  "en": "Kasumi: Mm.",
  "status": "translated",
  "style": 0,
  "text_off": 1718,
  "text_len": 7
 },
 {
  "id": "sce397:006CD",
  "jp": "ガボン「アジャスターの拒絶反応もねぇし、これなら{nl}　病原菌に感染するおそれもねぇだろう」",
  "off": 1741,
  "len": 57,
  "en": "Gabon: No rejection of the Adjuster, either. With this, there's no risk of her catching any germs.",
  "status": "translated",
  "style": 0,
  "text_off": 1743,
  "text_len": 54
 },
 {
  "id": "sce397:00709",
  "jp": "トウヤ「アジャスターって、そういう機能もあったんだな」",
  "off": 1801,
  "len": 33,
  "en": "Touya: So the Adjuster does that kind of thing too, huh.",
  "status": "translated",
  "style": 0,
  "text_off": 1803,
  "text_len": 30
 },
 {
  "id": "sce397:00741",
  "jp": "ミヤスコ「本来は病気から肉体を守ったり、{nl}　怪我の治癒を早めるために開発されたものですから。{nl}　我々アガルティア世界の人間は例外なく{nl}　アジャスターの恩恵にあずかっています」",
  "off": 1857,
  "len": 114,
  "en": "Miyasco: It was originally developed to protect the body from illness and speed up the healing of injuries. Every one of us in Agarthia, without exception, benefits from the Adjuster.",
  "status": "translated",
  "style": 0,
  "text_off": 1859,
  "text_len": 111
 },
 {
  "id": "sce397:007B6",
  "jp": "ガボン「おかげで俺達の仕事は減ったがな。{nl}　まあ、出番が少ないってことはいいことだ。{nl}　‥‥さて」",
  "off": 1974,
  "len": 62,
  "en": "Gabon: Cut down on our work, mind you. Well, getting called on less is a good thing. ...Now then.",
  "status": "translated",
  "style": 0,
  "text_off": 1976,
  "text_len": 59
 },
 {
  "id": "sce397:007F7",
  "jp": "ヤマト「あれ？　どこ行くの？」",
  "off": 2039,
  "len": 21,
  "en": "Yamato: Huh? Where are you going?",
  "status": "translated",
  "style": 0,
  "text_off": 2041,
  "text_len": 18
 },
 {
  "id": "sce397:0080F",
  "jp": "ガボン「せっかくの再会を邪魔するほど無粋じゃねぇよ。{nl}　ミヤスコ、行くぞ」",
  "off": 2063,
  "len": 47,
  "en": "Gabon: I'm not so tactless as to interrupt a long-awaited reunion. Miyasco, let's go.",
  "status": "translated",
  "style": 0,
  "text_off": 2065,
  "text_len": 44
 },
 {
  "id": "sce397:00845",
  "jp": "ミヤスコ「あっ、は、はい」",
  "off": 2117,
  "len": 16,
  "en": "Miyasco: Ah, y-yes, sir.",
  "status": "translated",
  "style": 0,
  "text_off": 2119,
  "text_len": 13
 },
 {
  "id": "sce397:0085C",
  "jp": "ヤマト「う～ん、それじゃ、あたしも‥‥」",
  "off": 2140,
  "len": 26,
  "en": "Yamato: Hmm, in that case, I'll...",
  "status": "translated",
  "style": 0,
  "text_off": 2142,
  "text_len": 23
 },
 {
  "id": "sce397:00882",
  "jp": "トウヤ「お、おい‥‥」",
  "off": 2178,
  "len": 16,
  "en": "Touya: H-hey...",
  "status": "translated",
  "style": 0,
  "text_off": 2180,
  "text_len": 13
 },
 {
  "id": "sce397:0089D",
  "jp": "カスミ「‥‥」",
  "off": 2205,
  "len": 12,
  "en": "Kasumi: ...",
  "status": "translated",
  "style": 0,
  "text_off": 2207,
  "text_len": 9
 },
 {
  "id": "sce397:008AC",
  "jp": "トウヤ「ま、まあ、問題なくてよかったな」",
  "off": 2220,
  "len": 25,
  "en": "Touya: W-well, good thing nothing's wrong.",
  "status": "translated",
  "style": 0,
  "text_off": 2222,
  "text_len": 22
 },
 {
  "id": "sce397:008C8",
  "jp": "カスミ「うん‥‥」",
  "off": 2248,
  "len": 14,
  "en": "Kasumi: Mm...",
  "status": "translated",
  "style": 0,
  "text_off": 2250,
  "text_len": 11
 },
 {
  "id": "sce397:008D9",
  "jp": "トウヤ「しかし、無茶するよな。{nl}　もしフォルゼンが嘘をついてたらって{nl}　考えなかったのか？」",
  "off": 2265,
  "len": 54,
  "en": "Touya: Still, that was reckless. Didn't you think about what would happen if Forzen was lying?",
  "status": "translated",
  "style": 0,
  "text_off": 2267,
  "text_len": 51
 },
 {
  "id": "sce397:00912",
  "jp": "カスミ「それでもあそこにいるよりは{nl}　マシだと思ったから‥‥{nl}　トウヤちゃんがいないあの場所より‥‥」",
  "off": 2322,
  "len": 61,
  "en": "Kasumi: Even so, I thought it'd be better than staying there... Better than that place, without Touya-chan...",
  "status": "translated",
  "style": 0,
  "text_off": 2324,
  "text_len": 58
 },
 {
  "id": "sce397:00952",
  "jp": "トウヤ「そ、そうか‥‥」",
  "off": 2386,
  "len": 17,
  "en": "Touya: I-I see...",
  "status": "translated",
  "style": 0,
  "text_off": 2388,
  "text_len": 14
 },
 {
  "id": "sce397:00978",
  "jp": "カスミ「もしかして迷惑‥‥だった？」",
  "off": 2424,
  "len": 26,
  "en": "Kasumi: Was I... a bother, maybe?",
  "status": "translated",
  "style": 0,
  "text_off": 2426,
  "text_len": 23
 },
 {
  "id": "sce397:00995",
  "jp": "トウヤ「そんなことねぇよ。ただ、心配なだけだ。{nl}　これから戦いも激しくなるだろうし、{nl}　この先どうなるかもわからねえからな」",
  "off": 2453,
  "len": 70,
  "en": "Touya: That's not it. I'm just worried, that's all. The fighting's only going to get worse from here, and there's no telling what happens next.",
  "status": "translated",
  "style": 0,
  "text_off": 2455,
  "text_len": 67
 },
 {
  "id": "sce397:009E9",
  "jp": "カスミ「‥‥よかった」",
  "off": 2537,
  "len": 16,
  "en": "Kasumi: ...I'm glad.",
  "status": "translated",
  "style": 0,
  "text_off": 2539,
  "text_len": 13
 },
 {
  "id": "sce397:009FC",
  "jp": "トウヤ「え？」",
  "off": 2556,
  "len": 11,
  "en": "Touya: Huh?",
  "status": "translated",
  "style": 0,
  "text_off": 2558,
  "text_len": 8
 },
 {
  "id": "sce397:00A15",
  "jp": "カスミ「迷惑じゃないって言ってくれて。{nl}　こうやってトウヤちゃんと再会できて」",
  "off": 2581,
  "len": 47,
  "en": "Kasumi: That you said I'm not a bother. And that I got to see you again like this, Touya-chan.",
  "status": "translated",
  "style": 0,
  "text_off": 2583,
  "text_len": 44
 },
 {
  "id": "sce397:00A47",
  "jp": "　俺もカスミと再会できてよかった、かな。{nl}　まったく‥‥もっと現実に目を向けろよな。",
  "off": 2631,
  "len": 54,
  "en": "Glad to see you too, Kasumi.{nl}Geez... Get real, will ya.",
  "status": "translated",
  "style": 128,
  "text_off": 2633,
  "text_len": 51
 },
 {
  "id": "sce397:00AC0",
  "jp": "カスミ「ほ、本当？」",
  "off": 2752,
  "len": 16,
  "en": "Kasumi: R-really?",
  "status": "translated",
  "style": 0,
  "text_off": 2754,
  "text_len": 13
 },
 {
  "id": "sce397:00AD3",
  "jp": "トウヤ「ああ」",
  "off": 2771,
  "len": 10,
  "en": "Touya: Yeah.",
  "status": "translated",
  "style": 0,
  "text_off": 2773,
  "text_len": 7
 },
 {
  "id": "sce397:00AF2",
  "jp": "カスミ「トウヤちゃん‥‥」",
  "off": 2802,
  "len": 18,
  "en": "Kasumi: Touya-chan...",
  "status": "translated",
  "style": 0,
  "text_off": 2804,
  "text_len": 15
 },
 {
  "id": "sce397:00B1C",
  "jp": "カスミ「‥‥ごめんなさい」",
  "off": 2844,
  "len": 18,
  "en": "Kasumi: ...I'm sorry.",
  "status": "translated",
  "style": 0,
  "text_off": 2846,
  "text_len": 15
 },
 {
  "id": "sce397:00B35",
  "jp": "トウヤ「だけど、俺もカスミと会えてうれしいぜ。{nl}　知ってる人間に会うとやっぱりほっとするしな」",
  "off": 2869,
  "len": 56,
  "en": "Touya: But I'm glad to see you too, Kasumi. Running into someone you know is a real relief, after all.",
  "status": "translated",
  "style": 0,
  "text_off": 2871,
  "text_len": 53
 },
 {
  "id": "sce397:00B8C",
  "jp": "カスミ「‥‥私もトウヤちゃんがいるから安心」",
  "off": 2956,
  "len": 30,
  "en": "Kasumi: ...I feel safe too, because you're here, Touya-chan.",
  "status": "translated",
  "style": 0,
  "text_off": 2958,
  "text_len": 27
 },
 {
  "id": "sce397:00BB0",
  "jp": "トウヤ「ま、まあ、なんにしても、これからどうするか{nl}　考えねぇとな」",
  "off": 2992,
  "len": 38,
  "en": "Touya: W-well, anyway, we gotta think about what to do from here.",
  "status": "translated",
  "style": 0,
  "text_off": 2994,
  "text_len": 35
 },
 {
  "id": "sce397:00BE4",
  "jp": "カスミ「うん‥‥」",
  "off": 3044,
  "len": 14,
  "en": "Kasumi: Mm...",
  "status": "translated",
  "style": 0,
  "text_off": 3046,
  "text_len": 11
 },
 {
  "id": "sce397:00BF5",
  "jp": "トウヤ「どうした？」",
  "off": 3061,
  "len": 14,
  "en": "Touya: What's wrong?",
  "status": "translated",
  "style": 0,
  "text_off": 3063,
  "text_len": 11
 },
 {
  "id": "sce397:00C18",
  "jp": "カスミ「トウヤちゃんはあのロボットにのって、{nl}　戦っているんだよね？」",
  "off": 3096,
  "len": 40,
  "en": "Kasumi: Touya-chan, you ride that robot and fight, right?",
  "status": "translated",
  "style": 0,
  "text_off": 3098,
  "text_len": 37
 },
 {
  "id": "sce397:00C43",
  "jp": "トウヤ「ああ‥‥状況に流されてって感じだがな」",
  "off": 3139,
  "len": 32,
  "en": "Touya: Yeah... Mostly just swept along by the situation, though.",
  "status": "translated",
  "style": 0,
  "text_off": 3141,
  "text_len": 29
 },
 {
  "id": "sce397:00C66",
  "jp": "カスミ「怖くない？」",
  "off": 3174,
  "len": 15,
  "en": "Kasumi: Aren't you scared?",
  "status": "translated",
  "style": 0,
  "text_off": 3176,
  "text_len": 12
 },
 {
  "id": "sce397:00C78",
  "jp": "トウヤ「う～ん、怖くねぇったら嘘になるが‥‥{nl}　自分にできることがあるならそれをやろうって気には{nl}　なってるかな」",
  "off": 3192,
  "len": 68,
  "en": "Touya: Hmm, I'd be lying if I said I wasn't scared... But if there's something I can do, I figure I'll do it. That's how I feel, I guess.",
  "status": "translated",
  "style": 0,
  "text_off": 3194,
  "text_len": 65
 },
 {
  "id": "sce397:00CD1",
  "jp": "カスミ「そうだよね。自分にできることがあったら‥‥」",
