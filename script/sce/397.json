  "status": "translated",
  "style": 0,
  "text_off": 3805,
  "text_len": 32
 },
 {
  "id": "sce397:00F01",
  "jp": "カスミ「あっ、頭をあげてください。{nl}　ぜんぜん気にしてませんから。ね、トウヤちゃん？」",
