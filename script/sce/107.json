  "off": 3825,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3827,
  "text_len": 16
 },
 {
  "id": "sce107:00F07",
  "jp": "トウヤ「‥‥なにブツブツ言ってんだ？」",
  "off": 3847,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3849,
  "text_len": 23
 },
 {
  "id": "sce107:00F2C",
  "jp": "デロック「ああ、キミ達か‥‥」",
  "off": 3884,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3886,
  "text_len": 18
 },
 {
  "id": "sce107:00F54",
  "jp": "デロック「あっ、やっと来たんだな。{nl}　ん？　キミ達は乗らないつもりなんだな。{nl}　それじゃ、僕が乗るんだな」",
  "off": 3924,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3926,
  "text_len": 59
 },
 {
  "id": "sce107:00F95",
  "jp": "ヤマト「あーっ！　乗るわよ。{nl}　順番は守りニャさいよ！」",
  "off": 3989,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3991,
  "text_len": 35
 },
 {
  "id": "sce107:00FBE",
  "jp": "デロック「‥‥ちっ」",
  "off": 4030,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4032,
  "text_len": 12
 },
 {
  "id": "sce107:00FE6",
  "jp": "デロック「さっさと端によるんだな。{nl}　そんなど真ん中にいられたら僕が乗れないんだな」",
