  "text_len": 19
 },
 {
  "id": "sce107:01086",
  "jp": "デロック「そんなはずないんだな。これは最大10人の{nl}　20ロット（1t）まで大丈夫なんだな」",
  "off": 4230,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
