  "text_len": 93
 },
 {
  "id": "sce107:00449",
  "jp": "ゲン「姉ちゃんはなにもわかってない！{nl}　オイラだっていつまでも子供じゃないんだ！」",
  "off": 1097,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1099,
  "text_len": 46
 },
