  "text_len": 34
 },
 {
  "id": "sce049:0045F",
  "jp": "デビッシュ「ふむ。そこそこには使えるようになったようだな。{nl}　だが、所詮は私の敵ではない。{nl}　どうだ？　我々に力を貸す気はないか？」",
  "off": 1119,
  "len": 82,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1123,
  "text_len": 77
 },
 {
  "id": "sce049:004BC",
  "jp": "トウヤ「ことわる‼　人の命をなんだと思ってやがる！{nl}　世界の災いとなることに荷担なんかできるか！」",
  "off": 1212,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1216,
  "text_len": 60
 },
 {
  "id": "sce049:004FD",
  "jp": "デビッシュ「災いか‥‥まだわかっていないようだな」",
  "off": 1277,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1281,
  "text_len": 28
 },
 {
  "id": "sce049:0051E",
  "jp": "トウヤ「なにっ⁉」",
