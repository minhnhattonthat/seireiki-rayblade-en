  "status": "todo",
  "style": 0,
  "text_off": 6661,
  "text_len": 12
 },
 {
  "id": "sce066:01A15",
  "jp": "晃一郎「‥‥佳澄美ちゃん、いいのかい？」",
  "off": 6677,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6679,
  "text_len": 29
 },
 {
  "id": "sce066:01A38",
  "jp": "佳澄美「うん‥‥だって透夜ちゃんが選んだことだもの」",
  "off": 6712,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6714,
  "text_len": 34
 },
 {
  "id": "sce066:01A60",
  "jp": "晃一郎「‥‥そっか。{nl}　‥‥でも、あの透夜がねぇ‥‥」",
