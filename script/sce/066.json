  "len": 73,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6467,
  "text_len": 70
 },
 {
  "id": "sce066:0198D",
  "jp": "透夜「ごきゅごきゅごきゅ‥‥ぷはーっ！{nl}　‥‥ごちそうさま。それじゃ、行ってくる！」",
  "off": 6541,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6543,
  "text_len": 52
 },
