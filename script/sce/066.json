  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7549,
  "text_len": 10
 },
 {
  "id": "sce066:01D8B",
  "jp": "透夜「お、おい、亜依‥‥」",
  "off": 7563,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7565,
  "text_len": 19
 },
 {
  "id": "sce066:01DA8",
  "jp": "亜依「‥‥それじゃ、今日のデートはぜんぶ透夜のおごり{nl}　ということで許してあげる」",
  "off": 7592,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7594,
  "text_len": 51
 },
 {
  "id": "sce066:01DE1",
  "jp": "透夜「えーっ！　学生の身分でそれは‥‥」",
