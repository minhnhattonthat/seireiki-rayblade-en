  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7095,
  "text_len": 14
 },
 {
  "id": "sce066:01BE7",
  "jp": "亜依「‥‥もぅ！　遅ぃ～{nl}　女の子を待たせるなんてどーいう了見よ⁉」",
