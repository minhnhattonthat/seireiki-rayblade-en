  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7460,
  "text_len": 17
 },
 {
  "id": "sce066:01D39",
  "jp": "透夜「おいおい、こっちに帰ってきて初めて会うのに‥‥{nl}　本当に悪かったって！　謝るから」",
  "off": 7481,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7483,
  "text_len": 56
 },
 {
  "id": "sce066:01D7B",
