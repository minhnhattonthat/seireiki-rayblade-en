  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7293,
  "text_len": 51
 },
 {
  "id": "sce066:01CB4",
  "jp": "透夜「ああ‥‥お前のことだから‥‥」",
  "off": 7348,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7350,
  "text_len": 25
 },
 {
  "id": "sce066:01CD7",
  "jp": "亜依「遅刻といい、その失礼な発言といい、{nl}　許されざる行為ね」",
