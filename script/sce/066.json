  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7651,
  "text_len": 30
 },
 {
  "id": "sce066:01E09",
  "jp": "亜依「だぁ～めっ！　けってー！」",
  "off": 7689,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7691,
  "text_len": 22
 },
 {
  "id": "sce066:01E25",
  "jp": "透夜「‥‥ハァ」",
  "off": 7717,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7719,
  "text_len": 12
 },
 {
  "id": "sce066:01E3B",
  "jp": "亜依「そうと決まれば早速しゅっぱつしんこー！」",
