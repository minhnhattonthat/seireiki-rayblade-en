 },
 {
  "id": "sce247:01A0A",
  "jp": "セリカ「ど、どうもぉ～」",
  "off": 6666,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6668,
  "text_len": 13
 },
 {
  "id": "sce247:01A1D",
  "jp": "ユミール「‥‥」",
  "off": 6685,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6687,
  "text_len": 11
 },
 {
  "id": "sce247:01A2E",
  "jp": "ヤマト「セリカぁ⁈」",
  "off": 6702,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6704,
  "text_len": 11
 },
 {
  "id": "sce247:01A3F",
  "jp": "トウヤ「お前‥‥」",
  "off": 6719,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6721,
  "text_len": 12
 },
 {
  "id": "sce247:01A53",
  "jp": "セリカ「だってぇ、王宮に帰っても退屈だしぃ～{nl}　それに聖霊機の主任設計者である私がいないと{nl}　なにかと不便よ」",
  "off": 6739,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6741,
  "text_len": 72
 },
 {
  "id": "sce247:01AA1",
  "jp": "トウヤ「このことローディスは‥‥知るワケないよなぁ‥‥」",
  "off": 6817,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6819,
  "text_len": 34
 },
 {
  "id": "sce247:01AD3",
  "jp": "ユミール「‥‥はぁ。仕方ないわね。{nl}　あとで殿下には私から報告しておくわ」",
  "off": 6867,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6869,
  "text_len": 47
 },
 {
  "id": "sce247:01B08",
  "jp": "セリカ「やった！」",
  "off": 6920,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6922,
  "text_len": 10
 },
 {
  "id": "sce247:01B20",
  "jp": "ユミール「でも、ちゃんと自分で説明はするのよ？」",
  "off": 6944,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6946,
  "text_len": 30
 },
 {
  "id": "sce247:01B44",
  "jp": "セリカ「えぇ～」",
  "off": 6980,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6982,
  "text_len": 9
 },
 {
  "id": "sce247:01B67",
  "jp": "ユミール「“えぇ～”じゃないの！　わかった⁈」",
  "off": 7015,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7017,
  "text_len": 29
 },
 {
  "id": "sce247:01B8A",
  "jp": "セリカ「はぁーい」",
  "off": 7050,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7052,
  "text_len": 10
 },
 {
  "id": "sce247:01C11",
  "jp": "ユミール「では、作戦を説明します。{nl}　これより我々はクロンデェム鉱山跡に作られている{nl}　隠し砦へと向かいます。{nl}　そこでヨークの方々と合流し、その後、陽動と{nl}　実行隊に分け、フラムエルク城#946を目指します。{nl}　陽動部隊の進軍によってジグリム軍の警戒#37Dを{nl}　喚起させ、待ち伏せをしに出撃してくればよし、{nl}　それでも動かなければ適当に砲撃し、退却。{nl}　追撃してきたところを実行部隊が城#946を占拠します」",
  "off": 7185,
  "len": 255,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7187,
  "text_len": 252
 },
 {
  "id": "sce247:01D13",
  "jp": "ガリュード「陽動部隊はワシが指揮をとる。{nl}　向こうも正面から攻撃するとは思ってはおらんだろう{nl}　から、その期待どおり、ワシとレデュースで{nl}　ゲリラ戦を摸した陽動行動をとる」",
  "off": 7443,
  "len": 111,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7445,
  "text_len": 108
 },
 {
  "id": "sce247:01D85",
  "jp": "フェイン「え？　ではシエル殿は？」",
  "off": 7557,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7559,
  "text_len": 20
 },
 {
  "id": "sce247:01D9F",
  "jp": "シエル「私は実行部隊としてあなた方に同行します」",
  "off": 7583,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7585,
  "text_len": 32
 },
 {
  "id": "sce247:01DC5",
  "jp": "アーサー「陽動に引っ掛かってくれればいいですが、{nl}　向こうも城#946を守ることを第一に考えていると{nl}　思いますし、追撃してくる可能性は低いのでは{nl}　ありませんか？」",
  "off": 7621,
  "len": 102,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7623,
  "text_len": 99
 },
 {
  "id": "sce247:01E2E",
  "jp": "ガリュード「無論その可能性も考えられるが、{nl}　ジグリムの気質からやられっぱなしということは{nl}　考えにくい。{nl}　鋳突ではないが、戦いによって解決することを{nl}　潔しとしているからな」",
  "off": 7726,
  "len": 108,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7728,
  "text_len": 105
 },
 {
  "id": "sce247:01E9D",
  "jp": "セリカ「たしかに“西の蛮勇”とか言われてるモンね」",
  "off": 7837,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7839,
  "text_len": 31
 },
 {
  "id": "sce247:01ED4",
  "jp": "シィウチェン「合理主義から盟邦を見捨てる麹よりは{nl}　扱い易いだろうな」",
  "off": 7892,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7894,
  "text_len": 46
 },
 {
  "id": "sce247:01F08",
  "jp": "オーレリィ「ちょっと！」",
  "off": 7944,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7946,
  "text_len": 14
 },
 {
  "id": "sce247:01F1C",
  "jp": "セリカ「耳が痛いわね。いくら知らなかったとはいえ{nl}　結果として認めたようなカタチになったし。{nl}　でも、だからこそ、間違いは正したいの。{nl}　今度は私自身の意志で行動して。{nl}　これって傲慢かな？」",
  "off": 7964,
  "len": 120,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7966,
  "text_len": 117
 },
 {
  "id": "sce247:01F97",
  "jp": "シィウチェン「‥‥気分を害したか？」",
  "off": 8087,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8089,
  "text_len": 24
 },
 {
  "id": "sce247:01FB5",
  "jp": "セリカ「ううん。でもやっぱりちょっと辛いかな」",
  "off": 8117,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8119,
  "text_len": 24
 },
 {
  "id": "sce247:01FD3",
  "jp": "シィウチェン「責めるつもりはなかった。{nl}　少しその心内を訊きたかっただけだ。{nl}　これから共に戦うのだからな」",
  "off": 8147,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8149,
  "text_len": 61
 },
 {
  "id": "sce247:02016",
  "jp": "セリカ「‥‥それでどうだった？」",
  "off": 8214,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8216,
  "text_len": 19
 },
 {
  "id": "sce247:0202F",
  "jp": "シィウチェン「今後、仲間を疑うことはよそう」",
  "off": 8239,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8241,
  "text_len": 27
 },
 {
  "id": "sce247:02050",
  "jp": "セリカ「ふふふ、ありがとう」",
  "off": 8272,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8274,
  "text_len": 14
 },
 {
  "id": "sce247:0206F",
  "jp": "ユミール（ほっ）",
  "off": 8303,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8305,
  "text_len": 9
 },
 {
  "id": "sce247:02089",
  "jp": "ユミール「‥‥最終的に目指すのは{nl}　ヨークの象徴でもある、フラムエルク城#946の奪回です。{nl}　おそらくチャンスは一度。{nl}　各員の健闘を祈ります」",
  "off": 8329,
  "len": 93,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8331,
  "text_len": 90
 },
 {
  "id": "sce247:020FF",
  "jp": "マキ「レイスケ、こんな電磁ロックぐらいチョチョイって‥‥」",
  "off": 8447,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8449,
  "text_len": 33
 },
 {
  "id": "sce247:02126",
  "jp": "レイスケ「‥‥ピピピ」",
  "off": 8486,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8488,
  "text_len": 13
 },
 {
  "id": "sce247:02139",
  "jp": "マキ「‥‥なワケないわよねぇ‥‥どうしよ‥‥」",
  "off": 8505,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8507,
  "text_len": 29
 },
 {
  "id": "sce247:02169",
  "jp": "マキ「お腹、すいたなぁ‥‥」",
  "off": 8553,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8555,
  "text_len": 17
 },
 {
  "id": "sce247:021A2",
  "jp": "シスク「間もなく到着します。{nl}　でも、本当に大丈夫なんですか？」",
  "off": 8610,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8612,
  "text_len": 41
 },
 {
  "id": "sce247:021D9",
  "jp": "ガリュード「問題ない。そもそも一時期はここで{nl}　リーボーフェンの建造が計画されていたのだからな」",
  "off": 8665,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8667,
  "text_len": 60
 },
 {
  "id": "sce247:0221B",
  "jp": "ミヤスコ「あっ、見て！　山が‥‥割れてる！」",
  "off": 8731,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8733,
  "text_len": 29
 },
 {
  "id": "sce247:0223E",
  "jp": "ヤマト「本当だ。ニャんか秘密基地みたいね。{nl}　でもすごく目立つ構造よね」",
  "off": 8766,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8768,
  "text_len": 46
 },
 {
  "id": "sce247:02272",
  "jp": "レデュース「‥‥私は反対したのだが、ガリュード様が{nl}　許可を出してしまわれたからな‥‥」",
  "off": 8818,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8820,
  "text_len": 57
 },
 {
  "id": "sce247:022B1",
  "jp": "ガリュード「うむ。こうして見ると、少々派手だったのかも{nl}　しれぬな。だが、まあ、湖を作って、その中から出すよりは{nl}　見栄えはするだろう」",
  "off": 8881,
  "len": 82,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8883,
  "text_len": 79
 },
 {
  "id": "sce247:02306",
  "jp": "シエル「そんな計画もあったのですか⁈」",
  "off": 8966,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8968,
  "text_len": 22
 },
 {
  "id": "sce247:02322",
  "jp": "ガリュード「いや、ま、まぁ‥‥な」",
  "off": 8994,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8996,
  "text_len": 20
 },
 {
  "id": "sce247:0233C",
  "jp": "ユミール「あの‥‥あそこに着陸すればよろしいのですか？」",
  "off": 9020,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9022,
  "text_len": 34
 },
 {
  "id": "sce247:02364",
  "jp": "ガリュード「あ、ああ」",
  "off": 9060,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9062,
  "text_len": 12
 },
 {
  "id": "sce247:02376",
  "jp": "ユミール「バレン」",
  "off": 9078,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9080,
  "text_len": 10
 },
 {
  "id": "sce247:02386",
  "jp": "バレン「‥‥了解。これより、垂直着陸を行います」",
  "off": 9094,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9096,
  "text_len": 33
 },
 {
  "id": "sce247:02407",
  "jp": "ヨーク兵止A「ガリュード様だ」",
  "off": 9223,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9225,
  "text_len": 20
 },
 {
  "id": "sce247:02421",
  "jp": "ヨーク兵止B「ガリュード様が戻られた‥‥」",
  "off": 9249,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9251,
  "text_len": 29
 },
 {
  "id": "sce247:02444",
  "jp": "ヨーク兵止C「もう大丈夫だ。レデュース様も、{nl}　シエル様もおられる、俺達は勝てるぞ！」",
  "off": 9284,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9286,
  "text_len": 56
 },
 {
  "id": "sce247:02482",
  "jp": "ヨーク兵止D「ええ！　それに聖霊機も協力してくれる。{nl}　いよいよだわ‥‥」",
  "off": 9346,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9348,
  "text_len": 48
 },
 {
  "id": "sce247:024C0",
  "jp": "ガリュード「‥‥待たせてすまなかった。{nl}　このような事態を招いたのはワシの油断#66Cと傲慢だ。{nl}　その責めはいかようにも受けよう。{nl}　だがその前にワシにはやらねばならぬことがある。{nl}　陛下の、我々のこの地を不条理な抑庄より{nl}　解放すること。{nl}　そのために我々は帰って来た。{nl}　昨日までの屈辱を明日の勝利へと変える、{nl}　その日のために」",
  "off": 9408,
  "len": 205,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9410,
  "text_len": 202
 },
 {
  "id": "sce247:02590",
  "jp": "ヨーク兵止E「ガリュード様‥‥」",
  "off": 9616,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9618,
  "text_len": 23
 },
 {
  "id": "sce247:025AD",
  "jp": "ヨーク兵止F「ガリュード様！」",
  "off": 9645,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9647,
  "text_len": 21
 },
 {
  "id": "sce247:025C8",
  "jp": "ヨーク兵止G「おかえりなさいませ、ガリュード様！」",
  "off": 9672,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9674,
  "text_len": 31
 },
 {
  "id": "sce247:025ED",
  "jp": "ガリュード「あぁ、ああ‥‥今、戻った」",
  "off": 9709,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9711,
  "text_len": 24
 },
 {
  "id": "sce247:0260B",
  "jp": "トウヤ「大した人気だな」",
  "off": 9739,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9741,
  "text_len": 15
 },
 {
  "id": "sce247:02620",
  "jp": "？？？「ガリュード殿は我らの精神的柱といっても{nl}　過言ではないからな」",
  "off": 9760,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9762,
  "text_len": 47
 },
 {
  "id": "sce247:02655",
  "jp": "トウヤ「ん？　あんたは‥‥」",
  "off": 9813,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9815,
  "text_len": 17
 },
 {
  "id": "sce247:0266C",
  "jp": "？？？「この砦の維持を任されている{nl}　ただの老いぼれ兵だよ」",
  "off": 9836,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9838,
  "text_len": 39
 },
 {
  "id": "sce247:026A1",
  "jp": "ロア艦長「‥‥」",
  "off": 9889,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9891,
  "text_len": 12
 },
 {
  "id": "sce247:026B3",
  "jp": "トウヤ「あっ、艦長‥‥」",
  "off": 9907,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9909,
  "text_len": 16
 },
 {
  "id": "sce247:026C9",
  "jp": "？？？「ようこそ、クロンデェムへ。{nl}　心より歓迎します」",
  "off": 9929,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9931,
  "text_len": 34
 },
 {
  "id": "sce247:026F1",
  "jp": "ロア艦長「うむ」",
  "off": 9969,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9971,
  "text_len": 10
 },
 {
  "id": "sce247:02701",
  "jp": "？？？「‥‥ふふふ、久しぶりだな」",
  "off": 9985,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9987,
  "text_len": 23
 },
