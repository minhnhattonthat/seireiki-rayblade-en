  "len": 60,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5306,
  "text_len": 57
 },
 {
  "id": "sce247:014F7",
  "jp": "整備止A「いや、そこまでは言ってないんだが‥‥」",
