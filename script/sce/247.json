  "off": 5993,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5995,
  "text_len": 30
 },
 {
  "id": "sce247:0178D",
  "jp": "ローディス「はい、お願いします‥‥」",
