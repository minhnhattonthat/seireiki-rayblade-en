  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3493,
  "text_len": 54
 },
 {
  "id": "sce247:00DDF",
  "jp": "カスミ「ち、ちがう！　トウヤちゃんとは‥‥{nl}　そんな‥‥まだキスしか‥‥」",
  "off": 3551,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3553,
  "text_len": 44
 },
 {
  "id": "sce247:00E2A",
  "jp": "アイ「えーっ！　キスぅ⁈　冗談だったのに‥‥」",
  "off": 3626,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3628,
  "text_len": 30
 },
 {
  "id": "sce247:00E4E",
  "jp": "カスミ「えっ⁈　あ、で、でもあれは事故っていうか、{nl}　偶然っていうか‥‥」",
  "off": 3662,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3664,
  "text_len": 44
 },
 {
  "id": "sce247:00E99",
  "jp": "アイ「どうだかなぁ～」",
