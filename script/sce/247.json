  "status": "todo",
  "style": 0,
  "text_off": 5083,
  "text_len": 29
 },
 {
  "id": "sce247:013FC",
  "jp": "整備止A「お前等、無駄口叩いてないで手ぇ動かせ！{nl}　もうすぐ出航だぞ！　早く例のモノも積み込め！」",
  "off": 5116,
