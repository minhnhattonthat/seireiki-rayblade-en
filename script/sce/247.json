  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4456,
  "text_len": 9
 },
 {
  "id": "sce247:01195",
  "jp": "アイ「あーっ、うそうそ！　きっとカスミは‥‥」",
  "off": 4501,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4503,
  "text_len": 27
 },
 {
  "id": "sce247:011C1",
  "jp": "カスミ「ふふふふ、うーそ。",
