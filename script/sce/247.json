  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4386,
  "text_len": 13
 },
 {
  "id": "sce247:01133",
  "jp": "アイ「こんなこと嘘ついてどーすんの？{nl}　まぁ、あいつだったら他の人でも‥‥」",
  "off": 4403,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4405,
  "text_len": 45
 },
 {
  "id": "sce247:01166",
  "jp": "カスミ「‥‥」",
