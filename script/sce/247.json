  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4547,
  "text_len": 14
 },
 {
  "id": "sce247:011EB",
  "jp": "　トウヤちゃん誰にでも優しいから、{nl}　きっと私じゃなくても必死に助けようとするよ。{nl}　そこがトウヤちゃんの良いとこだもの」",
  "off": 4587,
