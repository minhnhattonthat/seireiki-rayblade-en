  "jp": "アイ「こぉらぁ、だましたなぁ～」",
  "off": 4686,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4688,
  "text_len": 17
 },
 {
  "id": "sce247:01265",
  "jp": "カスミ「きゃ～」",
  "off": 4709,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4711,
  "text_len": 9
 },
 {
  "id": "sce247:012A4",
  "jp": "アイ「優しい‥‥か。たしかにね‥‥」",
  "off": 4772,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4774,
  "text_len": 23
 },
 {
  "id": "sce247:012D4",
  "jp": "整備止E「フォルスティン、オルベスト、アハティの{nl}　積み込み完了しました」",
