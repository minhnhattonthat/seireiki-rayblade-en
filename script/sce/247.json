[
 {
  "id": "sce247:0004F",
  "jp": "ベイオ「グロウスターのケチダヌキめ、ダーガばかり{nl}　採揖しよって‥‥！　たかが120億ミルごときの{nl}　値をつけただけで渋りおる。{nl}　アレの実力を考えれば安い買い物だという事も{nl}　解っておらんのだ！　そうは思わんかメリッサ？」",
  "off": 79,
  "len": 136,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 81,
  "text_len": 133
 },
 {
  "id": "sce247:000E4",
  "jp": "メリッサ「はい、博止‥‥でも、ケチダヌキはあんまりですわ」",
  "off": 228,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 230,
  "text_len": 33
 },
 {
  "id": "sce247:0010B",
  "jp": "ベイオ「かまわぬ！　ワシのバイン・ダーガを{nl}　聖霊機なんぞと一緒にするような奴は{nl}　バカケチダヌキで十分だ！」",
  "off": 267,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 269,
  "text_len": 66
 },
 {
  "id": "sce247:00153",
  "jp": "メリッサ「はい、博止。　でもバカケチダヌキは‥‥{nl}{ctl:3C3E}{face:041F06}{ctl:1E3E}{face:041F0B}{ctl:023E}{face:041F03}{ctl:043E}{face:041F0C}　うっ‥‥」",
  "off": 339,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 341,
  "text_len": 69
 },
 {
  "id": "sce247:0019E",
  "jp": "ベイオ「どうした？　頭が痛むのか？」",
  "off": 414,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 416,
  "text_len": 22
 },
 {
  "id": "sce247:001BA",
  "jp": "メリッサ「‥‥聖霊‥‥機‥‥うっ‥‥」",
  "off": 442,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 444,
  "text_len": 30
 },
 {
  "id": "sce247:001DE",
  "jp": "ベイオ「だ、大丈夫か⁈{nl}　と、とにかく休むのだ。さぁ‥‥」",
  "off": 478,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 480,
  "text_len": 36
 },
 {
  "id": "sce247:00236",
  "jp": "メリッサ「は、はい‥‥すみません‥‥」",
  "off": 566,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 568,
  "text_len": 23
 },
 {
  "id": "sce247:00253",
  "jp": "ベイオ「気にするな。最近はバイン・ダーガのテストで{nl}　働きづめだったからな。無理もない。{nl}　今日はゆっくりと休めばいい」",
  "off": 595,
  "len": 73,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 597,
  "text_len": 70
 },
 {
  "id": "sce247:002AA",
  "jp": "メリッサ「はい‥‥」",
  "off": 682,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 684,
  "text_len": 12
 },
 {
  "id": "sce247:002C3",
  "jp": "ベイオ「聖霊機‥‥なぜその名に‥‥まさか‥‥」",
  "off": 707,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 709,
  "text_len": 33
 },
 {
  "id": "sce247:0031A",
  "jp": "トウヤ「ふぅ、これで全部か？　‥‥ん？」",
  "off": 794,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 796,
  "text_len": 26
 },
 {
  "id": "sce247:0033A",
  "jp": "ヤマト「ほらほら、手を休めてニャいで‥‥どうしたの？」",
  "off": 826,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 828,
  "text_len": 32
 },
 {
  "id": "sce247:0037F",
  "jp": "トウヤ「あれ‥‥ライブレードじゃねぇか？」",
  "off": 895,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 897,
  "text_len": 25
 },
 {
  "id": "sce247:0039E",
  "jp": "ヤマト「本当だ。ライブレードも持っていくんだ‥‥」",
  "off": 926,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 928,
  "text_len": 31
 },
 {
  "id": "sce247:003C3",
  "jp": "ユミール「そうよ」",
  "off": 963,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 965,
  "text_len": 10
 },
 {
  "id": "sce247:003D3",
  "jp": "トウヤ「あ、ユミール」",
  "off": 979,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 981,
  "text_len": 12
 },
 {
  "id": "sce247:003E5",
  "jp": "ユミール「置いておくほうが危険だから持って行くようにと{nl}　イ<E1>ェル様がおっしゃってね」",
  "off": 997,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 999,
  "text_len": 50
 },
 {
  "id": "sce247:0041D",
  "jp": "ヤマト「たしかに聖霊機がいニャくニャったら{nl}　ライブレードを手にいれようとするかもしれニャいものね」",
  "off": 1053,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1055,
  "text_len": 55
 },
 {
  "id": "sce247:0045A",
  "jp": "ユミール「ええ。もっとも、ライブレードはまだ完全に{nl}　直ってないから使えないけどね」",
  "off": 1114,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1116,
  "text_len": 48
 },
 {
  "id": "sce247:00490",
  "jp": "トウヤ「そうか。せっかく‥‥？　この香り‥‥」",
  "off": 1168,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1170,
  "text_len": 29
 },
 {
  "id": "sce247:004B3",
  "jp": "ユミール「あ、これ？　イ<E1>ェル様からいただいたの。{nl}　いい香りでしょ？」",
  "off": 1203,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1205,
  "text_len": 41
 },
 {
  "id": "sce247:004E2",
  "jp": "トウヤ「‥‥あのときの香りと同じだ‥‥」",
  "off": 1250,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1252,
  "text_len": 26
 },
 {
  "id": "sce247:00530",
  "jp": "ユミール「どうかした？」",
  "off": 1328,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1330,
  "text_len": 14
 },
 {
  "id": "sce247:00544",
  "jp": "トウヤ「あ、いや‥‥」",
  "off": 1348,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1350,
  "text_len": 13
 },
 {
  "id": "sce247:00557",
  "jp": "ベルンスト「おや、この香り‥‥ラクリマですね」",
  "off": 1367,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1369,
  "text_len": 26
 },
 {
  "id": "sce247:00577",
  "jp": "ユミール「え？　あ、そういえば、そのような名前の{nl}　花から抽出したとおっしゃっていました」",
  "off": 1399,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1401,
  "text_len": 52
 },
 {
  "id": "sce247:005B1",
  "jp": "トウヤ「あんた、こういうものも詳しいのか？」",
  "off": 1457,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1459,
  "text_len": 24
 },
 {
  "id": "sce247:005CF",
  "jp": "ベルンスト「いえいえ。{nl}　ラクリマは昔の知り合いが好きだった花でして」",
  "off": 1487,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1489,
  "text_len": 40
 },
 {
  "id": "sce247:005FD",
  "jp": "トウヤ「ふ～ん」",
  "off": 1533,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1535,
  "text_len": 9
 },
 {
  "id": "sce247:0060C",
  "jp": "ベルンスト「ところで、たしかライブレードを発見したのは{nl}　イ<E1>ェル様だったのですよね？」",
  "off": 1548,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1550,
  "text_len": 49
 },
 {
  "id": "sce247:00643",
  "jp": "ユミール「え、ええ。そう聞いてますけど‥‥」",
  "off": 1603,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1605,
  "text_len": 26
 },
 {
  "id": "sce247:00663",
  "jp": "ベルンスト「なるほど。{nl}　そういうことだったのですね。ふふふふふ‥‥」",
  "off": 1635,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1637,
  "text_len": 37
 },
 {
  "id": "sce247:0068E",
  "jp": "トウヤ「気持ちわりぃなぁ」",
  "off": 1678,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1680,
  "text_len": 15
 },
 {
  "id": "sce247:006A3",
  "jp": "ベルンスト「ふふふふ‥‥失礼。{nl}　ユミールさん。その香水、大切にしてくださいね。{nl}　それでは失礼します」",
  "off": 1699,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1701,
  "text_len": 63
 },
 {
  "id": "sce247:006E8",
  "jp": "ユミール「‥‥どういう意味かしら？」",
  "off": 1768,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1770,
  "text_len": 24
 },
 {
  "id": "sce247:00706",
  "jp": "トウヤ「さあ？」",
  "off": 1798,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1800,
  "text_len": 9
 },
 {
  "id": "sce247:00715",
  "jp": "ユミール「それじゃ、そろそろブリッジへいきましょうか」",
  "off": 1813,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1815,
  "text_len": 28
 },
 {
  "id": "sce247:00737",
  "jp": "トウヤ「あ、ああ‥‥」",
  "off": 1847,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1849,
  "text_len": 13
 },
