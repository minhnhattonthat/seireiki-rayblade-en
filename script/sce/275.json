  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5779,
  "text_len": 24
 },
 {
  "id": "sce275:016AF",
  "jp": "トウヤ「お前なぁ！」",
  "off": 5807,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5809,
  "text_len": 12
 },
 {
  "id": "sce275:016C1",
  "jp": "アルフォリナ「ふふふふ‥‥仲良しさんなのですね」",
  "off": 5825,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5827,
  "text_len": 28
 },
 {
  "id": "sce275:016E3",
  "jp": "ヤマト「とんでもニャい。まったく手のかかる{nl}　弟をもつと苦労するわぁ」",
  "off": 5859,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5861,
  "text_len": 39
 },
 {
  "id": "sce275:01710",
