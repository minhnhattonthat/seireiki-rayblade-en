  "off": 6003,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6005,
  "text_len": 23
 },
 {
  "id": "sce275:01790",
  "jp": "トウヤ「それはお前だ！」",
  "off": 6032,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6034,
  "text_len": 14
 },
 {
  "id": "sce275:017A4",
  "jp": "アルフォリナ「ふふふふふふ‥‥{nl}　本当に楽しいお二人ですね」",
  "off": 6052,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6054,
  "text_len": 37
 },
 {
  "id": "sce275:017D9",
