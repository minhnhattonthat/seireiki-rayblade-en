 },
 {
  "id": "sce178:005BE",
  "jp": "アーサー「今、捜索中なのでしょ？{nl}　大丈夫ですよ」",
  "off": 1470,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1474,
  "text_len": 35
 },
 {
  "id": "sce178:005E6",
  "jp": "フェイン「しかし、大変なことをしてくれたぜ‥‥」",
  "off": 1510,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1514,
  "text_len": 28
 },
 {
  "id": "sce178:00607",
  "jp": "アーサー「ええ。カイン王子が復讐#54Fのためだけに{nl}　こういうことをしたとは‥‥」",
  "off": 1543,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1547,
  "text_len": 46
 },
 {
  "id": "sce178:0063A",
  "jp": "レスト「‥‥彼がホーレム大統領に近づいたのは{nl}　こういうことをするための“力”を欲したから{nl}　だったのだな‥‥」",
  "off": 1594,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1598,
  "text_len": 70
 },
 {
  "id": "sce178:00685",
  "jp": "フェイン「姫、私は詳しいことは知らないのですが、{nl}　殿下はレイフォン様にそんなひどいことをしたのですか？」",
  "off": 1669,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1673,
  "text_len": 61
 },
 {
  "id": "sce178:006C7",
  "jp": "セリカ「‥‥そうね‥‥確かに兄さんは{nl}　レイフォン兄を傷つけたわ。{page}　それからすぐにレイフォン兄は{nl}　＜ゼ＝オード＞の調査隊に志願し、{nl}　3年前の爆発に巻き込まれたの‥‥」",
  "off": 1735,
  "len": 117,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1739,
  "text_len": 112
 },
 {
  "id": "sce178:0073C",
  "jp": "トウヤ「そのレイフォンって何者なんだ？」",
  "off": 1852,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1856,
  "text_len": 23
 },
 {
  "id": "sce178:00758",
  "jp": "フェイン「‥‥え？」",
  "off": 1880,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1884,
  "text_len": 13
 },
 {
  "id": "sce178:0076A",
  "jp": "アーサー「そういえば説明してなかったですね。{nl}　‥‥レイフォン・ラング・マクソード。{page}　王弟ガハリン大公の息子で、錬金学止では{nl}　ありませんでしたが、装兵機の設計にも携わり、{nl}　自ら操者としても括#3A2躍した人物です。{nl}　3年前の爆発で死亡したとされていたのですが‥‥」",
  "off": 1898,
  "len": 175,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1902,
  "text_len": 170
 },
 {
  "id": "sce178:00819",
  "jp": "アガルティア兵止「少佐！　調査隊からの報告です！{nl}　陛下の無事を確認！　ティックス王子の身柄も{nl}　捕護しました！」",
  "off": 2073,
  "len": 87,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2077,
  "text_len": 82
 },
 {
  "id": "sce178:00870",
  "jp": "セリカ「に、兄さんは⁈」",
  "off": 2160,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2164,
  "text_len": 14
 },
 {
  "id": "sce178:00883",
  "jp": "アガルティア兵止「はっ‥‥今だ確認されて‥‥あっ！{nl}　ローディス様を発見いたしました！{nl}　無事です！　殿下はご無事です！」",
  "off": 2179,
  "len": 89,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2183,
  "text_len": 84
 },
 {
