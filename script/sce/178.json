  "off": 2625,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2629,
  "text_len": 26
 },
 {
  "id": "sce178:00A60",
  "jp": "レスト「ああ。兵止達も薬の呪縛から{nl}　解き放たれている。脱力状態にはなっているが、{nl}　精神崩壊や、副作揖はない。{nl}　あとは事後処理だけだ‥‥⁈」",
  "off": 2656,
  "len": 103,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2660,
  "text_len": 98
 },
 {
  "id": "sce178:00AC7",
