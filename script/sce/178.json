  "text_len": 29
 },
 {
  "id": "sce178:00314",
  "jp": "トウヤ「ああ。たぶんな。王都の人達は普通みたいだし、{nl}　あの薬とやらの効果も永遠じゃねぇみてぇだしな」",
  "off": 788,
