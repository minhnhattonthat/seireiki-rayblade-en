  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2504,
  "text_len": 14
 },
 {
  "id": "sce178:009DA",
  "jp": "マキ「う、うん。私はね。{nl}　とにかく、手が空いたら病室に来てね。{nl}　いろいろ話したいし‥‥」",
  "off": 2522,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2524,
  "text_len": 55
 },
