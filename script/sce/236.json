  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3129,
  "text_len": 70
 },
 {
  "id": "sce236:00C95",
  "jp": "アイ「ふぅ～ん‥‥そういうとこはちゃんとしてんだ、一応」",
