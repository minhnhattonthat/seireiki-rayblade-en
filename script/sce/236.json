  "style": 0,
  "text_off": 2654,
  "text_len": 9
 },
 {
  "id": "sce236:00A6B",
  "jp": "アイ「いや、いい。今の反応でだいたいのことはわかった。{nl}　そっか。あの子も大変なんだね‥‥うんうん」",
  "off": 2667,
  "len": 61,
