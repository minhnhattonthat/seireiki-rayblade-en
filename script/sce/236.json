  "off": 1749,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1751,
  "text_len": 11
 },
 {
  "id": "sce236:006E6",
  "jp": "アイ「会わなくなった原姻はあんたが避けたから。{nl}　そうでしょ？」",
