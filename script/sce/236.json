  "status": "todo",
  "style": 0,
  "text_off": 1322,
  "text_len": 66
 },
 {
  "id": "sce236:00570",
  "jp": "トウヤ「ああ。だけどあいつはそんなことおかまいなしで{nl}　接してきた。ほっとけなかったんだとさ」",
  "off": 1392,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1394,
  "text_len": 48
 },
 {
  "id": "sce236:005A6",
