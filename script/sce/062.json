  "id": "sce062:027D7",
  "jp": "トウヤ「ああ‥‥」",
  "off": 10199,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 10203,
  "text_len": 11
 },
