  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 8573,
  "text_len": 34
 },
 {
  "id": "sce062:021A0",
  "jp": "トウヤ「‥‥ちっ、考えさせる時間もくれねぇのか‥‥」",
