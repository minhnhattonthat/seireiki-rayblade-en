  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 8669,
  "text_len": 15
 },
 {
  "id": "sce062:021ED",
  "jp": "ヤマト「あれ？　どうして送信モードにしてるの？{nl}　ねぇ。ねぇ、トウ‥‥」",
