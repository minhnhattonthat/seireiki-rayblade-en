[
 {
  "id": "sce094:00063",
  "jp": "カスミ「はい、どなたですか？」",
  "off": 99,
  "len": 19,
  "en": "Kasumi: Yes, who is it?",
  "status": "translated",
  "style": 0,
  "text_off": 101,
  "text_len": 16
 },
 {
  "id": "sce094:00079",
  "jp": "トウヤ「あ、俺だけど」",
  "off": 121,
  "len": 15,
  "en": "Touya: Ah, it's me.",
  "status": "translated",
  "style": 0,
  "text_off": 123,
  "text_len": 12
 },
 {
  "id": "sce094:0008B",
  "jp": "カスミ「あっ、トウヤちゃん！　ど、どうぞ」",
  "off": 139,
  "len": 25,
  "en": "Kasumi: Oh, Touya-chan! C-come in.",
  "status": "translated",
  "style": 0,
  "text_off": 141,
  "text_len": 22
 },
 {
  "id": "sce094:000C8",
  "jp": "カスミ「どうしたの？」",
  "off": 200,
  "len": 15,
  "en": "Kasumi: What's up?",
  "status": "translated",
  "style": 0,
  "text_off": 202,
  "text_len": 12
 },
 {
  "id": "sce094:000DA",
  "jp": "トウヤ「いや、別にこれといった用はねぇんだけど‥‥{nl}　ちょっとカスミと話をしたいなと思って‥‥」",
  "off": 218,
  "len": 59,
  "en": "Touya: Nah, nothing in particular... I just thought I'd talk with you for a bit, Kasumi...",
  "status": "translated",
  "style": 0,
  "text_off": 220,
  "text_len": 56
 },
 {
  "id": "sce094:0012A",
  "jp": "カスミ「‥‥うれしいな。高校に入ったら前みたいに{nl}　話せなかったし」",
  "off": 298,
  "len": 44,
  "en": "Kasumi: ...That makes me happy. Once we got into high school, we couldn't talk like we used to.",
  "status": "translated",
  "style": 0,
  "text_off": 300,
  "text_len": 41
 },
 {
  "id": "sce094:00159",
  "jp": "トウヤ「そうか？　朝とかほとんど毎日一緒じゃねぇか」",
  "off": 345,
  "len": 35,
  "en": "Touya: Really? We're together almost every morning, aren't we?",
  "status": "translated",
  "style": 0,
  "text_off": 347,
  "text_len": 32
 },
 {
  "id": "sce094:00191",
  "jp": "カスミ「昔はいつも一緒だったよ」",
  "off": 401,
  "len": 22,
  "en": "Kasumi: We used to be together all the time.",
  "status": "translated",
  "style": 0,
  "text_off": 403,
  "text_len": 19
 },
 {
  "id": "sce094:001AA",
  "jp": "トウヤ「昔っていつの話だ？」",
