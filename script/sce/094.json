  "text_len": 18
 },
 {
  "id": "sce094:002E5",
  "jp": "カスミ「もぅ‥‥。{nl}{ctl:3C3E}{face:04F903}{ctl:023E}{face:04F602}{ctl:013E}{face:04F6F0}　あっ、トウヤちゃん、脱いで」",
