  "style": 0,
  "text_off": 389,
  "text_len": 21
 },
 {
  "id": "sce428:0019E",
  "jp": "ヤマト「どうしたの？」",
  "off": 414,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 416,
  "text_len": 12
 },
 {
  "id": "sce428:001B0",
  "jp": "ゲン「メル<E1>ィがいないんだ！」",
  "off": 432,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 434,
  "text_len": 16
 },
 {
  "id": "sce428:001C6",
  "jp": "トウヤ「え？」",
