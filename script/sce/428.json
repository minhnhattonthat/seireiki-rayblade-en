  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 456,
  "text_len": 8
 },
 {
  "id": "sce428:001D4",
  "jp": "ゲン「だからメル<E1>ィが行方不明なんだよ！」",
  "off": 468,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 470,
  "text_len": 26
 },
 {
  "id": "sce428:001F4",
  "jp": "トウヤ「行方不明って‥‥部屋にいねぇんだったら、{nl}　フォルスティンの中じゃねぇのか？」",
  "off": 500,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 502,
  "text_len": 53
 },
 {
  "id": "sce428:0022F",
  "jp": "ゲン「もう探したよ！{nl}　あいつ、とんでもない方徇音痴だろ？{page}　だから、甲板にでたり、通気孔にもぐりこんでたり、{nl}　とにかく、シャレになんないことになりそうだから、{nl}　兄ちゃんならわかるかなっておもったんだけど‥‥」",
  "off": 559,
  "len": 125,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 561,
  "text_len": 122
 },
 {
  "id": "sce428:002AF",
  "jp": "トウヤ「う～ん‥‥」",
  "off": 687,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 689,
  "text_len": 13
 },
 {
  "id": "sce428:002C2",
  "jp": "ヤマト「確かにメル<E1>ィニャら迷ってる可能性は{nl}　十分にあるわね」",
  "off": 706,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 708,
  "text_len": 39
 },
 {
  "id": "sce428:002EF",
  "jp": "ゲン「だろう？　それじゃ、手分けして探そうよ！」",
  "off": 751,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 753,
  "text_len": 29
 },
 {
  "id": "sce428:00312",
  "jp": "トウヤ「よし」",
  "off": 786,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 788,
  "text_len": 7
 },
 {
  "id": "sce428:0031F",
  "jp": "ヤマト「‥‥ねぇ、ゲン。どうしてそんニャに{nl}　必死にニャるの？」",
  "off": 799,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 801,
  "text_len": 37
 },
 {
  "id": "sce428:0034A",
  "jp": "ゲン「え？　友達を心配するのは当然だろ？{nl}　それに‥‥危なっかしくてほっておけないんだよなぁ」",
  "off": 842,
  "len": 61,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 844,
  "text_len": 58
 },
 {
  "id": "sce428:0038A",
  "jp": "ヤマト「ニャるほどねぇ‥‥」",
  "off": 906,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 908,
  "text_len": 16
 },
 {
  "id": "sce428:003A0",
  "jp": "ゲン「とにかく、オイラは上から見ていくから。頼んだよ！」",
  "off": 928,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 930,
  "text_len": 32
 },
 {
  "id": "sce428:003D2",
  "jp": "ヤマト「‥‥さて、それじゃ、あたし達も行きましょう」",
  "off": 978,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 980,
  "text_len": 30
 },
 {
  "id": "sce428:003F6",
  "jp": "トウヤ「でもよ、どこを探すんだ？　適当に探しても{nl}　見つかんねぇ‥‥って、そういやセンサーは？」",
  "off": 1014,
  "len": 61,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1016,
  "text_len": 58
 },
 {
  "id": "sce428:00436",
  "jp": "ヤマト「うーん、また調子が悪いみたい‥‥{nl}　ニャんとニャく、下のほうに感じるんだけど‥‥」",
  "off": 1078,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1080,
  "text_len": 55
 },
 {
  "id": "sce428:00473",
