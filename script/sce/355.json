  "len": 46,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 8953,
  "text_len": 41
 },
 {
  "id": "sce355:02334",
  "jp": "シィウチェン「フッ‥‥戻れと言われて素直に従うと{nl}　思うか？　仲間に押し付けて自分だけ去るほど{nl}　落ちぶれてはいない」",
  "off": 9012,
  "len": 81,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 9016,
  "text_len": 76
 },
