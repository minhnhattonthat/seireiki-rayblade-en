  "text_off": 1392,
  "text_len": 24
 },
 {
  "id": "sce171:0058C",
  "jp": "　あの時、悲しそうな顔してたから{nl}　仲間のこと心配するのに理由がいるのか？",
  "off": 1420,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 128,
