  "text_off": 1487,
  "text_len": 8
 },
 {
  "id": "sce171:005DB",
  "jp": "トウヤ「俺の勘違いかもしれねぇが、あの時のお前、{nl}　なんか無理してたような気がしたから‥‥」",
  "off": 1499,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1501,
  "text_len": 56
 },
