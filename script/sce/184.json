 },
 {
  "id": "sce184:00F76",
  "jp": "　‥‥クロビスに口説きのレッスンを受けた。{nl}　相変わらず役に立ちそうもない‥‥。",
  "off": 3958,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3960,
  "text_len": 51
 },
 {
  "id": "sce184:01070",
  "jp": "クロビス「おお、ト、トウヤ‥‥どどどど、どうした‥‥？」",
  "off": 4208,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4210,
  "text_len": 33
 },
 {
  "id": "sce184:01097",
  "jp": "トウヤ「心配しねぇでもヤマトはいねぇよ。{nl}　それより、訊きたいことがあるんだ」",
  "off": 4247,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4249,
  "text_len": 42
 },
 {
  "id": "sce184:010C7",
  "jp": "クロビス「おお、なんだ」",
  "off": 4295,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4297,
  "text_len": 12
 },
 {
  "id": "sce184:010D9",
  "jp": "トウヤ「この前、聖地で一緒にいた女の人、ありゃ、{nl}　いったい誰だ？」",
  "off": 4313,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4315,
  "text_len": 43
 },
 {
  "id": "sce184:0110F",
  "jp": "クロビス「あっ、その目は疑ってるな？{nl}　あれはだな。別にそういう関係ではないぞ。{nl}　まぁ、向こうはOKだったみたいだがな」",
  "off": 4367,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4369,
  "text_len": 68
 },
 {
  "id": "sce184:01159",
  "jp": "トウヤ「手は出してないと？」",
  "off": 4441,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4443,
  "text_len": 17
 },
 {
  "id": "sce184:01170",
  "jp": "クロビス「もちろんだ」",
  "off": 4464,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4466,
  "text_len": 11
 },
 {
  "id": "sce184:01181",
  "jp": "トウヤ「まぁ、信じるけどよ」",
  "off": 4481,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4483,
  "text_len": 15
 },
 {
  "id": "sce184:0119C",
  "jp": "クロビス「そいつは助かる」",
  "off": 4508,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4510,
  "text_len": 14
 },
 {
  "id": "sce184:011B0",
  "jp": "トウヤ「でもよ、そんならなんで一緒に消えたんだ？」",
  "off": 4528,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4530,
  "text_len": 29
 },
 {
  "id": "sce184:011D3",
  "jp": "クロビス「呼び出されたんだよ。{nl}　まぁ、なだめるのは大変だったがな」",
  "off": 4563,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4565,
  "text_len": 38
 },
 {
  "id": "sce184:011FF",
  "jp": "トウヤ「向こうからアプローチしてきたってことか？」",
  "off": 4607,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4609,
  "text_len": 28
 },
 {
  "id": "sce184:01221",
  "jp": "クロビス「ま、まぁ、最初のアクションは俺だがな」",
  "off": 4641,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4643,
  "text_len": 27
 },
 {
  "id": "sce184:01242",
  "jp": "トウヤ「‥‥あんたなぁ‥‥」",
  "off": 4674,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4676,
  "text_len": 18
 },
 {
  "id": "sce184:0125A",
  "jp": "クロビス「ははははは！　まぁ、息抜きぐらいは必要だろ？」",
  "off": 4698,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4700,
  "text_len": 34
 },
 {
  "id": "sce184:01282",
  "jp": "トウヤ「あんたっていう人がよくわからねぇよ」",
  "off": 4738,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4740,
  "text_len": 23
 },
 {
  "id": "sce184:0129F",
  "jp": "クロビス「男はミステリアスな魅力があってこそ{nl}　モテるんだぜ？　お前も頑張れよ。じゃあな」",
  "off": 4767,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4769,
  "text_len": 52
 },
 {
  "id": "sce184:012E4",
  "jp": "クロビス「え？　あ、ああ、あれか‥‥{nl}　誰だと思う？」",
  "off": 4836,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4838,
  "text_len": 33
 },
 {
  "id": "sce184:0130B",
  "jp": "　ズバリ愛人！{nl}　行きずりの女の人{nl}　クロビスのファン",
  "off": 4875,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 192,
  "text_off": 4877,
  "text_len": 33
 },
 {
  "id": "sce184:01340",
  "jp": "クロビス「おしい、いい勘してるな。{nl}　だが、残念ながらハズレだ。あれは単なる知り合い。{nl}　それ以上でも以下でもない」",
  "off": 4928,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4930,
  "text_len": 68
 },
 {
  "id": "sce184:01393",
  "jp": "クロビス「‥‥なかなか基本的な発想だな。{nl}　残念ながらハズレだ。あれは単なる知り合い。{nl}　それ以上でも以下でもない」",
  "off": 5011,
  "len": 77,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5013,
  "text_len": 74
 },
 {
  "id": "sce184:013E6",
  "jp": "クロビス「‥‥お前、俺をそういう目で見てたのか？」",
  "off": 5094,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5096,
  "text_len": 32
 },
 {
  "id": "sce184:0140C",
  "jp": "トウヤ「え？　ちがうのか？」",
  "off": 5132,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5134,
  "text_len": 16
 },
 {
  "id": "sce184:01422",
  "jp": "クロビス「あたりまえだろ？　あれは単なる知り合いだ。{nl}　それ以上でも以下でもない」",
  "off": 5154,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5156,
  "text_len": 49
 },
 {
  "id": "sce184:0145C",
  "jp": "トウヤ「え？」",
  "off": 5212,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5214,
  "text_len": 8
 },
 {
  "id": "sce184:0146A",
  "jp": "クロビス「‥‥お前、あの子と俺が“大人の関係”{nl}　だとでも思ったのか？」",
  "off": 5226,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5228,
  "text_len": 49
 },
 {
  "id": "sce184:014A1",
  "jp": "トウヤ「‥‥」",
  "off": 5281,
  "len": 12,
  "en": "Touya: ...",
  "status": "translated",
  "style": 0,
  "text_off": 5283,
  "text_len": 9
 },
 {
  "id": "sce184:014B0",
  "jp": "クロビス「なるほど‥‥そういう発想をするということは、{nl}　お前、相当溜まってるだろ？」",
  "off": 5296,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5298,
  "text_len": 52
 },
 {
  "id": "sce184:014EA",
  "jp": "トウヤ「なっ⁉」",
  "off": 5354,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5356,
  "text_len": 9
 },
 {
  "id": "sce184:014F9",
  "jp": "クロビス「ははははは、照れるな。{nl}　そうか、なら今度俺がいいところに連れていってやろう」",
  "off": 5369,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5371,
  "text_len": 49
 },
 {
  "id": "sce184:01530",
  "jp": "トウヤ「え？　いい、ところ‥‥？」",
  "off": 5424,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5426,
  "text_len": 21
 },
 {
  "id": "sce184:0154B",
  "jp": "クロビス「そう、いろいろシチュエーションを選べて‥‥」",
