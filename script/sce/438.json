  "style": 0,
  "text_off": 5391,
  "text_len": 12
 },
 {
  "id": "sce438:0151F",
  "jp": "ヤマト「カスミって、フェインと‥‥」",
  "off": 5407,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5409,
  "text_len": 20
 },
 {
  "id": "sce438:0153D",
  "jp": "カスミ「？　フェイン君は荷物を運ぶのを{nl}　手伝ってくれただけだよ。{nl}　それがどうかしたの？」",
  "off": 5437,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5439,
  "text_len": 54
 },
 {
  "id": "sce438:01579",
  "jp": "トウヤ「荷物？」",
  "off": 5497,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5499,
  "text_len": 11
 },
 {
  "id": "sce438:0159C",
  "jp": "カスミ「着替えとかは一人で大丈夫だったけど、{nl}　本なんかはさすがに運べなくって‥‥{nl}　そしたらフェイン君が通りかかって」",
  "off": 5532,
  "len": 76,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5534,
  "text_len": 73
 },
 {
  "id": "sce438:015EB",
  "jp": "トウヤ「それであいつが運んでやるって言い出したんだな？」",
  "off": 5611,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5613,
  "text_len": 32
 },
 {
  "id": "sce438:01623",
  "jp": "カスミ「うん。よくわかったね」",
  "off": 5667,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5669,
  "text_len": 15
 },
 {
  "id": "sce438:01638",
  "jp": "トウヤ「まあ、さっきのあいつの態度をみてたら、{nl}　ほっとくワケねぇだろうからな」",
  "off": 5688,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5690,
  "text_len": 42
 },
 {
  "id": "sce438:0166C",
  "jp": "カスミ「フェイン君ってどこかトウヤちゃんに似てるよね」",
  "off": 5740,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5742,
  "text_len": 29
 },
 {
  "id": "sce438:0168F",
  "jp": "トウヤ「そうか？」",
  "off": 5775,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5777,
  "text_len": 10
 },
 {
  "id": "sce438:016B1",
  "jp": "カスミ「うん。裏表のないところとか、優しいところとか」",
  "off": 5809,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5811,
  "text_len": 30
 },
 {
  "id": "sce438:016D5",
  "jp": "ヤマト「彼の場合は明確ニャ目的がある上での{nl}　行動だと思うけど‥‥」",
  "off": 5845,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5847,
  "text_len": 47
 },
 {
  "id": "sce438:0171C",
  "jp": "カスミ「？」",
  "off": 5916,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5918,
  "text_len": 7
 },
 {
  "id": "sce438:01729",
  "jp": "トウヤ「もう荷物は大丈夫なのか？{nl}　何かあるなら手伝うぞ」",
  "off": 5929,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5931,
  "text_len": 38
 },
 {
  "id": "sce438:01755",
  "jp": "カスミ「ううん。大丈夫。後は整理するだけだから」",
  "off": 5973,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5975,
  "text_len": 30
 },
 {
  "id": "sce438:01779",
  "jp": "トウヤ「そうか。まあ、何かあったら遠慮せずに言えよ」",
  "off": 6009,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6011,
  "text_len": 30
 },
 {
  "id": "sce438:017A1",
  "jp": "カスミ「うん。そうする」",
  "off": 6049,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6051,
  "text_len": 12
 },
 {
  "id": "sce438:017B3",
  "jp": "トウヤ「それじゃ」",
  "off": 6067,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6069,
  "text_len": 9
 },
 {
  "id": "sce438:018E0",
  "jp": "トウヤ「よっ」",
  "off": 6368,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6370,
  "text_len": 7
 },
 {
  "id": "sce438:018F5",
  "jp": "セリカ「ああ、トウヤ。どうしたの？」",
  "off": 6389,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6391,
  "text_len": 19
 },
 {
  "id": "sce438:01914",
  "jp": "トウヤ「ん？　まぁ、別にこれといって用はねぇけど」",
  "off": 6420,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6422,
  "text_len": 28
 },
 {
  "id": "sce438:0193B",
  "jp": "セリカ「ふぅ～ん。それじゃ、私の代わりにこの席を温める{nl}　任務を与えます」",
  "off": 6459,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6461,
  "text_len": 45
 },
 {
  "id": "sce438:0196E",
  "jp": "トウヤ「はぁ？」",
  "off": 6510,
  "len": 12,
  "en": "Touya: Huh?",
  "status": "translated",
  "style": 0,
  "text_off": 6512,
  "text_len": 9
 },
 {
  "id": "sce438:0198F",
  "jp": "セリカ「暇なんでしょ？」",
  "off": 6543,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6545,
  "text_len": 14
 },
 {
  "id": "sce438:019A3",
  "jp": "トウヤ「それほどまでに暇じゃねぇよ。それじゃあな！」",
  "off": 6563,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6565,
  "text_len": 28
 },
 {
  "id": "sce438:019C9",
  "jp": "セリカ「あっ‥‥」",
  "off": 6601,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6603,
  "text_len": 11
 },
 {
  "id": "sce438:019E2",
  "jp": "セリカ「新しい出会いをもとめて放浪中とか？」",
  "off": 6626,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6628,
  "text_len": 29
 },
 {
  "id": "sce438:01A05",
  "jp": "トウヤ「んなわけねぇーだろ」",
  "off": 6661,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6663,
  "text_len": 15
 },
 {
  "id": "sce438:01A25",
  "jp": "セリカ「そうよね。トウヤって、どっちかというと自分から{nl}　積極的に恋を求める感じじゃないものね」",
  "off": 6693,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6695,
  "text_len": 56
 },
 {
  "id": "sce438:01A63",
  "jp": "トウヤ「じゃ、どう見えるんだ？」",
  "off": 6755,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6757,
  "text_len": 18
 },
 {
  "id": "sce438:01A7F",
  "jp": "セリカ「う～ん、自分では特に気してない行動が{nl}　相手の心を動かして、いつのまにかうまくいく、{nl}{ctl:783E}{face:041C05}　かな？」",
  "off": 6783,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6785,
  "text_len": 72
 },
 {
  "id": "sce438:01ACD",
  "jp": "トウヤ「そんなに都合のいいことあるかよ」",
  "off": 6861,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6863,
  "text_len": 22
 },
 {
  "id": "sce438:01AF4",
  "jp": "セリカ「まっ、そのうち分かるわよ。{nl}　さて、それじゃ、私そろそろ行くね」",
  "off": 6900,
  "len": 42,
  "en": "",
  "status": "todo",
