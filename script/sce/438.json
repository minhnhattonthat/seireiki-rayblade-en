  "off": 2538,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2540,
  "text_len": 21
 },
 {
  "id": "sce438:00A07",
  "jp": "ヤマト「あっ‥‥出ていっちゃった‥‥{nl}　どこに連れていかれたんだろ？」",
