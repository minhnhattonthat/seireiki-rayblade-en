  "id": "sce158:022FF",
  "jp": "トウヤ「俺もできることがあったらなんでも協力するぜ」",
  "off": 8959,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8961,
  "text_len": 29
 },
 {
  "id": "sce158:02322",
  "jp": "シィウチェン「‥‥すまんな」",
  "off": 8994,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8996,
  "text_len": 16
 },
 {
  "id": "sce158:02340",
