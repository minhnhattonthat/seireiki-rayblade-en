 },
 {
  "id": "sce158:02861",
  "jp": "カイン「‥‥あれでよかったのかい？」",
  "off": 10337,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 10339,
  "text_len": 21
 },
 {
  "id": "sce158:0287C",
  "jp": "ホーレム「ええ。少し残念ではありますが、{nl}　あの状態で無理に引き止めたところで{nl}　彼女の心を開くことはできません」",
  "off": 10364,
  "len": 74,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 10366,
  "text_len": 71
 },
 {
  "id": "sce158:028C9",
  "jp": "カイン「だったらあの計画の成果を使えばいいじゃないか」",
  "off": 10441,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 10443,
  "text_len": 32
 },
 {
  "id": "sce158:028EF",
  "jp": "ホーレム「作られた人格では人を導くことはできません」",
