  "off": 7811,
  "len": 15,
  "en": "Xiujian: ...",
  "status": "translated",
  "style": 0,
  "text_off": 7813,
  "text_len": 12
 },
 {
  "id": "sce158:01E95",
  "jp": "トウヤ「‥‥はぁ。ま、いいや。{nl}　気がむいたらいつでも‥‥」",
