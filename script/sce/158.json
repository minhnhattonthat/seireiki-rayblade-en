[
 {
  "id": "sce158:00050",
  "jp": "ベイオ「‥‥どうすれば‥‥ワシは‥‥」",
  "off": 80,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 82,
  "text_len": 25
 },
 {
  "id": "sce158:00085",
  "jp": "バイオ「誉め言葉をありがとう。{nl}　‥‥で、提案なんだけど‥‥{nl}　兄さんが昔研究していたあの技術。{nl}　アレを使うんだよ」",
  "off": 133,
  "len": 78,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 135,
  "text_len": 75
 },
 {
  "id": "sce158:000D6",
  "jp": "ベイオ「昔？」",
  "off": 214,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 216,
  "text_len": 9
 },
 {
  "id": "sce158:000E5",
  "jp": "バイオ「とぼけないでくれよ。{nl}　アレだよアレ。“コード3”の‥‥」",
  "off": 229,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 231,
  "text_len": 38
 },
 {
  "id": "sce158:00111",
  "jp": "ベイオ「‼　お前、なぜそのことを‥‥」",
  "off": 273,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 275,
  "text_len": 23
 },
 {
  "id": "sce158:0012E",
  "jp": "バイオ「いや、ちょっと、ね‥‥」",
  "off": 302,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 304,
  "text_len": 18
 },
 {
  "id": "sce158:00146",
  "jp": "ベイオ「ワシのデータベースに侵入したな⁈{nl}　しかし、あのプロテクトを解除するとは‥‥{nl}　お前にそんな才能があったとは意外だな」",
  "off": 326,
  "len": 80,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 328,
  "text_len": 77
 },
 {
  "id": "sce158:00199",
  "jp": "バイオ「私じゃないよ。このセレアさ」",
  "off": 409,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 411,
  "text_len": 19
 },
 {
  "id": "sce158:001B2",
  "jp": "ベイオ「なにっ！　この色ボケねーちゃんがか⁉」",
  "off": 434,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 436,
  "text_len": 27
 },
 {
  "id": "sce158:001D3",
  "jp": "セレア「まぁお兄さまったら、{nl}　それはあんまりじゃありません？」",
  "off": 467,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 469,
  "text_len": 34
 },
 {
  "id": "sce158:001FB",
  "jp": "ベイオ「ふん！　人間なにか特技はあるもんじゃが‥‥{nl}　お前にハッキングの腕がのぅ‥‥」",
  "off": 507,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 509,
  "text_len": 54
 },
 {
  "id": "sce158:00237",
  "jp": "バイオ「自分のプロテクトの質は疑わないんだね」",
  "off": 567,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 569,
  "text_len": 27
 },
 {
  "id": "sce158:00258",
  "jp": "ベイオ「ふん！　当然だ。あれは最高ランクの{nl}　セキュリティシステム。あれを突破できるものは{nl}　昔のムルクと聖地のユミール、{nl}　あとはアガルティアのセリカぐらいだ。{nl}　それより、いまさらアレを持ち出しても誰も買わん。{page}　世論を敵に回してまで軍事力だけを{nl}　追求する国はないぞ」",
  "off": 600,
  "len": 165,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 602,
  "text_len": 162
 },
 {
  "id": "sce158:00300",
  "jp": "バイオ「それがあるんだよ。すぐ近くに。{nl}　ふふふ‥‥わからないかい？　ここ、だよ」",
  "off": 768,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 770,
  "text_len": 45
 },
 {
  "id": "sce158:00333",
  "jp": "ベイオ「床なんか指してどうした‥‥{nl}　‼　ま、まさか‥‥」",
  "off": 819,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 821,
  "text_len": 36
 },
 {
  "id": "sce158:0035D",
  "jp": "バイオ「そう。我等がジグリムさ。{nl}　正確にはホーレム大統領だけどね」",
  "off": 861,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 863,
  "text_len": 42
 },
 {
  "id": "sce158:0038D",
  "jp": "ベイオ「ばかな！　ホーレム大統領は“コード3”を{nl}　消滅させた国民労働党の推薦で当選したのだぞ。{nl}　それに彼の父も‥‥」",
  "off": 909,
  "len": 86,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 911,
  "text_len": 83
 },
 {
  "id": "sce158:003E6",
  "jp": "バイオ「まっ、周りの状況がそうだからといって{nl}　その本人もそうだとはかぎらないよ。{nl}　どうやら彼もグロウスター大将とちがった意味で{nl}　歴史に名を残したいようだね」",
  "off": 998,
  "len": 99,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1000,
  "text_len": 96
 },
 {
  "id": "sce158:0044C",
  "jp": "ベイオ「ダメだダメ！{nl}　だいたいワシはあの計画に反対だったのだ。{nl}　それにマテリアルもない‥‥‼　まさか‥‥」",
  "off": 1100,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1102,
  "text_len": 65
 },
 {
  "id": "sce158:00493",
  "jp": "バイオ「やっと気づいてもらえたようだね。{nl}　そう、あのメリッサという異世界の住人を使うのさ」",
  "off": 1171,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1173,
  "text_len": 53
 },
 {
  "id": "sce158:004CE",
  "jp": "ベイオ「ば！　馬鹿なことを言うなっ！」",
  "off": 1230,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1232,
  "text_len": 24
 },
 {
  "id": "sce158:004EC",
  "jp": "バイオ「じゃ、あの娘を手放してもいいのかい？{nl}　このままじゃ‥‥いや、もうすでに記憶が{nl}　戻っているのかもしれない。{nl}　そうなればここにいるとは思えないね。{nl}　きっと仲間達のもとへ戻るだろう。{nl}　兄さんの手がとどかないところへ、永遠にね」",
  "off": 1260,
  "len": 140,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1262,
  "text_len": 137
 },
 {
  "id": "sce158:0057B",
  "jp": "ベイオ「‥‥」",
  "off": 1403,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1405,
  "text_len": 9
 },
 {
  "id": "sce158:0058A",
  "jp": "バイオ「ねえ、兄さん。{nl}　彼女も本当は兄さんと一緒にいたいはずだよ。{nl}　あの研究ならそれがかなう。永遠に兄さんと一緒。{nl}　そして彼女は肉体という呪縛から解き放たれ、{nl}　永遠に自由な存在となれるんだ。{nl}　それは兄さんだけにしかできないことなんだよ‥‥」",
  "off": 1418,
  "len": 160,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1420,
  "text_len": 157
 },
 {
  "id": "sce158:0062D",
  "jp": "ベイオ「し、しかし‥‥」",
  "off": 1581,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1583,
  "text_len": 14
 },
 {
  "id": "sce158:00641",
  "jp": "バイオ「女性にとっての幸せは{nl}　最も愛してくれる人の元で暮らすことだよ。{nl}　あの娘を兄さん以上に愛している人はいるかい？」",
  "off": 1601,
  "len": 79,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1603,
  "text_len": 76
 },
 {
  "id": "sce158:00693",
  "jp": "ベイオ「そんな奴はおらん！　ワシが一番‥‥あっ」",
  "off": 1683,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1685,
  "text_len": 30
 },
 {
  "id": "sce158:006B7",
  "jp": "バイオ「今さら恥ずかしがることないよ。{nl}　‥‥だったら迷う必要はないじゃないか。{nl}　彼女を幸せにできるのは兄さんだけなんだから‥‥」",
  "off": 1719,
  "len": 82,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1721,
  "text_len": 79
 },
 {
  "id": "sce158:00722",
  "jp": "ベイオ「だめだ‥‥メリッサを手放すことなど考えられん‥‥{nl}　手放すぐらいなら‥‥そんなことになるぐらいなら‥‥」",
  "off": 1826,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1828,
  "text_len": 69
 },
 {
  "id": "sce158:00791",
  "jp": "ミヤスコ「大統領からの通信です」",
  "off": 1937,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1939,
  "text_len": 21
 },
 {
  "id": "sce158:007AC",
  "jp": "セリカ「つないで」",
  "off": 1964,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1966,
  "text_len": 9
 },
 {
  "id": "sce158:007BB",
  "jp": "ホーレム「‥‥さすがというべきでしょうね。{nl}　失礼ながら正直ここまでとは思いませんでした」",
  "off": 1979,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1981,
  "text_len": 53
 },
 {
  "id": "sce158:007F6",
  "jp": "セリカ「‥‥約束は守ってもらえるのでしょうね？」",
  "off": 2038,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2040,
  "text_len": 30
 },
 {
  "id": "sce158:0081A",
  "jp": "ホーレム「はい。ですが、一つ条件があります」",
  "off": 2074,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2076,
  "text_len": 26
 },
 {
  "id": "sce158:0083A",
  "jp": "アーサー「やはりそうきましたか」",
  "off": 2106,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2108,
  "text_len": 18
 },
 {
  "id": "sce158:00852",
  "jp": "ホーレム「そちらにマキ・テオラ・トレスさんが{nl}　同乗しておられるはずです。{nl}　彼女の所持している03Kー01の記録結晶と{nl}　リーボーフェンが記録した今回のデータをこちらに{nl}　渡してほしいのです。そのかわりと言ってはなんですが、{nl}　ちょっとした情報を提供させてもらいますよ」",
  "off": 2130,
  "len": 164,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2132,
  "text_len": 161
 },
 {
  "id": "sce158:008F9",
  "jp": "セリカ「ずいぶん都合のいい提案ね」",
  "off": 2297,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2299,
  "text_len": 21
 },
 {
  "id": "sce158:00914",
  "jp": "ホーレム「こちらも約束は守りたいので‥‥」",
  "off": 2324,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2326,
  "text_len": 27
 },
 {
  "id": "sce158:00935",
  "jp": "マキ「そんな馬鹿げた条件、呑めるワケないでしょ⁈{nl}　いったいなんのために協力したかわからなくなるわ！{nl}　それより早く返さないとこのことを公表するわよ⁉」",
  "off": 2357,
  "len": 93,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2359,
  "text_len": 90
 },
 {
  "id": "sce158:00995",
  "jp": "ホーレム「言っていることが矛盾していますよ。{nl}　あなたはデータを引き渡すつもりはないのでしょ？{nl}　ならばたとえユミールさんを返したところで、{nl}　公表するということ。どのみち公表されるのであれば{nl}　返すワケにはいきませんね」",
  "off": 2453,
  "len": 129,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2455,
  "text_len": 126
 },
 {
  "id": "sce158:00A19",
  "jp": "アーサー「完全に主導権は向こうに握られてますね」",
  "off": 2585,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2587,
  "text_len": 33
 },
 {
  "id": "sce158:00A40",
  "jp": "シィウチェン「‥‥条件を呑むしかないな」",
  "off": 2624,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2626,
  "text_len": 25
 },
 {
  "id": "sce158:00A5F",
  "jp": "トウヤ「ちっ‥‥向こうの言いなりかよ」",
  "off": 2655,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2657,
  "text_len": 23
 },
 {
  "id": "sce158:00A7C",
  "jp": "セリカ「‥‥わかりました。そちらの条件を呑むわ。{nl}　だけど、ユミールの解放が先よ」",
  "off": 2684,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2686,
  "text_len": 50
 },
 {
  "id": "sce158:00AB4",
  "jp": "ホーレム「それは勿論です。{nl}　では使いの者を向かわせますよ‥‥」",
  "off": 2740,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2742,
  "text_len": 40
 },
 {
  "id": "sce158:00B01",
  "jp": "セリカ「‥‥さて」",
  "off": 2817,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2819,
  "text_len": 11
 },
 {
  "id": "sce158:00B12",
  "jp": "マキ「うっ‥‥わ、私、ちょっと用事を思い出した‥‥{nl}　そ、それじゃ！」",
  "off": 2834,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2836,
  "text_len": 45
 },
 {
  "id": "sce158:00B53",
  "jp": "セリカ「デロック！」",
  "off": 2899,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2901,
  "text_len": 11
 },
 {
  "id": "sce158:00B64",
  "jp": "デロック「りょーかい、なんだな」",
  "off": 2916,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2918,
  "text_len": 17
 },
 {
  "id": "sce158:00B7B",
  "jp": "ヤマト「ニャ、ニャんニャの⁈　あの動き⁉」",
  "off": 2939,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2941,
  "text_len": 24
 },
 {
  "id": "sce158:00B99",
  "jp": "マキ「え⁈　嘘‥‥またぁ⁉」",
  "off": 2969,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2971,
  "text_len": 19
 },
 {
  "id": "sce158:00BB2",
  "jp": "レイスケ「ピポポ‥‥」",
  "off": 2994,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2996,
  "text_len": 13
 },
 {
  "id": "sce158:00BC5",
  "jp": "トウヤ「‥‥奴の身体にはガスでも詰まってるのか？」",
  "off": 3013,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3015,
  "text_len": 32
 },
 {
  "id": "sce158:00BEB",
  "jp": "シィウチェン「故郷の老師でもあのような{nl}　変幻自在の動きはできん。{nl}　恐るべき体術の使い手がいたものだ‥‥」",
