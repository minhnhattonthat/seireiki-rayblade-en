  "status": "todo",
  "style": 0,
  "text_off": 10004,
  "text_len": 112
 },
 {
  "id": "sce158:02794",
  "jp": "セリカ「そうね。ミヤスコ‥‥は医務室か。{nl}　シスク、通信のほう頼める？」",
  "off": 10132,
  "len": 48,
  "en": "",
