  "text_len": 8
 },
 {
  "id": "sce399:007D9",
  "jp": "アーサー「あ、いえ、忘れてください。{nl}　そうそう、私の家族でしたよね。{nl}　でも‥‥あまり楽しい話ではありませんよ？」",
  "off": 2009,
