  "status": "todo",
  "style": 0,
  "text_off": 2011,
  "text_len": 69
 },
 {
  "id": "sce399:00824",
  "jp": "トウヤ「なにか気になる‥‥いや、嫌なことが{nl}　あるんじゃねぇのか？{nl}　あの時、そういう風に見えたからな」",
  "off": 2084,
