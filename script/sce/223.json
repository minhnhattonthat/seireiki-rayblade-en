  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5799,
  "text_len": 44
 },
 {
  "id": "sce223:016D7",
  "jp": "フェイン「も、もったいないお言葉！」",
  "off": 5847,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5849,
  "text_len": 21
 },
 {
  "id": "sce223:016F2",
  "jp": "セリカ「だから、あなたは自由にしていて。{nl}　必要な時はちゃんと呼ぶから」",
