  "status": "todo",
  "style": 0,
  "text_off": 6158,
  "text_len": 10
 },
 {
  "id": "sce223:0182F",
  "jp": "セリカ「ふぅ～　一件落着。{nl}　ありがと、ヤマトちゃん。あっ、トウヤもね」",
