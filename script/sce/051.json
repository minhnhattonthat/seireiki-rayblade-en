[
 {
  "id": "sce051:0016C",
  "jp": "アイ「トウヤ！　もぅ、遅い！」",
  "off": 364,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 368,
  "text_len": 18
 },
 {
  "id": "sce051:00183",
  "jp": "トウヤ「向こうにシュテイニーズが現れた」",
  "off": 387,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 391,
  "text_len": 23
 },
 {
  "id": "sce051:0019F",
  "jp": "アイ「え⁈　シュテイニーズって、あのキレたやつ⁉」",
  "off": 415,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 419,
  "text_len": 28
 },
 {
  "id": "sce051:001C0",
  "jp": "トウヤ「ああ。向こうはフェイン達が迎撃している。{nl}　こっちを早く片付けて‥‥」",
  "off": 448,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 452,
  "text_len": 48
 },
 {
  "id": "sce051:001F5",
  "jp": "カイン「早く、片付けて、ねぇ‥‥{nl}　僕も嘗められたものだね」",
  "off": 501,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 505,
  "text_len": 37
 },
 {
  "id": "sce051:00228",
  "jp": "トウヤ「へっ！　裏でコソコソしてるような奴に{nl}　敬意を払うほど人間ができてねぇからな！」",
  "off": 552,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 556,
  "text_len": 53
 },
 {
  "id": "sce051:00262",
  "jp": "カイン「ティックスのことかい？」",
  "off": 610,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 614,
  "text_len": 17
 },
 {
  "id": "sce051:00282",
  "jp": "トウヤ「あとはオズ<E1>ァルドの野郎だよ！{nl}　お前があいつを利揖したんだってな」",
  "off": 642,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 646,
  "text_len": 44
 },
 {
  "id": "sce051:002B3",
  "jp": "カイン「オズ<E1>ァルド？　ああ、生きていたのか‥‥{nl}　たしかに彼を利揖したのは僕さ。{nl}　ベルンストへの義理を果たすためにね」",
  "off": 691,
  "len": 77,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 695,
  "text_len": 72
 },
 {
  "id": "sce051:00300",
  "jp": "トウヤ「ベルンストだと⁉」",
  "off": 768,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 772,
  "text_len": 14
 },
 {
  "id": "sce051:00313",
  "jp": "カイン「おや？　知り合いだったのかい？{nl}　なら彼が＜ゼ＝オード＞の一員だってことも{nl}　知っているのかな？　まぁ、どうでもいいけど。{nl}　とにかく彼らの目的のために女王のもつ結晶を{nl}　手に入れようとしたんだけどね。{nl}　あの男が失敗したというわけさ」",
  "off": 787,
  "len": 152,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 791,
  "text_len": 147
 },
 {
  "id": "sce051:003AB",
  "jp": "アイ「あんたが‥‥アルフォリナを‥‥{nl}　ふふふふ‥‥」",
  "off": 939,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 943,
  "text_len": 33
 },
 {
  "id": "sce051:003D1",
  "jp": "トウヤ「ア、アイ⁈」",
  "off": 977,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 981,
  "text_len": 11
 },
 {
  "id": "sce051:003E1",
  "jp": "アイ「あんた何様のつもり？　なに余裕かましてるのか{nl}　しんないけど、あんたがやってることって自分の手を{nl}　汚さないで金と地位に執着する政治家以下よね。{nl}　彼らはたとえ嘘でも建前をかかげるけど、{nl}　あんたはそれすらない。ただ、自分のやりたいことをやる{nl}　ガキじゃない！」",
  "off": 993,
  "len": 165,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 997,
  "text_len": 160
 },
 {
  "id": "sce051:00486",
  "jp": "カイン「ああ‥‥そういえば君はアルフォリナと{nl}　仲がよかったんだよね。わかるよ、その憤り。{nl}　僕も同じ様な想いを味わったことがあるからね。{nl}　ふふふふ、いいよ。僕を恨めばいい。{nl}　それで君の心が晴れるならね。{nl}　僕だってそのために動いているんだから‥‥」",
  "off": 1158,
  "len": 151,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1162,
  "text_len": 146
 },
 {
  "id": "sce051:0051D",
  "jp": "アイ「ええ。あんたを許さないわ。でも復讐#54Fなんかじゃない。{nl}　もう二度とあたしのような人間を増やさないためよ」",
  "off": 1309,
  "len": 67,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1313,
  "text_len": 62
 },
 {
  "id": "sce051:00560",
  "jp": "カイン「ふん‥‥どう言いつくろったって結局は同じことさ。{nl}　人間はそんな簡単に割り切れるように{nl}　賢くはできていないんだよ。{nl}　さてと、僕もあまり暇ではないのでね。{nl}　今回は僕も本気を出させてもらうよ‥‥」",
  "off": 1376,
  "len": 131,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1380,
  "text_len": 126
 },
 {
  "id": "sce051:005E6",
  "jp": "トウヤ「お前がなにを企んでるのかしらねぇが、{nl}　これ以上、野放しにできねぇ！{nl}　ここで決着をつけてやるぜ！」",
  "off": 1510,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1514,
  "text_len": 64
 },
 {
  "id": "sce051:0062B",
  "jp": "カイン「僕は君達と違って忙しい身でね。{nl}　あまりかまっているヒマはないんだ。{nl}　だから‥‥本気でいくよ！」",
  "off": 1579,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1583,
  "text_len": 64
 },
 {
  "id": "sce051:00683",
  "jp": "アイ「トウヤ。あたしは好きにさせてもらうわ」",
  "off": 1667,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1671,
  "text_len": 23
 },
 {
  "id": "sce051:006B9",
  "jp": "アーサー「すみません、今回は勝手に行動させて{nl}　もらいます」",
  "off": 1721,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1725,
  "text_len": 38
 },
 {
  "id": "sce051:006FE",
  "jp": "クロビス「俺は単独行動をする。そっちは任せたぞ」",
  "off": 1790,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1794,
  "text_len": 30
 },
 {
  "id": "sce051:0073B",
  "jp": "オーレリィ「悪いけど、まだあたしの命を預けれないんだ。{nl}　勝手にさせてもらうよ」",
  "off": 1851,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1855,
  "text_len": 46
 },
 {
  "id": "sce051:00788",
  "jp": "シィウチェン「‥‥指示に従うつもりはない。{nl}　こちらは勝手にさせてもらう」",
  "off": 1928,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1932,
  "text_len": 44
 },
 {
  "id": "sce051:007D1",
  "jp": "セリカ「悪いけど今回は指示に従えないわ」",
  "off": 2001,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2005,
  "text_len": 26
 },
 {
  "id": "sce051:0080A",
  "jp": "フェイン「お前の中にはまだ熱き正義の魂が{nl}　宿っていない！　そんな者の命令に従うことはできん！{nl}　ということで、俺は俺の正義を貫く！　以上！」",
  "off": 2058,
  "len": 98,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2062,
  "text_len": 93
 },
 {
  "id": "sce051:00884",
  "jp": "ゲン「オイラがどれだけ成長したかみせてあげるよ！{nl}　だから勝手に行動させてもらうから。じゃ！」",
  "off": 2180,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2184,
  "text_len": 55
 },
 {
  "id": "sce051:008D8",
  "jp": "メル<E1>ィ「お兄ちゃん、ちょっとメル<E1>ィに考えがあるの。{nl}　だから勝手に動くね」",
  "off": 2264,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2268,
  "text_len": 44
 },
 {
  "id": "sce051:00923",
  "jp": "メリッサ「今回はちょっと、単独行動をさせてもらうわ」",
  "off": 2339,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2343,
  "text_len": 32
 },
 {
  "id": "sce051:00962",
  "jp": "クルル「あたし、好きに戦うね」",
  "off": 2402,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2406,
  "text_len": 17
 },
 {
  "id": "sce051:00992",
  "jp": "レオーネ「ボク、トウヤの指示にうまく従えるか{nl}　自信ないんだ。だから、今回は自由にさせてもらうね」",
  "off": 2450,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2454,
  "text_len": 59
 },
 {
  "id": "sce051:00A66",
  "jp": "カイン「ふっ‥‥まぁ仕込みは終わったし、今日のところは{nl}　君達の勇気ある行動に敬意を表し退くとしよう‥‥{nl}　ああ、そうだ、証拠は梢しとかないとね‥‥」",
  "off": 2662,
  "len": 104,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2666,
  "text_len": 99
 },
 {
  "id": "sce051:00AD7",
  "jp": "トウヤ「ちっ‥‥逃がしたか‥‥」",
  "off": 2775,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2779,
  "text_len": 21
 },
 {
  "id": "sce051:00AF6",
  "jp": "ヤマト「どうするのトウヤ？{nl}　このままじゃオズ<E1>ァルドが‥‥」",
  "off": 2806,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 2811,
  "text_len": 34
 },
 {
  "id": "sce051:00B1E",
  "jp": "トウヤ「とにかく戻るしかねぇ‥‥{nl}　俺達のせいであの子を殺すことなんかさせねぇ！」",
  "off": 2846,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2850,
  "text_len": 49
 },
 {
  "id": "sce051:00B54",
  "jp": "ヤマト「ニャにか策があるの⁉」",
  "off": 2900,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 2905,
  "text_len": 17
 },
 {
  "id": "sce051:00B6B",
  "jp": "トウヤ「‥‥ない」",
  "off": 2923,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2927,
  "text_len": 11
 },
 {
  "id": "sce051:00B7B",
