  "status": "todo",
  "style": 2,
  "text_off": 5651,
  "text_len": 8
 },
 {
  "id": "sce207:0161C",
  "jp": "ヤマト「ちょっと！　そんニャ悠長にしてる場合じゃ{nl}　ニャいでしょ⁉」",
  "off": 5660,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 5665,
  "text_len": 40
 },
 {
  "id": "sce207:0164C",
  "jp": "ライル「‥‥面白い！　相手になってやる！{nl}　あの時の勝負の決着、つけようじゃねぇか！{nl}　ええ、レニスよぉっ‼」",
  "off": 5708,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5712,
  "text_len": 70
 },
