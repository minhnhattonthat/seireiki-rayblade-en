  "off": 5366,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5370,
  "text_len": 24
 },
 {
  "id": "sce207:0158C",
  "jp": "アイ「やった！　すごいよ！　効いてるじゃん！」",
  "off": 5516,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 5521,
  "text_len": 27
 },
 {
  "id": "sce207:015AD",
  "jp": "ヤマト「どうやらトウヤがメイン操者で、{nl}　アイの方が管制系の分担操縦みたいね」",
  "off": 5549,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 5554,
  "text_len": 49
 },
 {
  "id": "sce207:015E4",
  "jp": "アイ「え～　あたし、そっちがいい～」",
  "off": 5604,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 5609,
  "text_len": 20
 },
