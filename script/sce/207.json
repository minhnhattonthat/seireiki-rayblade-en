  "jp": "ライル「やるな‥‥」",
  "off": 4025,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4029,
  "text_len": 12
 },
 {
  "id": "sce207:00FF2",
