  "off": 5117,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5121,
  "text_len": 14
 },
 {
  "id": "sce207:01427",
  "jp": "ガリュード「もってくれよ‥‥」",
  "off": 5159,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5163,
  "text_len": 18
 },
 {
  "id": "sce207:0149A",
  "jp": "ライル「‥‥装兵機でここまでやる奴がいたとはな‥‥{nl}　だが、ここまでだっ！」",
  "off": 5274,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5278,
  "text_len": 47
 },
