  "id": "sce207:00F73",
  "jp": "ライル「‥‥後悔するぜ」",
  "off": 3955,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3959,
  "text_len": 16
 },
 {
  "id": "sce207:00F88",
  "jp": "ガリュード「知らぬな、そのような言葉」",
  "off": 3976,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3980,
  "text_len": 23
 },
