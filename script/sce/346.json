  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3624,
  "text_len": 52
 },
 {
  "id": "sce346:00E60",
  "jp": "ティックス「‥‥そうですよね。{nl}　‥‥みんな‥‥頑張って‥‥」",
  "off": 3680,
