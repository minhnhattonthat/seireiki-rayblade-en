  "status": "todo",
  "style": 0,
  "text_off": 4141,
  "text_len": 23
 },
 {
  "id": "sce346:01048",
  "jp": "レイフォン「ああ‥‥たぶん、その船の主砲をつかっても{nl}　<E1>ォーリアのフィールドは貫けないだろうね」",
  "off": 4168,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4170,
  "text_len": 57
 },
 {
  "id": "sce346:01087",
  "jp": "アーサー「ということは‥‥打つ手なしということですか？」",
