  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3570,
  "text_len": 48
 },
 {
  "id": "sce346:00E26",
  "jp": "ローディス「ああ。だが、その中にも希望の光を{nl}　見出すことはできる。それが、彼らなのだ」",
