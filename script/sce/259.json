  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5005,
  "text_len": 48
 },
 {
  "id": "sce259:013C1",
  "jp": "メル<E1>ィ「で、でもぉ‥‥」",
  "off": 5057,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5059,
  "text_len": 15
 },
 {
  "id": "sce259:013D6",
  "jp": "ゲン「大丈夫。みんなが黙ってればわかんないって。{nl}　ホラ、メル<E1>ィも行くぞ」",
  "off": 5078,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5080,
  "text_len": 43
 },
 {
  "id": "sce259:01407",
  "jp": "メル<E1>ィ「あっ、ゲ、ゲンちゃん‥‥」",
  "off": 5127,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5129,
  "text_len": 20
 },
 {
  "id": "sce259:01421",
  "jp": "ゲン「んじゃ、このことはここにいるみんなの秘密{nl}　ということで」",
  "off": 5153,
