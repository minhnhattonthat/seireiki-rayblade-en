  "status": "todo",
  "style": 0,
  "text_off": 4974,
  "text_len": 14
 },
 {
  "id": "sce259:0138B",
  "jp": "ゲン「決定！　そうと決まれば、早く出ようよ！{nl}　メル<E1>ィも黙っとけばいいからな」",
