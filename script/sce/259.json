  "status": "todo",
  "style": 0,
  "text_off": 5243,
  "text_len": 13
 },
 {
  "id": "sce259:01565",
  "jp": "ヤマト「あれ？　エレベーターが動いてる。めずらしいわね。{nl}　誰か乗ってるのかしら？」",
