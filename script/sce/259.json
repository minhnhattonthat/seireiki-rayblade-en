  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5534,
  "text_len": 14
 },
 {
  "id": "sce259:015B0",
  "jp": "ヤマト「でも、あたしが見るときはいつも止まってるよ。{nl}　しかもちょうどその階に」",
