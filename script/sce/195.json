  "off": 3546,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3548,
  "text_len": 39
 },
 {
  "id": "sce195:00E07",
  "jp": "デロック「単に怖れをなしただけなんだな、きっと。{nl}　まぁ、いざとなったら君達が出ていって{nl}　蹴散らせばいいんだな。{nl}　馬車馬のごとく戦いつづけてればいいんだな」",
  "off": 3591,
  "len": 94,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3593,
  "text_len": 91
 },
 {
  "id": "sce195:00E68",
  "jp": "クロビス「誰かそのでかいのを黙らせろ。なんかむかつく」",
  "off": 3688,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3690,
  "text_len": 29
 },
 {
  "id": "sce195:00E8B",
  "jp": "デロック「失礼なヤツなんだな‥‥{nl}　そんな奴は‥‥」",
  "off": 3723,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3725,
  "text_len": 33
 },
 {
  "id": "sce195:00EB2",
  "jp": "トウヤ「‥‥なに薯き込んでんだ？」",
  "off": 3762,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3764,
  "text_len": 22
 },
 {
  "id": "sce195:00ECE",
  "jp": "デロック「み、見ちゃダメなんだな。{nl}　僕の“復讐#54Fリスト”は誰にもみせないんだな‥‥」",
  "off": 3790,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3792,
  "text_len": 51
 },
 {
  "id": "sce195:00F07",
  "jp": "トウヤ「ふ、復讐#54Fリストぉ？」",
  "off": 3847,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3849,
  "text_len": 17
 },
 {
  "id": "sce195:00F1E",
  "jp": "ミヤスコ「あぁ、気にしないで。{nl}　いつものことだから」",
  "off": 3870,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3872,
  "text_len": 28
 },
 {
  "id": "sce195:00F40",
  "jp": "トウヤ「い、いつもって‥‥」",
  "off": 3904,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3906,
  "text_len": 16
 },
 {
  "id": "sce195:00F67",
  "jp": "アイ「なに和んでんの⁈{nl}　なんでそんなに普通でいられんの⁉」",
  "off": 3943,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3945,
  "text_len": 35
 },
 {
  "id": "sce195:00F90",
  "jp": "ユミール「アイ‥‥」",
  "off": 3984,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3986,
  "text_len": 13
 },
 {
  "id": "sce195:00FAB",
  "jp": "アイ「‥‥おかしいよ‥‥あの子のことも他のみんなのことも{nl}　心配じゃないの？{nl}　なんで助けに行こうって誰も言わないの？」",
  "off": 4011,
  "len": 77,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4013,
  "text_len": 74
 },
 {
  "id": "sce195:00FFB",
  "jp": "アーサー「残念ですが城#946はもう‥‥」",
  "off": 4091,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4093,
  "text_len": 24
 },
 {
  "id": "sce195:01024",
  "jp": "アイ「そんなことわかってる！　でも、もしかしたら‥‥」",
  "off": 4132,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4134,
  "text_len": 30
 },
 {
  "id": "sce195:01048",
  "jp": "アーサー「たしかにジグリム軍はまだ完全に掌握しきれて{nl}　いないでしょう。{nl}　かなりの大部隊がまだ駐留していましたし」",
  "off": 4168,
  "len": 73,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4170,
  "text_len": 70
 },
 {
  "id": "sce195:0109F",
  "jp": "アイ「だったら！」",
  "off": 4255,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4257,
  "text_len": 10
 },
 {
  "id": "sce195:010AF",
  "jp": "アーサー「だからこそダメなのです。冷たいようですが、{nl}　我々の貰的はこのリーボーフェンと聖霊機を守り、{nl}　＜ゼ＝オード＞復括#3A2に備え、対処することです」",
  "off": 4271,
  "len": 99,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4273,
  "text_len": 96
 },
 {
  "id": "sce195:0111D",
  "jp": "アイ「どうしてそんな冷静でいられるの⁉{nl}　みんな世話になったでしょ⁈{nl}　このままハイさよならなんてこと‥‥{nl}　なんで、できるのっ⁈」",
  "off": 4381,
  "len": 78,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4383,
  "text_len": 75
 },
 {
  "id": "sce195:0116E",
  "jp": "ユミール「誰もそんなこと‥‥」",
  "off": 4462,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4464,
  "text_len": 19
 },
 {
  "id": "sce195:0118F",
  "jp": "アイ「もういい！　あたしひとりでも‥‥」",
  "off": 4495,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4497,
  "text_len": 23
 },
 {
  "id": "sce195:011BE",
  "jp": "クロビス「いいかげんにしろっ！{nl}　お前だけが辛いと思っているのかっ⁉{nl}　俺達も女王やみんなに世話になったんだ！{nl}　‥‥好き好んで、退却なんかしたくねぇよ‥‥」",
  "off": 4542,
  "len": 102,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4544,
  "text_len": 99
 },
 {
  "id": "sce195:01239",
  "jp": "アイ「‥‥」",
  "off": 4665,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4667,
  "text_len": 8
 },
 {
  "id": "sce195:01247",
  "jp": "クロビス「‥‥さっきの状態をみたろ？{nl}　あれじゃたとえ生きていたとしてもすでに捕#791虜だ。{page}　下手に救出にむかったら、女王を盾に{nl}　全面降伏ってこともありうる。{nl}　そんなことあの子が望んでいると思っているのか？」",
  "off": 4679,
  "len": 130,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4681,
  "text_len": 127
 },
 {
  "id": "sce195:012CC",
  "jp": "アイ「それは‥‥」",
  "off": 4812,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4814,
  "text_len": 11
 },
 {
  "id": "sce195:012DD",
  "jp": "ユミール「辛い気持ちはわかるわ。{nl}　でも、今はどうしようもないの‥‥わかって」",
  "off": 4829,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4831,
  "text_len": 46
 },
 {
  "id": "sce195:01319",
  "jp": "アイ「だって‥‥約束したんだもん‥‥{nl}　今度一緒にクッキー作ろうって‥‥{nl}　あの子‥‥14才の、普通の女の子だったんだよ‥‥」",
  "off": 4889,
  "len": 90,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4891,
  "text_len": 87
 },
 {
  "id": "sce195:01376",
  "jp": "ユミール「アイ‥‥」",
  "off": 4982,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4984,
  "text_len": 13
 },
 {
  "id": "sce195:0138D",
  "jp": "アイ「‥‥！」",
  "off": 5005,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5007,
  "text_len": 10
 },
 {
  "id": "sce195:0139F",
  "jp": "トウヤ「お、おい！」",
  "off": 5023,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5025,
  "text_len": 11
 },
 {
  "id": "sce195:013C1",
  "jp": "セリカ「今はそっとしておいてあげましょう。{nl}　頭ではわかっているけど心がまだ受け入れられないのよ」",
  "off": 5057,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5059,
  "text_len": 54
 },
 {
  "id": "sce195:013FD",
  "jp": "トウヤ「お前は大丈夫なのか？」",
  "off": 5117,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5119,
  "text_len": 20
 },
 {
  "id": "sce195:01417",
  "jp": "セリカ「‥‥大丈夫よ。{nl}{ctl:3C3E}{ctl:043C}VI{ctl:023E}{ctl:043C}VJ{ctl:033E}{ctl:043C}YN　大丈夫でいなきゃ‥‥」",
  "off": 5143,
  "len": 61,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5145,
  "text_len": 58
 },
 {
  "id": "sce195:01457",
  "jp": "ユミール「とにかく、今は私達だけで動いても仕方ないわ。{nl}　一度聖地へ徇かいましょう」",
  "off": 5207,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5209,
  "text_len": 54
 },
 {
  "id": "sce195:01493",
  "jp": "アーサー「‥‥そうですね。{nl}　あそこにはシィウチェンさんやオーレリィもいますし、{nl}　今後のことも考えないといけませんしね」",
  "off": 5267,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5269,
  "text_len": 69
 },
 {
  "id": "sce195:014DE",
  "jp": "フェイン「このまま聖地へ徇かっても大丈夫なのか？{nl}　いくらユミールさんやセリカ様が乗っているとはいえ{nl}　やはり領空侵犯となるのではないか？」",
  "off": 5342,
  "len": 88,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5344,
  "text_len": 85
 },
 {
  "id": "sce195:01545",
  "jp": "クロビス「そういやぁ、聖地ってアガルティア王麹の中に{nl}　あって間借りしているみたいなもんだからな‥‥{nl}　なんくせつけられて、最悪の場合は聖霊機を{nl}　奪われる可能性もあるかもな」",
  "off": 5445,
  "len": 111,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5447,
  "text_len": 108
 },
 {
  "id": "sce195:015B7",
  "jp": "セリカ「‥‥そのへんは大丈夫。{nl}　この船には“光学遮蔽システム”が{nl}　搭載されてるから」",
  "off": 5559,
  "len": 61,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5561,
  "text_len": 58
 },
 {
  "id": "sce195:015F7",
  "jp": "クロビス「光学遮蔽って‥‥{nl}　あのステルスみたいなやつだよな」",
  "off": 5623,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5625,
  "text_len": 37
 },
 {
  "id": "sce195:01622",
  "jp": "アーサー「いえ、もっと凄いものですよ。{nl}　高いステルス性に加え、人の貰が受け取る{nl}　光の屈折率を変えることもできるはずですが‥‥」",
  "off": 5666,
  "len": 85,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5668,
  "text_len": 82
 },
 {
  "id": "sce195:0167A",
  "jp": "トウヤ「つまり、どういうことだ？」",
  "off": 5754,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5756,
  "text_len": 18
 },
 {
  "id": "sce195:01692",
  "jp": "セリカ「人間の貰にもみえないし、レーダーにも{nl}　反応しないってこと」",
  "off": 5778,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5780,
  "text_len": 41
 },
 {
  "id": "sce195:016C1",
  "jp": "トウヤ「なんて都合のいいもん積んでやがるんだ‥‥」",
  "off": 5825,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5827,
  "text_len": 30
 },
 {
  "id": "sce195:0170F",
  "jp": "ユミール「それじゃ行きましょう。{nl}　バレン、お願いします」",
  "off": 5903,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5905,
  "text_len": 32
 },
 {
  "id": "sce195:01735",
  "jp": "バレン「‥‥了解。進路を聖地へ設定します」",
  "off": 5941,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5943,
  "text_len": 31
 },
 {
  "id": "sce195:01788",
  "jp": "ミヤスコ「‥‥？　あっ！」",
  "off": 6024,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6026,
  "text_len": 17
 },
 {
  "id": "sce195:0179F",
  "jp": "セリカ「どうしたの？」",
  "off": 6047,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6049,
  "text_len": 12
 },
 {
  "id": "sce195:017B1",
  "jp": "ミヤスコ「せ、戦闘です。装兵機伺止の戦闘です！」",
  "off": 6065,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6067,
  "text_len": 34
 },
 {
  "id": "sce195:017D9",
  "jp": "クロビス「‥‥もう肉眼でも見えるじゃねぇか。{nl}　いったいなにやってんだ？」",
  "off": 6105,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6107,
  "text_len": 43
 },
 {
  "id": "sce195:0180A",
  "jp": "ミヤスコ「すみません‥‥」",
  "off": 6154,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6156,
  "text_len": 15
 },
 {
  "id": "sce195:0181F",
  "jp": "デロック「仕方ないんだな。{nl}　彼女は本来通信担当なんだな。{nl}　人手が足りないんだな。{nl}　ぐだぐだ言うならお前がやればいいんだな」",
  "off": 6175,
  "len": 82,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6177,
  "text_len": 79
 },
 {
  "id": "sce195:01874",
  "jp": "クロビス「なっ！　なんだとっ！」",
  "off": 6260,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6262,
  "text_len": 18
 },
 {
  "id": "sce195:0188C",
  "jp": "ユミール「ちょ、ちょっと！　今はそんなことしてる{nl}　場合じゃないでしょ！」",
  "off": 6284,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6286,
  "text_len": 43
 },
 {
  "id": "sce195:018BD",
  "jp": "セリカ「とにかく、データの分析急いで！」",
  "off": 6333,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6335,
  "text_len": 25
 }
]
