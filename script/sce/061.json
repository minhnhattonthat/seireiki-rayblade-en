  "style": 1,
  "text_off": 8597,
  "text_len": 15
 },
 {
  "id": "sce061:021A5",
  "jp": "ヤマト「あれ？　どうして送信モードにしてるの？{nl}　ねぇ。ねぇ、トウ‥‥」",
