[
 {
  "id": "sce234:00080",
  "jp": "セリカ「どうぞ～」",
  "off": 128,
  "len": 13,
  "en": "Celica: Come i~in.",
  "status": "translated",
  "style": 0,
  "text_off": 130,
  "text_len": 10
 },
 {
  "id": "sce234:000BA",
  "jp": "セリカ「あっ、ちょうどよかった。セルフィンに{nl}　搭載されてる“補完的修復システム”なんだけど、{nl}　アレの試作量産型ができたの」",
  "off": 186,
  "len": 80,
  "en": "Celica: Oh, perfect timing. You know the \"complementary repair system\" built into the Selphin? I've finished a prototype mass-production model of it.",
  "status": "translated",
  "style": 0,
  "text_off": 188,
  "text_len": 77
 },
 {
  "id": "sce234:0010D",
  "jp": "ヤマト「え？　それって、修理できる機体が{nl}　増えるってこと？」",
  "off": 269,
  "len": 41,
  "en": "Yamato: Huh? So that means more units can do repairs?",
  "status": "translated",
  "style": 0,
  "text_off": 271,
  "text_len": 38
 },
 {
  "id": "sce234:00139",
  "jp": "セリカ「そっ。あっ、でも、どの機体にも{nl}　搭載できるわけじゃないの。{nl}　アレって、結構場所を取るから」",
  "off": 313,
  "len": 63,
  "en": "Celica: Yup. Oh, but it can't be installed in just any unit. That thing takes up quite a bit of space.",
  "status": "translated",
  "style": 0,
  "text_off": 315,
  "text_len": 60
 },
 {
  "id": "sce234:0017B",
  "jp": "トウヤ「てぇーことは、どの機体に搭載できるんだ？」",
  "off": 379,
  "len": 34,
  "en": "Touya: Then which unit can it go in?",
  "status": "translated",
  "style": 0,
  "text_off": 381,
  "text_len": 31
 },
 {
  "id": "sce234:001A0",
  "jp": "セリカ「フォルスティンよ。{nl}　実はもう、搭載しちゃったんだけとね。{nl}　今から連絡に行こうと思っていたの」",
  "off": 416,
  "len": 63,
  "en": "Celica: The Forstin. Actually, I've already installed it. I was just about to go tell everyone.",
  "status": "translated",
  "style": 0,
  "text_off": 418,
  "text_len": 60
 },
 {
  "id": "sce234:001E2",
  "jp": "トウヤ「そしたら俺が来た‥‥」",
  "off": 482,
  "len": 22,
  "en": "Touya: And then I showed up...",
  "status": "translated",
  "style": 0,
  "text_off": 484,
  "text_len": 19
 },
 {
  "id": "sce234:00201",
  "jp": "セリカ「そっ。これって運命みたいなもの感じない？」",
  "off": 513,
  "len": 32,
  "en": "Celica: Yup. Don't you feel something like fate in this?",
  "status": "translated",
  "style": 0,
  "text_off": 515,
  "text_len": 29
 },
 {
  "id": "sce234:00224",
  "jp": "トウヤ「へ？」",
  "off": 548,
  "len": 11,
  "en": "Touya: Huh?",
  "status": "translated",
  "style": 0,
  "text_off": 550,
  "text_len": 8
 },
 {
  "id": "sce234:00232",
  "jp": "セリカ「う、ううん。なんでもない。{nl}　さて、調整でもしようかな。{nl}　まっ、そういうことだから。それじゃ」",
  "off": 562,
  "len": 57,
  "en": "Celica: N-no, never mind. Well, maybe I'll go do some tuning. Anyway, that's the deal. See ya.",
  "status": "translated",
  "style": 0,
  "text_off": 564,
  "text_len": 54
 },
 {
  "id": "sce234:00270",
  "jp": "トウヤ「‥‥？」",
  "off": 624,
  "len": 14,
  "en": "Touya: ...?",
  "status": "translated",
  "style": 0,
  "text_off": 626,
  "text_len": 11
 },
 {
  "id": "sce234:00281",
  "jp": "ヤマト「ほらほら、ぼーっとしてニャいで。{nl}　いつまでもここにいても仕方ニャいでしょ」",
  "off": 641,
  "len": 48,
  "en": "Yamato: Come on, come on, don't just space out. There's nyo point standing around here forever.",
  "status": "translated",
  "style": 0,
  "text_off": 643,
  "text_len": 45
 },
 {
  "id": "sce234:002B4",
  "jp": "トウヤ「あ、ああ‥‥」",
  "off": 692,
  "len": 16,
  "en": "Touya: Oh, r-right...",
  "status": "translated",
  "style": 0,
  "text_off": 694,
  "text_len": 13
 },
 {
  "id": "sce234:002CD",
  "jp": "セリカ「あれ？　トウヤじゃない、どうしたの？」",
  "off": 717,
  "len": 28,
  "en": "Celica: Huh? Touya? What's up?",
  "status": "translated",
  "style": 0,
  "text_off": 719,
  "text_len": 25
 },
 {
  "id": "sce234:002EC",
  "jp": "トウヤ「いや、別に用はねぇけど‥‥」",
  "off": 748,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 750,
  "text_len": 22
 },
 {
  "id": "sce234:00308",
  "jp": "セリカ「ふぅ～ん‥‥だったらまた今度にしてくれない？{nl}　今、ちょっと忙しいの」",
  "off": 776,
  "len": 50,
  "en": "Celica: Hmmm... Then could you make it another time? I'm a little busy right now.",
  "status": "translated",
  "style": 0,
  "text_off": 778,
  "text_len": 47
 },
 {
  "id": "sce234:0033D",
  "jp": "ヤマト「またニャにか作ってるの？」",
  "off": 829,
  "len": 22,
  "en": "Yamato: Making something again, are nyou?",
  "status": "translated",
  "style": 0,
  "text_off": 831,
  "text_len": 19
 },
 {
  "id": "sce234:00356",
  "jp": "セリカ「ふふふ‥‥ひ・み・つ。まっ、出来るかどうか{nl}　わからないから期待せずに待ってて」",
  "off": 854,
  "len": 54,
  "en": "Celica: Fufufu... It's a se-cr-et. Well, I don't know if it'll work out, so wait without getting your hopes up.",
  "status": "translated",
  "style": 0,
  "text_off": 856,
  "text_len": 51
 },
 {
  "id": "sce234:0038F",
  "jp": "トウヤ「わかった。それじゃ、邪魔したな」",
  "off": 911,
  "len": 25,
  "en": "Touya: Got it. Sorry for bugging you, then.",
  "status": "translated",
  "style": 0,
  "text_off": 913,
  "text_len": 22
 },
 {
  "id": "sce234:003AB",
  "jp": "セリカ「またね」",
  "off": 939,
  "len": 11,
  "en": "Celica: See ya.",
  "status": "translated",
  "style": 0,
  "text_off": 941,
  "text_len": 8
 },
