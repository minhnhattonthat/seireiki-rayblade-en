  "off": 2859,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2861,
  "text_len": 10
 },
 {
  "id": "sce161:00B46",
  "jp": "ロザリー「ううぅっ‥‥、ううぅっ‥‥」",
  "off": 2886,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2888,
  "text_len": 24
 },
 {
  "id": "sce161:00B64",
  "jp": "ゲン「うわ～ん、うわ～ん‥‥」",
  "off": 2916,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2918,
  "text_len": 19
 },
 {
  "id": "sce161:00B7D",
  "jp": "トウヤ「な、なんか芝居くさくねぇか‥‥おまえら？」",
  "off": 2941,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2943,
  "text_len": 30
 },
 {
  "id": "sce161:00BA1",
  "jp": "アイ「ちょっとトウヤ！　どういうことよ⁉{nl}　ちゃんと説明しなさいよねっ‼　やっぱり手を‥‥{nl}　男の下半身は人格ないって言うし‥‥」",
  "off": 2977,
  "len": 85,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2979,
  "text_len": 82
 },
 {
  "id": "sce161:00BF9",
  "jp": "カスミ「ふ‥‥不潔‥‥」",
  "off": 3065,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3067,
  "text_len": 18
 },
