 },
 {
  "id": "sce161:00D28",
  "jp": "ロザリー「‥‥ということで、契約は成立っと。{nl}　えー、一気に返せるワケないから240回の{nl}　分割ということで勘弁してあげるわ。{nl}　で、相場がだいたいこれぐらいだから‥‥{nl}　手数料がこれぐらいで‥‥」",
  "off": 3368,
  "len": 127,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3370,
  "text_len": 124
 },
 {
  "id": "sce161:00DAA",
  "jp": "ユミール「240回って‥‥すごい手数料になるわよ‥‥」",
  "off": 3498,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3500,
  "text_len": 36
 },
 {
  "id": "sce161:00DD4",
  "jp": "ロザリー「にひひひひ‥‥」",
  "off": 3540,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3542,
  "text_len": 16
 },
 {
  "id": "sce161:00DEA",
  "jp": "トウヤ「‥‥」",
  "off": 3562,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3564,
  "text_len": 9
 },
 {
  "id": "sce161:00DF9",
  "jp": "アイ「‥‥どうやらあたしたちの勘違いだったようね。{nl}　借金返済、頑張ってね」",
  "off": 3577,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3579,
  "text_len": 48
 },
 {
  "id": "sce161:00E54",
  "jp": "ロザリー「まいどぉ～」",
  "off": 3668,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3670,
  "text_len": 13
 },
 {
  "id": "sce161:00E67",
  "jp": "トウヤ「‥‥はぁ」",
  "off": 3687,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3689,
  "text_len": 11
 },
 {
  "id": "sce161:00E78",
  "jp": "ユミール「艦長、本当によろしいのですか？」",
  "off": 3704,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3706,
  "text_len": 27
 },
 {
  "id": "sce161:00E99",
  "jp": "ロア艦長「うむ」",
  "off": 3737,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3739,
  "text_len": 10
 },
 {
  "id": "sce161:00EA9",
  "jp": "ユミール「わかりました。ロザリー。今日からあなたには{nl}　厨房#915でみんなの食事の世話をしてもらいます。{nl}　いい？」",
  "off": 3753,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3755,
  "text_len": 66
 },
 {
  "id": "sce161:00EF9",
  "jp": "ロザリー「もちろん！　私だってプロの端くれよ。{nl}　中途半端なものは出さないから安心して」",
  "off": 3833,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3835,
  "text_len": 55
 },
 {
  "id": "sce161:00F36",
  "jp": "カスミ「それじゃ、今日から仲間ね。よろしく」",
  "off": 3894,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3896,
  "text_len": 26
 },
 {
  "id": "sce161:00F56",
  "jp": "ロザリー「よろしく。‥‥こら、ゲン。あんたも‥‥{nl}{ctl:3C3E}{ctl:043C}V％あれ？　あの子いったいどこ行っちゃったのかしら‥‥？」",
  "off": 3926,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3928,
  "text_len": 72
 },
 {
  "id": "sce161:00FCB",
  "jp": "ゲン「すっげぇ‥‥やっぱり聖霊機はカッコいいよなぁ‥‥{nl}　うおっ！　ライブレードだ！　すっげー‼」",
  "off": 4043,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4045,
  "text_len": 61
 },
 {
  "id": "sce161:0100E",
  "jp": "整備止C「おい！　そんなとこにいたら危ねぇぞ！」",
  "off": 4110,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4112,
  "text_len": 30
 },
 {
  "id": "sce161:01032",
  "jp": "ゲン「うわー‥‥でっけぇなぁ‥‥」",
  "off": 4146,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4148,
  "text_len": 22
 },
 {
  "id": "sce161:0104E",
  "jp": "整備止C「ったく‥‥おい！」",
  "off": 4174,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4176,
  "text_len": 20
 },
 {
  "id": "sce161:01068",
  "jp": "整備止F「まぁ、いいじゃない。{nl}　ねぇ坊や。聖霊機好き？」",
  "off": 4200,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4202,
  "text_len": 38
 },
 {
  "id": "sce161:01094",
  "jp": "ゲン「うん！　オイラ、おっきくなったら絶対{nl}　聖霊機操者になるんだ！　そして騎止になる！」",
  "off": 4244,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4246,
  "text_len": 57
 },
 {
  "id": "sce161:010D3",
  "jp": "整備止E「へぇ‥‥なかなかいい目をしてるね。{nl}　あながち夢で終わらないんじゃないか？」",
  "off": 4307,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4309,
  "text_len": 52
 },
 {
  "id": "sce161:0110D",
  "jp": "整備止B「ほぅ、おまえの見立てなら間違いねぇな。{nl}　おい、坊主。騎止になったら俺達が整備をしてやるぜ」",
  "off": 4365,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4367,
  "text_len": 66
 },
 {
  "id": "sce161:01155",
  "jp": "ゲン「ホント⁈　やったー！　約束だからね！」",
  "off": 4437,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4439,
  "text_len": 28
 },
 {
  "id": "sce161:01177",
  "jp": "整備止B「あぁ。約束だ」",
  "off": 4471,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4473,
  "text_len": 17
 },
 {
  "id": "sce161:0118E",
  "jp": "ゲン「よぉーし‥‥あっ‥‥あれ‥‥」",
  "off": 4494,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4496,
  "text_len": 25
 },
 {
  "id": "sce161:011CC",
  "jp": "整備止A「ああ、聖霊機ゼイフォンだ。{nl}　ちょっと前まではトウヤが乗っていたんだがな。{nl}　今では空き家さ。{nl}　良い機体なんだけど、パイロットがいないんじゃな。{nl}　せっかくいつでも使えるようにしているのに‥‥」",
  "off": 4556,
  "len": 123,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4558,
  "text_len": 120
 },
 {
  "id": "sce161:0124A",
  "jp": "ゲン「ふ～ん‥‥じゃいつでも戦えるんだ」",
  "off": 4682,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4684,
  "text_len": 24
 },
 {
  "id": "sce161:01268",
  "jp": "整備止D「無論だ。俺達の整備はつねに完璧だ」",
  "off": 4712,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4714,
  "text_len": 33
 },
 {
  "id": "sce161:0128F",
  "jp": "ゲン「えっと、じゃあ‥‥」",
  "off": 4751,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4753,
  "text_len": 15
 },
 {
  "id": "sce161:012C2",
  "jp": "ロザリー「ゲン！　まったく、勝手にうろついたら{nl}　危ないでしょ⁉　ホラ、いくよ！」",
  "off": 4802,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4804,
  "text_len": 48
 },
 {
  "id": "sce161:012F8",
  "jp": "ゲン「あー、あー！　もうちょっと！」",
  "off": 4856,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4858,
  "text_len": 22
 },
 {
  "id": "sce161:01314",
  "jp": "ロザリー「ダメ！　早速今晩の仕込みをしないと{nl}　ダメなんだから！　さっさと来るっ！」",
  "off": 4884,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4886,
  "text_len": 53
 },
 {
  "id": "sce161:0134F",
  "jp": "ゲン「そ、それじゃお仕事がんばってね～！」",
  "off": 4943,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4945,
  "text_len": 25
 },
 {
  "id": "sce161:0136E",
  "jp": "整備止B「おう！　また遊びにきな坊主！」",
  "off": 4974,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4976,
  "text_len": 28
 },
 {
  "id": "sce161:013B5",
  "jp": "トウヤ「‥‥ローディスが負傷したって本当か⁉」",
  "off": 5045,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5047,
  "text_len": 31
 },
 {
  "id": "sce161:013DA",
  "jp": "ユミール「ええ。ティックス王子をカインから{nl}　守ろうとして‥‥」",
  "off": 5082,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5084,
  "text_len": 38
 },
 {
  "id": "sce161:01406",
  "jp": "トウヤ「カイン？　あいつまたなにか企んでやがるのか⁈」",
  "off": 5126,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5128,
  "text_len": 30
 },
 {
  "id": "sce161:0142A",
  "jp": "ユミール「わからないわ。でもティックス王子を{nl}　連れ去ろうとしたみたい」",
  "off": 5162,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5164,
  "text_len": 41
 },
 {
  "id": "sce161:01459",
  "jp": "ヤマト「それで殿下の容態はどうニャの？」",
  "off": 5209,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5211,
  "text_len": 25
 },
 {
  "id": "sce161:01478",
  "jp": "ユミール「思ったほど讐傷じゃないわ。{nl}　内臓も傷ついてなかったしね。{nl}　あと麹王陛下もご無事よ。{nl}　王都のテロも鎮庄されたし、{nl}　とりあえず一安心ね。{nl}　ただ、陛下を守ってレビオス元帥が亡くなったわ‥‥」",
  "off": 5240,
  "len": 133,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5242,
  "text_len": 130
 },
 {
  "id": "sce161:01500",
  "jp": "トウヤ「そっか‥‥結局は忠義の人だったのかもな」",
  "off": 5376,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5378,
  "text_len": 31
 },
 {
  "id": "sce161:01525",
  "jp": "ユミール「ええ。元帥の愛麹心は本物だったから‥‥」",
  "off": 5413,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5415,
  "text_len": 35
 },
 {
  "id": "sce161:0154E",
  "jp": "トウヤ「とりあえず収まったとはいえ、{nl}　テロリストの奴等は生きてる‥‥安心はできねぇな」",
  "off": 5454,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5456,
  "text_len": 52
 },
 {
  "id": "sce161:01588",
  "jp": "ユミール「ええ。でも今回のことで{nl}　相当な損害をだしているはずよ。{nl}　組織的な活動をするのはしばらく無理ね」",
  "off": 5512,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5514,
  "text_len": 68
 },
 {
  "id": "sce161:015D2",
  "jp": "トウヤ「これで終わってくれればいいが‥‥」",
  "off": 5586,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5588,
  "text_len": 24
 },
 {
  "id": "sce161:01609",
  "jp": "マキ「やっほー！」",
  "off": 5641,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5643,
  "text_len": 11
 },
 {
  "id": "sce161:0161A",
  "jp": "トウヤ「フェインならいねぇぞ」",
  "off": 5658,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5660,
  "text_len": 15
 },
 {
  "id": "sce161:0162F",
  "jp": "マキ「はぁ？　別にフェインちゃんに揖はないわよ。{nl}　それにもう挨拶は済ましてきたし」",
  "off": 5679,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5681,
  "text_len": 48
 },
 {
  "id": "sce161:01665",
  "jp": "ユミール「挨拶？」",
  "off": 5733,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5735,
  "text_len": 13
 },
 {
  "id": "sce161:01678",
  "jp": "マキ「そっ。私、ここでリーボーフェンを降りるわ」",
  "off": 5752,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5754,
  "text_len": 28
 },
 {
  "id": "sce161:0169A",
  "jp": "トウヤ「突然だな」",
  "off": 5786,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5788,
  "text_len": 11
 },
 {
  "id": "sce161:016AB",
  "jp": "マキ「そう？　まぁ、あなた達が本気で＜ゼ＝オード＞と{nl}　戦おうとしていることもわかったし、ほかに真実を{nl}　暴くべき対象があることもわかったし、{nl}　なにより、これ以上一緒にいるとジャーナリストとして{nl}　冷静な目でみることができそうになくなる気がするから」",
  "off": 5803,
  "len": 152,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5805,
  "text_len": 149
 },
 {
  "id": "sce161:01746",
  "jp": "トウヤ「そんなこと言ってこの王都の状況を{nl}　取材する気だろ？」",
  "off": 5958,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5960,
  "text_len": 40
 },
 {
  "id": "sce161:01774",
  "jp": "マキ「あ、バレてた？　ま、そういうことだから。じゃあね」",
  "off": 6004,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6006,
  "text_len": 29
 },
 {
  "id": "sce161:017B1",
  "jp": "アイ「やっと捕#791まえたよ」",
  "off": 6065,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6067,
  "text_len": 13
 },
 {
  "id": "sce161:017CC",
  "jp": "クルル「もぅ！　放して！　放してよ！」",
  "off": 6092,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6094,
  "text_len": 24
 },
 {
  "id": "sce161:017EF",
  "jp": "カスミ「クルルちゃん。お姉ちゃんたちをあまり{nl}　困らせないで」",
  "off": 6127,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6129,
  "text_len": 33
 },
 {
  "id": "sce161:01816",
  "jp": "ユミール「黙って乗り込んでいたのはいいとしても、{nl}　聖霊機に乗って出撃するなんて‥‥今回は{nl}　うまくいったけど、下手すれば死んじゃう{nl}　ところだったのよ？」",
  "off": 6166,
  "len": 99,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6168,
  "text_len": 96
 },
 {
  "id": "sce161:0187C",
  "jp": "クルル「そんなことないモン！{nl}　あたしだって立派に戦えるよ！」",
  "off": 6268,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6270,
  "text_len": 36
 },
 {
  "id": "sce161:018A6",
  "jp": "トウヤ「‥‥」",
  "off": 6310,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6312,
  "text_len": 9
 },
 {
  "id": "sce161:018B5",
  "jp": "アイ「あなたねぇ‥‥たしかにいきなりフォルスティンを{nl}　動かしたのは凄いことだし、素質もあるかもしれないわ。{nl}　でも、これは遊びじゃないのよ？」",
  "off": 6325,
  "len": 83,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6327,
  "text_len": 80
 },
 {
  "id": "sce161:0190B",
  "jp": "クルル「そんなの分かってるよ。{nl}　あたしもお父さんみたいに立派な騎止になるの！{nl}　だからあたしも戦う！」",
  "off": 6411,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6413,
  "text_len": 61
 },
 {
  "id": "sce161:01951",
  "jp": "カスミ「クルルちゃん！　乗り込んでいたの⁈」",
  "off": 6481,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6483,
  "text_len": 26
 },
 {
  "id": "sce161:01979",
  "jp": "クルル「だって‥‥」",
  "off": 6521,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6523,
  "text_len": 12
 },
 {
  "id": "sce161:0198B",
  "jp": "ユミール「だってじゃないでしょ？　お母さんもお父さんも{nl}　心配なさっているわよ？」",
  "off": 6539,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6541,
  "text_len": 48
 },
 {
  "id": "sce161:019CC",
  "jp": "クルル「あたしだって、一緒に戦いたい。{nl}　お母さんもお父さんもわかってくれるよ！」",
  "off": 6604,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6606,
  "text_len": 47
 },
 {
  "id": "sce161:01A01",
  "jp": "クロビス「あのなぁ‥‥戦うったって遊びとは違うんだぞ？」",
  "off": 6657,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6659,
  "text_len": 34
 },
 {
  "id": "sce161:01A31",
  "jp": "クルル「そんなことわかってる！{nl}　あたしだって立派に戦えるよ！」",
  "off": 6705,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6707,
  "text_len": 37
 },
 {
  "id": "sce161:01A5C",
  "jp": "トウヤ「‥‥」",
  "off": 6748,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6750,
  "text_len": 9
 },
 {
  "id": "sce161:01A6B",
  "jp": "ユミール「‥‥たしかにグリオールを動かせるというのは{nl}　凄いことだし、素質もあるかもしれないわ。{nl}　でも、実戦とは違うのよ？」",
  "off": 6763,
  "len": 78,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6765,
  "text_len": 75
 },
 {
  "id": "sce161:01AC0",
  "jp": "クルル「そんなのわかってるよ。{nl}　あたしもお父さんみたいに立派な騎止になるの！{nl}　だからあたしも戦う！」",
  "off": 6848,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6850,
  "text_len": 60
 },
 {
  "id": "sce161:01B02",
  "jp": "アイ「ちょっと、トウヤ。あんたもなにか言いなさいよ」",
  "off": 6914,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6916,
  "text_len": 27
 },
 {
  "id": "sce161:01B23",
  "jp": "トウヤ「クルル。本当に戦いたいのか？{nl}　これはシミュレーターじゃねぇ。死ぬかもしれねぇぞ。{nl}　困っても誰も助けてくれねぇんだぞ？」",
  "off": 6947,
  "len": 79,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6949,
  "text_len": 76
 },
 {
  "id": "sce161:01B8E",
  "jp": "クルル「子供扱いしないで！　あたしだって戦えるモン！{nl}　それに、死ぬのなんて怖くないよ！」",
  "off": 7054,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7056,
  "text_len": 54
 },
 {
  "id": "sce161:01BCA",
  "jp": "トウヤ「‼」",
  "off": 7114,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7116,
  "text_len": 7
 },
 {
  "id": "sce161:01BE6",
  "jp": "クルル「‥‥え？」",
  "off": 7142,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7144,
  "text_len": 12
 },
 {
  "id": "sce161:01BF8",
  "jp": "ユミール「トウヤ‥‥」",
  "off": 7160,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7162,
  "text_len": 14
 },
 {
  "id": "sce161:01C0C",
  "jp": "トウヤ「そんなこと簡単に言うんじゃねぇ！{nl}　死ぬのが怖くないだと⁈{nl}　お前は自分のことしか考えてねぇのか⁉」",
  "off": 7180,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7182,
  "text_len": 66
 },
 {
  "id": "sce161:01C5C",
  "jp": "クルル「な、なによ‥‥なによ‥‥」",
  "off": 7260,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7262,
  "text_len": 21
 },
 {
  "id": "sce161:01C77",
  "jp": "トウヤ「お前が死んだら、トーラさんやグラードはどう思う？{nl}　喜ぶと思うのか？　お前はいいだろう。{nl}　英雄気取りで死ねるんだからな。{nl}　だが、遺されたものにどれだけ深い悲しみを与えるのか{nl}　考えたことあるか？」",
  "off": 7287,
  "len": 128,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7289,
  "text_len": 125
 },
 {
  "id": "sce161:01CFA",
  "jp": "カスミ「トウヤちゃん‥‥」",
  "off": 7418,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7420,
  "text_len": 15
 },
 {
  "id": "sce161:01D13",
  "jp": "クルル「うっ‥‥」",
  "off": 7443,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7445,
  "text_len": 11
 },
 {
  "id": "sce161:01D24",
  "jp": "トウヤ「俺はお前が本当に戦いたいっていうんなら{nl}　別に構わないと思ってるし、艦長にも頼んでやる。{nl}　でも、お前を愛してくれる両親のことを考えねぇで、{nl}　英雄を気取るつもりなら俺は絶対ゆるさねぇ。{nl}　縛り上げてでも戦場には出さん。{nl}　なぁクルル、俺はトーラさんに頼まれたんだ。{nl}　お前のことを頼むって。{nl}　だから死ぬのが怖くないなんか言うなよ‥‥な」",
  "off": 7460,
  "len": 215,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7462,
  "text_len": 212
 },
 {
  "id": "sce161:01E09",
  "jp": "クルル「ううっ‥‥ごめんなさい‥‥ごめんなさい‥‥」",
  "off": 7689,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7691,
  "text_len": 32
 },
 {
  "id": "sce161:01E2F",
  "jp": "トウヤ「俺も殴ったりしてごめんな。大丈夫か？」",
  "off": 7727,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7729,
  "text_len": 29
 },
 {
  "id": "sce161:01E56",
  "jp": "クルル「‥‥うん、大丈夫‥‥」",
  "off": 7766,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7768,
  "text_len": 22
 },
 {
  "id": "sce161:01E72",
  "jp": "トウヤ「説教じみたことを言ってすまなかったな。{nl}　でも、戦うってことは自分だけの問題じゃねぇ。{nl}　そこだけは分かってくれ」",
  "off": 7794,
  "len": 73,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7796,
  "text_len": 70
 },
 {
  "id": "sce161:01EC9",
  "jp": "クルル「‥‥うん」",
  "off": 7881,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7883,
  "text_len": 11
 },
 {
  "id": "sce161:01EDA",
  "jp": "トウヤ「よし。それじゃ、もう一度よく考えて、{nl}　それから聞かせてくれないか？」",
  "off": 7898,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7900,
  "text_len": 44
 },
 {
  "id": "sce161:01F14",
  "jp": "クルル「うん‥‥わかった。ちゃんと考える」",
  "off": 7956,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7958,
  "text_len": 24
 },
 {
  "id": "sce161:01F32",
  "jp": "トウヤ「よし。いい子だ」",
  "off": 7986,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7988,
  "text_len": 13
 },
 {
  "id": "sce161:01F5E",
  "jp": "クルル「ぶぅ～　子供扱いしないでよぉ！」",
  "off": 8030,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8032,
  "text_len": 25
 },
 {
  "id": "sce161:01F7D",
  "jp": "トウヤ「ははは、すまねぇ」",
  "off": 8061,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8063,
  "text_len": 13
 },
 {
  "id": "sce161:01F9B",
  "jp": "オーレリィ「トウヤ。あんたをちょっと見直したよ。{nl}　‥‥さっ、クルル、行こう」",
  "off": 8091,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8093,
  "text_len": 45
 },
 {
  "id": "sce161:01FD6",
  "jp": "クルル「あっ‥‥ね、ねぇ‥‥」",
  "off": 8150,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8152,
  "text_len": 19
 },
 {
  "id": "sce161:01FEF",
  "jp": "トウヤ「ん？　どうした？」",
  "off": 8175,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8177,
  "text_len": 15
 },
 {
  "id": "sce161:02016",
  "jp": "クルル「あたし、ぶたれたのって初めて‥‥」",
  "off": 8214,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8216,
  "text_len": 24
 },
 {
  "id": "sce161:02034",
  "jp": "トウヤ「え？　あ、ああ‥‥」",
  "off": 8244,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8246,
  "text_len": 17
 },
 {
  "id": "sce161:02056",
  "jp": "クルル「さっきのトウヤってちょっと怖かったけど、{nl}{ctl:3C3E}{ctl:043C}",
  "off": 8278,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8280,
  "text_len": 32
 },
 {
  "id": "sce161:0209C",
  "jp": "トウヤ「そ、そうか？」",
  "off": 8348,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8350,
  "text_len": 12
 },
 {
  "id": "sce161:020B9",
  "jp": "クルル「うん。トウヤなら‥‥{nl}{ctl:3C3E}{ctl:843C}ZC{ctl:013E}{ctl:843C}cE　あたしが大きくなったらおムコさんにしてあげてもいいよ」",
  "off": 8377,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8379,
  "text_len": 62
 },
 {
  "id": "sce161:020FD",
  "jp": "ユミール「お、お婿さん⁈」",
  "off": 8445,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8447,
  "text_len": 16
 },
 {
  "id": "sce161:02113",
  "jp": "トウヤ「は、ははは‥‥まいったなぁ‥‥いてっ！」",
  "off": 8467,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8469,
  "text_len": 29
 },
 {
  "id": "sce161:02136",
  "jp": "アイ「なににやけてんのよ！{nl}　ふん‥‥よかったわね。{nl}　こんなかわいい婚約者ができて！」",
  "off": 8502,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8504,
  "text_len": 51
 },
 {
  "id": "sce161:0216F",
  "jp": "カスミ「‥‥」",
  "off": 8559,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8561,
  "text_len": 9
 },
 {
  "id": "sce161:02186",
  "jp": "クルル「ふぅ～ん。そっか‥‥けっこう競争率激しそうだね。{nl}　でも、あたしも負けないよ」",
  "off": 8582,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8584,
  "text_len": 51
 },
 {
  "id": "sce161:021BF",
  "jp": "ヤマト「大変だぁ～」",
  "off": 8639,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8641,
  "text_len": 13
 },
 {
  "id": "sce161:021F1",
  "jp": "セリカ「‥‥大丈夫？」",
  "off": 8689,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8691,
  "text_len": 17
 },
 {
  "id": "sce161:02208",
  "jp": "ローディス「お前は心配性だな。{nl}　平気だよ。ほら、このとお‥‥いてててて」",
  "off": 8712,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8714,
  "text_len": 46
 },
 {
  "id": "sce161:0223C",
  "jp": "セリカ「もぅ！　無理しないの！　まったく兄さんは‥‥」",
  "off": 8764,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8766,
  "text_len": 34
 },
 {
  "id": "sce161:02264",
  "jp": "ローディス「‥‥カインの目的は私の命らしい‥‥」",
  "off": 8804,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8806,
  "text_len": 33
 },
 {
  "id": "sce161:0228B",
  "jp": "セリカ「え⁈」",
  "off": 8843,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8845,
  "text_len": 8
 },
 {
  "id": "sce161:02299",
  "jp": "ローディス「すぐに殺すのではなく、別の方法で{nl}　私を苦しめ、そして最後に殺したいらしい」",
  "off": 8857,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8859,
  "text_len": 54
 },
 {
  "id": "sce161:022D5",
  "jp": "セリカ「‥‥もしかしてレイフォン兄さんのこと？」",
  "off": 8917,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8919,
  "text_len": 28
 },
 {
  "id": "sce161:022F7",
  "jp": "ローディス「ああ。彼はレイフォンを本当の兄のように{nl}　慕っていたからな‥‥」",
  "off": 8951,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8953,
  "text_len": 46
 },
 {
  "id": "sce161:0232B",
  "jp": "セリカ「で、でも‥‥」",
  "off": 9003,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9005,
  "text_len": 13
 },
 {
  "id": "sce161:0233E",
  "jp": "ローディス「私がレイフォンを傷つけた‥‥{nl}　彼にとってはそれだけで十分だった。{nl}　私自身、あのときはどうかしていたんだ‥‥」",
  "off": 9022,
  "len": 78,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9024,
  "text_len": 75
 },
 {
  "id": "sce161:0238F",
  "jp": "セリカ「兄さん‥‥」",
  "off": 9103,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9105,
  "text_len": 13
 },
 {
  "id": "sce161:023CF",
  "jp": "デイ「‥‥ヨアニス‥‥君には失望したよ。{nl}　まさかこんなことまでしでかすとは‥‥」",
  "off": 9167,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9169,
  "text_len": 50
 },
 {
  "id": "sce161:02407",
  "jp": "ヨアニス「な、なんだよ！　結局失敗したじゃないか！{nl}　ローディスじゃなくてレビオスを殺してしまってさ‥‥」",
  "off": 9223,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9225,
  "text_len": 63
 },
 {
  "id": "sce161:02455",
  "jp": "ヨアニス「ぐっ‥‥貴様‥‥殴った‥‥僕を‥‥」",
  "off": 9301,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9303,
  "text_len": 35
 },
 {
  "id": "sce161:0247E",
  "jp": "デイ「貴様のような奴を招きいれたのは生涯最大の{nl}　過ちだったようだな。梢えろ！　そしてもう二度と{nl}　我々の前にその姿を見せるな！」",
  "off": 9342,
  "len": 86,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9344,
  "text_len": 83
 },
 {
  "id": "sce161:024D7",
  "jp": "ヨアニス「‥‥あ、あんたはスゲェよ。{nl}　でも‥‥なんでもかんでもが自分の思惑どおりに運ぶとは{nl}　思うなよ‥‥クククククク」",
  "off": 9431,
  "len": 76,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9433,
  "text_len": 73
 },
 {
  "id": "sce161:0252A",
  "jp": "ドリス「やめな！　自分の失敗を棚にあげて‥‥」",
  "off": 9514,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9516,
  "text_len": 31
 },
 {
  "id": "sce161:0254F",
  "jp": "ヨアニス「う、うるさいっ！　お前も‥‥{nl}　どうしてこんな男がいいんだ⁉{nl}　私のほうが地位も金もあるのに！」",
  "off": 9551,
  "len": 67,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9553,
  "text_len": 64
 },
 {
  "id": "sce161:02595",
  "jp": "デイ「ヨアニス、そんな物騒なものはしまえ‥‥」",
  "off": 9621,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9623,
  "text_len": 27
 },
 {
  "id": "sce161:025B6",
  "jp": "ヨアニス「わ、私に命令するなぁっ‼」",
  "off": 9654,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9656,
  "text_len": 22
 },
 {
  "id": "sce161:025E8",
  "jp": "デイ「ぐはっ！」",
  "off": 9704,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9706,
  "text_len": 9
 },
 {
  "id": "sce161:025F7",
  "jp": "ドリス「デイっ‼」",
  "off": 9719,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9721,
  "text_len": 10
 },
 {
  "id": "sce161:02607",
