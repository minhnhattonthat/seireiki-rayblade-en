[
 {
  "id": "sce161:0005D",
  "jp": "トウヤ「ローディスの容態はどうなんだ？」",
  "off": 93,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 95,
  "text_len": 24
 },
 {
  "id": "sce161:0007B",
  "jp": "ユミール「思ったほど讐傷じゃないわ。{nl}　内臓も傷ついてなかったしね。{nl}　あと麹王陛下もご無事よ。{nl}　王都のテロも鎮庄されたし、{nl}　とりあえず一安心ね。{nl}　ただ、陛下を守ってレビオス元帥が亡くなったわ‥‥」",
  "off": 123,
  "len": 133,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 125,
  "text_len": 130
 },
 {
  "id": "sce161:00103",
  "jp": "トウヤ「そっか‥‥結局は忠義の人だったのかもな」",
  "off": 259,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 261,
  "text_len": 31
 },
 {
  "id": "sce161:00128",
  "jp": "ユミール「ええ。元帥の愛麹心は本物だったから‥‥」",
  "off": 296,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 298,
  "text_len": 35
 },
 {
  "id": "sce161:00151",
  "jp": "トウヤ「とりあえず収まったとはいえ、{nl}　テロリストの奴等は生きてる‥‥安心はできねぇな」",
  "off": 337,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 339,
  "text_len": 52
 },
 {
  "id": "sce161:00193",
  "jp": "ユミール「ええ。でも今回のことで{nl}　相当な損害をだしているはずよ。{nl}　組織的な活動をするのはしばらく無理ね」",
  "off": 403,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 405,
  "text_len": 68
 },
 {
  "id": "sce161:001DD",
  "jp": "ヤマト「ふぅ～ん‥‥{nl}　あれ？　そういえばシスクがいニャいけど‥‥{nl}　やっぱりローディス殿下のところ？」",
  "off": 477,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 479,
  "text_len": 62
 },
 {
  "id": "sce161:00225",
  "jp": "ユミール「え、ええ。すごい張り切ってあれこれ{nl}　世話をしてるみたい」",
  "off": 549,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 551,
  "text_len": 39
 },
 {
  "id": "sce161:00252",
  "jp": "ミヤスコ「私なんか、邪魔の一言で{nl}　追い出されちゃいましたよ」",
  "off": 594,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 596,
  "text_len": 38
 },
 {
  "id": "sce161:0027E",
  "jp": "トウヤ「セリカは？」",
  "off": 638,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 640,
  "text_len": 11
 },
 {
  "id": "sce161:00293",
  "jp": "ユミール「自分の部屋にいるわ。{nl}　でも今はそっとしておいてあげて」",
  "off": 659,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 661,
  "text_len": 39
 },
 {
  "id": "sce161:002D3",
  "jp": "セリカ「大丈夫よ。私だって子供じゃないんだから。{nl}　それにティックスを助けるまで落ち込んでなんて{nl}　いられないもの」",
  "off": 723,
  "len": 70,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 725,
  "text_len": 67
 },
 {
  "id": "sce161:0031C",
  "jp": "トウヤ「大丈夫か？」",
  "off": 796,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 798,
  "text_len": 14
 },
 {
  "id": "sce161:00330",
  "jp": "セリカ「うん‥‥心配かけてごめんね」",
  "off": 816,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 818,
  "text_len": 22
 },
 {
  "id": "sce161:0034C",
  "jp": "ユミール「‥‥」",
  "off": 844,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 846,
  "text_len": 11
 },
 {
  "id": "sce161:0035D",
  "jp": "ヤマト「ね、ねぇ、さっきから王都の上空を{nl}　飛んでるみたいニャんだけど‥‥ニャにやってるの」",
  "off": 861,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 863,
  "text_len": 53
 },
 {
  "id": "sce161:00398",
  "jp": "ミヤスコ「え？　ああ、梢火活動に協力しているのよ。{nl}　議会の長がテロリストだったし、いろいろ揉めてるみたいで{nl}　行政が正常に働いていないの」",
  "off": 920,
  "len": 89,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 922,
  "text_len": 86
 },
 {
  "id": "sce161:0040B",
  "jp": "マキ「やっほー！」",
  "off": 1035,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1037,
  "text_len": 11
 },
 {
  "id": "sce161:0041C",
  "jp": "トウヤ「フェインならいねぇぞ」",
  "off": 1052,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1054,
  "text_len": 15
 },
 {
  "id": "sce161:00431",
  "jp": "マキ「はぁ？　別にフェインちゃんに揖はないわよ。{nl}　それにもう挨拶は済ましてきたし」",
  "off": 1073,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1075,
  "text_len": 48
 },
 {
  "id": "sce161:00467",
  "jp": "ユミール「挨拶？」",
  "off": 1127,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1129,
  "text_len": 13
 },
 {
  "id": "sce161:0047A",
  "jp": "マキ「そっ。私、ここでリーボーフェンを降りるわ」",
  "off": 1146,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1148,
  "text_len": 28
 },
 {
  "id": "sce161:0049C",
  "jp": "トウヤ「突然だな」",
  "off": 1180,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1182,
  "text_len": 11
 },
 {
  "id": "sce161:004AD",
  "jp": "マキ「そう？　まぁ、あなた達が本気で＜ゼ＝オード＞と{nl}　戦おうとしていることもわかったし、ほかに真実を{nl}　暴くべき対象があることもわかったし、{nl}　なにより、これ以上一緒にいるとジャーナリストとして{nl}　冷静な目でみることができそうになくなる気がするから」",
  "off": 1197,
  "len": 152,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1199,
  "text_len": 149
 },
 {
  "id": "sce161:00548",
  "jp": "トウヤ「そんなこと言ってこの王都の状況を{nl}　取材する気だろ？」",
  "off": 1352,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1354,
  "text_len": 40
 },
 {
  "id": "sce161:00576",
  "jp": "マキ「あ、バレてた？　でもそれだけじゃないよ。{nl}　このままだとレイスケにドリルでもつけられかねないから。{nl}　ね、王女さま？」",
  "off": 1398,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1400,
  "text_len": 66
 },
 {
  "id": "sce161:005BE",
  "jp": "セリカ「え⁈　は、はははは‥‥そんなこと‥‥{nl}　か、考えてるワケないでしょ？{nl}　ほ、ほほほほほ‥‥」",
  "off": 1470,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1472,
  "text_len": 59
 },
 {
  "id": "sce161:005FF",
  "jp": "トウヤ「‥‥考えてたのか‥‥」",
  "off": 1535,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1537,
  "text_len": 20
 },
 {
  "id": "sce161:00619",
  "jp": "マキ「ま、そういうことだから。じゃあね」",
  "off": 1561,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1563,
  "text_len": 20
 },
 {
  "id": "sce161:00640",
  "jp": "ヤマト「‥‥ねぇ、トウヤ。ニャんか忘れてる気がしニャい？」",
  "off": 1600,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1602,
  "text_len": 34
 },
 {
  "id": "sce161:00668",
  "jp": "トウヤ「ん？　なんのことだ？」",
  "off": 1640,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1642,
  "text_len": 17
 },
 {
  "id": "sce161:006CC",
  "jp": "ロザリー「あーっ！　こんなとこに隠れてた！{nl}　ちょっと！　私達のお店、どうしてくれるのよ⁈」",
  "off": 1740,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1742,
  "text_len": 56
 },
 {
  "id": "sce161:00715",
  "jp": "トウヤ「‥‥あ、そういえば、踏み潰しちまったんだ‥‥」",
  "off": 1813,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1815,
  "text_len": 33
 },
 {
  "id": "sce161:00755",
  "jp": "ロザリー「あのお店はね！　あのお店は私が一生懸命‥‥{nl}{ctl:783E}{ctl:043C}aK{ctl:023E}{ctl:043C}YR{ctl:023E}{ctl:043C}XS　うぅ～ん‥‥‥」",
  "off": 1877,
  "len": 78,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1879,
  "text_len": 75
 },
 {
  "id": "sce161:007B2",
  "jp": "ゲン「わっ⁈　ね、姉ちゃん⁈{nl}　しっかりしろよ、姉ちゃん⁈」",
  "off": 1970,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1972,
  "text_len": 35
 },
 {
  "id": "sce161:007DB",
  "jp": "トウヤ「お、おい、大丈夫か？」",
  "off": 2011,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2013,
  "text_len": 19
 },
 {
  "id": "sce161:00806",
  "jp": "ロザリー「ねぇ‥‥」",
