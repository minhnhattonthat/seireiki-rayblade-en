  "status": "todo",
  "style": 0,
  "text_off": 183,
  "text_len": 28
 },
 {
  "id": "sce203:000D7",
  "jp": "クロビス「あいつの剣が見つかったんだ。{nl}　それも血のついたな！」",
  "off": 215,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 217,
  "text_len": 36
 },
 {
  "id": "sce203:00101",
