  "style": 1,
  "text_off": 5961,
  "text_len": 44
 },
 {
  "id": "sce203:01776",
  "jp": "アイ「そんなのわかってる！{nl}　でもそいつを許すことなんてできない‥‥{nl}　だからお願い‥‥邪魔をしないで！」",
  "off": 6006,
