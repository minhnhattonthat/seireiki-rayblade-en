  "text_len": 11
 },
 {
  "id": "sce203:00088",
  "jp": "アーサー「オズ<E1>ァルドさんですよ。あの人の姿が{nl}　どこにもないんです」",
  "off": 136,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 138,
  "text_len": 39
 },
 {
  "id": "sce203:000B5",
  "jp": "ヤマト「そういえばどこにもいニャかったようニャ‥‥」",
