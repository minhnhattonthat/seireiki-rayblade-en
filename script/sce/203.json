  "status": "todo",
  "style": 1,
  "text_off": 3546,
  "text_len": 80
 },
 {
  "id": "sce203:00E2B",
  "jp": "アーサー「‥‥私が？　どういうことです？」",
  "off": 3627,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3631,
  "text_len": 28
 },
 {
  "id": "sce203:00E4C",
  "jp": "レンダー「自分の胸に訊いてみることだな！{nl}　おしゃべりはここまでだ。さぁ、かかってこい！」",
