  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 419,
  "text_len": 20
 },
 {
  "id": "sce203:001CA",
  "jp": "ユミール「どうしたの⁈」",
  "off": 458,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 460,
  "text_len": 14
 },
 {
  "id": "sce203:001DE",
  "jp": "ミヤスコ「え⁈　え、えっと‥‥」",
  "off": 478,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 480,
  "text_len": 19
 },
 {
  "id": "sce203:001F7",
  "jp": "デロック「第一格納庫のハッチが破壊されたんだな。{nl}　あっ、なにか出ようとしてるんだな‥‥」",
  "off": 503,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 505,
  "text_len": 55
 },
 {
  "id": "sce203:00234",
  "jp": "セリカ「え⁈　あっ！　あれは‥‥」",
  "off": 564,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 566,
  "text_len": 21
 },
 {
  "id": "sce203:0024F",
  "jp": "フェイン「あーっ！　俺のミレオン！」",
  "off": 591,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 593,
  "text_len": 22
 },
 {
  "id": "sce203:0026B",
  "jp": "トウヤ「とにかく追おう！」",
  "off": 619,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 621,
  "text_len": 15
 },
 {
  "id": "sce203:00285",
  "jp": "セリカ「あっ、ちょっとまって！　アート・ウェスペルは{nl}　部品が特殊で、整備ができなかったの。{nl}　だから私達だけで戦うことになるわ！」",
  "off": 645,
  "len": 81,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 647,
  "text_len": 78
 },
 {
  "id": "sce203:002D9",
  "jp": "アーサー「そうですか‥‥やはりレデュースさんは{nl}　無理をして戦っていたのですね‥‥」",
  "off": 729,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 731,
  "text_len": 52
 },
 {
  "id": "sce203:00313",
  "jp": "セリカ「あんな状態で戦えたのが不思議なぐらいよ」",
  "off": 787,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 789,
  "text_len": 30
 },
 {
  "id": "sce203:00337",
  "jp": "クロビス「さすが、というべきだな。{nl}　よし、とにかく俺達だけで行くか。{nl}　どうせあの野郎を捕#791らえるだけだからな」",
  "off": 823,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 825,
  "text_len": 62
 },
 {
  "id": "sce203:00410",
  "jp": "オズ<E1>ァルド「こ、こ、こ‥‥こんな‥‥こんなはずじゃ‥‥{nl}　お、お、おのれ‥‥カイン‥‥{nl}　呪われた“魔眼”の子供‥‥くくくく」",
  "off": 1040,
  "len": 88,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1044,
  "text_len": 83
 },
 {
  "id": "sce203:00470",
  "jp": "レデュース「なんと！　宰相殿‥‥いや、あやつは{nl}　装兵機を操れたのか⁉」",
  "off": 1136,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1138,
  "text_len": 48
 },
 {
  "id": "sce203:004A6",
  "jp": "ガリュード「そういえば奴は昔騎止であったと聞いた{nl}　ことがある。だが、すぐに第一線から退いたらしい」",
  "off": 1190,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1192,
  "text_len": 60
 },
 {
  "id": "sce203:004E8",
  "jp": "シエル「ならば素人伺然、そういうことですか？」",
  "off": 1256,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1258,
  "text_len": 28
 },
 {
  "id": "sce203:0050A",
  "jp": "ガリュード「中途半端に操れる分、始末が悪いな。{nl}　‥‥ワシのベーゼンドルファーも先程の戦いで{nl}　損傷してしまっておる‥‥{nl}　まったく、このような時に動けんとは‥‥」",
  "off": 1290,
  "len": 110,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1292,
  "text_len": 107
 },
 {
  "id": "sce203:0057B",
  "jp": "レデュース「彼らならきっとうまくやってくれます」",
  "off": 1403,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1405,
  "text_len": 26
 },
 {
  "id": "sce203:0059B",
  "jp": "シエル「へぇ‥‥けっこう買ってるのね。{nl}　あなたにしてはめずらしいことじゃない？」",
  "off": 1435,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1437,
  "text_len": 45
 },
 {
  "id": "sce203:005CE",
  "jp": "レデュース「あのトウヤという若者‥‥{nl}　なかなか良い瞳をしているからな」",
  "off": 1486,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1488,
  "text_len": 43
 },
 {
  "id": "sce203:005FF",
  "jp": "ガリュード「トウヤか‥‥では、お前の認める男の{nl}　括#3A2躍を見せてもらうとするか」",
  "off": 1535,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1537,
  "text_len": 48
 },
 {
  "id": "sce203:0063E",
  "jp": "バーキン「おおっ⁉　ありゃ、アガルティアの{nl}　装兵機じゃねぇか？」",
  "off": 1598,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1602,
  "text_len": 39
 },
 {
  "id": "sce203:0066A",
  "jp": "リョード「しかし、突然空から現れましたよ」",
  "off": 1642,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1646,
  "text_len": 26
 },
 {
  "id": "sce203:00689",
  "jp": "ゴウ「‥‥光学遮蔽か‥‥実揖化されていたとはな‥‥」",
  "off": 1673,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1677,
  "text_len": 39
 },
 {
  "id": "sce203:006B5",
  "jp": "レシュ「レンダーの大将、どうします？{nl}　このまま無視して聖地へ徇かった方が‥‥」",
  "off": 1717,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1721,
  "text_len": 52
 },
 {
  "id": "sce203:006EE",
  "jp": "レンダー「いや。光学遮蔽システムはヨークの技術。{nl}　それを搭載しているのはリーボーフェンだけだ」",
  "off": 1774,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1778,
  "text_len": 60
 },
 {
  "id": "sce203:0072F",
  "jp": "バーキン「‼　それじゃ‥‥聖霊機がいやがるんですか⁈」",
  "off": 1839,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1843,
  "text_len": 35
 },
 {
  "id": "sce203:00757",
  "jp": "レンダー「間違いない‥‥」",
  "off": 1879,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1883,
  "text_len": 18
 },
 {
  "id": "sce203:0076E",
  "jp": "レンダー（そして、ここには奴らもいる‥‥{nl}　クロビス・カミリオン、アーサー・ヌコモ‥‥）",
  "off": 1902,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1906,
  "text_len": 52
 },
 {
  "id": "sce203:007A7",
  "jp": "ゴウ「レンダー様‥‥」",
  "off": 1959,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1963,
  "text_len": 15
 },
 {
  "id": "sce203:007E3",
  "jp": "フェイン「ひ、姫！　もう装兵機はないのですか⁈」",
  "off": 2019,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2021,
  "text_len": 30
 },
 {
  "id": "sce203:00807",
  "jp": "セリカ「あるワケないでしょ！　今廻はここにいなさい！」",
  "off": 2055,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2057,
  "text_len": 31
 },
 {
  "id": "sce203:0082C",
  "jp": "フェイン「そんなぁ‥‥」",
  "off": 2092,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2094,
  "text_len": 14
 },
 {
  "id": "sce203:00845",
  "jp": "オズ<E1>ァルド「早く‥‥早く、奴の屋敷へ‥‥」",
  "off": 2117,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2121,
  "text_len": 31
 },
 {
  "id": "sce203:00883",
  "jp": "レンダー「やはりな。{nl}　こんなとこで出会えたのも僥倖。{nl}　よし、各機ぬかるなよ。私はあの白い機体を狙う！」",
  "off": 2179,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2183,
  "text_len": 66
 },
 {
  "id": "sce203:00936",
  "jp": "Aヤマト「トウヤ！　あれ、この前のテロリストだよ！」",
  "off": 2358,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 2362,
  "text_len": 29
 },
 {
  "id": "sce203:00958",
  "jp": "トウヤ「ああ。まったくどこにでもあらわれやがるな‥‥」",
  "off": 2392,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2396,
  "text_len": 29
 },
 {
  "id": "sce203:0097A",
  "jp": "アーサー「テロリストも戻#7EA題ですが、まずはあのミレオンを{nl}　捕#791らえることが先決です」",
  "off": 2426,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2430,
  "text_len": 48
 },
 {
  "id": "sce203:009AF",
  "jp": "クロビス「ある程度攻撃してから捕#791らえないと{nl}　逃げられる可能性があるな‥‥」",
  "off": 2479,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2483,
  "text_len": 49
 },
 {
  "id": "sce203:009E8",
  "jp": "セリカ「ちょっと待って！　あのミレオンは攻撃しちゃダメ！{nl}　フェインが無茶な操縦ばっかりするからかなりガタが{nl}　きてるの。だから下手に攻撃なんかしたら{nl}　たちまちドカンよ。だから、取り押さえて捕#791まえて」",
  "off": 2536,
  "len": 120,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2538,
  "text_len": 117
 },
 {
  "id": "sce203:00A60",
  "jp": "トウヤ「攻撃は禁止#4FDか‥‥{nl}　あのテロリストどもが攻撃しなけりゃいいが‥‥」",
  "off": 2656,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2660,
  "text_len": 47
 },
 {
  "id": "sce203:00A94",
  "jp": "Aヤマト「無理でしょうね」",
  "off": 2708,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 2712,
  "text_len": 15
 },
 {
  "id": "sce203:00AA8",
  "jp": "クロビス「‥‥となれば、奴等よりも先にあいつを{nl}　取り押さえなきゃならんってことだ」",
  "off": 2728,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2732,
  "text_len": 49
 },
 {
  "id": "sce203:00ADE",
  "jp": "アーサー「アイがいないのは痛いですが、仕方ありません。{nl}　急ぎましょう！　今廻もトウヤに指揮は任せますよ」",
  "off": 2782,
  "len": 70,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2786,
  "text_len": 65
 },
 {
  "id": "sce203:00B24",
  "jp": "Aヤマト「ミレオンを捕#791らえるには隣接すればOKよ。{nl}　くれぐれも攻撃しニャいようにね」",
  "off": 2852,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 2856,
  "text_len": 48
 },
 {
  "id": "sce203:00B59",
  "jp": "トウヤ「わかってるって」",
  "off": 2905,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2909,
  "text_len": 12
 },
 {
  "id": "sce203:00BDE",
  "jp": "オズ<E1>ァルド「う、うわぁぁぁぁぁぁっ‥‥」",
  "off": 3038,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3042,
  "text_len": 23
 },
 {
  "id": "sce203:00C0F",
  "jp": "クロビス「よぉ、また会ったな」",
  "off": 3087,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3091,
  "text_len": 16
 },
 {
  "id": "sce203:00C24",
  "jp": "レンダー「一度、手合せをしたいと思っていたが‥‥{nl}　こういう形で実現するとはな」",
  "off": 3108,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3112,
  "text_len": 51
 },
 {
  "id": "sce203:00C5C",
  "jp": "クロビス「あんた、それほどの腕をもちながら{nl}　なぜテロなんかに手を貸すんだ？」",
  "off": 3164,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3168,
  "text_len": 43
 },
 {
  "id": "sce203:00C8C",
  "jp": "レンダー「テロではない。革命だ。{nl}　そのあたりを間違えないでもらいたいものだな。{page}　それに貴様に説明したところで分からんだろうし、{nl}　分かってもらおうとも思わん」",
  "off": 3212,
  "len": 98,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3216,
  "text_len": 93
 },
 {
  "id": "sce203:00CEE",
  "jp": "クロビス「どうしてもヤルってのか？」",
  "off": 3310,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3314,
  "text_len": 19
 },
 {
  "id": "sce203:00D06",
  "jp": "レンダー「ああ、その為に生きているんだからな‥‥」",
  "off": 3334,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3338,
  "text_len": 30
 },
 {
  "id": "sce203:00D29",
  "jp": "クロビス「それは‥‥どういう意味だ？」",
  "off": 3369,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3373,
  "text_len": 24
 },
 {
  "id": "sce203:00D46",
  "jp": "レンダー「おしゃべりはここまでだ。{nl}　さぁ、かかってこい！」",
  "off": 3398,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3402,
  "text_len": 32
 },
 {
  "id": "sce203:00D85",
  "jp": "アーサー「できれば退いてほしいのですが？」",
  "off": 3461,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3465,
  "text_len": 25
 },
