  "off": 257,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 259,
  "text_len": 38
 },
 {
  "id": "sce203:0012D",
  "jp": "クロビス「ガリュードさんが確認してくれたんだ。{nl}　今、全員で捜索している」",
  "off": 301,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 303,
  "text_len": 45
 },
 {
  "id": "sce203:00160",
  "jp": "フェイン「まさか‥‥あいつ、宰相だったのではないのか⁉{nl}　自分の主君を手にかけたっていうのか⁈」",
  "off": 352,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 354,
  "text_len": 59
 },
 {
  "id": "sce203:001A1",
  "jp": "トウヤ「いったいどうなってやがんだ⁉」",
