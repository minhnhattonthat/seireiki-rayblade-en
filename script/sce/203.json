  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 6010,
  "text_len": 63
 },
 {
  "id": "sce203:017BA",
  "jp": "トウヤ「冷静になれ。ここでその引き金をひけば、{nl}　お前もこいつと伺類になる。{nl}　お前が許せない、こいつと！」",
  "off": 6074,
