  "jp": "レンダー「できぬ相談だな」",
  "off": 3491,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3495,
  "text_len": 16
 },
 {
  "id": "sce203:00DB8",
  "jp": "アーサー「そんなに我々が邪魔ですか？」",
