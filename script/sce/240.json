  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4866,
  "text_len": 34
 },
 {
  "id": "sce240:01328",
  "jp": "ヤマト「もぅ、こんニャとこでニャにを言い出すのよ。{nl}　カスミだって困ってるでしょ？」",
  "off": 4904,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4906,
  "text_len": 46
 },
 {
  "id": "sce240:0135C",
  "jp": "カスミ「わ、私は、別に‥‥」",
  "off": 4956,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4958,
  "text_len": 18
 },
 {
  "id": "sce240:01374",
  "jp": "ヤマト「そういうことはちゃんと言わニャいとダメよ！{nl}　だいたい、トウヤ、あニャたカスミにちゃんと{nl}　告白したの？　してニャいでしょ⁈{nl}　相手の承諾を得ニャいでいきニャり大勢の人の前で{nl}　そんニャ宣言するニャんて‥‥ちゃんとカスミの{nl}　気持ちを考えてあげニャさいよね！」",
  "off": 4980,
  "len": 160,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4982,
  "text_len": 157
 },
 {
  "id": "sce240:0143B",
  "jp": "アイ「と、いうことは‥‥」",
  "off": 5179,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5181,
  "text_len": 15
 },
 {
  "id": "sce240:01450",
  "jp": "ヤマト「さっきトウヤが言ってたとおりおさニャニャじみよ」",
  "off": 5200,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5202,
  "text_len": 29
 },
 {
  "id": "sce240:01473",
  "jp": "セリカ「ふ～ん」",
  "off": 5235,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5237,
  "text_len": 9
 },
 {
  "id": "sce240:0149B",
  "jp": "オーレリィ「なーんだ、つまんないねぇ」",
  "off": 5275,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5277,
  "text_len": 21
 },
 {
  "id": "sce240:014C8",
  "jp": "トウヤ「‥‥」",
  "off": 5320,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5322,
  "text_len": 9
 },
 {
  "id": "sce240:014E0",
  "jp": "カスミ「‥‥う、うん、そうだよ。{nl}　小学校の時からだよね」",
  "off": 5344,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5346,
  "text_len": 35
 },
 {
  "id": "sce240:01509",
  "jp": "トウヤ「ああ」",
  "off": 5385,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5387,
  "text_len": 7
 },
 {
  "id": "sce240:0152A",
  "jp": "アイ「そ、そっか‥‥‥‥ふぅ」",
  "off": 5418,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5420,
  "text_len": 19
 },
 {
  "id": "sce240:01560",
  "jp": "アイ（あ、あれ？　なんであたし安心してんだろ？{nl}　え？　うそ？　まさか‥‥）",
  "off": 5472,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5474,
  "text_len": 46
 },
 {
  "id": "sce240:015A2",
  "jp": "シィウチェン「‥‥とにかく、無事でなによりだった。{nl}　守るべきときに守れないことほど{nl}　辛いことはない‥‥」",
  "off": 5538,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5540,
  "text_len": 63
 },
 {
  "id": "sce240:015E7",
  "jp": "オーレリィ「そうか‥‥それで‥‥」",
  "off": 5607,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5609,
  "text_len": 22
 },
 {
  "id": "sce240:01603",
  "jp": "トウヤ「シィウチェン、あんたが救出を主張してくれた{nl}　おかげだ。礼を言うよ」",
  "off": 5635,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5637,
  "text_len": 44
 },
 {
  "id": "sce240:01635",
  "jp": "シィウチェン「当然のことをしたまでだ。{nl}　礼には及ばん。{nl}　さ、さてと‥‥」",
  "off": 5685,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5687,
  "text_len": 44
 },
 {
  "id": "sce240:01667",
  "jp": "アーサー「おや、シィウチェンさんどちらへ？」",
  "off": 5735,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5737,
  "text_len": 25
 },
 {
  "id": "sce240:01686",
  "jp": "シィウチェン「‥‥アハティの様子をみてくる」",
  "off": 5766,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5768,
  "text_len": 26
 },
 {
  "id": "sce240:016AA",
  "jp": "クロビス「あいつも、もう少し素直になればいいのにな」",
  "off": 5802,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5804,
  "text_len": 29
 },
 {
  "id": "sce240:016CD",
  "jp": "アーサー「ええ」",
  "off": 5837,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5839,
  "text_len": 10
 },
 {
  "id": "sce240:016DD",
  "jp": "ヤマト「そういえばどうしてカスミがこっちへ{nl}　来ることにニャったの？」",
  "off": 5853,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5855,
  "text_len": 37
 },
 {
  "id": "sce240:0171A",
  "jp": "カスミ「うん‥‥それが、3ヵ月前にトウヤちゃんが{nl}　梢えてから‥‥」",
  "off": 5914,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5916,
  "text_len": 41
 },
 {
  "id": "sce240:01749",
  "jp": "トウヤ「3ヵ月前⁈　俺がこっちに来てまだ{nl}　数日しかたってねぇぞ？」",
  "off": 5961,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5963,
  "text_len": 42
 },
 {
  "id": "sce240:01779",
  "jp": "ユミール「‥‥おそらくカスミさんもトウヤと{nl}　同じように別の平行世界へ跳ばされていたようね。{nl}　“トウヤが存在しない場合”の世界に」",
  "off": 6009,
  "len": 87,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6011,
  "text_len": 84
 },
 {
  "id": "sce240:017D3",
  "jp": "トウヤ「フォルゼンもそんなようなこと言っていたが‥‥」",
  "off": 6099,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6101,
  "text_len": 30
 },
 {
  "id": "sce240:017F7",
  "jp": "カスミ「新学期初日からいつもと違うようになって‥‥{nl}　フォルゼンさんの説明だと、トウヤちゃんも同じ日から{nl}　存在が不安定になったっておっしゃっていたけど‥‥」",
  "off": 6135,
  "len": 101,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6137,
  "text_len": 98
 },
 {
  "id": "sce240:0185F",
  "jp": "トウヤ「初日か‥‥校庭でゼイフォンとライブレードの{nl}　戦いを見た時‥‥{nl}　あの日が変化の分岐点だったのか‥‥」",
  "off": 6239,
  "len": 78,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6241,
  "text_len": 75
 },
 {
  "id": "sce240:018B0",
  "jp": "カスミ「その日から3ヵ月が経って‥‥{nl}　でも、誰もトウヤちゃんのこと知らないの。{nl}　トウヤちゃんのクラスのみんなも晃一郎君まで誰も‥‥{nl}　まるでトウヤちゃんがはじめから存在していなかった{nl}　みたいに‥‥。私、怖かった‥‥トウヤちゃんは{nl}　ホントにいたの⁈{nl}　すべて私の幻想じゃないのかって‥‥{nl}　でも、そんな時にフォルゼンさんがあらわれて‥‥」",
  "off": 6320,
  "len": 206,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6322,
  "text_len": 203
 },
 {
  "id": "sce240:01981",
  "jp": "トウヤ「それでこっちへ来たのか？」",
  "off": 6529,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6531,
  "text_len": 19
 },
 {
  "id": "sce240:0199A",
  "jp": "カスミ「うん」",
  "off": 6554,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6556,
  "text_len": 7
 },
 {
  "id": "sce240:019A7",
  "jp": "アイ「‥‥ということはあなたトウヤに会いたい一心で{nl}　ワケのわかんないトコへ行こうと思ったの？」",
  "off": 6567,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6569,
  "text_len": 56
 },
 {
  "id": "sce240:019F7",
  "jp": "カスミ「‥‥はい」",
  "off": 6647,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6649,
  "text_len": 11
 },
 {
  "id": "sce240:01A08",
  "jp": "オーレリィ「一途だねぇ‥‥」",
  "off": 6664,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6666,
  "text_len": 19
 },
 {
  "id": "sce240:01A21",
  "jp": "アイ「幼なじみ、眼鏡っ子、黒髪ストレート、健気‥‥」",
  "off": 6689,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6691,
  "text_len": 37
 },
 {
  "id": "sce240:01A4C",
  "jp": "トウヤ「なにブツブツ言ってんだ？」",
  "off": 6732,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6734,
  "text_len": 19
 },
 {
  "id": "sce240:01A65",
  "jp": "アイ「え⁈　あ、いや、べ、別に‥‥」",
  "off": 6757,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6759,
  "text_len": 22
 },
 {
  "id": "sce240:01A81",
  "jp": "トウヤ「？？？」",
  "off": 6785,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6787,
  "text_len": 11
 },
 {
  "id": "sce240:01A9A",
  "jp": "アイ（‥‥あたし、なに焦ってるの‥‥？{nl}　あの子がトウヤのこと好きだって構わないじゃない‥‥{nl}　でも、なんなの？　このモヤモヤした感じ‥‥）",
  "off": 6810,
  "len": 88,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6812,
  "text_len": 85
 },
 {
  "id": "sce240:01AF5",
  "jp": "トウヤ「おーい‥‥」",
  "off": 6901,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6903,
  "text_len": 13
 },
 {
  "id": "sce240:01B08",
  "jp": "セリカ「ダメね。今のアイは内的世界での戦闘中みたい」",
  "off": 6920,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6922,
  "text_len": 34
 },
 {
  "id": "sce240:01B30",
  "jp": "トウヤ「‥‥なんのことだか‥‥」",
  "off": 6960,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6962,
  "text_len": 20
 },
 {
  "id": "sce240:01B4A",
  "jp": "ミヤスコ「あの‥‥カスミさんも疲れているようですし、{nl}　一応検査とかもしておいたほうが‥‥」",
  "off": 6986,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6988,
  "text_len": 55
 },
 {
  "id": "sce240:01B87",
  "jp": "ユミール「そうね。お願いできる？」",
  "off": 7047,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7049,
  "text_len": 20
 },
 {
  "id": "sce240:01BA1",
  "jp": "ミヤスコ「はい。カスミさん、こちらへ」",
  "off": 7073,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7075,
  "text_len": 19
 },
 {
  "id": "sce240:01BC6",
  "jp": "フェイン「お、お、おおお俺もお供します！」",
  "off": 7110,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7112,
  "text_len": 24
 },
 {
  "id": "sce240:01BE4",
  "jp": "セリカ「‥‥」",
  "off": 7140,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7142,
  "text_len": 9
 },
 {
  "id": "sce240:01BF3",
  "jp": "フェイン「な、なんですか⁈{nl}　お、俺は別に‥‥その‥‥騎止として、あの‥‥」",
  "off": 7155,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7157,
  "text_len": 49
 },
 {
  "id": "sce240:01C2A",
  "jp": "セリカ「別になんにも言ってないわよ。{nl}　一目ボレしたならそう言えばいいのに」",
  "off": 7210,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7212,
  "text_len": 43
 },
 {
  "id": "sce240:01C5B",
  "jp": "フェイン「な！　ななななな、なんということを⁉」",
  "off": 7259,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7261,
  "text_len": 26
 },
 {
  "id": "sce240:01C7B",
  "jp": "オーレリィ「え？　フェインってユミールのことが‥‥」",
  "off": 7291,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7293,
  "text_len": 31
 },
 {
  "id": "sce240:01CA0",
  "jp": "ユミール「え？」",
  "off": 7328,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7330,
  "text_len": 10
 },
 {
  "id": "sce240:01CB0",
  "jp": "フェイン「わぁぁぁぁぁっ！」",
  "off": 7344,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7346,
  "text_len": 15
 },
 {
  "id": "sce240:01CC5",
  "jp": "デロック「恋多き年頃なんだな。{nl}　悩め青少年よ！　なんだな」",
  "off": 7365,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7367,
  "text_len": 39
 },
 {
  "id": "sce240:01CF2",
  "jp": "ユミール「と、とにかく彼女をお願いね」",
  "off": 7410,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7412,
  "text_len": 23
 },
 {
  "id": "sce240:01D0F",
  "jp": "ミヤスコ「はい」",
  "off": 7439,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7441,
  "text_len": 8
 },
 {
  "id": "sce240:01D1D",
  "jp": "トウヤ「あっ、そうだ。そのあたりに人がいねぇか？{nl}　カスミを助けてくれた人なんだ」",
  "off": 7453,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7455,
  "text_len": 45
 },
 {
  "id": "sce240:01D50",
  "jp": "シスク「人‥‥？　あっ、発見しました」",
  "off": 7504,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7506,
  "text_len": 25
 },
 {
  "id": "sce240:01D95",
  "jp": "ベルンスト「‥‥いや、あのまま放置されたらどうしようかと{nl}　思いましたよ」",
  "off": 7573,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7575,
  "text_len": 42
 },
 {
  "id": "sce240:01DC5",
  "jp": "トウヤ「悪い、悪い。さっきはカスミを助けてくれて{nl}　ありがとう。あんたがいなければどうなっていたか‥‥」",
  "off": 7621,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7623,
  "text_len": 57
 },
 {
  "id": "sce240:01E04",
  "jp": "ベルンスト「いえいえ。これもなにかの縁でしょう」",
  "off": 7684,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7686,
  "text_len": 25
 },
 {
  "id": "sce240:01E23",
  "jp": "ユミール「我々からもお礼を言います‥‥」",
  "off": 7715,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7717,
  "text_len": 26
 },
 {
  "id": "sce240:01E43",
  "jp": "ベルンスト「いえ‥‥！」",
  "off": 7747,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7749,
  "text_len": 15
 },
 {
  "id": "sce240:01E58",
  "jp": "ユミール「あの‥‥私の顔になにか？」",
  "off": 7768,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7770,
  "text_len": 24
 },
 {
  "id": "sce240:01E76",
  "jp": "ベルンスト「‥‥あ、いや、すみません。{nl}　あまりにも若くて美しい艦長だと思ったもので‥‥」",
  "off": 7798,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7800,
  "text_len": 54
 },
 {
  "id": "sce240:01EB2",
  "jp": "ヤマト（うわっ、無理矢理ニャ誉め方。{nl}　そんニャんじゃ逆効果‥‥）",
  "off": 7858,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7860,
  "text_len": 44
 },
 {
  "id": "sce240:01EE4",
  "jp": "ユミール「そ、そんな‥‥」",
  "off": 7908,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7910,
  "text_len": 16
 },
 {
  "id": "sce240:01EFA",
  "jp": "ヤマト（‥‥おいおい）",
  "off": 7930,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7932,
  "text_len": 13
 },
 {
  "id": "sce240:01F0D",
  "jp": "セリカ「‥‥見たところ、傭兵とかそういう感じじゃ{nl}　ないけど‥‥」",
  "off": 7949,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7951,
  "text_len": 41
 },
 {
  "id": "sce240:01F3C",
  "jp": "ベルンスト「ええ。私の専門は“生命工学”です」",
  "off": 7996,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7998,
  "text_len": 32
 },
 {
  "id": "sce240:01F62",
  "jp": "アイ「生命工学ってなに？」",
  "off": 8034,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8036,
  "text_len": 18
 },
 {
  "id": "sce240:01F7A",
  "jp": "ユミール「生命の進化や遺田子工学を包括する{nl}　学問よ。たしか、人工的に生命を造りだすことも{nl}　可能でしたよね？」",
  "off": 8058,
  "len": 82,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8060,
  "text_len": 79
 },
 {
  "id": "sce240:01FCF",
  "jp": "ベルンスト「ふふふ‥‥まぁ、理論的にはそうですね」",
  "off": 8143,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8145,
  "text_len": 30
 },
 {
  "id": "sce240:01FF3",
  "jp": "トウヤ「そういう学者さんがこんなところでなにを{nl}　してたんだ？　危険だろ？」",
  "off": 8179,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8181,
  "text_len": 44
 },
 {
  "id": "sce240:02025",
  "jp": "ベルンスト「研究ですよ」",
  "off": 8229,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8231,
  "text_len": 14
 },
 {
  "id": "sce240:02039",
  "jp": "トウヤ「研究？　命の危険を冒してまでする{nl}　研究なのか？」",
  "off": 8249,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8251,
  "text_len": 39
 },
 {
  "id": "sce240:02066",
  "jp": "ベルンスト「ええ。私の研究対象は“人の感情”{nl}　ですから。{nl}　感情に縛られる生き物は多くいますが、{nl}　人ほど複雑な生き物は他にいません。{nl}　私はその“感情”が人にどう影響を及ぼすのかを{nl}　研究しているのです。{nl}　そして、今回のテーマは“恐怖”だったのですが、{nl}　その前にさきほどの彼女をみつけたというワケです」",
  "off": 8294,
  "len": 201,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8296,
  "text_len": 198
 },
 {
  "id": "sce240:02132",
  "jp": "アーサー「つまりあなたは自分自身がどう“恐怖”を{nl}　味わうかを試すためにこの樹海へ足を踏みいれた、と？」",
  "off": 8498,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8500,
  "text_len": 69
 },
 {
  "id": "sce240:0217D",
  "jp": "ベルンスト「ええ。やはり自分自身で体験してみないと{nl}　何事も真実は分かりませんから」",
  "off": 8573,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8575,
  "text_len": 53
 },
 {
  "id": "sce240:021B8",
  "jp": "トウヤ「んなことして死んじまったら元も子もねぇだろ？」",
  "off": 8632,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8634,
  "text_len": 31
 },
 {
  "id": "sce240:021DD",
  "jp": "ベルンスト「そういえばそうですね。{nl}　気づきませんでした、はははははは」",
  "off": 8669,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8671,
  "text_len": 37
 },
 {
  "id": "sce240:02208",
  "jp": "アイ「なんか、フォルゼンを思い出すわね」",
  "off": 8712,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8714,
  "text_len": 22
 },
 {
  "id": "sce240:02224",
  "jp": "トウヤ「この世界ってこういう奴ばっかりか？」",
  "off": 8740,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8742,
  "text_len": 26
 },
 {
  "id": "sce240:02244",
  "jp": "ユミール「あの、ベルンストさんはまだここで研究を{nl}　続けるおつもりなのですか？」",
  "off": 8772,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8774,
  "text_len": 45
 },
 {
  "id": "sce240:02277",
  "jp": "ベルンスト「う～ん、それもいいのですが‥‥{nl}　噂の聖霊機を目の前にしてなにもしないのは{nl}　私の矜持（きょうじ）に反します。{nl}　是非ご同行させていただけませんか？」",
  "off": 8823,
  "len": 102,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8825,
  "text_len": 99
 },
 {
  "id": "sce240:022E0",
  "jp": "ユミール「え？　そ、それは‥‥」",
  "off": 8928,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8930,
  "text_len": 20
 },
 {
  "id": "sce240:022FA",
  "jp": "ベルンスト「私はこう見えても口は堅いほうですよ」",
  "off": 8954,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8956,
  "text_len": 28
 },
 {
  "id": "sce240:0231C",
  "jp": "ユミール「そうではありません。{nl}　間違いなく我々は戦いの中へ身を投じていくことに{nl}　なります。そんな中にいるのは危険です」",
  "off": 8988,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 8990,
  "text_len": 72
 },
 {
  "id": "sce240:0236A",
  "jp": "ベルンスト「私のことは気にしなくても結構です。{nl}　もし巻き添えで死んだとしてもそれは私自身の責任。{nl}　それにいつまでも居座るつもりもありません。{nl}　あくまで同乗者という立場で、不揖意な介入、{nl}　口出しはしないと約束します」",
  "off": 9066,
  "len": 142,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9068,
  "text_len": 139
 },
 {
  "id": "sce240:023FB",
  "jp": "ユミール「しかし‥‥。艦長‥‥」",
  "off": 9211,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9213,
  "text_len": 23
 },
 {
  "id": "sce240:02418",
  "jp": "ロア艦長「‥‥うむ」",
  "off": 9240,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9242,
  "text_len": 14
 },
 {
  "id": "sce240:0242C",
  "jp": "ユミール「そうですよね。やはり危険ですよね」",
  "off": 9260,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9262,
  "text_len": 25
 },
 {
  "id": "sce240:0244B",
  "jp": "ベルンスト「‥‥ではこういうのはどうです？{nl}　私がジグリム装兵機についての情報をお話しする。{nl}　あなた方はその謝礼として私の研究に協力する」",
  "off": 9291,
  "len": 91,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9293,
  "text_len": 88
 },
 {
  "id": "sce240:024A9",
  "jp": "アーサー「‥‥交換条件ですか？　揖意がいいのですね」",
  "off": 9385,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9387,
  "text_len": 37
 },
 {
  "id": "sce240:024D4",
  "jp": "ベルンスト「いえいえ、偶然ですよ。{nl}　この樹海、いや、バルアミーに興味を抱いている人は{nl}　他にもいるということです」",
  "off": 9428,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9430,
  "text_len": 68
 },
 {
  "id": "sce240:0251E",
  "jp": "セリカ「それって、ここにジグリムの調査隊が入り込んで{nl}　いるってこと？」",
  "off": 9502,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9504,
  "text_len": 42
 },
 {
  "id": "sce240:0254E",
  "jp": "ベルンスト「いえ。調査隊というよりは捕#791獲部隊ですね。{nl}　あれはあきらかに軍隊でしたよ。それも最新鋭の」",
  "off": 9550,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9552,
  "text_len": 63
 },
 {
  "id": "sce240:02593",
  "jp": "セリカ「もしかして、その装兵機の部品を{nl}　手に入れた、とか？」",
  "off": 9619,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9621,
  "text_len": 39
 },
 {
  "id": "sce240:025C0",
  "jp": "ベルンスト「ええ。どちらかというと技術的には{nl}　後進的だったジグリムに突如として{nl}　新型装兵機の開発が盛んになった{nl}　時期と一致しますし、何者か‥‥{nl}　それもかなり特殊な技術をもつ者の{nl}　協力があったと推測されます。{nl}　たとえば、＜ゼ＝オード＞の人達のようにね」",
  "off": 9664,
  "len": 173,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9666,
  "text_len": 170
 },
 {
  "id": "sce240:02670",
  "jp": "トウヤ「なっ⁉」",
  "off": 9840,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9842,
  "text_len": 9
 },
 {
  "id": "sce240:0267F",
  "jp": "ベルンスト「あくまで私の想像の域は越えていませんが{nl}　そう考えて間違いはないと思います」",
  "off": 9855,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9857,
  "text_len": 53
 },
 {
  "id": "sce240:026BA",
  "jp": "セリカ「でもそれだけじゃ‥‥」",
  "off": 9914,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9916,
  "text_len": 17
 },
 {
  "id": "sce240:026D1",
  "jp": "ベルンスト「その時のパーツはちゃんともっていますよ。{nl}　‥‥ホラ」",
  "off": 9937,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9939,
  "text_len": 37
 },
 {
  "id": "sce240:026FC",
  "jp": "セリカ「すごいじゃない！　ちょっと見せて‥‥」",
  "off": 9980,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9982,
  "text_len": 27
 },
 {
  "id": "sce240:0271D",
  "jp": "ベルンスト「おっと。これは研究の許可と引き換えです」",
  "off": 10013,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 10015,
  "text_len": 32
 },
 {
  "id": "sce240:02743",
  "jp": "セリカ「あーあー」",
  "off": 10051,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 10053,
  "text_len": 11
 },
 {
  "id": "sce240:02754",
  "jp": "フェイン「ひ、姫、はしたない！　おやめください‼」",
  "off": 10068,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 10070,
  "text_len": 28
 },
 {
  "id": "sce240:02776",
  "jp": "ロア艦長「うむ」",
  "off": 10102,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 10104,
  "text_len": 10
 },
 {
  "id": "sce240:02786",
  "jp": "ユミール「え⁈　は、はい。わかりました。{nl}　ベルンストさん、制限付きですが、あなたの乗船を{nl}　許可します」",
  "off": 10118,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 10120,
  "text_len": 62
 },
 {
  "id": "sce240:027CA",
  "jp": "ベルンスト「ありがとうございます。{nl}　では、どうぞ」",
  "off": 10186,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 10188,
  "text_len": 26
 },
 {
  "id": "sce240:027EA",
  "jp": "セリカ「‥‥これが‥‥へぇ‥‥ふぅ～ん‥‥ほぅ‥‥」",
  "off": 10218,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 10220,
  "text_len": 37
 },
 {
  "id": "sce240:0281C",
  "jp": "フェイン「あっ、ひ、姫！」",
  "off": 10268,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 10270,
  "text_len": 15
 },
 {
  "id": "sce240:02844",
  "jp": "ユミール「とりあえず、部品の解析はセリカに任せるとして{nl}　一度聖地へ戻りませんか？」",
  "off": 10308,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 10310,
  "text_len": 54
 },
 {
  "id": "sce240:02880",
  "jp": "ロア艦長「うむ」",
  "off": 10368,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 10370,
  "text_len": 10
 },
 {
  "id": "sce240:02890",
  "jp": "ユミール「はい。バレン、お願い」",
  "off": 10384,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 10386,
  "text_len": 18
 },
 {
  "id": "sce240:028A8",
  "jp": "バレン「了解。リーボーフェン、発進」",
  "off": 10408,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 10410,
  "text_len": 24
 }
]
