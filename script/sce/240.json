  "status": "todo",
  "style": 0,
  "text_off": 4834,
  "text_len": 15
 },
 {
  "id": "sce240:01300",
  "jp": "オーレリィ「やっぱりねぇ。{nl}　そうだろうと思ってたよ、うんうん」",
