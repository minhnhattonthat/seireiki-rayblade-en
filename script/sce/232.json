  "text_len": 51
 },
 {
  "id": "sce232:00646",
  "jp": "オーレリィ「‥‥別にいいけど、どうして？」",
  "off": 1606,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1608,
  "text_len": 26
 },
 {
  "id": "sce232:00666",
  "jp": "トウヤ「う～ん、俺の気のせいかもしれねぇけど、{nl}　悲しそうな顔もしてたからな」",
