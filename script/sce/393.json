  "status": "todo",
  "style": 0,
  "text_off": 1260,
  "text_len": 24
 },
 {
  "id": "sce393:00508",
  "jp": "トウヤ「よくやるよな‥‥それにあのガリュードって人、{nl}　軽く“いなしてる”って感じだな」",
  "off": 1288,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1290,
  "text_len": 52
 },
 {
  "id": "sce393:00542",
