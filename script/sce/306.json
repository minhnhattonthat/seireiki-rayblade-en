  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4959,
  "text_len": 9
 },
 {
  "id": "sce306:0137E",
  "jp": "セリカ「暇なんでしょ？」",
  "off": 4990,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4992,
  "text_len": 14
 },
 {
  "id": "sce306:01392",
  "jp": "トウヤ「それほどまでに暇じゃねぇよ。それじゃあな！」",
  "off": 5010,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5012,
  "text_len": 28
 },
 {
  "id": "sce306:013B8",
  "jp": "セリカ「あっ‥‥」",
  "off": 5048,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5050,
  "text_len": 11
 },
 {
  "id": "sce306:013D1",
  "jp": "セリカ「新しい出会いをもとめて放浪中とか？」",
  "off": 5073,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5075,
  "text_len": 29
 },
 {
  "id": "sce306:013F4",
  "jp": "トウヤ「んなわけねぇーだろ」",
  "off": 5108,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5110,
  "text_len": 15
 },
 {
  "id": "sce306:01414",
  "jp": "セリカ「そうよね。トウヤって、どっちかというと自分から{nl}　積極的に恋を求める感じじゃないものね」",
  "off": 5140,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5142,
  "text_len": 56
 },
 {
  "id": "sce306:01452",
  "jp": "トウヤ「じゃ、どう見えるんだ？」",
  "off": 5202,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5204,
  "text_len": 18
 },
 {
  "id": "sce306:0146E",
  "jp": "セリカ「う～ん、自分では特に気してない行動が{nl}　相手の心を動かして、いつのまにかうまくいく、{nl}{ctl:783E}{face:041C05}　かな？」",
  "off": 5230,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5232,
  "text_len": 72
 },
 {
  "id": "sce306:014BC",
  "jp": "トウヤ「そんなに都合のいいことあるかよ」",
  "off": 5308,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5310,
  "text_len": 22
 },
 {
  "id": "sce306:014E3",
  "jp": "セリカ「まっ、そのうち分かるわよ。{nl}　さて、それじゃ、私そろそろ行くね」",
  "off": 5347,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
