  "off": 4368,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4370,
  "text_len": 17
 },
 {
  "id": "sce306:01127",
  "jp": "トウヤ「まぁ、あいつはあれで充実してんだろ？{nl}　それより、いくぞ」",
