  "text_len": 7
 },
 {
  "id": "sce306:012E4",
  "jp": "セリカ「ああ、トウヤ。どうしたの？」",
  "off": 4836,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4838,
  "text_len": 19
 },
 {
  "id": "sce306:01303",
  "jp": "トウヤ「ん？　まぁ、別にこれといって用はねぇけど」",
  "off": 4867,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4869,
  "text_len": 28
 },
 {
  "id": "sce306:0132A",
  "jp": "セリカ「ふぅ～ん。それじゃ、私の代わりにこの席を温める{nl}　任務を与えます」",
  "off": 4906,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4908,
  "text_len": 45
 },
 {
  "id": "sce306:0135D",
  "jp": "トウヤ「はぁ？」",
