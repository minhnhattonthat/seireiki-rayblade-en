  "text_len": 93
 },
 {
  "id": "sce306:0087D",
  "jp": "ヤマト「あれ？　エレベーターが動いてる。めずらしいわね。{nl}　誰か乗ってるのかしら？」",
  "off": 2173,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2175,
  "text_len": 49
 },
 {
  "id": "sce306:008B4",
  "jp": "トウヤ「そりゃ、乗るだろ」",
  "off": 2228,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2230,
  "text_len": 14
 },
 {
  "id": "sce306:008C8",
  "jp": "ヤマト「でも、あたしが見るときはいつも止まってるよ。{nl}　しかもちょうどその階に」",
  "off": 2248,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2250,
  "text_len": 43
 },
 {
  "id": "sce306:008F9",
