  "status": "translated",
  "style": 0,
  "text_off": 1944,
  "text_len": 8
 },
 {
  "id": "sce385:007A4",
  "jp": "トウヤ「‥‥その‥‥いい言葉が思い浮かばねぇし、{nl}　お前の本当の辛さがわかるとも言えねぇから、{nl}　軽々しく言えねぇのもわかっている。だが‥‥」",
  "off": 1956,
  "len": 91,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1958,
  "text_len": 88
 },
 {
  "id": "sce385:0080D",
  "jp": "アイ「‥‥」",
  "off": 2061,
  "len": 11,
  "en": "Ai: ...",
  "status": "translated",
  "style": 0,
  "text_off": 2063,
  "text_len": 8
 },
 {
  "id": "sce385:0081B",
  "jp": "トウヤ「だが、月並みな言葉だけどよ‥‥がんばれ。{nl}　お前が悲しんでいたら、あの子は安心して天国へ{nl}　行けねぇんじゃねぇか？」",
  "off": 2075,
  "len": 80,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2077,
  "text_len": 77
 },
 {
  "id": "sce385:00879",
  "jp": "アイ「‥‥え‥‥？」",
  "off": 2169,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2171,
  "text_len": 15
 },
 {
  "id": "sce385:00892",
  "jp": "トウヤ「だってそうだろ？　友達が悲しんでるのに{nl}　それを無視していけるワケねぇよ」",
  "off": 2194,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2196,
  "text_len": 47
 },
 {
  "id": "sce385:008C7",
  "jp": "アイ「‥‥そう、かな‥‥？」",
  "off": 2247,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2249,
  "text_len": 19
 },
 {
  "id": "sce385:008E0",
  "jp": "トウヤ「ああ。だから、ちゃんと送り出してやらねぇとな。{nl}　今はまだ笑ってというのは無理かもしれねぇけど、{nl}　うつむいて、悲しむのはやめたほうがいい」",
  "off": 2272,
  "len": 84,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2274,
  "text_len": 81
 },
 {
  "id": "sce385:0093B",
  "jp": "アイ「トウヤ‥‥」",
  "off": 2363,
  "len": 14,
  "en": "Ai: Touya...",
  "status": "translated",
  "style": 0,
  "text_off": 2365,
  "text_len": 11
 },
 {
  "id": "sce385:0094C",
  "jp": "トウヤ「安心させてやろうぜ。な？」",
  "off": 2380,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2382,
  "text_len": 20
 },
 {
  "id": "sce385:0096A",
  "jp": "アイ「‥‥うん」",
  "off": 2410,
  "len": 13,
  "en": "Ai: ...Okay.",
  "status": "translated",
  "style": 0,
  "text_off": 2412,
  "text_len": 10
 },
 {
  "id": "sce385:0097A",
  "jp": "トウヤ「それに‥‥そういうしおらしいのは似合わねぇよ」",
  "off": 2426,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2428,
  "text_len": 31
 },
 {
  "id": "sce385:009A7",
  "jp": "アイ「なによぉ‥‥」",
  "off": 2471,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2473,
  "text_len": 12
 },
 {
  "id": "sce385:009B9",
  "jp": "トウヤ「そうそう。そのほうがお前らしい」",
  "off": 2489,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2491,
  "text_len": 21
 },
 {
  "id": "sce385:009F0",
  "jp": "アイ「‥‥でも、ありがとね、励ましてくれて」",
  "off": 2544,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2546,
  "text_len": 25
 },
 {
  "id": "sce385:00A0F",
  "jp": "トウヤ「いや。俺も大切な人を亡くす気持ち、{nl}　わかるから‥‥」",
  "off": 2575,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2577,
  "text_len": 40
 },
 {
  "id": "sce385:00A4F",
  "jp": "アイ「トウヤ‥‥」",
  "off": 2639,
  "len": 14,
  "en": "Ai: Touya...",
  "status": "translated",
  "style": 0,
  "text_off": 2641,
  "text_len": 11
 },
 {
  "id": "sce385:00A60",
  "jp": "トウヤ「あっ、いや、すまねぇ。{nl}　とにかく、がんばれ。言いたかったのはそれだけだ」",
  "off": 2656,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2658,
  "text_len": 42
 },
 {
  "id": "sce385:00AA2",
  "jp": "アイ「う、うん‥‥そうだね。がんばってみる」",
  "off": 2722,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2724,
