  "style": 0,
  "text_off": 507,
  "text_len": 13
 },
 {
  "id": "sce144:0020C",
  "jp": "セリカ「だからって、ユミールがユミールじゃなくなる{nl}　わけじゃないでしょ？　今までどおりだよね？」",
  "off": 524,
  "len": 57,
