[
 {
  "id": "sce376:00036",
  "jp": "シャール「まずは御帰還、お慶び申し上げます、博士」",
  "off": 54,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 56,
  "text_len": 34
 },
 {
  "id": "sce376:0005E",
  "jp": "デビッシュ「ああ。109年後のこの日、{nl}　再び我等が一同に会することができた。{nl}　これこそ天佑というべきだろうな」",
  "off": 94,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 96,
  "text_len": 68
 },
 {
  "id": "sce376:000A8",
  "jp": "ライル「人数は足りませんけどね」",
  "off": 168,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 170,
  "text_len": 19
 },
 {
  "id": "sce376:000C1",
  "jp": "シャール「ライル！」",
  "off": 193,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 195,
  "text_len": 12
 },
 {
  "id": "sce376:000D3",
  "jp": "デビッシュ「いや、いい。‥‥ライル。{nl}　ウェニマスのことは私も残念に思っている。{nl}　彼女の才能はなにものにも代えがたいものだった。{nl}　だが、我々にはこの世界のためにも成さねばならぬことが{nl}　ある。そのためにはこれ以上欠けることは許されん。{nl}　君の協力が必要なのだ」",
  "off": 211,
  "len": 159,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 213,
  "text_len": 156
 },
 {
  "id": "sce376:00175",
  "jp": "ライル「そんなことわかっていますよ。{nl}　だからここにいるんです」",
  "off": 373,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 375,
  "text_len": 32
 },
 {
  "id": "sce376:0019B",
  "jp": "デビッシュ「結構。それを聞いて安心したよ」",
  "off": 411,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 413,
  "text_len": 26
 },
 {
  "id": "sce376:001BB",
  "jp": "ベルンスト「失礼します。遅れて申し訳ありません」",
  "off": 443,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 445,
  "text_len": 29
 },
 {
  "id": "sce376:001DE",
  "jp": "？？？？「‥‥お、お父‥‥あっ、いや、博士‥‥{nl}　おかえりなさい‥‥」",
  "off": 478,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 480,
  "text_len": 50
 },
 {
  "id": "sce376:00216",
  "jp": "デビッシュ「ベルンストか‥‥少しふけたか」",
  "off": 534,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 536,
  "text_len": 24
 },
 {
  "id": "sce376:00234",
  "jp": "？？？？「‥‥」",
  "off": 564,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 566,
  "text_len": 14
 },
 {
  "id": "sce376:00248",
  "jp": "ベルンスト「これは御挨拶ですね‥‥{nl}　まぁ、ですが、その分、色々考える時間が持てましたよ」",
  "off": 584,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 586,
  "text_len": 56
 },
 {
  "id": "sce376:0028A",
  "jp": "デビッシュ「‥‥ほぅ。それは楽しみだな」",
  "off": 650,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 652,
  "text_len": 23
 },
 {
  "id": "sce376:002A7",
  "jp": "ベルンスト「いえいえ。{nl}　博士にお話しするほどのことではありません」",
  "off": 679,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 681,
  "text_len": 37
 },
 {
  "id": "sce376:002E4",
  "jp": "デビッシュ「‥‥まぁ、いい」",
  "off": 740,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 742,
  "text_len": 16
 },
 {
  "id": "sce376:002FA",
  "jp": "？？？？「あ、あの‥‥」",
  "off": 762,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 764,
  "text_len": 18
 },
 {
  "id": "sce376:00312",
  "jp": "シャール「レオーネ、今は‥‥」",
  "off": 786,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 788,
  "text_len": 20
 },
 {
  "id": "sce376:0032C",
  "jp": "デビッシュ「‥‥なんだ？」",
  "off": 812,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 814,
  "text_len": 16
 },
 {
  "id": "sce376:00342",
  "jp": "レオーネ「‥‥あの、ボク‥‥」",
  "off": 834,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 836,
  "text_len": 20
 },
 {
  "id": "sce376:0035C",
  "jp": "デビッシュ「‥‥」",
  "off": 860,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 862,
  "text_len": 11
 },
 {
  "id": "sce376:0036D",
  "jp": "レオーネ「‥‥ご、ごめんなさい‥‥なんでもありません‥‥」",
  "off": 877,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 879,
  "text_len": 36
 },
 {
  "id": "sce376:00397",
  "jp": "デビッシュ「‥‥お前はここにいることよりも他に{nl}　すべきことがあるだろう」",
  "off": 919,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 921,
  "text_len": 41
 },
 {
  "id": "sce376:003C6",
  "jp": "レオーネ「は、はい‥‥失礼します‥‥」",
  "off": 966,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 968,
  "text_len": 26
 },
 {
  "id": "sce376:003EF",
  "jp": "デビッシュ「‥‥ベルンスト、{nl}　お前の自信作は相変わらずだな」",
  "off": 1007,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1009,
  "text_len": 39
 },
 {
  "id": "sce376:0041C",
  "jp": "ベルンスト「まだ調整が必要だった彼女を{nl}　“出した”のは、あなただったと記憶しておりますが？」",
  "off": 1052,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1054,
  "text_len": 59
 },
 {
  "id": "sce376:0045D",
  "jp": "デビッシュ「私は人間を望んでいたのではない、{nl}　道具をつくれと命じたはずだ。{nl}　それを感情など余計なものを‥‥」",
  "off": 1117,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1119,
  "text_len": 69
 },
 {
  "id": "sce376:004A8",
  "jp": "ベルンスト「余計、ですか‥‥{nl}　以後、気をつけるとしますよ」",
  "off": 1192,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1194,
  "text_len": 37
 },
 {
  "id": "sce376:004D3",
  "jp": "デビッシュ「‥‥ゼルバリオシステムのほうは{nl}　どうなっている？」",
  "off": 1235,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1237,
  "text_len": 35
 },
 {
  "id": "sce376:004FC",
  "jp": "ベルンスト「あれを使うのですか？」",
  "off": 1276,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1278,
  "text_len": 19
 },
 {
  "id": "sce376:00515",
  "jp": "デビッシュ「私は意見を求めているのではない。{nl}　報告を求めているのだ」",
  "off": 1301,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1303,
  "text_len": 42
 },
 {
  "id": "sce376:00545",
  "jp": "シャール「それならばすでに用意はできています」",
  "off": 1349,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1351,
  "text_len": 26
 },
 {
  "id": "sce376:00565",
  "jp": "デビッシュ「エレアナへの取り付けを頼む。{nl}　アレの目、気にいらぬ」",
  "off": 1381,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1383,
  "text_len": 38
 },
 {
  "id": "sce376:00591",
  "jp": "シャール「わかりました」",
  "off": 1425,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1427,
  "text_len": 13
 },
 {
  "id": "sce376:005A4",
  "jp": "ベルンスト「しかし精神的な負荷に耐えれるかどうか{nl}　まだ保証できませんよ」",
  "off": 1444,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1446,
  "text_len": 45
 },
 {
  "id": "sce376:005D7",
  "jp": "デビッシュ「かまわぬ。壊れればまた君に頼むよ」",
  "off": 1495,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1497,
  "text_len": 26
 },
 {
  "id": "sce376:005F7",
  "jp": "ベルンスト「それはかまいませんが‥‥」",
  "off": 1527,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1529,
  "text_len": 21
 },
 {
  "id": "sce376:00612",
  "jp": "デビッシュ「返事はどうした？」",
  "off": 1554,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1556,
  "text_len": 18
 },
 {
  "id": "sce376:0062A",
  "jp": "ベルスト「‥‥かしこまりました」",
  "off": 1578,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1580,
  "text_len": 18
 },
 {
  "id": "sce376:00642",
  "jp": "シャール「‥‥博士、今後のことなのですが‥‥」",
  "off": 1602,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1604,
  "text_len": 32
 },
 {
  "id": "sce376:00668",
  "jp": "デビッシュ「‥‥うむ。すぐに“発動”にかかっても{nl}　よいのだが、今度はこの前のように失敗は許されん。{nl}　もう少し時が満ちるのを待つとしよう」",
  "off": 1640,
  "len": 89,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1642,
  "text_len": 86
 },
 {
  "id": "sce376:006C4",
  "jp": "ベルンスト「ライブレード、ですか？」",
  "off": 1732,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1734,
  "text_len": 20
 },
 {
  "id": "sce376:006DE",
  "jp": "デビッシュ「そうだ。たしかにあのトウヤという少年と{nl}　ライブレードの同調には目をみはるものがある。{nl}　だが、十分であるとは言いがたい」",
  "off": 1758,
  "len": 79,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1760,
  "text_len": 76
 },
 {
  "id": "sce376:00730",
  "jp": "ベルンスト「それに我々に協力するとは思えませんしね」",
  "off": 1840,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1842,
  "text_len": 30
 },
 {
  "id": "sce376:00754",
  "jp": "ライル「奴の意志など関係ない。{nl}　協力しねぇなら、そういう状況へ追い込み{nl}　こっちが利用すればいいじゃねぇか」",
  "off": 1876,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1878,
  "text_len": 68
 },
 {
  "id": "sce376:0079E",
  "jp": "デビッシュ「ライルの言う通りだな。{nl}　私のゴーデリウスがリードすればおそらくは問題ない。{nl}　だが、それはもう少し先だ。{nl}　その時まで、愚かな人類に刹那の享楽に{nl}　身を委ねる時間を与えよう‥‥」",
  "off": 1950,
  "len": 123,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1952,
  "text_len": 120
 },
 {
  "id": "sce376:0081C",
  "jp": "ベルンスト「ですが、我々もその人類であることには{nl}　変りませんよ」",
  "off": 2076,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2078,
  "text_len": 37
 },
 {
  "id": "sce376:00847",
  "jp": "デビッシュ「その通り。だが、我々は{nl}　ただ与えられたものを享受するしか能のない{nl}　愚か者達とは違う。{nl}　そして“個”という呪縛から人々を解放する{nl}　“力”を持っている」",
  "off": 2119,
  "len": 109,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2121,
  "text_len": 106
 },
 {
  "id": "sce376:008B7",
  "jp": "ベルンスト「‥‥個というものがあるから{nl}　他者より劣ることを怖れ、自分より優れているものを{nl}　憎むようになる。ですか」",
  "off": 2231,
  "len": 73,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2233,
  "text_len": 70
 },
 {
  "id": "sce376:00903",
  "jp": "デビッシュ「人が個というものを持ちつづけている限り{nl}　それは未来永劫続く不変の事実だよ」",
  "off": 2307,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2309,
  "text_len": 57
 },
 {
  "id": "sce376:00942",
  "jp": "ベルンスト「相変わらずですね、デビッシュ博士」",
  "off": 2370,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2372,
  "text_len": 27
 },
 {
  "id": "sce376:00963",
  "jp": "デビッシュ「安心したかね？」",
  "off": 2403,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2405,
  "text_len": 17
 },
 {
  "id": "sce376:0097A",
  "jp": "ベルンスト「‥‥ええ。とても」",
  "off": 2426,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2428,
  "text_len": 17
 },
 {
  "id": "sce376:00991",
  "jp": "シャール「‥‥ベルンスト、今は問答をしている場合では{nl}　ありません。発動の準備はすすめるとしても、{nl}　我々には座して待つ時間はないのです。{nl}　博士。いま一度こちらから出向くことを提案します」",
  "off": 2449,
  "len": 123,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2451,
  "text_len": 120
 },
 {
  "id": "sce376:00A0F",
  "jp": "ベルンスト「それは同感ですね。{nl}　私としては、彼の成長には目をみはるものがあり、{nl}　すでに発動を促せる段階にまで来ています。{nl}　そこで、彼を誘き寄せるために人質をとることを{nl}　提案いたします」",
  "off": 2575,
  "len": 119,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2577,
  "text_len": 116
 },
 {
  "id": "sce376:00A89",
  "jp": "ライル「人質？　また姑息な手段を‥‥{nl}　だが、そいつは誰なんだ？」",
  "off": 2697,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2699,
  "text_len": 44
 },
 {
  "id": "sce376:00ABB",
  "jp": "ベルンスト「ユミール・エアル・クラシオ」",
  "off": 2747,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2749,
  "text_len": 21
 },
 {
  "id": "sce376:00AD6",
  "jp": "シャール「名は聞いたことがありますが‥‥{nl}　本当にその価値があるのですか？」",
  "off": 2774,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2776,
  "text_len": 48
 },
 {
  "id": "sce376:00B0C",
  "jp": "ベルンスト「行動を共にし、そう判断しました。{nl}　彼らは非常に仲間意識が強く、彼を誘き寄せるには{nl}　格好の餌となりますよ」",
  "off": 2828,
  "len": 82,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2830,
  "text_len": 79
 },
 {
  "id": "sce376:00B61",
  "jp": "シャール「‥‥それだけですか？」",
  "off": 2913,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2915,
  "text_len": 20
 },
 {
  "id": "sce376:00B7B",
  "jp": "ベルンスト「ええ。それだけです。{nl}　ライルはどう思いますか？」",
  "off": 2939,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2941,
  "text_len": 33
 },
 {
  "id": "sce376:00BA2",
  "jp": "ライル「はぁ？　なんでオレに訊く？{nl}　まぁ、どっちにしろ、オレはそういうのはパスだ。{nl}　好きにすりゃいいだろ？」",
  "off": 2978,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2980,
  "text_len": 61
 },
 {
  "id": "sce376:00BE5",
  "jp": "シャール「‥‥博士はどう思われますか？」",
  "off": 3045,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3047,
  "text_len": 27
 },
 {
  "id": "sce376:00C06",
  "jp": "デビッシュ「‥‥任せる」",
  "off": 3078,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3080,
  "text_len": 15
 },
 {
  "id": "sce376:00C1B",
  "jp": "ベルンスト「では、早速‥‥」",
  "off": 3099,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3101,
  "text_len": 18
 },
 {
  "id": "sce376:00C33",
  "jp": "シャール「私も同行しましょう」",
  "off": 3123,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3125,
  "text_len": 19
 },
 {
