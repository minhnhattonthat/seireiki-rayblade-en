  "len": 63,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9119,
  "text_len": 60
 },
 {
  "id": "sce048:023DF",
  "jp": "ティックス「姉さん‥‥僕‥‥」",
