  "off": 3115,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3117,
  "text_len": 18
 },
 {
  "id": "sce048:00C55",
  "jp": "クルル「あっ、お母さん！　どうしたの？{nl}　今日は遅くなるって‥‥」",
  "off": 3157,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3159,
  "text_len": 41
 },
 {
  "id": "sce048:00C84",
