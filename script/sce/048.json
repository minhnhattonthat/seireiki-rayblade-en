  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9369,
  "text_len": 49
 },
 {
  "id": "sce048:024CE",
  "jp": "ティックス「ふふふふ‥‥ありがとう‥‥姉さん‥‥」",
  "off": 9422,
