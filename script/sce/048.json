  "id": "sce048:00CC0",
  "jp": "クルル「この村を取材しに来たんだって。{nl}　えっと‥‥あれ？　そういえば名前まだ知らなかった」",
  "off": 3264,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3266,
  "text_len": 56
 },
