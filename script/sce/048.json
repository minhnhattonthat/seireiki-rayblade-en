  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9185,
  "text_len": 21
 },
 {
  "id": "sce048:023FA",
  "jp": "セリカ「ここにいるみんなはあなたを助けるために{nl}　来てくれたのよ。あなたは一人じゃない」",
  "off": 9210,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9212,
  "text_len": 48
 },
 {
  "id": "sce048:02430",
  "jp": "ティックス「姉さん‥‥」",
  "off": 9264,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 9266,
  "text_len": 15
 },
