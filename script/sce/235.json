 {
  "id": "sce235:0147B",
  "jp": "トウヤ「‥‥ふぅふぅ‥‥へっ」",
  "off": 5243,
  "len": 22,
  "en": "Touya: ...*huff huff*... Heh.",
  "status": "translated",
  "style": 0,
  "text_off": 5245,
  "text_len": 19
 },
 {
  "id": "sce235:01499",
  "jp": "ヤマト「すごい、すごい！」",
  "off": 5273,
  "len": 17,
  "en": "Yamato: Amazing, amazing!",
  "status": "translated",
  "style": 0,
  "text_off": 5275,
  "text_len": 14
 },
 {
  "id": "sce235:014B3",
  "jp": "メリッサ「トウヤって、天賦の才があるみたいね」",
  "off": 5299,
  "len": 29,
  "en": "Melissa: Touya, you seem to have a natural gift.",
  "status": "translated",
  "style": 0,
  "text_off": 5301,
  "text_len": 26
 },
 {
  "id": "sce235:014D3",
  "jp": "シィウチェン「ふぅふぅ‥‥やるな‥‥{nl}　トウヤ、お前が本気で修行すれば老師ともいい勝負を{nl}　するようになるのかもしれんな‥‥」",
  "off": 5331,
  "len": 81,
  "en": "Xiujian: *huff huff*... Not bad... Touya, if you trained seriously, you might even give my master a good fight...",
  "status": "translated",
  "style": 0,
  "text_off": 5333,
  "text_len": 78
 },
 {
  "id": "sce235:01527",
  "jp": "トウヤ「褒めてもなにも出ないぜ？」",
  "off": 5415,
  "len": 23,
  "en": "Touya: Flattery won't get you anything, y'know?",
  "status": "translated",
  "style": 0,
  "text_off": 5417,
  "text_len": 20
 },
 {
  "id": "sce235:01541",
  "jp": "シィウチェン「‥‥つまらん世辞は言わん」",
  "off": 5441,
  "len": 28,
  "en": "Xiujian: ...I don't deal in empty compliments.",
  "status": "translated",
  "style": 0,
  "text_off": 5443,
  "text_len": 25
 },
 {
  "id": "sce235:01560",
  "jp": "トウヤ「そうだったな。その言葉、素直に受け取っとくよ」",
  "off": 5472,
  "len": 36,
  "en": "Touya: Right, you don't. I'll take those words at face value, then.",
  "status": "translated",
  "style": 0,
  "text_off": 5474,
  "text_len": 33
 },
 {
  "id": "sce235:01587",
  "jp": "シィウチェン「ああ。また気が向いたら相手を{nl}　務めさせてもらおう」",
  "off": 5511,
  "len": 41,
  "en": "Xiujian: Yes. Whenever you feel like it, I'll be your sparring partner again.",
  "status": "translated",
  "style": 0,
  "text_off": 5513,
  "text_len": 38
 },
 {
  "id": "sce235:015B3",
  "jp": "トウヤ「ああ、よろしくな、先生」",
  "off": 5555,
  "len": 21,
  "en": "Touya: Yeah, I'm counting on you, Sensei.",
  "status": "translated",
  "style": 0,
  "text_off": 5557,
  "text_len": 18
 },
