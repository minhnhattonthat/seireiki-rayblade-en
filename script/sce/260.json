 },
 {
  "id": "sce260:00B12",
  "jp": "トウヤ「‥‥お前、いっぺんガボンに診てもらえ」",
  "off": 2834,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2836,
  "text_len": 27
 },
 {
  "id": "sce260:00B33",
  "jp": "フェイン「なにを！　俺はいたって健康そのもの！{nl}　病気になるほど軟弱にはできていない！{nl}　だっはっはっはっ！」",
  "off": 2867,
