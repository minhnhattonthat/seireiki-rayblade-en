  "style": 0,
  "text_off": 2668,
  "text_len": 10
 },
 {
  "id": "sce370:00A7A",
  "jp": "ユミール「グラードさん、お休みになっていたほうが‥‥」",
  "off": 2682,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2684,
  "text_len": 32
 },
 {
  "id": "sce370:00AA0",
