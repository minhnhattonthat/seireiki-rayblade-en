  "style": 0,
  "text_off": 2243,
  "text_len": 10
 },
 {
  "id": "sce370:008DA",
  "jp": "ホーレム「ん？　鈴？　ほぅ、なかなか雅なものを‥‥{nl}　今のあなたには必要のないものかもしれませんが、{nl}　返しておきましょう」",
  "off": 2266,
  "len": 76,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2268,
  "text_len": 73
 },
 {
  "id": "sce370:00929",
  "jp": "タイロン「‥‥」",
  "off": 2345,
