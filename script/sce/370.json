  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1531,
  "text_len": 10
 },
 {
  "id": "sce370:00609",
  "jp": "ホーレム「そう。たとえば君がジグリムの裏にいる{nl}　＜ゼ＝オード＞の正体を探ろうとしている、とかね」",
  "off": 1545,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1547,
  "text_len": 59
 },
 {
  "id": "sce370:0064A",
