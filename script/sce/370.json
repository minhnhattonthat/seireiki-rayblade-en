  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2582,
  "text_len": 46
 },
 {
  "id": "sce370:00A48",
  "jp": "グラード「ああ、わかっている。{nl}　‥‥ありがとう」",
  "off": 2632,
  "len": 31,
