  "len": 101,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1349,
  "text_len": 98
 },
 {
  "id": "sce370:005AB",
  "jp": "タイロン「あ、あなたは‥‥」",
  "off": 1451,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1453,
  "text_len": 16
 },
 {
  "id": "sce370:005C1",
  "jp": "ホーレム「ただの公僕ですよ。{nl}　少しだけ、人とは違う“力”をもっているだけですよ」",
