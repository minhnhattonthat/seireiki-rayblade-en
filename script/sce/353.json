  "len": 38,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2334,
  "text_len": 33
 },
 {
  "id": "sce353:00940",
  "jp": "アイ「まぁ、ここまでそれでうまくやってきたし、{nl}　最後もビシッとキメますか」",
  "off": 2368,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2372,
  "text_len": 40
 },
 {
  "id": "sce353:0096D",
