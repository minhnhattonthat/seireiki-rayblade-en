  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1909,
  "text_len": 15
 },
 {
  "id": "sce015:0078C",
  "jp": "メリッサ「え⁉　あ、すみません‥‥なんでもありません‥‥」",
  "off": 1932,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1934,
  "text_len": 34
 },
 {
  "id": "sce015:007B4",
  "jp": "ベイオ「そうか。ま、まぁ、元気なようでよかった、よかった」",
  "off": 1972,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1974,
  "text_len": 31
 },
 {
  "id": "sce015:007D9",
  "jp": "メリッサ「うふふふふふ‥‥ありがとうございます」",
  "off": 2009,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2011,
  "text_len": 26
 },
 {
  "id": "sce015:007F9",
  "jp": "ベイオ「な、なにを、あ、あああらたまって‥‥」",
  "off": 2041,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2043,
  "text_len": 25
 },
 {
  "id": "sce015:00818",
  "jp": "メリッサ「ふふふふふふ」",
  "off": 2072,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2074,
  "text_len": 12
 },
 {
  "id": "sce015:0082A",
  "jp": "ベイオ「げ、元気になったらまたテスト開始じゃ！{nl}　か、覚悟するのじゃぞ！{nl}　ワシはバイン・ダーガを、調整してくる！」",
  "off": 2090,
