  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3262,
  "text_len": 10
 },
 {
  "id": "sce015:00CCC",
  "jp": "ホーレム「ええ。ぜひ、お願いします」",
