[
 {
  "id": "sce015:00030",
  "jp": "ベイオ「ふぅ‥‥まったく！　たかが無断#66C出撃ごときで{nl}　貰くじらをたておって‥‥。バイン・ダーガの性能が{nl}　証明されればジグリムのためになるというものを‥‥{nl}　まぁいい。吠えたてたところで、{nl}　このワシの邪魔は誰もできんわ！」",
  "off": 48,
  "len": 137,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 50,
  "text_len": 134
 },
 {
