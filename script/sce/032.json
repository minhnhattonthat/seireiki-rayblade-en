  "style": 1,
  "text_off": 3226,
  "text_len": 20
 },
 {
  "id": "sce032:00CAF",
  "jp": "シュテイニーズ「クククク‥‥誰だか知らねぇが‥‥{nl}　もう遅いんだよォォォ！」",
