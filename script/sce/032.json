  "len": 44,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12345,
  "text_len": 39
 },
 {
  "id": "sce032:03061",
  "jp": "<E1>ァレス「個人通信をしていたはずだが‥‥{nl}　その機体、そこまでの機能があるのか‥‥」",
  "off": 12385,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12389,
  "text_len": 54
 },
 {
  "id": "sce032:030A1",
  "jp": "シュテイニーズ「そんなことはどうでもいいじゃねぇか。{nl}　もうすぐ、みんな死ぬんだからよぉぉ！　ケケケケ‥‥」",
  "off": 12449,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12453,
  "text_len": 59
 },
