[
 {
  "id": "sce032:003C2",
  "jp": "ヤマト「ちょっと、トウヤ。わかってるとは思うけど、{nl}　あまり安易にプラーニャの補給を考えてたらダメよ」",
  "off": 962,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 967,
  "text_len": 58
 },
 {
  "id": "sce032:00402",
  "jp": "トウヤ「補給？　あ、ああ‥‥わかってる」",
  "off": 1026,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1030,
  "text_len": 25
 },
 {
  "id": "sce032:00420",
  "jp": "ヤマト「本当？　おんニャの子の唇はそんニャに{nl}　安いものじゃニャいんだからね」",
  "off": 1056,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 1061,
  "text_len": 45
 },
 {
  "id": "sce032:00453",
  "jp": "トウヤ「俺だって安易にしたくねぇよ」",
  "off": 1107,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1111,
  "text_len": 21
 },
 {
  "id": "sce032:0046D",
  "jp": "ヤマト「だったらいいけど」",
  "off": 1133,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 1138,
  "text_len": 13
 },
 {
  "id": "sce032:00480",
  "jp": "トウヤ「よし、それじゃ‥‥行くぞ」",
  "off": 1152,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1156,
  "text_len": 20
 },
 {
  "id": "sce032:004AC",
  "jp": "ホーレム「やはりきましたか‥‥ん？{nl}　グロウスター君の機体がみえませんが‥‥」",
  "off": 1196,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1198,
  "text_len": 49
 },
 {
  "id": "sce032:004E3",
  "jp": "シュテイニーズ「どっかでおっちんだんじゃねぇのか？」",
  "off": 1251,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1253,
  "text_len": 28
 },
 {
  "id": "sce032:00505",
  "jp": "ホーレム「それはないでしょう。{nl}　彼はたとえ裸で砂漠へ放置されても{nl}　気合で生還するような人です。{nl}　そう簡単には死にませんよ」",
  "off": 1285,
  "len": 82,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1287,
  "text_len": 79
 },
 {
  "id": "sce032:0055A",
  "jp": "シュテイニーズ「そんなことあったのか？」",
  "off": 1370,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1372,
  "text_len": 22
 },
 {
  "id": "sce032:00576",
  "jp": "ホーレム「昔にちょっとね。{nl}　未だにそれを根にもっているようですが‥‥」",
  "off": 1398,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1400,
  "text_len": 42
 },
 {
  "id": "sce032:005A6",
  "jp": "シュテイニーズ「あ、あんた無茶苦茶なことしてんなぁ‥‥{nl}　まぁいい。俺もそろそろ出てくるよ」",
  "off": 1446,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1448,
  "text_len": 55
 },
 {
  "id": "sce032:005E3",
  "jp": "ホーレム「あっ、そうそう。{nl}　例のモノですが、あまり軽く使わないでくださいね。{nl}　貴讐なモノなんですから」",
  "off": 1507,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1509,
  "text_len": 59
 },
 {
  "id": "sce032:00624",
  "jp": "シュテイニーズ「わかっているよ。{nl}　切り札は最後にとっとくもんだ、クククククク。{nl}　まぁ、あんたはここでゆっくり見物でもしてな」",
  "off": 1572,
  "len": 74,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1574,
  "text_len": 71
 },
 {
  "id": "sce032:0067A",
  "jp": "ホーレム「ふふふふ‥‥馬鹿な奴ほど御しやすい‥‥{nl}　さて、そろそろ脱出の準備でもしますか。{nl}　巻添えを被るのはごめんですからね‥‥」",
  "off": 1658,
  "len": 87,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1660,
  "text_len": 84
 },
 {
  "id": "sce032:00704",
  "jp": "<E1>ェル「なあ、隊長‥‥本当に戦うんですか？」",
  "off": 1796,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1800,
  "text_len": 30
 },
 {
  "id": "sce032:00727",
  "jp": "<E1>ァレス「‥‥契約だからな」",
  "off": 1831,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1835,
  "text_len": 18
 },
 {
  "id": "sce032:0073E",
  "jp": "ジョノ「らしく、ないですね」",
  "off": 1854,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1858,
  "text_len": 14
 },
 {
  "id": "sce032:00751",
  "jp": "<E1>ァレス「非情な傭兵断。{nl}　金さえ積まれればどこにでもつく最低の存在‥‥{nl}　なんといわれてもよかった。{nl}　だが、私は守るべき者から逃げ、そして今、{nl}　また逃げようとしている‥‥」",
  "off": 1873,
  "len": 115,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1877,
  "text_len": 110
 },
 {
  "id": "sce032:007C4",
  "jp": "<E1>ェル「‥‥娘さんたちのことですか‥‥{nl}　でもまだ死んだと決まったワケではないですぜ」",
  "off": 1988,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1992,
  "text_len": 50
 },
 {
  "id": "sce032:007FB",
  "jp": "ジョノ「店は倒壊していただけで、{nl}　まだ死亡の確認はされていません」",
  "off": 2043,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2047,
  "text_len": 41
 },
 {
  "id": "sce032:00829",
  "jp": "<E1>ァレス「いいんだ。たとえ生きていたとしても{nl}　あの子たちにとって私はすでに父親ではない」",
  "off": 2089,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2093,
  "text_len": 50
 },
 {
  "id": "sce032:00860",
  "jp": "ジョノ「隊長‥‥」",
  "off": 2144,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2148,
  "text_len": 13
 },
 {
  "id": "sce032:00872",
  "jp": "<E1>ェル「‥‥それは違いますぜ」",
  "off": 2162,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2166,
  "text_len": 18
 },
 {
  "id": "sce032:00889",
  "jp": "<E1>ァレス「‥‥」",
  "off": 2185,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2189,
  "text_len": 10
 },
 {
  "id": "sce032:00898",
  "jp": "<E1>ェル「親にとって子供はいつまでも子供であるように、{nl}　子供にとって親はいつまでたっても親なんです。{nl}　親がその義務を放棄するから子供は迷うんです。{nl}　隊長のおっしゃっているのは単なる逃げ口上です。{nl}　自分から親であることをやめてどうすんですか！」",
  "off": 2200,
  "len": 156,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2204,
  "text_len": 151
 },
 {
  "id": "sce032:00934",
  "jp": "ジョノ「おい‥‥」",
  "off": 2356,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2360,
  "text_len": 11
 },
 {
  "id": "sce032:00944",
  "jp": "<E1>ァレス「いや、<E1>ェルのいうとおりだ‥‥{nl}　私は逃げていたのかも知れないな。{nl}　だが、もう遅い。なにもかも、な」",
  "off": 2372,
  "len": 67,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2376,
  "text_len": 62
 },
 {
  "id": "sce032:00987",
  "jp": "<E1>ェル「隊長‥‥」",
  "off": 2439,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2443,
  "text_len": 13
 },
 {
  "id": "sce032:00999",
  "jp": "<E1>ァレス「今回の契約は＜孤高の銀翼＞ではなく、{nl}　私個人との契約だ。{nl}　お前達が私に付き合う必要はない」",
  "off": 2457,
  "len": 79,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2461,
  "text_len": 74
 },
 {
  "id": "sce032:009E8",
  "jp": "ジョノ「隊長‥‥水臭いことをいわないでください。{nl}　我々もお供します」",
  "off": 2536,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2540,
  "text_len": 43
 },
 {
  "id": "sce032:00A18",
  "jp": "<E1>ェル「‥‥おいしいところを独り占めするなんて{nl}　ずるいですぜ。隊長の最後の舞台#944、{nl}　見逃す手はありませんよ」",
  "off": 2584,
  "len": 73,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2588,
  "text_len": 68
 },
 {
  "id": "sce032:00A61",
  "jp": "<E1>ァレス「ふっ‥‥見物料は高いぞ」",
  "off": 2657,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2661,
  "text_len": 23
 },
 {
  "id": "sce032:00A7D",
  "jp": "<E1>ェル「へっ」",
  "off": 2685,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2689,
  "text_len": 7
 },
 {
  "id": "sce032:00A89",
  "jp": "ジョノ「‥‥もとより承知」",
  "off": 2697,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2701,
  "text_len": 17
 },
 {
  "id": "sce032:00A9F",
  "jp": "<E1>ァレス「‥‥よし、行くぞ！」",
  "off": 2719,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2723,
  "text_len": 19
 },
 {
  "id": "sce032:00ADB",
  "jp": "トウヤ「くっ！　間に合わなかったか！」",
  "off": 2779,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2783,
  "text_len": 23
 },
 {
  "id": "sce032:00B17",
  "jp": "セリカ「うそ‥‥エイディオン⁈　どういうこと⁉{nl}　あれは完全に死んでいたはずなのに‥‥{nl}　なんで動いてるの⁈」",
  "off": 2839,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2843,
  "text_len": 66
 },
 {
  "id": "sce032:00B63",
  "jp": "？？？？？「君にここで彼らと心中してもらうわけには{nl}　いかないんだ。悪いけど、こっちに来てもらうよ‥‥」",
  "off": 2915,
  "len": 70,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2919,
  "text_len": 65
 },
 {
