  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3140,
  "text_len": 12
 },
 {
  "id": "sce032:00C51",
  "jp": "<E1>ァルガ「こっちも完了じゃ！　リシュナ！」",
  "off": 3153,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3157,
  "text_len": 25
 },
 {
