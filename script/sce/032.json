  "len": 19,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 11232,
  "text_len": 14
 },
 {
  "id": "sce032:02BF2",
  "jp": "ロザリー「ちょっとトウヤ！　しっかり見ときなさいよね！」",
  "off": 11250,
  "len": 35,
  "en": "",
