  "status": "todo",
  "style": 1,
  "text_off": 12609,
  "text_len": 18
 },
 {
  "id": "sce032:03154",
  "jp": "シュテイニズ「こっちの性能はわかってるだろ、ええっ？{nl}　おとなしく倒されるしかねぇよなァ！」",
