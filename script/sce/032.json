  "len": 15,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12121,
  "text_len": 10
 },
 {
  "id": "sce032:02F64",
  "jp": "ゲン「父ちゃんなんだろ⁈{nl}　オイラの背中の傷のこと知ってるのって‥‥」",
  "off": 12132,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12136,
  "text_len": 43
 },
 {
  "id": "sce032:02F94",
  "jp": "<E1>ァレス「お前の父は‥‥{nl}　ガイザルディングテリウス・ジン・メルセーヌは死んだ」",
  "off": 12180,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12184,
  "text_len": 46
 },
 {
  "id": "sce032:02FC7",
  "jp": "ゲン「なに言ってんだよ！　父ちゃんなんだろ⁉」",
  "off": 12231,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12235,
  "text_len": 27
 },
 {
  "id": "sce032:02FE7",
  "jp": "シュテイニーズ「隊長さんよぉ‥‥なにうだうだやってんだ？{nl}　オレが手田ってやるよ‥‥」",
  "off": 12263,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12267,
  "text_len": 53
 },
 {
  "id": "sce032:03021",
