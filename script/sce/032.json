  "len": 19,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3052,
  "text_len": 14
 },
 {
  "id": "sce032:00BFB",
  "jp": "？？？？？「ふふふふ‥‥捕#791まえた」",
