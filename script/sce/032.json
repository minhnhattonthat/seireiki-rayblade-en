  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12325,
  "text_len": 15
 },
 {
  "id": "sce032:03035",
  "jp": "シュテイニーズ「‥‥ほぅ‥‥今の話、本当だったのか‥‥」",
