  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5276,
  "text_len": 17
 },
 {
  "id": "sce348:014B1",
  "jp": "ヤマト「ニャに⁈　そのロ#492の聞き方⁉」",
