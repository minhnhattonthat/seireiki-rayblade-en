  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5192,
  "text_len": 32
 },
 {
  "id": "sce348:0146C",
  "jp": "ヤマト「ダメ。今のまんまじゃ恥ずかしくて人様の前に{nl}　出せニャいわ」",
