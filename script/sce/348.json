  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4037,
  "text_len": 37
 },
 {
  "id": "sce348:00FF8",
  "jp": "佳澄美「透夜ちゃん‥‥透夜ちゃん！」",
  "off": 4088,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4090,
  "text_len": 28
 },
 {
  "id": "sce348:0101A",
  "jp": "透夜「佳澄美‥‥俺達、帰って‥‥」",
  "off": 4122,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4124,
  "text_len": 29
 },
 {
  "id": "sce348:0103F",
  "jp": "透夜「うわっ！　か、佳澄美⁈」",
