  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4161,
  "text_len": 22
 },
 {
  "id": "sce348:01077",
  "jp": "佳澄美「透夜ちゃん！　透夜ちゃん！」",
  "off": 4215,
  "len": 30,
