  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4856,
  "text_len": 20
 },
 {
  "id": "sce348:01310",
  "jp": "透夜「だぁーっ！　俺の家で和むなーっ！」",
  "off": 4880,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4882,
  "text_len": 29
 },
 {
  "id": "sce348:01333",
  "jp": "晃一郎「なにぷんぷんしてるんだい？{nl}　カルシウムが足りないんだね。{nl}　現代人は不足がちだっていわれてるしね」",
  "off": 4915,
  "len": 67,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4917,
  "text_len": 64
 },
 {
  "id": "sce348:01379",
  "jp": "佳澄美「まぁまぁ、いいじゃない透夜ちゃん。{nl}　晃一郎君も心配して来てくれてるのよ？{nl}　ホラ座って」",
  "off": 4985,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4987,
  "text_len": 63
 },
 {
  "id": "sce348:013BE",
  "jp": "透夜「あ、ああ‥‥」",
