  "off": 3980,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3982,
  "text_len": 12
 },
 {
  "id": "sce348:00FC3",
  "jp": "晃一郎「あっ、佳澄美ちゃん‥‥今、授業中‥‥」",
