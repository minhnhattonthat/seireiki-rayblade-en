[
 {
  "id": "sce014:0002E",
  "jp": "レビオス「どういうことだ⁈{nl}　なぜ奴等は軍を動かさんのだ⁉」",
  "off": 46,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 48,
  "text_len": 36
 },
 {
  "id": "sce014:00072",
  "jp": "ギール「再Ξの勧告もすべてはぐらかされております。{nl}　選定都市にまで手を回していたとは‥‥」",
  "off": 114,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 116,
  "text_len": 59
 },
 {
  "id": "sce014:000B3",
  "jp": "レビオス「まさか‥‥ジグリムに寝返ったというのか⁈」",
  "off": 179,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 181,
  "text_len": 31
 },
 {
  "id": "sce014:000D8",
  "jp": "ギール「ジグリムの裏工作を甘くみすぎていたのかも{nl}　しれません。このまま援軍が派遣されなければ{nl}　前線が崩壊する可能性もあります」",
  "off": 216,
  "len": 84,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 218,
  "text_len": 81
 },
 {
  "id": "sce014:0012F",
  "jp": "レビオス「‥‥仕方あるまい。{nl}　レンバードンを投入する」",
  "off": 303,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 305,
  "text_len": 35
 },
 {
  "id": "sce014:00158",
  "jp": "ギール「はっ！　二個中隊の派遣準備は{nl}　完了しております」",
  "off": 344,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 346,
  "text_len": 41
 },
 {
  "id": "sce014:00187",
  "jp": "レビオス「‥‥いつもながら手際がよいな」",
  "off": 391,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 393,
  "text_len": 24
 },
 {
  "id": "sce014:001A5",
  "jp": "ギール「はっ‥‥恐れ入ります」",
  "off": 421,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 423,
  "text_len": 20
 },
 {
  "id": "sce014:001BF",
  "jp": "レビオス「‥‥いつから知っていた？」",
  "off": 447,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 449,
  "text_len": 22
 },
 {
  "id": "sce014:001DB",
  "jp": "ギール「‥‥」",
  "off": 475,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 477,
  "text_len": 10
 },
 {
  "id": "sce014:001EB",
  "jp": "レビオス「大佐。君を責めているわけではない。{nl}　我々にはまだ策はある。{nl}　緒戦の敗退などすぐに挽回できよう。{nl}　君がそれを利揖し、密約をかわした選定都市を{nl}　掌握しようとしていることもわかる。{nl}　だが、君は一人で抱えすぎなのだ」",
  "off": 491,
  "len": 144,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 493,
  "text_len": 141
 },
 {
  "id": "sce014:0027E",
  "jp": "ギール「閣下‥‥申し訳ございません。{nl}　閣下に御迷惑をかけまいと‥‥」",
  "off": 638,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 640,
  "text_len": 49
 },
 {
  "id": "sce014:002B5",
  "jp": "レビオス「大佐、私はそれほど頼りない上官か？」",
  "off": 693,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 695,
  "text_len": 30
 },
 {
  "id": "sce014:002D9",
  "jp": "ギール「いえ、そのようなことはけっして‥‥」",
  "off": 729,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 731,
  "text_len": 25
 },
 {
  "id": "sce014:002F8",
  "jp": "レビオス「ならば今後は私にも相談すること。よいな？」",
  "off": 760,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 762,
  "text_len": 32
 },
 {
  "id": "sce014:0031E",
  "jp": "ギール「‥‥はっ」",
  "off": 798,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 800,
  "text_len": 12
 },
 {
  "id": "sce014:00371",
  "jp": "副官「閣下、ライル殿がお見えになりました」",
  "off": 881,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 883,
  "text_len": 27
 },
 {
  "id": "sce014:00398",
  "jp": "ライル「まずは緒戦の勝利、お慶び申し上げます、{nl}　閣下‥‥」",
  "off": 920,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 922,
  "text_len": 41
 },
 {
  "id": "sce014:003C7",
  "jp": "グロウスター「フン‥‥似合わぬことを‥‥」",
  "off": 967,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 969,
  "text_len": 28
 },
 {
  "id": "sce014:003E9",
  "jp": "ライル「まぁ、そう言うなよ。{nl}　本当はうれしいんだろ？」",
  "off": 1001,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1003,
  "text_len": 32
 },
 {
  "id": "sce014:0040F",
  "jp": "グロウスター「当然の結果だ。我がジグリムの栄光は{nl}　今日、この日から田説となるのだ！」",
  "off": 1039,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1041,
  "text_len": 57
 },
 {
  "id": "sce014:0044E",
  "jp": "ライル「‥‥それはよかったな。{nl}　で、この前に頼んでいた件だが‥‥」",
  "off": 1102,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1104,
  "text_len": 41
 },
 {
  "id": "sce014:0047D",
  "jp": "グロウスター「この前？」",
  "off": 1149,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1151,
  "text_len": 15
 },
 {
  "id": "sce014:00492",
  "jp": "副官「リーボーフェンの動向です」",
  "off": 1170,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1172,
  "text_len": 22
 },
 {
  "id": "sce014:004AE",
  "jp": "グロウスター「おお、そうであったな。{nl}　たしかライブレードを使い＜ゼ＝オード＞の一機を{nl}　撃退したらしいな」",
  "off": 1198,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1200,
  "text_len": 65
 },
 {
  "id": "sce014:004F5",
  "jp": "副官「それから現在はこのジグリムへ向かっているという{nl}　報告が入っています。{nl}　どうやら例の傭兵断を追っているようです」",
  "off": 1269,
  "len": 76,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1271,
  "text_len": 73
 },
 {
  "id": "sce014:00544",
  "jp": "グロウスター「あの昼行灯はなにを考えておるのだ？{nl}　聖地なんぞ攻撃すれば世論を敵にまわすことになる。{nl}　しかもあのユミール・エアル・クラシオをさらって‥‥」",
  "off": 1348,
  "len": 97,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1350,
  "text_len": 94
 },
 {
  "id": "sce014:005A8",
  "jp": "ライル「ユミール？　誰だ、そいつは？」",
  "off": 1448,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1450,
  "text_len": 23
 },
 {
  "id": "sce014:005C5",
  "jp": "副官「次期教母と目されている{nl}　聖地の筆頭錬金学止です。{nl}　100年に一人の俊英といわれ、{nl}　聖霊機の行動補正プログラムは{nl}　彼女の手によるものです」",
  "off": 1477,
  "len": 108,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1479,
  "text_len": 105
 },
 {
  "id": "sce014:00634",
  "jp": "ライル「へぇ、この時代にもそういう人間がいるんだな」",
  "off": 1588,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1590,
  "text_len": 30
 },
 {
  "id": "sce014:00658",
  "jp": "副官「時代？」",
  "off": 1624,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1626,
  "text_len": 12
 },
 {
  "id": "sce014:0066A",
  "jp": "ライル「‥‥なんでもねぇよ。{nl}　それより、その女をさらったということは{nl}　対外的にもかなりマズイんじゃねぇのか？」",
  "off": 1642,
  "len": 67,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1644,
  "text_len": 64
 },
 {
  "id": "sce014:006B0",
  "jp": "グロウスター「そんなこと、言われんでもわかっておる。{nl}　だが、現段階ではあの昼行灯の独断#66Cという方向で{nl}　処理できる。責任はすべて奴にかぶってもらう」",
  "off": 1712,
  "len": 94,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1714,
  "text_len": 91
 },
 {
  "id": "sce014:00711",
  "jp": "ライル「容赦なしだな」",
  "off": 1809,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1811,
  "text_len": 13
 },
 {
  "id": "sce014:00724",
  "jp": "グロウスター「奴のことだから、{nl}　なにか手を打ってはおるだろうが、{nl}　どちらにせよワシらの邪魔にはならん。{nl}　いざとなれば奴の取り巻き連中もまとめて{nl}　失脚させてくれるわ！」",
  "off": 1828,
  "len": 104,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1830,
  "text_len": 101
 },
 {
  "id": "sce014:0078F",
  "jp": "ライル「で、リーボーフェンはどうするんだ？」",
  "off": 1935,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1937,
  "text_len": 25
 },
 {
  "id": "sce014:007AE",
  "jp": "グロウスター「奴等に構っているほどヒマではない。{nl}　だが、邪魔をしてくれば話は別だ。{nl}　その時は全力で叩き潰すまでのこと」",
  "off": 1966,
  "len": 77,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1968,
  "text_len": 74
 },
 {
  "id": "sce014:007FE",
  "jp": "ライル「なるほどな。ま、せいぜい頑張ってくれや。{nl}　じゃあな」",
  "off": 2046,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2048,
  "text_len": 33
 },
 {
  "id": "sce014:00830",
  "jp": "副官「閣下。あのライルという男‥‥」",
  "off": 2096,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2098,
  "text_len": 25
 },
 {
  "id": "sce014:0084F",
  "jp": "グロウスター「わかっておる。はじめは名声に飢えた{nl}　錬金学止とばかり思っていたが、もしかすれば‥‥」",
  "off": 2127,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2129,
  "text_len": 61
 },
 {
  "id": "sce014:00892",
  "jp": "副官「これ以上かかわるのは閣下のためにも、{nl}　そしてこのジグリムのためにもならないのではありませんか？」",
  "off": 2194,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2196,
  "text_len": 59
 },
 {
  "id": "sce014:008D3",
  "jp": "グロウスター「ふむ。まさか100年以上も前の人間と{nl}　話していたとはな‥‥」",
  "off": 2259,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2261,
  "text_len": 48
 },
 {
  "id": "sce014:0092B",
  "jp": "ユミール「‥‥」",
  "off": 2347,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2349,
  "text_len": 11
 },
 {
  "id": "sce014:00946",
  "jp": "<E1>ァレス「‥‥手荒く扱ってすまなかったな。{nl}　お前に危害を加えるつもりはない。今から{nl}　その拘束具を取るが、静かにしてくれると助かる」",
  "off": 2374,
  "len": 86,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2376,
  "text_len": 83
 },
 {
  "id": "sce014:009A6",
  "jp": "ユミール「‥‥あ、あなた達はいったい‥‥？」",
  "off": 2470,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2472,
  "text_len": 29
 },
 {
  "id": "sce014:009C9",
  "jp": "<E1>ェル「俺達は＜孤高の銀翼＞って言う{nl}　しがない食い詰め傭兵断さ」",
  "off": 2505,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2507,
  "text_len": 47
 },
 {
  "id": "sce014:009FE",
  "jp": "ジョノ「別に我々は食うことに困ってはいない」",
  "off": 2558,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2560,
  "text_len": 26
 },
 {
  "id": "sce014:00A1E",
  "jp": "<E1>ェル「おいおい、本気にとるなよ。{nl}　冗談に決まってんだろ？　お前、堅すぎるぞ」",
  "off": 2590,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2592,
  "text_len": 48
 },
 {
  "id": "sce014:00A54",
  "jp": "ジョノ「‥‥お前の冗談はつまらん」",
  "off": 2644,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2646,
  "text_len": 22
 },
 {
  "id": "sce014:00A70",
  "jp": "<E1>ェル「へいへい、悪ぅございましたね」",
  "off": 2672,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2674,
  "text_len": 20
 },
 {
  "id": "sce014:00A8A",
  "jp": "ユミール「ふふふふ‥‥」",
  "off": 2698,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2700,
  "text_len": 15
 },
 {
  "id": "sce014:00A9F",
  "jp": "ジョノ「‥‥」",
  "off": 2719,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2721,
  "text_len": 9
 },
 {
  "id": "sce014:00AAE",
  "jp": "ユミール「あっ、ご、ごめんなさい‥‥{nl}　お二人がとても仲良く見えたから‥‥」",
  "off": 2734,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2736,
  "text_len": 48
 },
 {
  "id": "sce014:00AE4",
  "jp": "ジョノ「‥‥そうか」",
  "off": 2788,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2790,
  "text_len": 12
 },
 {
  "id": "sce014:00AF6",
  "jp": "<E1>ァレス「しばらくは空の旅を楽しんでもらうことになる。{nl}　お前が協力してくれるかぎりは危害を加えないと{nl}　約束する」",
  "off": 2806,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2808,
  "text_len": 69
 },
 {
  "id": "sce014:00B41",
  "jp": "ユミール「‥‥わかりました」",
  "off": 2881,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2883,
  "text_len": 17
 },
 {
  "id": "sce014:00B58",
  "jp": "<E1>ァレス「結構」",
  "off": 2904,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2906,
  "text_len": 10
 },
 {
  "id": "sce014:00B68",
  "jp": "<E1>ェル「隊長、世話係は俺に任せてください」",
  "off": 2920,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2922,
  "text_len": 28
 },
 {
  "id": "sce014:00B8A",
  "jp": "ユミール「‥‥」",
  "off": 2954,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2956,
  "text_len": 11
 },
 {
  "id": "sce014:00B9B",
  "jp": "<E1>ァレス「ジョノ、お前に任せる」",
  "off": 2971,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2973,
  "text_len": 18
 },
 {
  "id": "sce014:00BB3",
  "jp": "<E1>ェル「なんでですか！」",
  "off": 2995,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2997,
  "text_len": 13
 },
 {
  "id": "sce014:00BC6",
  "jp": "ジョノ「‥‥了解しました」",
  "off": 3014,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3016,
  "text_len": 17
 },
 {
  "id": "sce014:00BDD",
  "jp": "<E1>ァレス「<E1>ェル、お前は操縦席にいろ」",
  "off": 3037,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3039,
  "text_len": 23
 },
 {
  "id": "sce014:00BFA",
  "jp": "<E1>ェル「へいへい‥‥」",
  "off": 3066,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3068,
  "text_len": 13
 },
 {
  "id": "sce014:00C35",
  "jp": "ユミール「あ、あの‥‥」",
  "off": 3125,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3127,
  "text_len": 15
 },
 {
  "id": "sce014:00C4A",
