  "status": "todo",
  "style": 0,
  "text_off": 1184,
  "text_len": 23
 },
 {
  "id": "sce152:004BB",
  "jp": "アーサー「とりあえずゼウレアーの修理のこともありますし、{nl}　今日のところはこの聖地で待機しましょう」",
  "off": 1211,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1213,
  "text_len": 61
 },
