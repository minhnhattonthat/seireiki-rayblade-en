  "status": "todo",
  "style": 0,
  "text_off": 773,
  "text_len": 26
 },
 {
  "id": "sce152:00323",
  "jp": "イ<E1>ェル「こんなことをしてジグリムにいったい{nl}　どのような利益が‥‥」",
