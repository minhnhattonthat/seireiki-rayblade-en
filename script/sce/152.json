  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2895,
  "text_len": 94
 },
 {
  "id": "sce152:00BB1",
  "jp": "ベルンスト「無能のレッテルを貼られますね。{nl}　あの人はそういうのを一番嫌ってましたから」",
  "off": 2993,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2995,
  "text_len": 51
 },
 {
  "id": "sce152:00BEA",
  "jp": "？？？？「‥‥そういうことです。{nl}　今回は私が直接出向きます。{nl}　あなたは出迎えの準備をお願いします」",
  "off": 3050,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3052,
  "text_len": 69
 },
 {
  "id": "sce152:00C35",
  "jp": "ベルンスト「了解しました。では御健闘を‥‥」",
  "off": 3125,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3127,
  "text_len": 29
 },
 {
  "id": "sce152:00C79",
  "jp": "メル<E1>ィ「ほぇ～」",
  "off": 3193,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3195,
  "text_len": 10
 },
 {
  "id": "sce152:00C89",
  "jp": "トウヤ「‥‥」",
  "off": 3209,
  "len": 12,
  "en": "Touya: ...",
  "status": "translated",
  "style": 0,
  "text_off": 3211,
  "text_len": 9
 },
 {
  "id": "sce152:00C98",
  "jp": "フォルゼン「これはこれは‥‥」",
  "off": 3224,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3226,
  "text_len": 17
 },
 {
  "id": "sce152:00CAF",
  "jp": "レオーネ「‥‥ん？」",
  "off": 3247,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3249,
  "text_len": 14
 },
 {
  "id": "sce152:00CC3",
  "jp": "フォルゼン「すごい食欲ですね」",
  "off": 3267,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3269,
  "text_len": 17
 },
 {
  "id": "sce152:00CDA",
  "jp": "レオーネ「あっ‥‥」",
  "off": 3290,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3292,
  "text_len": 13
 },
 {
  "id": "sce152:00CED",
  "jp": "パルディア「あっ、遠慮しなくていいのよ。{nl}　若いうちはたくさん食べなきゃ。{nl}　ほら、あなた。見つめてたら食べられないでしょ」",
  "off": 3309,
  "len": 71,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3311,
  "text_len": 68
 },
 {
  "id": "sce152:00D37",
  "jp": "フォルゼン「あ、ああ‥‥いやぁ、気持ちいいねぇ。{nl}　それだけ食べるのは男でもなかなか‥‥いててててて」",
  "off": 3383,
  "len": 62,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3385,
  "text_len": 59
 },
 {
  "id": "sce152:00D78",
  "jp": "レオーネ「‥‥」",
  "off": 3448,
  "len": 14,
  "en": "Leone: ...",
  "status": "translated",
  "style": 0,
  "text_off": 3450,
  "text_len": 11
 },
 {
  "id": "sce152:00D89",
  "jp": "パルディア「気にしないでたくさん食べてね。{nl}　足りなければすぐに作るから」",
  "off": 3465,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3467,
  "text_len": 41
 },
 {
  "id": "sce152:00DB8",
  "jp": "レオーネ「でも‥‥」",
  "off": 3512,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3514,
  "text_len": 13
 },
 {
  "id": "sce152:00DCB",
  "jp": "フォルゼン「そうとも。全然遠慮することありませんよ。{nl}　こんなに美味しそうに食べてくれるんですから、{nl}　作るほうも作りがいがあるってもんですよ、ねぇ？」",
  "off": 3531,
  "len": 89,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3533,
  "text_len": 86
 },
 {
  "id": "sce152:00E27",
  "jp": "パルディア「ええ。たくさん食べてね」",
  "off": 3623,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3625,
  "text_len": 19
 },
 {
  "id": "sce152:00E40",
  "jp": "レオーネ「ありがとう、ございます‥‥」",
  "off": 3648,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3650,
  "text_len": 22
 },
 {
  "id": "sce152:00E5C",
  "jp": "メル<E1>ィ「メル<E1>ィもたくさん食べる！」",
  "off": 3676,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3678,
  "text_len": 21
 },
 {
  "id": "sce152:00E77",
  "jp": "フォルゼン「よぉーし！　パパも負けないぞぉ」",
  "off": 3703,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3705,
  "text_len": 25
 },
 {
  "id": "sce152:00EBB",
  "jp": "トウヤ「‥‥ん？　あれは‥‥レオーネ？{nl}　こんな時間にどうしたんだ？」",
  "off": 3771,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3773,
  "text_len": 45
 },
 {
  "id": "sce152:00EEE",
  "jp": "　レオーネを追って外へ出る{nl}　そのまま寝る",
  "off": 3822,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 128,
  "text_off": 3824,
  "text_len": 26
 },
 {
  "id": "sce152:00F32",
  "jp": "トウヤ「よぅ。こんな時間にどうした？」",
  "off": 3890,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3892,
  "text_len": 22
 },
 {
  "id": "sce152:00F58",
  "jp": "レオーネ「あ‥‥う、うん。{nl}　ちょっと、眠れなくて‥‥」",
  "off": 3928,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3930,
  "text_len": 34
 },
 {
  "id": "sce152:00F80",
  "jp": "トウヤ「なにか心配ごとか？」",
  "off": 3968,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3970,
  "text_len": 17
 },
 {
  "id": "sce152:00FA9",
  "jp": "レオーネ「ううん。その逆。{nl}　今日はとっても楽しかったから。それで‥‥」",
  "off": 4009,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4011,
  "text_len": 43
 },
 {
  "id": "sce152:00FDA",
  "jp": "トウヤ「楽しいって、普通‥‥でもないか。{nl}　あのフォルゼン以外はいい人ばかりだからな」",
  "off": 4058,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4060,
  "text_len": 51
 },
 {
  "id": "sce152:01017",
  "jp": "レオーネ「ふふふ‥‥すごく幸せそうな、{nl}　暖かい家族だよね。{nl}　あんなに楽しい食事、はじめて」",
  "off": 4119,
  "len": 60,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4121,
  "text_len": 57
 },
 {
  "id": "sce152:01056",
  "jp": "トウヤ「‥‥お前の家族はそうじゃなかったのか？」",
  "off": 4182,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4184,
  "text_len": 30
 },
 {
  "id": "sce152:01085",
  "jp": "レオーネ「‥‥ボク、お父さんやお姉ちゃんに{nl}　あまり好かれてなかったから‥‥{nl}　いつも邪魔者だったし」",
  "off": 4229,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4231,
  "text_len": 62
 },
 {
  "id": "sce152:010C9",
  "jp": "トウヤ「‥‥」",
  "off": 4297,
  "len": 12,
  "en": "Touya: ...",
  "status": "translated",
  "style": 0,
  "text_off": 4299,
  "text_len": 9
 },
 {
  "id": "sce152:010E3",
  "jp": "レオーネ「‥‥たとえ嫌われても家族だから。{nl}　その絆は絶対に消えないもん。{nl}　それが、それだけが変わらないたしかなモノ‥‥」",
  "off": 4323,
  "len": 78,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4325,
  "text_len": 75
 },
 {
  "id": "sce152:01134",
  "jp": "トウヤ「‥‥だからたとえ嫌われていても父親を探すのか？」",
  "off": 4404,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4406,
  "text_len": 35
 },
 {
  "id": "sce152:0116F",
  "jp": "レオーネ「うん。だってそれが家族でしょ？",
  "off": 4463,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4465,
  "text_len": 24
 },
 {
  "id": "sce152:0118E",
  "jp": "　でも‥‥さっきみたいなのが、あの食卓にあった雰囲気が{nl}　本当の“家族”なのかもしれないね‥‥」",
  "off": 4494,
  "len": 66,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4496,
  "text_len": 63
 },
 {
  "id": "sce152:011D3",
  "jp": "トウヤ「‥‥なぁ、あまり無理はするなよ。{nl}　辛いときは辛いって言えばいい。{nl}　俺でよければいつでも相談にのるぜ」",
  "off": 4563,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4565,
  "text_len": 66
 },
 {
  "id": "sce152:01236",
  "jp": "レオーネ「‥‥優しいね」",
  "off": 4662,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4664,
  "text_len": 16
 },
 {
  "id": "sce152:0124C",
  "jp": "トウヤ「いやぁ‥‥」",
  "off": 4684,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4686,
  "text_len": 12
 },
 {
  "id": "sce152:01262",
  "jp": "レオーネ「くしゅん」",
  "off": 4706,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4708,
  "text_len": 11
 },
 {
  "id": "sce152:01277",
  "jp": "トウヤ「そ、そろそろ戻るか‥‥」",
  "off": 4727,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4729,
  "text_len": 19
 },
 {
  "id": "sce152:0129B",
  "jp": "レオーネ「あ‥‥もうちょっと、話がしたいな‥‥」",
  "off": 4763,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4765,
  "text_len": 30
 },
 {
  "id": "sce152:012BF",
  "jp": "トウヤ「でも、風邪ひくぞ」",
  "off": 4799,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4801,
  "text_len": 15
 },
 {
  "id": "sce152:012D8",
  "jp": "レオーネ「ボクと話すのは退屈？」",
  "off": 4824,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4826,
  "text_len": 21
 },
 {
  "id": "sce152:012F3",
  "jp": "トウヤ「いや、そういうワケじゃねぇけど‥‥」",
  "off": 4851,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4853,
  "text_len": 24
 },
 {
  "id": "sce152:01323",
  "jp": "レオーネ「じゃ、もう少しだけ。ね？」",
  "off": 4899,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4901,
  "text_len": 21
 },
 {
  "id": "sce152:01342",
  "jp": "トウヤ「お、おい‥‥ひっつくなよ」",
  "off": 4930,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4932,
  "text_len": 19
 },
 {
  "id": "sce152:0135B",
  "jp": "レオーネ「こうすると風邪ひかないよ。{nl}　それに‥‥独りになりたくないんだ‥‥」",
  "off": 4955,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4957,
  "text_len": 47
 },
 {
  "id": "sce152:01390",
  "jp": "トウヤ「ま、まぁ、お前がこれでいいなら別にいいけどよ‥‥」",
  "off": 5008,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5010,
  "text_len": 33
 },
 {
  "id": "sce152:013B7",
  "jp": "レオーネ「へへへへ、トウヤの身体、暖かい」",
  "off": 5047,
