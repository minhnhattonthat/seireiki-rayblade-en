[
 {
  "id": "sce377:00150",
  "jp": "セリカ「あっ、そうそう、言い忘れていたけど、{nl}　ライブレードの変形機構も直ってるから」",
  "off": 336,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 340,
  "text_len": 51
 },
 {
  "id": "sce377:00188",
  "jp": "トウヤ「え？　変形？」",
  "off": 392,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 396,
  "text_len": 15
 },
 {
  "id": "sce377:0019C",
  "jp": "セリカ「そっ。ライブレードって元々、{nl}　飛行形態に変形できる構造だったんだけど、{nl}　やっとそれが直ったの。{page}　変形すると武装が限定されるけど、その分、{nl}　機動性が増すわ。移動に関しての制限が減るから、{nl}　状況によって使い分けて！」",
  "off": 412,
  "len": 153,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 416,
  "text_len": 148
 },
 {
  "id": "sce377:00235",
  "jp": "トウヤ「わかった！」",
  "off": 565,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 569,
  "text_len": 11
 },
 {
  "id": "sce377:0024D",
  "jp": "ベルンスト「聖霊機のほうをたのみます。{nl}　私は“彼女”を捕#791らえますので」",
  "off": 589,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 593,
  "text_len": 45
 },
 {
  "id": "sce377:0027F",
  "jp": "シャール「わかりました。{nl}　適当にあしらっておきます」",
  "off": 639,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 643,
  "text_len": 30
 },
 {
  "id": "sce377:002A2",
  "jp": "ベルンスト「それではまいりましょうか」",
  "off": 674,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 678,
  "text_len": 19
 },
 {
  "id": "sce377:0034C",
  "jp": "<E1>ェル「隊長、本当に行くんですか？{nl}　聖霊機はともかくあの＜ゼ＝オード＞には{nl}　こっちの攻撃は効かないんですよ」",
  "off": 844,
  "len": 77,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 848,
  "text_len": 72
 },
 {
  "id": "sce377:00399",
  "jp": "<E1>ァレス「目標を確捕してすぐに離脱する。{nl}　交戦はできうるかぎり控えろ」",
  "off": 921,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 925,
  "text_len": 45
 },
 {
