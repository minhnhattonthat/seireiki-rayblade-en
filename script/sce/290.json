  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2590,
  "text_len": 14
 },
 {
  "id": "sce290:00A30",
  "jp": "ヤマト「でも、あたしが見るときはいつも止#4FDまってるよ。{nl}　しかもちょうどその階に」",
  "off": 2608,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2610,
  "text_len": 43
 },
 {
