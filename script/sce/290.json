  "status": "todo",
  "style": 0,
  "text_off": 3522,
  "text_len": 17
 },
 {
  "id": "sce290:00DDD",
  "jp": "フェイン「おおっ！　それはつまり俺の口上もそれだけ{nl}　素晴らしいってことだな！」",
  "off": 3549,
