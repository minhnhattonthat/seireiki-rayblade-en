  "status": "todo",
  "style": 0,
  "text_off": 5096,
  "text_len": 12
 },
 {
  "id": "sce290:013F8",
  "jp": "ヤマト「カスミって、フェインと‥‥」",
  "off": 5112,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5114,
  "text_len": 20
 },
 {
  "id": "sce290:01416",
  "jp": "カスミ「？　フェイン君は荷物を運ぶのを{nl}　手田ってくれただけだよ。{nl}　それがどうかしたの？」",
  "off": 5142,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5144,
  "text_len": 54
 },
 {
  "id": "sce290:01452",
  "jp": "トウヤ「荷物？」",
  "off": 5202,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5204,
  "text_len": 11
 },
 {
  "id": "sce290:01475",
  "jp": "カスミ「着替えとかは一人で大丈夫だったけど、{nl}　本なんかはさすがに運べなくって‥‥{nl}　そしたらフェイン君が通りかかって」",
  "off": 5237,
  "len": 76,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5239,
  "text_len": 73
 },
 {
  "id": "sce290:014C4",
  "jp": "トウヤ「それであいつが運んでやるって言い出したんだな？」",
  "off": 5316,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5318,
  "text_len": 32
 },
 {
  "id": "sce290:014FC",
  "jp": "カスミ「うん。よくわかったね」",
  "off": 5372,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5374,
  "text_len": 15
 },
 {
  "id": "sce290:01511",
  "jp": "トウヤ「まあ、さっきのあいつの態度をみてたら、{nl}　ほっとくワケねぇだろうからな」",
  "off": 5393,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5395,
  "text_len": 42
 },
 {
  "id": "sce290:01545",
  "jp": "カスミ「フェイン君ってどこかトウヤちゃんに似てるよね」",
  "off": 5445,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5447,
  "text_len": 29
 },
 {
  "id": "sce290:01568",
  "jp": "トウヤ「そうか？」",
  "off": 5480,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5482,
  "text_len": 10
 },
 {
  "id": "sce290:0158A",
  "jp": "カスミ「うん。裏表のないところとか、優しいところとか」",
  "off": 5514,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5516,
  "text_len": 30
 },
 {
  "id": "sce290:015AE",
  "jp": "ヤマト「彼の場合は明確ニャ目的がある上での{nl}　行動だと思うけど‥‥」",
  "off": 5550,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5552,
  "text_len": 47
 },
 {
  "id": "sce290:015F5",
  "jp": "カスミ「？」",
  "off": 5621,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5623,
  "text_len": 7
 },
 {
  "id": "sce290:01602",
  "jp": "トウヤ「もう荷物は大丈夫なのか？{nl}　何かあるなら手田うぞ」",
  "off": 5634,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5636,
  "text_len": 38
 },
 {
  "id": "sce290:0162E",
  "jp": "カスミ「ううん。大丈夫。後は整理するだけだから」",
  "off": 5678,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5680,
  "text_len": 30
 },
 {
  "id": "sce290:01652",
  "jp": "トウヤ「そうか。まあ、何かあったら遠慮せずに言えよ」",
  "off": 5714,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5716,
  "text_len": 30
 },
 {
  "id": "sce290:0167A",
  "jp": "カスミ「うん。そうする」",
  "off": 5754,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5756,
  "text_len": 12
 },
 {
  "id": "sce290:0168C",
  "jp": "トウヤ「それじゃ」",
  "off": 5772,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5774,
  "text_len": 9
 },
 {
  "id": "sce290:01846",
  "jp": "トウヤ「よっ」",
  "off": 6214,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6216,
  "text_len": 7
 },
 {
  "id": "sce290:0185B",
  "jp": "セリカ「ああ、トウヤ。どうしたの？」",
  "off": 6235,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6237,
  "text_len": 19
 },
 {
  "id": "sce290:01874",
  "jp": "トウヤ「ん？　まぁ、別にこれといって揖はねぇけど」",
  "off": 6260,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6262,
  "text_len": 28
 },
 {
  "id": "sce290:0189B",
  "jp": "セリカ「ふぅ～ん。それじゃ、私の代わりにこの席を温める{nl}　任務を与えます」",
  "off": 6299,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6301,
  "text_len": 45
 },
 {
  "id": "sce290:018CE",
  "jp": "トウヤ「はぁ？」",
  "off": 6350,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6352,
  "text_len": 9
 },
 {
  "id": "sce290:018EF",
  "jp": "セリカ「暇なんでしょ？」",
  "off": 6383,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6385,
  "text_len": 14
 },
 {
  "id": "sce290:01903",
  "jp": "トウヤ「それほどまでに暇じゃねぇよ。それじゃあな！」",
  "off": 6403,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6405,
  "text_len": 28
 },
 {
  "id": "sce290:01929",
  "jp": "セリカ「あっ‥‥」",
  "off": 6441,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6443,
  "text_len": 11
 },
 {
  "id": "sce290:0193D",
  "jp": "セリカ「新しい出会いをもとめて放浪中とか？」",
  "off": 6461,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6463,
  "text_len": 29
 },
 {
  "id": "sce290:01960",
  "jp": "トウヤ「んなわけねぇーだろ」",
  "off": 6496,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6498,
  "text_len": 15
 },
 {
  "id": "sce290:01980",
  "jp": "セリカ「そうよね。トウヤって、どっちかというと自分から{nl}　積極的に恋を求める感じじゃないものね」",
  "off": 6528,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6530,
  "text_len": 56
 },
 {
  "id": "sce290:019BE",
  "jp": "トウヤ「じゃ、どう見えるんだ？」",
  "off": 6590,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6592,
  "text_len": 18
 },
 {
  "id": "sce290:019DA",
  "jp": "セリカ「う～ん、自分では特に気してない行動が{nl}　相手の心を動かして、いつのまにかうまくいく、{nl}{ctl:783E}{face:041C05}　かな？」",
  "off": 6618,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6620,
  "text_len": 72
 },
 {
  "id": "sce290:01A28",
  "jp": "トウヤ「そんなに都合のいいことあるかよ」",
  "off": 6696,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6698,
  "text_len": 22
 },
 {
  "id": "sce290:01A4F",
  "jp": "セリカ「まっ、そのうち分かるわよ。{nl}　さて、それじゃ、私そろそろ行くね」",
  "off": 6735,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
