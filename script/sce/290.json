  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2399,
  "text_len": 13
 },
 {
  "id": "sce290:009E5",
  "jp": "ヤマト「あれ？　エレベーターが動いてる。めずらしいわね。{nl}　誰か乗ってるのかしら？」",
  "off": 2533,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2535,
  "text_len": 49
 },
 {
