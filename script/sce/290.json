  "off": 2282,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2284,
  "text_len": 21
 },
 {
  "id": "sce290:00907",
  "jp": "ヤマト「あっ‥‥出ていっちゃった‥‥{nl}　どこに連れていかれたんだろ？」",
  "off": 2311,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2313,
  "text_len": 42
 },
 {
