  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1640,
  "text_len": 21
 },
 {
  "id": "sce290:00689",
  "jp": "シスク「とーぜん。バートさんがいろいろ揖意してくれたから{nl}　思いのほか早く終わったわ」",
  "off": 1673,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1675,
  "text_len": 50
 },
 {
  "id": "sce290:006C1",
  "jp": "トウヤ「へぇ‥‥これで料理のレパートリーも増えるって{nl}　ことだな？」",
  "off": 1729,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1731,
  "text_len": 42
 },
 {
