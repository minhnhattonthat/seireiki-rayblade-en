[
 {
  "id": "sce383:003A1",
  "jp": "オーレリィ「あっ‥‥」",
  "off": 929,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 931,
  "text_len": 14
 },
 {
  "id": "sce383:003B5",
  "jp": "トウヤ「よう。あのさ、ちょっと訊きたいことがあるんだけど」",
  "off": 949,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 951,
  "text_len": 30
 },
 {
  "id": "sce383:003D9",
  "jp": "オーレリィ「うん‥‥なに？」",
  "off": 985,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 987,
  "text_len": 18
 },
 {
  "id": "sce383:003F1",
  "jp": "トウヤ「この前、孤児院で育ったって言ってたよな。{nl}　そのことをもうちょっと聞きたくてな」",
  "off": 1009,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1011,
  "text_len": 51
 },
 {
  "id": "sce383:0042A",
  "jp": "オーレリィ「‥‥別にいいけど、どうして？」",
  "off": 1066,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1068,
  "text_len": 26
 },
 {
  "id": "sce383:0044A",
  "jp": "トウヤ「う～ん、俺の気のせいかもしれねぇけど、{nl}　悲しそうな顔もしてたからな」",
  "off": 1098,
  "len": 47,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1100,
  "text_len": 44
 },
 {
  "id": "sce383:0047C",
  "jp": "オーレリィ「また、いつものお節介？」",
  "off": 1148,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1150,
  "text_len": 22
 },
 {
  "id": "sce383:00498",
  "jp": "トウヤ「そうかもな」",
  "off": 1176,
  "len": 13,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1178,
  "text_len": 10
 },
 {
  "id": "sce383:004A8",
  "jp": "オーレリィ「‥‥そういえば、トウヤのご両親は{nl}　亡くなられたんだよね？」",
  "off": 1192,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1194,
  "text_len": 43
 },
 {
  "id": "sce383:004D9",
  "jp": "トウヤ「ああ‥‥空港でのテロに巻き込まれてな」",
  "off": 1241,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1243,
  "text_len": 29
 },
 {
  "id": "sce383:004FC",
  "jp": "オーレリィ「失って初めてその大切さに気づくことも{nl}　あるけど、ちゃんといたとしても幸せでいれるとは{nl}　限らないよ‥‥」",
  "off": 1276,
  "len": 72,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1278,
  "text_len": 69
 },
 {
  "id": "sce383:00547",
  "jp": "トウヤ「どういうことだ？」",
  "off": 1351,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1353,
  "text_len": 14
 },
 {
  "id": "sce383:0055B",
  "jp": "オーレリィ「ずっと、両親はアタシが生まれてすぐに{nl}　死んだって聞かされてたんだ。でも、そうじゃなかった。{nl}　母親が生きてるって事がわかったんだ。{nl}　はじめは、会いたいなんて思わなかった。{nl}　どんな理由があったにせよアタシを捨てた人だからね。{nl}　けど‥‥気がついたら母親のいる家に向かってた。{nl}　なんでなんだろうね。憎んでたはずなのに、どうしても{nl}　顔を見たくなったんだ。{nl}　‥‥けど、行くんじゃなかったよ。{nl}　そこは、平凡だけど暖かい家庭があった。{nl}　母親とその旦那と、小さな男の子が一人、いた‥‥」",
  "off": 1371,
  "len": 298,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1373,
  "text_len": 295
 },
 {
  "id": "sce383:00688",
  "jp": "トウヤ「‥‥‥‥」",
  "off": 1672,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1674,
  "text_len": 13
 },
 {
  "id": "sce383:0069B",
  "jp": "オーレリィ「その時、わかったんだ。アタシの居場所は{nl}　そこにはない‥‥{nl}　そこにある幸せを壊す権利はアタシにはないってね」",
  "off": 1691,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1693,
  "text_len": 72
 },
 {
  "id": "sce383:006E9",
  "jp": "ヤマト「そんニャ‥‥ひどいじゃニャい‥‥{nl}　オーレリィだって、娘ニャのに‥‥」",
  "off": 1769,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1771,
  "text_len": 47
 },
 {
  "id": "sce383:0071E",
  "jp": "オーレリィ「ううん、元はと言えばアタシも悪いの。{nl}　母の顔をみた時‥‥アタシが小さい時によくお菓子を{nl}　もって来てくれてた人だって気づいたの。{nl}　その人は、未婚の母で娘がいるって言ってたけど、{nl}　アタシ、そんなことに気づきもせず、母に対する憎しみを{nl}　語ったの。顔も見たくない、吐き気がするって。{nl}　その時、ただ黙って悲しそうな瞳をして笑ってた‥‥」",
  "off": 1822,
  "len": 216,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1824,
  "text_len": 213
 },
 {
  "id": "sce383:007F9",
  "jp": "トウヤ「だけどよ、自分の娘だろ？{nl}　憎まれてるとかそういう問題じゃねぇだろうに‥‥」",
  "off": 2041,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2043,
  "text_len": 51
 },
 {
  "id": "sce383:00832",
  "jp": "オーレリィ「そんなに強い人ならアタシを孤児院に置いたり{nl}　しないよ」",
  "off": 2098,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2100,
  "text_len": 41
 },
 {
  "id": "sce383:00861",
  "jp": "トウヤ「‥‥」",
  "off": 2145,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2147,
  "text_len": 9
 },
 {
  "id": "sce383:00870",
  "jp": "オーレリィ「それに、産んでくれただけでも感謝しないと」",
  "off": 2160,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2162,
  "text_len": 31
 },
 {
  "id": "sce383:00895",
  "jp": "トウヤ「オーレリィ‥‥」",
  "off": 2197,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2199,
  "text_len": 15
 },
 {
  "id": "sce383:008B4",
  "jp": "オーレリィ「だって、そうじゃなかったらこうやって{nl}　トウヤと出会う‥‥あっ」",
  "off": 2228,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2230,
  "text_len": 43
 },
 {
  "id": "sce383:008E5",
  "jp": "トウヤ「？」",
  "off": 2277,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2279,
  "text_len": 7
 },
 {
  "id": "sce383:008F2",
  "jp": "オーレリィ「う、ううん、なんでもない！」",
  "off": 2290,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2292,
  "text_len": 22
 },
 {
  "id": "sce383:0090E",
  "jp": "トウヤ「それじゃ、もう憎んでないのか？」",
  "off": 2318,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2320,
  "text_len": 22
 },
 {
  "id": "sce383:0092A",
  "jp": "オーレリィ「‥‥まぁね。{nl}　気にしてないって言ったら嘘になるけどね。{nl}　でも、こう思えるようになったのはこのアガルティアへ{nl}　やってきてからなんだけどね。{nl}　こっちにきてから色々考える時間もあったし」",
  "off": 2346,
  "len": 114,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2348,
  "text_len": 111
 },
 {
  "id": "sce383:0099F",
  "jp": "トウヤ「そっか‥‥」",
  "off": 2463,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2465,
  "text_len": 12
 },
 {
  "id": "sce383:009B1",
  "jp": "オーレリィ「見守るだけの関係がいい場合だってあるよ。{nl}　誰だって幸せにならなきゃ‥‥{nl}　あっ、ごめん、暗くなるなんてらしくないよね」",
  "off": 2481,
  "len": 81,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2483,
  "text_len": 78
 },
 {
  "id": "sce383:00A05",
  "jp": "トウヤ「オーレリィ‥‥」",
  "off": 2565,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2567,
  "text_len": 15
 },
 {
  "id": "sce383:00A1A",
  "jp": "オーレリィ「あっ、アタシ用があるからこれで！　じゃ！」",
  "off": 2586,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2588,
  "text_len": 31
 },
 {
  "id": "sce383:00A41",
  "jp": "ヤマト「‥‥オーレリィも辛いのね‥‥」",
  "off": 2625,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2627,
  "text_len": 25
 },
 {
  "id": "sce383:00A60",
  "jp": "トウヤ「ああ‥‥」",
  "off": 2656,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2658,
  "text_len": 11
 },
 {
  "id": "sce383:00A71",
  "jp": "ヤマト「でも最近のオーレリィって、前と違って{nl}　柔らかい表情をするようにニャったわね。{nl}　これも誰かさんのおかげかニャ？」",
  "off": 2673,
  "len": 74,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2675,
  "text_len": 71
 },
 {
  "id": "sce383:00ABE",
  "jp": "トウヤ「‥‥さっ、俺達も行くか！」",
  "off": 2750,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2752,
  "text_len": 23
 },
 {
  "id": "sce383:00ADB",
  "jp": "ヤマト「あ～　照れてるぅ～」",
  "off": 2779,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2781,
  "text_len": 17
 },
 {
  "id": "sce383:00AF2",
  "jp": "トウヤ「うるさい」",
  "off": 2802,
  "len": 12,
  "en": "",
  "status": "todo",
