  "off": 6341,
  "len": 12,
  "en": "Touya: ...",
  "status": "translated",
  "style": 0,
  "text_off": 6343,
  "text_len": 9
 },
 {
  "id": "sce313:018D4",
  "jp": "セリカ「ト、トウ‥‥ヤ？」",
  "off": 6356,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6358,
  "text_len": 16
 },
 {
  "id": "sce313:018EA",
  "jp": "トウヤ「‥‥すまねぇ。{nl}　辛いことを思い出させちまったな‥‥」",
  "off": 6378,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6380,
  "text_len": 38
 },
 {
  "id": "sce313:01916",
  "jp": "セリカ「‥‥」",
  "off": 6422,
  "len": 12,
  "en": "Celica: ...",
  "status": "translated",
  "style": 0,
  "text_off": 6424,
  "text_len": 9
 },
 {
  "id": "sce313:01925",
  "jp": "トウヤ「ほんと、ごめん」",
  "off": 6437,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6439,
  "text_len": 12
 },
 {
  "id": "sce313:01937",
  "jp": "セリカ「‥‥ううん。ずっと心の中に閉じこめていたから、{nl}　話したらなんだか心が軽くなった気がする‥‥」",
  "off": 6455,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6457,
  "text_len": 62
 },
 {
  "id": "sce313:0197B",
  "jp": "トウヤ「俺でよければいつでも話ぐらい聞くぜ」",
  "off": 6523,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6525,
  "text_len": 25
 },
 {
  "id": "sce313:0199A",
  "jp": "セリカ「‥‥うん。ありがと。{nl}　‥‥ねえ」",
  "off": 6554,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6556,
  "text_len": 25
 },
 {
  "id": "sce313:019B9",
  "jp": "トウヤ「ん？」",
  "off": 6585,
  "len": 11,
  "en": "Touya: Hm?",
  "status": "translated",
  "style": 0,
  "text_off": 6587,
  "text_len": 8
 },
 {
  "id": "sce313:019D1",
  "jp": "セリカ「もう少し、こうしてていい？」",
  "off": 6609,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6611,
  "text_len": 20
 },
 {
  "id": "sce313:019EB",
  "jp": "トウヤ「あ、ああ‥‥」",
  "off": 6635,
  "len": 16,
  "en": "Touya: Oh, r-right...",
  "status": "translated",
  "style": 0,
  "text_off": 6637,
  "text_len": 13
 },
 {
  "id": "sce313:01A17",
  "jp": "セリカ「‥‥ありがとう。{nl}{ctl:3C3E}{face:841C03}{ctl:023E}{face:841C05}　えへへへ、なんか、らしくないよね」",
  "off": 6679,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6681,
  "text_len": 49
 },
 {
  "id": "sce313:01A4E",
  "jp": "トウヤ「いや、そうでもないぜ」",
  "off": 6734,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6736,
  "text_len": 15
 },
 {
  "id": "sce313:01A6E",
  "jp": "セリカ「そう？」",
  "off": 6766,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6768,
  "text_len": 9
 },
 {
  "id": "sce313:01A7D",
  "jp": "トウヤ「セリカも女の子なんだって再認識できたしな」",
  "off": 6781,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6783,
  "text_len": 30
 },
 {
  "id": "sce313:01AAC",
  "jp": "セリカ「ちょっと、それどういう意味⁈」",
  "off": 6828,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6830,
  "text_len": 22
 },
 {
  "id": "sce313:01AC8",
  "jp": "トウヤ「はははは‥‥まぁ、なんだ。お互い、逃げねぇで{nl}　ちょっとずつでも向き合うようにしていこうぜ」",
  "off": 6856,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6858,
  "text_len": 56
 },
 {
  "id": "sce313:01B18",
  "jp": "セリカ「そうだね」",
  "off": 6936,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6938,
  "text_len": 9
 },
 {
  "id": "sce313:01B27",
  "jp": "トウヤ「それじゃ、そろそろ行くよ」",
  "off": 6951,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6953,
  "text_len": 18
 },
 {
  "id": "sce313:01B3F",
  "jp": "セリカ「うん」",
  "off": 6975,
  "len": 10,
  "en": "Celica: Yep.",
  "status": "translated",
  "style": 0,
  "text_off": 6977,
  "text_len": 7
 },
 {
  "id": "sce313:01B65",
  "jp": "トウヤ「辛かったんだな。そうやって胸の中にしまいこんで。{nl}　でもよ、セリカ。ちゃんと向き合えって言ってたのは{nl}　お前だぞ？　俺が両親の‥‥その‥‥死を認めることから{nl}　逃げているようにお前も逃げてる‥‥」",
  "off": 7013,
  "len": 127,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7015,
  "text_len": 124
 },
 {
  "id": "sce313:01BEB",
  "jp": "セリカ「‥‥」",
  "off": 7147,
  "len": 12,
  "en": "Celica: ...",
  "status": "translated",
  "style": 0,
  "text_off": 7149,
  "text_len": 9
 },
 {
  "id": "sce313:01BFA",
  "jp": "トウヤ「結局は自分で向き合わなければならねぇけど、{nl}　そこに至るまでは誰かと共に立ち上がることが{nl}　できると思う。{nl}　だから、一緒に、少しずつでもいい。{nl}　ちゃんと向き合えるように頑張ってみねぇか？」",
  "off": 7162,
  "len": 123,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7164,
  "text_len": 120
 },
 {
  "id": "sce313:01C8A",
  "jp": "セリカ「トウヤ‥‥」",
  "off": 7306,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7308,
  "text_len": 12
 },
 {
  "id": "sce313:01C9C",
