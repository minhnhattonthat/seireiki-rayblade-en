[
 {
  "id": "sce056:0002E",
  "jp": "オズヴァルド「カインが逃げた‥‥{nl}　ちっ、せっかくのチャンスを‥‥{nl}　これではこの子は返すことはできませんね」",
  "off": 46,
  "len": 65,
  "en": "Oswald: Cain got away... Tch, and it was such a golden chance... Now I can't very well give this child back, can I?",
  "status": "translated",
  "style": 0,
  "text_off": 48,
  "text_len": 62
 },
 {
  "id": "sce056:00072",
  "jp": "クルル「いや‥‥離して！」",
