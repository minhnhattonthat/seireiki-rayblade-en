 },
 {
  "id": "sce040:00054",
  "jp": "トウヤ「‥‥そういや、ユミールはちゃんと起きたのかな？」",
  "off": 84,
  "len": 36,
  "en": "Touya: ...Come to think of it, I wonder if Ymir got up okay?",
