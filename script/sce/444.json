  "off": 4767,
  "len": 10,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4769,
  "text_len": 7
 },
 {
  "id": "sce444:012B4",
  "jp": "セリカ「ああ、トウヤ。どうしたの？」",
  "off": 4788,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4790,
  "text_len": 19
 },
 {
  "id": "sce444:012D3",
  "jp": "トウヤ「ん？　まぁ、別にこれといって用はねぇけど」",
  "off": 4819,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4821,
  "text_len": 28
 },
 {
  "id": "sce444:012FA",
  "jp": "セリカ「ふぅ～ん。それじゃ、私の代わりにこの席を温める{nl}　任務を与えます」",
  "off": 4858,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4860,
  "text_len": 45
 },
 {
  "id": "sce444:0132D",
  "jp": "トウヤ「はぁ？」",
  "off": 4909,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4911,
  "text_len": 9
 },
 {
  "id": "sce444:0134E",
  "jp": "セリカ「暇なんでしょ？」",
  "off": 4942,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4944,
  "text_len": 14
 },
 {
  "id": "sce444:01362",
  "jp": "トウヤ「それほどまでに暇じゃねぇよ。それじゃあな！」",
  "off": 4962,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4964,
  "text_len": 28
 },
 {
  "id": "sce444:01388",
  "jp": "セリカ「あっ‥‥」",
  "off": 5000,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5002,
  "text_len": 11
 },
 {
  "id": "sce444:013A1",
  "jp": "セリカ「新しい出会いをもとめて放浪中とか？」",
  "off": 5025,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5027,
  "text_len": 29
 },
 {
  "id": "sce444:013C4",
  "jp": "トウヤ「んなわけねぇーだろ」",
  "off": 5060,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5062,
  "text_len": 15
 },
 {
  "id": "sce444:013E4",
  "jp": "セリカ「そうよね。トウヤって、どっちかというと自分から{nl}　積極的に恋を求める感じじゃないものね」",
  "off": 5092,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5094,
  "text_len": 56
 },
 {
  "id": "sce444:01422",
  "jp": "トウヤ「じゃ、どう見えるんだ？」",
  "off": 5154,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5156,
  "text_len": 18
 },
 {
  "id": "sce444:0143E",
  "jp": "セリカ「う～ん、自分では特に気してない行動が{nl}　相手の心を動かして、いつのまにかうまくいく、{nl}{ctl:783E}{face:041C05}　かな？」",
  "off": 5182,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5184,
  "text_len": 72
 },
 {
  "id": "sce444:0148C",
  "jp": "トウヤ「そんなに都合のいいことあるかよ」",
  "off": 5260,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5262,
  "text_len": 22
 },
 {
  "id": "sce444:014B3",
  "jp": "セリカ「まっ、そのうち分かるわよ。{nl}　さて、それじゃ、私そろそろ行くね」",
  "off": 5299,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5301,
  "text_len": 39
 }
