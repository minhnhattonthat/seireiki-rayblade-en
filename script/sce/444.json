[
 {
  "id": "sce444:00061",
  "jp": "　「1B0のフラグが立っていません。このプライベート{nl}　イベントをする場合は1B0のフラグを立てやり直して{nl}　ください。しない場合は、強制終了いたします。」{ctl:B43E}",
  "off": 97,
  "len": 96,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 99,
  "text_len": 93
 },
 {
  "id": "sce444:0084D",
  "jp": "ヤマト「あれ？　エレベーターが動いてる。めずらしいわね。{nl}　誰か乗ってるのかしら？」",
  "off": 2125,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2127,
  "text_len": 49
 },
 {
  "id": "sce444:00884",
  "jp": "トウヤ「そりゃ、乗るだろ」",
  "off": 2180,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2182,
  "text_len": 14
 },
 {
  "id": "sce444:00898",
  "jp": "ヤマト「でも、あたしが見るときはいつも止まってるよ。{nl}　しかもちょうどその階に」",
  "off": 2200,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2202,
  "text_len": 43
 },
 {
  "id": "sce444:008C9",
  "jp": "トウヤ「気のせいだ。気のせい。それより‥‥」",
  "off": 2249,
  "len": 29,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2251,
  "text_len": 26
 },
 {
  "id": "sce444:008F0",
  "jp": "ヤマト「あっ、止まった」",
  "off": 2288,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2290,
  "text_len": 13
 },
 {
  "id": "sce444:0090A",
  "jp": "フェイン「はははははははっ！{nl}　愛する人を守る為、正義の刃が敵を撃つ！{nl}　赤い血潮を真っ赤に燃やし、それが男の生きる道！{nl}　正義と真実の男！{nl}　フェイィィン、ジィィン、バァァァリィオォォン‼{nl}　只今、推参！　正義のためなら‥‥死ねる」",
  "off": 2314,
  "len": 158,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2316,
  "text_len": 155
 },
