[
 {
  "id": "sce412:00055",
  "jp": "　「1B0のフラグが立っていません。このプライベート{nl}　イベントをする場合は1B0のフラグを立てやり直して{nl}　ください。しない場合は、強制終了いたします。」{ctl:B43E}",
  "off": 85,
  "len": 96,
  "en": "\"Flag 1B0 is not set. To run this private event, set flag 1B0 and start again. Otherwise, the event will be force-quit.\"{ctl:B43E}",
  "status": "translated",
  "style": 0,
  "text_off": 87,
  "text_len": 93
 },
 {
  "id": "sce412:006EA",
  "jp": "ヤマト「あれ？　エレベーターが動いてる。めずらしいわね。{nl}　誰か乗ってるのかしら？」",
  "off": 1770,
  "len": 52,
  "en": "Yamato: Huh? The elevator's moving. That's rare. I wonder if someone's riding it?",
  "status": "translated",
  "style": 0,
  "text_off": 1772,
  "text_len": 49
 },
 {
  "id": "sce412:00721",
  "jp": "トウヤ「そりゃ、乗るだろ」",
  "off": 1825,
  "len": 17,
  "en": "Touya: Well, yeah, people ride it.",
  "status": "translated",
  "style": 0,
  "text_off": 1827,
  "text_len": 14
 },
 {
  "id": "sce412:00735",
  "jp": "ヤマト「でも、あたしが見るときはいつも止まってるよ。{nl}　しかもちょうどその階に」",
  "off": 1845,
  "len": 46,
  "en": "Yamato: But whenever I look, it's always stopped. And right on this floor, too.",
  "status": "translated",
  "style": 0,
  "text_off": 1847,
  "text_len": 43
 },
 {
  "id": "sce412:00766",
  "jp": "トウヤ「気のせいだ。気のせい。それより‥‥」",
