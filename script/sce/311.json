  "status": "todo",
  "style": 128,
  "text_off": 2488,
  "text_len": 23
 },
 {
  "id": "sce311:009DF",
  "jp": "フェイン「だろ？　特に最後のとこなんか言ってる俺が{nl}　しびれるぐらいだからな」",
