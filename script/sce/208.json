  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2547,
  "text_len": 13
 },
 {
  "id": "sce208:00A16",
  "jp": "メル<E1>ィ「えへへへ。うれしいな。{nl}　でも、それを言う相手はメル<E1>ィじゃないよ」",
