  "status": "todo",
  "style": 0,
  "text_off": 4538,
  "text_len": 45
 },
 {
  "id": "sce208:011EB",
  "jp": "トウヤ「やめやめ、そんなこと考えたって仕方ねぇよな。{nl}　どうせ行き着くところはデビッシュのような{nl}　考えだろうしな」",
