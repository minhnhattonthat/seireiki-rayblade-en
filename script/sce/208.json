  "status": "todo",
  "style": 0,
  "text_off": 925,
  "text_len": 8
 },
 {
  "id": "sce208:003A9",
  "jp": "レオーネ「ボクの手を握ってくれない？{nl}　トウヤを‥‥感じたいの」",
  "off": 937,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 939,
  "text_len": 39
 },
 {
  "id": "sce208:003D6",
  "jp": "トウヤ「あ、ああ‥‥これでいいか？」",
  "off": 982,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 984,
  "text_len": 21
 },
 {
  "id": "sce208:003F1",
  "jp": "レオーネ「うふふふ‥‥トウヤの手‥‥あったかいね。{nl}　トウヤの心とおんなじだ」",
  "off": 1009,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1011,
  "text_len": 46
 },
