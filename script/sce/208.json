  "off": 2348,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2350,
  "text_len": 12
 },
 {
  "id": "sce208:0093E",
  "jp": "メル<E1>ィ「大丈夫、よしよし。{nl}　お兄ちゃん！ヤマトちゃんをイジメちゃダメだよ、めっ！」",
  "off": 2366,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2368,
  "text_len": 49
 },
