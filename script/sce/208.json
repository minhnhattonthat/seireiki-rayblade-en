  "off": 2421,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2423,
  "text_len": 15
 },
 {
  "id": "sce208:0098A",
  "jp": "メル<E1>ィ「せっかくのパーティーなんだから、みんなで{nl}　楽しくいこうよ。ね？」",
  "off": 2442,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 2444,
  "text_len": 42
 },
