  "len": 67,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4589,
  "text_len": 64
 },
 {
  "id": "sce208:01231",
  "jp": "クロビス「まぁな。それじゃ、とりあえず今夜のパーティーは{nl}　思いっきり楽しもうぜ」",
