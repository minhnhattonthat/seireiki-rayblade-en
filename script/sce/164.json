  "style": 0,
  "text_off": 959,
  "text_len": 40
 },
 {
  "id": "sce164:003EB",
  "jp": "ゲン「姉ちゃん、なにも泣くことないだろ？{nl}　オイラはこのとおり無事なんだからさ‥‥」",
  "off": 1003,
  "len": 52,
