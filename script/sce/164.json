  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4881,
  "text_len": 33
 },
 {
  "id": "sce164:01336",
  "jp": "ベイオ「⁉　メ、メリッサ‥‥お前‥‥記憶が‥‥」",
  "off": 4918,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4920,
  "text_len": 34
 },
 {
  "id": "sce164:01369",
  "jp": "メリッサ「ええ。まだおぼろげではありますが」",
  "off": 4969,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4971,
  "text_len": 22
 },
 {
  "id": "sce164:01385",
  "jp": "ベイオ「そ、そうか‥‥」",
  "off": 4997,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 4999,
  "text_len": 14
 },
 {
  "id": "sce164:013AB",
  "jp": "メリッサ「もう記憶を失うのはごめんです。{nl}　だって‥‥あなたと過ごしたこの2年も、{nl}　私にとっては大切な思い出だもの」",
  "off": 5035,
  "len": 74,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5037,
  "text_len": 71
 },
 {
  "id": "sce164:0140A",
  "jp": "ベイオ「おお‥‥メリッサ‥‥ワシは‥‥ワシは‥‥うぅっ」",
  "off": 5130,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5132,
  "text_len": 36
 },
 {
  "id": "sce164:0143F",
  "jp": "メリッサ「大丈夫。あなたは悪くない。{nl}　あなたの気持ち、とてもうれしかった‥‥」",
  "off": 5183,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5185,
  "text_len": 48
 },
 {
  "id": "sce164:01475",
  "jp": "ベイオ「メリッサ‥‥」",
  "off": 5237,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5239,
  "text_len": 13
 },
 {
  "id": "sce164:0148C",
  "jp": "メリッサ「ありがとう。そして、さよなら‥‥ベイオ‥‥」",
  "off": 5260,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5262,
  "text_len": 31
 },
 {
  "id": "sce164:014B5",
  "jp": "ベイオ「‥‥ちょっと待て。どうやって帰るつもりじゃ？{nl}　それに奴等の居場所も知らんだろ」",
  "off": 5301,
  "len": 58,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5303,
  "text_len": 55
 },
 {
  "id": "sce164:01504",
  "jp": "メリッサ「それは‥‥」",
  "off": 5380,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5382,
  "text_len": 13
 },
 {
  "id": "sce164:01517",
  "jp": "ベイオ「ワシの艇で送ってやろう」",
  "off": 5399,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5401,
  "text_len": 18
 },
