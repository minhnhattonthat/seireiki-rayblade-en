  "jp": "ベイオ「‥‥ちょっとした試験だ。{nl}　昔に作った装置のな‥‥」",
  "off": 3083,
  "len": 43,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3085,
  "text_len": 40
 },
 {
  "id": "sce164:00C39",
  "jp": "メリッサ「装置‥‥それも装兵機のものなのですか？」",
  "off": 3129,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3131,
  "text_len": 33
 },
 {
  "id": "sce164:00C60",
  "jp": "ベイオ「あ、ああ‥‥」",
  "off": 3168,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3170,
  "text_len": 13
 },
 {
  "id": "sce164:00C73",
  "jp": "メリッサ「博士？」",
  "off": 3187,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3189,
  "text_len": 12
 },
 {
  "id": "sce164:00C85",
  "jp": "ベイオ「と、とにかく一緒にくるのだ！」",
  "off": 3205,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3207,
  "text_len": 22
 },
 {
  "id": "sce164:00CA3",
  "jp": "メリッサ「は、博士‥‥痛い‥‥」",
  "off": 3235,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 3237,
  "text_len": 23
 },
