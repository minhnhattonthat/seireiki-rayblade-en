[
 {
  "id": "sce164:0005A",
  "jp": "トウヤ「‥‥ん？　あれは‥‥」",
  "off": 90,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 92,
  "text_len": 20
 },
 {
  "id": "sce164:0007E",
  "jp": "セリカ「神剣ダイフォゾンよ。{nl}　本当はさっきの戦いの最中に転送される{nl}　予定だったけど、その前にケリついちゃったからね。{nl}　使うのは次の戦闘までおあずけよ」",
  "off": 126,
  "len": 97,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 128,
  "text_len": 94
 },
 {
  "id": "sce164:000E2",
  "jp": "トウヤ「これが、ダイフォゾンか‥‥{nl}　なんだか不思議な力を感じるな」",
  "off": 226,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 228,
  "text_len": 41
 },
 {
  "id": "sce164:00111",
  "jp": "セリカ「そう？　私には全然わからないけど‥‥{nl}　やっぱりトウヤはライブレードに選ばれた操者なのね。{nl}　ほんと凄いわ‥‥操縦もかなり上達したし」",
  "off": 273,
  "len": 91,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 275,
  "text_len": 88
 },
 {
  "id": "sce164:0016F",
  "jp": "トウヤ「まぁ、それは腕のいい整備士と、{nl}　お前のサポートがあるからだ。感謝してるぜ」",
  "off": 367,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 369,
  "text_len": 50
 },
 {
  "id": "sce164:001C0",
  "jp": "セリカ「そ、そんなこと‥‥私は‥‥」",
  "off": 448,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 450,
  "text_len": 23
 },
 {
  "id": "sce164:001DD",
  "jp": "トウヤ「ん？　どうした？　顔が赤いぞ？{nl}　熱でもあるのか？」",
  "off": 477,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 479,
  "text_len": 37
 },
 {
  "id": "sce164:0020C",
  "jp": "セリカ「あっ‥‥も、もぅ！　大丈夫だって！」",
  "off": 524,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 526,
  "text_len": 29
 },
 {
  "id": "sce164:0022F",
  "jp": "トウヤ「う～ん、大丈夫みてぇだが、{nl}　ちょっと熱があるんじゃねぇか？」",
  "off": 559,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 561,
  "text_len": 41
 },
 {
  "id": "sce164:0025E",
  "jp": "セリカ（ドキドキドキ‥‥）",
  "off": 606,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 608,
  "text_len": 15
 },
 {
  "id": "sce164:00292",
  "jp": "セリカ「そ、それじゃ‥‥私、用事があるから‥‥」",
  "off": 658,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 660,
  "text_len": 31
 },
 {
  "id": "sce164:002C2",
  "jp": "トウヤ「？？？」",
  "off": 706,
  "len": 14,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 708,
  "text_len": 11
 },
 {
  "id": "sce164:00325",
  "jp": "ゲン「ふぅ～危ない、危ない‥‥{nl}　ホント、ゼイフォンって頑丈にできてんだなぁ‥‥」",
  "off": 805,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 807,
  "text_len": 50
 },
