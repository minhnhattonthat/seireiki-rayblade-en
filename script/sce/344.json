  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 7617,
  "text_len": 25
 },
 {
  "id": "sce344:01DDB",
  "jp": "トウヤ「そうだ。だからライブレードが二人乗りなんだ。{nl}　俺達が五#486いに想う心、確かな絆を生むために！」",
  "off": 7643,
  "len": 68,
