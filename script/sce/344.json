  "off": 6623,
  "len": 76,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 6627,
  "text_len": 71
 },
 {
  "id": "sce344:01A2B",
  "jp": "トウヤ「おいおい、マジかよ‥‥」",
  "off": 6699,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 6703,
  "text_len": 18
 },
 {
