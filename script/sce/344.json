  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 6857,
  "text_len": 26
 },
 {
  "id": "sce344:01AEC",
  "jp": "トウヤ「ここまでか‥‥ごめんな、オーレリィ‥‥」",
