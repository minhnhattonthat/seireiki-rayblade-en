  "status": "todo",
  "style": 2,
  "text_off": 6727,
  "text_len": 31
 },
 {
  "id": "sce344:01A67",
  "jp": "トウヤ「‥‥やるしかねぇってことだな‥‥‥‥セリカ」",
  "off": 6759,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 6763,
  "text_len": 32
 },
 {
  "id": "sce344:01A8C",
  "jp": "セリカ「‥‥うん。私達の本当の力‥‥絆の強さ、{nl}　見せてあげましょう！」",
  "off": 6796,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 6801,
  "text_len": 49
 },
 {
  "id": "sce344:01AC5",
  "jp": "デビッシュ「‥‥ふふふふ‥‥さぁ来い！」",
  "off": 6853,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 6857,
  "text_len": 26
 },
 {
  "id": "sce344:01AEC",
  "jp": "トウヤ「ここまでか‥‥ごめんな、オーレリィ‥‥」",
  "off": 6892,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 6896,
  "text_len": 29
 },
 {
  "id": "sce344:01B0E",
  "jp": "オーレリィ「ううん‥‥トウヤと一緒なら怖くないよ。{nl}　生まれ変わったら、また逢えるかな？」",
  "off": 6926,
  "len": 61,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 6931,
  "text_len": 55
 },
 {
  "id": "sce344:01B4B",
  "jp": "トウヤ「ああ。きっと」",
  "off": 6987,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 6991,
  "text_len": 11
 },
 {
  "id": "sce344:01B5B",
  "jp": "オーレリィ「トウヤ‥‥愛してるよ‥‥」",
  "off": 7003,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 2,
