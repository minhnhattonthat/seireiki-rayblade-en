[
 {
  "id": "sce344:001B8",
  "jp": "デビッシュ「‥‥ようこそ。そちらからわざわざ出徇いて{nl}　くれるとはありがたい話だな」",
  "off": 440,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 444,
  "text_len": 47
 },
 {
  "id": "sce344:001EC",
  "jp": "トウヤ「もうお前の好きにはさせねぇ！{nl}　ここで決着をつけてやるぜっ！」",
  "off": 492,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 496,
  "text_len": 41
 },
 {
  "id": "sce344:0021A",
  "jp": "デビッシュ「ふっ‥‥人は所詮、表面だけの関係を{nl}　取り繕うことで己の心が傷つくことを避け、{nl}　現状から逃げるだけの悲しい存在だ。{nl}　だから私がその呪縛から人を、そして魂を解き放つ。{nl}　貴様ごときが私をとめることはできぬよ」",
  "off": 538,
  "len": 147,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 542,
  "text_len": 142
 },
 {
  "id": "sce344:002AD",
  "jp": "トウヤ「ぬかせっ！　てめぇが勝手に決めたことを{nl}　押し付けられるのは迷惑なんだよ！」",
  "off": 685,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 689,
  "text_len": 51
 },
 {
  "id": "sce344:002E5",
  "jp": "デビッシュ「‥‥私は人類の未来を切り開きたいだけだ」",
  "off": 741,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 745,
  "text_len": 35
 },
 {
  "id": "sce344:0030D",
  "jp": "トウヤ「その未来はてめぇが決めるもんじゃねぇよ！{nl}　俺達が自らの手で掴みとるもんだっ！」",
  "off": 781,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 785,
  "text_len": 54
 },
 {
  "id": "sce344:00348",
  "jp": "デビッシュ「ふっ‥‥我がエステリアもそうだが、{nl}　ここの人類も自分のことしか考えていない‥‥{nl}　エゴのかたまり、か‥‥」",
  "off": 840,
  "len": 77,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 844,
  "text_len": 72
 },
 {
  "id": "sce344:00395",
  "jp": "トウヤ「エステリア？　なにを言ってやがる‥‥」",
  "off": 917,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 921,
  "text_len": 27
 },
 {
  "id": "sce344:003B5",
  "jp": "デビッシュ「少しおしゃべりがすぎたようだ。{nl}　では始めようか‥‥」",
  "off": 949,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 953,
  "text_len": 37
 },
 {
  "id": "sce344:0050F",
  "jp": "デビッシュ「脆い‥‥その程度でこの私を止#4FDめようとなど{nl}　片腹痛い‥‥」",
  "off": 1295,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1299,
  "text_len": 47
 },
 {
  "id": "sce344:00543",
  "jp": "トウヤ「くっ‥‥」",
  "off": 1347,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1351,
  "text_len": 11
 },
 {
  "id": "sce344:00561",
  "jp": "デビッシュ「これで、終わりだ‥‥」",
  "off": 1377,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1381,
  "text_len": 20
 },
 {
  "id": "sce344:005BB",
  "jp": "Aアイ「だめえぇぇぇぇっ‼」",
  "off": 1467,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 1471,
  "text_len": 15
 },
 {
  "id": "sce344:005DD",
  "jp": "トウヤ「⁈　な、なんだ‥‥今の光は‥‥？」",
  "off": 1501,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1505,
  "text_len": 29
 },
 {
  "id": "sce344:00614",
  "jp": "デビッシュ「なっ⁈　効いていない‥‥？{nl}　こ、これは‥‥」",
  "off": 1556,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1560,
  "text_len": 36
 },
 {
  "id": "sce344:0063D",
  "jp": "Aアイ「やらせない‥‥やらせはしない！{nl}　あたしが‥‥あたしがトウヤを守る‼」",
  "off": 1597,
  "len": 51,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 1601,
  "text_len": 46
 },
 {
  "id": "sce344:00672",
  "jp": "トウヤ「この感じ‥‥バースト・プラーナ？{nl}　いや、違う‥‥とても暖かい‥‥‼」",
  "off": 1650,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1654,
  "text_len": 52
 },
 {
  "id": "sce344:006B9",
  "jp": "Aヤマト「うそ‥‥ライブレードがニャおっていく‥‥」",
  "off": 1721,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 1725,
  "text_len": 31
 },
 {
  "id": "sce344:006DD",
  "jp": "デビッシュ「なんなのだ⁉　こんなことが‥‥{nl}　何故だ⁈　このようなこと、ありえるはずがない！」",
  "off": 1757,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 1761,
  "text_len": 54
 },
 {
  "id": "sce344:00741",
  "jp": "ウェニマス「世界を、アガルティアを救って‥‥{nl}　それができるのは、あなたと、あなたがもっとも{nl}　大切に想うひとだけだから‥‥」",
  "off": 1857,
  "len": 76,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1859,
  "text_len": 73
 },
 {
  "id": "sce344:00790",
  "jp": "トウヤ「もっとも大切なひと‥‥」",
  "off": 1936,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1938,
  "text_len": 20
 },
 {
  "id": "sce344:007AA",
  "jp": "ウェニマス「そう。それがライブレードが{nl}　二人乗りの理由‥‥」",
  "off": 1962,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 1964,
  "text_len": 39
 },
 {
  "id": "sce344:007EF",
  "jp": "トウヤ「そうか、そういうことか‥‥」",
  "off": 2031,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2035,
  "text_len": 20
 },
 {
  "id": "sce344:00808",
  "jp": "Aアイ「トウヤ‥‥？」",
  "off": 2056,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 2060,
  "text_len": 14
 },
 {
  "id": "sce344:0081B",
  "jp": "トウヤ「アイと俺の力、それがライブレードの力なんだ」",
  "off": 2075,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2079,
  "text_len": 30
 },
 {
  "id": "sce344:0083E",
  "jp": "Aアイ「あたしとトウヤの力？」",
  "off": 2110,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 2114,
  "text_len": 17
 },
 {
  "id": "sce344:00854",
  "jp": "トウヤ「そうだ。だからライブレードが二人乗りなんだ。{nl}　俺達が五#486いに想う心、確かな絆を生むために！」",
  "off": 2132,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2136,
  "text_len": 63
 },
 {
  "id": "sce344:00898",
  "jp": "Aアイ「なーるほど。要はあたし達のらぶらぶパワーの前に{nl}　敵はいないってことね！」",
  "off": 2200,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 2204,
  "text_len": 48
 },
 {
  "id": "sce344:008CD",
  "jp": "デビッシュ「愛の力とでも言うのか‥‥くだらん！{nl}　そんなものは幻想に過ぎん‼　ただの思い込みだ！{nl}　そんなものに頼っているから、人は成長することなく、{nl}　伺じ過ちを繰り返すのだっ！」",
  "off": 2253,
  "len": 118,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2257,
  "text_len": 113
 },
 {
  "id": "sce344:00943",
  "jp": "Aアイ「バッカじゃないの？　誰かを好きになるって{nl}　気持ちのない世界なんてなんの面白みがあるのよ⁈」",
  "off": 2371,
  "len": 65,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 2375,
  "text_len": 60
 },
 {
  "id": "sce344:00984",
  "jp": "デビッシュ「そのような感情に惑わされるから、{nl}　悲劇は繰り返されるのだ！」",
  "off": 2436,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2440,
  "text_len": 45
 },
 {
  "id": "sce344:009B6",
  "jp": "Aアイ「だから認めないの？　だから無くすの？」",
  "off": 2486,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 2490,
  "text_len": 27
 },
 {
  "id": "sce344:009D6",
  "jp": "デビッシュ「そうだ。事が起こってからでは遅いのだ！{nl}　だから私が人類を救済する！　エステリアは私を{nl}　見捨てたが、私はこの世界を見捨てたりはしない」",
  "off": 2518,
  "len": 97,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2522,
  "text_len": 92
 },
 {
  "id": "sce344:00A37",
  "jp": "Aアイ「なに言ってんのかわかんないけど、それって、{nl}　明廿雨が降るかもしれないから、全部の人に傘を{nl}　無理やりくっつけちゃう様なものよ！{nl}　誰も望んでないし、バカげたことだわ！」",
  "off": 2615,
  "len": 110,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 2619,
  "text_len": 105
 },
 {
  "id": "sce344:00AA5",
  "jp": "デビッシュ「ならばその愛とやらで私を倒してみろ！」",
  "off": 2725,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2729,
  "text_len": 29
 },
 {
  "id": "sce344:00AE4",
  "jp": "トウヤ「な、なんだ⁈」",
  "off": 2788,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2792,
  "text_len": 12
 },
 {
  "id": "sce344:00B1B",
  "jp": "Aヤマト「今の衝撃で対フィールドユニットが{nl}　無力化されちゃったみたい‥‥」",
  "off": 2843,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 2847,
  "text_len": 48
 },
 {
  "id": "sce344:00B50",
  "jp": "トウヤ「おい、それって‥‥」",
  "off": 2896,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 2900,
  "text_len": 16
 },
 {
  "id": "sce344:00B65",
  "jp": "Aアイ「あたし達だけしかあいつにダメージを{nl}　与えられないってこと⁈」",
  "off": 2917,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 2921,
  "text_len": 39
 },
 {
  "id": "sce344:00B91",
  "jp": "Aヤマト「ええ。でも、これで最後！　頑張りましょ！」",
  "off": 2961,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 2965,
  "text_len": 32
 },
 {
  "id": "sce344:00BB6",
  "jp": "トウヤ「ああ。やるしかねぇってことだな‥‥‥‥アイ」",
  "off": 2998,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 3002,
  "text_len": 30
 },
 {
  "id": "sce344:00BD9",
  "jp": "Aアイ「‥‥うん。あたし達の絆、見せてやりましょう！」",
  "off": 3033,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 3037,
  "text_len": 33
 },
