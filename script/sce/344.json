  "status": "todo",
  "style": 2,
  "text_off": 6726,
  "text_len": 32
 },
 {
  "id": "sce344:01A67",
  "jp": "トウヤ「‥‥やるしかねぇってことだな‥‥‥‥セリカ」",
  "off": 6759,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 6763,
  "text_len": 32
 },
 {
