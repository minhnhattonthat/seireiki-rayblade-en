 },
 {
  "id": "sce344:00FBD",
  "jp": "カスミ「そんなことない！　だって、私はトウヤちゃんと{nl}　出会えて幸せだったもの。トウヤちゃんがいたから{nl}　ここまで来ることができたの」",
  "off": 4029,
  "len": 79,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 4034,
  "text_len": 73
 },
 {
  "id": "sce344:0100C",
  "jp": "デビッシュ「人は独りでも生きて行ける。{nl}　エステリアが私を見捨てたように、{nl}　所詮は誰も信揖できんのだ」",
  "off": 4108,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4112,
  "text_len": 64
 },
 {
  "id": "sce344:01051",
  "jp": "カスミ「‥‥あなたも辛い経験をしたのね‥‥{nl}　でも、誰かを好きになるってすごく暖かい気持ちに{nl}　なれるのよ？」",
  "off": 4177,
  "len": 74,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 4182,
  "text_len": 68
 },
 {
  "id": "sce344:0109B",
  "jp": "デビッシュ「そのような感情に惑わされるから、{nl}　悲劇は繰り返されるのだ！」",
  "off": 4251,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4255,
  "text_len": 45
 },
 {
  "id": "sce344:010CD",
  "jp": "カスミ「だから認めないの？　だから無くすの？」",
  "off": 4301,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 4306,
  "text_len": 27
 },
 {
  "id": "sce344:010EE",
  "jp": "デビッシュ「そうだ。事が起こってからでは遅いのだ！{nl}　だから私が人類を救済する！　エステリアは私を{nl}　見捨てたが、私はこの世界を見捨てたりはしない。{nl}　私が誰にも頼らない、誰も必要としない理想の世界を{nl}　創り上げてみせる。<E1>ォーリアがあればそれが{nl}　できるのだ‥‥愛などまやかしにすぎん！」",
  "off": 4334,
  "len": 185,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4338,
  "text_len": 180
 },
 {
  "id": "sce344:011A7",
  "jp": "カスミ「そんなこと‥‥誰も必要としない世界なんて、{nl}　そんなことさせない！」",
  "off": 4519,
  "len": 52,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 4524,
  "text_len": 46
 },
 {
  "id": "sce344:011DB",
  "jp": "デビッシュ「ならばその愛とやらで私を倒してみろ！」",
  "off": 4571,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4575,
  "text_len": 29
 },
 {
  "id": "sce344:0121A",
  "jp": "トウヤ「な、なんだ⁈」",
  "off": 4634,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4638,
  "text_len": 12
 },
 {
  "id": "sce344:01231",
  "jp": "ヤマト「あっ！」",
  "off": 4657,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 4662,
  "text_len": 9
 },
 {
  "id": "sce344:01240",
  "jp": "カスミ「ど、どうしたの⁈」",
  "off": 4672,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 4677,
  "text_len": 14
 },
 {
  "id": "sce344:01254",
  "jp": "ヤマト「今の衝撃で対フィールドユニットが{nl}　無力化されちゃったみたい‥‥」",
  "off": 4692,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 4697,
  "text_len": 47
 },
 {
  "id": "sce344:01289",
  "jp": "トウヤ「おい、それって‥‥」",
  "off": 4745,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4749,
  "text_len": 16
 },
 {
  "id": "sce344:0129E",
  "jp": "カスミ「ゴーデリウスにはライブレードの攻撃しか{nl}　効かなくなったってこと‥‥？」",
  "off": 4766,
  "len": 54,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 4771,
  "text_len": 48
 },
 {
  "id": "sce344:012D4",
  "jp": "ヤマト「ええ。でも、これで最後！　頑張りましょ！」",
  "off": 4820,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 4825,
  "text_len": 31
 },
 {
  "id": "sce344:012F9",
  "jp": "トウヤ「ああ。やるしかねぇってことだな‥‥‥‥カスミ」",
  "off": 4857,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4861,
  "text_len": 31
 },
 {
  "id": "sce344:0131D",
  "jp": "カスミ「うん。トウヤちゃんとヤマトちゃんと私の絆‥‥{nl}　たしかな絆を見せてあげましょ！」",
  "off": 4893,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 4898,
  "text_len": 51
 },
 {
  "id": "sce344:01358",
  "jp": "デビッシュ「‥‥ふふふふ‥‥さぁ来い！」",
  "off": 4952,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 4956,
  "text_len": 26
 },
 {
  "id": "sce344:0137F",
  "jp": "セリカ「だめえぇぇぇぇっ‼」",
  "off": 4991,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 4996,
  "text_len": 15
 },
 {
  "id": "sce344:013A2",
  "jp": "トウヤ「⁈　な、なんだ‥‥今の光は‥‥？」",
  "off": 5026,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5030,
  "text_len": 29
 },
 {
  "id": "sce344:013D9",
  "jp": "デビッシュ「なっ⁈　効いていない‥‥？{nl}　こ、これは‥‥」",
  "off": 5081,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5085,
  "text_len": 36
 },
 {
  "id": "sce344:01402",
  "jp": "セリカ「せっかく想いが通じ合えたのに‥‥{nl}　こんなところで死ぬワケにはいかないわ！」",
  "off": 5122,
  "len": 55,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 5127,
  "text_len": 49
 },
 {
  "id": "sce344:0143B",
  "jp": "トウヤ「この感じ‥‥バースト・プラーナ？{nl}　いや、違う‥‥とても暖かい‥‥‼」",
  "off": 5179,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5183,
  "text_len": 52
 },
 {
  "id": "sce344:01480",
  "jp": "ヤマト「うそ‥‥ライブレードがニャおっていく‥‥」",
  "off": 5248,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 5253,
  "text_len": 30
 },
 {
  "id": "sce344:014A4",
  "jp": "セリカ「え？　なに？　どういうこと？」",
  "off": 5284,
  "len": 28,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 5289,
  "text_len": 22
 },
 {
  "id": "sce344:014C0",
  "jp": "デビッシュ「なんなのだ⁉　こんなことが‥‥{nl}　何故だ⁈　このようなこと、ありえるはずがない！」",
  "off": 5312,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5316,
  "text_len": 54
 },
 {
  "id": "sce344:01524",
  "jp": "ウェニマス「世界を、アガルティアを救って‥‥{nl}　それができるのは、あなたと、あなたがもっとも{nl}　大切に想うひとだけだから‥‥」",
  "off": 5412,
  "len": 76,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5414,
  "text_len": 73
 },
 {
  "id": "sce344:01573",
  "jp": "トウヤ「もっとも大切なひと‥‥」",
  "off": 5491,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5493,
  "text_len": 20
 },
 {
  "id": "sce344:0158D",
  "jp": "ウェニマス「そう。それがライブレードが{nl}　二人乗りの理由‥‥」",
  "off": 5517,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5519,
  "text_len": 39
 },
 {
  "id": "sce344:015D2",
  "jp": "トウヤ「そうか、そういうことか‥‥」",
  "off": 5586,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5590,
  "text_len": 20
 },
 {
  "id": "sce344:015EB",
  "jp": "セリカ「トウヤ‥‥？」",
  "off": 5611,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 5616,
  "text_len": 14
 },
 {
  "id": "sce344:015FF",
  "jp": "トウヤ「セリカと俺の力、それがライブレードの力なんだ」",
  "off": 5631,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5635,
  "text_len": 31
 },
 {
  "id": "sce344:01623",
  "jp": "セリカ「私とトウヤの力‥‥？」",
  "off": 5667,
  "len": 26,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 5672,
  "text_len": 20
 },
 {
  "id": "sce344:0163D",
  "jp": "トウヤ「そうだ。だからライブレードが二人乗りなんだ。{nl}　俺達が互いに想う心、確かな絆を生むために！」",
  "off": 5693,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5697,
  "text_len": 63
 },
 {
  "id": "sce344:01681",
  "jp": "セリカ「そっか！　＜ゼ＝オード＞聖霊機は人の意志や{nl}　感情をエネルギーとすることができるってベルンストが{nl}　言っていたわね。‥‥ということは、{nl}　ライブレードには相手への想い‥‥つまり、その‥‥{nl}　“愛”をエネルギーとすることができるのね」",
  "off": 5761,
  "len": 155,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 5766,
  "text_len": 149
 },
 {
  "id": "sce344:0171C",
  "jp": "デビッシュ「愛だと‥‥くだらん！{nl}　そんなものは幻想に過ぎん‼　ただの思い込みだ！{nl}　そんなものに頼っているから、人は成長することなく、{nl}　同じ過ちを繰り返すのだっ！」",
  "off": 5916,
  "len": 109,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 5920,
  "text_len": 104
 },
 {
  "id": "sce344:01789",
  "jp": "セリカ「あなたは“愛”なんていらないって言うの？{nl}　そんな世界が本当にいいって思っているの？」",
  "off": 6025,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 6030,
  "text_len": 58
 },
 {
  "id": "sce344:017C9",
  "jp": "デビッシュ「“愛”や“信頼”という感情に{nl}　惑わされるから、悲劇は繰り返されるのだ！」",
  "off": 6089,
  "len": 63,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 6093,
  "text_len": 58
 },
 {
  "id": "sce344:01808",
  "jp": "セリカ「だから認めないの？　だから無くすの？」",
  "off": 6152,
  "len": 33,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 6157,
  "text_len": 27
 },
 {
  "id": "sce344:01829",
  "jp": "デビッシュ「そうだ。事が起こってからでは遅いのだ！{nl}　だから私が人類を救済する！　エステリアは私を{nl}　見捨てたが、私はこの世界を見捨てたりはしない」",
  "off": 6185,
  "len": 97,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 6189,
  "text_len": 92
 },
 {
  "id": "sce344:0188A",
  "jp": "セリカ「‥‥あなた誰？　デビッシュ博止じゃないわね？」",
  "off": 6282,
  "len": 40,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 6287,
  "text_len": 34
 },
 {
  "id": "sce344:018B2",
  "jp": "デビッシュ「えぇーい、うるさいっ！　どうしても嫌だと{nl}　いうのであれば、その愛とやらで私を倒してみろ！」",
  "off": 6322,
  "len": 64,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 6326,
  "text_len": 59
 },
 {
  "id": "sce344:0190F",
  "jp": "トウヤ「な、なんだ⁈」",
  "off": 6415,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 6419,
  "text_len": 12
 },
 {
