  "id": "sce344:02920",
  "jp": "トウヤ「だから勝手に決めるなって！」",
  "off": 10528,
  "len": 27,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 10532,
  "text_len": 22
 },
 {
  "id": "sce344:0293B",
  "jp": "クルル「さっ、それじゃいくわよぉ！」",
  "off": 10555,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 10560,
  "text_len": 19
 },
 {
  "id": "sce344:02954",
  "jp": "ヤマト「やれやれ‥‥」",
  "off": 10580,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 10585,
  "text_len": 13
 },
 {
  "id": "sce344:02969",
  "jp": "デビッシュ「‥‥ふふふふ‥‥さぁ来い！」",
  "off": 10601,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 10605,
  "text_len": 26
 },
 {
  "id": "sce344:02990",
  "jp": "トウヤ「くっ‥‥ここまできて‥‥ごめんな」",
  "off": 10640,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 10644,
  "text_len": 25
 },
 {
  "id": "sce344:029AE",
  "jp": "ユミール「トウヤは悪くない。私の力が足りなかったから‥‥{nl}　ごめんね」",
  "off": 10670,
  "len": 48,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 10675,
  "text_len": 42
 },
 {
  "id": "sce344:029DE",
  "jp": "トウヤ「ユミール‥‥俺達、生まれ変わっても{nl}　また逢えるかな？」",
  "off": 10718,
  "len": 46,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 10722,
  "text_len": 41
 },
 {
  "id": "sce344:02A0C",
  "jp": "ユミール「ええ‥‥」",
  "off": 10764,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 10769,
  "text_len": 13
 },
 {
  "id": "sce344:02A1F",
  "jp": "トウヤ「ユミール‥‥」",
  "off": 10783,
  "len": 19,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 10787,
  "text_len": 14
 },
 {
  "id": "sce344:02A32",
  "jp": "ユミール「トウヤ‥‥愛してるわ‥‥」",
  "off": 10802,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 10807,
  "text_len": 24
 },
 {
  "id": "sce344:02A5E",
  "jp": "トウヤ「⁈　な、なんだ‥‥今の光は‥‥？」",
  "off": 10846,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 10850,
  "text_len": 29
 },
 {
  "id": "sce344:02A95",
  "jp": "デビッシュ「なっ⁈　効いていない‥‥？{nl}　こ、これは‥‥」",
  "off": 10901,
  "len": 41,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 10905,
  "text_len": 36
 },
 {
  "id": "sce344:02AC0",
  "jp": "トウヤ「この感じ‥‥バースト・プラーナ？{nl}　いや、違う‥‥とても暖かい‥‥‼」",
  "off": 10944,
  "len": 57,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 10948,
  "text_len": 52
 },
 {
  "id": "sce344:02B07",
  "jp": "ヤマト「うそ‥‥ライブレードがニャおっていく‥‥」",
  "off": 11015,
  "len": 36,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 11020,
  "text_len": 30
 },
 {
  "id": "sce344:02B2B",
  "jp": "デビッシュ「なんなのだ⁉　こんなことが‥‥{nl}　何故だ⁈　このようなこと、ありえるはずがない！」",
  "off": 11051,
  "len": 59,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 11055,
  "text_len": 54
 },
 {
  "id": "sce344:02B8F",
  "jp": "ウェニマス「世界を、アガルティアを救って‥‥{nl}　それができるのは、あなたと、あなたがもっとも{nl}　大切に想うひとだけだから‥‥」",
  "off": 11151,
  "len": 76,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 11153,
  "text_len": 73
 },
 {
  "id": "sce344:02BDE",
  "jp": "トウヤ「もっとも大切なひと‥‥」",
  "off": 11230,
  "len": 23,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 11232,
  "text_len": 20
 },
 {
  "id": "sce344:02BF8",
  "jp": "ウェニマス「そう。それがライブレードが{nl}　二人乗りの理由‥‥」",
  "off": 11256,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 11258,
  "text_len": 39
 },
 {
  "id": "sce344:02C3D",
  "jp": "トウヤ「そうか、そういうことか‥‥」",
  "off": 11325,
  "len": 25,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 11329,
  "text_len": 20
 },
 {
  "id": "sce344:02C56",
  "jp": "ユミール「トウヤ‥‥？」",
  "off": 11350,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 11355,
  "text_len": 16
 },
 {
  "id": "sce344:02C6C",
  "jp": "トウヤ「ユミールと俺の力、それがライブレードの力なんだ」",
  "off": 11372,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 11376,
  "text_len": 33
 },
 {
  "id": "sce344:02C92",
  "jp": "ユミール「私とトウヤの力？」",
  "off": 11410,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 11415,
  "text_len": 18
 },
 {
  "id": "sce344:02CAA",
  "jp": "トウヤ「そうだ。だからライブレードが二人乗りなんだ。{nl}　俺達が互いに想う心、確かな絆を生むために！」",
  "off": 11434,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 11438,
  "text_len": 63
 },
 {
  "id": "sce344:02CEE",
  "jp": "ユミール「それが、ライブレードの本当の力‥‥{nl}　愛の力が‥‥？」",
  "off": 11502,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 11507,
  "text_len": 44
 },
 {
  "id": "sce344:02D20",
  "jp": "デビッシュ「愛の力だと‥‥くだらん！{nl}　そんなものは幻想に過ぎん‼　ただの思い込みだ！{nl}　そんなものに頼っているから、人は成長することなく、{nl}　同じ過ちを繰り返すのだっ！」",
  "off": 11552,
  "len": 112,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 11556,
  "text_len": 107
 },
 {
  "id": "sce344:02D90",
  "jp": "ユミール「人は独りでは生きてはいけないわ‥‥{nl}　誰かを支え、誰かに支えられ、助け合って{nl}　成長していくものよ」",
  "off": 11664,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 11669,
  "text_len": 69
 },
 {
  "id": "sce344:02DDB",
  "jp": "デビッシュ「そのような感情に惑わされるから、{nl}　悲劇は繰り返されるのだ！」",
  "off": 11739,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 11743,
  "text_len": 45
 },
 {
  "id": "sce344:02E0D",
  "jp": "ユミール「だから認めないの？　だから無くすの？」",
  "off": 11789,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 11794,
  "text_len": 29
 },
 {
  "id": "sce344:02E30",
  "jp": "デビッシュ「そうだ。事が起こってからでは遅いのだ！{nl}　だから私が人類を救済する！　エステリアは私を{nl}　見捨てたが、私はこの世界を見捨てたりはしない。{nl}　私が誰にも頼らない、誰も必要としない理想の世界を{nl}　創り上げてみせる。<E1>ォーリアがあればそれが{nl}　できるのだ‥‥愛などまやかしにすぎん！」",
  "off": 11824,
  "len": 185,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 11828,
  "text_len": 180
 },
 {
  "id": "sce344:02EE9",
  "jp": "ユミール「誰も必要としない世界なんて‥‥{nl}　誰も愛することのできない世界なんて、{nl}　誰も望んでいないわ！　そんなことさせない！」",
  "off": 12009,
  "len": 86,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 12014,
  "text_len": 80
 },
 {
  "id": "sce344:02F3F",
  "jp": "デビッシュ「ならばその愛とやらで私を倒してみろ！」",
  "off": 12095,
  "len": 34,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12099,
  "text_len": 29
 },
 {
  "id": "sce344:02F7E",
  "jp": "トウヤ「な、なんだ⁈」",
  "off": 12158,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12162,
  "text_len": 12
 },
 {
  "id": "sce344:02F95",
  "jp": "ヤマト「あっ！」",
  "off": 12181,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 12186,
  "text_len": 9
 },
 {
  "id": "sce344:02FA4",
  "jp": "ユミール「ど、どうしたの？」",
  "off": 12196,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 12201,
  "text_len": 16
 },
 {
  "id": "sce344:02FBA",
  "jp": "ヤマト「今の衝撃で対フィールドユニットが{nl}　無力化されちゃったみたい‥‥」",
  "off": 12218,
  "len": 53,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 12223,
  "text_len": 47
 },
 {
  "id": "sce344:02FEF",
  "jp": "トウヤ「おい、それって‥‥」",
  "off": 12271,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12275,
  "text_len": 16
 },
 {
  "id": "sce344:03004",
  "jp": "ユミール「ゴーデリウスにはライブレードの攻撃しか{nl}　効かなくなったということね‥‥」",
  "off": 12292,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 12297,
  "text_len": 50
 },
 {
  "id": "sce344:0303C",
  "jp": "ヤマト「ええ。でも、これで最後！　頑張りましょ！」",
  "off": 12348,
  "len": 37,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 12353,
  "text_len": 31
 },
 {
  "id": "sce344:03061",
  "jp": "トウヤ「ああ。やるしかねぇってことだな‥‥‥‥ユミール」",
  "off": 12385,
  "len": 38,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12389,
  "text_len": 33
 },
 {
  "id": "sce344:03087",
  "jp": "ユミール「ええ。いきましょう。{nl}　すべての決着をつけるために！」",
  "off": 12423,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 12428,
  "text_len": 36
 },
 {
  "id": "sce344:030B3",
  "jp": "デビッシュ「‥‥ふふふふ‥‥さぁ来い！」",
  "off": 12467,
  "len": 31,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12471,
  "text_len": 26
 },
 {
  "id": "sce344:030E7",
  "jp": "デビッシュ「これが‥‥クククク‥‥{nl}　このような異郷の地で果てるのも一興‥‥」",
  "off": 12519,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12523,
  "text_len": 51
 },
 {
  "id": "sce344:0314C",
  "jp": "ヤマト「ト、トウヤ！」",
  "off": 12620,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 12625,
  "text_len": 12
 },
 {
  "id": "sce344:0315E",
  "jp": "トウヤ「よし、脱出する！」",
  "off": 12638,
  "len": 21,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12642,
  "text_len": 16
 },
 {
  "id": "sce344:031AB",
  "jp": "デビッシュ「ばっ、馬鹿な！　この私が貴様らごときに{nl}　倒されるだと⁉　そんな事、絶対に有り得ん‼{nl}　私が、私が許さんっ！！！　ぐぅおおおおお‼‼」",
  "off": 12715,
  "len": 100,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12719,
  "text_len": 95
 },
 {
  "id": "sce344:03223",
  "jp": "デビッシュ「はぁ、はぁはぁ‥‥クククククク‥‥{nl}　この‥‥ゴーデリウスの力、見くびってもらっては困る！」",
  "off": 12835,
  "len": 68,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12839,
  "text_len": 63
 },
 {
  "id": "sce344:03267",
  "jp": "トウヤ「な、なんて奴だ‥‥」",
  "off": 12903,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12907,
  "text_len": 17
 },
 {
  "id": "sce344:0327D",
  "jp": "デビッシュ「諦めろ。貴様達に勝ち目はない。{nl}　座して死を待て」",
  "off": 12925,
  "len": 45,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12929,
  "text_len": 40
 },
 {
  "id": "sce344:032AA",
  "jp": "トウヤ「くっ‥‥あ、あきらめてたまるか‼{nl}　俺は‥‥絶対にあきらめねえ‼{nl}　‥‥お前に倒されるわけにはいかねぇんだよ‼」",
  "off": 12970,
  "len": 79,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 12974,
  "text_len": 74
 },
 {
  "id": "sce344:032F9",
  "jp": "デビッシュ「ならば、跡形もなく梢し去ってくれる‼」",
  "off": 13049,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 13053,
  "text_len": 30
 }
]
