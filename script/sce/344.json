  "jp": "Aオーレリィ「ううん‥‥トウヤと一緒なら怖くないよ。{nl}　生まれ変わったら、また逢えるかな？」",
  "off": 6926,
  "len": 61,
  "en": "",
  "status": "todo",
  "style": 2,
  "text_off": 6930,
  "text_len": 56
 },
 {
  "id": "sce344:01B4B",
  "jp": "トウヤ「ああ。きっと」",
  "off": 6987,
  "len": 16,
  "en": "",
  "status": "todo",
  "style": 1,
  "text_off": 6991,
  "text_len": 11
 },
