  "status": "todo",
  "style": 0,
  "text_off": 545,
  "text_len": 27
 },
 {
  "id": "sce417:00240",
  "jp": "トウヤ「慣れるほど日にちはたってねぇからな」",
  "off": 576,
  "len": 27,
