  "status": "todo",
  "style": 0,
  "text_off": 578,
  "text_len": 24
 },
 {
  "id": "sce417:0025E",
  "jp": "セリカ「‥‥もっともね。でもだんだん戦士の目に{nl}　なってきてるわよ」",
  "off": 606,
  "len": 42,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 608,
  "text_len": 39
 },
 {
  "id": "sce417:0028B",
  "jp": "トウヤ「‥‥俺は好きで戦ってるワケじゃねぇ」",
  "off": 651,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 653,
  "text_len": 27
 },
 {
  "id": "sce417:002AC",
  "jp": "セリカ「う～ん、言い方がマズかったかな？{nl}　別にあなたが楽しんでるとか言ってるわけじゃないの。{nl}　なんて言うか、うれしいのよね」",
  "off": 684,
  "len": 75,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 686,
  "text_len": 72
 },
 {
  "id": "sce417:002FA",
  "jp": "トウヤ「は？」",
  "off": 762,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 764,
  "text_len": 8
 },
 {
  "id": "sce417:00308",
  "jp": "セリカ「あなたと聖霊機の同調測定値は{nl}　底知れないものがあるわ。{nl}　こんなこと初めてなの。{nl}　こっちがいじればいじるほど{nl}　あなたはそれに応える‥‥すごく楽しいのよ」",
  "off": 776,
  "len": 101,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 778,
  "text_len": 98
 },
 {
  "id": "sce417:00370",
  "jp": "トウヤ「‥‥」",
  "off": 880,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 882,
  "text_len": 9
 },
 {
  "id": "sce417:0037F",
  "jp": "セリカ「こんなにうまくゼイフォンを使ってくれる人が{nl}　あらわれたことがたまらなくうれしい。{nl}　こんな気持ちになれるなんてね」",
  "off": 895,
  "len": 69,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 897,
  "text_len": 66
 },
 {
  "id": "sce417:003C7",
  "jp": "トウヤ「‥‥あんた変わってるな」",
  "off": 967,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 969,
  "text_len": 19
 },
 {
  "id": "sce417:003E0",
  "jp": "セリカ「かもね。でも、そういうあなたもよ」",
  "off": 992,
  "len": 24,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 994,
  "text_len": 21
 },
 {
  "id": "sce417:003FB",
  "jp": "トウヤ「俺？」",
