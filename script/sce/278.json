  "off": 6835,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6837,
  "text_len": 9
 },
 {
  "id": "sce278:01AC6",
  "jp": "アイ「‥‥な、なに？」",
  "off": 6854,
  "len": 17,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6856,
  "text_len": 14
 },
 {
  "id": "sce278:01ADA",
  "jp": "ヤマト「捨てるのが嫌だからあたし達に押し付けた」",
  "off": 6874,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6876,
  "text_len": 29
 },
 {
  "id": "sce278:01B11",
  "jp": "アイ「うっ‥‥そ、そんなワケあるはずないこともないかも{nl}　しれないじゃない‥‥ははははは‥‥」",
  "off": 6929,
  "len": 56,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6931,
  "text_len": 53
 },
 {
  "id": "sce278:01B4C",
  "jp": "トウヤ「‥‥」",
  "off": 6988,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 6990,
  "text_len": 9
 },
 {
  "id": "sce278:01B66",
  "jp": "アイ「‥‥ごめん。協力して。{nl}　あたし、本当に物を捨てたりするの嫌いなんだ。{nl}　でも、さすがにこんだけ食べきれないし‥‥」",
  "off": 7014,
  "len": 76,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7016,
  "text_len": 73
 },
 {
  "id": "sce278:01BB5",
  "jp": "トウヤ「‥‥そんならそうと言えばいいじゃねえか」",
  "off": 7093,
  "len": 30,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7095,
  "text_len": 27
 },
 {
  "id": "sce278:01BDA",
  "jp": "アイ「なんか照れくさくって‥‥」",
  "off": 7130,
  "len": 22,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7132,
  "text_len": 19
 },
 {
  "id": "sce278:01BF3",
  "jp": "ヤマト「でも、アイの年代でそんニャこと言う子って{nl}　結構珍しいんじゃニャい？」",
  "off": 7155,
  "len": 50,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7157,
  "text_len": 47
 },
 {
  "id": "sce278:01C3A",
  "jp": "アイ「そう？　まあ、あたし、おばあちゃん子だったし、{nl}　その影響かな？」",
  "off": 7226,
  "len": 44,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7228,
  "text_len": 41
 },
 {
  "id": "sce278:01C69",
  "jp": "トウヤ「そっか。まぁ、そういうことなら協力してやるよ」",
  "off": 7273,
  "len": 32,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7275,
  "text_len": 29
 },
 {
  "id": "sce278:01CA1",
  "jp": "アイ「ありがと」",
  "off": 7329,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7331,
  "text_len": 8
 },
 {
  "id": "sce278:01CAF",
  "jp": "トウヤ「それじゃ、もらっていくぞ」",
  "off": 7343,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7345,
  "text_len": 17
 },
 {
  "id": "sce278:01CC6",
  "jp": "アイ「うん。よろしくね」",
  "off": 7366,
  "len": 15,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7368,
  "text_len": 12
 },
 {
  "id": "sce278:01CDC",
  "jp": "ヤマト「さて、とりあえず持ち歩くわけにもいかニャいし、{nl}　一度部屋に戻ろうよ」",
  "off": 7388,
  "len": 49,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7390,
  "text_len": 46
 },
 {
  "id": "sce278:01D10",
  "jp": "トウヤ「そうだな」",
  "off": 7440,
  "len": 12,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 7442,
  "text_len": 9
 },
 {
  "id": "sce278:01D22",
