  "off": 5476,
  "len": 11,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5478,
  "text_len": 8
 },
 {
  "id": "sce278:01581",
  "jp": "アイ「あっ、トウヤ。なに？」",
  "off": 5505,
  "len": 18,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5507,
  "text_len": 15
 },
 {
  "id": "sce278:01596",
  "jp": "トウヤ「いや、別にこれといって揖事があるワケじゃ‥‥」",
  "off": 5526,
  "len": 35,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5528,
  "text_len": 32
 },
 {
  "id": "sce278:015CE",
