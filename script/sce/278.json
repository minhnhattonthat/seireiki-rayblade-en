  "off": 5311,
  "len": 20,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5313,
  "text_len": 17
 },
 {
  "id": "sce278:014D6",
  "jp": "トウヤ「まぁ、あいつはあれで充実してんだろ？{nl}　それより、いくぞ」",
  "off": 5334,
  "len": 39,
  "en": "",
  "status": "todo",
  "style": 0,
  "text_off": 5336,
  "text_len": 36
 },
 {
  "id": "sce278:01500",
